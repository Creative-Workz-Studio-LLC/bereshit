// =============================================================================
// SETUP
// =============================================================================
//
// Key: B-go-workspace
// Consumer: Go toolchain (go build, go test, go mod)
// Loader: Automatically detected by go commands in workspace
//
// Dependencies:
//   - Go 1.23+ (workspace support)
//   - word/work/go.mod (core library module)
//   - tov/demo/phase-0/demo-config/go.mod (phase 0 demo module)
//
// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY
// =============================================================================

go 1.24.4

use (

	// Phase 0 demo - validates TOML specs exist and load correctly
	./tov/demo/phase-0/demo-config

	// Claude Code integration - hooks and pkg
	// Config-driven pattern: These modules read from word/core/ TOML specs
	./word/claude/hooks
	./word/claude/pkg
	// Core library - config loader, future packages
	./word/work

	// CPI-SI CLI - state machine interface
	./word/work/cmd/cpisi
)

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING
// =============================================================================
//
// Validation:
//   go work sync    # Sync workspace with modules
//   go list -m all  # List all modules in workspace
//
// Modification Policy:
//   Safe: Add new use directives for additional modules
//   Careful: Changing go version (affects all modules)
//   Never: Remove core modules without migration plan
//
// Related:
//   word/work/go.mod - Core library module
//   tov/demo/*/go.mod - Demo modules
//
// =============================================================================
// END CLOSING
// =============================================================================
