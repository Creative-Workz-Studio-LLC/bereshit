{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-schema/main/v2.json",
  "productName": "CWS Dashboard",
  "version": "0.1.0",
  "identifier": "com.creativeworkzstudio.dashboard",
  "build": {
    "beforeDevCommand": "npx tsc -p tsconfig.web.json",
    "beforeBuildCommand": "npx tsc -p tsconfig.web.json",
    "frontendDist": "../src-web",
    "devUrl": "http://localhost:3847"
  },
  "app": {
    "windows": [
      {
        "title": "CWS Manual Builder Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "targets": ["deb", "appimage"],
    "shortDescription": "CWS Manual Builder Dashboard",
    "longDescription": "GUI and web dashboard for the CWS Company Identity Manual build system. Provides clickable access to all 18 CLI commands, file selection, configuration editors, and real-time build output streaming.",
    "category": "Development",
    "linux": {}
  },
  "plugins": {
    "dialog": {},
    "shell": {
      "open": true
    }
  }
}
