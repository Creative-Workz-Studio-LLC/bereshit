{
  // =========================================================================
  // CWS Manual Builder — TypeScript Configuration
  // =========================================================================
  //
  // Specification: editorial-style-guide.adoc (CWS-GDE-001)
  //
  // Node.js ESM project using Node16 module resolution.
  // Strict mode with full type safety — quality reflects the Creator.
  //
  // "Whatsoever thy hand findeth to do, do it with thy might."
  //   — Ecclesiastes 9:10
  //
  // =========================================================================

  "compilerOptions": {

    // --- Emit ---
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",

    // --- Module Interop ---
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // --- Type Safety (strict + extras) ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // --- Output Artifacts ---
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
