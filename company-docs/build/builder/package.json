{
  "name": "@cws/manual-builder",
  "version": "2.0.0",
  "description": "Build system for the CWS Company Identity Manual — editorial review (Make) and multi-format publishing (TS builder)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cws-build": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.adoc"
  ],

  "scripts": {

    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean:dist": "rm -rf dist/",
    "start": "node dist/cli.js",

    "editorial:book":          "make -C ../.. book",
    "editorial:frontmatter":   "make -C ../.. A",
    "editorial:content":       "make -C ../.. B",
    "editorial:appendices":    "make -C ../.. C",
    "editorial:backmatter":    "make -C ../.. D",
    "editorial:validate":      "make -C ../.. validate TYPE=manual-l",
    "editorial:validate:full": "make -C ../.. validate TYPE=manual-l BONUS=operational",
    "editorial:deps":          "make -C ../.. deps",
    "editorial:watch":         "make -C ../.. watch-pdf",
    "editorial:assets":        "make -C ../.. assets",
    "editorial:assets:force":  "make -C ../.. assets FORCE=1",
    "editorial:clean":         "make -C ../.. clean",

    "publish:pdf":    "node dist/cli.js --format pdf",
    "publish:html":   "node dist/cli.js --format html",
    "publish:epub":   "node dist/cli.js --format epub",
    "publish:all":    "node dist/cli.js --format all",
    "publish:watch":  "node dist/cli.js --watch",
    "publish:clean":  "node dist/cli.js --clean",
    "publish:info":   "node dist/cli.js --info",
    "publish:check":  "node dist/cli.js --check"
  },

  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.5.0"
  },

  "engines": {
    "node": ">=20.0.0"
  },

  "author": "CreativeWorkzStudio LLC",
  "license": "UNLICENSED",
  "private": true,

  "keywords": [
    "asciidoc",
    "asciidoctor",
    "build-system",
    "pdf",
    "publishing",
    "company-identity-manual",
    "editorial"
  ]
}
