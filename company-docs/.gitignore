# =============================================================================
# CWS Company Identity Manual — .gitignore
# =============================================================================
#
# NOTE: The repo root .gitignore has `**/build/` which ignores all build dirs.
# We override that here to track build source files (previews, themes, etc.)
# while still ignoring generated output.
# =============================================================================

# Override repo-root `**/build/` — unignore the build directory
!build/

# Then re-ignore only the generated/artifact subdirectories:

# Generated PDF output (all scopes)
build/output/

# Temporary article preview files (generated by make article, cleaned after build)
build/_previews/_tmp-*

# TypeScript builder artifacts
build/builder/node_modules/
build/builder/dist/
build/builder/npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
