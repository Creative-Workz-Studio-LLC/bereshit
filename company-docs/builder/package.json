{
  "name": "@cws/manual-builder",
  "version": "1.0.0",
  "description": "Build system for CWS Company Identity Manual - AsciiDoc to multiple formats",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cws-build": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "manual:html": "node dist/cli.js --format html",
    "manual:pdf": "node dist/cli.js --format pdf",
    "manual:epub": "node dist/cli.js --format epub",
    "manual:all": "node dist/cli.js --format all",
    "manual:watch": "node dist/cli.js --watch",
    "clean": "node dist/cli.js --clean"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Creative Workz Studio LLC",
  "license": "UNLICENSED",
  "private": true
}
