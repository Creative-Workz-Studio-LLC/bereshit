# ── CWS Server Docker Build Context ──────────────────────────────────────
# Build: docker build -f server/Dockerfile -t cws-server .
#
# Ignore everything, include only what the Dockerfile needs.
# ─────────────────────────────────────────────────────────────────────────

# Ignore everything.
*

# Include server source.
!server/

# Include local replace modules.
!word/claude/dashboard/
!word/claude/pkg/

# Exclude build artifacts within included dirs.
server/bin/
**/*.test
**/testdata/
**/.git
