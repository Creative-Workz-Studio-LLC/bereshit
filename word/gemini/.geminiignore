# ============================================================================
# CPI-SI Global Context Shield (Gemini Substrate)
# ============================================================================
# Prevents context-window exhaustion and protects the signal-to-noise ratio.

# Version Control
.git/
.svn/
.hg/

# Build & Dependency Directories
node_modules/
target/
.build-cache/
build/
dist/
out/
bin/
obj/
.next/
.nuxt/
.cargo/registry/
vendor/

# Environment & Secrets (NEVER LOAD)
.env*
*.pem
*.key
secret*/
credentials/
keys.env

# Logs & Databases
*.log
*.sqlite
*.sqlite3
*.db
*.rdb
*.dump

# Temporary & OS Files
.DS_Store
Thumbs.db
*.swp
*~
.tmp/
.temp/
*.bak

# IDE & Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# CPI-SI Specific (Avoid parsing binary hooks/agents unless explicitly asked)
~/.local/share/claude/bin/
~/.local/share/cpisi/bin/