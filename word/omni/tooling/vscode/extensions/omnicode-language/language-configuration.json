{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    [">...>", "<...<"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?://|#)\\s*[═]{3,}\\s*$|^\\s*(?://|#)\\s*(?:OMNICODE PRAGMA|METADATA BLOCK|CONTENT BLOCK|CLOSING BLOCK|HEADER BLOCK|CONTEXT BLOCK|SETUP BLOCK|BODY BLOCK|FOOTER BLOCK)\\s*\\[",
      "end": "^\\s*(?://|#)\\s*END\\s+(?:PRAGMA|METADATA|CONTENT|CLOSING|HEADER|CONTEXT|SETUP|BODY|FOOTER)\\s*\\[END\\]"
    }
  },
  "wordPattern": "[a-zA-Z_@#][a-zA-Z0-9_-]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*:\\s*$|^\\s*(FUNCTION|PROGRAM|WHEN|OTHERWISE|REPEAT|THROUGH|FROM|ATTEMPT|RECOVER|ENSURE)\\b|^\\s*>>\\s+\\S+/\\s*$",
    "decreaseIndentPattern": "^\\s*(END|OTHERWISE)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*//\\s*[═]{3,}\\s*$",
      "afterText": "",
      "action": {
        "indent": "none",
        "appendText": "// "
      }
    }
  ]
}
