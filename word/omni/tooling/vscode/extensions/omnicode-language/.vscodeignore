# OmniCode Language — VSIX Ignore
# Exclude development files from packaged extension

# Source (TypeScript — only bundled JS ships)
src/**
tsconfig.json

# Development
.vscode/**
.vscode-test/**
test/**

# Build tooling (lives in ext4 cache, not here)
node_modules/**

# Documentation (README.md included by default)
INSTALL.md
CHANGELOG.md

# Git
.gitignore

# Editor files
*.swp
*.swo
*~
