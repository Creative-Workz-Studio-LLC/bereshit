    },
    "grammars": [
      {
        "scopeName": "omnicode.ecosystem.injection",
        "injectTo": [
          "source.go",
          "source.c",
          "source.cpp",
          "source.rust",
          "source.ts",
          "source.tsx",
          "source.js",
          "source.jsx",
          "source.python",
          "source.shell",
          "source.makefile",
          "source.toml",
          "source.yaml",
          "source.json.comments",
          "source.css",
          "source.csharp"
        ],
        "path": "./syntaxes/omnicode-injection.tmLanguage.json"
      },
      {
        "scopeName": "omnicode.ecosystem.jsonc-meta",
        "injectTo": [
          "source.json.comments",
          "source.json"
        ],
        "path": "./syntaxes/omnicode-jsonc-meta.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "name": "OmniCode — Block Boundaries (═══)",
            "scope": "markup.heading.block-boundary.omnicode, omnicode.structure.block-boundary",
            "settings": {
              "foreground": "#6A9955",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Section Boundaries (───)",
            "scope": "comment.line.section-boundary.omnicode, omnicode.structure.section-boundary",
            "settings": {
              "foreground": "#4E7A46"
            }
          },
          {
            "name": "OmniCode — Block/Section Tags [TAG]",
            "scope": "keyword.control.block.tag.omnicode, keyword.control.section.tag.omnicode, omnicode.tag",
            "settings": {
              "foreground": "#DCDCAA",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Block Names (METADATA BLOCK, etc.)",
            "scope": "keyword.control.block.name.omnicode, keyword.control.block.end.omnicode, omnicode.block-name",
            "settings": {
              "foreground": "#4EC9B0",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Section Addressing (P.1, M.1, Cc, etc.)",
            "scope": "entity.name.section.pragma.omnicode, entity.name.section.metadata.omnicode, entity.name.section.closing.omnicode, entity.name.section.content.omnicode, omnicode.section-address",
            "settings": {
              "foreground": "#9CDCFE",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Pragma Shebang (#!omni)",
            "scope": "keyword.control.pragma.shebang.omnicode",
            "settings": {
              "foreground": "#C586C0",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Pragma Type (folder, spec, template, etc.)",
            "scope": "entity.name.type.pragma.omnicode",
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "name": "OmniCode — Flags (--jsonc, --toml, etc.)",
            "scope": "keyword.operator.flag.omnicode",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "name": "OmniCode — Directives (@key, @type, @version, etc.)",
            "scope": "keyword.control.directive.omnicode",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "name": "OmniCode — Anchor (#anchor)",
            "scope": "keyword.control.anchor.omnicode",
            "settings": {
              "foreground": "#FFD700",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Anchor Value",
            "scope": "string.unquoted.anchor.omnicode",
            "settings": {
              "foreground": "#D4A76A"
            }
          },
          {
            "name": "OmniCode — Type Binding (::)",
            "scope": "keyword.operator.type-binding.omnicode",
            "settings": {
              "foreground": "#D4D4D4",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Containment (>>, =>, <-)",
            "scope": "keyword.operator.containment.child.omnicode, keyword.operator.containment.provides.omnicode, keyword.operator.containment.derives.omnicode",
            "settings": {
              "foreground": "#569CD6",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — File/Path Names",
            "scope": "entity.name.filename.omnicode, string.unquoted.path.omnicode",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "name": "OmniCode — Export Names",
            "scope": "variable.other.export.omnicode",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "name": "OmniCode — Control Flow Symbols (-->, ->|, \\->)",
            "scope": "keyword.control.proceed.omnicode, keyword.control.halt.omnicode, keyword.control.await.omnicode, keyword.control.backward.omnicode",
            "settings": {
              "foreground": "#C586C0",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Direction (->)",
            "scope": "keyword.operator.arrow.forward.omnicode",
            "settings": {
              "foreground": "#D4D4D4"
            }
          },
          {
            "name": "OmniCode — Branch (|)",
            "scope": "keyword.operator.branch.omnicode",
            "settings": {
              "foreground": "#D4D4D4"
            }
          },
          {
            "name": "OmniCode — Control Keywords (HALT, PROCEED, AWAIT)",
            "scope": "keyword.control.halt.omnicode, keyword.control.proceed.omnicode, keyword.control.await.omnicode, keyword.control.pivot.omnicode",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "name": "OmniCode — Response Affirm (YES, CONFIRMED)",
            "scope": "constant.language.affirm.omnicode",
            "settings": {
              "foreground": "#6A9955"
            }
          },
          {
            "name": "OmniCode — Response Negate (NO, DENIED)",
            "scope": "constant.language.negate.omnicode",
            "settings": {
              "foreground": "#F44747"
            }
          },
          {
            "name": "OmniCode — Response Acknowledge (NOTED, UNDERSTOOD)",
            "scope": "constant.language.acknowledge.omnicode",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "name": "OmniCode — Emphasis (BAM, ATTENTION, IMPORTANT)",
            "scope": "markup.bold.emphasis.omnicode",
            "settings": {
              "foreground": "#FF8C00",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Attention Critical (>!!! !!!>)",
            "scope": "markup.bold.attention.critical.omnicode",
            "settings": {
              "foreground": "#F44747",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Attention Warning (>!! !!>)",
            "scope": "markup.bold.attention.warning.omnicode",
            "settings": {
              "foreground": "#FF8C00",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Attention Notice (>! !>)",
            "scope": "markup.bold.attention.notice.omnicode",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "name": "OmniCode — Hebrew States",
            "scope": "support.type.hebrew.omnicode",
            "settings": {
              "foreground": "#FFD700"
            }
          },
          {
            "name": "OmniCode — Primitive Types",
            "scope": "support.type.primitive.omnicode",
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "name": "OmniCode — Covenant Values (granted, deferred, denied)",
            "scope": "constant.language.covenant.omnicode",
            "settings": {
              "foreground": "#B5CEA8"
            }
          },
          {
            "name": "OmniCode — Ternary Values (+1, -1)",
            "scope": "constant.numeric.trit.omnicode",
            "settings": {
              "foreground": "#B5CEA8",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniCode — Meta Fields (_ prefix)",
            "scope": "variable.other.meta.omnicode, omnicode.jsonc.meta-key",
            "settings": {
              "foreground": "#808080",
              "fontStyle": "italic"
            }
          },
          {
            "name": "OmniCode — Legend Parameters",
            "scope": "variable.parameter.legend.omnicode",
            "settings": {
              "foreground": "#9CDCFE",
              "fontStyle": "italic"
            }
          },
          {
            "name": "OmniCode — Flow Keywords (lower-case)",
            "scope": "keyword.control.flow.omnicode",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "name": "OmniCode — Declaration Keywords",
            "scope": "keyword.declaration.omnicode",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "name": "OmniCode — CPI-SI Keywords",
            "scope": "keyword.cpisi.health.omnicode, keyword.cpisi.state.omnicode, keyword.cpisi.dar.omnicode, keyword.cpisi.witness.omnicode, keyword.cpisi.operation.omnicode",
            "settings": {
              "foreground": "#4FC1FF"
            }
          },
          {
            "name": "OmniCode — High-level Entity Keywords (this, is, a, folder)",
            "scope": "keyword.control.entity.omnicode",
            "settings": {
              "foreground": "#569CD6"
            }
          },

          {
            "name": "OmniFold — Format Header Keys (ofd, source, compiled)",
            "scope": "entity.name.tag.header.omnifold",
            "settings": {
              "foreground": "#FFD700",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniFold — Required Section Keys (identity, state, attribution, children)",
            "scope": "entity.name.tag.section.required.omnifold",
            "settings": {
              "foreground": "#4EC9B0",
              "fontStyle": "bold"
            }
          },
          {
            "name": "OmniFold — Recommended Section Keys (grounding, dependencies, metadata)",
            "scope": "entity.name.tag.section.recommended.omnifold",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "name": "OmniFold — Optional Section Keys (declarations, observations, navigation)",
            "scope": "entity.name.tag.section.optional.omnifold",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "name": "OmniFold — Identity Field Keys (key, subtype, structure)",
            "scope": "support.type.property-name.identity.omnifold",
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "name": "OmniFold — State Field Keys (version, status, created, updated)",
            "scope": "support.type.property-name.state.omnifold",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "name": "OmniFold — Attribution Field Keys (architect, implementation, organization)",
            "scope": "support.type.property-name.attribution.omnifold",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "name": "OmniFold — Grounding Field Keys (scriptures, principle)",
            "scope": "support.type.property-name.grounding.omnifold",
            "settings": {
              "foreground": "#FFD700"
            }
          },
          {
            "name": "OmniFold — Dependency Field Keys (from, provides, derives)",
