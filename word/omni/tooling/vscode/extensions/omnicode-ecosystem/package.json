            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "name": "OmniFold — Child Field Keys (path, description)",
            "scope": "support.type.property-name.child.omnifold",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "name": "OmniFold — Detail Field Keys (text, reference, translation, role, design)",
            "scope": "support.type.property-name.detail.omnifold",
            "settings": {
              "foreground": "#D4D4D4"
            }
          }
        ]
      }
    }
  }
}
