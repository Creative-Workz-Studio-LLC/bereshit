{
  "name": "omnicode-ecosystem",
  "displayName": "OmniCode Ecosystem",
  "description": "OmniCode structural patterns across all file types — block markers, section tags, and operator conventions injected into comments of Go, C, Rust, TOML, JSONC, and more",
  "version": "0.2.1",
  "publisher": "creativeworkzstudio",
  "author": {
    "name": "CreativeWorkzStudio LLC",
    "url": "https://github.com/Creative-Workz-Studio-LLC"
  },
  "license": "Proprietary",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Creative-Workz-Studio-LLC/workspace"
  },
  "homepage": "https://github.com/Creative-Workz-Studio-LLC/workspace",
  "bugs": {
    "url": "https://github.com/Creative-Workz-Studio-LLC/workspace/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "omnicode",
    "omnifold",
    "ecosystem",
    "injection-grammar",
    "syntax-highlighting",
    "block-structure",
    "creativeworkzstudio"
  ],
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "contributes": {
    "configuration": {
      "title": "OmniCode Ecosystem",
      "properties": {

        "omnicode.colors.structure.blockBoundary": {
          "type": "string",
          "format": "color",
          "default": "#6A9955",
          "description": "Block boundaries (═══) — the structural separators between major blocks",
          "order": 1
        },
        "omnicode.colors.structure.sectionBoundary": {
          "type": "string",
          "format": "color",
          "default": "#4E7A46",
          "description": "Section boundaries (───) — lighter separators within blocks",
          "order": 2
        },
        "omnicode.colors.structure.tags": {
          "type": "string",
          "format": "color",
          "default": "#DCDCAA",
          "description": "Block and section tags — [PRAGMA], [METADATA], [CONTENT], [CLOSING], [END]",
          "order": 3
        },
        "omnicode.colors.structure.blockNames": {
          "type": "string",
          "format": "color",
          "default": "#4EC9B0",
          "description": "Block names — METADATA BLOCK, CONTENT BLOCK, END METADATA, etc.",
          "order": 4
        },
        "omnicode.colors.structure.sectionAddresses": {
          "type": "string",
          "format": "color",
          "default": "#9CDCFE",
          "description": "Section addressing — P.1, M.1, X.1, Cc, Co, Cv",
          "order": 5
        },

        "omnicode.colors.pragma.shebang": {
          "type": "string",
          "format": "color",
          "default": "#C586C0",
          "description": "Pragma shebang (#!omni) — the declaration line at the top of every .omni file",
          "order": 10
        },
        "omnicode.colors.pragma.type": {
          "type": "string",
          "format": "color",
          "default": "#4EC9B0",
          "description": "Pragma type (folder, spec, template, document, etc.)",
          "order": 11
        },
        "omnicode.colors.pragma.flags": {
          "type": "string",
          "format": "color",
          "default": "#CE9178",
          "description": "Pragma flags (--jsonc, --toml, --md, etc.)",
          "order": 12
        },

        "omnicode.colors.operators.directives": {
          "type": "string",
          "format": "color",
          "default": "#C586C0",
          "description": "Directives — @key, @type, @version, @authors, @status",
          "order": 20
        },
        "omnicode.colors.operators.anchor": {
          "type": "string",
          "format": "color",
          "default": "#FFD700",
          "description": "Anchor declarations (#anchor) — gold for the foundation point",
          "order": 21
        },
        "omnicode.colors.operators.anchorValue": {
          "type": "string",
          "format": "color",
          "default": "#D4A76A",
          "description": "Anchor values — the text following #anchor",
