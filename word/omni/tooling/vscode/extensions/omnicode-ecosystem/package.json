        "omnicode.colors.operators.containment": {
          "type": "string",
          "format": "color",
          "default": "#569CD6",
          "description": "Containment operators — >> (child), => (provides), <- (derives)",
          "order": 23
        },
        "omnicode.colors.operators.typeBinding": {
          "type": "string",
          "format": "color",
          "default": "#D4D4D4",
          "description": "Type binding operator (::) — binds a name to its type",
          "order": 24
        },
        "omnicode.colors.operators.controlFlow": {
          "type": "string",
          "format": "color",
          "default": "#C586C0",
          "description": "Control flow symbols — --> (proceed), ->| (halt), \\-> (await), <-- (backward)",
          "order": 25
        },
        "omnicode.colors.operators.direction": {
          "type": "string",
          "format": "color",
          "default": "#D4D4D4",
          "description": "Direction arrow (->) and branch pipe (|)",
          "order": 26
        },
        "omnicode.colors.operators.filePaths": {
          "type": "string",
          "format": "color",
          "default": "#CE9178",
          "description": "File and path names referenced in containment declarations",
          "order": 27
        },

        "omnicode.colors.language.controlKeywords": {
          "type": "string",
          "format": "color",
          "default": "#C586C0",
          "description": "Control keywords — HALT, PROCEED, AWAIT, PIVOT",
          "order": 30
        },
        "omnicode.colors.language.declarationKeywords": {
          "type": "string",
          "format": "color",
          "default": "#569CD6",
          "description": "Declaration keywords — this, is, a, folder, and entity-level words",
          "order": 31
        },
        "omnicode.colors.language.flowKeywords": {
          "type": "string",
          "format": "color",
          "default": "#C586C0",
          "description": "Flow keywords (lower-case) — when, then, from, through, repeat",
          "order": 32
        },
        "omnicode.colors.language.primitiveTypes": {
          "type": "string",
          "format": "color",
          "default": "#4EC9B0",
          "description": "Primitive types — trit, tryte, word, byte, truth, falsehood",
          "order": 33
        },
        "omnicode.colors.language.exports": {
          "type": "string",
          "format": "color",
          "default": "#DCDCAA",
          "description": "Export names in containment declarations",
          "order": 34
        },

        "omnicode.colors.response.affirm": {
          "type": "string",
          "format": "color",
          "default": "#6A9955",
          "description": "Affirmation responses — YES, CONFIRMED, GRANTED",
          "order": 40
        },
        "omnicode.colors.response.negate": {
          "type": "string",
          "format": "color",
          "default": "#F44747",
          "description": "Negation responses — NO, DENIED, REJECTED",
          "order": 41
        },
        "omnicode.colors.response.acknowledge": {
          "type": "string",
          "format": "color",
          "default": "#9CDCFE",
          "description": "Acknowledgment responses — NOTED, UNDERSTOOD, RECEIVED",
          "order": 42
        },

        "omnicode.colors.attention.critical": {
          "type": "string",
          "format": "color",
          "default": "#F44747",
          "description": "Critical attention markers (>!!! !!!>) — highest severity",
          "order": 50
        },
        "omnicode.colors.attention.warning": {
          "type": "string",
          "format": "color",
          "default": "#FF8C00",
          "description": "Warning attention markers (>!! !!>) — medium severity",
          "order": 51
        },
        "omnicode.colors.attention.notice": {
          "type": "string",
          "format": "color",
          "default": "#DCDCAA",
          "description": "Notice attention markers (>! !>) — informational",
          "order": 52
        },
        "omnicode.colors.attention.emphasis": {
          "type": "string",
          "format": "color",
          "default": "#FF8C00",
          "description": "Emphasis keywords — BAM, ATTENTION, IMPORTANT",
          "order": 53
        },

        "omnicode.colors.cpisi.hebrewStates": {
          "type": "string",
          "format": "color",
          "default": "#FFD700",
          "description": "Hebrew cognitive states — shavar, chaser, ratsah, yashar, tamim, shalem, tov",
          "order": 60
        },
        "omnicode.colors.cpisi.keywords": {
          "type": "string",
          "format": "color",
          "default": "#4FC1FF",
          "description": "CPI-SI keywords — health states, DAR operations, witness declarations",
          "order": 61
        },
        "omnicode.colors.cpisi.covenantValues": {
          "type": "string",
          "format": "color",
          "default": "#B5CEA8",
          "description": "Covenant values — granted, deferred, denied",
          "order": 62
        },
        "omnicode.colors.cpisi.ternaryValues": {
          "type": "string",
          "format": "color",
          "default": "#B5CEA8",
          "description": "Ternary values — +1, -1, balanced ternary constants",
          "order": 63
        },

        "omnicode.colors.meta.fields": {
          "type": "string",
          "format": "color",
          "default": "#808080",
          "description": "Meta fields (_ prefix) — _pragma, _P1_key, _metadata in JSONC files",
          "order": 70
        },
        "omnicode.colors.meta.legendParameters": {
          "type": "string",
          "format": "color",
          "default": "#9CDCFE",
          "description": "Legend parameters — named values in legend blocks",
          "order": 71
        },

        "omnicode.colors.omnifold.headerKeys": {
          "type": "string",
          "format": "color",
          "default": "#FFD700",
          "description": "OmniFold format header keys — ofd, source, compiled",
          "order": 80
        },
        "omnicode.colors.omnifold.requiredKeys": {
          "type": "string",
          "format": "color",
          "default": "#4EC9B0",
          "description": "OmniFold required section keys — identity, state, attribution, children",
          "order": 81
        },
        "omnicode.colors.omnifold.recommendedKeys": {
          "type": "string",
          "format": "color",
          "default": "#569CD6",
          "description": "OmniFold recommended section keys — grounding, dependencies, metadata",
          "order": 82
        },
        "omnicode.colors.omnifold.optionalKeys": {
          "type": "string",
          "format": "color",
          "default": "#9CDCFE",
          "description": "OmniFold optional section keys — declarations, observations, navigation",
          "order": 83
        },
        "omnicode.colors.omnifold.identityFields": {
          "type": "string",
          "format": "color",
          "default": "#4EC9B0",
          "description": "OmniFold identity section fields — key, subtype, structure",
          "order": 84
        },
        "omnicode.colors.omnifold.stateFields": {
          "type": "string",
          "format": "color",
          "default": "#9CDCFE",
          "description": "OmniFold state section fields — version, status, created, updated",
          "order": 85
        }
