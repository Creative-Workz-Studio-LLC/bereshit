// ═══════════════════════════════════════════════════════════════════════════
// FORMAT DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════
//
// Executable specification for transpiling this OmniCode code template
// to other programming languages. The transpiler reads this syntax.
//
// When using: #!omni code --[format]
// These definitions tell the transpiler HOW to convert each block.
//
// ═══════════════════════════════════════════════════════════════════════════

format definitions:

    format "go" for code:
        file extension ".go"
        derives from "bereshit/word/seed/go/B-word-seed-go-executable.go"

        pragma mapping:
            "#!omni code --go" emits:
                emit "// Code generated from OmniCode. DO NOT EDIT."
                emit "// Source: [source-file].omni"
                emit ""

        metadata mapping:
            "this is a [code] for" → package doc comment
            "keyed as" → // Key: [key] comment
            "grounded in: scripture" → // Biblical: [reference] comment
            "authored by" → // Authors: [list] comment
            "version" → // Version: [version] comment
            "exists to: purpose" → package doc first line

        setup mapping:
            "inputs of this work: requires" → import statements
            "from stdlib (1)" → standard library imports
            "from internal (0)" → internal package imports
            "from external (-1)" → third-party imports (go.mod)
            "definitions of this work: constants" → const block
            "definitions of this work: variables" → var block
            "definitions of this work: assemblies" → type struct definitions
            "definitions of this work: methods" → method receivers

        body mapping:
            "structure of this work: organized as" → // Architecture comment
            "implementation of this work: helpers" → unexported functions
            "implementation of this work: operations" → core functions
            "implementation of this work: recovery" → error handling functions
            "interface of this work: exposes: exported" → exported (Capitalized) functions
            "interface of this work: exposes: internal" → unexported functions

        closing mapping:
            "operations of this work: executed through: main" → func main()
            "operations of this work: cleaned by" → defer statements
            "synthesis of this work" → // See: comments

    format "c" for code:
        // [PLANNED] - C format support
        // Template: bereshit/word/seed/c/B-word-seed-c-executable.c
        // Status: Template not yet created
        file extension ".c"
        derives from "[PLANNED]"

        pragma mapping:
            "#!omni code --c" emits:
                emit "/* Code generated from OmniCode. DO NOT EDIT. */"
                emit "/* Source: [source-file].omni */"

        // Block mappings: [PLANNED]
        // Will follow 4-block pattern adapted to C conventions:
        //   METADATA → file header comment block
        //   SETUP → #include, #define, typedefs
        //   BODY → function implementations
        //   CLOSING → main(), cleanup

    format "rs" for code:
        // [PLANNED] - Rust format support
        // Template: bereshit/word/seed/rust/B-word-seed-rs-executable.rs
        // Status: Template not yet created
        file extension ".rs"
        derives from "[PLANNED]"

        pragma mapping:
            "#!omni code --rs" emits:
                emit "//! Code generated from OmniCode. DO NOT EDIT."
                emit "//! Source: [source-file].omni"

        // Block mappings: [PLANNED]
        // Will follow 4-block pattern adapted to Rust conventions:
        //   METADATA → //! doc comments
        //   SETUP → use statements, mod, type definitions
        //   BODY → impl blocks, functions
        //   CLOSING → fn main(), Drop traits

    format "sh" for code:
        file extension ".sh"
        derives from "bereshit/word/seed/code/B-word-seed-code-shell-4block.sh"

        pragma mapping:
            "#!omni code --sh" emits:
                emit "#!/usr/bin/env bash"
                emit "# Code generated from OmniCode. DO NOT EDIT."
                emit "# Source: [source-file].omni"
                emit ""

        metadata mapping:
            "this is a [code] for" → # [Name] - [description] header comment
            "keyed as" → # Key: [key] comment
            "grounded in: scripture" → # Scripture: [reference] comment
            "grounded in: principle" → # Principle: [principle] comment
            "grounded in: anchor" → # Anchor: [reference] comment
            "serves as" → # Component Type: [Ladder/Baton/Rails] comment
            "authored by" → # Authorship section
            "version" → # Version: [version] comment
            "exists to: purpose" → # Purpose: [purpose] comment
            "exists to: features" → # Key Features: list
            "interface: depends on" → # Dependencies section
            "interface: integrated as" → # Usage & Integration section
            "operational: blocking" → # Blocking Status section
            "operational: health" → # Health Scoring section

        setup mapping:
            "inputs of this work: requires: from stdlib" → # SCRIPT SETTINGS (set -euo pipefail)
            "inputs of this work: requires: from internal" → # SOURCES (source scripts)
            "inputs of this work: requires: from external" → # External tool dependencies (comments)
            "definitions of this work: constants" → # CONSTANTS (readonly declarations)
            "definitions of this work: variables" → # VARIABLES (mutable state)
            "definitions of this work: assemblies" → # associative arrays or structured data
            "definitions of this work: methods" → # UTILITY FUNCTIONS
            "infrastructure of this work: rails" → # INFRASTRUCTURE (logging, inspection)

        body mapping:
            "structure of this work: organized as: ladder" → # Org Chart comment documenting dependencies
            "structure of this work: organized as: baton" → # Execution Flow comment
            "implementation of this work: helpers" → # Helper Functions (internal)
            "implementation of this work: operations" → # Core Operations
            "implementation of this work: recovery" → # Error handling functions
            "interface of this work: exposes: exported" → # Public API functions
            "interface of this work: exposes: internal" → # Internal functions

        closing mapping:
            "operations of this work: verified by" → # Verification comments
            "operations of this work: executed through: main" → # Main execution block
            "operations of this work: cleaned by" → # Cleanup (trap handlers)
            "synthesis of this work" → # Reference comments (see: sections)

        type mapping:
            "word" → string variable (unquoted or "$var")
            "count" → integer variable
            "truth" → boolean (0=true, 1=false in shell convention)
            "gathering" → array (indexed or associative)
            "covenant" → exit code (0=granted, 1=denied, 2=deferred)

        control mapping:
            "when [condition]:" → if [[ condition ]]; then
            "otherwise:" → else
            "through gathering [var]:" → for item in "${array[@]}"; do
            "attempt:" → { (subshell or function call)
            "recover from [error]:" → } || { (error handler)
            "ensure:" → trap 'cleanup' EXIT
            "return [value]" → return [value] or exit [value]
            "witness [msg] with level [level]" → log_[level] "[msg]" or echo "[LEVEL] [msg]"

// ═══════════════════════════════════════════════════════════════════════════
// END FORMAT DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════
