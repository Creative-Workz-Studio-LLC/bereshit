// #!omni template --jsonc
// #!omni meta.key = B-word-seed-data-json-3block-config
// #!omni meta.from = bereshit/word/omni/seed/data.omni
// #!omni meta.at = template
// ============================================================================
// METADATA
// ============================================================================
//
// TEMPLATE: JSONC Configuration (3-Block Structure)
// STRUCTURE: METADATA → CONTENT → CLOSING
// USAGE: cp config.jsonc /path/to/new.jsonc → update pragma → fill brackets
//
// # M.1 Core Identity [IDENTITY]
//
//	Key:         [project-path-to-file]
//	Scripture:   "[Relevant verse]" — [Book Chapter:Verse]
//	Principle:   "[Kingdom principle this config demonstrates]"
//	Anchor:      "A workman that needeth not to be ashamed" — 2 Timothy 2:15
//
//	Type:        [Ladder/Baton/Rails] — See: word/glossary/paradigm/
//	Role:        [Specific responsibility in system architecture]
//	Dependency:  [PURE: self-contained | DEPENDED: extends other configs]
//
//	Architect:   [Who designed]
//	Created:     [YYYY-MM-DD]
//	Version:     [a-XX.XX]
//
//	Becomes:     settings.jsonc, launch.jsonc, [tool]-config.jsonc
//
// # M.2 Version History [HISTORY]
//
//   - [a-XX.XX] ([YYYY-MM-DD]) — [Brief description of changes]
//
// # M.3 Interface [INTERFACE]
//
//	Consumer:  [What uses this — VSCode, tool, extension]
//	Loader:    [How loaded — settings API, jsonc-parser, embed.FS]
//	Depends:   [Related — schema.json, handler.go, documentation]
//	Pattern:   jsonc.parse(content) → config.section.key
//
//	If Missing: [error | use defaults | create from template]
//
// # M.4 Operational [OPERATIONAL]
//
//	Blocking:  no (-1) — config files are declarative, not executable
//	Health:    Base100 | granted (1): valid | deferred (0): partial | denied (-1): parse error
//
//	On Error:  invalid value → [fallback to default | error]
//	           missing key   → [use default | require]
//	           parse fail    → [stop load | show location]
//
// ============================================================================
// END METADATA
// ============================================================================

// ============================================================================
// CONTENT
// ============================================================================
//
// # C.1 Schema [SCHEMA]
//
//	Format:    JSONC (JSON with comments, trailing commas allowed)
//	Order:     Core settings → Feature settings → Advanced settings
//
// # C.2 Values [VALUES]
//
{
  // -------------------------------------------------------------------------
  // [Section Name] — [Brief Description]
  // -------------------------------------------------------------------------

  "[section_key]": {
    // [Setting description]
    // Type: [string/number/boolean/array/object] | Default: [value]
    "[setting_name]": "[value]",
    "[another_setting]": "[value]"
  },

  "[another_section]": {
    "[key]": "[value]"
  },

  "[array_section]": [
    "[item1]",
    "[item2]"
  ]
}

// ============================================================================
// END CONTENT
// ============================================================================

// ============================================================================
// CLOSING
// ============================================================================
//
// # X.1 Verification [VERIFY]
//
//	Check:   npx jsonc-parser validate [filename].jsonc
//	Test:    [validation command or test path]
//	Issues:  trailing commas OK | check quotes | bracket matching
//
// # X.2 Policy [POLICY]
//
//	Safe:    Change values, add keys (if schema supports), add comments
//	Careful: Change key names, change types, remove keys
//	Never:   Break 3-block structure, remove required keys
//
//	Future:  planned: [features to add]
//	         considered: [possibilities being evaluated]
//	         rejected: [what won't change and why]
//
// # X.3 Synthesis [SYNTHESIS]
//
//	Scope:   [What this configuration controls]
//	Impact:  [What changes affect]
//	Note:    "A workman that needeth not to be ashamed" — 2 Timothy 2:15
//
// ============================================================================
// END CLOSING
// ============================================================================
