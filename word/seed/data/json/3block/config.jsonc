// ═══════════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════════
//
// 3-Block Structure: Configuration (Cc) → Operations (Co) → Verification (Cv)
// Cc-Cv Flow: how to set up → what exists → how to verify
//
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION [Cc]
// ───────────────────────────────────────────────────────────────────────────────

{
  // -------------------------------------------------------------------------
  // Cc.1 Identity [IDENTITY]
  // -------------------------------------------------------------------------
  //
  //   Configuration file identity and classification.
  //   Engine/system uses these fields for lookup and version tracking.
  //
  //   name:    [string] — Display name for this configuration
  //   type:    [string] — Category or classification
  //   scope:   [global | local | feature] — Where this config applies
  //   version: [a|b|c]-[PHASE].[COMPLETION] — Living versioning
  //
  "name": "[Configuration Name]",               // Display name
  "type": "[category]",                         // Classification

  "scope": "[global|local|feature]",            // Application scope
  "version": "a-01.00",                         // Living version

  // -------------------------------------------------------------------------
  // Cc.2 Defaults [DEFAULTS]
  // -------------------------------------------------------------------------
  //
  //   Default values and behavior settings.
  //   These can be overridden by consumers or inherited from here.
  //
  //   [setting]: [type] — [description] (default: [value])
  //
  "defaults": {
    "[setting_name]": "[value]",                // Description | Type
    "[another_setting]": "[value]"              // Description | Type
  },

  // -------------------------------------------------------------------------
  // Cc.3 [Custom] [CUSTOM]
  // -------------------------------------------------------------------------
  //
  //   File-specific configuration sections.
  //   Add sections here that are unique to this config's purpose.
  //
  //   (Example: triggers, connections, integrations, etc.)
  //

// ───────────────────────────────────────────────────────────────────────────────
// OPERATIONS [Co]
// ───────────────────────────────────────────────────────────────────────────────

  "[content_array]": [

    // -------------------------------------------------------------------------
    // Co.1 [Content Type] [TAG]
    // -------------------------------------------------------------------------
    //
    //   [Description of this content type.]
    //   [What it represents and when to use it.]
    //
    //   [field]: [type] — [description]
    //
    // [field]: [example]
    //
    {
      "[field]": "[value]"                      // Description
    }

    // -------------------------------------------------------------------------
    // Co.N [Additional Content Types]
    // -------------------------------------------------------------------------
    //
    //   Add Co sections as needed for each content type.
    //   Each section documents its structure in the schema comment.
    //
    //   Pattern: Header → Descriptor → Schema → Example values → Data
    //

  ],

// ───────────────────────────────────────────────────────────────────────────────
// VERIFICATION [Cv]
// ───────────────────────────────────────────────────────────────────────────────

  // -------------------------------------------------------------------------
  // Cv.1 Validation [VALIDATION]
  // -------------------------------------------------------------------------
  //
  //   Validation commands for this configuration.
  //   How to verify the file is valid and functional.
  //
  //   commands: [array] — Shell commands to validate
  //
  // commands: [build command, test command, run command]
  //
  "_validation": {
    "commands": [
      "[build_command]",                        // Build
      "[test_command]",                         // Test
      "[run_command]"                           // Run
    ]
  },

  // -------------------------------------------------------------------------
  // Cv.2 Schema [SCHEMA]
  // -------------------------------------------------------------------------
  //
  //   Schema manifest matching Cc and Co structure.
  //   Parser validates these fields exist.
  //
  //   required:      [array] — Required top-level keys (Cc.1, Cc.2, Co)
  //   optional:      [array] — Optional top-level keys (Cc.3)
  //   item_required: [array] — Required per item in Co arrays
  //   item_optional: [array] — Optional per item in Co arrays
  //
  "_schema": {
    "required": [
      "name",
      "type",
      "scope",
      "version",
      "defaults"
    ],
    "optional": [
      "[custom_fields]"
    ],
    "item_required": [
      "[per_item_required_fields]"
    ],
    "item_optional": [
      "[per_item_optional_fields]"
    ]
  },

  // -------------------------------------------------------------------------
  // Cv.3 Maintenance [MAINTENANCE]
  // -------------------------------------------------------------------------
  //
  //   Modification rules for this configuration.
  //   What's safe, what needs care, what to never touch.
  //
  //   safe:    [array] — Safe to modify
  //   careful: [array] — Modify with care
  //   never:   [array] — Never modify
  //
  "_maintenance": {
    "safe": [
      "Update values within documented constraints",
      "Add comments explaining settings",
      "Add new keys following existing patterns"
    ],
    "careful": [
      "Change key names (breaks consuming code)",
      "Change value types (breaks parsing)",
      "Remove keys (may break dependencies)"
    ],
    "never": [
      "Break 3-block structure",
      "Remove required schema fields",
      "Remove Cv verification sections"
    ]
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// END CONTENT
