{
  "$pragma": "omni template --json",
  "$meta": {
    "key": "TAL-TEMPLATE-DATA-JSON",
    "from": "bereshit/word/omni/seed/B-word-omni-seed-data.omni",
    "at": "template"
  },

  "_template": {
    "name": "JSON Data (3-Block Structure)",
    "structure": "METADATA -> CONTENT -> CLOSING",
    "usage": "cp data.json /path/to/new.json -> update $meta -> fill brackets",
    "becomes": ["token-data.json", "keyword-table.json", "type-mappings.json"]
  },

  "_metadata": {
    "_m1_identity": {
      "_schema": {
        "key": "[PROJECT-DATA-###] — Unique identifier",
        "title": "[Title] — What this file is",
        "type": "Data",
        "component": "[Ladder/Baton/Rails] — Architectural role",
        "role": "[Specific responsibility in system]"
      },
      "key": "TAL-TEMPLATE-DATA-JSON",
      "title": "JSON Data Template",
      "type": "Data",
      "component": "Template",
      "role": "Provides 3-block structure for JSON data files"
    },

    "_m2_state": {
      "_schema": {
        "status": "Draft | Active | Deprecated | Archived",
        "version": "a-XX.XX — Living versioning",
        "created": "YYYY-MM-DD",
        "updated": "YYYY-MM-DD"
      },
      "status": "Active",
      "version": "a-01.00",
      "created": "2026-01-03",
      "updated": "2026-01-03"
    },

    "_m3_attribution": {
      "_schema": {
        "authors": "[Name (Role)]",
        "organization": "[Company]",
        "copyright": "[© YYYY Company]"
      },
      "authors": "Seanje Lenox-Wise (Architect), Nova Dawn (Author)",
      "organization": "CreativeWorkzStudio LLC",
      "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    "_m4_location": {
      "_schema": {
        "path": "[/path/to/file]"
      },
      "path": "templates/data/data.json"
    },

    "_m5_derivation": {
      "_schema": {
        "derives_from": "[path/to/parent/template] — file template copied from",
        "note": "pragma meta.from = OmniCode spec; derives_from = file lineage"
      },
      "derives_from": "Bereshit/word/seed/data/json/3block/data.json"
    },

    "_m6_classification": {
      "_schema": {
        "tags": "[tag1, tag2, tag3] — discovery"
      },
      "tags": "data, json, template, 3-block"
    },

    "_m7_intent": {
      "_schema": {
        "purpose": "[Enables X for Y] — one-line purpose statement",
        "core_design": "[Architectural pattern or paradigm]",
        "philosophy": "[Guiding principle for how this works]"
      },
      "purpose": "Define structured data — key-value pairs for application consumption",
      "core_design": "JSON format — strict, machine-parseable, no comments",
      "philosophy": "Language definition in data, algorithm in code"
    },

    "_m8_grounding": {
      "_schema": {
        "scripture": "[Book Chapter:Verse] — grounding verse for this component",
        "principle": "[Kingdom principle demonstrated]",
        "anchor": "[Supporting verse] — reinforcing principle (optional)"
      },
      "scripture": "2 Timothy 2:15 — A workman that needeth not to be ashamed",
      "principle": "Excellence in data structure — rightly dividing the content",
      "anchor": "Proverbs 24:27 — Prepare thy work without"
    },

    "_m9_dependencies": {
      "_schema": {
        "what_this_needs": {
          "system_tools": "[json parser, jq, etc.]",
          "external": "[None | tool with version]",
          "internal": "[None | project files this depends on]"
        },
        "what_uses_this": {
          "commands": "[tools that consume this data]",
          "processes": "[workflows that depend on this]"
        },
        "integration_points": "[How consumers read and apply data]"
      },
      "what_this_needs": {
        "system_tools": "JSON parser (json.Unmarshal, JSON.parse, etc.)",
        "external": "None",
        "internal": "None — standalone data"
      },
      "what_uses_this": {
        "commands": "Application that consumes data",
        "processes": "Build, runtime, import workflows"
      },
      "integration_points": "json.Unmarshal(content, &data) -> data.section.key"
    },

    "_m10_roadmap": {
      "_schema": {
        "planned": "[Future additions]",
        "considered": "[Possibilities being evaluated]"
      },
      "planned": "Schema validation support",
      "considered": "Type coercion helpers"
    }
  },

  "_content": {
    "_cc_configuration": {
      "_schema": {
        "purpose": "Configuration — how to read this file",
        "contains": "Format rules and conventions"
      },
      "format": "JSON (strict — no comments, no trailing commas)",
      "order": "Schema definition -> Data values",
      "encoding": "UTF-8, no BOM",
      "key_convention": "lowercase_with_underscores"
    },

    "_co_operations": {
      "_schema": {
        "purpose": "Data values — the actual content",
        "patterns": "Organized by section, documented by _schema keys"
      },
      "[section_key]": {
        "[field_name]": "[value]",
        "[nested_key]": {
          "[inner_key]": "[inner_value]"
        }
      },
      "[array_section]": [
        "[item1]",
        "[item2]"
      ]
    },

    "_cv_verification": {
      "_cv1_validation": {
        "_schema": {
          "purpose": "Verify data is valid",
          "commands": "JSON parsers, schema validators"
        },
        "check": "python -m json.tool [filename].json",
        "test": "go test ./pkg/[consumer]/... -run TestDataLoad",
        "issues": {
          "parse_error": "no trailing commas | check quotes | bracket matching",
          "encoding": "UTF-8 required | no BOM",
          "type_mismatch": "verify Go struct tags match JSON keys"
        }
      },
      "_cv2_schema": {
        "_schema": {
          "purpose": "Type checking and required fields",
          "contains": "Schema reference if applicable"
        },
        "schema_path": "[path/to/schema.json if exists]",
        "required_keys": "[list of keys that must be present]"
      },
      "_cv3_maintenance": {
        "_schema": {
          "purpose": "Safe modification guidance",
          "levels": "Safe / Careful / Never"
        },
        "safe": "Add entries following pattern, change values within constraints",
        "careful": "Change key names (breaks code), change types (breaks parse)",
        "never": "Break 3-block structure, remove required keys without updating consumers"
      }
    }
  },

  "_closing": {
    "_x1_policy": {
      "_schema": {
        "purpose": "Guide future maintainers — what's safe to change",
        "contains": "Safe / Careful / Never modification levels"
      },
      "safe": [
        "Add new data sections (_co.*)",
        "Add entries following existing patterns",
        "Add _schema keys explaining structure"
      ],
      "careful": [
        "Change key names (breaks consuming code)",
        "Change value types (breaks parsing)",
        "Remove keys (may break dependencies)"
      ],
      "never": [
        "3-block structure (_metadata, _content, _closing)",
        "Remove required keys without updating consumers",
        "Remove _cv.* verification sections"
      ],
      "validation": "See _cv_verification for commands"
    },

    "_x2_extension": {
      "_schema": {
        "purpose": "How to expand this data — mirrors M.10 Roadmap",
        "contains": "Extension patterns, planned additions"
      },
      "adding_sections": [
        "Add _co_* section with _schema docstring",
        "Add keys organized by purpose",
        "Document expected types in _schema"
      ],
      "adding_keys": [
        "Place in appropriate _co_* section",
        "Add _schema comment if type is unclear",
        "Update schema.json if applicable"
      ],
      "architecture": "See _content for _cc/_co/_cv structure",
      "roadmap": "See _m10_roadmap for planned additions"
    },

    "_x3_troubleshooting": {
      "_schema": {
        "purpose": "Common problems and solutions — JSON issues"
      },
      "unexpected_token": [
        "Check for missing commas between keys",
        "Verify all strings are quoted",
        "Check bracket/brace matching"
      ],
      "trailing_comma_error": [
        "JSON is strict — remove trailing commas",
        "Use JSONC parser if comments needed"
      ],
      "type_mismatch": [
        "Verify Go struct tags match JSON keys",
        "Check expected vs actual types"
      ],
      "note": "Data-specific troubleshooting in _co_* _schema docstrings"
    },

    "_x4_reference": {
      "_schema": {
        "purpose": "Quick lookup — copy-paste ready commands"
      },
      "validation": {
        "syntax": "python -m json.tool [file].json",
        "pretty": "jq '.' [file].json"
      },
      "parsing_go": "json.Unmarshal(content, &data)",
      "parsing_node": "JSON.parse(content)",
      "parsing_python": "json.loads(content)"
    },

    "_x5_note": {
      "_schema": {
        "purpose": "Final guidance and grounding — echoes M.8",
        "verse": "2 Timothy 2:15"
      },
      "summary": "This data template provides 3-block structure for JSON files.",
      "principle": "Language definition in data, algorithm in code.",
      "verse": "A workman that needeth not to be ashamed, rightly dividing the word of truth. — 2 Timothy 2:15"
    },

    "_x6_template": {
      "_schema": {
        "purpose": "How to use this template — remove when instantiating",
        "usage": "cp data.json /path/to/new.json -> update $meta -> fill brackets"
      },
      "update_on_instantiation": [
        "_m1_identity: key, title",
        "_m2_state: created/updated dates",
        "_m4_location: path",
        "_m5_derivation: derives_from (point to this template)",
        "_m9_dependencies: if applicable",
        "_m10_roadmap: planned data additions",
        "_co_*: actual data values"
      ],
      "note": "Remove _x6_template section when instantiating"
    },

    "_x7_omission": {
      "_schema": {
        "purpose": "What can be reserved and why — guidance for CLOSING sections"
      },
      "rule": "All sections must be present. Empty sections use _schema only.",
      "guidance": "Omit subsection content, never the subsection header itself."
    }
  }
}
