{
  "$pragma": "omni template --json",
  "$meta": {
    "key": "B-word-seed-data-json-4block-data",
    "from": "bereshit/word/omni/seed/data.omni",
    "at": "template"
  },

  "_template": {
    "name": "JSON Data (4-Block Structure)",
    "structure": "METADATA -> SETUP -> BODY -> CLOSING",
    "usage": "cp data.json /path/to/new.json -> update $meta -> fill brackets",
    "becomes": ["token-data.json", "keyword-table.json", "type-mappings.json"],
    "see": "word/seed/code/go/library.go > SETUP for full pattern"
  },

  "_metadata": {
    "_m1_identity": {
      "key": "[project-path-to-file]",
      "scripture": "[Relevant verse] - [Book Chapter:Verse]",
      "principle": "[Kingdom principle this data demonstrates]",
      "anchor": "A workman that needeth not to be ashamed - 2 Timothy 2:15",

      "type": "[Ladder/Baton/Rails] - See: word/glossary/paradigm/",
      "role": "[Specific responsibility in system architecture]",
      "dependency": "[PURE: self-contained | DEPENDED: references other files]",

      "architect": "[Who designed]",
      "created": "[YYYY-MM-DD]",
      "version": "[a-XX.XX]"
    },

    "_m2_history": [
      "[a-XX.XX] ([YYYY-MM-DD]) - [Brief description]"
    ],

    "_m3_interface": {
      "consumer": "[What uses this - pkg/lexer, pkg/parser, tool]",
      "loader": "[How loaded - embed.FS, json.Unmarshal, import]",
      "depends": "[Related - schema.json, loader.go, documentation]",
      "pattern": "json.Unmarshal(content, &data) -> data.section.key",
      "if_missing": "[compile error (embedded) | runtime panic | use defaults]"
    },

    "_m4_operational": {
      "blocking": "no (-1) - data files are declarative, not executable",
      "health": "Base100 | granted (1): valid | deferred (0): partial | denied (-1): parse error",

      "on_error": {
        "invalid_entry": "[skip entry | error | use default]",
        "missing_required": "[compile error | runtime panic]",
        "type_mismatch": "[parse error | coercion]"
      }
    },

    "_m5_paradigm": {
      "philosophy": "Language Definition in Data, Algorithm in Code",

      "data_holds": [
        "Type definitions and categories",
        "Keyword lists and reserved words",
        "Lookup tables and mappings",
        "Configuration values"
      ],

      "code_holds": [
        "Parsing algorithms",
        "Validation logic",
        "Transformation functions",
        "Error handling"
      ]
    }
  },

  "_setup": {
    "_s1_file": {
      "key": "[DATA-KEY-###]",
      "consumer": "[package/system that reads this]",
      "loader": "[how loaded - json.Unmarshal, embed.FS]"
    },

    "_s2_constants": {
      "_reserved": "JSON data files ARE constants - values defined in BODY"
    },

    "_s3_variables": {
      "_reserved": "JSON data files don't hold mutable state"
    },

    "_s4_related": {
      "code": "[path/to/loader.go - processes this data]",
      "docs": "[path/to/documentation]",
      "schema": "[path/to/schema.json - if validation exists]",
      "tests": "[path/to/loader_test.go]"
    },

    "_s5_behaviors": {
      "_reserved": "JSON data files have no executable behaviors"
    },

    "_s6_usage": {
      "when": "[startup (embed) | on-demand | cached after first load]",
      "if_missing": "[compile error | runtime panic | use defaults]",
      "validation": "[Go struct tags | custom validator | schema]"
    }
  },

  "_body": {
    "_b1_structure": {
      "organization": "Schema definition -> Data values",
      "json_features": "Strict JSON - no comments, no trailing commas",
      "encoding": "UTF-8, no BOM",
      "section_flow": "[schema_key] -> [data_key] -> [more_data]"
    },

    "_b2_values": {
      "[section_key]": {
        "[field_name]": "[value]",
        "[nested_key]": {
          "[inner_key]": "[inner_value]"
        }
      },

      "[array_section]": [
        "[item1]",
        "[item2]"
      ]
    }
  },

  "_closing": {
    "_x1_verify": {
      "check": "python -m json.tool [filename].json",
      "test": "go test ./pkg/[consumer]/... -run TestDataLoad",
      "issues": {
        "parse_error": "no trailing commas | check quotes | bracket matching",
        "encoding": "UTF-8 required | no BOM",
        "type_mismatch": "verify Go struct tags match JSON keys"
      }
    },

    "_x2_policy": {
      "safe": "Add entries following pattern, update values within constraints",
      "careful": "Change key names (breaks code), change types (breaks parse)",
      "never": "Break 4-block structure, remove required keys without updating code",

      "future": {
        "planned": "[features to add]",
        "considered": "[possibilities being evaluated]",
        "rejected": "[what won't change and why]"
      }
    },

    "_x3_synthesis": {
      "scope": "[What this data file defines]",
      "impact": "[What changes affect]",
      "note": "A workman that needeth not to be ashamed - 2 Timothy 2:15"
    }
  }
}
