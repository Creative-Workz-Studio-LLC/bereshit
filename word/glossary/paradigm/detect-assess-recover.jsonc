  // ============================================================================
  // CONTENT
  // ============================================================================
  "definition": "The DAR pattern — Detect (notice deviation), Assess (evaluate severity and context), Recover (apply atomic correction). The linter detects, the schema assesses, the transformer recovers.",

  "phases": {
    "detect": "Notice deviation from standard — Linter produces LintResult",
    "assess": "Evaluate severity and context — Schema provides form constraints and severity",
    "recover": "Apply atomic correction — Transformer produces corrected output"
  },

  "atomic_action": {
    "self_contained": "Each fix carries all information needed to apply it",
    "traceable": "Every fix links back to the detecting rule",
    "composable": "Multiple fixes compose without conflict"
  },

  "k_factor_mapping": {
    "growth": "k=0, errors only — minimal correction",
    "balance": "k=0.5, errors + warnings — correct structure",
    "strict": "k=+1, 0E 0W 0I — scaffold toward fullness"
  },

  "building_block_connection": {
    "detect": "-1 — break down, trace toward what's wrong",
    "assess": "0 — anchor, the schema is the immutable standard",
    "recover": "+1 — build up, construct the correction from standard"
  },

  "biblical_connection": "God searches His sheep and seeks them out (Ezek 34:11-12). DAR is the shepherd pattern — detect the scattered, assess where they are, recover them.",

  // ============================================================================
  // CLOSING
  // ============================================================================
  "see_also": ["schema-template-linter-triangle", "building-block-method", "form-awareness"],
  "companion_doc": "detect-assess-recover.adoc"
}
