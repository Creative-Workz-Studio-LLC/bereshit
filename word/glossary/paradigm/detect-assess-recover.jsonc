  "metadata": {
    "key": "GLOSS-PAR-008",
    "term": "detect-assess-recover",
    "category": "paradigm",
    "status": "active",
    "created": "2026-02-20",
    "authors": ["Nova Dawn", "Seanje Lenox-Wise"],
    "biblical_foundation": "Ezekiel 34:11-12"
