  // ============================================================================
  // CONTENT
  // ============================================================================
  "definition": "Multiple system components evolving from the same source of truth simultaneously — one schema change enables detection, generation, and template alignment in parallel",

  "key_insight": "Not multiple people working but multiple system components growing from the same schema. The schema IS the coordinator — zero coordination overhead.",

  "example": "Adding identity_groups to the Rust schema simultaneously gives the linter validation data, the transformer generation data, and the template its standard.",

  "distinction": {
    "not_parallel": "Multiple developers on same file, concurrent but independent, coordination overhead",
    "parallel": "Multiple system components from same schema, simultaneous growth from shared truth, zero coordination"
  },

