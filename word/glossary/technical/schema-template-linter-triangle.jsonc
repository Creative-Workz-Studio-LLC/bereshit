  // ============================================================================
  // CONTENT
  // ============================================================================
  "definition": "The collapse of schema, template, and linter into a single source of truth — schema DEFINES what's correct, template EMBODIES it, linter ENFORCES it, transformer PRODUCES it",

  "four_faces": {
    "schema": "DEFINES correctness (rust-4block-schema.jsonc)",
    "template": "EMBODIES the standard (exists.rs — schema made flesh)",
    "linter": "ENFORCES compliance (cws-struct lint)",
    "transformer": "PRODUCES correct output (cws-struct transform)"
  },

  "why_matters": "When collapsed, maintain ONE thing and three others stay in sync by definition. Foundation of parallel development.",

  "biblical_connection": "A just weight (Proverbs 11:1) — one standard of measure, not different scales for linter vs transformer",

  // ============================================================================
  // CLOSING
