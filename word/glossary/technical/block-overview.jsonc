  // ============================================================================
  // CONTENT
  // ============================================================================
  "definition": "Purpose statement + section order list at the start of each structural block — orients the reader and declares the file's organizational contract",

  "structure": [
    "Purpose statement — what this block does",
    "Section order — bracket-tagged list in dependency order",
    "Status markers — RESERVED for structurally prohibited sections"
  ],

  "bracket_format": {
    "setup_body": "Numbered [N] tags: [1] Imports, [2] Modules, etc.",
    "closing": "Named tags: [Cv] Closing Validation, [X1] Modification Policy, etc.",
    "why": "Bracket format avoids false-positive zone detection and subsection pattern matching. CLOSING discovered this first; SETUP/BODY learned it."
  },

  "biblical_connection": "Nehemiah surveyed the walls before rebuilding (Neh 2:13-15). The overview is the survey — see the whole structure before working on any part.",

