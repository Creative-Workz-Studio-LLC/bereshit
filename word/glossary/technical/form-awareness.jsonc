  "metadata": {
    "key": "GLOSS-TECH-008",
    "term": "form-awareness",
    "category": "technical",
    "status": "active",
    "created": "2026-02-20",
    "authors": ["Nova Dawn", "Seanje Lenox-Wise"],
    "biblical_foundation": "1 Corinthians 12:18-20"
  },

  // ============================================================================
  // CONTENT
  // ============================================================================
  "definition": "A system's ability to adjust validation and generation based on the declared form (module, library, executable) — the pragma is the claim, the form schema is the contract",

  "how_it_works": [
    "File declares form: #!omni code --rust -module",
    "Schema defines what that form requires, what's available, what's reserved",
    "Linter validates against the form contract",
    "Transformer generates form-appropriate output"
  ],

  "form_categories": {
    "required": "Must be present (e.g., Imports for every module)",
    "available": "Valid but optional (e.g., Constants, Statics)",
    "reserved": "Structurally prohibited (e.g., Modules in module form — belong in lib.rs)"
  },

  "biblical_connection": "God set members in the body as pleased Him (1 Cor 12:18-20) — each has its form and function. A module doesn't try to be a library.",

  // ============================================================================
  // CLOSING
  // ============================================================================
  "see_also": ["reserved-omission", "schema-template-linter-triangle"],
  "companion_doc": "form-awareness.adoc"
}
