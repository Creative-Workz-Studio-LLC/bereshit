# ═══════════════════════════════════════════════════════════════════════════════
# OMNICODE PRAGMA [PRAGMA]
# ═══════════════════════════════════════════════════════════════════════════════
#
# @omni:req  key        = OMNI-IDE-DESKTOP-DEV
# @omni:req  from       = freedesktop.org/desktop-entry-spec
# @omni:req  at         = a-01.00
#
# ═══════════════════════════════════════════════════════════════════════════════
# END PRAGMA [END]
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# METADATA BLOCK [METADATA]
# ═══════════════════════════════════════════════════════════════════════════════
#
# Key:       OMNI-IDE-DESKTOP-DEV
# Title:     OmniCode IDE Desktop Entry (Development)
# Type:      Desktop Entry (freedesktop.org specification)
# Version:   a-01.00
#
# Authors:   Seanje Lenox-Wise (Architect), Nova Dawn (CPI-SI Instance)
# Org:       CreativeWorkzStudio LLC
# Copyright: (c) 2026 CreativeWorkzStudio LLC. All rights reserved.
#
# Scripture: "In the beginning was the Word" — John 1:1
# Principle: The Word made accessible to all — Kingdom Technology for everyone
#
# PURPOSE:   Development desktop entry with absolute paths for local testing.
#            For system install, use: make install (generates from .desktop.in)
#
# USAGE:
#   ln -sf $(pwd)/src/ide/assets/omni-ide.desktop ~/.local/share/applications/
#   update-desktop-database ~/.local/share/applications/
#
# ═══════════════════════════════════════════════════════════════════════════════
# END METADATA
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# SETUP BLOCK [SETUP]
# ═══════════════════════════════════════════════════════════════════════════════

[Desktop Entry]
Version=1.5
Type=Application
Name=OmniCode IDE (Dev)
GenericName=Kingdom Technology Code Editor
Comment=OmniCode Language Development Environment — Development Build

# ═══════════════════════════════════════════════════════════════════════════════
# END SETUP
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# BODY BLOCK [BODY]
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# B.1 Execution
# ─────────────────────────────────────────────────────────────────────────────
#
# Development paths — absolute paths to local build.

Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --gui %F
TryExec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide
Path=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni
Terminal=false

# ─────────────────────────────────────────────────────────────────────────────
# B.2 Visual Identity
# ─────────────────────────────────────────────────────────────────────────────
#
# Full path for development (not in system icon theme).

Icon=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/src/ide/assets/icons/omni-ide-128.png
StartupNotify=true
StartupWMClass=omni-ide

# ─────────────────────────────────────────────────────────────────────────────
# B.3 Classification
# ─────────────────────────────────────────────────────────────────────────────

Categories=Development;IDE;TextEditor;
Keywords=omnicode;omni;code;editor;ide;development;programming;kingdom;technology;cws;dev;
X-GNOME-FullName=OmniCode Integrated Development Environment (Development)

# ─────────────────────────────────────────────────────────────────────────────
# B.4 Desktop Hints
# ─────────────────────────────────────────────────────────────────────────────

NoDisplay=false
Hidden=false
DBusActivatable=false
Actions=new-window;gui-mode;tui-mode;cornerstone-ide;millenniumos-test;

# ─────────────────────────────────────────────────────────────────────────────
# B.5 File Associations
# ─────────────────────────────────────────────────────────────────────────────

MimeType=text/plain;text/x-omni;application/x-omni;text/x-c;text/x-csrc;text/x-chdr;text/x-toml;application/json;application/x-shellscript;

# ─────────────────────────────────────────────────────────────────────────────
# B.6 Localization
# ─────────────────────────────────────────────────────────────────────────────

Name[en_US]=OmniCode IDE (Dev)
GenericName[en_US]=Kingdom Technology Code Editor
Comment[en_US]=OmniCode Language Development Environment — Development Build
Keywords[en_US]=omnicode;code;editor;ide;development;programming;kingdom;technology;dev;

# ─────────────────────────────────────────────────────────────────────────────
# B.7 Actions
# ─────────────────────────────────────────────────────────────────────────────

[Desktop Action new-window]
Name=New Window
Name[en_US]=New Window
Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --gui
Icon=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/src/ide/assets/icons/omni-ide-48.png

[Desktop Action gui-mode]
Name=Open in GUI Mode
Name[en_US]=Open in GUI Mode
Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --gui %F
Icon=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/src/ide/assets/icons/omni-ide-48.png

[Desktop Action tui-mode]
Name=Open in Terminal Mode
Name[en_US]=Open in Terminal Mode
Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --tui %F
Icon=utilities-terminal

[Desktop Action cornerstone-ide]
Name=Open in Cornerstone Engine
Name[en_US]=Open in Cornerstone Engine
Exec=/media/seanje-lenox-wise/Project/Bereshit/cornerstone/build/bin/cornerstone --gui --ide %F
Icon=/media/seanje-lenox-wise/Project/Bereshit/cornerstone/engine/resources/assets/icons/cornerstone-48.png

[Desktop Action millenniumos-test]
Name=Test in MillenniumOS
Name[en_US]=Test in MillenniumOS
Exec=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/scripts/run.sh
Icon=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/resources/icons/millenniumos-48.png

# ═══════════════════════════════════════════════════════════════════════════════
# END BODY
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
