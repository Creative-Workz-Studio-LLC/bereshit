#
# "In the beginning was the Word, and the Word was with God, and the Word
# was God." — John 1:1
#
# DEVELOPMENT FILE: Uses absolute paths to development location.
# For system installation: make install (uses omni-ide.desktop.in template)
#
# To use this development desktop file:
#   ln -sf $(pwd)/src/ide/assets/omni-ide.desktop ~/.local/share/applications/
#   update-desktop-database ~/.local/share/applications/
#
# ═══════════════════════════════════════════════════════════════════════════════
