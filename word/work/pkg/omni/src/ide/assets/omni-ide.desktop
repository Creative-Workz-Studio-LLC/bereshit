# =============================================================================
# DESKTOP ENTRY [Desktop Entry]
# =============================================================================
#
# Primary application definition following freedesktop.org Desktop Entry
# Specification v1.5. This file enables system integration for the OmniCode
# IDE across Linux desktop environments (GNOME, KDE, XFCE, etc.).
#
# Reference: https://specifications.freedesktop.org/desktop-entry-spec/latest/
#
# =============================================================================

[Desktop Entry]

# -----------------------------------------------------------------------------
# Core Identity
# -----------------------------------------------------------------------------

# Specification version (required)
Version=1.5

# Entry type: Application, Link, or Directory
Type=Application

# Human-readable name (required)
Name=OmniCode IDE

# Generic software category name
GenericName=Code Editor

# Tooltip/description shown in menus
Comment=OmniCode Language Development Environment — Kingdom Technology

# -----------------------------------------------------------------------------
# Execution
# -----------------------------------------------------------------------------

# Command to execute (%F = file list, %U = URL list)
# Direct path - Path= sets working directory
Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --gui %F

# Working directory (may not be honored by all desktop environments)
Path=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni

# Run in terminal window? (No - GUI mode)
Terminal=false

# Try to execute with specific environment
TryExec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide

# -----------------------------------------------------------------------------
# Visual Identity
# -----------------------------------------------------------------------------

# Icon name (without extension, searched in icon theme)
Icon=omni-ide

# Startup notification support
StartupNotify=true

# WM_CLASS hint for window matching
StartupWMClass=omni-ide

# -----------------------------------------------------------------------------
# Classification & Discovery
# -----------------------------------------------------------------------------

# Main categories (freedesktop.org registered categories)
# Development = programming tools
# IDE = integrated development environment
# TextEditor = text editing capability
# Utility = general utility (required for TextEditor category)
Categories=Development;IDE;TextEditor;Utility;

# Additional categories for better discoverability
X-GNOME-FullName=OmniCode Integrated Development Environment
X-KDE-SubstituteUID=false

# Search keywords (semicolon-separated)
Keywords=omnicode;omni;code;editor;ide;development;programming;text;kingdom;technology;creativeworkz;

# -----------------------------------------------------------------------------
# File Associations
# -----------------------------------------------------------------------------

# MIME types this application can open
MimeType=text/plain;text/x-omni;application/x-omni;text/x-c;text/x-csrc;text/x-chdr;text/x-toml;application/json;application/x-shellscript;

# -----------------------------------------------------------------------------
# Desktop Environment Hints
# -----------------------------------------------------------------------------

# Show in all desktop environments
NoDisplay=false

# Not hidden
Hidden=false

# Note: Omitting OnlyShowIn/NotShowIn means show in all environments

# Use D-Bus activation (if available)
DBusActivatable=false

# Registered actions (right-click menu options)
Actions=new-window;build-project;run-project;run-cornerstone;gui-mode;tui-mode;cli-mode;

# -----------------------------------------------------------------------------
# Localization (English primary, expandable)
# -----------------------------------------------------------------------------

Name[en_US]=OmniCode IDE
GenericName[en_US]=Code Editor
Comment[en_US]=OmniCode Language Development Environment — Kingdom Technology
Keywords[en_US]=omnicode;code;editor;ide;development;programming;kingdom;technology;

# =============================================================================
# END DESKTOP ENTRY
# =============================================================================

# =============================================================================
# ACTIONS [Desktop Action *]
# =============================================================================
#
# Additional actions accessible from right-click menu or application launchers.
# Provides quick access to different display modes (tripwire fallback chain).
#
# =============================================================================

# -----------------------------------------------------------------------------
# Action: New Window
# -----------------------------------------------------------------------------

[Desktop Action new-window]
Name=New Window
Name[en_US]=New Window
Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --gui

# -----------------------------------------------------------------------------
# Action: Build Project
# -----------------------------------------------------------------------------

[Desktop Action build-project]
Name=Build Project
Name[en_US]=Build Project
Exec=gnome-terminal -- /media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --build %F
Icon=system-run

# -----------------------------------------------------------------------------
# Action: Run Project
# -----------------------------------------------------------------------------

[Desktop Action run-project]
Name=Run Project
Name[en_US]=Run Project
Exec=gnome-terminal -- /media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --run %F
Icon=media-playback-start

# -----------------------------------------------------------------------------
# Action: Run in Cornerstone
# -----------------------------------------------------------------------------

[Desktop Action run-cornerstone]
Name=Run in Cornerstone
Name[en_US]=Run in Cornerstone
Exec=/media/seanje-lenox-wise/Project/Bereshit/cornerstone/build/cornerstone --game %F
Icon=cornerstone

# -----------------------------------------------------------------------------
# Action: Open in GUI Mode (Default)
# -----------------------------------------------------------------------------

[Desktop Action gui-mode]
Name=Open in GUI Mode
Name[en_US]=Open in GUI Mode
Exec=/media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --gui %F
Icon=omni-ide

# -----------------------------------------------------------------------------
# Action: Open in TUI Mode (Terminal)
# -----------------------------------------------------------------------------

[Desktop Action tui-mode]
Name=Open in Terminal Mode
Name[en_US]=Open in Terminal Mode
Exec=gnome-terminal -- /media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --tui %F
Icon=utilities-terminal

# -----------------------------------------------------------------------------
# Action: Open in CLI Mode (Minimal)
# -----------------------------------------------------------------------------

[Desktop Action cli-mode]
Name=Open in CLI Mode
Name[en_US]=Open in CLI Mode
Exec=gnome-terminal -- /media/seanje-lenox-wise/Project/Bereshit/word/work/pkg/omni/build/omni-ide --cli %F
Icon=utilities-terminal

# =============================================================================
# END ACTIONS
# =============================================================================

# =============================================================================
# CLOSING
# =============================================================================
#
# "In the beginning was the Word, and the Word was with God, and the Word
# was God." — John 1:1
#
# OmniCode IDE: Where words become reality. Kingdom Technology serving all.
#
# Installation:
#   sudo cp omni-ide.desktop /usr/local/share/applications/
#   sudo update-desktop-database
#
