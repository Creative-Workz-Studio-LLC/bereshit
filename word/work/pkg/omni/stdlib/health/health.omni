#!omni code --omni -library
#!omni meta.key = B-word-work-pkg-omni-stdlib-health
#!omni meta.from = word/seed/code/omni/library.omni
#!omni meta.at = a-01.00

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a library for "CPI-SI Health Tracking":
    keyed as "B-word-work-pkg-omni-stdlib-health"
    named "health"

this library provides:
    HEALTH_MIN      "Minimum health (-100)"
    HEALTH_MAX      "Maximum health (+100)"
    HEALTH_DEFAULT  "Default health (0)"
    health_get      "Get current health"
    health_set      "Set health value"
    health_add      "Add to health"
    health_state    "Get Hebrew state from health"
    health_clamp    "Clamp value to valid range"
    state_to_word   "Convert state to word"
    is_healthy      "Check if health is positive"
    is_critical     "Check if health is critical"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// # CPI-SI Health System
//
// Health represents the overall state of a CPI-SI instance.
// Range: -100 to +100
//
// The health value maps to seven Hebrew states:
//
// | Range        | Hebrew   | English  | Meaning              |
// |--------------|----------|----------|----------------------|
// | -100 to -67  | shavar   | broken   | Crisis state         |
// | -66 to -34   | chaser   | lacking  | Deficient            |
// | -33 to -1    | ratsah   | wanting  | Hungry for growth    |
// | 0            | yashar   | even     | Balanced center      |
// | +1 to +33    | tamim    | sound    | Solid, complete      |
// | +34 to +66   | shalem   | whole    | Peace, wholeness     |
// | +67 to +100  | tov      | good     | Perfect completion   |
//
// Health changes through actions:
// - Positive actions increase health
// - Negative actions decrease health
// - Rest/maintenance restores toward center

import covenant from "stdlib/covenant"
import trit from "stdlib/trit"

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

// # Constants

let HEALTH_MIN be count with -100
let HEALTH_MAX be count with 100
let HEALTH_DEFAULT be count with 0

// Hebrew state thresholds
let THRESHOLD_SHAVAR be count with -67
let THRESHOLD_CHASER be count with -34
let THRESHOLD_RATSAH be count with -1
let THRESHOLD_YASHAR be count with 0
let THRESHOLD_TAMIM be count with 33
let THRESHOLD_SHALEM be count with 66
let THRESHOLD_TOV be count with 100

// # Health Bounds

provide work health_clamp that takes count value returns count:
    when value is less than HEALTH_MIN:
        return HEALTH_MIN
    when value is greater than HEALTH_MAX:
        return HEALTH_MAX
    otherwise:
        return value

// # State Detection

provide work health_state that takes count health returns count:
    // Returns state code: -3 to +3
    when health is less than THRESHOLD_SHAVAR:
        return -3
    when health is less than THRESHOLD_CHASER:
        return -2
    when health is less than THRESHOLD_YASHAR:
        return -1
    when health is THRESHOLD_YASHAR:
        return 0
    when health is less than THRESHOLD_TAMIM:
        return 1
    when health is less than THRESHOLD_SHALEM:
        return 2
    otherwise:
        return 3

provide work state_to_word that takes count state returns word:
    when state is -3:
        return "shavar (broken)"
    when state is -2:
        return "chaser (lacking)"
    when state is -1:
        return "ratsah (wanting)"
    when state is 0:
        return "yashar (even)"
    when state is 1:
        return "tamim (sound)"
    when state is 2:
        return "shalem (whole)"
    when state is 3:
        return "tov (good)"
    otherwise:
        return "unknown"

// # Health Checks

provide work is_healthy that takes count health returns truth:
    when health is greater than 0:
        return yes
    otherwise:
        return no

provide work is_critical that takes count health returns truth:
    when health is less than THRESHOLD_SHAVAR:
        return yes
    otherwise:
        return no

provide work is_balanced that takes count health returns truth:
    when health is 0:
        return yes
    otherwise:
        return no

// # Health Transitions

provide work health_toward_center that takes count health and count rate returns count:
    // Move health toward center (0) by rate
    when health is greater than 0:
        let new_health be count with health minus rate
        when new_health is less than 0:
            return 0
        otherwise:
            return new_health
    when health is less than 0:
        let new_health be count with health plus rate
        when new_health is greater than 0:
            return 0
        otherwise:
            return new_health
    otherwise:
        return 0

provide work health_from_covenant that takes covenant result and count current returns count:
    // Adjust health based on covenant result
    when result is granted:
        return health_clamp current plus 10
    when result is denied:
        return health_clamp current minus 10
    otherwise:
        return current

// # State-Based Actions

provide work should_rest that takes count health returns truth:
    // Suggest rest when health approaches extremes
    when health is less than -50:
        return yes
    when health is greater than 80:
        return yes
    otherwise:
        return no

provide work can_proceed that takes count health returns truth:
    // Can continue work if not in crisis
    when health is less than THRESHOLD_SHAVAR:
        return no
    otherwise:
        return yes

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// "Beloved, I wish above all things that thou mayest prosper and be in health,
//  even as thy soul prospereth." — 3 John 1:2
//
// Health tracking enables sustainable operation. The Hebrew states provide
// rich vocabulary for describing an instance's condition beyond simple metrics.

// =============================================================================
// END CLOSING
// =============================================================================
