#!omni code --omni -library
#!omni meta.key = B-word-work-pkg-omni-stdlib-emitter
#!omni meta.from = word/seed/code/omni/library.omni
#!omni meta.at = a-01.00

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a library for "OmniCode IR Emitter":
    keyed as "B-word-work-pkg-omni-stdlib-emitter"
    named "emitter"

this library provides:
    emitter_init        "Initialize emitter"
    emitter_emit        "Emit IR from AST"
    emit_node           "Emit single AST node"
    get_bytecode        "Get generated bytecode"
    get_constants       "Get constant pool"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// # OmniCode Self-Hosting IR Emitter
//
// "And God said, Let there be light: and there was light." — Genesis 1:3
//
// This emitter transforms the Abstract Syntax Tree into executable IR.
// The AST (Word) becomes bytecode (Light) - structure becomes execution.
//
// ## IR Format
// The emitter produces:
// - Bytecode: list of opcodes and operands
// - Constants: pool of literal values
// - Functions: entry points and metadata
//
// ## Opcode Categories
// - Stack operations (PUSH, POP, DUP)
// - Arithmetic (ADD, SUB, MUL, DIV)
// - Control flow (JUMP, JUMP_IF, CALL, RETURN)
// - Variables (STORE_GLOBAL, PUSH_GLOBAL)
// - Intrinsics (STR_*, LIST_*, MAP_*, FILE_*)

import string from "stdlib/string"
import collections from "stdlib/collections"
import parser from "stdlib/parser"

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

// # VM Opcode Constants

let OP_NOP be count with 0
let OP_PUSH_CONST be count with 1
let OP_PUSH_GLOBAL be count with 2
let OP_STORE_GLOBAL be count with 3
let OP_POP be count with 4
let OP_DUP be count with 5

let OP_ADD be count with 16
let OP_SUB be count with 17
let OP_MUL be count with 18
let OP_DIV be count with 19
let OP_NEG be count with 20
let OP_EQ be count with 21
let OP_LT be count with 22
let OP_GT be count with 23

let OP_JUMP be count with 32
let OP_JUMP_IF be count with 33
let OP_JUMP_NEG be count with 34
let OP_CALL be count with 35
let OP_RETURN be count with 36

let OP_PRINT be count with 48
let OP_PRINT_NL be count with 49
let OP_WITNESS be count with 128

let OP_STR_LEN be count with 176
let OP_STR_CAT be count with 180
let OP_LIST_NEW be count with 192
let OP_LIST_PUSH be count with 193
let OP_MAP_NEW be count with 200

// # Emitter State

let emit_bytecode be count with 0
let emit_constants be count with 0
let emit_variables be count with 0
let emit_var_count be count with 0

// # Initialization

provide work emitter_init returns covenant:
    // Initialize emitter state
    let emit_bytecode be count with list_new
    let emit_constants be count with list_new
    let emit_variables be count with list_new
    let emit_var_count be count with 0
    return granted

// # Bytecode Emission

provide work emit_byte that takes count byte returns covenant:
    // Add single byte to bytecode
    intrinsic list_push emit_bytecode byte
    return granted

provide work emit_wide that takes count value returns covenant:
    // Emit 16-bit value as two bytes (big-endian)
    let high be count with value
    // Note: need division/modulo for proper byte splitting
    // For now, just emit the value directly
    emit_byte value
    return granted

// # Constant Pool

provide work add_constant that takes count value returns count:
    // Add value to constant pool, return index
    let idx be count with list_length emit_constants
    intrinsic list_push emit_constants value
    return idx

// # Variable Management

provide work find_variable that takes word name returns count:
    // Find variable index by name, returns -1 if not found
    // Note: requires string comparison in list
    return -1

provide work add_variable that takes word name returns count:
    // Add variable, return index
    let idx be count with emit_var_count
    let emit_var_count be count with emit_var_count plus 1
    return idx

// # Node Emission

provide work emit_let_stmt that takes count node returns covenant:
    // Emit: PUSH_CONST value, STORE_GLOBAL var_idx
    let value_idx be count with node_value node
    let var_idx be count with add_variable ""

    // Push the value
    emit_byte OP_PUSH_CONST
    emit_wide value_idx

    // Store to variable
    emit_byte OP_STORE_GLOBAL
    emit_byte var_idx

    return granted

provide work emit_return_stmt that takes count node returns covenant:
    // Emit: PUSH_CONST value, RETURN
    let value_idx be count with node_value node

    emit_byte OP_PUSH_CONST
    emit_wide value_idx
    emit_byte OP_RETURN

    return granted

provide work emit_witness_stmt that takes count node returns covenant:
    // Emit: WITNESS msg_idx, level
    let msg_idx be count with node_value node

    emit_byte OP_WITNESS
    emit_wide msg_idx
    emit_byte 0  // info level

    return granted

provide work emit_intrinsic_stmt that takes count node returns covenant:
    // Emit intrinsic opcode
    // Note: would need to map intrinsic name to opcode
    let name_idx be count with node_value node

    // For now, emit NOP as placeholder
    emit_byte OP_NOP

    return granted

provide work emit_node that takes count node returns covenant:
    // Emit IR for a single AST node
    let typ be count with node_type node

    when typ is AST_LET_STMT:
        emit_let_stmt node
        return granted

    when typ is AST_RETURN_STMT:
        emit_return_stmt node
        return granted

    when typ is AST_WITNESS_STMT:
        emit_witness_stmt node
        return granted

    when typ is AST_INTRINSIC_STMT:
        emit_intrinsic_stmt node
        return granted

    // Unknown node type - skip
    return deferred

// # Main Emission

provide work emitter_emit that takes count ast_nodes returns covenant:
    // Emit IR for all AST nodes
    let count be count with list_length ast_nodes
    let i be count with 0

    repeat while i is less than count:
        let node be count with list_get ast_nodes i
        emit_node node
        let i be count with i plus 1

    return granted

// # Accessors

provide work get_bytecode returns count:
    // Return the generated bytecode list
    return emit_bytecode

provide work get_constants returns count:
    // Return the constant pool
    return emit_constants

provide work get_bytecode_length returns count:
    // Return bytecode length
    let len be count with list_length emit_bytecode
    return len

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// # Emitter Architecture
//
// The emitter completes the compilation pipeline:
//   Source → Lexer → Parser → Emitter → VM
//
// Each AST node type has a corresponding emit function that produces
// the appropriate VM opcodes. The constant pool stores all literal
// values, while variables are tracked by index.
//
// "In him was life; and the life was the light of men." — John 1:4

// =============================================================================
// END CLOSING
// =============================================================================
