# Litestream — R2 Credentials
# Copy to /home/seanje/.config/litestream/env
# chmod 600 /home/seanje/.config/litestream/env
#
# Same R2 API token as Restic backups, different env var names.
# Litestream reads LITESTREAM_ACCESS_KEY_ID / LITESTREAM_SECRET_ACCESS_KEY

LITESTREAM_ACCESS_KEY_ID=<your-r2-access-key-id>
LITESTREAM_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
