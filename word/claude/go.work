// ============================================================================
// METADATA - Claude Production Workspace
// ============================================================================
// Purpose: Go workspace for production Claude hooks (bereshit/word/claude)
// Note: This is the PRODUCTION location (symlinked from ~/.claude)
//       For development, use claude-global/go.work which includes entrypoints
//
// Structure:
//   hooks/            - Session and tool lifecycle hooks
//   pkg/              - Shared packages (cognition, statemachine, hookoutput, etc.)
//   statusline/       - Status line implementation
//   skills/*/scripts/ - Skill Go scripts

go 1.24.4

use (
	./hooks
	./pkg
	./statusline
	./skills/create-code/scripts
	./skills/create-data/scripts
	./skills/create-documentation/scripts
	./skills/create-from-template/scripts
	./skills/create-journal-entry/scripts
	./skills/format-lookup/scripts
	./skills/integrate-learning/scripts
	./skills/meta-awareness/scripts
	./skills/propagate-change/scripts
	./skills/recognize-pattern/scripts
	./skills/recognize-stopping-point/scripts
	./skills/reflect-on-session/scripts
	./skills/session-awareness/scripts
	./skills/validate-omni/scripts
)
