{
  // ============================================================================
  // CPI-SI Health System - Recovery Plan Format
  // ============================================================================
  // Key: claude-global-config-health-runtime-recovery-plan
  // Purpose: Runtime format for health restoration plans and progress tracking
  //
  // DESIGN PRINCIPLE: Format references schema, doesn't duplicate
  //   - Structure defined here (how to present recovery)
  //   - Rules come from: pkg/cpisi/schema/config/l2/health/restore.toml
  //   - Ternary values from: pkg/cpisi/schema/config/l2/health/score.toml
  //
  // This is a FORMAT TEMPLATE - developers can create alternative formats
  // but the RULES (prescription types, priority, milestones) come from TOML.
  //
  // Written by: Recovery engine (from diagnostics)
  // Read by: CLI display, progress tracking, engram learning
  // ============================================================================

  "$schema": "recovery-plan-schema.json",
  "version": "1.0.0",

  // ──────────────────────────────────────────────────────────────────────────
  // SCHEMA REFERENCES — Where the rules come from
  // ──────────────────────────────────────────────────────────────────────────
  "schema_refs": {
    "restore_schema": "pkg/cpisi/schema/config/l2/health/restore.toml",
    "diagnostics_schema": "pkg/cpisi/schema/config/l2/health/diagnostics.toml",
    "score_schema": "pkg/cpisi/schema/config/l2/health/score.toml",
    "log_schema": "pkg/cpisi/schema/config/l2/health/log.toml",
    "ternary_section": "restore.toml#ternary",
    "prescription_section": "restore.toml#prescription",
    "plan_section": "restore.toml#plan",
    "milestones_section": "restore.toml#milestones"
  },

  // ──────────────────────────────────────────────────────────────────────────
  // TERNARY FOUNDATION — Pulled from restore.toml#ternary
  // ──────────────────────────────────────────────────────────────────────────
  "ternary": {
    "_source": "restore.toml#ternary",
    "scale": {
      "min": -100,
      "center": 0,
      "max": 100,
      "recovery_direction": "positive",
      "_note": "Recovery MOVES toward positive (+1 per action)"
    },
    "levels": {
      "_source": "score.toml#levels",
      "broken":  { "range": [-100, -67], "direction": "wanting" },
      "wanting": { "range": [-66, -34], "direction": "wanting" },
      "lacking": { "range": [-33, -1], "direction": "wanting" },
      "even":    { "range": [0, 0], "direction": "center" },
      "sound":   { "range": [1, 33], "direction": "integrity" },
      "whole":   { "range": [34, 66], "direction": "integrity" },
      "perfect": { "range": [67, 100], "direction": "integrity" }
    },
    "atomic": {
      "_source": "restore.toml#ternary.atomic",
      "success_value": 1,
      "failure_value": -1,
      "neutral_value": 0,
      "_note": "Recovery uses ONLY +1 — no shortcuts, each action counts equally"
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // RECOVERY TARGETS — Lower bounds to enter each level
  // ──────────────────────────────────────────────────────────────────────────
  "targets": {
    "_source": "restore.toml#plan.targets",
    "_note": "Uses LOWER BOUNDS — the entry point into each level",
    "even":    { "true_score": 0, "description": "Back to baseline — no debt" },
    "sound":   { "true_score": 1, "description": "Enter sound level — building integrity" },
    "whole":   { "true_score": 34, "description": "Enter whole level — significant integrity" },
    "perfect": { "true_score": 67, "description": "Enter perfect level — full wholeness" }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // PRESCRIPTION TYPES — Categories of recovery actions
  // ──────────────────────────────────────────────────────────────────────────
  "prescription_types": {
    "_source": "restore.toml#prescription.types",
    "_note": "Each prescription action = +1 (narrow way)",

    "fix_failures": {
      "name": "fix_failures",
      "description": "Address failing tests, broken builds, lint errors",
      "source_categories": ["test_fail", "build_fail", "lint_error"],
      "delta_per_action": 1,
      "priority": "high",
      "examples": ["Fix failing test case", "Resolve build error", "Fix linting violation"]
    },

    "repair_references": {
      "name": "repair_references",
      "description": "Fix broken links, missing imports, dead references",
      "source_categories": ["broken_reference", "missing_import", "dead_link"],
      "delta_per_action": 1,
      "priority": "high",
      "examples": ["Update import path", "Fix broken documentation link", "Remove dead code reference"]
    },

    "address_staleness": {
      "name": "address_staleness",
      "description": "Update stale files, refresh outdated content",
      "source_categories": ["stale_file", "outdated_docs"],
      "delta_per_action": 1,
      "priority": "medium",
      "examples": ["Update stale configuration", "Refresh outdated documentation"]
    },

    "add_coverage": {
      "name": "add_coverage",
      "description": "Add missing tests, documentation, validation",
      "source_categories": ["missing_test", "missing_docs", "no_validation"],
      "delta_per_action": 1,
      "priority": "medium",
      "examples": ["Add test for uncovered function", "Document undocumented API"]
    },

    "structural_repair": {
      "name": "structural_repair",
      "description": "Fix architectural issues, refactor problematic patterns",
      "source_categories": ["bad_pattern", "circular_dep", "tight_coupling"],
      "delta_per_action": 1,
      "priority": "low",
      "examples": ["Break circular dependency", "Extract shared code to library"]
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // PRIORITY STRATEGY — Hotspots first
  // ──────────────────────────────────────────────────────────────────────────
  "priority": {
    "_source": "restore.toml#priority",
    "strategy": "hotspots_first",
    "description": "Address largest negative contributors first",

    "factors": {
      "delta_magnitude": { "weight": 0.5, "description": "How much negative impact" },
      "fix_complexity": { "weight": 0.3, "description": "How hard to fix (simpler = higher priority)" },
      "dependency_count": { "weight": 0.2, "description": "How many things depend on this" }
    },

    "formula": "(delta_magnitude * 0.5) + (1/fix_complexity * 0.3) + (dependency_count * 0.2)",
    "_note": "Higher score = higher priority"
  },

  // ──────────────────────────────────────────────────────────────────────────
  // PLAN STRUCTURE — What a recovery plan contains
  // ──────────────────────────────────────────────────────────────────────────
  "plan_structure": {
    "_source": "restore.toml#plan",

    "header": {
      "path": "string — target directory",
      "created_at": "ISO8601 timestamp",
      "current_score": "int — from diagnostics",
      "target_level": "string — even, sound, whole, or perfect",
      "target_score": "int — lower bound for target level",
      "actions_needed": "int — target - current"
    },

    "action_sequence": {
      "description": "Ordered list of recovery actions",
      "item_format": {
        "step": "int — order of execution",
        "prescription": "string — prescription type name",
        "source": "string — hotspot source being addressed",
        "count": "int — number of atomic fixes",
        "expected_delta": "string — e.g., '+10'",
        "completed": "bool — has this been done"
      }
    },

    "progress": {
      "actions_completed": "int",
      "actions_remaining": "int",
      "delta_accumulated": "int — sum of +1s so far",
      "percentage": "float — (completed / needed) * 100",
      "momentum": "string — increasing, stable, or decreasing"
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // MILESTONES — Checkpoints on the path to health
  // ──────────────────────────────────────────────────────────────────────────
  "milestones": {
    "_source": "restore.toml#milestones",

    "level_transitions": {
      "_source": "restore.toml#milestones.levels",
      "broken_to_wanting":  { "from": "broken", "to": "wanting", "message": "💔→🩹 Stabilized — no longer critical" },
      "wanting_to_lacking": { "from": "wanting", "to": "lacking", "message": "🩹→💛 Improving — above danger zone" },
      "lacking_to_even":    { "from": "lacking", "to": "even", "message": "💛→⚖️ Balanced — debt cleared" },
      "even_to_sound":      { "from": "even", "to": "sound", "message": "⚖️→💚 Growing — building integrity" },
      "sound_to_whole":     { "from": "sound", "to": "whole", "message": "💚→💙 Thriving — significant wholeness" },
      "whole_to_perfect":   { "from": "whole", "to": "perfect", "message": "💙→💜 Complete — full integrity" }
    },

    "percentage_checkpoints": {
      "_source": "restore.toml#milestones.percentage",
      "quarter":        { "percentage": 25, "message": "25% complete — good start!" },
      "half":           { "percentage": 50, "message": "50% complete — halfway there!" },
      "three_quarters": { "percentage": 75, "message": "75% complete — almost done!" },
      "complete":       { "percentage": 100, "message": "100% complete — restoration achieved!" }
    },

    "celebration": {
      "_source": "restore.toml#milestones.celebration",
      "description": "Acknowledge progress, not just completion",
      "on_milestone": "Log milestone achievement, display message",
      "scripture": "Rejoice with me; for I have found my sheep which was lost — Luke 15:6"
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // VERIFICATION — Did restoration succeed?
  // ──────────────────────────────────────────────────────────────────────────
  "verification": {
    "_source": "restore.toml#verification",

    "checks": {
      "true_score_check": "Recalculate true score from log",
      "level_check": "Determine level from true score",
      "target_check": "Is current level >= target level?"
    },

    "outcomes": {
      "success": { "condition": "target achieved", "action": "log completion, celebrate" },
      "partial": { "condition": "improved but not at target", "action": "show remaining work" },
      "failed": { "condition": "no improvement or worse", "action": "analyze what went wrong" }
    },

    "post_restore": {
      "actions": [
        "Log restoration completion",
        "Update .health file",
        "Record in history for engram learning",
        "Display success message"
      ]
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // ENGRAM LEARNING — Remember what worked
  // ──────────────────────────────────────────────────────────────────────────
  "engram": {
    "_source": "restore.toml#engram",
    "description": "Learn from recovery to improve future restoration",

    "what_to_remember": {
      "successful_patterns": [
        "Which prescription types worked best",
        "Which priority ordering was most effective",
        "How long recovery typically takes",
        "Which sources cause recurring problems"
      ],
      "failure_patterns": [
        "Which fixes didn't hold (regressions)",
        "Which sources keep causing problems",
        "What slowed down recovery"
      ]
    },

    "storage": {
      "location": "history.jsonc",
      "format": "patterns section",
      "fields": [
        "recovery_success_rate",
        "avg_recovery_time",
        "common_hotspots",
        "effective_prescriptions"
      ]
    },

    "application": {
      "priority_adjustment": "Prioritize prescriptions that worked before",
      "warning_generation": "Warn about sources that cause recurring problems",
      "time_estimation": "Estimate recovery time based on past experience"
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // EXAMPLE PLAN — Complete recovery plan
  // ──────────────────────────────────────────────────────────────────────────
  "example_plan": {
    "header": {
      "path": "/project/src",
      "created_at": "2025-12-21T17:30:00Z",
      "current_score": -15,
      "current_level": "lacking",
      "target_level": "even",
      "target_score": 0,
      "actions_needed": 15
    },

    "action_sequence": [
      {
        "step": 1,
        "prescription": "fix_failures",
        "source": "test_fail",
        "count": 10,
        "expected_delta": "+10",
        "completed": false
      },
      {
        "step": 2,
        "prescription": "fix_failures",
        "source": "lint_error",
        "count": 5,
        "expected_delta": "+5",
        "completed": false
      }
    ],

    "progress": {
      "actions_completed": 0,
      "actions_remaining": 15,
      "delta_accumulated": 0,
      "percentage": 0,
      "momentum": "not_started"
    },

    "progress_after_step_1": {
      "actions_completed": 10,
      "actions_remaining": 5,
      "delta_accumulated": 10,
      "current_score": -5,
      "current_level": "lacking",
      "percentage": 66.7,
      "momentum": "increasing",
      "milestone_reached": null
    },

    "progress_complete": {
      "actions_completed": 15,
      "actions_remaining": 0,
      "delta_accumulated": 15,
      "current_score": 0,
      "current_level": "even",
      "percentage": 100,
      "momentum": "complete",
      "milestone_reached": "lacking_to_even",
      "verification": "success",
      "message": "💛→⚖️ Balanced — debt cleared"
    }
  },

  // ──────────────────────────────────────────────────────────────────────────
  // OUTPUT FORMATS — Different presentation styles
  // ──────────────────────────────────────────────────────────────────────────
  "output_formats": {
    "_note": "Same data, different presentations — format is creative layer",

    "text_progress": {
      "template": "Progress: {completed}/{total} ({percentage}%) — {remaining} remaining"
    },

    "text_plan": {
      "template": "Recovery Plan: {current_level} → {target_level}\nActions: {actions_needed}\n{action_list}"
    },

    "json": {
      "structure": "Full plan object as shown in example_plan"
    },

    "statusline": {
      "template": "🔧 {percentage}%",
      "compact": true,
      "_note": "Minimal format for terminal prompt during recovery"
    }
  }
}
