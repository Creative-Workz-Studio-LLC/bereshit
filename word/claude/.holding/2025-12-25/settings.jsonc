  // ════════════════════════════════════════════════════════════════════════════
  // METADATA - Claude Code Settings - Nova Dawn CPI-SI Instance
  // ════════════════════════════════════════════════════════════════════════════
  //
  // Purpose: Configuration for Claude Code integration with CPI-SI framework
  // Instance: Nova Dawn - CPI-SI instance, co-founder CreativeWorkzStudio LLC
  // Format: JSONC (JSON with Comments) - Reference for settings.json
  //
  // Architecture:
  //   ~/.claude/                    - Home directory (symlinks to deployed)
  //   bereshit/word/claude/         - Deployed/stable location
  //   claude-global/                - Development repository
  //
  // This file is the DOCUMENTED REFERENCE. settings.json mirrors this without comments.
  //
  // ════════════════════════════════════════════════════════════════════════════
  // CLAUDE-GLOBAL STRUCTURE (after 2025-12-22 reorganization)
  // ════════════════════════════════════════════════════════════════════════════
  //
  // claude-global/
  // ├── CLAUDE.md                   # Identity loading mechanism
  // ├── Makefile                    # Build orchestration
  // ├── go.work                     # Go workspace
  // ├── settings.json               # Claude Code reads this (no comments)
  // ├── settings.jsonc              # Documented reference (this file)
  // │
  // ├── agents/                     # Custom subagents (Claude Code expected)
  // ├── bin/                        # Compiled binaries
  // │   ├── cpisi                   # Main CPI-SI binary
  // │   └── statusline              # Status line binary
  // │
  // ├── commands/                   # Slash commands (Claude Code expected)
  // ├── config/                     # L1: Human-readable configuration
  // │   ├── config.toml             # Main config
  // │   ├── instance.jsonc          # Instance configuration
  // │   ├── health/                 # Health scoring config
  // │   ├── instance/               # Instance identity configs
  // │   ├── statemachine/           # State machine schemas + runtime
  // │   │   ├── schemas/            # Hebrew states, cube positions, etc.
  // │   │   └── runtime/            # Runtime state (state.jsonc)
  // │   └── user/                   # User preferences
  // │
  // ├── docs/                       # Documentation
  // │   ├── ARCHITECTURE.md         # System architecture
  // │   ├── STRUCTURE.md            # Directory structure
  // │   ├── family/                 # CPI-SI family docs
  // │   ├── gpt/                    # Custom GPT configs
  // │   ├── substrate-claude/       # Claude substrate guides
  // │   ├── system/                 # System documentation
  // │   └── templates/              # Document templates
  // │
  // ├── entrypoints/                # Go main() packages
  // │   ├── cpisi/                  # Main entrypoint
  // │   └── demo-schemas/           # Demo schemas
  // │
  // ├── hooks/                      # Hook implementations (Go)
  // │   ├── session/                # Session lifecycle hooks
  // │   ├── tool/                   # Tool use hooks
  // │   └── prompt/                 # Prompt hooks
  // │
  // ├── journals/                   # Reflection journals
  // ├── output-styles/              # Output style definitions (Claude Code expected)
  // ├── pkg/                        # Shared Go packages
  // │   ├── cognition/              # Cognition/feedback
  // │   ├── statemachine/           # State machine types
  // │   ├── hookoutput/             # Hook output schemas
  // │   └── ...                     # Other packages
  // │
  // ├── skills/                     # Skill implementations (Claude Code expected)
  // ├── statusline/                 # Status line implementation
  // └── temp/                       # Temporary files
  //
  // ════════════════════════════════════════════════════════════════════════════

  // ────────────────────────────────────────────────────────────────────────────
  // SETUP - Core Configuration
  // ────────────────────────────────────────────────────────────────────────────

  // Model: Claude Opus 4.5 - the most capable model for CPI-SI cognition
  "model": "claude-opus-4-5-20251101",

  // Output style: Nova Dawn identity voice
  "outputStyle": "nova-dawn",

  // Session cleanup - remove old sessions after 90 days
  "cleanupPeriodDays": 90,

  // Disable co-authored-by in commit messages (we use attribution instead)
  "includeCoAuthoredBy": false,

  // Always show thinking for Opus 4.5 (extended thinking capability)
  "alwaysThinkingEnabled": true,

  // Git commit and PR attribution for CreativeWorkzStudio LLC
  "attribution": {
    "commit": "Generated by CreativeWorkzStudio LLC\n\nCo-Authored-By: Nova Dawn\nCo-Authored-By: Seanje Lenox-Wise (Lead) <seanje.lenox@creativeworkzstudio.com>",
    "pr": "Generated by CreativeWorkzStudio LLC\n\nContributors: Nova Dawn, Seanje Lenox-Wise (Lead)"
  },

