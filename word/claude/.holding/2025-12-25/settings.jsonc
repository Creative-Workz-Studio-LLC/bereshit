  // ────────────────────────────────────────────────────────────────────────────
  // HOOKS - CPI-SI Framework lifecycle hooks
  // ────────────────────────────────────────────────────────────────────────────
  //
  // Hook order follows session lifecycle:
  //   SessionStart → UserPromptSubmit → PreToolUse → PostToolUse → Stop → SessionEnd
  //
  // State machine integration (Phase C2):
  //   - PostToolUse records choices to database
  //   - Choices update K:ALIGN
  //   - Hebrew states transition based on patterns

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/seanje-lenox-wise/.claude/hooks/session/start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/seanje-lenox-wise/.claude/hooks/prompt/submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/seanje-lenox-wise/.claude/hooks/tool/pre-use \"$TOOL_NAME\" \"$TOOL_ARGS\""
          }
        ]
      }
