{
  // #!omni data --json
  // ==========================================================================
  // METADATA
  // Key: B-vscode-tasks
  // Purpose: Build tasks for Bereshit - thin wrapper over Makefiles
  // Version: a-01.00
  // ==========================================================================

  "version": "2.0.0",
  "tasks": [
    // ========================================================================
    // libtrit (C Library)
    // ========================================================================
    {
      "label": "libtrit: Build",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/word/work/pkg/trit"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "libtrit: Test All",
      "type": "shell",
      "command": "make test",
      "options": {
        "cwd": "${workspaceFolder}/word/work/pkg/trit"
      },
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "libtrit: Clean",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}/word/work/pkg/trit"
      },
      "problemMatcher": []
    },

    // ========================================================================
    // Phase 0 Demo (Go)
    // ========================================================================
    {
      "label": "demo-config: Build",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/tov/demo/phase-0/demo-config"
      },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "demo-config: Run",
      "type": "shell",
      "command": "./bin/demo-config",
      "options": {
        "cwd": "${workspaceFolder}/tov/demo/phase-0/demo-config",
        "env": {
          "BERESHIT_ROOT": "${workspaceFolder}"
        }
      },
      "problemMatcher": []
    },

    // ========================================================================
    // Phase 1 Demo (C)
    // ========================================================================
    {
      "label": "demo-trit: Build",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/tov/demo/phase-1/demo-trit"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "demo-trit: Run",
      "type": "shell",
      "command": "./bin/demo-trit",
      "options": {
        "cwd": "${workspaceFolder}/tov/demo/phase-1/demo-trit"
      },
      "problemMatcher": []
    }
  ]
}
