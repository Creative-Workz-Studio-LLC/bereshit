definition of this folder:

    schema:
        fields (1):
            "name" be word
            "key" be word
            "classification" be ternary

        constraints (0):
            "active_organized" ensuring "active projects have priorities"

        reserved (-1):
            none

    values:
        primary (1):
            "name" is "Project Tracking"
            "key" is "B-tov-data-system-projects"
            "classification" is "tov (0)"

        structure (0):
            "derivation" is "bereshit/tov/data/system/"
            "structure" is "by-status then by-priority"
            "contents" is:
                "Project files" as "tracking data per project"
            "children" is:
                "active/" as "Active Projects":
                    purpose "Currently active work"
                    contains "high/, mid/, low/"
                "archive/" as "Archived Projects":
                    purpose "Completed or paused work"
                    contains "high/, mid/, low/"
                "templates/" as "Project Templates":
                    purpose "Templates for new projects"

        reserved (-1):
            none

