  // ==========================================================================
  // Co.3 MENUS
  // ==========================================================================
  //
  // Data-driven menu definitions. IDE loads menus from config.
  // Actions reference function names; keybindings defined separately.
  //

  "menus": {
    "description": "Data-driven menu definitions for IDE and applications",

    "main_menu": {
      "items": [
        {
          "label": "File",
          "hotkey": "F",
          "submenu": [
            { "label": "New",        "hotkey": "N", "action": "file_new",     "key": "Ctrl+N" },
            { "label": "Open",       "hotkey": "O", "action": "file_open",    "key": "Ctrl+O" },
            { "label": "Save",       "hotkey": "S", "action": "file_save",    "key": "Ctrl+S" },
            { "label": "Save As",    "hotkey": "A", "action": "file_save_as", "key": "Ctrl+Shift+S" },
            { "type": "separator" },
            { "label": "Close",      "hotkey": "C", "action": "file_close",   "key": "Ctrl+W" },
            { "label": "Quit",       "hotkey": "Q", "action": "quit",         "key": "Ctrl+Q" }
          ]
        },
        {
          "label": "Edit",
          "hotkey": "E",
          "submenu": [
            { "label": "Undo",       "hotkey": "U", "action": "edit_undo",    "key": "Ctrl+Z" },
            { "label": "Redo",       "hotkey": "R", "action": "edit_redo",    "key": "Ctrl+Y" },
            { "type": "separator" },
            { "label": "Cut",        "hotkey": "T", "action": "edit_cut",     "key": "Ctrl+X" },
            { "label": "Copy",       "hotkey": "C", "action": "edit_copy",    "key": "Ctrl+C" },
            { "label": "Paste",      "hotkey": "P", "action": "edit_paste",   "key": "Ctrl+V" },
            { "type": "separator" },
            { "label": "Find",       "hotkey": "F", "action": "edit_find",    "key": "Ctrl+F" },
            { "label": "Replace",    "hotkey": "H", "action": "edit_replace", "key": "Ctrl+H" },
            { "label": "Go to Line", "hotkey": "G", "action": "edit_goto",    "key": "Ctrl+G" }
          ]
        },
        {
          "label": "View",
          "hotkey": "V",
          "submenu": [
            { "label": "Toggle Panels",    "hotkey": "P", "action": "view_toggle_panels",  "key": "F9" },
            { "label": "Toggle Line Nums", "hotkey": "L", "action": "view_toggle_lines",   "key": "F10" },
            { "label": "Toggle Block Ind", "hotkey": "B", "action": "view_toggle_blocks",  "key": "F11" },
            { "type": "separator" },
            { "label": "Zoom In",          "hotkey": "+", "action": "view_zoom_in",        "key": "Ctrl+=" },
            { "label": "Zoom Out",         "hotkey": "-", "action": "view_zoom_out",       "key": "Ctrl+-" },
            { "label": "Reset Zoom",       "hotkey": "0", "action": "view_zoom_reset",     "key": "Ctrl+0" }
          ]
        },
        {
          "label": "Build",
          "hotkey": "B",
          "submenu": [
            { "label": "Compile",          "hotkey": "C", "action": "build_compile",       "key": "F5" },
            { "label": "Run",              "hotkey": "R", "action": "build_run",           "key": "F6" },
            { "label": "Compile & Run",    "hotkey": "B", "action": "build_compile_run",   "key": "F7" },
            { "type": "separator" },
            { "label": "Clean",            "hotkey": "L", "action": "build_clean",         "key": "Shift+F5" },
            { "label": "Rebuild All",      "hotkey": "A", "action": "build_rebuild",       "key": "Ctrl+F5" }
          ]
        },
        {
          "label": "Tools",
          "hotkey": "T",
          "submenu": [
            { "label": "Validate Blocks",  "hotkey": "V", "action": "tools_validate",      "key": "Ctrl+Shift+V" },
            { "label": "Format Document",  "hotkey": "F", "action": "tools_format",        "key": "Ctrl+Shift+F" },
            { "label": "Insert Template",  "hotkey": "T", "action": "tools_template",      "key": "Ctrl+Shift+T" },
            { "type": "separator" },
            { "label": "Settings",         "hotkey": "S", "action": "tools_settings",      "key": "Ctrl+," }
          ]
        },
        {
          "label": "Help",
          "hotkey": "H",
          "submenu": [
            { "label": "OmniCode Help",    "hotkey": "O", "action": "help_omnicode",       "key": "F1" },
            { "label": "Keyboard Shortcuts","hotkey": "K", "action": "help_shortcuts",     "key": "Ctrl+?" },
            { "type": "separator" },
            { "label": "About",            "hotkey": "A", "action": "help_about",          "key": "" }
          ]
        }
      ]
    },

    "context_menu": {
      "editor": [
        { "label": "Cut",        "action": "edit_cut",     "key": "Ctrl+X" },
        { "label": "Copy",       "action": "edit_copy",    "key": "Ctrl+C" },
        { "label": "Paste",      "action": "edit_paste",   "key": "Ctrl+V" },
        { "type": "separator" },
        { "label": "Go to Definition", "action": "goto_definition", "key": "F12" },
        { "label": "Find References",  "action": "find_references", "key": "Shift+F12" }
      ],
      "file_tree": [
        { "label": "Open",       "action": "file_open",    "key": "" },
        { "label": "Rename",     "action": "file_rename",  "key": "F2" },
        { "label": "Delete",     "action": "file_delete",  "key": "Delete" },
        { "type": "separator" },
        { "label": "New File",   "action": "file_new",     "key": "" },
        { "label": "New Folder", "action": "folder_new",   "key": "" }
      ]
    }
  },

  // ==========================================================================
  // Co.4 KEYBINDINGS
  // ==========================================================================
  //
  // Key-to-action mappings. Supports modifier combinations.
  // Maps to DisplayKey enum in cornerstone/engine/display/include/display.h
  //

  "keybindings": {
    "description": "Key-to-action mappings for IDE and applications",

    "global": {
      "Ctrl+Q":       "quit",
      "Ctrl+N":       "file_new",
      "Ctrl+O":       "file_open",
      "Ctrl+S":       "file_save",
      "Ctrl+Shift+S": "file_save_as",
      "Ctrl+W":       "file_close",

      "Ctrl+Z":       "edit_undo",
      "Ctrl+Y":       "edit_redo",
      "Ctrl+X":       "edit_cut",
      "Ctrl+C":       "edit_copy",
      "Ctrl+V":       "edit_paste",
      "Ctrl+F":       "edit_find",
      "Ctrl+H":       "edit_replace",
      "Ctrl+G":       "edit_goto",

      "F1":           "help_omnicode",
      "F5":           "build_compile",
      "F6":           "build_run",
      "F7":           "build_compile_run",
      "F9":           "view_toggle_panels",
      "F10":          "view_toggle_lines",
      "F11":          "view_toggle_blocks",

      "Escape":       "cancel",
      "Alt+F":        "menu_file",
      "Alt+E":        "menu_edit",
      "Alt+V":        "menu_view",
      "Alt+B":        "menu_build",
      "Alt+T":        "menu_tools",
      "Alt+H":        "menu_help"
    },

    "editor": {
      "Up":           "cursor_up",
      "Down":         "cursor_down",
      "Left":         "cursor_left",
      "Right":        "cursor_right",
      "Home":         "cursor_line_start",
      "End":          "cursor_line_end",
      "Ctrl+Home":    "cursor_file_start",
      "Ctrl+End":     "cursor_file_end",
      "PageUp":       "page_up",
      "PageDown":     "page_down",

      "Backspace":    "delete_backward",
      "Delete":       "delete_forward",
      "Enter":        "insert_newline",
      "Tab":          "insert_tab",
      "Shift+Tab":    "unindent",

      "Ctrl+D":       "duplicate_line",
      "Ctrl+K":       "delete_line",
      "Ctrl+L":       "select_line",
      "Ctrl+/":       "toggle_comment",

      "Ctrl+Up":      "scroll_up",
      "Ctrl+Down":    "scroll_down"
    },

    "menu": {
      "Up":           "menu_prev",
      "Down":         "menu_next",
      "Left":         "menu_parent",
      "Right":        "menu_child",
      "Enter":        "menu_select",
      "Escape":       "menu_close"
    },

    "prompt": {
      "Enter":        "prompt_submit",
      "Escape":       "prompt_cancel",
      "Tab":          "prompt_complete",
      "Up":           "prompt_history_prev",
      "Down":         "prompt_history_next"
    }
  },

  // ==========================================================================
  // Co.5 LAYOUT
  // ==========================================================================

  "layout": {
    "description": "Spacing, padding, and layout values",

    "editor": {
      "line_number_width": 6,
      "left_margin": 1,
      "right_margin": 1,
      "tab_width": 4,
      "scroll_margin": 3
    },

    "panels": {
      "file_tree_width": 25,
      "output_height": 10,
      "min_editor_width": 40,
      "min_editor_height": 10
    },

    "menu": {
      "item_padding": 2,
      "submenu_indent": 2,
      "separator_char": "─"
    },

    "status_bar": {
      "height": 1,
      "padding": 1
    },

    "dialog": {
      "min_width": 40,
      "max_width": 80,
      "padding": 2,
      "button_spacing": 2
    }
  },

  // ==========================================================================
  // Co.6 PROGRESS & FEEDBACK
  // ==========================================================================

  "progress_bar": {
    "description": "Progress bar characters for long operations",
    "current_style": "block_style",

    "block_style": {
      "filled": "█",
      "empty":  "░",
      "partial": ["▏", "▎", "▍", "▌", "▋", "▊", "▉"]
    },

    "bar_style": {
      "filled": "▓",
      "empty":  "░"
    },

    "ascii_style": {
      "filled": "#",
      "empty":  "."
    }
  },

  // ==========================================================================
  // Co.7 IDE SETTINGS
  // ==========================================================================

  "ide": {
    "description": "IDE-specific configuration",

    "editor": {
      "show_line_numbers": true,
      "show_block_indicators": true,
      "highlight_current_line": true,
      "show_matching_brackets": true,
      "auto_indent": true,
      "wrap_lines": false,
      "tab_to_spaces": true,
      "trim_trailing_whitespace": true,
      "ensure_newline_at_eof": true
    },

    "syntax": {
      "enabled": true,
      "omni_extensions": [".omni", ".omnicode"],
      "c_extensions": [".c", ".h"],
      "go_extensions": [".go"],
      "toml_extensions": [".toml"],
      "json_extensions": [".json", ".jsonc"]
    },

    "blocks": {
      "validate_on_save": true,
      "show_structure_hints": true,
      "auto_insert_end_markers": false
    },

    "files": {
      "recent_max": 10,
      "auto_save": false,
      "auto_save_interval_ms": 60000,
      "backup_on_save": true
    },

    "output": {
      "max_lines": 1000,
      "auto_scroll": true,
      "show_timestamps": true,
      "clear_on_build": true
    }
  },

  // ==========================================================================
  // Co.8 BEHAVIOR
  // ==========================================================================

  "behavior": {
    "description": "Behavioral settings and feature toggles",

    "panic_recovery": {
      "enabled": true,
      "silent": true,
      "note": "Rails self-evidence: panic recovery is silent because failure is visually obvious"
    },

    "validation": {
      "empty_table_returns_empty": true,
      "no_headers_returns_empty": true,
      "zero_total_returns_empty": true,
      "negative_values_return_empty": true
    },

    "accessibility": {
      "reduce_motion": false,
      "high_contrast": false,
      "large_text": false,
      "screen_reader_hints": false
    },

    "terminal": {
      "detect_capabilities": true,
      "unicode_fallback": true,
      "color_fallback": true,
      "min_width": 80,
      "min_height": 24
    }
  },

  // ==========================================================================
  // Co.9 SESSION DISPLAY
  // ==========================================================================

  "session": {
    "description": "Session-specific display content",

    "banner": {
      "width": 64,
      "content_width": 62,
      "border_style": "single_line"
    },

    "section_headers": {
      "session_start": {
        "environment": "SESSION ENVIRONMENT",
        "temporal_awareness": "TEMPORAL AWARENESS",
        "workspace_analysis": "WORKSPACE ANALYSIS"
      },
      "session_stop": {
        "stopping_point": "STOPPING POINT CHECK",
        "temporal_context": "TEMPORAL CONTEXT AT STOP"
      },
      "session_end": {
        "session_summary": "SESSION SUMMARY",
        "temporal_journey": "TEMPORAL JOURNEY",
        "state_reminders": "STATE REMINDERS"
      }
    },

    "biblical_verses": {
      "session_stop": {
        "banner_title": "Task Complete - Excellence that Honors God",
        "verse_text": "Whatever you do, work heartily, as for the Lord and not for men.",
        "verse_ref": "Colossians 3:23"
      },
      "session_end": {
        "banner_title": "Session Ending - Grace and Peace",
        "verse_text": "The Lord bless you and keep you; the Lord make his face shine on you and be gracious to you.",
        "verse_ref": "Numbers 6:24-25"
      }
    },

    "messages": {
      "workspace": {
        "no_workspace": "ⓘ No workspace configured (NOVA_DAWN_WORKSPACE not set)",
        "workspace_healthy": "✓ Workspace healthy - no warnings or context to report"
      },
      "compaction": {
        "manual": "Manual compaction #{count} - optimizing context...",
        "auto": "Auto-compaction #{count} - managing token usage...",
        "preservation_header": "📍 Temporal State Preservation:"
      }
    }
  },

  // ==========================================================================
  // Cv.1 VALIDATION
  // ==========================================================================

  "_validation": {
    "commands": [
      "npx jsonc-parser validate formatting.jsonc",
      "cornerstone --config-check display"
    ]
  },

  // ==========================================================================
  // Cv.2 SCHEMA
  // ==========================================================================

  "_schema": {
    "required": [
      "metadata",
      "colors",
      "themes",
      "styles",
      "icons",
      "menus",
      "keybindings",
      "layout",
      "behavior"
    ],
    "optional": [
      "box_characters",
      "progress_bar",
      "ide",
      "session"
    ]
  },

  // ==========================================================================
  // Cv.3 MAINTENANCE
  // ==========================================================================

  "_maintenance": {
    "safe": [
      "Add new themes",
      "Modify color values",
      "Add menu items with new actions",
      "Change keybinding mappings"
    ],
    "careful": [
      "Change existing action names (breaks code references)",
      "Remove menu items (may break UI expectations)",
      "Change theme structure (affects all themes)"
    ],
    "never": [
      "Remove required schema sections",
      "Break DisplayColor enum compatibility",
      "Remove core keybindings without replacement"
    ]
  }
}

// ============================================================================
// END CONTENT
// ============================================================================

// ============================================================================
// CLOSING [CLOSING]
// ============================================================================
//
// X.1 Purpose
//
// This configuration drives the entire display system:
// - CLI, TUI, and GUI backends all load from this single source
// - Themes, styles, menus, and keybindings are data-driven
// - IDE behavior is configurable without code changes
//
// X.2 Integration
//
// Engine loads via: engine_config_init() → display_config_load()
// Display layer references: g_config->display->themes, menus, keybindings
// IDE consumes: menus.main_menu, themes.current, ide.editor settings
//
// X.3 Extension
//
// To add new theme: Copy existing theme block, modify colors
// To add menu item: Add to menus.main_menu.items[].submenu
// To add keybinding: Add to keybindings.global or keybindings.editor
//
// Closing Note:
//   "A word fitly spoken is like apples of gold in pictures of silver."
//     — Proverbs 25:11
//
//   Presentation matters. How we display information affects understanding.
//   This configuration ensures consistent, accessible, beautiful output
//   across all display backends and applications.
//
// ============================================================================
// END CLOSING
// ============================================================================
