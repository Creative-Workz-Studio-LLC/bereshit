  // ==========================================================================
  // Cc.4 STYLES
  // ==========================================================================
  //
  // Predefined DisplayStyle structs. Code references by name.
  // Structure: { "fg": color, "bg": color, "bold": bool }
  //

  "styles": {
    "description": "Named DisplayStyle definitions - { fg, bg, bold }",

    "text": {
      "normal":     { "fg": "default", "bg": "default", "bold": false },
      "bold":       { "fg": "default", "bg": "default", "bold": true },
      "dim":        { "fg": "bright_black", "bg": "default", "bold": false },
      "error":      { "fg": "white", "bg": "red", "bold": true },
      "warning":    { "fg": "black", "bg": "yellow", "bold": false },
      "success":    { "fg": "green", "bg": "default", "bold": false },
      "info":       { "fg": "cyan", "bg": "default", "bold": false }
    },

    "ui": {
      "border":     { "fg": "white", "bg": "default", "bold": false },
      "title":      { "fg": "white", "bg": "default", "bold": true },
      "header":     { "fg": "cyan", "bg": "default", "bold": true },
      "footer":     { "fg": "bright_black", "bg": "default", "bold": false }
    }
  },

