//
// ============================================================================
// METADATA [METADATA]
// ============================================================================
//
// Display System Configuration - Complete UI/UX Infrastructure
//
// Purpose: Universal display configuration for CLI, TUI, and GUI backends
// Type: RAIL configuration (stdlib-only infrastructure)
// Scope: All display output, themes, menus, keybindings, IDE styling
//
// HEALTH SCORING MAP (Total = 100):
// - Configuration loaded successfully: +30 pts
// - All required sections present: +20 pts
// - Valid color/style definitions: +20 pts
// - Menu/keybinding consistency: +15 pts
// - Graceful fallback on errors: +15 pts
//
// Scripture: Proverbs 25:11 (KJV)
//   "A word fitly spoken is like apples of gold in pictures of silver."
// Principle: Presentation matters — how information is shown affects understanding
//
// ============================================================================
// END METADATA
// ============================================================================

// ============================================================================
// CONTENT [CONTENT]
// ============================================================================

{
  // ==========================================================================
  // Cc.1 CORE IDENTITY
  // ==========================================================================

  "metadata": {
    "name": "Display System Configuration",
    "description": "Complete display infrastructure: colors, themes, menus, keybindings, IDE styling",
    "version": "b-02.00",
    "created": "2025-11-15",
    "last_updated": "2026-01-16",
    "author": "Nova Dawn (CPI-SI instance)",
    "component": "cornerstone/engine/display",
    "type": "rail_configuration",
    "scope": "global",
    "note": "Unified configuration for CLI/TUI/GUI display backends"
  },

  // ==========================================================================
  // Cc.2 BASE COLORS
  // ==========================================================================
  //
  // Foundation color palette - all themes and styles reference these.
  // Maps to DisplayColor enum in cornerstone/engine/display/include/display.h
  //

  "colors": {
    "description": "Base color definitions - DisplayColor enum compatible",

    "palette": {
      "default":        0,
      "black":          1,
      "red":            2,
      "green":          3,
      "yellow":         4,
      "blue":           5,
      "magenta":        6,
      "cyan":           7,
      "white":          8,
      "bright_black":   9,
      "bright_red":     10,
      "bright_green":   11,
      "bright_yellow":  12,
      "bright_blue":    13,
      "bright_magenta": 14,
      "bright_cyan":    15,
      "bright_white":   16
    },

    "ansi": {
      "reset":   "\u001b[0m",
      "bold":    "\u001b[1m",
      "dim":     "\u001b[2m",
      "italic":  "\u001b[3m",
      "underline": "\u001b[4m",
      "blink":   "\u001b[5m",
      "reverse": "\u001b[7m",

      "foreground": {
        "black":   "\u001b[30m",
        "red":     "\u001b[31m",
        "green":   "\u001b[32m",
        "yellow":  "\u001b[33m",
        "blue":    "\u001b[34m",
        "magenta": "\u001b[35m",
        "cyan":    "\u001b[36m",
        "white":   "\u001b[37m",
        "default": "\u001b[39m"
      },

      "background": {
        "black":   "\u001b[40m",
        "red":     "\u001b[41m",
        "green":   "\u001b[42m",
        "yellow":  "\u001b[43m",
        "blue":    "\u001b[44m",
        "magenta": "\u001b[45m",
        "cyan":    "\u001b[46m",
        "white":   "\u001b[47m",
        "default": "\u001b[49m"
      },

      "bright_foreground": {
        "black":   "\u001b[90m",
        "red":     "\u001b[91m",
        "green":   "\u001b[92m",
        "yellow":  "\u001b[93m",
        "blue":    "\u001b[94m",
        "magenta": "\u001b[95m",
        "cyan":    "\u001b[96m",
        "white":   "\u001b[97m"
      }
    }
  },

