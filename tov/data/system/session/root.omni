            "name" be word
            "key" be word
            "classification" be ternary
            "derivation" be word
            "structure" be word
            "contents" be gathering
            "children" be gathering

        constraints (0):
            "state_valid" ensuring "state files parse correctly"

        reserved (-1):
            none

    values:
        primary (1):
            "name" is "Session State Management"
            "key" is "B-tov-data-system-session"
            "classification" is "tov (0)"

        structure (0):
            "derivation" is "bereshit/tov/data/system/"
            "structure" is "by-function — one folder per session concern"
            "contents" is:
                "JSON state files" as "session state data"
            "children" is:
