                "privacy/" as "Privacy Filters":
                    purpose "Sensitive pattern definitions"
                "projects/" as "Project Tracking":
                    contains "active/" for "Current projects by priority"
                    contains "archive/" for "Completed projects"
                    contains "templates/" for "Project templates"
                "reference-docs/" as "Reference Documentation":
                    purpose "Session analysis and reference material"
                "session/" as "Session State Management":
                    contains "activity/" for "Current activity tracking"
                    contains "archive/" for "Historical sessions"
                    contains "consolidation/" for "Memory consolidation"
                    contains "history/" for "Session history"
                    contains "memory/" for "Patterns and significant events"
                    contains "templates/" for "Session templates"
                "temporal/" as "Temporal System":
                    contains "appointed/" for "Appointments (recurring, one-time)"
                    contains "celestial/" for "Astronomical data"
                    contains "chronological/" for "Calendar and milestones"
                    contains "definitions/" for "Time units and phases"
                    contains "patterns/" for "Temporal patterns (instance, user, discovered)"

        reserved (-1):
            none

