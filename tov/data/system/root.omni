definition of this folder:

    schema:
        fields (1):
            "name" be word
            "key" be word
            "classification" be ternary
            "derivation" be word
            "structure" be word
            "contents" be gathering
            "children" be gathering

        constraints (0):
            "config_valid" ensuring "configuration files parse correctly"
                because "invalid config breaks operation"

        reserved (-1):
            none

    values:
        primary (1):
            "name" is "System Configuration"
            "key" is "B-tov-data-system"
            "classification" is "tov (0)"

        structure (0):
            "derivation" is "bereshit/tov/data/"
            "structure" is "by-domain — config, session, temporal, and supporting"
            "contents" is:
                "Configuration files" as "JSON, TOML settings"
                "Session state" as "current and historical session data"
                "Temporal patterns" as "time awareness and learned rhythms"
            "children" is:
                "config/" as "Runtime Configuration":
                    contains "display/" for "Output formatting"
