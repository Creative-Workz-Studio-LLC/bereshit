definition of this folder:

    schema:
        fields (1):
            "name" be word
                meaning "Human-readable name for this folder"

            "key" be word
                meaning "Unique identifier following keying standard"

            "classification" be ternary
                meaning "Where this folder sits in Word/Work/Fruit"

            "derivation" be word or none
                meaning "What this folder derives from"

            "structure" be word
                meaning "Organizational pattern within folder"

            "contents" be gathering
                meaning "Types of items this folder holds"

            "children" be gathering or none
                meaning "Child folders within this folder"
                defaulting to none

        constraints (0):
            "database_integrity" ensuring "databases pass integrity checks"
                because "corrupted database breaks state machine"

            "schema_match" ensuring "tables match expected schema"
                because "schema drift causes query failures"

        reserved (-1):
            none

    values:
        primary (1):
            "name" is "Database Storage"
            "key" is "B-tov-data-db"
            "classification" is "tov (0)"

        structure (0):
            "derivation" is "bereshit/tov/data/"
            "structure" is "flat — databases at root level"
            "contents" is:
                "cpisi.db" as "CPI-SI cognitive state database":
                    tables "sessions" for "session tracking and state"
                    tables "choices" for "ternary choice history"
                    tables "transitions" for "Hebrew state transitions"
                    tables "patterns" for "learned patterns"
                "registry.db" as "Type registry for Phase 0 specs":
                    tables "specs" for "specification file tracking"
                    tables "types" for "type definitions from specs"
                    tables "dependencies" for "spec dependency graph"
                    tables "operations" for "operations defined in specs"
                    tables "constants" for "constants from specs"
                "build.db" as "Build state for Phase 1+ artifacts":
                    tables "sources" for "source file tracking by layer"
                    tables "objects" for "compiled .o artifacts"
                    tables "libraries" for "archive libraries like libtrit.a"
                    tables "tests" for "test results and assertions"
                    tables "demos" for "phase demo validation"
                    tables "build_events" for "build history log"
            "children" is:
                none

        reserved (-1):
            none

