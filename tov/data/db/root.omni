operations of this folder:

    verified by:
        static (1):
            "ls -la bereshit/tov/data/db/" producing "cpisi.db visible"
            "sqlite3 tov/data/db/cpisi.db '.tables'" producing "tables exist"

        runtime (0):
            "sqlite3 tov/data/db/cpisi.db 'PRAGMA integrity_check'" succeeding when "database valid"
            "sqlite3 tov/data/db/cpisi.db '.schema'" returning when "schema accessible"

        integrity (-1):
            "integrity_check fails" detected by "database validator"
            "missing database" detected by "file checker"

    accessed through:
        to access this folder:
            meaning "Navigate to database storage"

            "cd bereshit/tov/data/db/"

            "ls -la" returns "database files"

            "sqlite3 cpisi.db" returns "database shell"

policy of this folder:

    modification:
        safe (1):
            "Query databases (SELECT)"
            "Insert new records through hooks"
            "Update state through Go packages"

        careful (0):
            "Modify database schema"
            "Delete records"

        never (-1):
            "Delete cpisi.db without backup"
            "Manually edit database binary"
            "Run DROP TABLE without explicit request"

    future:
        planned (1):
            "Seed registry.db with word/core/ specs"
            "Seed build.db with word/work/pkg/trit/ sources"
            "Database migration tooling"

        considered (0):
            "Query views for dashboard display"
            "Automated spec-to-registry sync"

        rejected (-1):
            "Multiple concurrent writers" because "SQLite limitation"

