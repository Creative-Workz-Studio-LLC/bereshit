definition of this folder:

    schema:
        fields (1):
            "name" be word
                meaning "Human-readable name for this folder"
                cautioning "Should be clear and descriptive"

            "key" be word
                meaning "Unique identifier following keying standard"
                cautioning "Must be unique within namespace"

            "classification" be ternary
                meaning "Where this folder sits in Word/Work/Fruit"
                cautioning "Must match actual contents"

            "derivation" be word or none
                meaning "What this folder derives from, if any"

            "structure" be word
                meaning "Organizational pattern within folder"

            "contents" be gathering
                meaning "Types of items this folder holds"

            "children" be gathering or none
                meaning "Child folders within this folder"
                defaulting to none

        constraints (0):
            "classification_alignment" ensuring "classification matches actual contents"
                because "misclassification breaks ternary navigation"

            "key_unique" ensuring "key is unique within parent namespace"
                because "duplicate keys break reference resolution"

        reserved (-1):
            none

    values:
        primary (1):
            "name" is "State Machine Data"
            "key" is "B-tov-data"
            "classification" is "tov (0)"

        structure (0):
            "derivation" is "bereshit/tov/"
            "structure" is "by-domain (db, logs, system)"
            "contents" is:
                "SQLite databases" as "cpisi.db, future registry.db, build.db"
                "Runtime logs" as "cognition, session, tools, trajectory"
                "System configuration" as "config, privacy, projects, session, temporal"
            "children" is:
                "db/" as "SQLite Database Storage":
                    contains "cpisi.db" for "CPI-SI cognitive state database"
                "logs/" as "Runtime Logging":
                    contains "cognition/" for "Cognitive state logs"
                    contains "context/" for "Context tracking"
                    contains "health/" for "Health monitoring"
                    contains "libraries/" for "Library usage"
                    contains "session/" for "Session logs (JSONL)"
                    contains "tools/" for "Tool usage logs"
                    contains "trajectory/" for "State trajectory"
                "system/" as "System Configuration and State":
                    contains "config/" for "Runtime configuration"
                    contains "privacy/" for "Privacy filters"
                    contains "projects/" for "Project tracking"
                    contains "reference-docs/" for "Reference documentation"
                    contains "session/" for "Session state"
                    contains "temporal/" for "Temporal system"

        reserved (-1):
            none

