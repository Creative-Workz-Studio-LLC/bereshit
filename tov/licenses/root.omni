definition of this folder:

    schema:
        fields (1):
            "name" be word
            "key" be word
            "classification" be ternary

        constraints (0):
            "three_tier" ensuring "patterns, implementation, commercial all present"
            "clear_terms" ensuring "each license has unambiguous terms"

        reserved (-1):
            none

    values:
        primary (1):
            "name" is "Three-License Structure"
            "key" is "B-tov-licenses"
            "classification" is "tov (+1)"

        structure (0):
            "derivation" is "bereshit/tov/"
            "structure" is "by-type — one folder per license tier"
            "contents" is:
                "LICENSE files" as "legal documents"
                "README files" as "explanation documents"
            "children" is:
                "patterns/" as "Patterns License — Free":
                    purpose "Ideas, approaches, documentation freely shared"
