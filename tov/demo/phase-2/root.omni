    health:
        system Base100 with scale from -100 to +100
        granted (1) above +50 meaning "demo builds and passes"
        deferred (0) within ±50 meaning "demo needs attention"
        denied (-1) below -50 meaning "demo failing"

        operations:
            "demo builds" scores +30 (1) for "make succeeds"
            "21 demonstrations pass" scores +30 (1) for "all families validate"
            "demo fails" scores -40 (-1) for "Phase 2 broken"

        cascade multipliers:
