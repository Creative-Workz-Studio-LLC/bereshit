#!omni code --c -executable
#!omni meta.key = B-tov-demo-phase-3-test-exec
#!omni meta.from = word/seed/code/omni/executable.omni
#!omni meta.at = a-01.00

// METADATA

this is a file for "Executable OmniCode Test":
    keyed as "B-tov-demo-phase-3-test-exec"
    named "test_exec"

// END METADATA

// SETUP

import trit from "libtrit"

// END SETUP

// BODY

let health be count with 100
let status be covenant with granted
let name be word with "Nova"
let active be truth with yes

establish work calculate_damage that takes count amount returns count:
    when amount is greater than health:
        return 0
    otherwise:
        return health minus amount

provide work greet that returns word:
    return "Hello, World!"

when status is granted:
    witness "Access granted" with info
    display name

otherwise:
    witness "Access denied" with error
    fail with "Permission denied"

// END BODY

// CLOSING

// Test file for validating OmniCode executable parsing
// "Let there be light: and there was light" — Genesis 1:3

// END CLOSING
