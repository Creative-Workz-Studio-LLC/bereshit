#!omni code --omni -program
#!omni meta.key = B-tov-demo-phase3-test-lexer-concept
#!omni meta.from = word/seed/code/omni/program.omni
#!omni meta.at = a-01.00

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a program for "Lexer Concept Test":
    keyed as "B-tov-demo-phase3-test-lexer-concept"
    named "test_lexer_concept"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// Demonstrates OmniCode self-hosting capability
// Uses string intrinsics to analyze text character by character

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

witness "Testing lexer concepts in OmniCode"

// Define a simple source string
let source be word with "let x be 42"
witness "Source to tokenize:"
display source

// Get the length
intrinsic str_len source
witness "Got string length"

// Get first character
intrinsic str_char source 0
witness "Got first character"

// Test substring
intrinsic str_sub source 0 3
witness "Got substring 'let'"

// Test string finding
let keyword be word with "be"
intrinsic str_find source keyword
witness "Found keyword position"

witness "Lexer concept test complete!"
return 0

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// This proves OmniCode has the primitives for self-hosting lexer:
// - str_len for measuring input
// - str_char for character-by-character scanning
// - str_sub for extracting tokens
// - str_find for keyword detection

// =============================================================================
// END CLOSING
// =============================================================================
