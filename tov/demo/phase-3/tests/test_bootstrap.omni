#!omni code --omni -program
#!omni meta.key = B-tov-demo-phase3-test-bootstrap
#!omni meta.from = word/seed/code/omni/program.omni
#!omni meta.at = a-01.00

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a program for "Bootstrap Test":
    keyed as "B-tov-demo-phase3-test-bootstrap"
    named "test_bootstrap"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// # Self-Hosting Bootstrap Test
//
// This test demonstrates the OmniCode self-hosting milestone:
// - Lexer written in OmniCode
// - Parser written in OmniCode
// - IR Emitter written in OmniCode
//
// "In the beginning was the Word" — John 1:1

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

witness "=== OmniCode Self-Hosting Bootstrap Test ==="

// The self-hosting milestone:
// OmniCode can express its own compiler components

witness ""
witness "1. Lexer (stdlib/lexer/lexer.omni)"
witness "   - Tokenizes source code"
witness "   - Uses string intrinsics: str_len, str_char, str_sub"
witness "   - Result capture: let length be count with str_len source"

witness ""
witness "2. Parser (stdlib/parser/parser.omni)"
witness "   - Builds AST from tokens"
witness "   - Recognizes sentence patterns"
witness "   - Uses collections: list_new, list_push"

witness ""
witness "3. Emitter (stdlib/emitter/emitter.omni)"
witness "   - Generates VM bytecode"
witness "   - Maps AST nodes to opcodes"
witness "   - Manages constant pool and variables"

witness ""
witness "=== Key Language Features Demonstrated ==="

// Demonstrate the features that make self-hosting possible

// 1. Result capture with intrinsics
let greeting be word with "Hello, OmniCode!"
let length be count with str_len greeting
witness "String length captured:"
display length

// 2. String manipulation
let upper be word with str_upper greeting
witness "Uppercase:"
display upper

// 3. Collections
let numbers be count with list_new
intrinsic list_push numbers 10
intrinsic list_push numbers 20
intrinsic list_push numbers 30
let list_len be count with list_len numbers
witness "List length:"
display list_len

// 4. Sentence-based syntax (this file itself!)
witness ""
witness "This test IS written in OmniCode's sentence-based syntax:"
witness "  let greeting be word with Hello"
witness "  let length be count with str_len greeting"
witness "  when condition is true: ..."

witness ""
witness "=== Bootstrap Test Complete ==="
witness "OmniCode can express its own compiler!"

return 0

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// This milestone demonstrates that OmniCode has sufficient expressive
// power to implement its own tooling. The language can compile itself.
//
// "The entrance of thy words giveth light" — Psalm 119:130

// =============================================================================
// END CLOSING
// =============================================================================
