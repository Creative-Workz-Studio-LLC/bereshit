#!omni code --omni -program
#!omni meta.key = B-tov-demo-phase3-test-result-capture
#!omni meta.from = word/seed/code/omni/program.omni
#!omni meta.at = a-01.00

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a program for "Result Capture Test":
    keyed as "B-tov-demo-phase3-test-result-capture"
    named "test_result_capture"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// Test the new "let X be TYPE with intrinsic args" syntax
// This captures intrinsic results directly into variables

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

witness "Testing result capture: let X be TYPE with intrinsic args"

// Test 1: Capture string length
let source be word with "Hello, World!"
let length be count with str_len source
witness "Got string length"
display length

// Test 2: Capture substring
let sub be word with str_sub source 0 5
witness "Got substring"
display sub

// Test 3: Capture find position
let pos be count with str_find source "World"
witness "Got find position"
display pos

// Test 4: Capture concatenation
let a be word with "Hello"
let b be word with " OmniCode"
let greeting be word with str_cat a b
witness "Got concatenation"
display greeting

// Test 5: Capture uppercase
let upper_greeting be word with str_upper greeting
witness "Got uppercase"
display upper_greeting

// Test 6: Capture list creation and length
let mylist be count with list_new
witness "Created list"
display mylist

witness "Result capture test complete!"
return 0

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// This test demonstrates OmniCode's sentence-based syntax for capturing
// intrinsic results. The pattern "let X be TYPE with intrinsic args"
// reads naturally and transpiles cleanly to other languages.

// =============================================================================
// END CLOSING
// =============================================================================
