#!omni code --omni -test

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a program for "Health Operations Test":
    keyed as "test-health"
    named "test_health"
    described as "Tests CPI-SI health tracking operations"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// No imports needed for built-in health operations

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

witness "Health test starting"

// Get initial health (should be 50 - deferred)
let initial_health be health
witness "Got initial health"

// Add positive health
add 25 to health
witness "Added 25 to health"

// Set health directly
set health to 80
witness "Set health to 80"

// Get Hebrew state (should be yashar initially)
let initial_state be hebrew
witness "Got initial Hebrew state"

// Expand state toward tov
expand toward tov
witness "Expanded toward tov"

// Create a checkpoint (DAR integration)
checkpoint "healthy_state"
witness "Created checkpoint"

// Simulate some work that might affect health
set health to 90
witness "Health at 90"

// Expand again
expand toward tov
witness "Expanded again"

witness "Health test complete"

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// "A just man falleth seven times, and riseth up again."
//   — Proverbs 24:16

// =============================================================================
// END CLOSING
// =============================================================================
