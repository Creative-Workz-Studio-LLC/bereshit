#!omni code --omni -test

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a program for "Conditional Logic Test":
    keyed as "test-conditionals"
    named "test_conditionals"
    described as "Tests if/elif/else conditional execution"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// No imports needed

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

witness "Conditional test starting"

// Test 1: Simple if-true
let value be +1
if value equals +1:
    witness "Test 1 PASS: value equals +1"

// Test 2: If with trit comparison
let direction be +1
if direction equals +1:
    witness "Test 2 PASS: positive direction"
    print "Moving forward"

// Test 3: Boolean condition
let enabled be true
if enabled:
    witness "Test 3 PASS: enabled is true"

// Test 4: Nested logic simulation
let health be 75
let state be +1

if state equals +1:
    witness "Test 4 PASS: healthy state confirmed"
    print "System healthy"

witness "Conditional test complete"

// =============================================================================
// END BODY
// =============================================================================

