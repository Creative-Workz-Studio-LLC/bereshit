// =============================================================================
// BODY [BODY]
// =============================================================================

witness "Basic test starting"

// Test integer assignment
let x be 42
witness "Assigned integer"

// Test boolean
let flag be true
witness "Assigned boolean"

// Test trit value
let direction be +1
witness "Assigned trit"

// Test string
let message be "Hello, OmniCode!"
witness "Assigned string"

// Output the message
print message

witness "Basic test complete"

