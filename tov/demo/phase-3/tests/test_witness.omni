#!omni code --omni -test

// =============================================================================
// METADATA [METADATA]
// =============================================================================

this is a program for "Witness & Fail Test":
    keyed as "test-witness"
    named "test_witness"
    described as "Tests witness (assertion) and conditional fail"

// =============================================================================
// END METADATA
// =============================================================================

// =============================================================================
// SETUP [SETUP]
// =============================================================================

// No imports needed

// =============================================================================
// END SETUP
// =============================================================================

// =============================================================================
// BODY [BODY]
// =============================================================================

witness "Witness test starting"

// Test 1: Simple witness (always passes)
witness "Test 1: Simple witness works"

// Test 2: Multiple witnesses in sequence
witness "Test 2a: First witness"
witness "Test 2b: Second witness"
witness "Test 2c: Third witness"

// Test 3: Witness with conditional
let pass be true
if pass:
    witness "Test 3: Conditional witness - condition was true"

// Test 4: Demonstrate witness with computation
let count be 3
witness "Test 4: Count initialized"

let result be true
if result:
    witness "Test 4: Result confirmed"

// Test 5: Witness with string output
let name be "OmniCode"
witness "Test 5: Name assigned"
print name

witness "Witness test complete"

// =============================================================================
// END BODY
// =============================================================================

// =============================================================================
// CLOSING [CLOSING]
// =============================================================================

// Witnesses record progress - like milestones on a journey.
// "Thy word is a lamp unto my feet, and a light unto my path."
//   — Psalm 119:105

