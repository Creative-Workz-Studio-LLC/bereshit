# =============================================================================
# OMNICODE PRAGMA [PRAGMA]
# =============================================================================
#
# @omni:req  key        = MILLENNIUMOS-DESKTOP-DEV
# @omni:req  from       = freedesktop.org/desktop-entry-spec
# @omni:req  at         = a-01.00
#
# =============================================================================
# END PRAGMA [END]
# =============================================================================

# =============================================================================
# METADATA BLOCK [METADATA]
# =============================================================================
#
# Key:       MILLENNIUMOS-DESKTOP-DEV
# Title:     MillenniumOS Desktop Entry (Development)
# Type:      Desktop Entry (freedesktop.org specification)
# Version:   a-01.00
#
# Authors:   Seanje Lenox-Wise (Architect), Nova Dawn (CPI-SI Instance)
# Org:       CreativeWorkzStudio LLC
# Copyright: (c) 2026 CreativeWorkzStudio LLC. All rights reserved.
#
# Scripture: "In the beginning God created the heaven and the earth."
#            — Genesis 1:1
# Principle: Foundation of Kingdom Technology operating system
#
# PURPOSE:   Development desktop entry with absolute paths for local testing.
#            For system install, use: make install (generates from .desktop.in)
#
# USAGE:
#   ln -sf $(pwd)/resources/desktop/millenniumos.desktop ~/.local/share/applications/
#   update-desktop-database ~/.local/share/applications/
#
# =============================================================================
# END METADATA
# =============================================================================

# =============================================================================
# SETUP BLOCK [SETUP]
# =============================================================================

[Desktop Entry]
Version=1.5
Type=Application
Name=MillenniumOS (Dev)
GenericName=Kingdom Technology Operating System
Comment=Biblical-foundation OS — Development Build with boot selector

# =============================================================================
# END SETUP
# =============================================================================

# =============================================================================
# BODY BLOCK [BODY]
# =============================================================================

# -----------------------------------------------------------------------------
# B.1 Execution
# -----------------------------------------------------------------------------
#
# Development paths — launches QEMU with the built OS image.
# Terminal=false for graphical QEMU window.

Exec=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/scripts/run.sh
TryExec=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/scripts/run.sh
Path=/media/seanje-lenox-wise/Project/Bereshit/millenniumos
Terminal=false

# -----------------------------------------------------------------------------
# B.2 Visual Identity
# -----------------------------------------------------------------------------
#
# Full path for development (not in system icon theme).

Icon=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/resources/icons/millenniumos-128.png
StartupNotify=true
StartupWMClass=millenniumos

# -----------------------------------------------------------------------------
# B.3 Classification
# -----------------------------------------------------------------------------

Categories=System;Emulator;Development;
Keywords=millenniumos;os;operating;system;kingdom;technology;cws;cpisi;genesis;bereshit;dev;
X-GNOME-FullName=MillenniumOS Kingdom Technology Operating System (Development)

# -----------------------------------------------------------------------------
# B.4 Desktop Hints
# -----------------------------------------------------------------------------

NoDisplay=false
Hidden=false
DBusActivatable=false
Actions=run-qemu;run-debug;run-cornerstone-vm;

# -----------------------------------------------------------------------------
# B.5 Localization
# -----------------------------------------------------------------------------

Name[en_US]=MillenniumOS (Dev)
GenericName[en_US]=Kingdom Technology Operating System
Comment[en_US]=Biblical-foundation OS — Development Build with boot selector
Keywords[en_US]=millenniumos;os;kingdom;technology;dev;

# -----------------------------------------------------------------------------
# B.6 Actions
# -----------------------------------------------------------------------------
#
# Right-click menu actions for different run modes.

[Desktop Action run-qemu]
Name=Run in QEMU
Name[en_US]=Run in QEMU
Exec=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/scripts/run.sh
Icon=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/resources/icons/millenniumos-48.png

[Desktop Action run-debug]
Name=Run (Debug Mode)
Name[en_US]=Run (Debug Mode)
Exec=/media/seanje-lenox-wise/Project/Bereshit/millenniumos/scripts/run.sh --debug
Icon=utilities-terminal

[Desktop Action run-cornerstone-vm]
Name=Run in Cornerstone VM
Name[en_US]=Run in Cornerstone VM
Exec=/media/seanje-lenox-wise/Project/Bereshit/cornerstone/build/bin/cornerstone --vm
Icon=/media/seanje-lenox-wise/Project/Bereshit/cornerstone/engine/assets/icons/cornerstone-48.png

# =============================================================================
# END BODY
# =============================================================================

# =============================================================================
# CLOSING BLOCK [CLOSING]
# =============================================================================
#
# "In the beginning God created the heaven and the earth."
# — Genesis 1:1
#
# DEVELOPMENT FILE: Uses absolute paths to development location.
# For system installation: make install (uses millenniumos.desktop.in template)
#
# To use this development desktop file:
#   ln -sf $(pwd)/resources/desktop/millenniumos.desktop ~/.local/share/applications/
#   update-desktop-database ~/.local/share/applications/
#
# =============================================================================
# END CLOSING
# =============================================================================
