[Desktop Entry]
Version=1.5
Type=Application
Name=MillenniumOS
GenericName=Kingdom Technology Operating System
Comment=Biblical-foundation operating system built on CPI-SI paradigm

Exec=@BINDIR@/millenniumos-run
TryExec=@BINDIR@/millenniumos-run
Path=@DATADIR@
Terminal=false

Icon=millenniumos
StartupNotify=true
StartupWMClass=millenniumos

Categories=System;Emulator;
Keywords=millenniumos;os;operating;system;kingdom;technology;cws;cpisi;genesis;

NoDisplay=false
Hidden=false
DBusActivatable=false
Actions=run-qemu;run-debug;

Name[en_US]=MillenniumOS
GenericName[en_US]=Kingdom Technology Operating System
Comment[en_US]=Biblical-foundation operating system built on CPI-SI paradigm

[Desktop Action run-qemu]
Name=Run in QEMU
Exec=@BINDIR@/millenniumos-run
Icon=millenniumos

[Desktop Action run-debug]
Name=Run (Debug Mode)
Exec=@BINDIR@/millenniumos-run --debug
Icon=utilities-terminal
