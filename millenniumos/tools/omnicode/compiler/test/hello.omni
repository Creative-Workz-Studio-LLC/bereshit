/**
 * @brief Main entry point.
 *
 * Prints greeting and returns success.
 *
 * @return 0 on success
 */
int main(void) {
    printf("Hello from OmniCode!\n");
    printf("\n");
    printf("\"In the beginning was the Word,\n");
    printf(" and the Word was with God,\n");
    printf(" and the Word was God.\"\n");
    printf("   — John 1:1\n");
    printf("\n");
    printf("OmniCode bootstrap test: PASS\n");
    return 0;
}

