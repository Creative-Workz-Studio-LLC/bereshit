/// METADATA BLOCK [METADATA]
/// ═══════════════════════════════════════════════════════════════════════════════
///
/// @file health.h
/// @brief Health score type and operations for CPI-SI systems
///
/// Health uses balanced ternary range: -100 to +100 where:
///   - Negative: degraded, needs recovery
///   - Zero: neutral, balanced
///   - Positive: healthy, stable
///
/// Biblical Grounding:
///   "A just man falleth seven times, and riseth up again."
///   — Proverbs 24:16
///
/// ═══════════════════════════════════════════════════════════════════════════════

#ifndef HEALTH_H
#define HEALTH_H

/// ═══════════════════════════════════════════════════════════════════════════════
/// SETUP BLOCK [SETUP]
/// ═══════════════════════════════════════════════════════════════════════════════

#include <stdint.h>
#include <stdbool.h>

/// ───────────────────────────────────────────────────────────────────────────────
/// S.1 CONSTANTS [CONSTANTS]
/// ───────────────────────────────────────────────────────────────────────────────

/** Minimum health value (critical state) */
#define HEALTH_MIN  (-100)

/** Maximum health value (optimal state) */
#define HEALTH_MAX  (+100)

/** Threshold below which state is critical */
#define HEALTH_CRITICAL_THRESHOLD  (-50)

/** Threshold above which state is healthy */
#define HEALTH_HEALTHY_THRESHOLD   (+50)

/// ───────────────────────────────────────────────────────────────────────────────
/// S.2 TYPES [TYPES]
/// ───────────────────────────────────────────────────────────────────────────────

/**
 * @brief Health score type.
 *
 * Signed 8-bit integer representing health in range [HEALTH_MIN, HEALTH_MAX].
 * Balanced ternary semantics: negative = degraded, zero = neutral, positive = healthy.
 */
typedef int8_t HealthScore;

/// ═══════════════════════════════════════════════════════════════════════════════
/// END SETUP
/// ═══════════════════════════════════════════════════════════════════════════════

/// ═══════════════════════════════════════════════════════════════════════════════
/// BODY BLOCK [BODY]
/// ═══════════════════════════════════════════════════════════════════════════════

/// ───────────────────────────────────────────────────────────────────────────────
/// B.1 STATE QUERIES [QUERIES]
/// ───────────────────────────────────────────────────────────────────────────────

/**
 * @brief Check if health is in critical state.
 * @param health Health score to check
 * @return true if health <= HEALTH_CRITICAL_THRESHOLD
 */
bool health_is_critical(HealthScore health);

/**
 * @brief Check if health is in healthy state.
 * @param health Health score to check
 * @return true if health >= HEALTH_HEALTHY_THRESHOLD
 */
bool health_is_healthy(HealthScore health);

/// ───────────────────────────────────────────────────────────────────────────────
/// B.2 OPERATIONS [OPERATIONS]
/// ───────────────────────────────────────────────────────────────────────────────

/**
 * @brief Add delta to health, clamping to valid range.
 * @param current Current health score
 * @param delta Amount to add (can be negative)
 * @return New health score in [HEALTH_MIN, HEALTH_MAX]
 */
HealthScore health_add(HealthScore current, int8_t delta);

/**
 * @brief Clamp health to valid range.
 * @param value Value to clamp
 * @return Value clamped to [HEALTH_MIN, HEALTH_MAX]
 */
HealthScore health_clamp(int16_t value);

/// ═══════════════════════════════════════════════════════════════════════════════
/// END BODY
/// ═══════════════════════════════════════════════════════════════════════════════

#endif /* HEALTH_H */

/// ═══════════════════════════════════════════════════════════════════════════════
/// CLOSING BLOCK [CLOSING]
/// ═══════════════════════════════════════════════════════════════════════════════
