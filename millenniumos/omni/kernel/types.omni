structure of this work:

    organized as:
        ladder (dependencies):
            documented (1):
                libtrit types (foundation):
                    trit_t, trit5_t, trit9_t, trit27_t

                Kernel type aliases (built on libtrit):
                    mos_result_t uses int16_t (trit9 range)
                    mos_paddr_t uses trit27_t
                    mos_vaddr_t uses trit27_t
                    MosZone uses trit_t
                    MosHebrewState uses trit5_t
                    mos_flags_t uses trit5_t

                Helper functions (use libtrit pack/unpack):
                    mos_state_health_sign uses trit5_unpack
                    mos_state_k_factor uses trit5_unpack
                    mos_flag_get uses trit5_unpack
                    mos_flag_set uses trit5_pack

            implied (0):
                [none - all dependencies documented]

            omitted (-1):
                [none - complete dependency map]

implementation of this work:

    helpers:
        internal (1):
            /// MOS_FAILED - Check if result indicates failure
            ///
            /// teaching: Negative results are errors in ternary semantics
            ///
            establish macro MOS_FAILED that takes mos_result_t r and returns truth:
                meaning "Check if result is error (negative)"
                return (r is less than TRIT_ZERO)

            /// MOS_SUCCESS - Check if result indicates success
            establish macro MOS_SUCCESS that takes mos_result_t r and returns truth:
                meaning "Check if result is success (non-negative)"
                return (r is greater than or equal to TRIT_ZERO)

            /// MOS_HAS_INFO - Check if result has additional info
            establish macro MOS_HAS_INFO that takes mos_result_t r and returns truth:
                meaning "Check if result has info (positive)"
                return (r is greater than TRIT_ZERO)

            /// MOS_ZONE_VALID - Check if zone is valid trit
            establish macro MOS_ZONE_VALID that takes MosZone z and returns truth:
                meaning "Check if zone is valid (-1, 0, or +1)"
                return trit_valid with z

            /// MOS_ADDR_TO_BINARY - Convert ternary address to binary
            establish macro MOS_ADDR_TO_BINARY that takes trit27_t t27 and returns uint64_t:
                meaning "Convert ternary address to binary (trit27 is already uint64)"
                return t27

            /// MOS_BINARY_TO_ADDR - Convert binary to ternary address
            establish macro MOS_BINARY_TO_ADDR that takes uint64_t u64 and returns mos_paddr_t:
                meaning "Convert binary to ternary address (mask to trit27 range)"
                return ((mos_paddr_t)(u64) bitand TRIT27_MAX)

            /// MOS_PID_TO_BALANCED - Convert PID to balanced representation
            establish macro MOS_PID_TO_BALANCED that takes mos_pid_t pid and returns int16_t:
                meaning "Convert raw PID to balanced (-9841 to +9841)"
                return ((int16_t)(pid) minus 9841)

            /// MOS_BALANCED_TO_PID - Convert balanced to raw PID
            establish macro MOS_BALANCED_TO_PID that takes int16_t bal and returns mos_pid_t:
                meaning "Convert balanced PID to raw (0 to 19682)"
                return ((mos_pid_t)((bal) plus 9841))

            /// MOS_HEALTH_TREND - Determine health direction
            establish macro MOS_HEALTH_TREND that takes mos_health_t old and mos_health_t new and returns trit_t:
                meaning "Calculate health trend (improving/stable/degrading)"
                return trit_create with (new minus old)

        shared (0):
            [none - no helpers from other modules]

        reserved (-1):
            [none - all helpers implemented]

    operations:
        implemented (1):
            /// mos_state_health_sign - Extract health sign from Hebrew state
            ///
            /// teaching: Hebrew states encode health sign in first trit position
            ///
            establish work mos_state_health_sign that takes MosHebrewState s and returns trit_t:
                meaning "Extract health sign (-1=negative, 0=neutral, +1=positive)"

                let trits be array of trit_t with 5 elements
                call trit5_unpack with s and trits
                return trits at index 0

            /// mos_state_k_factor - Extract k-factor from Hebrew state
            ///
            /// teaching: k-factor is direction of choice (trit position 2)
            ///
            establish work mos_state_k_factor that takes MosHebrewState s and returns trit_t:
                meaning "Extract k-factor (-1=retreat, 0=hold, +1=advance)"

                let trits be array of trit_t with 5 elements
                call trit5_unpack with s and trits
                return trits at index 2

            /// mos_flag_get - Get individual permission flag
            ///
            /// teaching: Flags are packed in trit5 - extract using position
            ///
            establish work mos_flag_get that takes mos_flags_t flags and count pos and returns trit_t:
                meaning "Extract single flag from permission trit5"

                let trits be array of trit_t with 5 elements
                call trit5_unpack with flags and trits
                when (pos is greater than or equal to 0) and (pos is less than 5):
                    return trits at index pos
                return TRIT_ZERO

            /// mos_flag_set - Set individual permission flag
            ///
            /// teaching: Modify single flag in trit5 packed permissions
            ///
            establish work mos_flag_set that takes mos_flags_t flags and count pos and trit_t val and returns mos_flags_t:
                meaning "Set single flag in permission trit5"

                let trits be array of trit_t with 5 elements
                call trit5_unpack with flags and trits
                when (pos is greater than or equal to 0) and (pos is less than 5):
                    set trits at index pos to val
                return trit5_pack with trits

        delegated (0):
            [none - all operations implemented locally]

        reserved (-1):
            [none - all operations defined]

interface of this work:

    exposes:
        exported (1):
            /// Type aliases - available to all kernel code
            mos_result_t for "ternary result type"
            mos_paddr_t for "physical address"
            mos_vaddr_t for "virtual address"
            mos_size_t for "size type"
            mos_pid_t for "process ID"
            mos_tid_t for "thread ID"
            mos_uid_t for "user ID"
            mos_gid_t for "group ID"
            mos_time_t for "time in nanoseconds"
            mos_ticks_t for "timer ticks"
            MosZone for "zone type"
            MosHebrewState for "Hebrew cognitive state"
            mos_health_t for "health score"
            mos_flags_t for "permission flags"

            /// Result checking macros
            MOS_FAILED for "check error"
            MOS_SUCCESS for "check success"
            MOS_HAS_INFO for "check info"

            /// Zone checking
            MOS_ZONE_VALID for "validate zone"

            /// Address conversion
            MOS_ADDR_TO_BINARY for "ternary to binary"
            MOS_BINARY_TO_ADDR for "binary to ternary"

            /// PID conversion
            MOS_PID_TO_BALANCED for "raw to balanced"
            MOS_BALANCED_TO_PID for "balanced to raw"

            /// State extraction functions
            mos_state_health_sign for "get health sign"
            mos_state_k_factor for "get k-factor"
            mos_flag_get for "get flag"
            mos_flag_set for "set flag"

        internal (0):
            [none - all types are exported]

        reserved (-1):
