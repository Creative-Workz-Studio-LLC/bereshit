inputs of this work:

    requires:
        from stdlib (1):
            import "stdint.h" for "fixed-width integer types"
            import "stddef.h" for "size_t, NULL"
            import "stdbool.h" for "bool type"

        from internal (0):
            import "trit/trit.h" for "libtrit ternary foundation"

        from external (-1):
            [none - kernel is freestanding]

definitions of this work:

    constants:
        established (1):
            /// Result codes using ternary semantics
            ///
            /// teaching: Negative = error, Zero = success, Positive = success with info
            ///
            MOS_OK be trit of TRIT_ZERO meaning "Success (0)"
            MOS_ERR_GENERIC be count of TRIT_NEG meaning "Generic error (-1)"
            MOS_ERR_NOMEM be count of (TRIT_NEG times 2) meaning "Out of memory (-2)"
            MOS_ERR_INVALID be count of (TRIT_NEG times 3) meaning "Invalid argument (-3)"
            MOS_ERR_NOTFOUND be count of (TRIT_NEG times 4) meaning "Not found (-4)"
            MOS_ERR_BUSY be count of (TRIT_NEG times 5) meaning "Resource busy (-5)"
            MOS_ERR_TIMEOUT be count of (TRIT_NEG times 6) meaning "Operation timed out (-6)"
            MOS_ERR_PERM be count of (TRIT_NEG times 7) meaning "Permission denied (-7)"
            MOS_ERR_IO be count of (TRIT_NEG times 8) meaning "I/O error (-8)"
            MOS_ERR_NODEV be count of (TRIT_NEG times 9) meaning "No such device (-9)"

            /// Zone constants (direct trit mapping)
            MOS_ZONE_VOID be trit of TRIT_NEG meaning "Entry gate (-1, permissive)"
            MOS_ZONE_WORD be trit of TRIT_ZERO meaning "Processing (0, standard)"
            MOS_ZONE_TOV be trit of TRIT_POS meaning "Exit gate (+1, structured)"
            MOS_ZONE_UNKNOWN be trit of (-99) meaning "Invalid zone marker"

            /// Address constants
            MOS_ADDR_NULL be trit27 of 0 meaning "Null address (ternary zero)"

            /// Process ID constants
            MOS_PID_KERNEL be trit9 of 9841 meaning "Kernel pseudo-process (0 in balanced)"
            MOS_PID_INIT be trit9 of 9842 meaning "Init process (+1 in balanced)"
            MOS_PID_INVALID be trit9 of TRIT9_MAX meaning "Invalid PID marker"

            /// Hebrew state constants (trit5 packed values)
            MOS_STATE_SHAVAR be trit5 of 0 meaning "BROKEN [-1,-1,*,*,*]"
            MOS_STATE_CHASER be trit5 of 40 meaning "LACKING [-1,0,-1,*,*] k=-1"
            MOS_STATE_RATSAH be trit5 of 42 meaning "WANTING [-1,0,+1,*,*] k=+1"
            MOS_STATE_YASHAR be trit5 of 121 meaning "EVEN [0,0,0,*,*] center"
            MOS_STATE_TAMIM be trit5 of 202 meaning "SOUND [+1,0,-1,*,*] k=-1"
            MOS_STATE_SHALEM be trit5 of 204 meaning "WHOLE [+1,0,+1,*,*] k=+1"
            MOS_STATE_TOV be trit5 of 242 meaning "PERFECT [+1,+1,*,*,*]"

            /// Flag constants (trit5 packed permissions)
            MOS_FLAG_NONE be trit5 of 121 meaning "All inherit [0,0,0,0,0]"
            MOS_FLAG_RO be trit5 of 122 meaning "Read only [+1,0,0,0,0]"
            MOS_FLAG_RW be trit5 of 125 meaning "Read-write [+1,+1,0,0,0]"
            MOS_FLAG_RWX be trit5 of 134 meaning "Full access [+1,+1,+1,0,0]"
            MOS_FLAG_USER_RWX be trit5 of 161 meaning "User full [+1,+1,+1,+1,0]"

            /// Flag positions
            MOS_FLAG_POS_READ be count of 0 meaning "Read flag position"
            MOS_FLAG_POS_WRITE be count of 1 meaning "Write flag position"
            MOS_FLAG_POS_EXEC be count of 2 meaning "Execute flag position"
            MOS_FLAG_POS_USER be count of 3 meaning "User flag position"
            MOS_FLAG_POS_SHARED be count of 4 meaning "Shared flag position"

            /// Health constants
            MOS_HEALTH_MIN be count of (-127) meaning "Minimum health"
            MOS_HEALTH_MAX be count of (+127) meaning "Maximum health"
            MOS_HEALTH_NEUTRAL be trit of TRIT_ZERO meaning "Neutral health"

            /// Time constants
            MOS_NS_PER_US be count of 1000 meaning "Nanoseconds per microsecond"
            MOS_NS_PER_MS be count of 1000000 meaning "Nanoseconds per millisecond"
            MOS_NS_PER_SEC be count of 1000000000 meaning "Nanoseconds per second"

        derived (0):
            [none - all constants from scratch]

        reserved (-1):
            [none - all constants defined]

    assemblies:
        defined (1):
            /// mos_result_t - Kernel result type
            ///
            /// teaching: Results follow ternary pattern using trit9 range
            ///   Negative (-9841 to -1): Error codes
            ///   Zero (0): Success
            ///   Positive (+1 to +9841): Success with info
            ///
            mos_result_t is alias for int16_t
                meaning "Kernel result using trit9 range"

            /// Address types (ternary word = 48 bits)
            mos_paddr_t is alias for trit27_t
                meaning "Physical address (ternary word)"

            mos_vaddr_t is alias for trit27_t
                meaning "Virtual address (ternary word)"

            mos_size_t is alias for trit27_t
                meaning "Size type (ternary word)"

            /// Process/Thread/User/Group IDs (trit9 = 19,683 values)
            mos_pid_t is alias for trit9_t
                meaning "Process ID (trit9)"

            mos_tid_t is alias for trit9_t
                meaning "Thread ID (trit9)"

            mos_uid_t is alias for trit9_t
                meaning "User ID (trit9)"

            mos_gid_t is alias for trit9_t
                meaning "Group ID (trit9)"

            /// Time types (ternary word for nanosecond precision)
            mos_time_t is alias for trit27_t
                meaning "Time in nanoseconds (ternary word)"

            mos_ticks_t is alias for trit9_t
                meaning "Timer ticks (smaller granularity)"

            /// Zone type (pure trit)
            MosZone is alias for trit_t
                meaning "Zone IS a trit (void/word/tov)"

            /// Hebrew cognitive state (trit5 packed)
            MosHebrewState is alias for trit5_t
                meaning "Hebrew state (7 states packed in trit5)"

            /// Health score (scaled trit)
            mos_health_t is alias for int8_t
                meaning "Health score (-127 to +127)"

            /// Permission flags (trit5 packed)
            mos_flags_t is alias for trit5_t
                meaning "Ternary permission flags"

        extended (0):
            [none - all types are new]

        reserved (-1):
            [none - all types defined]

