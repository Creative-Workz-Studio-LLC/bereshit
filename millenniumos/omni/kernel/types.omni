// FORMAT DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════

format definitions:

    format "c" for this code:
        file extension ".h"
        derives from "millenniumos/kernel/types.h"

        pragma mapping:
            "#!omni code --c" emits:
                emit "// Code generated from OmniCode. DO NOT EDIT."
                emit "// Source: millenniumos/omni/kernel/types.omni"
                emit ""

        metadata mapping:
            "this is a code for" → file header comment block
            "keyed as" → Key: comment
            "grounded in: scripture" → Biblical grounding comment
            "authored by" → Authors comment

        setup mapping:
            "inputs: from stdlib" → #include <stdint.h> etc.
            "inputs: from internal" → #include "trit/trit.h"
            "definitions: constants" → #define statements
            "definitions: assemblies: is alias for" → typedef statements

        body mapping:
            "helpers: establish macro" → #define macro
            "operations: establish work" → static inline function

        guard:
            emit "#ifndef MILLENNIUMOS_KERNEL_TYPES_H"
            emit "#define MILLENNIUMOS_KERNEL_TYPES_H"
            at end emit "#endif // MILLENNIUMOS_KERNEL_TYPES_H"

