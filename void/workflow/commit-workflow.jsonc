// ============================================================================
// CONTENT
// ============================================================================
//
// # C.1 Schema [SCHEMA]
//
//	Format:    JSONC (workflow documentation)
//	Order:     Core insights → Message format → Workflow steps → Timing → Verification
//
// # C.2 Values [VALUES]
//
{
  "core_insights": {
    "meaningful_commits": {
      "insight": "Each commit should represent a coherent unit of work",
      "pattern": "Complete a chunk, verify it works, then commit",
      "why": "History should tell a story"
    },
    "living_versioning": {
      "insight": "Version format STAGE-PHASE.COMPLETION reflects where we are",
      "pattern": "a-01.00 (alpha, phase 1, 0%) → b-03.25 (beta, phase 3, 25%)",
      "why": "Version tells WHERE, not just a number"
    },
    "scope_prefix": {
      "insight": "Prefix identifies scope - [bereshit], [void], [word], etc.",
      "pattern": "[scope] VERB: Short description",
      "why": "Enables filtering, shows affected area"
    }
  },

  "commit_message_format": {
    "structure": "[scope] VERB: Short description\n\nBody if needed.\n\nGenerated by CreativeWorkzStudio LLC\n\nCo-Authored-By: Nova Dawn\nCo-Authored-By: Seanje Lenox-Wise (Lead)",
    "scope_options": ["bereshit", "void", "word", "tov", "libtrit", "config", "omnicode"],
    "verb_options": {
      "BUILD": "Creating new structure or features",
      "REFINE": "Improving existing content",
      "FIX": "Correcting bugs or errors",
      "DOCS": "Documentation only changes",
      "TEST": "Test additions or fixes",
      "CLEAN": "Removing unnecessary items"
    }
  },

  "workflow_steps": [
    "1. Complete a coherent chunk of work",
    "2. Verify the work (run tests, validate structure)",
    "3. Check git status - review what will be committed",
    "4. Check git diff - understand the changes",
    "5. Stage appropriate files (git add)",
    "6. Craft commit message following format",
    "7. Commit with proper attribution",
    "8. Verify commit succeeded"
  ],

  "gitmessage_integration": {
    "file": ".gitmessage",
    "purpose": "Template for consistent commit messages",
    "usage": "git config commit.template .gitmessage",
    "content_includes": ["Scope prefix", "Verb options", "Attribution block"]
  },

  "commit_timing": {
    "when_to_commit": {
      "after_chunk": "When a coherent piece of work is complete",
      "after_alignment": "When folder/file alignment is verified",
      "before_context_switch": "Before moving to different area of codebase",
      "end_of_session": "Capture progress before session ends"
    },
    "when_not_to_commit": {
      "mid_refactor": "Wait until refactor is complete and verified",
      "broken_state": "Never commit code that doesn't compile/run",
      "incomplete_thought": "Wait until the change is coherent"
    }
  },

  "verification_commands": {
    "check_status": "git status",
    "check_diff": "git diff --staged",
    "check_history": "git log --oneline -10",
    "verify_message": "Read commit message before confirming"
  },

  "key_principles": {
    "atomic_commits": "Each commit is one logical change",
    "clear_history": "Someone reading history should understand what happened",
    "proper_attribution": "Always include CWS signature and co-authors",
    "scope_accuracy": "Prefix should accurately reflect scope of changes"
  }
}

