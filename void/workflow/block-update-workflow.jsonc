// ============================================================================
// METADATA
// ============================================================================
//
// # M.1 Core Identity [IDENTITY]
//
//	Key:         B-void-workflow-block-update
//	Scripture:   "In all labour there is profit" — Proverbs 14:23
//	Principle:   Surgical precision over wholesale rewrite - block is unit of work
//	Anchor:      "A workman that needeth not to be ashamed" — 2 Timothy 2:15
//
//	Type:        Rails — infrastructure pattern for file editing
//	Role:        Defines how to update existing files block by block
//	Dependency:  DEPENDED — references block structures, glossary
//
//	Architect:   Nova Dawn
//	Created:     2025-12-25
//	Version:     a-01.00
//
//	Becomes:     word/standards/workflows/block-update.jsonc when proven
//
// # M.2 Version History [HISTORY]
//
//   - a-01.00 (2025-12-25) — Initial capture of block update patterns
//   - a-01.01 (2025-12-25) — Updated to 3-block structure with numbered sections
//
// # M.3 Interface [INTERFACE]
//
//	Consumer:  Nova Dawn, team members, Claude Code Edit tool
//	Loader:    Human reading
//	Depends:   Block structure patterns (3-block, 4-block, 5-block)
//	Pattern:   Read file → Identify blocks → Edit one block → Verify → Next block
//
// # M.4 Operational [OPERATIONAL]
//
//	Blocking:  no (-1) — workflow documentation, not executable
//	Health:    N/A — human-consumed documentation
//
//	Status:    void (capturing patterns) — moves to word/ when proven
//
// ============================================================================
// END METADATA
// ============================================================================

// ============================================================================
// CONTENT
// ============================================================================
//
// # C.1 Schema [SCHEMA]
//
//	Format:    JSONC (workflow documentation)
//	Order:     Core insights → Workflow steps → Edit patterns → Block order → Scenarios
//
// # C.2 Values [VALUES]
//
{
  "core_insights": {
    "block_is_unit": {
      "insight": "Each block is a unit of work - complete one before moving to next",
      "pattern": "METADATA → SETUP → BODY → CLOSING (4-block) or METADATA → CONTENT → CLOSING (3-block)",
      "why": "Prevents drift, enables verification at each step"
    },
    "surgical_not_wholesale": {
      "insight": "Update specific blocks, don't rewrite entire file",
      "pattern": "Identify block → Read current → Edit precisely → Verify → Next block",
      "why": "Preserves working content, reduces errors"
    },
    "read_before_edit": {
      "insight": "Always read the file before editing",
      "pattern": "Read tool first → Then Edit tool",
      "why": "Claude Code Edit requires prior Read"
    },
    "understand_before_condensing": {
      "insight": "Reducing verbosity requires understanding what each piece teaches",
      "pattern": "Read original → Ask 'what is this teaching?' → Express maturely → Preserve meaning",
      "why": "Cutting words without understanding meaning strips essential guidance"
    }
  },

  "workflow_steps": [
    "1. Read the entire file first (understand current state)",
    "2. Identify which block(s) need updating",
    "3. Start with METADATA block if dates/versions need updating",
    "4. Edit one block at a time using Edit tool",
    "5. Verify each edit before moving to next block",
    "6. Update related blocks (e.g., if CONTENT changes, METADATA version/date may need update)",
    "7. Final verification - read entire file to confirm coherence",
    "8. If root file, consider children cascade"
  ],

  "edit_tool_patterns": {
    "targeted_replace": {
      "pattern": "Match exact old_string → Replace with new_string",
      "constraint": "old_string must be unique in file",
      "tip": "Include surrounding context to ensure uniqueness"
    },
    "replace_all": {
      "pattern": "Set replace_all: true for renaming across file",
      "use_case": "Variable renaming, consistent term changes"
    }
  },

  "block_order_by_type": {
    "documentation_5block": ["METADATA", "HEADER", "CONTEXT", "CONTENT", "FOOTER"],
    "code_4block": ["METADATA", "SETUP", "BODY", "CLOSING"],
    "data_3block": ["METADATA", "CONTENT", "CLOSING"],
    "folder_3block": ["METADATA", "CONTENT", "CLOSING"]
  },

  "common_update_scenarios": {
    "version_bump": {
      "blocks": ["METADATA"],
      "updates": ["version", "updated date"]
    },
    "content_change": {
      "blocks": ["CONTENT/BODY", "METADATA"],
      "updates": ["Actual content change", "version/date bump"]
    },
    "children_update": {
      "blocks": ["CONTENT"],
      "updates": ["children list", "descriptions"],
      "note": "When folder structure changes"
    },
    "reference_fix": {
      "blocks": ["Multiple - grep to find all"],
      "updates": ["Old reference → New reference"],
      "use": "replace_all: true if consistent renaming"
    }
  },

  "verification_patterns": {
    "after_each_edit": "Read back the edited section",
    "after_all_edits": "Read entire file",
    "for_root_files": "Check if children need cascade updates"
  },

  "key_principles": {
    "block_by_block": "Complete one block before moving to next",
    "precision_over_speed": "Surgical edits prevent introducing new errors",
    "read_first": "Always read before edit - required and wise",
    "cascade_awareness": "Root changes may require children updates",
    "verify_verify_verify": "Check after each significant edit",
    "preserve_meaning": "Ask 'what is this teaching?' then express it clearly - reduce words, not meaning",
    "understand_before_condensing": "Verbose → concise requires understanding why things exist"
  }
}

// ============================================================================
// END CONTENT
// ============================================================================

