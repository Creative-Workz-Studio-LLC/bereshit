//
// 3-Block Folder: METADATA → CONTENT → CLOSING
// The middle block defines folder schema and values.
//
// 2 Tiers, 2 Sections:
//   Tier 1 - SCHEMA: What fields folder metadata has (structure definition)
//   Tier 2 - VALUES: What values this specific folder holds (instance)
//
// ═══════════════════════════════════════════════════════════════════════════

definition of this folder:

    schema:
        fields (1):
            /// name - Human-readable folder name
            ///
            /// teaching: Names communicate purpose to humans
            ///
            "name" be word
                meaning "Human-readable folder name"

            /// key - Unique identifier for this folder
            ///
            /// teaching: Keys enable programmatic reference and navigation
            ///
            "key" be word
                meaning "Unique identifier following keying standard"

            /// classification - Void designation (special entry gate)
            "classification" be value
                meaning "Void (null) - entry gate for unclassified items"

            /// derivation - Origin lineage
            "derivation" be value
                meaning "Parent folder derivation"

            /// structure - Gate folder pattern
            "structure" be word
                meaning "Entry gate organizational pattern"

            /// contents - Items awaiting classification
            "contents" be gathering
                meaning "Items currently in void awaiting placement"

            /// children - Staging areas within void
            "children" be gathering or none
                meaning "Staging subdirectories for categorized imports"

        constraints (0):
            /// temporary_only - Items must eventually be classified
            "temporary_only" ensuring "no items remain indefinitely"
                because "void is staging, not permanent storage"

            /// flow_direction - Items flow outward after classification
            "flow_direction" ensuring "items exit to word or tov"
                because "void is entry, classification leads to proper placement"

        reserved (-1):
            [none - all fields defined]

    values:
        primary (1):
            /// Folder identity values
            ///
            /// teaching: Workflow captures how we work - patterns from practice
            ///
            "name" is "Workflow"
            "key" is "B-void-workflow"
            "classification" is "void (null) - patterns forming"

        structure (0):
            /// Organizational values - workflow pattern structure
            "derivation" is "void/ (entry)"
            "structure" is "flat - workflow files at same level"
            "contents" is:
                "file-creation-workflow.jsonc" as "how to create new files from templates"
                "alignment-workflow.jsonc" as "chunk-by-chunk review and update process"
                "commit-workflow.jsonc" as "git commit patterns and conventions"
                "block-update-workflow.jsonc" as "updating existing files block by block"
            "children" is:
                [none - workflows are files, not folders]

        reserved (-1):
            [none - all values assigned]

