# ============================================================================
# EditorConfig - Consistent formatting across all editors
# ============================================================================
# https://editorconfig.org
# CreativeWorkzStudio LLC / Bereshit

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++ - 4 spaces
[*.{c,h,cpp,hpp,cc,hh,cxx,hxx}]
indent_size = 4

# Go - tabs (gofmt standard)
[*.go]
indent_style = tab

# Rust - 4 spaces (rustfmt standard)
[*.rs]
indent_size = 4

# C# - 4 spaces
[*.cs]
indent_size = 4

# TypeScript/JavaScript - 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON/YAML - 2 spaces
[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

# Markdown - preserve trailing whitespace (for line breaks)
[*.md]
trim_trailing_whitespace = false

# AsciiDoc
[*.adoc]
indent_size = 2

# Makefiles - must use tabs
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 4

# SQL
[*.sql]
indent_size = 2

# Protocol Buffers
[*.proto]
indent_size = 2
