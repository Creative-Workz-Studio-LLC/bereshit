    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "workflow",
    "_P2_role": "rails",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "workflows",
    "_P3_layer": "a-void/workflows",
    "_P3_includes": "none",
    "_P3_provides": ["ALIGNMENT_WORKFLOW"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Alignment Workflow — Documentation-Reality Gap Analysis",
    "_P5_brief": "Documentation-reality gap analysis patterns — Contract - Reality = The Work. Chunk-by-chunk alignment with bidirectional cross-updating.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "alignment-workflow.jsonc",
        "key": "B-void-workflows-alignment",
        "title": "Alignment Workflow — Documentation-Reality Gap Analysis",
        "type": "Data (Workflow)",
        "component": "Rails",
        "role": "Defines how documentation is aligned with filesystem reality — Contract - Reality = The Work"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.03",
        "status": "Active",
        "created": "2025-12-25",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Proverbs 14:23 — In all labour there is profit: but the talk of the lips tendeth only to penury.",
        "principle": "Alignment is labor that yields profit. Documentation that matches reality enables confident work. The gap between contract and reality IS the work."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "word/seed/ templates, glossary (gap-analysis, block-by-block)",
        "consumers": "Alignment tasks, documentation maintenance, gap analysis processes"
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "name": "Alignment Workflow",
    "type": "workflow",
    "scope": "global",
    "version": "a-01.03",

    "core_insights": {
        "chunk_by_chunk": {
            "insight": "Work through structure level by level, not all at once",
            "pattern": "Folder → Children → Grandchildren",
            "why": "Prevents missing updates, ensures cascade"
        },
        "gap_analysis": {
            "insight": "Contract - Reality = The Work",
            "pattern": "Read documentation → Check actual state → Identify gaps → Fix",
            "why": "Documentation must match reality"
        },
        "content_not_just_metadata": {
            "insight": "Updating metadata dates/versions is not enough",
            "pattern": "Version AND content AND children descriptions all need accuracy",
            "why": "Partial updates create drift"
        },
        "cross_updating": {
            "insight": "Alignment is bidirectional - files align to templates, templates refine from usage",
            "pattern": "Read target → Align implementation → Learn from implementation → Refine target",
            "why": "Templates improve through real usage, usage improves through better templates"
        }
    },

    "key_principles": {
        "todo_tracking": "Use TODOs to track alignment tasks - mark complete as you go",
        "block_by_block": "Don't rewrite entire file - update section by section",
        "commit_chunks": "Commit after completing a coherent chunk of alignment",
        "depth_first": "Complete one branch before moving to siblings",
        "cross_updating": "Files align TO templates AND templates get refined BY real usage",
        "bidirectional_truth": "Reality informs docs, docs inform future reality"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "workflow_steps": [
        "1. Identify chunk to align (folder, file, or section)",
        "2. Read current metadata/documentation for that chunk",
        "3. Check actual reality (ls, cat, verify existence)",
        "4. Gap analysis: What does doc say vs what exists?",
        "5. Create TODOs for alignment tasks",
        "6. Update block by block (not wholesale rewrite)",
        "7. Move to children, repeat process",
        "8. Commit when chunk is complete"
    ],

    "folder_alignment_pattern": {
        "step_1": "Evaluate folder root files (root.omni, root.adoc)",
        "step_2": "Check version, dates, content descriptions",
        "step_3": "Verify children listed match actual children",
        "step_4": "Update metadata block",
        "step_5": "Update content block (children descriptions)",
        "step_6": "Update closing block if needed",
        "step_7": "Move into child folders, repeat",
        "step_8": "Commit chunk"
    },

    "common_gaps": {
        "outdated_children": "Documentation lists children that don't exist or misses new ones",
        "wrong_references": "References to renamed folders (e.g., fruit → tov)",
        "stale_versions": "Version/date not updated when content changed",
        "missing_folder_metadata": "Folder exists but has no root.omni/root.adoc"
    },

    "verification_commands": {
        "list_children": "ls -la [folder]/",
        "check_metadata": "cat [folder]/root.omni",
        "find_references": "grep -r 'old_name' [folder]/",
        "count_files": "find [folder] -type f | wc -l"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "validation": {
        "checks": [
            "Must have actual filesystem to compare against",
            "Children listed must match actual children",
            "Version/date updated when content changed"
        ],
        "formula": "Contract - Reality = The Work"
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_never": [
        "Break 3-block structure",
        "Remove core insights",
        "Remove Cv verification sections"
    ],
    "_X1_careful": [
        "Change workflow steps (affects all alignment work)",
        "Modify core insights (foundational patterns)"
    ],
    "_X1_safe": [
        "Add insights",
        "Update verification commands",
        "Add common gaps"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Automated gap detection tooling",
        "Integration with bhealth",
        "Move to word/standards/workflows/ when proven"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "a-void/workflows/file-creation-workflow.jsonc",
        "a-void/workflows/commit-workflow.jsonc",
        "a-void/workflows/block-update-workflow.jsonc"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Alignment is labor that yields profit. Documentation that matches reality enables confident work. The gap between contract and reality IS the work.",
    "_X5_scripture": "In all hard work there is profit, but the talk of the lips leads only to poverty. — Proverbs 14:23 (WEB)",
    "_X5_anchor": "Contract - Reality = The Work. Chunk by chunk, block by block.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
