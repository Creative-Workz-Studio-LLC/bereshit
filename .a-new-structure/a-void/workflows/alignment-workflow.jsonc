// ═══════════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════════
//
// 3-Block Structure: Configuration (Cc) → Operations (Co) → Verification (Cv)
// Cc-Cv Flow: core insights → alignment steps → verification
//
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION [Cc]
// ───────────────────────────────────────────────────────────────────────────────

{
  // -------------------------------------------------------------------------
  // Cc.1 Identity [IDENTITY]
  // -------------------------------------------------------------------------
  //
  //   Workflow identity and classification.
  //   Defines what this workflow is and where it applies.
  //
  //   name:    [string] — Display name for this workflow
  //   type:    [string] — Category: workflow
  //   scope:   [global | local | feature] — Where this workflow applies
  //   version: [a|b|c]-[PHASE].[COMPLETION] — Living versioning
  //
  "name": "Alignment Workflow",                 // Display name
  "type": "workflow",                           // Classification

  "scope": "global",                            // Applies to all alignment work
  "version": "a-01.02",                         // Living version

  // -------------------------------------------------------------------------
  // Cc.2 Core Insights [INSIGHTS]
  // -------------------------------------------------------------------------
  //
  //   Foundational patterns discovered through practice.
  //   These are the WHY behind the alignment workflow.
  //
  //   [insight_name]: { insight, pattern, why }
  //
  "core_insights": {
    "chunk_by_chunk": {
      "insight": "Work through structure level by level, not all at once",
      "pattern": "Folder → Children → Grandchildren",
      "why": "Prevents missing updates, ensures cascade"
    },
    "gap_analysis": {
      "insight": "Contract - Reality = The Work",
      "pattern": "Read documentation → Check actual state → Identify gaps → Fix",
      "why": "Documentation must match reality"
    },
    "content_not_just_metadata": {
      "insight": "Updating metadata dates/versions is not enough",
      "pattern": "Version AND content AND children descriptions all need accuracy",
      "why": "Partial updates create drift"
    },
    "cross_updating": {
      "insight": "Alignment is bidirectional - files align to templates, templates refine from usage",
      "pattern": "Read target → Align implementation → Learn from implementation → Refine target",
      "why": "Templates improve through real usage, usage improves through better templates"
    }
  },

  // -------------------------------------------------------------------------
  // Cc.3 Key Principles [PRINCIPLES]
  // -------------------------------------------------------------------------
  //
  //   Standing rules that guide all alignment work.
  //   Quick reference for the essential patterns.
  //
  //   [principle]: [one-line description]
  //
  "key_principles": {
    "todo_tracking": "Use TODOs to track alignment tasks - mark complete as you go",
    "block_by_block": "Don't rewrite entire file - update section by section",
    "commit_chunks": "Commit after completing a coherent chunk of alignment",
    "depth_first": "Complete one branch before moving to siblings",
    "cross_updating": "Files align TO templates AND templates get refined BY real usage",
    "bidirectional_truth": "Reality informs docs, docs inform future reality"
  },

// ───────────────────────────────────────────────────────────────────────────────
// OPERATIONS [Co]
// ───────────────────────────────────────────────────────────────────────────────

  // -------------------------------------------------------------------------
  // Co.1 Workflow Steps [STEPS]
  // -------------------------------------------------------------------------
  //
  //   The ordered steps for aligning documentation with reality.
  //   Apply these for any alignment task.
  //
  //   [step]: [action]
  //
  "workflow_steps": [
    "1. Identify chunk to align (folder, file, or section)",
    "2. Read current metadata/documentation for that chunk",
    "3. Check actual reality (ls, cat, verify existence)",
    "4. Gap analysis: What does doc say vs what exists?",
    "5. Create TODOs for alignment tasks",
    "6. Update block by block (not wholesale rewrite)",
    "7. Move to children, repeat process",
    "8. Commit when chunk is complete"
  ],

  // -------------------------------------------------------------------------
  // Co.2 Folder Alignment Pattern [FOLDER]
  // -------------------------------------------------------------------------
  //
  //   Specific steps for aligning folder documentation.
  //   Use when aligning root.omni/root.adoc files.
  //
  //   [step]: [action]
  //
  "folder_alignment_pattern": {
    "step_1": "Evaluate folder root files (root.omni, root.adoc)",
    "step_2": "Check version, dates, content descriptions",
    "step_3": "Verify children listed match actual children",
    "step_4": "Update metadata block",
    "step_5": "Update content block (children descriptions)",
    "step_6": "Update closing block if needed",
    "step_7": "Move into child folders, repeat",
    "step_8": "Commit chunk"
  },

  // -------------------------------------------------------------------------
  // Co.3 Common Gaps [GAPS]
  // -------------------------------------------------------------------------
  //
  //   Frequently encountered alignment problems.
  //   Check for these during gap analysis.
  //
  //   [gap_type]: [description]
  //
  "common_gaps": {
    "outdated_children": "Documentation lists children that don't exist or misses new ones",
    "wrong_references": "References to renamed folders (e.g., fruit → tov)",
    "stale_versions": "Version/date not updated when content changed",
    "missing_folder_metadata": "Folder exists but has no root.omni/root.adoc"
  },

  // -------------------------------------------------------------------------
  // Co.4 Verification Commands [COMMANDS]
  // -------------------------------------------------------------------------
  //
  //   Shell commands for checking alignment.
  //   Use these during gap analysis step.
  //
  //   [operation]: [command]
  //
  "verification_commands": {
    "list_children": "ls -la [folder]/",
    "check_metadata": "cat [folder]/root.omni",
    "find_references": "grep -r 'old_name' [folder]/",
    "count_files": "find [folder] -type f | wc -l"
  },

// ───────────────────────────────────────────────────────────────────────────────
// VERIFICATION [Cv]
// ───────────────────────────────────────────────────────────────────────────────

  // -------------------------------------------------------------------------
  // Cv.1 Validation [VALIDATION]
  // -------------------------------------------------------------------------
  //
  //   How to verify alignment was done correctly.
  //   Commands and checks for aligned files.
  //
  //   commands: [array] — Shell commands to validate
  //
  "_validation": {
    "commands": [
      "npx jsonc-parser validate alignment-workflow.jsonc",
      "ls -la [folder]/ | wc -l",
      "grep -c 'children' [folder]/root.omni"
    ],
    "checks": [
      "Must have actual filesystem to compare against",
      "Children listed must match actual children",
      "Version/date updated when content changed"
    ]
  },

  // -------------------------------------------------------------------------
  // Cv.2 Schema [SCHEMA]
  // -------------------------------------------------------------------------
  //
  //   Required and optional fields for this workflow file.
  //   Parser validates these fields exist.
  //
  //   required:      [array] — Required top-level keys
  //   optional:      [array] — Optional top-level keys
  //
  "_schema": {
    "required": [
      "name",
      "type",
      "scope",
      "version",
      "core_insights",
      "key_principles",
      "workflow_steps"
    ],
    "optional": [
      "folder_alignment_pattern",
      "common_gaps",
      "verification_commands"
    ]
  },

  // -------------------------------------------------------------------------
  // Cv.3 Maintenance [MAINTENANCE]
  // -------------------------------------------------------------------------
  //
  //   Modification rules for this workflow.
  //   What's safe, what needs care, what to never touch.
  //
  //   safe:    [array] — Safe to modify
  //   careful: [array] — Modify with care
  //   never:   [array] — Never modify
  //
  "_maintenance": {
    "safe": [
      "Add insights",
      "Update verification commands",
      "Add common gaps"
    ],
    "careful": [
      "Change workflow steps (affects all alignment work)",
      "Modify core insights (foundational patterns)"
    ],
    "never": [
      "Break 3-block structure",
      "Remove core insights",
      "Remove Cv verification sections"
    ]
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// END CONTENT
