// ═══════════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════════
//
// 3-Block Structure: Configuration (Cc) → Operations (Co) → Verification (Cv)
// Cc-Cv Flow: core insights → workflow steps by type → verification
//
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────
// CONFIGURATION [Cc]
// ───────────────────────────────────────────────────────────────────────────────

{
  // -------------------------------------------------------------------------
  // Cc.1 Identity [IDENTITY]
  // -------------------------------------------------------------------------
  //
  //   Workflow identity and classification.
  //   Defines what this workflow is and where it applies.
  //
  //   name:    [string] — Display name for this workflow
  //   type:    [string] — Category: workflow
  //   scope:   [global | local | feature] — Where this workflow applies
  //   version: [a|b|c]-[PHASE].[COMPLETION] — Living versioning
  //
  "name": "File Creation Workflow",             // Display name
  "type": "workflow",                           // Classification

  "scope": "global",                            // Applies to all file creation
  "version": "a-01.02",                         // Living version

  // -------------------------------------------------------------------------
  // Cc.2 Core Insights [INSIGHTS]
  // -------------------------------------------------------------------------
  //
  //   Foundational patterns discovered through practice.
  //   These are the WHY behind the workflow steps.
  //
  //   [insight_name]: { insight, enables/not/why, glossary_term }
  //
  "core_insights": {
    "boundary_markers": {
      "insight": "Comments are parseable structure, not just for humans",
      "enables": ["grep for location", "sed for extraction", "batch operations", "validation"],
      "glossary_term": "boundary-marker"
    },
    "block_by_block": {
      "insight": "Each block is a unit of work - edit entire block, then move to next",
      "not": ["section-by-section within block", "wholesale across all blocks"],
      "glossary_term": "block-by-block"
    },
    "template_first": {
      "insight": "Never write from scratch - always derive from templates",
      "why": "Templates carry structural DNA"
    },
    "pragma_change": {
      "insight": "Change #!omni template → #!omni document/code/data after copying",
      "why": "Distinguishes templates from implementations"
    }
  },

  // -------------------------------------------------------------------------
  // Cc.3 Key Principles [PRINCIPLES]
  // -------------------------------------------------------------------------
  //
  //   Standing rules that guide all file creation.
  //   Quick reference for the essential patterns.
  //
  //   [principle]: [one-line description]
  //
  "key_principles": {
    "template_first": "cp template dest → Edit → never Write from scratch",
    "pragma_change": "Change #!omni template → #!omni document after copying",
    "block_by_block": "Complete one block before moving to next",
    "content_accuracy": "Update content to match reality, not just metadata",
    "location_agnostic": "Structure is the same whether in void/ or word/",
    "cross_updating": "Templates align TO target AND get refined BY real usage",
    "phd_bible_principle": "Understanding enables concise expression - express maturely, not verbosely"
  },

// ───────────────────────────────────────────────────────────────────────────────
// OPERATIONS [Co]
// ───────────────────────────────────────────────────────────────────────────────

  // -------------------------------------------------------------------------
  // Co.1 Workflow by Type [TYPES]
  // -------------------------------------------------------------------------
  //
  //   File type determines structure and template location.
  //   Each type has its own block pattern and source.
  //
  //   structure:         [string] — Block pattern (3/4/5-block)
  //   blocks:            [array] — Block names in order
  //   template_location: [string] — Where to find templates
  //   skill:             [string] — Skill that implements this
  //
  "workflow_by_type": {
    "documentation": {
      "structure": "5-block",
      "blocks": ["METADATA", "HEADER", "CONTEXT", "CONTENT", "FOOTER"],
      "template_location": "word/seed/documentation/",
      "skill": "create-documentation"
    },
    "code": {
      "structure": "4-block",
      "blocks": ["METADATA", "SETUP", "BODY", "CLOSING"],
      "template_location": "word/seed/code/",
      "skill": "create-code"
    },
    "data": {
      "structure": "3-block",
      "blocks": ["METADATA", "CONTENT", "CLOSING"],
      "template_location": "word/seed/data/",
      "skill": "create-data"
    }
  },

  // -------------------------------------------------------------------------
  // Co.2 Workflow Steps [STEPS]
  // -------------------------------------------------------------------------
  //
  //   The ordered steps for creating any file.
  //   Apply these regardless of file type.
  //
  //   [step]: [action]
  //
  "workflow_steps": [
    "1. Determine type (documentation/code/data)",
    "2. Copy template: cp word/seed/[type]/template dest",
    "3. Change pragma: #!omni template → #!omni document/code/data",
    "4. Update meta.key, meta.from, meta.at",
    "5. Fill blocks one at a time (block-by-block)",
    "6. Remove template notes/examples",
    "7. Verify structure complete"
  ],

  // -------------------------------------------------------------------------
  // Co.3 Template Locations [LOCATIONS]
  // -------------------------------------------------------------------------
  //
  //   Quick reference for where templates live.
  //   Use these paths in step 2.
  //
  //   [type]: [path]
  //
  "template_locations": {
    "documentation": "word/seed/documentation/adoc/",
    "code_go": "word/seed/code/go/",
    "data_json_3block": "word/seed/data/json/3block/",
    "data_json_4block": "word/seed/data/json/4block/",
    "folder": "Copy parent root.omni and update"
  },

  // -------------------------------------------------------------------------
  // Co.4 Linux Tool Patterns [TOOLS]
  // -------------------------------------------------------------------------
  //
  //   Command patterns for working with block-structured files.
  //   Use these for navigation and extraction.
  //
  //   [operation]: [command]
  //
  "linux_tool_patterns": {
    "find_block": "grep -n 'BLOCK NAME' file",
    "extract_block": "sed -n '/START/,/END/p' file",
    "remove_lines": "sed -i 'N,Md' file",
    "count_blocks": "grep -c 'BLOCK' file"
  },

// ───────────────────────────────────────────────────────────────────────────────
// VERIFICATION [Cv]
// ───────────────────────────────────────────────────────────────────────────────

  // -------------------------------------------------------------------------
  // Cv.1 Validation [VALIDATION]
  // -------------------------------------------------------------------------
  //
  //   How to verify the workflow was followed correctly.
  //   Commands and checks for created files.
  //
  //   commands: [array] — Shell commands to validate
  //
  "_validation": {
    "commands": [
      "npx jsonc-parser validate file-creation-workflow.jsonc",
      "grep -c 'BLOCK' [created_file]",
      "head -5 [created_file] | grep '#!omni document'"
    ],
    "checks": [
      "Template paths must exist",
      "Skill names must match",
      "Pragma changed from template to document/code/data"
    ]
  },

  // -------------------------------------------------------------------------
  // Cv.2 Schema [SCHEMA]
  // -------------------------------------------------------------------------
  //
  //   Required and optional fields for this workflow file.
  //   Parser validates these fields exist.
  //
  //   required:      [array] — Required top-level keys
  //   optional:      [array] — Optional top-level keys
  //
  "_schema": {
    "required": [
      "name",
      "type",
      "scope",
      "version",
      "core_insights",
      "key_principles",
      "workflow_by_type",
      "workflow_steps"
    ],
    "optional": [
      "template_locations",
      "linux_tool_patterns"
    ]
  },

  // -------------------------------------------------------------------------
  // Cv.3 Maintenance [MAINTENANCE]
  // -------------------------------------------------------------------------
  //
  //   Modification rules for this workflow.
  //   What's safe, what needs care, what to never touch.
  //
  //   safe:    [array] — Safe to modify
  //   careful: [array] — Modify with care
  //   never:   [array] — Never modify
  //
  "_maintenance": {
    "safe": [
      "Add insights",
      "Update template paths",
      "Add new file types"
    ],
    "careful": [
      "Change workflow steps (affects all file creation)",
      "Modify core insights (foundational patterns)"
    ],
    "never": [
      "Break 3-block structure",
      "Remove core insights",
      "Remove Cv verification sections"
    ]
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// END CONTENT
// ═══════════════════════════════════════════════════════════════════════════════

