{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-void-workflows-file-creation",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-01.03",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "workflow",
    "_P2_role": "rails",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "workflows",
    "_P3_layer": "a-void/workflows",
    "_P3_includes": "none",
    "_P3_provides": ["FILE_CREATION_WORKFLOW"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "File Creation Workflow — Template-First Patterns",
    "_P5_brief": "Template-first file creation patterns — never write from scratch. Templates carry structural DNA.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "file-creation-workflow.jsonc",
        "key": "B-void-workflows-file-creation",
        "title": "File Creation Workflow — Template-First Patterns",
        "type": "Data (Workflow)",
        "component": "Rails",
        "role": "Defines how new files are created from templates — never write from scratch"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.03",
        "status": "Active",
        "created": "2025-12-11",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Exodus 25:40 — Look that thou make them after their pattern, which was shewed thee in the mount.",
        "principle": "Templates carry structural DNA — the pattern was shown on the mount. Copy → customize → never reinvent. The work of templating enables consistent, quality output across all files."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "word/seed/ templates, glossary (boundary-marker, block-by-block)",
        "consumers": "create-from-template skill, create-documentation skill, file creation tasks"
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "name": "File Creation Workflow",
    "type": "workflow",
    "scope": "global",
    "version": "a-01.03",

    "core_insights": {
        "boundary_markers": {
            "insight": "Comments are parseable structure, not just for humans",
            "enables": ["grep for location", "sed for extraction", "batch operations", "validation"],
            "glossary_term": "boundary-marker"
        },
        "block_by_block": {
            "insight": "Each block is a unit of work - edit entire block, then move to next",
            "not": ["section-by-section within block", "wholesale across all blocks"],
            "glossary_term": "block-by-block"
        },
        "template_first": {
            "insight": "Never write from scratch - always derive from templates",
            "why": "Templates carry structural DNA"
        },
        "pragma_change": {
            "insight": "Change #!omni template → #!omni document/code/data after copying",
            "why": "Distinguishes templates from implementations"
        }
    },

    "key_principles": {
        "template_first": "cp template dest → Edit → never Write from scratch",
        "pragma_change": "Change #!omni template → #!omni document after copying",
        "block_by_block": "Complete one block before moving to next",
        "content_accuracy": "Update content to match reality, not just metadata",
        "location_agnostic": "Structure is the same whether in void/ or word/",
        "cross_updating": "Templates align TO target AND get refined BY real usage",
        "phd_bible_principle": "Understanding enables concise expression - express maturely, not verbosely"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "workflow_by_type": {
        "documentation": {
            "structure": "5-block",
            "blocks": ["METADATA", "HEADER", "CONTEXT", "CONTENT", "FOOTER"],
            "template_location": "b-word/seed/documentation/L0/",
            "skill": "create-documentation"
        },
        "code": {
            "structure": "4-block",
            "blocks": ["METADATA", "SETUP", "BODY", "CLOSING"],
            "template_location": "b-word/seed/code/L0/",
            "skill": "create-code"
        },
        "data": {
            "structure": "3-block",
            "blocks": ["METADATA", "CONTENT", "CLOSING"],
            "template_location": "b-word/seed/data/L0/",
            "skill": "create-data"
        }
    },

    "workflow_steps": [
        "1. Determine type (documentation/code/data)",
        "2. Copy template: cp b-word/seed/[type]/L0/template dest",
        "3. Change pragma: #!omni template → #!omni document/code/data",
        "4. Update _P1_key, _P1_from, _P1_at",
        "5. Fill blocks one at a time (block-by-block)",
        "6. Remove template notes/examples",
        "7. Verify structure complete"
    ],

    "template_locations": {
        "documentation_adoc": "b-word/seed/documentation/L0/asciidoc/",
        "documentation_md": "b-word/seed/documentation/L0/markdown/",
        "code_go": "b-word/seed/code/L0/go/",
        "code_c": "b-word/seed/code/L0/c/",
        "data_json": "b-word/seed/data/L0/json/",
        "data_toml": "b-word/seed/data/L0/toml/",
        "folder_omni": "Copy parent root.omni and update"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "validation": {
        "checks": [
            "Template paths must exist",
            "Pragma changed from template to document/code/data",
            "All required blocks present for type",
            "cws-struct lint passes (0 errors)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_never": [
        "Break 3-block structure",
        "Remove core insights",
        "Remove Cv verification sections"
    ],
    "_X1_careful": [
        "Change workflow steps (affects all file creation)",
        "Modify core insights (foundational patterns)"
    ],
    "_X1_safe": [
        "Add insights",
        "Update template paths",
        "Add new file types"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Integration with validation tools",
        "Auto-verification after file creation",
        "Move to word/standards/workflows/ when proven"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "a-void/workflows/alignment-workflow.jsonc",
        "a-void/workflows/commit-workflow.jsonc",
        "a-void/workflows/block-update-workflow.jsonc"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Templates are labor that yields profit. The work of creating good templates enables every file that follows to carry that structural DNA forward.",
    "_X5_scripture": "Look that thou make them after their pattern, which was shewed thee in the mount. — Exodus 25:40",
    "_X5_anchor": "Never write from scratch. Copy, customize, verify.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
