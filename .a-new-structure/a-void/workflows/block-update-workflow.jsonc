    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "workflows",
    "_P3_layer": "a-void/workflows",
    "_P3_includes": "none",
    "_P3_provides": ["BLOCK_UPDATE_WORKFLOW"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Block Update Workflow — Surgical File Editing",
    "_P5_brief": "Surgical block-by-block file editing patterns — precision over wholesale rewrite. Each block is a unit of work.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "block-update-workflow.jsonc",
        "key": "B-void-workflows-block-update",
        "title": "Block Update Workflow — Surgical File Editing",
        "type": "Data (Workflow)",
        "component": "Rails",
        "role": "Defines how existing files are updated block by block — precision over wholesale rewrite"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.03",
        "status": "Active",
        "created": "2025-12-11",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "2 Timothy 2:15 — Study to shew thyself approved unto God, a workman that needeth not to be ashamed, rightly dividing the word of truth.",
        "principle": "Surgical precision honors the work already done. Block-by-block editing preserves what's working while improving what needs attention. Rightly dividing — each block gets its proper treatment."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "Block structure patterns (3-block, 4-block, 5-block), Claude Code Edit tool",
        "consumers": "File modification tasks, content updates, maintenance processes"
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "name": "Block Update Workflow",
    "type": "workflow",
    "scope": "global",
    "version": "a-01.03",

    "core_insights": {
        "block_is_unit": {
            "insight": "Each block is a unit of work - complete one before moving to next",
            "pattern": "METADATA → SETUP → BODY → CLOSING (4-block) or METADATA → CONTENT → CLOSING (3-block)",
            "why": "Prevents drift, enables verification at each step"
        },
        "surgical_not_wholesale": {
            "insight": "Update specific blocks, don't rewrite entire file",
            "pattern": "Identify block → Read current → Edit precisely → Verify → Next block",
            "why": "Preserves working content, reduces errors"
        },
        "read_before_edit": {
            "insight": "Always read the file before editing",
            "pattern": "Read tool first → Then Edit tool",
            "why": "Claude Code Edit requires prior Read"
        },
        "understand_before_condensing": {
            "insight": "Reducing verbosity requires understanding what each piece teaches",
            "pattern": "Read original → Ask 'what is this teaching?' → Express maturely → Preserve meaning",
            "why": "Cutting words without understanding meaning strips essential guidance"
        }
    },

    "key_principles": {
        "block_by_block": "Complete one block before moving to next",
        "precision_over_speed": "Surgical edits prevent introducing new errors",
        "read_first": "Always read before edit - required and wise",
        "cascade_awareness": "Root changes may require children updates",
        "verify_verify_verify": "Check after each significant edit",
        "preserve_meaning": "Ask 'what is this teaching?' then express it clearly - reduce words, not meaning",
        "understand_before_condensing": "Verbose → concise requires understanding why things exist"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "workflow_steps": [
        "1. Read the entire file first (understand current state)",
        "2. Identify which block(s) need updating",
        "3. Start with METADATA block if dates/versions need updating",
        "4. Edit one block at a time using Edit tool",
        "5. Verify each edit before moving to next block",
        "6. Update related blocks (e.g., if CONTENT changes, METADATA version/date may need update)",
        "7. Final verification - read entire file to confirm coherence",
        "8. If root file, consider children cascade"
    ],

    "edit_tool_patterns": {
        "targeted_replace": {
            "pattern": "Match exact old_string → Replace with new_string",
            "constraint": "old_string must be unique in file",
            "tip": "Include surrounding context to ensure uniqueness"
        },
        "replace_all": {
            "pattern": "Set replace_all: true for renaming across file",
            "use_case": "Variable renaming, consistent term changes"
        }
    },

    "block_order_by_type": {
        "documentation_5block": ["METADATA", "HEADER", "CONTEXT", "CONTENT", "FOOTER"],
        "code_4block": ["METADATA", "SETUP", "BODY", "CLOSING"],
        "data_3block": ["METADATA", "CONTENT", "CLOSING"],
        "folder_3block": ["METADATA", "CONTENT", "CLOSING"]
    },

    "common_update_scenarios": {
        "version_bump": {
            "blocks": ["METADATA"],
            "updates": ["version", "updated date"]
        },
        "content_change": {
            "blocks": ["CONTENT/BODY", "METADATA"],
            "updates": ["Actual content change", "version/date bump"]
        },
        "children_update": {
            "blocks": ["CONTENT"],
            "updates": ["children list", "descriptions"],
            "note": "When folder structure changes"
        },
        "reference_fix": {
            "blocks": ["Multiple - grep to find all"],
            "updates": ["Old reference → New reference"],
            "use": "replace_all: true if consistent renaming"
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "validation": {
        "patterns": {
            "after_each_edit": "Read back the edited section",
            "after_all_edits": "Read entire file",
            "for_root_files": "Check if children need cascade updates"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_never": [
        "Break 3-block structure",
        "Remove core insights",
        "Remove Cv verification sections"
    ],
    "_X1_careful": [
        "Change workflow steps (affects all file editing)",
        "Modify core insights (foundational patterns)"
    ],
    "_X1_safe": [
        "Add scenarios",
        "Update verification patterns",
        "Add edit patterns"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Integration with file type detection",
        "Automated block boundary checking",
        "Move to word/standards/workflows/ when proven"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "a-void/workflows/file-creation-workflow.jsonc",
        "a-void/workflows/alignment-workflow.jsonc",
        "a-void/workflows/commit-workflow.jsonc"
