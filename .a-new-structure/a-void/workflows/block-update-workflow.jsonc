    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Surgical precision honors the work already done. Block-by-block editing preserves what's working while improving what needs attention.",
    "_X5_scripture": "Give diligence to present yourself approved by God, a workman who doesn't need to be ashamed, properly handling the Word of truth. — 2 Timothy 2:15 (WEB)",
    "_X5_anchor": "Block is the unit of work. Complete one, verify, move to next.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
