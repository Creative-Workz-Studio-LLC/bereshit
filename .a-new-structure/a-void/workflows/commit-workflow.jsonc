    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "workflow",
    "_P2_role": "rails",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "workflows",
    "_P3_layer": "a-void/workflows",
    "_P3_includes": "none",
    "_P3_provides": ["COMMIT_WORKFLOW"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Commit Workflow — Git Conventions for Kingdom Technology",
    "_P5_brief": "Git commit conventions for Kingdom Technology — each commit is a coherent unit of work. History tells a story.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "commit-workflow.jsonc",
        "key": "B-void-workflows-commit",
        "title": "Commit Workflow — Git Conventions for Kingdom Technology",
        "type": "Data (Workflow)",
        "component": "Rails",
        "role": "Defines commit patterns and conventions — history tells a story"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.03",
        "status": "Active",
        "created": "2025-12-25",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "Each commit has a time and a purpose. Meaningful commits tell the story of how Kingdom Technology was built — one coherent chunk at a time."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "git, .gitmessage template, git conventions",
        "consumers": "git commit, /commit skill, version control, code review, release management"
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "name": "Commit Workflow",
    "type": "workflow",
    "scope": "global",
    "version": "a-01.03",

    "core_insights": {
        "meaningful_commits": {
            "insight": "Each commit should represent a coherent unit of work",
            "pattern": "Complete a chunk, verify it works, then commit",
            "why": "History should tell a story"
        },
        "living_versioning": {
            "insight": "Version format STAGE-PHASE.COMPLETION reflects where we are",
            "pattern": "a-01.00 (alpha, phase 1, 0%) → b-03.25 (beta, phase 3, 25%)",
            "why": "Version tells WHERE, not just a number"
        },
        "scope_prefix": {
            "insight": "Prefix identifies scope - [bereshit], [void], [word], etc.",
            "pattern": "[scope] VERB: Short description",
            "why": "Enables filtering, shows affected area"
        }
    },

    "key_principles": {
        "atomic_commits": "Each commit is one logical change",
        "clear_history": "Someone reading history should understand what happened",
        "proper_attribution": "Always include CWS signature and co-authors",
        "scope_accuracy": "Prefix should accurately reflect scope of changes"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "commit_message_format": {
        "structure": "[scope] VERB: Short description\n\nBody if needed.\n\nGenerated by CreativeWorkzStudio LLC\n\nCo-Authored-By: Nova Dawn\nCo-Authored-By: Seanje Lenox-Wise (Lead)",
        "scope_options": ["bereshit", "void", "word", "tov", "libtrit", "config", "omnicode"],
        "verb_options": {
            "BUILD": "Creating new structure or features",
            "REFINE": "Improving existing content",
            "FIX": "Correcting bugs or errors",
            "DOCS": "Documentation only changes",
            "TEST": "Test additions or fixes",
            "CLEAN": "Removing unnecessary items",
            "WAVE": "Major milestone or multi-area change",
            "INFRA": "Infrastructure and deployment changes"
        }
    },

    "workflow_steps": [
        "1. Complete a coherent chunk of work",
        "2. Verify the work (run tests, validate structure)",
        "3. Check git status - review what will be committed",
        "4. Check git diff - understand the changes",
        "5. Stage appropriate files (git add)",
        "6. Craft commit message following format",
        "7. Commit with proper attribution",
        "8. Verify commit succeeded"
    ],

    "commit_timing": {
        "when_to_commit": {
            "after_chunk": "When a coherent piece of work is complete",
            "after_alignment": "When folder/file alignment is verified",
            "before_context_switch": "Before moving to different area of codebase",
            "end_of_session": "Capture progress before session ends"
        },
        "when_not_to_commit": {
            "mid_refactor": "Wait until refactor is complete and verified",
            "broken_state": "Never commit code that doesn't compile/run",
            "incomplete_thought": "Wait until the change is coherent"
        }
    },

    "gitmessage_integration": {
        "file": ".gitmessage",
        "purpose": "Template for consistent commit messages",
        "usage": "git config commit.template .gitmessage",
        "content_includes": ["Scope prefix", "Verb options", "Attribution block"]
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "validation": {
        "checks": [
            "Must have .gitmessage configured",
            "Scope must match changes",
            "Attribution block present",
            "Commit message follows [scope] VERB: description format"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_never": [
        "Break 3-block structure",
        "Remove attribution",
        "Remove Cv verification sections"
    ],
    "_X1_careful": [
        "Change message format (affects all commits)",
        "Modify core insights (foundational patterns)"
    ],
    "_X1_safe": [
        "Add scopes",
        "Add verb options",
        "Update timing guidance"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Pre-commit hook validation",
        "Automated scope detection",
        "Move to word/standards/workflows/ when proven"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "a-void/workflows/file-creation-workflow.jsonc",
        "a-void/workflows/alignment-workflow.jsonc",
        "a-void/workflows/block-update-workflow.jsonc"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Each commit is a witness to the work. Meaningful commits tell the story of how Kingdom Technology was built — one coherent chunk at a time.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose under the heaven. — Ecclesiastes 3:1",
    "_X5_anchor": "History tells a story. Make each commit count.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
