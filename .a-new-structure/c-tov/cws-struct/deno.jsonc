{
    // #!omni data --jsonc
    "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-cws-struct-deno-config",
    "_P1_from": "b-word/seed/data/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "config",
    "_P2_role": "tool",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "cws-struct",
    "_P3_layer": "c-tov/cws-struct",
    "_P3_includes": "none",
    "_P3_provides": ["CWS_STRUCT_DENO_CONFIG"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:Deno/TS — structuring tool for all layers",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "CWS Struct — Deno Project Configuration",
    "_P5_brief": "Deno runtime configuration for the unified structuring and alignment tool",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "deno.jsonc",
        "key": "B-tov-cws-struct-deno-config",
        "title": "CWS Struct — Deno Project Configuration",
        "type": "Data (Configuration)",
        "component": "cws-struct",
        "role": "Runtime configuration for the structuring tool — tasks, imports, compiler options"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-11",
        "updated": "2026-02-11"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Ecclesiastes 9:10 — Whatsoever thy hand findeth to do, do it with thy might.",
        "principle": "Tools built well serve the builder faithfully. Configuration done right means the tool just works."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "Deno 2.6+",
        "consumers": "cws-struct CLI tool (mod.ts entrypoint)",
        "related_data": {
            "role": "Deno project config consumed by the Deno runtime and toolchain",
            "parent_template": "b-word/seed/data/json/config.jsonc — 3-block JSONC template",
            "tool_source": "c-tov/cwe-creator-tools/ — original standalone linters this tool unifies",
            "relationship": "Configuration for the tool that validates configuration — self-referential integrity"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Deno reads top-level keys it recognizes and ignores _ prefixed keys.
    // Structure lives in _ fields. Deno config lives in standard keys.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Project identity and Deno-specific naming.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — Deno native config format, UTF-8, LF line endings",

    "name": "@cws/struct",
    "version": "0.1.0",
    "exports": "./mod.ts",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Deno tasks, import map, and compiler options.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "tasks": {

        // ── Lint: per-format (append targets after task name) ────
        // Note: --allow-ffi and --allow-write needed when --db is used
        "lint": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint",
        "lint:go": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint go",
        "lint:rust": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint rust",
        "lint:toml": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint toml",
        "lint:json": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint json",
        "lint:makefile": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint makefile",
        "lint:dotfiles": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint dotfiles",
        "lint:omni": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint omni",
        "lint:ofd": "deno run --allow-read --allow-write --allow-ffi --allow-env mod.ts lint ofd",

        // ── Lint: output modes (append format + targets) ─────────
        "lint:verbose": "deno run --allow-read mod.ts lint --verbose",
        "lint:deep": "deno run --allow-read mod.ts lint --deep",
        "lint:errors": "deno run --allow-read mod.ts lint --errors-only",
        "lint:summary": "deno run --allow-read mod.ts lint --summary",
        "lint:json-out": "deno run --allow-read mod.ts lint --json",
        "lint:changed": "deno run --allow-read --allow-run mod.ts lint --changed",
        "lint:staged": "deno run --allow-read --allow-run mod.ts lint --staged",

        // ── Watch: monitor and re-lint on change ─────────────────
        "watch": "deno run --allow-read --allow-run mod.ts watch",

        // ── Transform: per-format (append targets) ───────────────
        "transform": "deno run --allow-read --allow-write mod.ts transform",
        "transform:go": "deno run --allow-read --allow-write mod.ts transform go",
        "transform:rust": "deno run --allow-read --allow-write mod.ts transform rust",
        "transform:toml": "deno run --allow-read --allow-write mod.ts transform toml",
        "transform:json": "deno run --allow-read --allow-write mod.ts transform json",
        "transform:dry": "deno run --allow-read mod.ts transform --dry-run",

        // ── Create: per-format (append subtype + dest) ───────────
        "create": "deno run --allow-read --allow-write mod.ts create",
        "create:go": "deno run --allow-read --allow-write mod.ts create go",
        "create:rust": "deno run --allow-read --allow-write mod.ts create rust",
        "create:dry": "deno run --allow-read mod.ts create --dry-run",

        // ── Query: database queries (append --db <path>) ──────────
        "query": "deno run --allow-read --allow-ffi mod.ts query",
        "query:health": "deno run --allow-read --allow-ffi mod.ts query health",
        "query:worst": "deno run --allow-read --allow-ffi mod.ts query worst",
        "query:best": "deno run --allow-read --allow-ffi mod.ts query best",
        "query:patterns": "deno run --allow-read --allow-ffi mod.ts query patterns",
        "query:trend": "deno run --allow-read --allow-ffi mod.ts query trend",
        "query:instance": "deno run --allow-read --allow-ffi mod.ts query instance",
        "query:session": "deno run --allow-read --allow-ffi mod.ts query session",
        "query:stats": "deno run --allow-read --allow-ffi mod.ts query stats",

        // ── Verify, Check, Info ──────────────────────────────────
        "verify": "deno run --allow-read --allow-run mod.ts verify env",
        "verify:verbose": "deno run --allow-read --allow-run mod.ts verify env --verbose",
        "check": "deno check mod.ts",
        "formats": "deno run --allow-read mod.ts formats",
        "help": "deno run --allow-read mod.ts help",

        // ── Test: full suite ─────────────────────────────────────
        "test": "deno test --allow-read --allow-write --allow-run --allow-env --ignore=tests/tool/T00/data/database_test.ts --ignore=tests/content/R10/api/health_query_test.ts tests/",
        "test:watch": "deno test --allow-read --allow-write --allow-run --allow-env --watch --ignore=tests/tool/T00/data/database_test.ts --ignore=tests/content/R10/api/health_query_test.ts tests/",
        "test:db": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net tests/tool/T00/data/database_test.ts",

        // ── Test: by layer (semantic domain) ─────────────────────
        //    test/<layer>/R[n]/<tool|format>/<concern>/
        //    Layer → error code namespace → debugger in disguise
        "test:existence": "deno test --allow-read --allow-write --allow-run --allow-env tests/existence/",
        "test:organization": "deno test --allow-read --allow-write --allow-run --allow-env tests/organization/",
        "test:content": "deno test --allow-read --allow-write --allow-run --allow-env --ignore=tests/content/R10/api/health_query_test.ts tests/content/",
        "test:pattern": "deno test --allow-read --allow-write --allow-run --allow-env tests/pattern/",
        "test:tool": "deno test --allow-read --allow-write --allow-run --allow-env tests/tool/",

        // ── Test: by R[n] detection level ────────────────────────
        "test:R50": "deno test --allow-read --allow-write --allow-run --allow-env tests/existence/R50/",
        "test:R25": "deno test --allow-read --allow-write --allow-run --allow-env tests/organization/R25/",
        "test:R10": "deno test --allow-read --allow-write --allow-run --allow-env --ignore=tests/content/R10/api/health_query_test.ts tests/content/R10/",
        "test:R05": "deno test --allow-read --allow-write --allow-run --allow-env tests/pattern/R05/",
        "test:R03": "deno test --allow-read --allow-write --allow-run --allow-env tests/pattern/R03/",
        "test:T00": "deno test --allow-read --allow-write --allow-run --allow-env tests/tool/T00/",

        // ── Test: by handler (all layers for one format) ─────────
        "test:go": "deno test --allow-read --allow-write --allow-run tests/existence/R50/go/ tests/organization/R25/go/ tests/content/R10/go/ tests/pattern/R05/go/ tests/pattern/R03/go/",
        "test:rust": "deno test --allow-read --allow-write --allow-run tests/existence/R50/rust/ tests/organization/R25/rust/ tests/content/R10/rust/ tests/pattern/R05/rust/ tests/pattern/R03/rust/",
        "test:toml": "deno test --allow-read --allow-write --allow-run tests/existence/R50/toml/ tests/organization/R25/toml/ tests/content/R10/toml/ tests/pattern/R05/toml/",

        // ── Test: by tool component (across layers) ──────────────
        "test:engine": "deno test --allow-read --allow-write --allow-run --allow-env tests/existence/R50/engine/ tests/organization/R25/engine/ tests/content/R10/engine/ tests/pattern/R05/engine/",
        "test:data": "deno test --allow-read --allow-write --allow-run --allow-env tests/existence/R50/data/ tests/content/R10/data/",
        "test:foundation": "deno test --allow-read --allow-write --allow-run --allow-env tests/existence/R50/foundation/ tests/organization/R25/foundation/ tests/content/R10/foundation/",
        "test:shared": "deno test --allow-read --allow-write --allow-run --allow-env tests/organization/R25/shared/ tests/content/R10/shared/ tests/pattern/R05/shared/ tests/pattern/R03/shared/",
        "test:api": "deno test --allow-read --allow-write --allow-run --allow-env --ignore=tests/content/R10/api/health_query_test.ts tests/organization/R25/api/ tests/content/R10/api/",

        // ── Test: cross-cutting ──────────────────────────────────
        "test:cli": "deno test --allow-read --allow-write --allow-run --allow-env tests/cli/",
        "test:integration": "deno test --allow-read --allow-write --allow-run tests/integration/",
        "test:verify": "deno test --allow-read --allow-run tests/tool/T00/verify/",

        // ── Test: handler x R[n] (targeted) ──────────────────────
        "test:go:R50": "deno test --allow-read --allow-write --allow-run tests/existence/R50/go/",
        "test:go:R25": "deno test --allow-read --allow-write --allow-run tests/organization/R25/go/",
        "test:go:R10": "deno test --allow-read --allow-write --allow-run tests/content/R10/go/",
        "test:go:R05": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/go/",
        "test:go:R03": "deno test --allow-read --allow-write --allow-run tests/pattern/R03/go/",
        "test:rust:R50": "deno test --allow-read --allow-write --allow-run tests/existence/R50/rust/",
        "test:rust:R25": "deno test --allow-read --allow-write --allow-run tests/organization/R25/rust/",
        "test:rust:R10": "deno test --allow-read --allow-write --allow-run tests/content/R10/rust/",
        "test:rust:R05": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/rust/",
        "test:rust:R03": "deno test --allow-read --allow-write --allow-run tests/pattern/R03/rust/",
        "test:toml:R50": "deno test --allow-read --allow-write --allow-run tests/existence/R50/toml/",
        "test:toml:R25": "deno test --allow-read --allow-write --allow-run tests/organization/R25/toml/",
        "test:toml:R10": "deno test --allow-read --allow-write --allow-run tests/content/R10/toml/",
        "test:toml:R05": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/toml/",

        // ── Test: by concern (directory-based) ───────────────────
        //    Error code fires → navigate to concern dir → find the test
        "test:blocks": "deno test --allow-read --allow-write --allow-run tests/existence/R50/rust/blocks/ tests/existence/R50/go/blocks/ tests/existence/R50/toml/blocks/ tests/existence/R50/json/blocks/",
        "test:ordering": "deno test --allow-read --allow-write --allow-run tests/organization/R25/rust/ordering/ tests/organization/R25/go/ordering/ tests/organization/R25/makefile/ordering/",
        "test:concept": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/rust/concept/ tests/pattern/R05/go/concept/ tests/pattern/R05/toml/concept/ tests/pattern/R05/ofd/concept/ tests/pattern/R03/",
        "test:recursion": "deno test --allow-read --allow-write --allow-run tests/pattern/R03/rust/recursion/",
        "test:self-access": "deno test --allow-read --allow-write --allow-run tests/pattern/R03/go/self-access/",
        "test:transform": "deno test --allow-read --allow-write --allow-run tests/integration/",

        // ── Test: handler x concern (targeted debugging) ─────────
        "test:rust:blocks": "deno test --allow-read --allow-write --allow-run tests/existence/R50/rust/blocks/",
        "test:rust:ordering": "deno test --allow-read --allow-write --allow-run tests/organization/R25/rust/ordering/",
        "test:rust:content": "deno test --allow-read --allow-write --allow-run tests/content/R10/rust/content/",
        "test:rust:concept": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/rust/concept/ tests/pattern/R03/rust/recursion/",
        "test:go:blocks": "deno test --allow-read --allow-write --allow-run tests/existence/R50/go/blocks/",
        "test:go:ordering": "deno test --allow-read --allow-write --allow-run tests/organization/R25/go/ordering/",
        "test:go:content": "deno test --allow-read --allow-write --allow-run tests/content/R10/go/content/",
        "test:go:concept": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/go/concept/ tests/pattern/R03/go/self-access/",
        "test:toml:blocks": "deno test --allow-read --allow-write --allow-run tests/existence/R50/toml/blocks/",
        "test:toml:content": "deno test --allow-read --allow-write --allow-run tests/content/R10/toml/content/",
        "test:toml:concept": "deno test --allow-read --allow-write --allow-run tests/pattern/R05/toml/concept/",

        // ── Test: specific ───────────────────────────────────────
        "test:errors": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net tests/existence/R50/data/errors_test.ts",

        // ── Witness coverage ────────────────────────────────────
        "witness": "deno run --allow-read scripts/witness.ts",
        "witness:verbose": "deno run --allow-read scripts/witness.ts --verbose",
        "witness:grid": "deno run --allow-read scripts/witness.ts --grid",
        "witness:full": "deno run --allow-read scripts/witness.ts --grid --verbose --files",

        // ── Live test runner (dashboard) ──────────────────────────
        "test:live": "deno run --allow-read --allow-run --allow-env scripts/test-live.ts",
        "test:live:verbose": "deno run --allow-read --allow-run --allow-env scripts/test-live.ts --verbose",
        "test:live:quiet": "deno run --allow-read --allow-run --allow-env scripts/test-live.ts --no-verse",

        // ── Test report (scorecard) ────────────────────────────
        "test:report": "deno run --allow-read --allow-run scripts/test-report.ts",
        "test:report:brief": "deno run --allow-read --allow-run scripts/test-report.ts --brief",
        "test:report:failures": "deno run --allow-read --allow-run scripts/test-report.ts --failures",

        // ── Dev workflow ─────────────────────────────────────────
        "dev": "deno check mod.ts && deno test --allow-read --allow-write --allow-run --allow-env --ignore=tests/tool/T00/data/database_test.ts --ignore=tests/content/R10/api/health_query_test.ts tests/",
        "ci": "deno check mod.ts && deno test --allow-read --allow-write --allow-run --allow-env --ignore=tests/tool/T00/data/database_test.ts --ignore=tests/content/R10/api/health_query_test.ts tests/",

        // ── Studio & Build ───────────────────────────────────────
        "studio": "deno run --allow-read --allow-write --allow-run --allow-net mod.ts studio",
        "compile": "deno compile --allow-read --allow-write --allow-run --allow-net --allow-env --include ../../b-word/L1-omnicode/ladder/schemas/ --output bin/cws-struct mod.ts"
    },

    "imports": {
        "@std/toml": "jsr:@std/toml@1",
        "@std/jsonc": "jsr:@std/jsonc@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "@std/fmt": "jsr:@std/fmt@1",
        "@std/async": "jsr:@std/async@1",
        "@db/sqlite": "jsr:@db/sqlite@0.12",
        "@lib/": "./lib/",
        "@test/": "./tests/"
    },

    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true
    },

    // ───────────────────────────────────────────────────────────
    // Ct — Content Tool Config [TOOL]
    // ───────────────────────────────────────────────────────────
    //
    // Config-driven values for cws-struct. Deno ignores _ prefixed keys.
    // Each value has a hardcoded default — partial or missing is safe.

    "_Ct": "─────────────────────────────────────────────────────────────",
    "_Ct_tag": "Ct — Content Tool Config [TOOL]",

    "_cwsStruct": {
        "concurrency": 8,
        "maxFiles": 10000,
        "maxFileSize": 1048576,
        "excludedDirs": [".git", "node_modules", ".cache", "__pycache__", "target", "bin"],
        "impactWeights": { "error": 2.0, "warn": 1.0, "info": 0.25 }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno check mod.ts && deno test --allow-read",
    "_Cv_expected_state": "All imports resolve, type checks pass, tests green",
    "_Cv_required_keys": ["name", "version", "tasks", "imports", "compilerOptions"],

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Remove 3-block structure from this config file",
        "Change import aliases without updating all source files",
        "Remove --allow-read from lint task (needs filesystem access)"
    ],
    "_X1_careful": [
        "Updating @std versions (may introduce breaking changes)",
        "Adding new tasks (keep naming consistent with subcommands)"
    ],
    "_X1_safe": [
        "Adding new @std imports as needed",
        "Adding new deno tasks for new subcommands",
        "Updating compiler options for stricter checks"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "mod.ts — CLI entrypoint",
        "lib/foundation/ — Types, health scoring, schema loader (what things ARE)",
        "lib/engine/ — Discovery, output, registry (what RUNS the system)",
        "lib/handlers/ — Format-specific lint and transform handlers (what each format MEANS)",
        "lib/verify/ — Environment verification commands",
        "c-tov/cwe-creator-tools/ — Original standalone linters (reference)"
    ],
    "_X4_validate": "deno check mod.ts",

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Deno config for the unified structuring tool. Consolidates 8 standalone linters into one expandable CLI. New formats register in lib/handlers/ — the tool grows by addition, not modification.",
    "_X5_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X5_anchor": "The tool that validates structure must itself be structured.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
