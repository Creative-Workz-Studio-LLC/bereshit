[Desktop Entry]
Type=Application
Name=CWS Studio
GenericName=Structural Intelligence Studio
Comment=Create, validate, and inspect OmniCode-aligned files — schema-driven linting and scaffolding
Exec=/home/seanje-lenox-wise/.local/bin/cws-studio
Icon=/home/seanje-lenox-wise/.local/share/icons/cws-studio.svg
Terminal=false
Categories=Development;
Keywords=CWS;Studio;Lint;Scaffold;OmniCode;cws-struct;CreativeWorkzStudio;
StartupNotify=true
StartupWMClass=com.creativeworkzstudio.cws-studio
MimeType=text/x-go;text/x-rust;application/toml;
Actions=server;stop;

[Desktop Action server]
Name=Start Server Only
Exec=/home/seanje-lenox-wise/.local/bin/cws-studio --server

[Desktop Action stop]
Name=Stop Running Instance
Exec=/home/seanje-lenox-wise/.local/bin/cws-studio --stop
