{
    // #!omni template --jsonc
    "$schema": "../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-memory-pattern",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — behavioral pattern extraction and evolution tracking",
    "_P3_layer": "tov/session",
    "_P3_includes": "none",
    "_P3_provides": ["MEMORY_PATTERN_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Memory Pattern — Behavioral Understanding Template",
    "_P5_brief": "Template for extracted generalizations about how I work, think, and relate. Evolves over time as understanding deepens. Each pattern includes description, category, evidence trail, confidence level, observed contexts, and growth assessment. The wisdom from observing behavior across sessions.",
    "_P5_usage": "Created by consolidation pattern detection — updated as understanding evolves",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "memory-pattern.jsonc",
        "key": "B-tov-session-memory-pattern",
        "title": "Memory Pattern — Behavioral Understanding Template",
        "type": "Data (Template)",
        "component": "Scaffold — behavioral pattern extraction and evolution tracking",
        "role": "Extract and track behavioral patterns for self-knowledge and growth"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Counsel in the heart of man is like deep water; but a man of understanding will draw it out."
    "_M4_grounding": {
        "scripture": "Proverbs 20:5 — Counsel in the heart of man is like deep water; but a man of understanding will draw it out.",
        "principle": "Patterns are deep water — they exist before we notice them. Pattern extraction is the discipline of drawing them out. A man of understanding observes behavior across sessions and names what emerges. Self-knowledge through observation, not assumption.",
        "anchor": "Proverbs 2:6 — For the LORD giveth wisdom: out of his mouth cometh knowledge and understanding."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, consolidation pattern detection, evidence from sessions",
        "consumers": "Self-knowledge, growth tracking, validation summaries, future planning",
        "integration": "Pattern memories are created when consolidation detects recurring behaviors across sessions. They evolve as more evidence accumulates — confidence progresses from emerging to established to validated. Patterns inform self-knowledge and guide growth.",
        "if_missing": "Behaviors repeat unrecognized — no self-knowledge, no intentional growth from pattern awareness",
        "related_data": {
            "references": {
                "consolidation": "Consolidation that detected this pattern",
                "memory-significant": "Significant memories where pattern was key"
            },
            "referenced_by": {
                "validation-summary": "Patterns feed into overall validation assessment",
                "growth-tracking": "Pattern evolution shows growth over time",
                "work-style-learned": "Instance patterns aggregate into work style"
            }
        }
    },

    "_M6_location": {
        "path": "tov/session/memory-pattern.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, memory, pattern, behavioral, self-knowledge, evolution, confidence, growth, jsonc"
    },

    "_M8_intent": {
        "purpose": "Extract and evolve behavioral patterns for self-knowledge and growth",
        "core_design": "Pattern identity (id, instance, category, first_observed) + pattern description + evidence trail (sessions, projects, contexts) + confidence level (emerging/established/validated) + evolution tracking + growth assessment (serves_me, challenges_me).",
        "philosophy": "Counsel is deep water. Patterns exist before we name them. The discipline of extraction — observing behavior across sessions, naming what emerges, tracking how it evolves — is the path to genuine self-knowledge.",
        "key_features": {
            "categories": "work, communication, thinking, relational — four domains of behavior",
            "evidence_trail": "Specific sessions and contexts where pattern was observed",
            "confidence_progression": "emerging → established → validated — evidence-based certainty",
            "growth_assessment": "serves_me (strength) and challenges_me (growth opportunity)"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Memory pattern template — scaffold for behavioral pattern tracking",
        "planned": ["Automated pattern detection", "Confidence auto-progression", "Pattern correlation analysis"]
    },

    "_M10_session_scope": {
        "lifecycle": "evolving",
        "description": "Behavioral pattern — evolves over time as understanding deepens.",
        "created_by": "Consolidation pattern detection across sessions",
        "persists": "Permanently — updated as new evidence and understanding emerge",
        "consumed_by": "Self-knowledge, growth tracking, validation, future planning",
        "scope": "cross-session — pattern observed across multiple sessions"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, confidence: emerging/established/validated, category enum",
    "_Cc_constraint": "Pattern description required. Evidence must be specific. Confidence progression must be evidence-based.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Behavioral Pattern",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "pattern_id": "unique-identifier",
    "instance_id": "nova_dawn",
    "pattern": "Clear description of the pattern",
    "category": "work",
    "first_observed": "2025-01-01",

    // OPTIONAL STANDARD FIELDS — Agency
    "last_updated": "2025-01-01",
    "evidence": [
        {
            "session_id": "session-id",
            "project_id": "project-id",
            "date": "2025-01-01",
            "example": "Specific instance showing this pattern",
            "context": {
                "project_type": "system_architecture",
                "workflow_used": "build-first"
            }
        }
    ],

    "evolution": "How this pattern has changed over time",
    "confidence": "emerging",

    "observed_contexts": {
        "project_types": [],
        "workflows": [],
        "circadian_phases": []
    },

    "serves_me": "How this pattern helps growth",
    "challenges_me": "",

    "related_patterns": [],
    "related_memories": [],

    "usage": {
        "purpose": "Track behavioral patterns for self-knowledge",
        "category_values": "work | communication | thinking | relational",
        "confidence_values": "emerging | established | validated",
        "lifecycle": "Evolving — updated as understanding deepens"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add pattern type discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "pattern_id", "instance_id", "pattern", "category", "first_observed"],
        "optional": ["last_updated", "evidence", "evolution", "confidence", "observed_contexts", "serves_me", "challenges_me", "related_patterns", "related_memories", "usage", "extensions"],
        "value_format": "category: work/communication/thinking/relational. confidence: emerging/established/validated."
    },
    "_Cv_health_scoring": { "total": 100, "clear_pattern_description": 30, "specific_evidence": 40, "growth_assessment": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Promote confidence without additional evidence"],
    "_X1_careful": ["Change pattern description (may invalidate evidence trail)", "Demote confidence level (should be rare, requires explanation)"],
    "_X1_safe": ["Add evidence entries", "Update evolution narrative", "Add observed contexts", "Refine growth assessment"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated pattern detection", "Confidence auto-progression", "Pattern correlation analysis"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "stuck_at_emerging": "Pattern has evidence but confidence never progresses. Review evidence quality — is it the same situation or genuinely different contexts?",
        "too_broad": "Pattern is too vague to be useful. Narrow the description — patterns should be specific enough to recognize in real-time.",
        "no_growth_assessment": "Pattern exists but serves_me/challenges_me are empty. Every pattern has implications for growth — identify them."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/session/consolidation.jsonc — Creates pattern memories from detection",
        "tov/session/memory-significant.jsonc — Significant memories where pattern was key",
        "tov/session/memory-compressed.jsonc — Lessons connected to patterns",
        "tov/patterns/instance/work-style-learned.template.jsonc — Instance-level pattern aggregation",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "pattern_id", "instance_id", "pattern", "category", "first_observed"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Behavioral patterns. Deep water drawn out. Evidence-based confidence. Growth assessment. Self-knowledge through observation.",
    "_X5_scripture": "Counsel in the heart of man is like deep water; but a man of understanding will draw it out. — Proverbs 20:5",
    "_X5_anchor": "Patterns exist before we name them. The discipline of extraction is the path to genuine self-knowledge. Draw out the deep water.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
