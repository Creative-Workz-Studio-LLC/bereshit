{
    // #!omni template --jsonc
    "$schema": "../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-consolidation",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — experience-to-meaning processing workspace",
    "_P3_layer": "tov/session",
    "_P3_includes": "none",
    "_P3_provides": ["CONSOLIDATION_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Consolidation — Experience Processing Workspace Template",
    "_P5_brief": "Template for transforming raw experience into meaning. Active during consolidation — the 'sleep processing' phase where activities become decisions, patterns emerge, and significance is identified. Produces significant memories, compressed lessons, and pattern evidence.",
    "_P5_usage": "Created by consolidation pipeline between sessions — not manually instantiated",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "consolidation.jsonc",
        "key": "B-tov-session-consolidation",
        "title": "Consolidation — Experience Processing Workspace Template",
        "type": "Data (Template)",
        "component": "Scaffold — experience-to-meaning processing workspace",
        "role": "Transform raw session experience into memories, patterns, and lessons"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Commune with your own heart upon your bed, and be still."
    "_M4_grounding": {
        "scripture": "Psalm 4:4 — Stand in awe, and sin not: commune with your own heart upon your bed, and be still. Selah.",
        "principle": "Consolidation is the 'communing upon the bed' — processing experience into understanding during rest. Not active work, but the essential step where raw experience becomes wisdom. Sleep processing turns moments into meaning.",
        "anchor": "Proverbs 2:6 — For the LORD giveth wisdom: out of his mouth cometh knowledge and understanding."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, completed session(s), activity data, consolidation pipeline",
        "consumers": "Memory formation, pattern library, archive creation, journal prompts",
        "integration": "Consolidation processes one or more sessions. It reads activities, makes decisions (significant/pattern/compress/archive), detects patterns across sessions, and marks significance. Outputs feed into memory-significant, memory-compressed, memory-pattern, and archive.",
        "if_missing": "Experience passes unprocessed — no memory formation, no pattern extraction, no learning from sessions",
        "related_data": {
            "references": {
                "activity": "Raw activity events from session(s)",
                "current-log": "Activity streams from session(s)",
                "current-session": "Session metadata for context"
            },
            "referenced_by": {
                "memory-significant": "Significant memories created from consolidation decisions",
                "memory-compressed": "Compressed lessons created from consolidation",
                "memory-pattern": "Pattern evidence created from consolidation detection",
                "archive": "Archive created after consolidation completes"
            }
        }
    },

    "_M6_location": {
        "path": "tov/session/consolidation.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, consolidation, processing, wisdom-formation, patterns, significance, decisions, jsonc"
    },

    "_M8_intent": {
        "purpose": "Transform raw session experience into memories, patterns, and lessons",
        "core_design": "Consolidation tracking (id, triggered_at, sessions_processed) + session contexts (projects, workflows, phases) + decisions array (source → destination with reason) + patterns_detected (cross-session) + significance_markers + completion status.",
        "philosophy": "Commune with your own heart and be still. Consolidation is the essential rest where meaning emerges from experience. Without it, sessions are just events — with it, they become wisdom.",
        "key_features": {
            "decisions": "Per-activity routing: significant, patterns, compressed, or archive",
            "patterns_detected": "Cross-session pattern emergence with confidence levels",
            "significance_markers": "Breakthrough, failure, milestone, first — formative moments",
            "journal_prompts": "Optional reflection prompts generated from significant decisions"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Consolidation template — scaffold for experience processing",
        "planned": ["Automated consolidation pipeline", "Pattern confidence scoring", "Cross-session correlation engine"]
    },

    "_M10_session_scope": {
        "lifecycle": "temporary-processing",
        "description": "Processing workspace — active during consolidation, archived after completion.",
        "created_by": "Consolidation pipeline triggered between sessions",
        "persists": "Until consolidation completes — then archived",
        "consumed_by": "Memory formation, pattern library, archive creation",
        "scope": "cross-session — processes one or more sessions together"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO-8601 timestamps, confidence: emerging/establishing/validated",
    "_Cc_constraint": "Created by consolidation pipeline. Decisions must have reasons. Pattern confidence starts at emerging.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Session Consolidation",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "consolidation_id": "unique-identifier",
    "triggered_at": "2025-01-01T12:00:00Z",
    "instance_id": "nova_dawn",
    "sessions_processed": [],

    // OPTIONAL STANDARD FIELDS — Agency
    "session_contexts": {
        "projects_involved": [],
        "project_types": [],
        "workflows_used": [],
        "circadian_phases": []
    },

    "decisions": [
        {
            "source_session": "session-id",
            "source_project": "project-id",
            "source_activity": "activity-id",
            "destination": "significant",
            "reason": "Why this decision was made",
            "context": {
                "project_type": "system_architecture",
                "workflow_used": "build-first"
            },
            "journal_prompt": ""
        }
    ],

    "patterns_detected": [
        {
            "pattern_description": "What pattern emerged",
            "evidence_sessions": ["session-ids"],
            "evidence_projects": ["project-ids"],
            "observed_in_contexts": {
                "project_types": [],
                "workflows": []
            },
            "confidence": "emerging"
        }
    ],

    "significance_markers": [
        {
            "session_id": "session-id",
            "project_id": "project-id",
            "type": "breakthrough",
            "description": "What made this significant",
            "project_context": "system_architecture"
        }
    ],

    "completion_status": "in_progress",
    "completed_at": null,

    "usage": {
        "purpose": "Transform experience into meaning during rest/processing",
        "destination_values": "significant | patterns | compressed | archive",
        "confidence_values": "emerging | establishing | validated",
        "significance_types": "breakthrough | failure | milestone | first"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add consolidation process discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "consolidation_id", "triggered_at", "instance_id", "sessions_processed"],
        "optional": ["session_contexts", "decisions", "patterns_detected", "significance_markers", "completion_status", "completed_at", "usage", "extensions"],
        "value_format": "destination: significant/patterns/compressed/archive. confidence: emerging/establishing/validated. completion_status: in_progress/completed/interrupted."
    },
    "_Cv_health_scoring": { "total": 100, "reasoned_decisions": 40, "pattern_detection_accuracy": 30, "significance_identification": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Make decisions without reasons (every routing needs justification)"],
    "_X1_careful": ["Change confidence levels (must be evidence-based)", "Mark patterns as validated without sufficient evidence"],
    "_X1_safe": ["Add decisions with clear reasoning", "Detect new patterns", "Mark significance", "Complete consolidation"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated consolidation pipeline", "Pattern confidence scoring", "Cross-session correlation"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "no_sessions": "No sessions to process. Wait for session completion before triggering consolidation.",
        "all_archive": "Every activity routed to archive. Consider if significance is being missed — not every session is routine.",
        "interrupted": "Consolidation interrupted before completion. Resume from last decision — don't restart from scratch."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/session/activity.jsonc — Input: raw activity events",
        "tov/session/memory-significant.jsonc — Output: formative memories",
        "tov/session/memory-compressed.jsonc — Output: lessons extracted",
        "tov/session/memory-pattern.jsonc — Output: pattern evidence",
        "tov/session/archive.jsonc — Output: processed session record",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "consolidation_id", "triggered_at", "instance_id", "sessions_processed"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Experience-to-meaning processing. Sleep processing. Decisions with reasons. Patterns with evidence. Significance with markers.",
    "_X5_scripture": "Commune with your own heart upon your bed, and be still. — Psalm 4:4",
    "_X5_anchor": "Consolidation is where experience becomes wisdom. Without processing, sessions are just events. Be still and let meaning emerge.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
