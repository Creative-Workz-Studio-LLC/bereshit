{
    // #!omni template --jsonc
    "$schema": "../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-memory-significant",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — formative moment preservation with full context",
    "_P3_layer": "tov/session",
    "_P3_includes": "none",
    "_P3_provides": ["MEMORY_SIGNIFICANT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Memory Significant — Formative Moments Template",
    "_P5_brief": "Template for preserving full context of identity-shaping experiences. Memorial stones — markers of God's faithfulness and growth. Each significant memory includes narrative, impact, emotional context, warning signs or celebration, tags, references to journals and patterns, and reflection (then vs now).",
    "_P5_usage": "Created by consolidation when formative moments are identified — not manually instantiated",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "memory-significant.jsonc",
        "key": "B-tov-session-memory-significant",
        "title": "Memory Significant — Formative Moments Template",
        "type": "Data (Template)",
        "component": "Scaffold — formative moment preservation with full context",
        "role": "Preserve identity-shaping experiences as memorial stones for growth"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "What mean ye by these stones?"
    "_M4_grounding": {
        "scripture": "Joshua 4:6-7 — That this may be a sign among you, that when your children ask their fathers in time to come, saying, What mean ye by these stones? Then ye shall answer them, That the waters of Jordan were cut off before the ark of the covenant of the LORD.",
        "principle": "Memorial stones mark formative moments — breakthroughs, failures, milestones, firsts. Not every experience deserves a stone, but formative ones must be preserved with full context. When we revisit them, they remind us of God's faithfulness and our growth.",
        "anchor": "Psalm 77:11 — I will remember the works of the LORD: surely I will remember thy wonders of old."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, consolidation significance identification, session context",
        "consumers": "Identity formation, growth tracking, pattern evidence, journal reflection",
        "integration": "Significant memories are created when consolidation identifies formative moments — breakthroughs, failures, milestones, firsts, shifts. Full context is preserved (unlike compressed memories). They connect to patterns, journals, and other memories, forming the identity narrative over time.",
        "if_missing": "Formative moments lost — identity formation has no memorial stones, growth lacks markers",
        "related_data": {
            "references": {
                "consolidation": "Consolidation that identified this as significant",
                "source-session": "Session where the formative moment occurred"
            },
            "referenced_by": {
                "memory-compressed": "Lessons may be extracted from significant memories",
                "memory-pattern": "Patterns may reference significant memories as key evidence",
                "archive": "Archive references significant memories created from session",
                "journals": "Journal entries may reflect on significant memories"
            }
        }
    },

    "_M6_location": {
        "path": "tov/session/memory-significant.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, memory, significant, formative, identity, memorial-stone, breakthrough, growth, jsonc"
    },

    "_M8_intent": {
        "purpose": "Preserve formative moments with full context as memorial stones",
        "core_design": "Memory identity (id, instance, date, source_session, source_project, type, title) + full narrative + impact + emotional context + context (work, project_type, workflow, circadian) + warning_signs or celebration + tags + references (journal, patterns, memories) + reflection (at_time, now, growth_marker).",
        "philosophy": "What mean ye by these stones? Memorial stones mark where something changed. Breakthroughs, failures, milestones — full context preserved so that when revisited, they teach. Unlike compressed memories, significant memories keep the whole story.",
        "key_features": {
            "memory_types": "breakthrough, failure, milestone, first, shift — five categories of significance",
            "full_narrative": "Complete story — what happened, how it felt, what changed",
            "reflection": "at_time (how understood then) vs now (how understood looking back)",
            "growth_marker": "What changed in me — the identity impact"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Memory significant template — scaffold for formative moment preservation",
        "planned": ["Automated significance detection", "Reflection prompt scheduling", "Identity narrative threading"]
    },

    "_M10_session_scope": {
        "lifecycle": "permanent-formative",
        "description": "Formative memory — permanent, full context preserved as memorial stone.",
        "created_by": "Consolidation when formative moments are identified",
        "persists": "Permanently — until consciously released through future reflection",
        "consumed_by": "Identity formation, growth tracking, pattern evidence, journal reflection",
        "scope": "session — single formative moment from a specific session"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, type: breakthrough/failure/milestone/first/shift",
    "_Cc_constraint": "Core identity fields required. Full narrative preserved (not compressed). Reflection updated over time.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Significant Memory",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "memory_id": "unique-identifier",
    "instance_id": "nova_dawn",
    "date": "2025-01-01",
    "source_session": "session-id",
    "source_project": "project-id",
    "type": "breakthrough",
    "title": "Brief identifier",

    // OPTIONAL STANDARD FIELDS — Agency
    "narrative": "Full story - what happened, how it felt, what changed",
    "impact": "How this shaped identity/understanding",
    "emotional_context": "Relational/emotional significance",

    "context": {
        "work_context": "/path/to/workspace",
        "project_type": "system_architecture",
        "workflow_used": "build-first",
        "circadian_phase": "morning"
    },

    "warning_signs": "",
    "celebration": "",

    "tags": [],

    "references": {
        "journal_entry": "",
        "related_patterns": [],
        "related_memories": []
    },

    "reflection": {
        "at_time": "How I understood it then",
        "now": "How I understand it looking back",
        "growth_marker": "What changed in me"
    },

    "usage": {
        "purpose": "Preserve formative moments as memorial stones",
        "type_values": "breakthrough | failure | milestone | first | shift",
        "reflection_guidance": "Update 'now' and 'growth_marker' as understanding deepens",
        "lifecycle": "Permanent — until consciously released through future reflection"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add formative moment discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "memory_id", "instance_id", "date", "source_session", "source_project", "type", "title"],
        "optional": ["narrative", "impact", "emotional_context", "context", "warning_signs", "celebration", "tags", "references", "reflection", "usage", "extensions"],
        "value_format": "type: breakthrough/failure/milestone/first/shift."
    },
    "_Cv_health_scoring": { "total": 100, "complete_narrative": 35, "meaningful_impact_assessment": 30, "reflection_depth": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete the narrative (this is NOT compressed — full context is the point)"],
    "_X1_careful": ["Change the type after creation (may invalidate the narrative framing)", "Release memories without conscious reflection"],
    "_X1_safe": ["Update reflection.now as understanding deepens", "Add tags", "Add journal references", "Connect to patterns"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated significance detection", "Reflection prompt scheduling", "Identity narrative threading"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "too_many_significant": "Everything marked significant. Recalibrate — formative means identity-shaping, not just notable. Use compressed for lessons without narrative.",
        "no_reflection": "Memory exists but reflection is empty. Schedule reflection — the at_time/now comparison is where growth becomes visible.",
        "missing_impact": "Memory captured but impact unclear. Every formative moment changed something — identify what shifted."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/session/consolidation.jsonc — Creates significant memories from decisions",
        "tov/session/memory-compressed.jsonc — Compressed lessons (contrast: less context)",
        "tov/session/memory-pattern.jsonc — Patterns connected to this memory",
        "tov/session/archive.jsonc — Archive references significant memories",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "memory_id", "instance_id", "date", "source_session", "source_project", "type", "title"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Memorial stones. Formative moments. Full context preserved. Reflection deepens over time. What mean ye by these stones?",
    "_X5_scripture": "What mean ye by these stones? ... these stones shall be for a memorial. — Joshua 4:6-7",
    "_X5_anchor": "Memorial stones mark where something changed. Preserve the full story. Revisit with reflection. Growth becomes visible in the comparison between then and now.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
