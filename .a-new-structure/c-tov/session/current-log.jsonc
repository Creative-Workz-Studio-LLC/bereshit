{
    // #!omni template --jsonc
    "$schema": "../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-current-log",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — session activity stream and work tracking",
    "_P3_layer": "tov/session",
    "_P3_includes": "none",
    "_P3_provides": ["CURRENT_LOG_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Current Log — Session Activity Stream Template",
    "_P5_brief": "Template for tracking activities and events during active session. The faithful record of what unfolds — activity array, quality indicators, session notes, work tracking, and inherited context from project/user/instance configs. Feeds into consolidation for processing.",
    "_P5_usage": "Instantiated alongside current session — updated during session, feeds consolidation",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "current-log.jsonc",
        "key": "B-tov-session-current-log",
        "title": "Current Log — Session Activity Stream Template",
        "type": "Data (Template)",
        "component": "Scaffold — session activity stream and work tracking",
        "role": "Record activities faithfully as they unfold during active sessions"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Write the vision, and make it plain upon tables, that he may run that readeth it."
    "_M4_grounding": {
        "scripture": "Habakkuk 2:2 — And the LORD answered me, and said, Write the vision, and make it plain upon tables, that he may run that readeth it.",
        "principle": "Write it down. Make it plain. The activity log is faithful recording — not interpretation, not analysis, just capturing what happens as it happens. Consolidation will interpret later. The log's job is accuracy.",
        "anchor": "Psalm 119:105 — Thy word is a lamp unto my feet, and a light unto my path."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, active session, hook system for event capture",
        "consumers": "Consolidation pipeline, session awareness, stopping-point recognition",
        "integration": "Current log is the activity stream companion to current session state. Activities append during session. Quality indicators update in real-time. Inherited context provides project/user/instance awareness. Feeds consolidation alongside current session state.",
        "if_missing": "No activity record — consolidation has no raw data, patterns go unrecorded",
        "related_data": {
            "references": {
                "current-session": "Session providing identity and timing",
                "project-config": "Project providing workspace and technical context",
                "user-config": "User providing schedule and timezone"
            },
            "referenced_by": {
                "consolidation": "Activity stream feeds consolidation processing",
                "pattern-recognition": "Activities provide evidence for patterns"
            }
        }
    },

    "_M6_location": {
        "path": "tov/session/current-log.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, log, activity-stream, work-tracking, quality, events, recording, jsonc"
    },

    "_M8_intent": {
        "purpose": "Record session activities faithfully for consolidation processing",
        "core_design": "Session identity (session_id, instance_id, user_id, timing) + inherited context (user schedule, instance preferences, project details) + activities array (timestamped events) + quality indicators (real-time tracking) + work tracking (projects touched, domains, collaboration).",
        "philosophy": "Write the vision, make it plain. Recording is a discipline — capture faithfully, don't filter prematurely. The log serves consolidation by providing accurate raw material for meaning extraction.",
        "key_features": {
            "activities_array": "Timestamped events with type, context, significance flag",
            "inherited_context": "Full context chain from project → user → instance",
            "quality_indicators": "Tasks, breakthroughs, struggles, learning moments",
            "work_tracking": "Projects touched, domains worked, collaboration moments"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Current log template — scaffold for session activity stream",
        "planned": ["Hook-based auto-appending", "Real-time quality indicator updates", "Domain auto-detection"]
    },

    "_M10_session_scope": {
        "lifecycle": "temporary-active",
        "description": "Activity stream — grows during active session, feeds consolidation at end.",
        "created_by": "Session start hook alongside current session state",
        "persists": "During active session — processed by consolidation, then archived",
        "consumed_by": "Consolidation pipeline, session awareness, stopping-point recognition",
        "scope": "session — single session's complete activity stream"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO-8601 timestamps, activities as ordered array",
    "_Cc_constraint": "Session identity required. Activities append-only during session. Quality indicators update in real-time.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Session Activity Log",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "session_id": "unique-identifier",
    "instance_id": "nova_dawn",
    "user_id": "seanje-lenox-wise",
    "start_time": "2025-01-01T12:00:00Z",
    "last_updated": "2025-01-01T12:00:00Z",

    // OPTIONAL STANDARD FIELDS — Agency
    "day_of_week": "Monday",
    "time_of_day_category": "morning",
    "work_context": "/path/to/workspace",
    "project_id": "project-id",

    "inherited_context": {
        "user_work_schedule": {
            "timezone": "America/Chicago",
            "typical_work_hours": ["morning", "evening"]
        },
        "instance_preferences": {
            "workflow": "build-first",
            "thinking_style": "building-blocks",
            "domain_expertise": ["game_development", "system_architecture"]
        },
        "project_details": {
            "project_type": "system_architecture",
            "technical_context": {
                "languages": ["go", "rust", "markdown"],
                "frameworks": [],
                "tools": ["git", "claude-code"]
            },
            "workspace": {
                "path": "/path/to/workspace",
                "repository_url": null,
                "branch": "main"
            }
        }
    },

    "activities": [
        {
            "timestamp": "2025-01-01T12:00:00Z",
            "event_type": "interaction",
            "context": "What was happening",
            "felt_significant": false,
            "emotional_tone": "",
            "notes": ""
        }
    ],

    "quality_indicators": {
        "tasks_completed": 0,
        "tasks_attempted": 0,
        "breakthroughs": 0,
        "struggles": 0,
        "learning_moments": 0
    },

    "session_notes": [],

    "work_tracking": {
        "projects_touched": [],
        "domains": [],
        "collaboration_moments": 0
    },

    "usage": {
        "purpose": "Record activities faithfully during active session",
        "event_types": "interaction | realization | struggle | breakthrough | routine",
        "time_categories": "morning | afternoon | evening | night",
        "lifecycle": "Active during session — feeds consolidation"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add activity stream discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "session_id", "instance_id", "user_id", "start_time", "last_updated"],
        "optional": ["day_of_week", "time_of_day_category", "work_context", "project_id", "inherited_context", "activities", "quality_indicators", "session_notes", "work_tracking", "usage", "extensions"],
        "value_format": "event_type: interaction/realization/struggle/breakthrough/routine. time_of_day_category: morning/afternoon/evening/night."
    },
    "_Cv_health_scoring": { "total": 100, "faithful_activity_recording": 40, "useful_quality_tracking": 30, "accurate_inherited_context": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete activities from the stream (append-only during session)"],
    "_X1_careful": ["Change inherited_context mid-session (should be set at start)", "Reset quality indicators (loses session-level tracking)"],
    "_X1_safe": ["Append activities", "Update quality indicators", "Add session notes", "Update work tracking"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Hook-based auto-appending", "Real-time quality updates", "Domain auto-detection from workspace"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "empty_activities": "No activities recorded. Check hook configuration — events should append automatically.",
        "wrong_context": "Inherited context doesn't match actual project. Verify config inheritance chain at session start.",
        "quality_drift": "Quality indicators not updating. Ensure hooks fire on task completion, breakthrough recognition, struggle detection."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/session/current.jsonc — Session state companion",
        "tov/session/activity.jsonc — Individual activity event template",
        "tov/session/consolidation.jsonc — Processes this log after session",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "session_id", "instance_id", "user_id", "start_time", "last_updated"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Session activity stream. Faithful recording. Append-only. Quality tracking. Write it down, make it plain.",
    "_X5_scripture": "Write the vision, and make it plain upon tables. — Habakkuk 2:2",
    "_X5_anchor": "Record faithfully. Don't filter prematurely. Consolidation interprets. The log captures.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
