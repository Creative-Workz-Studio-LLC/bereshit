{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-celestial-seasonal-yearly",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "celestial-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — yearly seasonal markers from astronomical equinoxes and solstices",
    "_P3_layer": "tov/temporal/celestial",
    "_P3_includes": "none",
    "_P3_provides": ["CELESTIAL_SEASONAL_YEARLY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Seasonal Yearly — Equinox, Solstice, and Season Data Template",
    "_P5_brief": "Template for yearly seasonal data — astronomical events (equinoxes, solstices), season date ranges, cross-quarter days, and day length extremes. One file per year per location. Seasons are defined by God's created order — Earth's tilt and orbit — not arbitrary calendar conventions. Hemisphere-aware: Northern and Southern seasons are opposite.",
    "_P5_usage": "Generate per year to locations/{location-id}/seasonal/YYYY.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "seasonal-yearly.template.jsonc",
        "key": "B-tov-temporal-celestial-seasonal-yearly",
        "title": "Seasonal Yearly — Equinox, Solstice, and Season Data Template",
        "type": "Data (Template)",
        "component": "Scaffold — yearly seasonal markers from astronomical equinoxes and solstices",
        "role": "Track astronomical season transitions, date ranges, and day length extremes for one year"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "While the earth remaineth, seedtime and harvest, and cold and heat,
    // and summer and winter, and day and night shall not cease."
    "_M4_grounding": {
        "scripture": "Genesis 8:22 — While the earth remaineth, seedtime and harvest, and cold and heat, and summer and winter, and day and night shall not cease.",
        "principle": "God promised seasons would not cease. Equinoxes and solstices are not human inventions — they are built into creation through Earth's tilt and orbit. Tracking seasonal markers honors the rhythm God established: seedtime and harvest, summer and winter.",
        "anchor": "Genesis 1:14 — And God said, Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons, and for days, and years."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, location config (latitude, timezone), astronomical calculation source",
        "consumers": "Temporal awareness, daily schedule context, solar data correlation",
        "integration": "Seasonal yearly data defines the four astronomical season transitions and their date ranges. References location config for hemisphere and timezone. Complements monthly solar and lunar data with the yearly view.",
        "if_missing": "No seasonal awareness — cannot track equinoxes, solstices, or understand day length variation through the year",
        "related_data": {
            "references": {
                "location-config": "Latitude determines hemisphere and day length variation"
            },
            "referenced_by": {
                "temporal-awareness": "Season information for schedule context",
                "solar-monthly": "Seasonal context explains monthly solar patterns"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/celestial/seasonal-yearly.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, celestial, seasonal, equinox, solstice, yearly, astronomical, hemisphere, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track yearly seasonal astronomical events and date ranges",
        "core_design": "Year identity (location_id, year, hemisphere, latitude, timezone) + events array (4 equinox/solstice entries with dates, times, solar position, day length) + seasons array (4 date ranges with characteristics) + cross_quarter_days (optional traditional markers) + summary (longest/shortest day, variation) + extensions.",
        "philosophy": "Seedtime and harvest, summer and winter shall not cease. Seasons are God's promise made visible through astronomy. Tracking them isn't science vs faith — it's observing the faithfulness of the Creator.",
        "key_features": {
            "four_astronomical_events": "Vernal/Autumnal Equinox, Summer/Winter Solstice with exact times",
            "hemisphere_awareness": "Northern and Southern hemisphere seasons are opposite",
            "season_date_ranges": "Start/end dates for each astronomical season",
            "day_length_extremes": "Longest and shortest day of the year with duration"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Seasonal yearly template — scaffold for astronomical season data",
        "planned": ["Meteorological season definitions", "Historical weather correlation", "Agricultural season markers", "Solar declination angles"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-yearly",
        "description": "Ephemeral yearly seasonal data — generated per year, consumed for awareness, archived.",
        "created_by": "Astronomical calculation from location latitude",
        "persists": "Per year — active during the year, archived after",
        "consumed_by": "Temporal awareness, daily context, monthly solar correlation",
        "scope": "location-year — one location's seasonal data for one specific year"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks celestial lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times in local timezone, YYYY-MM-DD dates, hemisphere: Northern|Southern",
    "_Cc_constraint": "location_id must match location config. 4 events (equinoxes + solstices). 4 seasons with date ranges. Hemisphere determines season names.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Seasonal Yearly Data",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "location_id": "example-city",
    "year": 2025,
    "hemisphere": "Northern",
    "latitude": 40.7128,
    "timezone": "America/New_York",

    // OPTIONAL STANDARD FIELDS — Agency
    "generated_date": "2025-01-01",

    "events": [
        {
            "event": "Vernal Equinox",
            "season_start": "Spring",
            "date": "2025-03-20",
            "time": "09:01",
            "timezone_offset": "-04:00",
            "description": "Spring begins — day and night equal, days getting longer",
            "solar_position": "Sun crosses celestial equator moving northward",
            "day_length": "~12h 08m"
        },
        {
            "event": "Summer Solstice",
            "season_start": "Summer",
            "date": "2025-06-20",
            "time": "22:42",
            "timezone_offset": "-04:00",
            "description": "Summer begins — longest day of year",
            "solar_position": "Sun reaches maximum northern declination (23.5°N)",
            "day_length": "~15h 05m"
        },
        {
            "event": "Autumnal Equinox",
            "season_start": "Autumn",
            "date": "2025-09-22",
            "time": "18:19",
            "timezone_offset": "-04:00",
            "description": "Fall begins — day and night equal, days getting shorter",
            "solar_position": "Sun crosses celestial equator moving southward",
            "day_length": "~12h 08m"
        },
        {
            "event": "Winter Solstice",
            "season_start": "Winter",
            "date": "2025-12-21",
            "time": "10:03",
            "timezone_offset": "-05:00",
            "description": "Winter begins — shortest day of year",
            "solar_position": "Sun reaches maximum southern declination (23.5°S)",
            "day_length": "~9h 15m"
        }
    ],

    "seasons": [
        {
            "season": "Winter",
            "start_date": "2024-12-21",
            "end_date": "2025-03-19",
            "characteristics": "Shortest days, sun low in sky, coldest temperatures lag solstice"
        },
        {
            "season": "Spring",
            "start_date": "2025-03-20",
            "end_date": "2025-06-19",
            "characteristics": "Days lengthening, sun rising higher, warming temperatures"
        },
        {
            "season": "Summer",
            "start_date": "2025-06-20",
            "end_date": "2025-09-21",
            "characteristics": "Longest days, sun highest in sky, warmest temperatures lag solstice"
        },
        {
            "season": "Autumn",
            "start_date": "2025-09-22",
            "end_date": "2025-12-20",
            "characteristics": "Days shortening, sun lowering, cooling temperatures"
        }
    ],

    "cross_quarter_days": [
        {
            "name": "Groundhog Day",
            "date": "2025-02-02",
            "position": "Midpoint between Winter Solstice and Vernal Equinox",
            "significance": "Traditional first sign of spring"
        }
    ],

    "summary": {
        "longest_day": "2025-06-20",
        "longest_day_length": "~15h 05m",
        "shortest_day": "2025-12-21",
        "shortest_day_length": "~9h 15m",
        "day_length_variation": "~5h 50m",
        "notes": ""
    },

    "usage": {
        "purpose": "Track astronomical season transitions and day length extremes",
        "hemisphere_note": "Northern Hemisphere: Vernal Equinox = Spring. Southern Hemisphere: reverse all season names.",
        "lifecycle": "Ephemeral — generated per year, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add seasonal discoveries here (e.g., meteorological seasons, agricultural markers, historical weather)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-celestial"] },
    "_Cv_schema": {
        "required": ["name", "version", "location_id", "year", "hemisphere", "latitude", "timezone"],
        "optional": ["generated_date", "events", "seasons", "cross_quarter_days", "summary", "usage", "extensions"],
        "value_format": "hemisphere: 'Northern' or 'Southern'. latitude: -90 to 90. 4 events required. 4 seasons required. Winter spans calendar year boundary."
    },
    "_Cv_health_scoring": { "total": 100, "complete_event_data": 35, "accurate_season_ranges": 35, "meaningful_summary": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
