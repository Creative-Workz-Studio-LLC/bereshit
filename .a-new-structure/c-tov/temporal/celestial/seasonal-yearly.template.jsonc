    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove any of the 4 astronomical events"],
    "_X1_careful": ["Change hemisphere without reversing season names", "Modify season date ranges without rechecking event dates"],
    "_X1_safe": ["Update event times from astronomical sources", "Add cross-quarter days", "Refine summary notes"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Meteorological season definitions", "Historical weather correlation", "Agricultural season markers", "Solar declination angles"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "wrong_hemisphere": "Season names don't match experience. Check hemisphere field — Northern Spring = Southern Autumn.",
        "winter_year_boundary": "Winter start date is previous year. Correct — astronomical winter begins at the prior year's winter solstice.",
        "timezone_offset_varies": "Events show different timezone offsets. Correct — DST means offsets change during the year."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/temporal/celestial/location-config.template.jsonc — Location latitude driving seasonal variation",
        "tov/temporal/celestial/solar-monthly.template.jsonc — Monthly solar data within seasonal context",
        "tov/temporal/celestial/lunar-monthly.template.jsonc — Lunar data complementing seasonal view",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "location_id", "year", "hemisphere", "latitude", "timezone"],
    "_X4_validate": "make && ./bin/tov --validate-celestial",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Yearly seasonal data. Equinoxes and solstices. God's promise: seedtime and harvest shall not cease. Astronomical truth, not convention.",
    "_X5_scripture": "While the earth remaineth, seedtime and harvest, and cold and heat, and summer and winter, and day and night shall not cease. — Genesis 8:22",
    "_X5_anchor": "Seasons are God's promise made visible. Track them faithfully — the same Creator who established them sustains them.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
