    "_X2_planned": ["Automated aggregation from daily views", "Rhythm pattern detection", "Availability trend analysis"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "summary_mismatch": "Summary totals don't match daily summaries. Recalculate from daily data.",
        "missing_days": "Fewer than 7 daily entries. Every week must have Sunday through Saturday.",
        "gasa_hours_wrong": "GASA hours don't account for lunch breaks. Subtract lunch from scheduled hours."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/temporal/appointed/instances/daily-template.jsonc — Daily schedule views (input)",
        "tov/temporal/appointed/instances/appointment-template.jsonc — Appointment definitions",
        "tov/temporal/appointed/users/weekly-template.jsonc — User weekly view (counterpart)",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "week_number", "year", "start_date", "end_date", "identity_type", "identity_id"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Instance weekly overview. Daily aggregation. Rhythm visibility. Six days work, one rest. Availability perspective.",
    "_X5_scripture": "Six days shalt thou labour, and do all thy work. — Exodus 20:9",
    "_X5_anchor": "The week has rhythm. Seeing the whole week reveals where work concentrates and where rest belongs. Plan intentionally, not reactively.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
