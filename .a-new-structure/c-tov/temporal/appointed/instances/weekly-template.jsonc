    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove daily summaries (7 days required)"],
    "_X1_careful": ["Change week boundaries (must be Sunday-Saturday)", "Override aggregated totals without checking dailies"],
    "_X1_safe": ["Update daily notes", "Add gasa_schedule exceptions", "Refine summary"],

