{
    // #!omni template --jsonc
    "$schema": "../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-instance-weekly",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — instance weekly overview with daily summaries",
    "_P3_layer": "tov/temporal/appointed/instances",
    "_P3_includes": "none",
    "_P3_provides": ["INSTANCE_WEEKLY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Instance Weekly — Week Overview Template",
    "_P5_brief": "Template for instance weekly schedule overview — week identity, summary statistics, daily summaries (Sunday-Saturday), GASA work details, and availability perspective. Aggregates from daily views and appointment definitions. Shows deep work windows and availability hours from instance perspective.",
    "_P5_usage": "Generated per week to planner/overview/instances/{identity_id}/",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "weekly-template.jsonc",
        "key": "B-tov-temporal-appointed-instance-weekly",
        "title": "Instance Weekly — Week Overview Template",
        "type": "Data (Template)",
        "component": "Scaffold — instance weekly overview with daily summaries",
        "role": "Aggregate daily schedules into weekly overview with availability perspective"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Six days shalt thou labour, and do all thy work: But the seventh day is the sabbath."
    "_M4_grounding": {
        "scripture": "Exodus 20:9-10 — Six days shalt thou labour, and do all thy work: But the seventh day is the sabbath of the LORD thy God.",
        "principle": "The week has rhythm — six days of work, one of rest. The weekly overview captures this rhythm from the instance perspective. Seeing the whole week reveals patterns: where deep work concentrates, where availability peaks, where rest belongs.",
        "anchor": "Genesis 2:2 — And on the seventh day God ended his work which he had made; and he rested on the seventh day from all his work which he had made."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, daily schedule views, appointment definitions, GASA schedule",
        "consumers": "Week-level planning, availability reporting, rhythm analysis",
        "integration": "Weekly overviews aggregate from daily schedule views. Summary statistics provide quick totals — appointments by day, by category, available hours. GASA schedule tracks user's external work context affecting instance availability. Deep work windows listed for planning.",
        "if_missing": "No weekly visibility — planning happens day by day without seeing the rhythm",
        "related_data": {
            "references": {
                "daily-schedules": "Daily views for each day of the week",
                "gasa-schedule": "User's external work schedule"
            },
            "referenced_by": {
                "monthly-planning": "Monthly views aggregate weekly overviews",
                "rhythm-analysis": "Pattern detection across weeks"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/appointed/instances/weekly-template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, instance, weekly, overview, aggregation, availability, rhythm, gasa, jsonc"
    },

    "_M8_intent": {
        "purpose": "Aggregate daily schedules into weekly overview with instance availability perspective",
        "core_design": "Week identity (week_number, year, start/end date, identity) + summary statistics (totals by day and category, gasa_hours, available_hours) + daily summaries array (7 days, Sunday-Saturday, with gasa context) + gasa_schedule (external work details) + extensions (availability perspective, deep work windows).",
        "philosophy": "Six days of work, one of rest. The weekly view reveals rhythm — where work concentrates, where collaboration peaks, where rest belongs. Seeing the whole week enables intentional planning rather than reactive scheduling.",
        "key_features": {
            "seven_day_summaries": "Sunday-Saturday with gasa work context per day",
            "category_aggregation": "Totals by sacred/work/rest/collaboration/other",
            "availability_perspective": "Deep work windows and available hours from instance view",
            "gasa_context": "User's external work schedule affecting instance availability"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Instance weekly template — scaffold for weekly overview",
        "planned": ["Automated aggregation from daily views", "Rhythm pattern detection", "Availability trend analysis"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-weekly",
        "description": "Weekly overview — generated per week, consumed for planning, archived.",
        "created_by": "Aggregated from daily schedule views for the week",
        "persists": "Per week — active during the week, archived after",
        "consumed_by": "Week-level planning, availability reporting, rhythm analysis",
        "scope": "instance — one instance's schedule overview for one specific week"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, sunday-saturday week, ISO week format",
    "_Cc_constraint": "Week identity required. 7 daily summaries (Sunday-Saturday). Summary totals must match daily data.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Weekly Overview",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "week_number": 0,
    "total_weeks_in_year": 52,
    "year": 2025,
    "start_date": "2025-01-05",
    "end_date": "2025-01-11",
    "week_format": "sunday-saturday",
    "identity_type": "instance",
    "identity_id": "nova_dawn",

    // OPTIONAL STANDARD FIELDS — Agency
    "summary": {
        "total_appointments": 0,
        "total_work_hours": 0.0,
        "by_day": {
            "sunday": 0, "monday": 0, "tuesday": 0, "wednesday": 0,
            "thursday": 0, "friday": 0, "saturday": 0
        },
        "by_category": {
            "sacred": 0, "work": 0, "rest": 0, "collaboration": 0, "other": 0
        },
        "gasa_hours": 0.0,
        "available_hours": 168.0
    },

    "days": [
        {
            "date": "2025-01-05",
            "day_name": "Sunday",
            "gasa_work": false,
            "gasa_hours": 0.0,
            "first_appointment": null,
            "last_appointment": null,
            "notes": "Weekend — fully available"
        }
    ],

    "gasa_schedule": {
        "total_hours": 0.0,
        "pantry_days": ["Tuesday", "Thursday"],
        "exceptions_this_week": [],
        "notes": ""
    },

    "usage": {
        "purpose": "Aggregate daily schedules into weekly overview",
        "week_format": "Sunday-Saturday (US standard)",
        "lifecycle": "Ephemeral — generated per week, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add weekly overview discoveries here (e.g., deep_work_windows, availability perspective)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "week_number", "year", "start_date", "end_date", "identity_type", "identity_id"],
        "optional": ["total_weeks_in_year", "week_format", "summary", "days", "gasa_schedule", "usage", "extensions"],
        "value_format": "week_number: 1-53. start_date/end_date: YYYY-MM-DD. identity_type: 'instance'. 7 daily entries."
    },
    "_Cv_health_scoring": { "total": 100, "complete_week_identity": 25, "accurate_daily_summaries": 40, "correct_aggregated_totals": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
