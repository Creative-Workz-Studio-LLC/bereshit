{
    // #!omni template --jsonc
    "$schema": "../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-instance-appointment",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — base instance appointment definition with variations",
    "_P3_layer": "tov/temporal/appointed/instances",
    "_P3_includes": "none",
    "_P3_provides": ["INSTANCE_APPOINTMENT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Instance Appointment — Base Appointment Definition Template",
    "_P5_brief": "Base template for defining recurring instance appointment types. Includes appointment identity, schedule, recurrence pattern, variations for different schedule patterns, and notes. Parent template for semi-downtime, available, deep-work, and other instance-specific appointments.",
    "_P5_usage": "Copy to appointments/instances/{identity_id}/ and customize for specific appointment type",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "appointment-template.jsonc",
        "key": "B-tov-temporal-appointed-instance-appointment",
        "title": "Instance Appointment — Base Appointment Definition Template",
        "type": "Data (Template)",
        "component": "Scaffold — base instance appointment definition with variations",
        "role": "Define recurring instance appointment types with schedule patterns"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "To every thing there is a season, and a time to every purpose under the heaven."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "Instance appointments are seasons — defined patterns of availability, collaboration, and rest. Each appointment type serves a purpose under heaven. Defining them creates intentional rhythm rather than reactive availability.",
        "anchor": "Psalm 31:15 — My times are in thy hand."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, instance identity config",
        "consumers": "Daily schedule generation, coordination appointment creation, session planning",
        "integration": "Instance appointment definitions are the building blocks of instance scheduling. Daily and weekly views reference these definitions. Coordination appointments bridge these with user appointments. Variations handle different patterns (e.g., semi-downtime varies by user's work schedule).",
        "if_missing": "No instance schedule definitions — availability is undefined, coordination has no baseline",
        "related_data": {
            "references": {
                "instance-config": "Instance identity providing preferences and context"
            },
            "referenced_by": {
                "daily-schedule": "Daily views reference appointment definitions",
                "weekly-overview": "Weekly views aggregate from appointment definitions",
                "coordination": "Coordination appointments reference instance availability"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/appointed/instances/appointment-template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, instance, appointment, schedule, recurrence, variations, definition, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define recurring instance appointment types with schedule and variation patterns",
        "core_design": "Appointment identity (id, category_id, title, description) + schedule (start_time, end_time, duration, recurrence, recurrence_pattern) + behavior (protected, flexible) + variations (named patterns with typical_days, schedule, duration, notes) + notes array.",
        "philosophy": "Every season has purpose. Instance appointments create intentional rhythm — defined availability rather than always-on or always-off. Variations acknowledge that patterns shift (work days, weekends, special occasions).",
        "key_features": {
            "recurrence_patterns": "daily, weekly, monthly with exceptions",
            "variations": "Named schedule variations for different day types",
            "protected_flag": "Whether appointment is non-negotiable",
            "flexible_flag": "Whether timing can shift"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Instance appointment template — scaffold for recurring schedule definitions",
        "planned": ["Automated variation selection", "Schedule conflict detection", "Circadian-aware scheduling"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring appointment definition — persistent pattern defining instance schedule.",
        "created_by": "Instance configuration or manual definition",
        "persists": "Permanently — updated when schedule patterns change",
        "consumed_by": "Daily/weekly schedule generation, coordination creation",
        "scope": "instance — defines one instance's appointment pattern"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times (24-hour), category_id enum, recurrence enum",
    "_Cc_constraint": "Appointment id, category_id, and title required. Variations optional — use when schedule has multiple patterns.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Appointment Definition",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "unique-identifier",
    "category_id": "collaboration",
    "title": "Appointment Title",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "What this appointment is for",
    "start_time": "HH:MM",
    "end_time": "HH:MM",
    "duration_minutes": 0,
    "recurrence": "daily",
    "recurrence_pattern": {
        "frequency": "daily",
        "exceptions": []
    },
    "location": "",
    "protected": false,
    "flexible": true,

    "variations": {
        "variation_name": {
            "typical_days": [],
            "schedule": "HH:MM - HH:MM",
            "duration_minutes": 0,
            "notes": "Notes about this variation"
        }
    },

    "notes": [],

    "usage": {
        "purpose": "Define recurring instance appointment patterns",
        "category_values": "sacred | work | rest | collaboration | other",
        "recurrence_values": "daily | weekly | monthly | none",
        "lifecycle": "Persistent — updated when patterns change"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add appointment definition discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "variations", "notes", "usage", "extensions"],
        "value_format": "category_id: sacred/work/rest/collaboration/other. recurrence: daily/weekly/monthly/none."
    },
    "_Cv_health_scoring": { "total": 100, "clear_appointment_definition": 35, "useful_schedule_patterns": 35, "meaningful_variations": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove appointment_id (breaks schedule references)"],
    "_X1_careful": ["Change recurrence pattern (may invalidate daily/weekly views)", "Change category_id (may affect scheduling priorities)"],
    "_X1_safe": ["Add variations", "Update notes", "Adjust timing", "Toggle protected/flexible flags"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated variation selection", "Schedule conflict detection", "Circadian-aware scheduling"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "time_mismatch": "Start/end times don't match duration. Recalculate — duration_minutes should equal the difference.",
        "missing_variations": "Appointment has variable schedule but no variations defined. Add variation entries for each pattern.",
        "orphaned_reference": "Daily schedule references appointment_id that doesn't exist. Check appointment definitions."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/temporal/appointed/instances/available-template.jsonc — Available appointment (lunch breaks)",
        "tov/temporal/appointed/instances/deep-work-template.jsonc — Deep work sessions",
        "tov/temporal/appointed/instances/semi-downtime-template.jsonc — Semi-downtime state",
        "tov/temporal/appointed/instances/daily-template.jsonc — Daily schedule view",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "appointment_id", "category_id", "title"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Instance appointment definitions. Recurring schedule patterns. Variations for flexibility. Intentional rhythm over reactive availability.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose under the heaven. — Ecclesiastes 3:1",
    "_X5_anchor": "Defined patterns create intentional rhythm. Each appointment type serves a purpose. Variations honor the reality that patterns shift.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
