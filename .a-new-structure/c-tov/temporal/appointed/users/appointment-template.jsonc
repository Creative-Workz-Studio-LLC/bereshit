    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — base user appointment definition with variations",
    "_P3_layer": "tov/temporal/appointed/users",
    "_P3_includes": "none",
    "_P3_provides": ["USER_APPOINTMENT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "User Appointment — Base Recurring Appointment Template",
    "_P5_brief": "Template for defining user recurring appointments with schedule variations. Captures appointment identity (id, category, title), schedule details (times, duration, recurrence), and day-specific variations. Base template — specialized templates (work, sacred, rest) extend this pattern for specific appointment types.",
    "_P5_usage": "Copy to appointments/users/{identity_id}/ as [appointment-name].jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "appointment-template.jsonc",
        "key": "B-tov-temporal-appointed-user-appointment",
        "title": "User Appointment — Base Recurring Appointment Template",
        "type": "Data (Template)",
        "component": "Scaffold — base user appointment definition with variations",
        "role": "Define recurring user appointments with schedule and day-specific variations"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "To every thing there is a season, and a time to every purpose under the heaven."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "Appointments are purposes with appointed times. Each recurring commitment has a rhythm — days it happens, times it occupies, variations by context. Defining these rhythms brings intentionality to what could otherwise be reactive scheduling.",
        "anchor": "Psalm 31:15 — My times are in thy hand."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, user identity config",
        "consumers": "Daily schedule generation, weekly overview, coordination planning",
        "integration": "User appointments define the user's committed time blocks. Specialized templates (work, sacred, rest) extend this base pattern for specific categories. Variations capture day-to-day schedule differences. Daily views reference these definitions.",
        "if_missing": "No structured appointment definitions — scheduling happens ad hoc",
        "related_data": {
            "references": {
                "category-definitions": "Appointment categories (sacred, work, rest, collaboration, other)"
            },
            "referenced_by": {
                "daily-schedule": "Daily views reference appointment definitions",
                "weekly-overview": "Weekly views aggregate from appointment data",
                "coordination": "Coordination files link user and instance appointments"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/appointed/users/appointment-template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, user, appointment, recurring, variations, schedule, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define recurring user appointments with schedule variations",
        "core_design": "Appointment identity (id, category_id, title) + schedule (start_time, end_time, duration, recurrence, recurrence_pattern, location, protected, flexible) + variations (day-specific patterns with schedule, duration, lunch_break, notes) + notes array.",
        "philosophy": "To every thing there is a season. Appointments are committed time — defining them explicitly transforms reactive scheduling into intentional time stewardship.",
        "key_features": {
            "base_template": "Pattern extended by work, sacred, rest specialized templates",
            "day_variations": "Different schedules for different days of the week",
            "recurrence_patterns": "Weekly/daily with exceptions",
            "protected_flexible_flags": "Non-negotiable vs adjustable appointments"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "User appointment template — scaffold for recurring appointment definitions",
        "planned": ["Appointment conflict detection", "Schedule optimization suggestions", "Calendar integration"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring appointment — persistent pattern defining user's committed time blocks.",
        "created_by": "User configuration documenting actual schedule commitments",
        "persists": "Permanently — updated when schedule changes",
        "consumed_by": "Daily schedule generation, weekly overview, coordination",
        "scope": "user — defines the user's own recurring appointments"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times (24-hour), weekly/daily recurrence",
    "_Cc_constraint": "Appointment id required. Category must be one of: sacred, work, rest, collaboration, other. Variations optional.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Appointment Definition",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "example-appointment",
    "category_id": "work",
    "title": "Example Work Appointment",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Example recurring work appointment with multiple schedule variations",
    "start_time": "09:00",
    "end_time": "17:00",
    "duration_minutes": 480,
    "recurrence": "weekly",
    "recurrence_pattern": {
        "frequency": "weekly",
        "day_of_week": "Monday",
        "exceptions": []
    },
    "location": "Office Building",
    "protected": false,
    "flexible": true,

    "variations": {
        "regular_day": {
            "typical_days": ["Monday", "Wednesday", "Friday"],
            "schedule": "9:00 AM - 5:00 PM",
            "duration_minutes": 480,
            "work_minutes": 420,
            "lunch_break": "12:00 PM - 1:00 PM",
            "notes": "Standard work day with lunch break"
        },
        "early_day": {
            "typical_days": ["Tuesday"],
            "schedule": "8:00 AM - 4:00 PM",
            "duration_minutes": 480,
            "work_minutes": 420,
            "lunch_break": "11:30 AM - 12:30 PM",
            "notes": "Early start day"
        }
    },

    "notes": [
        "Example appointment showing structure",
        "Replace all example values with actual appointment details",
        "Variations section is optional — use only if needed"
    ],

    "usage": {
        "purpose": "Define recurring user appointments with day-specific variations",
        "naming": "Simple names: work, church, bible-study, personal-time, sleep",
        "lifecycle": "Persistent — updated when schedule changes"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add appointment pattern discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "variations", "notes", "usage", "extensions"],
        "value_format": "category_id: sacred|work|rest|collaboration|other. Times in HH:MM 24-hour format."
    },
    "_Cv_health_scoring": { "total": 100, "complete_appointment_identity": 30, "clear_schedule_definition": 35, "useful_variations": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

