        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "appointment_id", "category_id", "title"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Base user appointment template. Recurring definitions. Day variations. Schedule intentionality. Stewardship of time.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose. — Ecclesiastes 3:1",
    "_X5_anchor": "Appointments are purposes with appointed times. Define them explicitly, schedule intentionally, steward time faithfully.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
