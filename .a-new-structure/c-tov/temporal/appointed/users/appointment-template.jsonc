        "missing_lunch_break": "Work hours don't account for lunch. Separate work_minutes from duration_minutes.",
        "category_mismatch": "Category doesn't match appointment purpose. Valid: sacred, work, rest, collaboration, other."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
