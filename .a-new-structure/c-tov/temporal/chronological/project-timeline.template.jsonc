{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-chronological-project-timeline",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "chronological-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — project chronology with milestones, sessions, and time tracking",
    "_P3_layer": "tov/temporal/chronological",
    "_P3_includes": "none",
    "_P3_provides": ["CHRONOLOGICAL_PROJECT_TIMELINE_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Project Timeline — Chronology and Progress Tracking Template",
    "_P5_brief": "Template for tracking project chronology — milestones, work sessions, time investment, and progress summary. Captures the full story of a project: who participated, what was accomplished, how time was invested, and where it's headed. Kingdom purpose tracked alongside technical progress.",
    "_P5_usage": "Copy to projects/{project-id}.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "project-timeline.template.jsonc",
        "key": "B-tov-temporal-chronological-project-timeline",
        "title": "Project Timeline — Chronology and Progress Tracking Template",
        "type": "Data (Template)",
        "component": "Scaffold — project chronology with milestones, sessions, and time tracking",
        "role": "Track project progress, time investment, and Kingdom impact over time"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "For which of you, intending to build a tower, sitteth not down first, and counteth the cost?"
    "_M4_grounding": {
        "scripture": "Luke 14:28 — For which of you, intending to build a tower, sitteth not down first, and counteth the cost, whether he have sufficient to finish it?",
        "principle": "Count the cost. Project timelines honor wise stewardship — knowing what's been invested, what's been accomplished, and what's needed to finish. Time tracking isn't micromanagement but faithful accounting of the resources God provides.",
        "anchor": "Nehemiah 4:6 — So built we the wall... for the people had a mind to work."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, project definition",
        "consumers": "Milestone tracking, yearly summary, portfolio overview",
        "integration": "Project timelines track the chronological story of a specific project. Sessions cross-reference with personal calendars. Milestones feed into the yearly milestones tracker. Time summary provides investment visibility.",
        "if_missing": "No project history — cannot see how time was invested, what milestones were reached, or how the project evolved",
        "related_data": {
            "references": {
                "personal-calendars": "Personal logs for complete time tracking context"
            },
            "referenced_by": {
                "milestones": "Yearly milestones reference project milestones",
                "yearly-log": "Year-end summary references project progress"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/chronological/project-timeline.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, chronological, project, timeline, milestones, sessions, time-tracking, progress, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track project progress, time investment, and Kingdom impact",
        "core_design": "Project identity (project_id, name, type, status, dates, participants, kingdom_purpose) + milestones array (achievements within this project) + sessions array (work sessions with focus/outcomes) + time_summary (totals by participant, phase, session averages) + summary (current state, priorities, achievements, kingdom impact, next steps) + extensions.",
        "philosophy": "Count the cost. Faithful stewardship of time and resources. Project timelines tell the story of how God's provision was invested — not just what was built but how it was built and why it matters.",
        "key_features": {
            "full_project_story": "From start to current state with milestones and sessions",
            "time_investment_tracking": "Total time, by participant, by phase, average sessions",
            "kingdom_purpose": "Why this project matters for Kingdom purposes",
            "partnership_insights": "How collaboration functioned on this project"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Project timeline template — scaffold for project chronology",
        "planned": ["Budget tracking", "Resource allocation", "Risk assessment", "Dependency tracking"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "project-lifetime",
        "description": "Project-lifetime chronology — active throughout the project, completed and archived when project finishes.",
        "created_by": "Project initiation — one file per project",
        "persists": "Project lifetime — from start to completion/archival",
        "consumed_by": "Milestone tracking, yearly summary, portfolio overview",
        "scope": "project — one specific project's complete chronological record"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks chronological lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, Xh XXm duration format, kebab-case identifiers",
    "_Cc_constraint": "project_id required (kebab-case). status from: planning, active, on-hold, completed, archived. Sessions and milestones accumulated over project lifetime.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Project Timeline",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "project_id": "example-project",
    "project_name": "Example Project",
    "project_type": "infrastructure",
    "status": "active",
    "start_date": "2025-01-01",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Brief description of what this project is and aims to accomplish",
    "target_completion_date": null,
    "participants": [
        { "identity_type": "user", "identity_id": "example-user", "role": "Role in project" }
    ],
    "kingdom_purpose": "How this project serves Kingdom purposes and eternal value",
    "generated_date": "2025-01-01",

    "milestones": [
        {
            "milestone_id": "example-milestone",
            "name": "Milestone Name",
            "date": "2025-03-01",
            "description": "What this milestone represents",
            "participants": ["user-id"],
            "significance": "Why this milestone matters for the project"
        }
    ],

    "sessions": [
        {
            "date": "2025-01-01",
            "duration": "3h 00m",
            "focus": "What this session focused on",
            "participants": ["user-id"],
            "outcomes": ["What was accomplished"]
        }
    ],

    "time_summary": {
        "total_time_invested": "0h 00m",
        "time_by_participant": {},
        "average_session_length": "0h 00m",
        "total_sessions": 0,
        "time_by_phase": {}
    },

    "summary": {
        "current_state": "",
        "major_components_completed": [],
        "current_priorities": [],
        "technical_achievements": [],
        "partnership_insights": [],
        "kingdom_impact": [],
        "next_steps": []
    },

    "usage": {
        "purpose": "Track project chronology with milestones and time investment",
        "status_values": "planning | active | on-hold | completed | archived",
        "lifecycle": "Project lifetime — active from start to completion"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add project discoveries here (e.g., budget tracking, resource allocation, risk assessment)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-chronological"] },
    "_Cv_schema": {
        "required": ["name", "version", "project_id", "project_name", "project_type", "status", "start_date"],
        "optional": ["description", "target_completion_date", "participants", "kingdom_purpose", "generated_date", "milestones", "sessions", "time_summary", "summary", "usage", "extensions"],
        "value_format": "project_id: kebab-case. status: planning|active|on-hold|completed|archived. Dates: YYYY-MM-DD. Durations: 'Xh XXm'."
    },
    "_Cv_health_scoring": { "total": 100, "complete_session_logging": 30, "meaningful_milestones": 35, "accurate_time_tracking": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete recorded sessions or milestones"],
    "_X1_careful": ["Change project status without updating summary", "Remove kingdom_purpose field"],
    "_X1_safe": ["Add sessions and milestones", "Update summary and time tracking", "Refine project description"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Budget tracking", "Resource allocation", "Risk assessment", "Dependency tracking", "Deliverables list"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "time_mismatch": "Time summary doesn't match session totals. Recalculate from sessions array.",
        "stale_status": "Project status doesn't reflect reality. Update status and summary together.",
        "missing_kingdom_purpose": "No kingdom_purpose recorded. Every project should articulate how it serves Kingdom purposes."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/temporal/chronological/milestones.template.jsonc — Cross-project milestone tracking",
        "tov/temporal/chronological/shared-log.template.jsonc — Partnership collaboration log",
        "tov/temporal/chronological/weekly-log.template.jsonc — Weekly personal logs for session context",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "project_id", "project_name", "project_type", "status", "start_date"],
    "_X4_validate": "make && ./bin/tov --validate-chronological",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Project chronology. Milestones and sessions. Time investment tracking. Kingdom purpose alongside technical progress.",
    "_X5_scripture": "For which of you, intending to build a tower, sitteth not down first, and counteth the cost? — Luke 14:28",
    "_X5_anchor": "Count the cost. Track faithfully. Every session invested and milestone reached tells the story of how God's provision was stewarded.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
