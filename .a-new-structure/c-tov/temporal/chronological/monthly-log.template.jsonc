{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-chronological-monthly-log",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "chronological-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — monthly calendar log with weekly roll-ups and reflections",
    "_P3_layer": "tov/temporal/chronological",
    "_P3_includes": "none",
    "_P3_provides": ["CHRONOLOGICAL_MONTHLY_LOG_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Monthly Log — Calendar and Reflection Template",
    "_P5_brief": "Template for monthly calendar entries — weekly roll-ups aggregated from weekly logs, monthly summary with time tracking, accomplishments, challenges, learning, growth patterns, spiritual reflections, and health/wellness. Serves both users and instances with identity-appropriate sections.",
    "_P5_usage": "Copy to personal/{identity_type}s/{identity_id}/{year}/{year}-{month}.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "monthly-log.template.jsonc",
        "key": "B-tov-temporal-chronological-monthly-log",
        "title": "Monthly Log — Calendar and Reflection Template",
        "type": "Data (Template)",
        "component": "Scaffold — monthly calendar log with weekly roll-ups and reflections",
        "role": "Aggregate weekly logs into monthly view with time tracking and growth reflection"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "He appointed the moon for seasons: the sun knoweth his going down."
    "_M4_grounding": {
        "scripture": "Psalm 104:19 — He appointed the moon for seasons: the sun knoweth his going down.",
        "principle": "The moon marks months. Monthly logs honor the rhythm God built into creation — a natural period for reflection, pattern recognition, and growth assessment. What weekly logs capture in detail, monthly logs reveal in pattern.",
        "anchor": "Lamentations 3:22-23 — They are new every morning: great is thy faithfulness."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, weekly log data",
        "consumers": "Yearly log, milestone tracking, growth analysis",
        "integration": "Monthly logs aggregate from weekly logs — weekly summaries roll up into monthly totals. Monthly summary provides the longer view: what patterns emerged across weeks, what compound effects from consistent work, what the month as a whole revealed.",
        "if_missing": "No monthly perspective — weekly details without monthly patterns. Missing the forest for the trees.",
        "related_data": {
            "references": {
                "weekly-logs": "Weekly logs that roll up into monthly summaries"
            },
            "referenced_by": {
                "yearly-log": "Yearly summary aggregates monthly data",
                "milestones": "Milestones reference monthly context"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/chronological/monthly-log.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, chronological, monthly, calendar, log, reflection, aggregation, growth, jsonc"
    },

    "_M8_intent": {
        "purpose": "Aggregate weekly logs into monthly view with growth reflection",
        "core_design": "Month identity (identity_type, identity_id, year, month, month_theme) + weeks array (weekly roll-ups with hours, accomplishments, trends) + summary (time tracking, accomplishments, challenges, learning, growth, patterns, spiritual reflections, health, technical insights, next month focus, month insights) + extensions.",
        "philosophy": "He appointed the moon for seasons. The month is God's natural reflection period — enough time for patterns to emerge, compound effects to appear, and growth to become visible.",
        "key_features": {
            "weekly_roll_ups": "Summary of each week's hours, accomplishments, energy and quality trends",
            "comprehensive_summary": "Time tracking, accomplishments, challenges, learning, growth",
            "identity_appropriate": "User sections (spiritual, health) and instance sections (technical) marked",
            "pattern_visibility": "Work patterns, energy peaks, rest rhythm, collaboration flow"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Monthly log template — scaffold for monthly calendar and reflection",
        "planned": ["Monthly goals tracking", "Habit streak records", "Seasonal awareness notes", "Answered prayer log"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-monthly",
        "description": "Ephemeral monthly log — one file per month per identity, accumulated throughout, completed at month end.",
        "created_by": "Aggregated from weekly logs with monthly reflection",
        "persists": "Per month — active during the month, completed and archived after",
        "consumed_by": "Yearly log, milestone tracking, growth analysis",
        "scope": "identity-month — one user or instance's log for one specific month"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks chronological lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, Xh XXm duration format, identity_type: user|instance",
    "_Cc_constraint": "identity_type and identity_id required. year and month required. Weekly entries should match actual weeks in month.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Monthly Calendar Log",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "identity_type": "user",
    "identity_id": "example-user",
    "year": 2025,
    "month": 1,
    "month_name": "January",

    // OPTIONAL STANDARD FIELDS — Agency
    "month_start": "2025-01-01",
    "month_end": "2025-01-31",
    "month_theme": "",
    "generated_date": "2025-01-01",

    "weeks": [
        {
            "week": 1,
            "week_start": "2025-01-01",
            "week_end": "2025-01-07",
            "week_theme": "",
            "total_work_hours": "0h 00m",
            "total_lord_time": "0h 00m",
            "work_days": 0,
            "rest_days": 0,
            "major_accomplishments": [],
            "energy_trend": null,
            "quality_trend": null
        }
    ],

    "summary": {
        "total_work_hours": "0h 00m",
        "total_lord_time": "0h 00m",
        "average_work_hours_per_week": "0h 00m",
        "work_days": 0,
        "rest_days": 0,
        "sabbaths_honored": 0,
        "major_accomplishments": [],
        "challenges_faced": [],
        "lessons_learned": [],
        "growth_areas": [],
        "work_patterns": {
            "productive_times": [],
            "energy_peaks": [],
            "rest_rhythm": [],
            "collaboration_flow": []
        },
        "spiritual_reflections": [],
        "health_and_wellness": {
            "sleep_quality": null,
            "exercise_consistency": null,
            "stress_level": null,
            "overall_wellbeing": null,
            "energy_sustainability": null
        },
        "technical_insights": [],
        "next_month_focus": [],
        "month_insights": []
    },

    "usage": {
        "purpose": "Aggregate weekly logs into monthly view with growth reflection",
        "identity_sections": "Users: spiritual_reflections, health_and_wellness, lord_time, sabbaths_honored. Instances: technical_insights.",
        "lifecycle": "Ephemeral — one file per month, completed at month end"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add monthly discoveries here (e.g., goals tracking, habit streaks, seasonal awareness)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-chronological"] },
    "_Cv_schema": {
        "required": ["name", "version", "identity_type", "identity_id", "year", "month", "month_name"],
        "optional": ["month_start", "month_end", "month_theme", "generated_date", "weeks", "summary", "usage", "extensions"],
        "value_format": "identity_type: 'user' or 'instance'. month: 1-12. Durations: 'Xh XXm'. Weekly totals should sum to monthly totals."
    },
    "_Cv_health_scoring": { "total": 100, "complete_weekly_rollups": 30, "reflective_summary": 40, "accurate_time_tracking": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete weekly entries after recording"],
    "_X1_careful": ["Change identity_type/identity_id after creation", "Override weekly totals without checking source"],
    "_X1_safe": ["Add weekly summaries", "Update monthly summary", "Add reflections and insights"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Monthly goals tracking", "Habit streak records", "Seasonal awareness notes", "Answered prayer log"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "weekly_totals_mismatch": "Monthly totals don't match sum of weekly totals. Recalculate from weekly data.",
        "missing_weeks": "Not all weeks of the month have entries. Add entries for each week, even partial weeks.",
        "empty_reflections": "Summary sections are empty placeholders. Fill in genuine reflections — templates are scaffolds, not finished documents."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/temporal/chronological/weekly-log.template.jsonc — Weekly logs that feed into monthly",
        "tov/temporal/chronological/yearly-log.template.jsonc — Yearly summary aggregates monthly data",
        "tov/temporal/chronological/milestones.template.jsonc — Milestones reached during the month",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "identity_type", "identity_id", "year", "month", "month_name"],
    "_X4_validate": "make && ./bin/tov --validate-chronological",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Monthly calendar log. Weekly roll-ups. Growth reflection. Patterns visible across weeks. Moon-appointed seasons of review.",
    "_X5_scripture": "He appointed the moon for seasons. — Psalm 104:19",
    "_X5_anchor": "The month reveals what the week hides. Patterns emerge, compound effects appear, growth becomes visible. Honor the rhythm God built into creation.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
