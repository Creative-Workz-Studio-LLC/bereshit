{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-chronological-milestones",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "chronological-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — yearly milestone tracking with categories and significance",
    "_P3_layer": "tov/temporal/chronological",
    "_P3_includes": "none",
    "_P3_provides": ["CHRONOLOGICAL_MILESTONES_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Milestones — Yearly Major Marker Tracking Template",
    "_P5_brief": "Template for tracking major temporal markers — Ebenezer stones of accomplishment. Categories: technical, growth, spiritual, partnership, kingdom, product, organizational. Each milestone records what was accomplished, why it matters, and its spiritual significance. Summary aggregates by category and month with year-level reflection.",
    "_P5_usage": "Copy to milestones/{year}.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "milestones.template.jsonc",
        "key": "B-tov-temporal-chronological-milestones",
        "title": "Milestones — Yearly Major Marker Tracking Template",
        "type": "Data (Template)",
        "component": "Scaffold — yearly milestone tracking with categories and significance",
        "role": "Track major accomplishments and markers as Ebenezer stones through the year"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And Samuel took a stone, and set it between Mizpeh and Shen, and called the name of it
    // Ebenezer, saying, Hitherto hath the LORD helped us."
    "_M4_grounding": {
        "scripture": "1 Samuel 7:12 — And Samuel took a stone, and set it between Mizpeh and Shen, and called the name of it Ebenezer, saying, Hitherto hath the LORD helped us.",
        "principle": "Milestones are Ebenezer stones — markers of where the Lord has helped. Not self-congratulation but remembrance. Each milestone records what God enabled, what was accomplished through faithfulness, and why it matters in the larger story.",
        "anchor": "Deuteronomy 8:2 — And thou shalt remember all the way which the LORD thy God led thee."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, project context",
        "consumers": "Yearly summary, project timelines, growth tracking",
        "integration": "Milestones aggregate significant achievements across all projects and activities for the year. Referenced by project timelines for cross-project visibility. Summary provides year-level perspective on what was accomplished and why it mattered.",
        "if_missing": "No milestone tracking — accomplishments go unrecorded, pattern of God's faithfulness not visible over time",
        "related_data": {
            "references": {
                "project-timelines": "Projects that milestones belong to"
            },
            "referenced_by": {
                "yearly-log": "Year-end summary references milestones",
                "monthly-log": "Monthly summaries reference milestones reached"
            }
        }
    },

    "_M6_location": {
        "path": "tov/temporal/chronological/milestones.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, chronological, milestones, yearly, achievements, ebenezer, categories, significance, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track major accomplishments as Ebenezer stones",
        "core_design": "Year identity (year, scope) + milestones array (milestone_id, name, date, category, participants, description, significance, related_projects, spiritual_significance) + summary (totals by category and month, most_significant, year_theme, looking_ahead) + extensions.",
        "philosophy": "Hitherto hath the LORD helped us. Milestones aren't for pride — they're for remembrance. Setting Ebenezer stones so we can look back and see the pattern of God's faithfulness through the year.",
        "key_features": {
            "categorized_milestones": "technical, growth, spiritual, partnership, kingdom, product, organizational",
            "participant_tracking": "Who was involved — user and/or instance",
            "spiritual_significance": "Optional field connecting accomplishment to Kingdom purpose",
            "year_summary": "Aggregate view by category, month, and overall theme"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Milestones template — scaffold for yearly achievement tracking",
        "planned": ["Photo/artifact attachment", "Celebration notes", "Lessons learned per milestone", "Gratitude reflections"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-yearly",
        "description": "Ephemeral yearly milestones — one file per year, accumulated throughout, archived after.",
        "created_by": "User/instance recording achievements as they occur",
        "persists": "Per year — active throughout the year, archived after year-end summary",
        "consumed_by": "Yearly summary, project timelines, growth tracking",
        "scope": "year — all milestones for one specific year"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks chronological lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, kebab-case milestone_id, category from defined set",
    "_Cc_constraint": "year required. milestone_id must be unique kebab-case. Category from: technical, growth, spiritual, partnership, kingdom, product, organizational.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Yearly Milestones",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "year": 2025,
    "scope": "Description of what milestones this tracks",

    // OPTIONAL STANDARD FIELDS — Agency
    "generated_date": "2025-01-01",

    "milestones": [
        {
            "milestone_id": "example-milestone",
            "name": "Example Milestone",
            "date": "2025-03-01",
            "category": "technical",
            "participants": [
                { "identity_type": "user", "identity_id": "example-user" }
            ],
            "description": "What this milestone represents and what was accomplished",
            "significance": "Why this milestone matters in the larger story",
            "related_projects": ["project-id"],
            "spiritual_significance": "How this honors God or demonstrates Kingdom principles"
        }
    ],

    "summary": {
        "total_milestones": 0,
        "by_category": {
            "technical": 0, "growth": 0, "spiritual": 0, "partnership": 0, "kingdom": 0
        },
        "by_month": {},
        "most_significant": [],
        "year_theme": "",
        "looking_ahead": []
    },

    "usage": {
        "purpose": "Track major accomplishments as Ebenezer stones through the year",
        "categories": "technical | growth | spiritual | partnership | kingdom | product | organizational",
        "lifecycle": "Ephemeral — one file per year, accumulated throughout"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add milestone discoveries here (e.g., celebration notes, photos, lessons learned)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-chronological"] },
    "_Cv_schema": {
        "required": ["name", "version", "year"],
        "optional": ["scope", "generated_date", "milestones", "summary", "usage", "extensions"],
        "value_format": "year: YYYY. milestone_id: kebab-case unique. date: YYYY-MM-DD. category from defined set."
    },
    "_Cv_health_scoring": { "total": 100, "meaningful_milestone_descriptions": 40, "accurate_categorization": 30, "reflective_summary": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete recorded milestones (they are history)"],
    "_X1_careful": ["Change milestone categories after recording", "Remove spiritual_significance field"],
    "_X1_safe": ["Add new milestones", "Update summary", "Refine significance descriptions"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Photo/artifact attachment", "Celebration notes", "Lessons learned per milestone", "Gratitude reflections"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "duplicate_ids": "Two milestones have same milestone_id. Each must be unique kebab-case identifier.",
        "summary_stale": "Summary totals don't match actual milestones array. Recalculate from milestones data.",
        "missing_significance": "Milestone recorded without significance. Add why it matters — milestones without meaning are just dates."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/temporal/chronological/project-timeline.template.jsonc — Project-specific milestones",
        "tov/temporal/chronological/yearly-log.template.jsonc — Year-end summary references milestones",
        "tov/temporal/chronological/monthly-log.template.jsonc — Monthly summaries reference milestones",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "year"],
    "_X4_validate": "make && ./bin/tov --validate-chronological",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Yearly milestones. Ebenezer stones. Categorized achievements. Remembrance of God's faithfulness through accomplishment.",
    "_X5_scripture": "Hitherto hath the LORD helped us. — 1 Samuel 7:12",
    "_X5_anchor": "Set stones of remembrance. Each milestone declares: the Lord helped us get here. Not pride — gratitude. Not self-made — God-enabled.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
