{
    // #!omni template --jsonc
    "$schema": "../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-projects-low-level",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "project-tracking",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — days-scope concrete task tracking",
    "_P3_layer": "tov/projects",
    "_P3_includes": "none",
    "_P3_provides": ["LOW_LEVEL_PROJECT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Low-Level Project — Task-Scope Project Template",
    "_P5_brief": "Template for days-scope specific tasks. Concrete actionable work with short timeframes and clear completion criteria. References mid-level parent. Usually doesn't subdivide further.",
    "_P5_usage": "cp low-level-template.jsonc projects/<project-id>.jsonc -> set core fields, link to parent",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "low-level-template.jsonc",
        "key": "B-tov-projects-low-level",
        "title": "Low-Level Project — Task-Scope Project Template",
        "type": "Data (Template)",
        "component": "Scaffold — days-scope concrete task tracking",
        "role": "Track concrete tasks with clear completion criteria and session-level progress"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Whatsoever thy hand findeth to do, do it with thy might."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 9:10 — Whatsoever thy hand findeth to do, do it with thy might; for there is no work, nor device, nor knowledge, nor wisdom, in the grave, whither thou goest.",
        "principle": "Do the work at hand with full effort. Low-level tasks are where vision becomes reality — concrete, actionable, completable. Each task done with might contributes to the whole.",
        "anchor": "Colossians 3:23 — And whatsoever ye do, do it heartily, as to the Lord, and not unto men."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Task tracking, session focus, parent project progress",
        "integration": "Low-level tasks reference mid-level parents. Completion feeds up to parent progress. Session-level tracking (current_session_number) enables precise awareness.",
        "if_missing": "No task-level tracking — work happens without clear completion criteria or session awareness",
        "related_data": {
            "references": {
                "mid-level-project": "Parent project providing context and scope"
            },
            "referenced_by": {
                "session-current": "Active task informs current session focus",
                "parent-progress": "Task completion feeds parent progress"
            }
        }
    },

    "_M6_location": {
        "path": "tov/projects/low-level-template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "project, low-level, task, tracking, concrete, actionable, completion, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track concrete tasks with session-level progress and clear completion",
        "core_design": "Same core structure as high/mid + session-level progress tracking (current_session_number). Low-level usually doesn't subdivide. Short timeframes with clear completion criteria.",
        "philosophy": "Do it with thy might. Low-level tasks are where the rubber meets the road. Clear criteria, honest progress, faithful execution. Every task done well honors the whole.",
        "key_features": {
            "short_timeframe": "Days-scope — usually 1-3 days",
            "session_tracking": "Current session number for precise progress awareness",
            "clear_completion": "Specific deliverables with obvious done criteria",
            "no_subdivision": "Usually leaf nodes — doesn't contain subprojects"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Low-level task template — scaffold for concrete task tracking",
        "planned": ["First task instance", "Session-to-task progress automation", "Completion notification to parent"]
    },

    "_M10_project_scope": {
        "level": "low",
        "typical_timeframe": "Days",
        "description": "Task-scope project — concrete actionable work with clear completion criteria.",
        "parent": "Mid-level subsystem project",
        "children": "Usually none (leaf node)",
        "consumed_by": "Task tracking, session focus, parent progress aggregation"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (project scope) tracks project hierarchy and timeframe.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "kebab-case for project_id, lowercase_with_underscores for fields",
    "_Cc_constraint": "Core fields required. Short timeframes. Clear completion criteria. Usually doesn't subdivide.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Low-Level Task Template",
    "version": "a-01.00",

    // CORE (REQUIRED) — The Created Order
    "schema_version": "1.0.0",
    "project_id": "unique-identifier",
    "project_name": "Task Name",
    "level": "low",
    "parent_id": "parent-project-id",
    "status": "active",

    "identity": {
        "primary_user_id": "user-id",
        "primary_instance_id": "instance-id",
        "collaborators": []
    },

    "biblical_foundation": {
        "scripture": "Book Chapter:Verse",
        "text": "Actual Scripture text here",
        "principle": "How this Scripture illuminates THIS specific work"
    },

    // OPTIONAL STANDARD FIELDS — Agency Within Constraints
    "workspace": {
        "path": "/path/to/workspace",
        "repository_url": null,
        "branch": "main"
    },

    "inherited_preferences": {
        "workflow": "build-first",
        "thinking_style": "building-blocks",
        "session_defaults": {
            "thinking_enabled": false,
            "plan_mode": false,
            "auto_accept": false
        },
        "work_hours": {
            "timezone": "America/Chicago",
            "preferred_times": ["morning", "evening"]
        }
    },

    "project_type": "system_architecture",

    "technical_context": {
        "languages": ["go", "rust", "markdown"],
        "frameworks": [],
        "tools": ["git", "claude-code"]
    },

    "scope": {
        "description": "What this task accomplishes",
        "deliverables": ["Specific output 1", "Specific output 2"],
        "impact": "How this contributes to parent project"
    },

    "dates": {
        "start_date": "2025-01-01",
        "estimated_end_date": "2025-01-03",
        "actual_end_date": null
    },

    "estimates": {
        "total_days": 2,
        "total_sessions": 3,
        "total_uptime_hours": 6,
        "avg_session_uptime_minutes": 120
    },

    "progress": {
        "days_elapsed": 0,
        "sessions_completed": 0,
        "uptime_hours_actual": 0,
        "current_session_number": 1,
        "completion_percentage": 0
    },

    "milestones": [
        {
            "name": "Task complete",
            "target_date": "2025-01-03",
            "status": "pending",
            "description": "All deliverables finished"
        }
    ],

    "subprojects": [],
    "dependencies": [],
    "notes": ["Context, insights, observations"],

    "usage": {
        "purpose": "Track concrete tasks with session-level progress",
        "level_guidance": "Low-level = days scope, concrete deliverables, clear completion. Usually doesn't subdivide.",
        "session_tracking": "current_session_number tracks which session you're in for this task"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add completed_tasks, remaining_tasks, insights as discoveries emerge"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-projects"] },
    "_Cv_schema": {
        "required": ["name", "version", "project_id", "project_name", "level", "parent_id", "status", "identity", "biblical_foundation"],
        "optional": ["workspace", "inherited_preferences", "project_type", "technical_context", "scope", "dates", "estimates", "progress", "milestones", "subprojects", "dependencies", "notes", "usage", "extensions"],
        "value_format": "project_id: kebab-case. Status: planned/active/paused/completed."
    },
    "_Cv_health_scoring": { "total": 100, "clear_completion_criteria": 35, "realistic_estimates": 30, "honest_session_tracking": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Mark completed without actually finishing deliverables"],
    "_X1_careful": ["Change scope after starting (document why)", "Add subprojects (low-level usually doesn't subdivide)"],
    "_X1_safe": ["Update progress after each session", "Add notes and insights", "Mark completed when done"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["First task instance", "Session-to-task automation", "Completion notification chain"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "task_growing": "Task scope expanding beyond days. Break into multiple low-level tasks or promote to mid-level.",
        "stuck": "Task stuck — no progress across sessions. Re-evaluate approach, check dependencies, or ask for help.",
        "unclear_completion": "Don't know when task is done. Define specific deliverables before continuing."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/projects/mid-level-template.jsonc — Parent project template",
        "tov/projects/high-level-template.jsonc — Paradigm project template",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "project_id", "project_name", "level", "parent_id", "status", "identity", "biblical_foundation"],
    "_X4_validate": "make && ./bin/tov --validate-projects",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Task-scope concrete work. Days timeframe. Clear completion criteria. Session-level tracking. Do it with thy might.",
    "_X5_scripture": "Whatsoever thy hand findeth to do, do it with thy might. — Ecclesiastes 9:10",
    "_X5_anchor": "Where vision becomes reality. Every task done with might contributes to the whole. Faithful in the small things.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp low-level-template.jsonc projects/<project-id>.jsonc -> set core fields, link to parent",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title with task name",
        "project_id, project_name, parent_id, identity, biblical_foundation: set for this task",
        "scope: define specific deliverables with clear completion criteria",
        "Remove _X6 section when instantiating"
    ],

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
