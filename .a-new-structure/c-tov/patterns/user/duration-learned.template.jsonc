    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — user session duration pattern aggregation",
    "_P3_layer": "tov/patterns/user",
    "_P3_includes": "none",
    "_P3_provides": ["DURATION_LEARNED_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Duration Learned — User Session Duration Patterns",
    "_P5_brief": "Template for aggregating user session duration patterns from observed behavior. Duration distribution, typical session length, quality correlation, and capacity insights. Generated from session history, NOT manually created. Enables realistic capacity planning.",
    "_P5_usage": "cp duration-learned.template.jsonc patterns/user/<username>/duration/learned.jsonc -> populate from session aggregation",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "duration-learned.template.jsonc",
        "key": "B-tov-patterns-user-duration-learned",
        "title": "Duration Learned — User Session Duration Patterns",
        "type": "Data (Template)",
        "component": "Scaffold — user session duration pattern aggregation",
        "role": "Enable realistic capacity planning from observed session duration behavior"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "In all labour there is profit: but the talk of the lips tendeth only to penury."
    "_M4_grounding": {
        "scripture": "Proverbs 14:23 — In all labour there is profit: but the talk of the lips tendeth only to penury.",
        "principle": "Actual labor produces results. Duration patterns reveal real capacity — not what we say we can do, but what we actually do. Honest assessment enables faithful stewardship. Planning based on reality honors God.",
        "anchor": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, session history data, aggregation pipeline",
        "consumers": "Capacity planning, session scheduling, stopping-point recognition",
        "integration": "Duration patterns reveal actual session capacity. Quality correlation identifies optimal session length. Capacity insights inform realistic planning — sustainable work blocks based on proven data.",
        "if_missing": "System plans based on aspirational capacity — likely overestimates, leading to fatigue",
        "related_data": {
            "references": {
                "durations": "Base duration category definitions (brief, short, medium, long, extended)",
                "quality-indicators": "Quality scoring for duration-quality correlation"
            },
            "referenced_by": {
                "validation-summary": "Duration patterns feed into overall validation",
                "stopping-point": "Sustainable duration informs stopping-point recognition"
            }
        }
    },

    "_M6_location": {
        "path": "tov/patterns/user/duration-learned.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "duration, session-length, capacity, user-patterns, quality-correlation, sustainability, learned, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize user duration pattern observations — actual capacity vs aspirational",
        "core_design": "Duration distribution (across base categories) + typical duration (mean/median/mode) + quality correlation (optimal range, degradation point) + capacity insights (sustainable length, maximum observed, planning recommendations).",
        "philosophy": "In all labour there is profit. Real capacity is honest — neither underselling nor overselling. Duration patterns enable planning that honors actual limits. Sustainability over ambition.",
        "key_features": {
            "duration_categories": "Distribution across base duration definitions with quality scores",
            "typical_duration": "Statistical summary — mean, median, mode category",
            "quality_correlation": "Optimal duration range and quality degradation point",
            "capacity": "Sustainable session length, maximum observed, planning recommendations"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Duration learned template — scaffold for user-specific duration aggregation",
        "planned": ["Seanje duration pattern instance", "Automated aggregation pipeline", "Quality degradation curve analysis"]
    },

    "_M10_pattern_scope": {
        "lifetime": "user",
        "description": "User-level pattern — session duration observations for a specific user.",
        "loaded_at": "Session initialization — informs capacity awareness",
        "persists": "Updated weekly or after significant pattern shifts",
        "consumed_by": "Capacity planning, session scheduling, stopping-point recognition",
        "scope": "user — specific person's observed session durations",
        "data_source": "Aggregated from session history — NOT manually created"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (pattern scope) tracks learned pattern lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, durations in minutes, percentages 0-100, quality scores 0-100",
    "_Cc_constraint": "Data aggregated from session history. NOT manually populated. Duration categories reference base definitions. Quality scores 0-100.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Duration Patterns",
    "version": "a-01.00",

    // DURATION DISTRIBUTION
    "duration_categories": {
        "note": "Distribution using base duration definitions",
        "brief": {
            "range_minutes": "< 15",
            "session_count": 0,
            "percentage": 0,
            "avg_quality_score": 0,
            "typical_context": "Quick check-ins, brief updates"
        },
        "short": {
            "range_minutes": "15-60",
            "session_count": 0,
            "percentage": 0,
            "avg_quality_score": 0,
            "typical_context": "Focused tasks, planning sessions"
        },
        "medium": {
            "range_minutes": "60-240",
            "session_count": 0,
            "percentage": 0,
            "avg_quality_score": 0,
            "typical_context": "Deep work, implementation"
        },
        "long": {
            "range_minutes": "240-480",
            "session_count": 0,
            "percentage": 0,
            "avg_quality_score": 0,
            "typical_context": "Extended work sessions"
        },
        "extended": {
            "range_minutes": "> 480",
            "session_count": 0,
            "percentage": 0,
            "avg_quality_score": 0,
            "typical_context": "Marathon sessions (assess sustainability)"
        }
    },

    "typical_duration": {
        "mean_minutes": 0,
        "median_minutes": 0,
        "mode_category": "unknown",
        "note": "Most common session length"
    },

    "quality_correlation": {
        "note": "Does duration correlate with work quality?",
        "optimal_duration_range": {
            "min_minutes": 0,
            "max_minutes": 0,
            "avg_quality_score": 0,
            "note": "Duration range with highest quality scores"
        },
        "quality_degradation_point": {
            "minutes": 0,
            "note": "When quality typically begins to decline"
        }
    },

    // CAPACITY INSIGHTS
    "capacity": {
        "sustainable_session_length": {
            "minutes": 0,
            "note": "Typical session length without fatigue"
        },
        "maximum_observed": {
            "minutes": 0,
            "date": "unknown",
            "quality_score": 0,
            "note": "Longest session recorded"
        },
        "recommended_planning": {
            "note": "For scheduling purposes",
            "typical_work_block": "unknown minutes",
            "include_breaks": true
        }
    },

    "usage": {
        "purpose": "Understand actual capacity vs aspirational expectations",
        "planning_application": "Schedule work blocks based on proven sustainable durations",
        "validation_use": "Compare against stated capacity in config"
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal sections or removed",
        "usage_guidance": "Add duration discoveries here during pattern learning"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-patterns"] },
    "_Cv_schema": {
        "required": ["name", "version", "duration_categories"],
        "optional": ["typical_duration", "quality_correlation", "capacity", "usage", "extensions"],
        "value_format": "Durations in minutes, percentages 0-100, quality scores 0-100"
    },
    "_Cv_health_scoring": { "total": 100, "accurate_duration_categorization": 40, "useful_for_capacity_planning": 35, "quality_correlation_insights": 25 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

