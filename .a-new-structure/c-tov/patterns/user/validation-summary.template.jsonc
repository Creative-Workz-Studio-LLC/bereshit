{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-patterns-user-validation-summary",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "user-patterns",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — cross-pattern validation aggregation for a user",
    "_P3_layer": "tov/patterns/user",
    "_P3_includes": "none",
    "_P3_provides": ["VALIDATION_SUMMARY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Validation Summary — Stated Identity vs Actual Patterns",
    "_P5_brief": "Template for aggregating validation results across all user pattern types. Compares stated identity (config preferences) against actual observed behavior. Enables truthful self-knowledge — not condemnation, but information for growth.",
    "_P5_usage": "cp validation-summary.template.jsonc patterns/user/<username>/validation-summary.jsonc -> populate from pattern validation results",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "validation-summary.template.jsonc",
        "key": "B-tov-patterns-user-validation-summary",
        "title": "Validation Summary — Stated Identity vs Actual Patterns",
        "type": "Data (Template)",
        "component": "Scaffold — cross-pattern validation aggregation for a user",
        "role": "Aggregate validation results for truthful self-knowledge and growth"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Search me, O God, and know my heart: try me, and know my thoughts."
    "_M4_grounding": {
        "scripture": "Psalm 139:23-24 — Search me, O God, and know my heart: try me, and know my thoughts: And see if there be any wicked way in me, and lead me in the way everlasting.",
        "principle": "Truthful self-knowledge is the foundation of growth. Validation reveals reality — not condemnation, but information. Misalignment between stated identity and actual behavior is opportunity for growth, not failure. Grace covers the gap.",
        "anchor": "2 Corinthians 13:5 — Examine yourselves, whether ye be in the faith; prove your own selves."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, pattern validation results from circadian, duration, and quality",
        "consumers": "Config updates, planning adjustments, rhythm refinements, growth tracking",
        "integration": "Validation summary aggregates across all pattern types. Compares stated config preferences against observed behavior. Identifies alignments, misalignments, and discoveries for actionable growth.",
        "if_missing": "No cross-pattern validation — each pattern type validated in isolation, losing aggregate insights",
        "related_data": {
            "references": {
                "circadian-learned": "Circadian validation results",
                "duration-learned": "Duration validation results",
                "quality-indicators": "Quality metrics for assessment"
            },
            "referenced_by": {
                "config-updates": "Validation findings may trigger config preference updates",
                "growth-tracking": "Validation trends show growth over time"
            }
        }
    },

    "_M6_location": {
        "path": "tov/patterns/user/validation-summary.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "validation, self-knowledge, stated-vs-actual, user-patterns, growth, assessment, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize cross-pattern validation — truthful self-knowledge for growth",
        "core_design": "Config identity snapshot + per-category validation results + overall assessment + insights/recommendations + truth-and-grace interpretation guidance.",
        "philosophy": "Search me, O God. Validation is not judgment — it's honest self-examination. Misalignment is opportunity, not failure. Grace covers the gap between intention and execution.",
        "key_features": {
            "stated_identity": "Snapshot of config preferences for comparison",
            "per_category": "Circadian, duration, quality validation results",
            "overall_assessment": "Aggregate self-knowledge accuracy and confidence",
            "insights": "Strengths, growth opportunities, discoveries",
            "interpretation": "Biblical framework for understanding results with grace"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Validation summary template — scaffold for user-specific cross-pattern validation",
        "planned": ["Seanje validation summary instance", "Automated validation pipeline", "Growth trend visualization"]
    },

    "_M10_pattern_scope": {
        "lifetime": "user",
        "description": "User-level pattern — cross-pattern validation aggregation for a specific user.",
        "loaded_at": "On demand — when validation assessment is requested",
        "persists": "Updated monthly or when significant pattern shifts detected",
        "consumed_by": "Config updates, planning adjustments, growth tracking",
        "scope": "user — specific person's stated-vs-actual validation",
        "data_source": "Aggregated from per-pattern validation results"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (pattern scope) tracks learned pattern lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, alignment values: unknown/aligned/misaligned/partial",
    "_Cc_constraint": "Populated from pattern validation results. Truth over comfort. Misalignment is information, not judgment.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Validation Summary",
    "version": "a-01.00",

    // CONFIG IDENTITY SNAPSHOT
    "stated_identity": {
        "source": "config/user/[username]/config.jsonc",
        "extracted_date": "2025-01-01",
        "key_preferences": {
            "work_rhythm": "unknown",
            "work_capacity": "unknown",
            "quality_preferences": "unknown"
        }
    },

    // VALIDATION RESULTS BY CATEGORY
    "circadian_validation": {
        "source": "patterns/user/[username]/circadian/validation.jsonc",
        "status": "unknown",
        "alignment": "unknown",
        "key_finding": "Awaiting validation data"
    },

    "duration_validation": {
        "source": "patterns/user/[username]/duration/validation.jsonc",
        "status": "unknown",
        "alignment": "unknown",
        "key_finding": "Awaiting validation data"
    },

    "quality_validation": {
        "note": "Quality patterns vs stated productivity preferences",
        "status": "unknown",
        "alignment": "unknown",
        "key_finding": "Awaiting validation data"
    },

    // OVERALL ASSESSMENT
    "overall_validation": {
        "self_knowledge_accuracy": "unknown",
        "major_alignments": [],
        "major_misalignments": [],
        "confidence": "low",
        "note": "Populate after validation data available"
    },

    // INSIGHTS & RECOMMENDATIONS
    "insights": {
        "strengths": {
            "note": "Areas where self-knowledge is accurate",
            "items": []
        },
        "growth_opportunities": {
            "note": "Areas where stated identity doesn't match reality",
            "items": []
        },
        "discoveries": {
            "note": "Patterns not previously recognized",
            "items": []
        }
    },

    "recommendations": {
        "config_updates": [],
        "planning_adjustments": [],
        "rhythm_refinements": [],
        "note": "Populate from validation results"
    },

    // TRUTH & GRACE
    "interpretation_guidance": {
        "biblical_foundation": "Psalm 139:23-24 — Search me, know my heart",
        "truth": "Validation reveals reality — not condemnation, but information",
        "grace": "Misalignment is opportunity for growth, not failure",
        "application": "Use insights for wise planning, sustainable rhythms, faithful work",
        "kingdom_principle": "Truth-based self-knowledge enables better stewardship"
    },

    "usage": {
        "purpose": "Aggregate view of all validation across pattern types",
        "update_frequency": "Monthly or when significant pattern shifts detected",
        "decision_support": "Inform config updates, planning adjustments, rhythm changes"
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal sections or removed",
        "usage_guidance": "Add cross-pattern validation discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-patterns"] },
    "_Cv_schema": {
        "required": ["name", "version", "stated_identity", "overall_validation"],
        "optional": ["circadian_validation", "duration_validation", "quality_validation", "insights", "recommendations", "interpretation_guidance", "usage", "extensions"],
        "value_format": "Alignment: unknown/aligned/misaligned/partial. Confidence: low/medium/high."
    },
    "_Cv_health_scoring": { "total": 100, "accurate_overall_assessment": 35, "clear_misalignment_detection": 35, "actionable_recommendations": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Soften misalignment findings to avoid discomfort (truth over comfort)"],
    "_X1_careful": ["Change interpretation guidance (affects how results are received)", "Remove historical validation results (loses trend data)"],
    "_X1_safe": ["Update validation results from pattern data", "Add new insights and recommendations", "Refine interpretation guidance"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Seanje validation summary instance", "Growth trend analysis over time", "Automated config update recommendations"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "all_unknowns": "No validation data available. Run pattern aggregation first, then validation.",
        "harsh_interpretation": "Results feel discouraging. Remember: misalignment is information, not judgment. Grace covers the gap.",
        "stale_validation": "Validation from months ago. Re-run with current data — patterns evolve."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/patterns/user/circadian-learned.template.jsonc — Circadian patterns for validation",
        "tov/patterns/user/duration-learned.template.jsonc — Duration patterns for validation",
        "tov/definitions/base/quality-indicators.template.jsonc — Quality scoring",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "stated_identity", "overall_validation"],
    "_X4_validate": "make && ./bin/tov --validate-patterns",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Cross-pattern validation summary. Stated vs actual. Truth with grace. Misalignment is opportunity, not failure. Self-knowledge enables stewardship.",
    "_X5_scripture": "Search me, O God, and know my heart. — Psalm 139:23",
    "_X5_anchor": "Truthful self-knowledge is the foundation of growth. Validation reveals reality. Grace covers the gap.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp validation-summary.template.jsonc patterns/user/<username>/validation-summary.jsonc -> populate from validation results",
    "_X6_update": [
        "_P1_key: unique identifier (e.g., B-tov-patterns-user-seanje-validation-summary)",
        "_M1_identity: file, key, title with username",
        "stated_identity: extract from user config",
        "Per-category validations: populate from pattern validation files",
        "overall_validation: aggregate assessment",
        "Remove _X6 section when instantiating"
    ],

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
