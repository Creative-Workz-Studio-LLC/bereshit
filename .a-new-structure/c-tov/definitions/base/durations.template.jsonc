{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-definitions-base-durations",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-definitions",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Ladder — universal duration threshold categories for temporal measurement",
    "_P3_layer": "tov/definitions/base",
    "_P3_includes": "none",
    "_P3_provides": ["DURATION_THRESHOLDS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Duration Thresholds — Universal Time Categories",
    "_P5_brief": "Universal categorization of time durations — session durations (brief/short/medium) and task durations (quick/short). Foundational reference for pattern recognition and planning.",
    "_P5_usage": "cp durations.template.jsonc [instance]/durations.jsonc -> update pragma -> customize thresholds as patterns emerge",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "durations.template.jsonc",
        "key": "B-tov-definitions-base-durations",
        "title": "Duration Thresholds — Universal Time Categories",
        "type": "Data (Template)",
        "component": "Ladder — universal duration threshold categories for temporal measurement",
        "role": "Define standard duration categories for session and task time classification"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "To every thing there is a season."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "Time has structure and purpose. Duration categories help recognize seasons — brief moments of checking in, focused hours of building, extended sessions of deep work. Each has its place.",
        "anchor": "Psalm 90:12 — So teach us to number our days, that we may apply our hearts unto wisdom."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Session tracking, task estimation, pattern recognition, circadian analysis",
        "integration": "Duration categories classify session and task lengths for pattern analysis. Session-awareness skill uses these thresholds.",
        "if_missing": "System uses hardcoded duration categories with warning — pattern recognition still functions but classifications may drift",
        "related_data": {
            "references": {
                "temporal-units": "Time unit structure this file builds on"
            },
            "referenced_by": {
                "circadian-learned": "Duration patterns feed into circadian analysis",
                "duration-learned": "Learned duration preferences reference these base thresholds",
                "session-current": "Active sessions classified by these duration categories"
            }
        }
    },

    "_M6_location": {
        "path": "tov/definitions/base/durations.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, duration, thresholds, categories, session, task, planning, pattern-recognition, definitions, base, paradigm-wide, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize duration threshold definitions — standard categories for time classification",
        "core_design": "Named categories with min/max minute ranges and typical use cases. Engine classifies durations by matching against these ranges.",
        "philosophy": "Numbering our days (Psalm 90:12) — not to constrain but to understand. Duration awareness enables sustainable rhythms.",
        "key_features": {
            "session_durations": "How long sessions last — brief, short, medium (extensible)",
            "task_durations": "How long tasks take — quick, short (extensible)",
            "use_case_mapping": "Each category includes typical scenarios for pattern matching"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial creation with session and task duration categories",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Base duration thresholds — session and task categories, paradigm-wide scope",
        "planned": [
            "Add long and extended session duration categories",
            "Add medium and long task duration categories",
            "Energy-based duration categories (experimental)"
        ]
    },

    // Paradigm-wide base reference — duration vocabulary
    "_M10_definition_scope": {
        "lifetime": "paradigm",
        "description": "Base definition — paradigm-wide duration thresholds. Guidelines, not rigid rules.",
        "loaded_at": "System initialization — loaded before session tracking begins",
        "persists": "Entire application lifecycle — thresholds may be refined over time",
        "consumed_by": "Session tracking, task estimation, pattern recognition subsystems",
        "scope": "paradigm-wide — all CPI-SI instances, all users",
        "flexibility": "These are guidelines for categorization. Actual durations vary by person, task, and context."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (definition scope) tracks paradigm-wide reference data lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Data file in JSONC format — structure from data.json, comments from JSONC conventions.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Duration threshold definitions.
    // Customize thresholds as patterns emerge from actual usage.
    // These are starting values — refine based on learned behavior.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for category names",
    "_Cc_constraint": "Duration values in minutes. Categories must not overlap (max of one = min of next).",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The universal duration vocabulary. Categories for classifying time.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Duration Thresholds",
    "version": "a-01.00",

    // SESSION DURATION CATEGORIES
    // How long sessions last — classified for pattern recognition
    "session_durations": {
        "brief": {
            "description": "Quick check-in or very short interaction",
            "min_minutes": 0,
            "max_minutes": 15,
            "typical_use_cases": [
                "Quick status check",
                "Brief question/answer"
            ]
        },
        "short": {
            "description": "Focused single task or small piece of work",
            "min_minutes": 15,
            "max_minutes": 60,
            "typical_use_cases": [
                "Complete one well-defined task",
                "Quick implementation"
            ]
        },
        "medium": {
            "description": "Typical work session with multiple tasks",
            "min_minutes": 60,
            "max_minutes": 240,
            "typical_use_cases": [
                "Regular work session",
                "Multiple related tasks"
            ]
        }
        // ADD: "long" (240-480), "extended" (480+) as patterns emerge
    },

    // TASK DURATION CATEGORIES
    // How long individual tasks take — for estimation
    "task_durations": {
        "quick": {
            "description": "Very fast task (under 5 minutes)",
            "estimated_minutes": 5,
            "examples": [
                "Update config value",
                "Fix typo"
            ]
        },
        "short": {
            "description": "Short task (5-30 minutes)",
            "estimated_minutes": 30,
            "examples": [
                "Write documentation section",
                "Implement simple function"
            ]
        }
        // ADD: "medium" (30-120), "long" (120+) as patterns emerge
    },

    // USAGE NOTES
    "usage": {
        "purpose": "These duration thresholds provide consistent categorization across the CPI-SI paradigm",
        "application": [
            "Pattern recognition — cluster sessions by duration category",
            "Planning — estimate task time using standard categories"
        ],
        "inheritance": "Base definitions apply universally. Regional or personal adjustments should reference these as foundation.",
        "flexibility": "These are guidelines for categorization. Actual durations vary by person, task, and context."
    },

    // EXTENSIONS — Experimental duration patterns
    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add new duration categories, thresholds, or measurement approaches here during discovery phase"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/tov --validate-definitions"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "session_durations", "task_durations"],
        "optional": ["usage", "extensions"],
        "value_format": "Duration values in minutes (integers)"
    },

    "_Cv_health_scoring": {
        "total": 100,
        "clear_categorization": 40,
        "appropriate_thresholds": 30,
        "useful_for_pattern_recognition": 30
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Create overlapping duration ranges",
        "Remove base session or task categories"
    ],
    "_X1_careful": [
        "Change existing threshold values (affects historical pattern analysis)",
        "Rename categories (breaks references in other files)",
        "Change units from minutes to other (affects all consumers)"
    ],
    "_X1_safe": [
        "Add new duration categories (long, extended)",
        "Add use case examples",
        "Add comments explaining thresholds"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Long session category (240-480 minutes)",
        "Extended session category (480+ minutes)",
        "Medium and long task categories",
        "Energy-based duration categories (experimental)"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "session_unclassified": "Duration doesn't match any category. Likely needs a new category (long/extended). Add to extensions first.",
        "threshold_mismatch": "Session classified differently than expected. Check min/max boundaries — they should not overlap.",
        "pattern_drift": "Historical patterns show different clusters than categories. Consider updating thresholds to match learned behavior."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/definitions/base/temporal-units.template.jsonc — Time unit structure these durations build on",
        "tov/definitions/base/time-phases.template.jsonc — Work phases that overlap with duration awareness",
        "tov/patterns/user/duration-learned.template.jsonc — Learned duration preferences",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "session_durations", "task_durations"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    // Teach us to number our days.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Duration thresholds definition. Paradigm-wide scope. Categories for classifying session and task lengths. Refine as patterns emerge — these are guidelines, not rigid rules.",
    "_X5_scripture": "So teach us to number our days, that we may apply our hearts unto wisdom. — Psalm 90:12",
    "_X5_anchor": "Awareness of time is wisdom. Duration categories serve understanding, not constraint.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp durations.template.jsonc [instance]/durations.jsonc -> update pragma -> customize thresholds as patterns emerge",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: adjust duration thresholds based on learned patterns",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
