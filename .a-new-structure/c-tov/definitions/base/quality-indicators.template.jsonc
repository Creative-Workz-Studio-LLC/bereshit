{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-definitions-base-quality-indicators",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-definitions",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Ladder — universal quality metrics for session and work measurement",
    "_P3_layer": "tov/definitions/base",
    "_P3_includes": "none",
    "_P3_provides": ["QUALITY_INDICATORS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Quality Indicators — Universal Work Metrics",
    "_P5_brief": "Universal metrics for measuring session and work quality — stopping reasons, health score ranges (Base100 system), session quality factors. Feeds into health scoring. Grace-centered: metrics serve understanding, not condemnation.",
    "_P5_usage": "cp quality-indicators.template.jsonc [instance]/quality-indicators.jsonc -> update pragma -> define stopping reasons and health ranges",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "quality-indicators.template.jsonc",
        "key": "B-tov-definitions-base-quality-indicators",
        "title": "Quality Indicators — Universal Work Metrics",
        "type": "Data (Template)",
        "component": "Ladder — universal quality metrics for session and work measurement",
        "role": "Define quality measurement vocabulary for health scoring and pattern analysis"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "A just man falleth seven times, and riseth up again."
    "_M4_grounding": {
        "scripture": "Proverbs 24:16 — For a just man falleth seven times, and riseth up again: but the wicked shall fall into mischief.",
        "principle": "Quality metrics serve grace, not condemnation. Missing the mark (chata) is finite reality. Fatigue should be honored, not pushed through. Rest is commanded, not optional.",
        "anchor": "Lamentations 3:22-23 — His compassions fail not. They are new every morning: great is thy faithfulness."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Health scoring system, session tracking, pattern recognition, reflect-on-session skill",
        "integration": "Quality indicators feed into Base100 health scoring system (-100 to +100). Stopping reasons classify why sessions end. Health ranges interpret scores.",
        "if_missing": "System uses hardcoded quality categories with warning — health scoring still functions but classifications may be less nuanced",
        "related_data": {
            "references": {
                "temporal-units": "Time unit structure for measurement",
                "durations": "Duration thresholds for session classification"
            },
            "referenced_by": {
                "session-current": "Active session quality tracked against these indicators",
                "validation-summary": "Pattern validation uses these quality ranges",
                "reflect-on-session": "Session reflection evaluates quality against these metrics"
            }
        }
    },

    "_M6_location": {
        "path": "tov/definitions/base/quality-indicators.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "quality, health-scoring, base100, stopping-reasons, metrics, session, definitions, base, paradigm-wide, grace, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize quality measurement definitions — one source of truth for health scoring vocabulary",
        "core_design": "Three measurement domains: stopping reasons (why sessions end), health score ranges (how to interpret scores), session quality factors (what makes work good or poor).",
        "philosophy": "Metrics serve understanding, not condemnation. Grace-centered measurement — missing the mark is finite reality, not failure. Rest is faithful work.",
        "key_features": {
            "stopping_reasons": "Why sessions end — natural completion, fatigue, sabbath, etc.",
            "health_score_ranges": "Base100 interpretation — excellent, good, etc. (-100 to +100)",
            "session_quality_factors": "What constitutes good session quality — task completion, focus, etc."
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial creation with stopping reasons and health ranges",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Base quality indicators — stopping reasons, health ranges, quality factors",
        "planned": [
            "Complete health score range coverage (-100 to +100)",
            "Add blocked, interrupted, context_switch stopping reasons",
            "Add focus_quality, work_rest_balance, satisfaction quality factors",
            "Align health ranges with Hebrew states (shavar through tov)"
        ]
    },

    // Paradigm-wide base reference — quality vocabulary
    "_M10_definition_scope": {
        "lifetime": "paradigm",
        "description": "Base definition — paradigm-wide quality metrics. Grace-centered measurement.",
        "loaded_at": "System initialization — loaded before health scoring begins",
        "persists": "Entire application lifecycle — categories may expand over time",
        "consumed_by": "Health scoring system, session tracking, pattern recognition, reflection skills",
        "scope": "paradigm-wide — all CPI-SI instances, all users",
        "scoring_system": "Base100 (-100 to +100)"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (definition scope) tracks paradigm-wide reference data lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Data file in JSONC format — structure from data.json, comments from JSONC conventions.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Quality measurement definitions.
    // Grace-centered: metrics serve understanding, not condemnation.
    // Missing the mark (chata) is finite reality — not failure.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for category names",
    "_Cc_constraint": "Health scores use Base100 system (-100 to +100). Quality indicators must be positive, neutral, or attention — never punitive.",
    "_Cc_scoring_system": "Base100 (-100 to +100)",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The universal quality vocabulary. Measurement serving grace.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Quality Indicators",
    "version": "a-01.00",

    // STOPPING REASON CATEGORIES
    // Why sessions end — for pattern recognition, not judgment
    "stopping_reasons": {
        "natural_completion": {
            "description": "Work reached natural completion point",
            "quality_indicator": "positive",
            "examples": [
                "Task completed successfully",
                "Milestone reached"
            ],
            "health_impact": "Suggests good task scoping and completion satisfaction"
        },
        "fatigue": {
            "description": "Stopped due to tiredness or need for rest",
            "quality_indicator": "attention",
            "examples": [
                "Mental fatigue",
                "Need for sleep"
            ],
            "health_impact": "Important to honor — rest is faithful work"
        },
        "sabbath": {
            "description": "Intentional rest — honoring biblical sabbath principle",
            "quality_indicator": "positive",
            "examples": [
                "Weekly day of rest",
                "Honoring God's rhythm"
            ],
            "health_impact": "Essential for sustainable Kingdom work — not optional"
        }
        // ADD: blocked, interrupted, context_switch, external_obligation, etc.
    },

    // HEALTH SCORE RANGES
    // Base100 system (-100 to +100)
    "health_score_ranges": {
        "excellent": {
            "min": 80,
            "max": 100,
            "emoji": "crown",
            "description": "Exceptional execution — working as designed",
            "interpretation": "System/session performing excellently. Sustainable at this level."
        },
        "good": {
            "min": 60,
            "max": 79,
            "emoji": "checkmark",
            "description": "Good execution with minor room for improvement",
            "interpretation": "Solid performance. Small optimizations possible but not urgent."
        }
        // ADD: acceptable (40-59), concerning (20-39), poor (0-19), negative ranges
        // REQUIRED: Cover full -100 to +100 range
    },

    // SESSION QUALITY METRICS
    // What makes a session "good" or "poor"?
    "session_quality_factors": {
        "task_completion": {
            "description": "Did planned work get completed?",
            "measurement": "Percentage of planned tasks completed",
            "high_quality": "80-100% of planned tasks completed",
            "notes": "Consider stopping reason — blocked/interrupted vs poor planning"
        }
        // ADD: focus_quality, work_rest_balance, satisfaction, etc.
    },

    // USAGE NOTES
    "usage": {
        "purpose": "Provide consistent quality measurement across CPI-SI paradigm",
        "health_scoring_integration": "These indicators feed into Base100 health scoring system",
        "grace_and_truth": "Metrics serve understanding, not condemnation. Missing the mark (chata) is finite reality.",
        "biblical_foundation": "Rest is not weakness — sabbath is commanded. Fatigue should be honored, not pushed through."
    },

    // EXTENSIONS — Experimental quality metrics
    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add new quality metrics, stopping reasons, productivity indicators, or health patterns here during discovery phase"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/tov --validate-definitions"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "stopping_reasons", "health_score_ranges"],
        "optional": ["session_quality_factors", "usage", "extensions"],
        "value_format": "Health scores are integers in Base100 range (-100 to +100)"
    },

    "_Cv_health_scoring": {
        "total": 100,
        "comprehensive_categories": 30,
        "alignment_with_health_scoring": 40,
        "useful_for_pattern_recognition": 30
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Use punitive quality indicators (shame, failure, etc.)",
        "Remove sabbath as a stopping reason"
    ],
    "_X1_careful": [
        "Change health score range boundaries (affects historical analysis)",
        "Rename stopping reasons (breaks references in session data)",
        "Remove quality indicators (may lose pattern data)"
    ],
    "_X1_safe": [
        "Add new stopping reasons (blocked, interrupted, etc.)",
        "Add new health score ranges (cover full -100 to +100)",
        "Add new session quality factors"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Complete health score ranges covering -100 to +100",
        "Additional stopping reasons (blocked, interrupted, context_switch, external_obligation)",
        "Additional quality factors (focus_quality, work_rest_balance, satisfaction)",
        "Hebrew state alignment (shavar=-1.0 through tov=+1.0 mapped to Base100)"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "no_matching_stopping_reason": "Session ended for a reason not in the list. Add as new stopping reason to extensions first, then promote if recurring.",
        "health_score_unranged": "Score falls outside defined ranges. Likely need to complete the range coverage (-100 to +100).",
        "punitive_framing": "If quality metrics feel condemning, reframe. Grace-centered: missing the mark is finite reality. The metric serves understanding."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/definitions/base/durations.template.jsonc — Duration categories for session classification",
        "tov/definitions/base/time-phases.template.jsonc — Work phases for quality context",
        "tov/patterns/user/validation-summary.template.jsonc — Pattern validation using these quality ranges",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "stopping_reasons", "health_score_ranges"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    // Grace covers the gap.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Quality indicators definition. Base100 health scoring. Grace-centered measurement — missing the mark is reality, not failure. Rest is commanded. Metrics serve understanding.",
    "_X5_scripture": "A just man falleth seven times, and riseth up again. — Proverbs 24:16",
    "_X5_anchor": "Quality measurement in Kingdom context serves growth, not condemnation. Grace is the foundation.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp quality-indicators.template.jsonc [instance]/quality-indicators.jsonc -> update pragma -> define stopping reasons and health ranges",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: expand stopping reasons, complete health score ranges, add quality factors",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
