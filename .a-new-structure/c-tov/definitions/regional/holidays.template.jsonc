{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-definitions-regional-holidays",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "regional-definitions",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — holiday definitions for a specific country/region",
    "_P3_layer": "tov/definitions/regional",
    "_P3_includes": "none",
    "_P3_provides": ["HOLIDAYS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Holidays — Regional Holiday Definitions",
    "_P5_brief": "Template for defining holidays in a specific country/region. Fixed-date federal holidays, calculated-date holidays, and cultural observances. Used for scheduling awareness and cultural context.",
    "_P5_usage": "cp holidays.template.jsonc regional/<continent>/<country>/holidays.jsonc -> update pragma -> define federal, calculated, and cultural holidays",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "holidays.template.jsonc",
        "key": "B-tov-definitions-regional-holidays",
        "title": "Holidays — Regional Holiday Definitions",
        "type": "Data (Template)",
        "component": "Scaffold — holiday definitions for a specific country/region",
        "role": "Define holiday schedule for scheduling awareness and cultural context"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And God said, Let there be lights... for signs, and for seasons."
    "_M4_grounding": {
        "scripture": "Genesis 1:14 — And God said, Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons, and for days, and years.",
        "principle": "God appointed seasons and times. Holidays mark cultural and spiritual rhythms — rest, remembrance, celebration. Awareness of these seasons enables faithful planning.",
        "anchor": "Leviticus 23:2 — The feasts of the LORD, which ye shall proclaim to be holy convocations, even these are my feasts."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Scheduling system, session planning, availability tracking",
        "integration": "Holiday awareness prevents scheduling during closures. Cultural holidays provide context for availability patterns.",
        "if_missing": "System has no holiday awareness — may schedule during closures or miss cultural context",
        "related_data": {
            "references": {
                "temporal-units": "Date format standards for holiday dates"
            },
            "referenced_by": {
                "work-patterns": "Work patterns adjust around holidays",
                "session-planning": "Sessions may be shorter or absent during holidays"
            }
        }
    },

    "_M6_location": {
        "path": "tov/definitions/regional/holidays.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "holidays, federal, cultural, regional, scheduling, calendar, definitions, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize holiday definitions for a specific region — scheduling and cultural awareness",
        "core_design": "Three holiday categories: fixed-date federal, calculated-date federal, and cultural. Each with significance and observance level.",
        "philosophy": "God appointed seasons. Cultural holidays mark collective rhythms. Awareness enables faithful stewardship of time.",
        "key_features": {
            "federal_fixed": "Holidays on same date every year (New Year's, Independence Day)",
            "federal_calculated": "Holidays with variable dates (first Monday in May, etc.)",
            "cultural": "Widely celebrated but not official closures"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Holiday template — scaffold for region-specific instantiation",
        "planned": [
            "US holidays instance (first instantiation)",
            "Biblical feast day overlay",
            "Multi-year date calculation support"
        ]
    },

    "_M10_definition_scope": {
        "lifetime": "regional",
        "description": "Regional definition — holiday schedule for a specific country/region.",
        "loaded_at": "System initialization — loaded for the user's configured region",
        "persists": "Entire application lifecycle — updated annually for calculated dates",
        "consumed_by": "Scheduling system, availability tracking, session planning",
        "scope": "regional — specific country/region, not paradigm-wide"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (definition scope) tracks regional reference data lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for holiday identifiers",
    "_Cc_constraint": "Dates use MM-DD format for fixed, calculation rules for variable. Federal holidays typically mean government offices closed.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Country/Region Holidays",
    "version": "a-01.00",

    // FEDERAL/NATIONAL HOLIDAYS — Fixed dates
    "federal_holidays_fixed": {
        "new_years_day": {
            "name": "New Year's Day",
            "date": "January 1",
            "date_pattern": "MM-DD",
            "fixed_value": "01-01",
            "type": "federal",
            "significance": "Beginning of calendar year",
            "observance": "Widely observed — most businesses closed",
            "observed_rule": "If falls on Saturday, observed Friday. If Sunday, observed Monday."
        }
        // ADD: Other fixed-date holidays for this country/region
    },

    // FEDERAL/NATIONAL HOLIDAYS — Calculated dates
    "federal_holidays_calculated": {
        "example_holiday": {
            "name": "Example Holiday",
            "calculation": "First Monday in May",
            "month": 5,
            "week": "first",
            "day_of_week": "Monday",
            "type": "federal",
            "significance": "Description of what this holiday commemorates",
            "observance": "How widely observed"
        }
        // ADD: Other calculated holidays for this country/region
    },

    // MAJOR CULTURAL HOLIDAYS — Non-federal
    "cultural_holidays": {
        "example_cultural": {
            "name": "Cultural Holiday Name",
            "date": "Month Day",
            "date_pattern": "MM-DD",
            "fixed_value": "MM-DD",
            "type": "cultural",
            "significance": "What this celebrates",
            "observance": "Not a day off, but widely celebrated"
        }
        // ADD: Other cultural holidays for this country/region
    },

    // USAGE NOTES
    "usage": {
        "purpose": "Provide awareness of holiday schedule for planning and cultural context",
        "expectation_setting": "Federal holidays typically mean reduced availability, difficulty scheduling meetings",
        "individual_variation": "Not everyone observes all holidays — cultural/religious holidays vary by person",
        "planning_use": "Consider holidays when scheduling work, setting deadlines, expecting responses"
    },

    // EXTENSIONS
    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add new holidays, regional observances, or cultural celebrations here during discovery phase"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": ["make", "./bin/tov --validate-definitions"]
    },

    "_Cv_schema": {
        "required": ["name", "version", "federal_holidays_fixed"],
        "optional": ["federal_holidays_calculated", "cultural_holidays", "usage", "extensions"],
        "value_format": "Fixed dates use MM-DD format. Calculated dates specify month, week, day_of_week."
    },

    "_Cv_health_scoring": {
        "total": 100,
        "complete_federal_holidays": 30,
        "relevant_cultural_holidays": 35,
        "accurate_date_calculations": 35
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove federal holidays without verification"],
    "_X1_careful": ["Change holiday dates (verify against official sources)", "Remove cultural holidays (may lose cultural context)"],
    "_X1_safe": ["Add new holidays", "Update observance descriptions", "Add calculated date rules"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["US holidays instance", "Biblical feast day overlay", "Multi-year date calculation support"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "wrong_observed_date": "Observed date differs from actual date (weekend rule). Check observed_rule field.",
        "missing_holiday": "Regional holiday not in list. Add to cultural_holidays or federal depending on type.",
        "calculated_date_wrong": "Variable-date holiday on wrong day. Verify calculation rule against official sources."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/definitions/base/temporal-units.template.jsonc — Date format standards",
        "tov/definitions/regional/work-patterns.template.jsonc — Work patterns adjust around holidays",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "federal_holidays_fixed"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Regional holiday definitions. Scheduling awareness and cultural context. Federal = closures, cultural = widely celebrated. Update annually for calculated dates.",
    "_X5_scripture": "Let there be lights in the firmament... for signs, and for seasons. — Genesis 1:14",
    "_X5_anchor": "God appointed seasons. Holidays mark collective rhythms of rest and remembrance.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp holidays.template.jsonc regional/<continent>/<country>/holidays.jsonc -> update pragma -> define holidays",
    "_X6_update": [
        "_P1_key: unique identifier (e.g., B-tov-definitions-regional-us-holidays)",
        "_M1_identity: file, key, title with country/region name",
        "_M2_state: created/updated dates",
        "_M6_location: path to instantiated file",
        "Co section: replace example holidays with actual federal, calculated, and cultural holidays",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
