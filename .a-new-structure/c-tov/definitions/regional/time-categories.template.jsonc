        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "time-of-day, morning, afternoon, evening, night, circadian, regional, definitions, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize time-of-day category definitions — standard boundaries for a region",
        "core_design": "Fixed-hour categories with start/end times, characteristics, and typical activities. Simple, predictable, consistent across seasons.",
        "philosophy": "God divided day from night. We refine with morning, afternoon, evening. Fixed hours honor consistency — celestial anchoring can be added for seasons.",
        "key_features": {
            "fixed_hour": "Boundaries defined by clock hours (recommended — simple and consistent)",
            "celestial_optional": "Can be extended with sunrise/sunset-based boundaries for seasonal awareness",
            "characteristics": "Each category includes typical activities and energy levels"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template with morning and afternoon categories",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Time categories template — scaffold for region-specific instantiation",
        "planned": ["US Central time categories instance", "Evening and night categories", "Celestial-anchored seasonal variation"]
    },

    "_M10_definition_scope": {
        "lifetime": "regional",
        "description": "Regional definition — time-of-day boundaries for a specific timezone.",
        "loaded_at": "System initialization — loaded for user's configured region",
        "persists": "Entire application lifecycle",
        "consumed_by": "Session-awareness skill, circadian tracking, time classification",
        "scope": "regional — specific timezone area"
    },

