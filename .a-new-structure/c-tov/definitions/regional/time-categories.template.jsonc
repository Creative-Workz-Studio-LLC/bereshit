    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Time Categories — Regional Time-of-Day Definitions",
    "_P5_brief": "Template for defining time-of-day categories (morning, afternoon, evening, night) for a specific timezone. Fixed-hour approach recommended. Provides context for circadian awareness and session classification.",
    "_P5_usage": "cp time-categories.template.jsonc regional/<continent>/<country>/<region>/time-categories.jsonc -> define time boundaries",

