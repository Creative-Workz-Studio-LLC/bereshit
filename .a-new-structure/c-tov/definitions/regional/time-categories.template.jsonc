    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for category names",
    "_Cc_constraint": "Times in HH:MM 24-hour format. Categories must cover full 24-hour cycle without gaps or overlaps.",
    "_Cc_approach": "fixed_hour recommended — simple, predictable, consistent across seasons",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Region Time Categories",
    "version": "a-01.00",

    // CATEGORIZATION APPROACH
    "approach": {
        "recommendation": "fixed_hour",
        "rationale": "Simple, predictable, consistent across seasons"
    },

    // FIXED-HOUR CATEGORIES
    "fixed_hour_categories": {
        "morning": {
            "name": "Morning",
            "description": "Standard morning work hours",
            "start_time": "08:00",
            "end_time": "12:00",
            "characteristics": ["Start of typical work day", "High alertness for many"],
            "typical_activities": ["Deep work", "Important meetings"]
        },
        "afternoon": {
            "name": "Afternoon",
            "description": "Post-lunch through late work hours",
            "start_time": "12:00",
            "end_time": "17:00",
            "characteristics": ["Midday energy for some", "Active collaboration hours"],
            "typical_activities": ["Continued project work", "Meetings and collaboration"]
        }
        // ADD: evening (17:00-21:00), night (21:00-08:00), or more granular
    },

    "usage": {
        "purpose": "Provide consistent time-of-day categorization for this timezone",
        "recommendation": "Use fixed-hour categories for general purposes",
        "config_integration": "User configs may state preferences ('works better at night'). These categories provide standard definitions.",
        "flexibility": "Categories are tools for understanding, not rigid rules."
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add alternative time categorization approaches, refined boundaries, or seasonal adjustments here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-definitions"] },
    "_Cv_schema": {
        "required": ["name", "version", "approach", "fixed_hour_categories"],
        "optional": ["usage", "extensions"],
        "value_format": "Times in HH:MM 24-hour format"
    },
    "_Cv_health_scoring": { "total": 100, "clear_category_definitions": 30, "practical_usability": 35, "celestial_integration": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

