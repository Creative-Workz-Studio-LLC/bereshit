    // "And God called the light Day, and the darkness he called Night."
    "_M4_grounding": {
        "scripture": "Genesis 1:5 — And God called the light Day, and the darkness he called Night. And the evening and the morning were the first day.",
        "principle": "God divided day from night — the original time categories. Morning, afternoon, evening, night are human refinements of this divine division. Fixed hours provide consistency.",
        "anchor": "Psalm 113:3 — From the rising of the sun unto the going down of the same the LORD's name is to be praised."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Session-awareness skill, circadian tracking, time-of-day classification",
        "integration": "Time categories classify current time for circadian-aware messages and session context. Session hooks use these to determine 'morning session' vs 'evening session'.",
        "if_missing": "System uses generic morning/afternoon/evening/night with hardcoded boundaries",
        "related_data": {
            "references": {
                "timezone-rules": "Timezone determines what clock hour it is locally"
            },
            "referenced_by": {
                "circadian-learned": "Circadian patterns map productivity to these time categories",
                "session-awareness": "Current time category provided in session context"
            }
        }
    },

