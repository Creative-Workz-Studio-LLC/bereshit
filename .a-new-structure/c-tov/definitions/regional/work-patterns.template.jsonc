    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO day numbers for days",
    "_Cc_constraint": "Cultural norms, not universal rules. Individual patterns in patterns layer override. Times in HH:MM 24-hour format.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Region Work Patterns",
    "version": "a-01.00",

    // STANDARD WORK WEEK
    "standard_work_week": {
        "pattern": "Monday through Friday",
        "days": {
            "monday": {
                "iso_day": 1,
                "typical_status": "work_day",
                "typical_start": "09:00",
                "typical_end": "17:00",
                "characteristics": ["Week begins", "Planning and coordination common"]
            },
            "friday": {
                "iso_day": 5,
                "typical_status": "work_day",
                "typical_start": "09:00",
                "typical_end": "17:00",
                "characteristics": ["Week completion", "Wrap-up and planning"]
            },
            "saturday": {
                "iso_day": 6,
                "typical_status": "weekend",
                "typical_work": "Minimal — most have off"
            },
            "sunday": {
                "iso_day": 7,
                "typical_status": "weekend",
                "typical_work": "Minimal — most have off"
            }
            // ADD: Tuesday, Wednesday, Thursday following Monday pattern
        },
        "total_hours": "40 hours typical"
    },

    // COMMON WORK SCHEDULES
    "common_schedules": {
        "standard_9to5": {
            "name": "Standard 9-to-5",
            "start": "09:00",
            "end": "17:00",
            "lunch": "12:00-13:00 (1 hour)",
            "work_hours": 8,
            "characteristics": "Traditional office schedule"
        }
        // ADD: early, late, shift work, remote/flexible schedules
    },

    "usage": {
        "purpose": "Provide cultural context for work patterns in this region",
        "expectation_setting": "When someone says 'work hours' in this region, these patterns provide context",
        "flexibility_emphasis": "These are guidelines for understanding, not rigid rules to follow"
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add emerging work patterns, new schedule types, or cultural shifts here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-definitions"] },
    "_Cv_schema": {
        "required": ["name", "version", "standard_work_week"],
        "optional": ["common_schedules", "usage", "extensions"],
        "value_format": "Times in HH:MM 24-hour format, ISO day numbers"
    },
    "_Cv_health_scoring": { "total": 100, "accurate_cultural_norms": 35, "useful_for_expectation_setting": 35, "flexibility_acknowledgment": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

