    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "pattern_mismatch": "Individual work pattern differs from regional norm. This is expected — use personal patterns layer.",
        "missing_days": "Tuesday-Thursday not defined yet. Follow Monday pattern to add them.",
        "rigid_interpretation": "Work patterns are context, not rules. If treating as constraints, reframe as guidelines."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "tov/definitions/base/temporal-units.template.jsonc — ISO day numbers",
        "tov/definitions/base/time-phases.template.jsonc — Work phases",
        "tov/definitions/regional/holidays.template.jsonc — Holidays adjust patterns",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "standard_work_week"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Regional work pattern norms. Cultural context, not universal rules. Individual patterns override. Six days of labor, one of rest.",
    "_X5_scripture": "Six days shalt thou labour, and do all thy work. — Exodus 20:9",
    "_X5_anchor": "God established work-rest rhythm. Regional norms express cultural form of created order.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp work-patterns.template.jsonc regional/<continent>/<country>/<region>/work-patterns.jsonc -> define work week",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title with region name",
        "standard_work_week: complete all 7 days, set typical hours and status",
        "common_schedules: add schedules typical for this region",
        "Remove _X6 section when instantiating"
    ],

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
