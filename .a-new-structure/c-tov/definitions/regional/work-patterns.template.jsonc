    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Present cultural norms as universal rules"],
    "_X1_careful": ["Change typical hours (affects expectation setting)", "Remove weekend days (cultural sensitivity)"],
    "_X1_safe": ["Add work days (Tuesday-Thursday)", "Add schedule types", "Add cultural notes"],

