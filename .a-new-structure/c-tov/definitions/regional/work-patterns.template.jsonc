    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — typical work patterns for a specific region/culture",
    "_P3_layer": "tov/definitions/regional",
    "_P3_includes": "none",
    "_P3_provides": ["WORK_PATTERNS_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Work Patterns — Regional Work Schedule Norms",
    "_P5_brief": "Template for defining typical work patterns in a specific region/culture. Standard work week, common schedules, cultural norms. Guidelines for expectation setting, not rigid rules.",
    "_P5_usage": "cp work-patterns.template.jsonc regional/<continent>/<country>/<region>/work-patterns.jsonc -> update pragma -> define work week and schedules",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "work-patterns.template.jsonc",
        "key": "B-tov-definitions-regional-work-patterns",
        "title": "Work Patterns — Regional Work Schedule Norms",
        "type": "Data (Template)",
        "component": "Scaffold — typical work patterns for a specific region/culture",
        "role": "Define cultural work norms for expectation setting and scheduling context"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    "_M4_grounding": {
        "scripture": "Exodus 20:9-10 — Six days shalt thou labour, and do all thy work: But the seventh day is the sabbath of the LORD thy God.",
        "principle": "God established a work-rest rhythm. Cultural work patterns reflect this created order — six days of labor, one day of rest. Regional norms are guidelines, not commands.",
        "anchor": "Proverbs 14:23 — In all labour there is profit: but the talk of the lips tendeth only to penury."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Session planning, availability estimation, scheduling",
        "integration": "Work patterns provide cultural context — when 'work hours' means in this region. Individual patterns in the patterns layer override these defaults.",
        "if_missing": "System has no regional work context — defaults to generic 9-5 assumption",
        "related_data": {
            "references": {
                "temporal-units": "ISO day numbers for day-of-week mapping",
                "holidays": "Work patterns adjust around holidays"
            },
            "referenced_by": {
                "circadian-learned": "Individual circadian patterns may differ from regional norms",
                "work-style-learned": "Personal work style overrides regional defaults"
            }
        }
    },

    "_M6_location": {
        "path": "tov/definitions/regional/work-patterns.template.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "work-patterns, schedule, work-week, cultural-norms, regional, definitions, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize regional work pattern definitions — cultural context for scheduling",
        "core_design": "Standard work week structure + common schedules. Each day includes typical status, hours, and characteristics.",
        "philosophy": "Six days of labor, one of rest. Regional norms reflect cultural expression of created rhythm. Individual patterns override.",
        "key_features": {
            "work_week": "Day-by-day breakdown with typical status and hours",
            "common_schedules": "Standard schedules in this region (9-5, shift work, etc.)",
            "cultural_context": "Not rules but expectations for understanding"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template with US-style work week",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Work patterns template — scaffold for region-specific instantiation",
        "planned": ["US work patterns instance", "Remote work schedule patterns", "Flexible schedule patterns"]
    },

    "_M10_definition_scope": {
        "lifetime": "regional",
        "description": "Regional definition — work schedule norms for a specific culture/region.",
        "loaded_at": "System initialization — loaded for user's configured region",
        "persists": "Entire application lifecycle",
        "consumed_by": "Session planning, availability estimation, scheduling",
        "scope": "regional — cultural norms, not universal rules. Individual patterns override."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific.",
