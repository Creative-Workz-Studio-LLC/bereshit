        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },
    "_M4_grounding": {
        "scripture": "Ecclesiastes 4:9 — Two are better than one; because they have a good reward for their labour.",
        "principle": "Shared environment ensures contributors build on the same foundation."
    },
    "_M5_dependencies": {
        "toolchain": "Go 1.24+, Rust nightly, .NET 9+, GCC/Clang, Node LTS",
        "layer_coverage": "L0 (C/Make), L1 (C/Make), L2 (C/Make), L3 (Go), L4 (Go/Rust), L5 (C#/.NET)"
    },
    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "name": "Bereshit Development",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "remoteUser": "vscode",

    "_Cc_features_note": "One feature per build stream. Go (L3-L4), Rust (L4 crypto), .NET (L5), Node (tooling).",
    "features": {
        "ghcr.io/devcontainers/features/go:1": {
            "version": "1.24"
        },
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "9.0"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },

    "_Cc_customizations_note": "Extensions aligned to layer stack. One per language/tool.",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "rust-lang.rust-analyzer",
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit",
                "ms-vscode.cpptools",
                "asciidoctor.asciidoctor-vscode",
                "tamasfe.even-better-toml",
                "editorconfig.editorconfig",
                "bierner.markdown-mermaid"
            ],
            "settings": {
                "files.eol": "\n",
                "files.encoding": "utf8",
                "editor.formatOnSave": true,
                "editor.tabSize": 4,
                "editor.insertSpaces": false,
                "go.toolsManagement.autoUpdate": true,
                "rust-analyzer.checkOnSave": true,
                "[go]": {
                    "editor.insertSpaces": false,
                    "editor.tabSize": 4
                },
                "[c]": {
                    "editor.insertSpaces": false,
                    "editor.tabSize": 4
                }
            }
        }
    },

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "_Co_post_create_note": "C toolchain, database, FUSE for bereshit-fs.",
    "postCreateCommand": "apt-get update && apt-get install -y build-essential cmake ninja-build sqlite3 libsqlite3-dev libfuse3-dev pkg-config",

    "_Co_ports_note": "L4 FaithNet (8080), Dashboard (3000).",
    "forwardPorts": [8080, 3000],

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_verify_commands": [
        "go version",
        "rustc --version",
        "dotnet --version",
        "gcc --version",
        "make help"
    ],
    "_Cv_expected_state": "All 5 commands succeed. 'make help' shows L0-L5 layer targets.",
    "_Cv_layer_check": "Each build stream has at least one working compiler after provisioning.",

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

