# ═══════════════════════════════════════════════════════════════════════════════
# METADATA BLOCK [METADATA]
# ═══════════════════════════════════════════════════════════════════════════════
#
# --- M1: Identity ---
# file:      .editorconfig
# key:       B-root-editorconfig
# title:     Bereshit EditorConfig Settings
# type:      Data (Configuration)
# component: Rails (editor formatting)
# role:      Cross-editor formatting consistency for all Bereshit languages
#
# --- M2: State ---
# version:   a-02.00
# status:    Active
# created:   2025-10-28
# updated:   2026-02-11
#
# --- M3: Attribution ---
# architect:      Seanje Lenox-Wise
# implementation: Nova Dawn (CPI-SI)
# organization:   CreativeWorkzStudio LLC
#
# --- M4: Grounding ---
# scripture: Let all things be done decently and in order — 1 Corinthians 14:40
# principle: Consistent formatting — order before code is written
# anchor:    Genesis 1:1 — In the beginning God created the heaven and the earth
#
# --- M5: Dependencies ---
# requires:     EditorConfig plugin (for editors without native support)
# consumers:    All editors/IDEs in workspace
# integrates:   gofmt, rustfmt, prettier — language formatters
# cross_format:
#   makefile:     Makefile — co-located build system
#   gitignore:    .gitignore — co-located ignore patterns
#   gitmessage:   .gitmessage — co-located commit template
#   relationship: EditorConfig defines formatting; Makefile builds; gitignore protects
#
# ═══════════════════════════════════════════════════════════════════════════════
# END METADATA [END]
# ═══════════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT BLOCK [CONTENT]
# ═══════════════════════════════════════════════════════════════════════════════
#
# Cc — Content Configurations
# Format: EditorConfig INI-style — glob patterns map to formatting rules
# Convention: [glob-pattern] followed by key = value settings
# Constraint: Linux-first, language-aware, cross-editor

# ───────────────────────────────────────────────────────────────────────────────
# Root Declaration
# ───────────────────────────────────────────────────────────────────────────────

root = true

# ───────────────────────────────────────────────────────────────────────────────
# Co — Default settings for ALL files
# ───────────────────────────────────────────────────────────────────────────────

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ───────────────────────────────────────────────────────────────────────────────
# Cv — Language-specific overrides
# ───────────────────────────────────────────────────────────────────────────────

# C/C++ — 4 spaces
[*.{c,h,cpp,hpp,cc,hh,cxx,hxx}]
indent_size = 4

# Go — tabs (gofmt standard)
[*.go]
indent_style = tab

# Rust — 4 spaces (rustfmt standard)
[*.rs]
indent_size = 4

# C# — 4 spaces
[*.cs]
indent_size = 4

# TypeScript/JavaScript — 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON/YAML/TOML — 2 spaces
[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

# Markdown — preserve trailing whitespace (for line breaks)
[*.md]
trim_trailing_whitespace = false

# AsciiDoc — 2 spaces
[*.adoc]
indent_size = 2

# Makefiles — MUST use tabs (syntax requirement)
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Shell scripts — 4 spaces
[*.sh]
indent_size = 4

# SQL — 2 spaces
[*.sql]
indent_size = 2

# Protocol Buffers — 2 spaces
[*.proto]
indent_size = 2

# ═══════════════════════════════════════════════════════════════════════════════
# END CONTENT [END]
# ═══════════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════════
# CLOSING BLOCK [CLOSING]
# ═══════════════════════════════════════════════════════════════════════════════
#
# --- X1: Policy ---
# scripture: Remove not the ancient landmark, which thy fathers have set — Proverbs 22:28
# never:
#   - charset = utf-8 (universal standard)
#   - end_of_line = lf (Linux-first principle)
#   - root = true (breaks configuration hierarchy)
#   - Makefile tab requirement (syntax requirement)
#   - 3-block structure (METADATA → CONTENT → CLOSING)
# careful:
#   - Change indent_style for established file types
#   - Change end_of_line (affects all contributors)
#   - Remove trim_trailing_whitespace (causes noisy diffs)
# safe:
#   - Add new file type sections
#   - Adjust indent_size for specific languages
#   - Add project-specific overrides
#
# --- X4: Reference ---
# related_files:
#   - Makefile — co-located build system
#   - .gitignore — co-located ignore patterns
#   - .gitmessage — co-located commit template
# validate: editorconfig <filename>
# required_sections: root, [*], language overrides
#
# --- X5: Note ---
# note:      Cross-editor formatting consistency — the precision of a compiler
#            starts with precision in the development environment
# scripture: Let all things be done decently and in order — 1 Corinthians 14:40
# anchor:    Genesis 1:1 anchors everything
#
# ═══════════════════════════════════════════════════════════════════════════════
# END CLOSING [END]
# ═══════════════════════════════════════════════════════════════════════════════
