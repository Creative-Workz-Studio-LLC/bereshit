{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-celestial-solar-monthly",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "celestial-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — monthly solar position and daylight data for temporal awareness",
    "_P3_layer": "data/L0/celestial",
    "_P3_includes": "none",
    "_P3_provides": ["CELESTIAL_SOLAR_MONTHLY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Solar Monthly — Sun Position and Daylight Data Template",
    "_P5_brief": "Template for monthly solar data — daily sunrise, sunset, solar noon, and day length for a specific location. One file per month per location. The greater light God made to rule the day defines the fundamental rhythm of light and darkness that all temporal awareness builds upon.",
    "_P5_usage": "Generate per month to locations/{location-id}/solar/YYYY/YYYY-MM.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "solar-monthly.template.jsonc",
        "key": "B-tov-temporal-celestial-solar-monthly",
        "title": "Solar Monthly — Sun Position and Daylight Data Template",
        "type": "Data (Template)",
        "component": "Scaffold — monthly solar position and daylight data for temporal awareness",
        "role": "Track sunrise, sunset, solar noon, and day length for each day of one month"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And God made two great lights; the greater light to rule the day."
    "_M4_grounding": {
        "scripture": "Genesis 1:16 — And God made two great lights; the greater light to rule the day, and the lesser light to rule the night: he made the stars also.",
        "principle": "The greater light rules the day. Sunrise and sunset define the most fundamental temporal rhythm — light from darkness, the first separation God made. True temporal awareness respects God's created order, not arbitrary human conventions.",
        "anchor": "Psalm 113:3 — From the rising of the sun unto the going down of the same the LORD's name is to be praised."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, location config (coordinates, timezone), astronomical calculation source (NOAA, timeanddate.com)",
        "consumers": "Temporal awareness, daily schedule context, availability calculations",
        "integration": "Solar monthly data provides the fundamental light/dark cycle for each day. References location config for coordinates and timezone. One file per month — the complete solar picture for that location in that period. Drives daily schedule awareness: when does the day begin and end?",
        "if_missing": "No solar awareness — cannot track sunrise, sunset, or day length. Schedule loses connection to natural light cycle.",
        "related_data": {
            "references": {
                "location-config": "Geographic coordinates and timezone for calculations"
            },
            "referenced_by": {
                "temporal-awareness": "Sunrise/sunset for daily context",
                "daily-schedule": "Light cycle informs schedule awareness",
                "seasonal-yearly": "Monthly solar data shows seasonal patterns"
            }
        }
    },

    "_M6_location": {
        "path": "data/L0/celestial/solar-monthly.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, celestial, solar, sun, sunrise, sunset, daylight, monthly, ephemeral, astronomical, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track monthly solar position and daylight data",
        "core_design": "Month identity (location_id, year, month, timezone) + days array (daily sunrise, sunset, solar_noon, day_length) + summary (shortest/longest day, average times, total daylight change) + extensions.",
        "philosophy": "The greater light to rule the day. Sunrise and sunset are not just data — they are the rhythm God established on Day One. Light from darkness, the first separation. Tracking solar data connects daily life to creation's fundamental pattern.",
        "key_features": {
            "daily_solar_data": "Sunrise, sunset, solar noon, and day length for every day",
            "month_summary": "Shortest and longest day, average times, total daylight change",
            "local_timezone": "All times in local timezone for practical use",
            "daylight_trend": "Shows whether days are lengthening or shortening"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Solar monthly template — scaffold for sun position data",
        "planned": ["Twilight times (civil, nautical, astronomical)", "Solar elevation angles", "Azimuth data", "UV index and solar intensity"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-monthly",
        "description": "Ephemeral monthly solar data — generated per month, consumed for awareness, archived.",
        "created_by": "Astronomical calculation from location coordinates",
        "persists": "Per month — active during the month, archived after",
        "consumed_by": "Temporal awareness, daily schedule context, seasonal correlation",
        "scope": "location-month — one location's solar data for one specific month"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks celestial lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times in local timezone, YYYY-MM-DD dates, day_length as 'Xh YYm' string",
    "_Cc_constraint": "location_id must match location config. One file per month. All days of month required (28-31). Times in local timezone (24-hour HH:MM).",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Solar Monthly Data",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "location_id": "example-city",
    "year": 2025,
    "month": 1,
    "month_name": "January",
    "timezone": "America/New_York",

    // OPTIONAL STANDARD FIELDS — Agency
    "timezone_offset": "-05:00",
    "generated_date": "2025-01-01",

    "days": [
        {
            "date": "2025-01-01",
            "sunrise": "07:20",
            "sunset": "16:39",
            "solar_noon": "12:00",
            "day_length": "9h 19m"
        }
    ],

    "summary": {
        "shortest_day": "2025-01-01",
        "shortest_day_length": "9h 19m",
        "longest_day": "2025-01-31",
        "longest_day_length": "9h 45m",
        "total_daylight_change": "Gained 26 minutes",
        "average_sunrise": "07:15",
        "average_sunset": "16:55",
        "notes": ""
    },

    "usage": {
        "purpose": "Track solar position and daylight for temporal awareness",
        "data_organization": "Solar data in YEAR subfolders: solar/YYYY/YYYY-MM.jsonc",
        "lifecycle": "Ephemeral — generated per month, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add solar discoveries here (e.g., twilight times, elevation angles, azimuth data, UV index)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-celestial"] },
    "_Cv_schema": {
        "required": ["name", "version", "location_id", "year", "month", "month_name", "timezone"],
        "optional": ["timezone_offset", "generated_date", "days", "summary", "usage", "extensions"],
        "value_format": "location_id: must match location config. month: 1-12. All days of month required in days array. Times: HH:MM 24-hour local. day_length: 'Xh YYm' format."
    },
    "_Cv_health_scoring": { "total": 100, "complete_daily_data": 40, "accurate_summary_statistics": 30, "correct_timezone_handling": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove daily entries (all days of month required)"],
    "_X1_careful": ["Change timezone offset without checking DST transitions", "Override summary statistics without verifying against daily data"],
    "_X1_safe": ["Update daily solar data", "Refine summary statistics", "Add extension fields"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Twilight times (civil, nautical, astronomical)", "Solar elevation angles", "Azimuth data", "UV index and solar intensity"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "dst_time_jump": "Sunrise/sunset times jump unexpectedly mid-month. Check if DST transition occurs — times shift by one hour.",
        "summary_mismatch": "Summary statistics don't match daily data. Recalculate shortest/longest day and averages from actual daily entries.",
        "location_mismatch": "Solar times don't match expectations. Verify location_id matches correct location config — sunrise/sunset vary by latitude and longitude."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L0/celestial/location-config.template.jsonc — Location coordinates driving calculations",
        "data/L0/celestial/lunar-monthly.template.jsonc — Lunar counterpart (moon data)",
        "data/L0/celestial/seasonal-yearly.template.jsonc — Seasonal context for solar data",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "location_id", "year", "month", "month_name", "timezone"],
    "_X4_validate": "make && ./bin/tov --validate-celestial",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Monthly solar data. Sunrise and sunset. The greater light ruling the day. God's first separation — light from darkness.",
    "_X5_scripture": "From the rising of the sun unto the going down of the same the LORD's name is to be praised. — Psalm 113:3",
    "_X5_anchor": "Sunrise to sunset — the rhythm God established on Day One. Track it faithfully. The greater light rules the day, and knowing its pattern connects daily life to creation's order.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
