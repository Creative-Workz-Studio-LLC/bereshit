{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-celestial-location-config",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "celestial-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — geographic and astronomical data for celestial temporal awareness",
    "_P3_layer": "data/L0/celestial",
    "_P3_includes": "none",
    "_P3_provides": ["CELESTIAL_LOCATION_CONFIG_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Location Config — Geographic and Astronomical Reference Template",
    "_P5_brief": "Template for defining a location's geographic coordinates, timezone, and context for celestial temporal awareness. Anchors all solar, lunar, and seasonal calculations to a specific place on Earth. Coordinates, timezone, DST rules, and organizational context. Persistent config — updated only when location changes.",
    "_P5_usage": "Copy to locations/{location-id}/ as config.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "location-config.template.jsonc",
        "key": "B-tov-temporal-celestial-location-config",
        "title": "Location Config — Geographic and Astronomical Reference Template",
        "type": "Data (Template)",
        "component": "Scaffold — geographic and astronomical data for celestial temporal awareness",
        "role": "Define location coordinates, timezone, and context for all celestial calculations"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And God said, Let there be lights in the firmament of the heaven to divide the day from the night;
    // and let them be for signs, and for seasons, and for days, and years."
    "_M4_grounding": {
        "scripture": "Genesis 1:14 — And God said, Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons, and for days, and years.",
        "principle": "God placed lights in the firmament for signs and seasons. Location config anchors temporal awareness to a specific place on Earth — where you stand determines what you see of God's celestial order. Coordinates and timezone connect abstract time to physical reality.",
        "anchor": "Psalm 19:1 — The heavens declare the glory of God; and the firmament sheweth his handywork."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, GPS/map coordinates, IANA timezone database",
        "consumers": "Solar data generation, lunar data generation, seasonal calculations, temporal awareness",
        "integration": "Location config is the foundation for all celestial calculations. Solar, lunar, and seasonal data files reference this config's location_id. Without accurate coordinates and timezone, all derived temporal data is wrong.",
        "if_missing": "No celestial awareness — cannot calculate sunrise, moonrise, seasons, or day length for this location",
        "related_data": {
            "references": {
                "iana-timezone": "IANA timezone database for timezone identifiers",
                "gps-coordinates": "GPS or map service for latitude/longitude"
            },
            "referenced_by": {
                "solar-monthly": "Solar data uses location coordinates and timezone",
                "lunar-monthly": "Lunar data uses location coordinates and timezone",
                "seasonal-yearly": "Seasonal data uses location latitude and timezone"
            }
        }
    },

    "_M6_location": {
        "path": "data/L0/celestial/location-config.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, celestial, location, geographic, coordinates, timezone, config, persistent, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define location for celestial temporal calculations",
        "core_design": "Location identity (location_id, display_name, country, state_province) + coordinates (latitude, longitude, elevation, reference_point, accuracy) + timezone (IANA identifier, UTC offsets, DST rules) + context (primary user, organization, usage) + extensions.",
        "philosophy": "God placed lights in the firmament — but where you stand on Earth determines what you see. Location config grounds celestial awareness in physical place. Without knowing WHERE, you cannot know WHEN the sun rises or the moon sets.",
        "key_features": {
            "geographic_coordinates": "Latitude, longitude, elevation for astronomical calculations",
            "timezone_definition": "IANA timezone with DST rules for local time conversion",
            "organizational_context": "Who uses this location and why",
            "persistent_config": "Updated only when location changes — foundation for all ephemeral data"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Location config template — scaffold for geographic reference",
        "planned": ["Magnetic declination tracking", "Climate zone classification", "Historical data source registry"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "persistent-config",
        "description": "Persistent location configuration — updated only when geographic or organizational context changes.",
        "created_by": "User's geographic location and organizational context",
        "persists": "Permanently — updated only when location or organization changes",
        "consumed_by": "Solar, lunar, and seasonal data generation — all celestial calculations",
        "scope": "location — defines one geographic location for celestial awareness"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks celestial lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, decimal degrees for coordinates, IANA timezone identifiers, YYYY-MM-DD dates",
    "_Cc_constraint": "location_id required (kebab-case). Coordinates: latitude -90 to 90, longitude -180 to 180. Timezone must be valid IANA identifier.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Celestial Location Config",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "location_id": "example-city",
    "display_name": "Example City, State",
    "country": "Country Name",
    "state_province": "State/Province",

    // OPTIONAL STANDARD FIELDS — Agency
    "coordinates": {
        "latitude": 40.7128,
        "longitude": -74.0060,
        "elevation": 10,
        "reference_point": "City center",
        "accuracy": "City-level"
    },

    "timezone": {
        "iana_identifier": "America/New_York",
        "utc_offset_standard": "-05:00",
        "utc_offset_dst": "-04:00",
        "observes_dst": true,
        "dst_start": "Second Sunday in March at 2:00 AM",
        "dst_end": "First Sunday in November at 2:00 AM"
    },

    "context": {
        "primary_user": "User Name",
        "primary_organization": "Organization Name",
        "primary_workplace": "Workplace Name",
        "usage": "Primary location for temporal awareness"
    },

    "usage": {
        "purpose": "Define geographic reference for celestial temporal calculations",
        "lifecycle": "Persistent — updated only when location changes"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add location discoveries here (e.g., magnetic declination, climate zone, historical data sources)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-celestial"] },
    "_Cv_schema": {
        "required": ["name", "version", "location_id", "display_name", "country"],
        "optional": ["state_province", "coordinates", "timezone", "context", "usage", "extensions"],
        "value_format": "location_id: kebab-case. latitude: -90 to 90. longitude: -180 to 180. timezone: valid IANA identifier."
    },
    "_Cv_health_scoring": { "total": 100, "accurate_coordinates": 35, "valid_timezone_definition": 35, "meaningful_context": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove coordinate fields (all celestial data depends on them)"],
    "_X1_careful": ["Change timezone without verifying IANA database", "Move location coordinates significantly without re-generating derived data"],
    "_X1_safe": ["Update context fields", "Refine coordinate accuracy", "Add extension fields"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Magnetic declination tracking", "Climate zone classification", "Historical data source registry"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "wrong_timezone": "Solar/lunar times don't match reality. Verify IANA identifier matches actual timezone — watch for DST transitions.",
        "coordinate_precision": "Celestial calculations slightly off. City-level coordinates are fine for sunrise/sunset; need higher precision for shadow calculations.",
        "dst_rules_changed": "Government changed DST rules. Update dst_start/dst_end fields and re-generate affected solar/lunar data."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L0/celestial/solar-monthly.template.jsonc — Solar data using this location",
        "data/L0/celestial/lunar-monthly.template.jsonc — Lunar data using this location",
        "data/L0/celestial/seasonal-yearly.template.jsonc — Seasonal data using this location",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "location_id", "display_name", "country"],
    "_X4_validate": "make && ./bin/tov --validate-celestial",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Geographic reference for celestial awareness. Coordinates anchor all temporal calculations to physical place. Persistent foundation for ephemeral data.",
    "_X5_scripture": "The heavens declare the glory of God; and the firmament sheweth his handywork. — Psalm 19:1",
    "_X5_anchor": "Where you stand determines what you see of God's celestial order. Location config connects abstract time to physical reality — the firmament sheweth His handywork from this specific vantage point.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
