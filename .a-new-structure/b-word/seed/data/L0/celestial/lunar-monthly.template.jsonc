{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-celestial-lunar-monthly",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "celestial-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — monthly lunar phase and position data for temporal awareness",
    "_P3_layer": "data/L0/celestial",
    "_P3_includes": "none",
    "_P3_provides": ["CELESTIAL_LUNAR_MONTHLY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Lunar Monthly — Moon Phase and Position Data Template",
    "_P5_brief": "Template for monthly lunar data — major phase transitions, daily moonrise/moonset times, phase names, illumination percentages, and moon age. One file per month per location. The lesser light God made to rule the night marks months and seasons through its cycle.",
    "_P5_usage": "Generate per month to locations/{location-id}/lunar/YYYY/YYYY-MM.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "lunar-monthly.template.jsonc",
        "key": "B-tov-temporal-celestial-lunar-monthly",
        "title": "Lunar Monthly — Moon Phase and Position Data Template",
        "type": "Data (Template)",
        "component": "Scaffold — monthly lunar phase and position data for temporal awareness",
        "role": "Track moon phases, moonrise/moonset times, and illumination for one month"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And God made two great lights... the lesser light to rule the night."
    "_M4_grounding": {
        "scripture": "Genesis 1:16 — And God made two great lights; the greater light to rule the day, and the lesser light to rule the night: he made the stars also.",
        "principle": "The lesser light rules the night. The moon's cycle — new to full to new — marks months and seasons in God's created order. Ancient calendars followed the moon. Tracking lunar data honors the rhythm God established before any human convention.",
        "anchor": "Psalm 104:19 — He appointed the moon for seasons: the sun knoweth his going down."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, location config (coordinates, timezone), astronomical calculation source",
        "consumers": "Temporal awareness, calendar correlation, seasonal context",
        "integration": "Lunar monthly data provides moon phase and position for each day. References location config for coordinates and timezone. One file per month — the complete lunar picture for that location in that period.",
        "if_missing": "No lunar awareness — cannot track moon phases, traditional calendar correlations, or nighttime light conditions",
        "related_data": {
            "references": {
                "location-config": "Geographic coordinates and timezone for calculations"
            },
            "referenced_by": {
                "temporal-awareness": "Moon phase information for schedule context",
                "seasonal-yearly": "Lunar data complements seasonal solar markers"
            }
        }
    },

    "_M6_location": {
        "path": "data/L0/celestial/lunar-monthly.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, celestial, lunar, moon, phases, monthly, ephemeral, astronomical, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track monthly lunar phases and position data",
        "core_design": "Month identity (location_id, year, month, timezone) + major_phases array (New Moon, First Quarter, Full Moon, Last Quarter with dates/times) + days array (daily moonrise, moonset, phase_name, illumination, age) + summary (lunar month length, phases this month, traditional names) + extensions.",
        "philosophy": "He appointed the moon for seasons. The moon's cycle is not decoration — it's the original calendar. Tracking lunar data connects modern timekeeping to the rhythm God built into creation.",
        "key_features": {
            "major_phase_transitions": "New Moon, First Quarter, Full Moon, Last Quarter with exact times",
            "daily_moon_data": "Moonrise, moonset, phase name, illumination percentage, moon age",
            "traditional_moon_names": "Wolf Moon, Harvest Moon — cultural connection to lunar cycles",
            "null_handling": "Moonrise/moonset can be null when moon doesn't rise/set that day"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Lunar monthly template — scaffold for moon phase data",
        "planned": ["Lunar elevation angles", "Perigee/apogee distance tracking", "Eclipse prediction", "Tidal influence data"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-monthly",
        "description": "Ephemeral monthly lunar data — generated per month, consumed for awareness, archived.",
        "created_by": "Astronomical calculation from location coordinates",
        "persists": "Per month — active during the month, archived after",
        "consumed_by": "Temporal awareness, calendar correlation, nighttime context",
        "scope": "location-month — one location's lunar data for one specific month"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks celestial lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times in local timezone, YYYY-MM-DD dates, percentage illumination, decimal moon age",
    "_Cc_constraint": "location_id must match location config. One file per month. All days of month required (28-31). Times in local timezone. Moonrise/moonset can be null.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Lunar Monthly Data",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "location_id": "example-city",
    "year": 2025,
    "month": 1,
    "month_name": "January",
    "timezone": "America/New_York",

    // OPTIONAL STANDARD FIELDS — Agency
    "timezone_offset": "-05:00",
    "generated_date": "2025-01-01",

    "major_phases": [
        {
            "phase": "New Moon",
            "date": "2025-01-06",
            "time": "23:57",
            "illumination": "0%",
            "description": "Moon between Earth and Sun — not visible"
        },
        {
            "phase": "First Quarter",
            "date": "2025-01-13",
            "time": "17:27",
            "illumination": "50%",
            "description": "Half moon visible — right side illuminated"
        }
    ],

    "days": [
        {
            "date": "2025-01-01",
            "moonrise": "04:23",
            "moonset": "14:56",
            "phase_name": "Waxing Crescent",
            "illumination": "3%",
            "age": 1.2
        }
    ],

    "summary": {
        "lunar_month_length": "29.5 days",
        "phases_this_month": ["New Moon", "First Quarter"],
        "full_moon_name": "Wolf Moon",
        "notes": ""
    },

    "usage": {
        "purpose": "Track lunar phases and position for temporal awareness",
        "lunar_phase_names": "New Moon → Waxing Crescent → First Quarter → Waxing Gibbous → Full Moon → Waning Gibbous → Last Quarter → Waning Crescent",
        "lifecycle": "Ephemeral — generated per month, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add lunar discoveries here (e.g., elevation angles, perigee/apogee distance, eclipse data)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-celestial"] },
    "_Cv_schema": {
        "required": ["name", "version", "location_id", "year", "month", "month_name", "timezone"],
        "optional": ["timezone_offset", "generated_date", "major_phases", "days", "summary", "usage", "extensions"],
        "value_format": "location_id: must match location config. month: 1-12. All days of month required in days array. Times: HH:MM local. Illumination: percentage string."
    },
    "_Cv_health_scoring": { "total": 100, "complete_daily_data": 40, "accurate_phase_transitions": 30, "meaningful_summary": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove daily entries (all days of month required)"],
    "_X1_careful": ["Change timezone offset without checking DST transitions", "Remove major phase entries"],
    "_X1_safe": ["Update daily moon data", "Add phase descriptions", "Refine summary notes"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Lunar elevation angles", "Perigee/apogee distance tracking", "Eclipse prediction", "Tidal influence data"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "moonrise_null": "Moonrise or moonset is null for a day. This is normal — the moon sometimes doesn't rise or set in a given calendar day at certain latitudes.",
        "phase_name_mismatch": "Daily phase name doesn't match illumination percentage. Verify phase names follow the 8-phase cycle: New → Waxing Crescent → First Quarter → Waxing Gibbous → Full → Waning Gibbous → Last Quarter → Waning Crescent.",
        "location_mismatch": "Moon times don't match expectations. Verify location_id matches the correct location config — moonrise/moonset vary significantly by latitude."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L0/celestial/location-config.template.jsonc — Location coordinates driving calculations",
        "data/L0/celestial/solar-monthly.template.jsonc — Solar counterpart (sun data)",
        "data/L0/celestial/seasonal-yearly.template.jsonc — Seasonal context for lunar data",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "location_id", "year", "month", "month_name", "timezone"],
    "_X4_validate": "make && ./bin/tov --validate-celestial",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Monthly lunar data. Moon phases and position. The lesser light ruling the night. God's original calendar marker.",
    "_X5_scripture": "He appointed the moon for seasons. — Psalm 104:19",
    "_X5_anchor": "The moon marks months and seasons. Its cycle — new to full to new — is the rhythm God established before any human calendar. Track it faithfully.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
