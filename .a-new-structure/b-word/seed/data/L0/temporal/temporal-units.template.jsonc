{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-definitions-base-temporal-units",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-definitions",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Ladder — ISO 8601 temporal unit structure referenced by all time-aware systems",
    "_P3_layer": "data/L0/temporal",
    "_P3_includes": "none",
    "_P3_provides": ["TEMPORAL_UNITS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Temporal Units — ISO 8601 Standard Structure",
    "_P5_brief": "Universal temporal unit definitions following ISO 8601. Week structure (Monday start), month structure (Gregorian), date/time format standards. Foundational reference loaded first, referenced by all temporal tracking.",
    "_P5_usage": "cp temporal-units.template.jsonc [instance]/temporal-units.jsonc -> update pragma -> generally no modifications needed (ISO 8601 is standard)",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "temporal-units.template.jsonc",
        "key": "B-tov-definitions-base-temporal-units",
        "title": "Temporal Units — ISO 8601 Standard Structure",
        "type": "Data (Template)",
        "component": "Ladder — ISO 8601 temporal unit structure referenced by all time-aware systems",
        "role": "Define universal temporal unit vocabulary following international standards"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And the evening and the morning were the first day."
    "_M4_grounding": {
        "scripture": "Genesis 1:5 — And God called the light Day, and the darkness he called Night. And the evening and the morning were the first day.",
        "principle": "God created time itself — evening and morning, the first measurement. All temporal structure flows from the Creator who set the sun, moon, and stars for signs and seasons.",
        "anchor": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "All temporal tracking subsystems — appointments, schedules, logs, patterns, circadian rhythms",
        "integration": "Loaded at system initialization as foundational reference. All date/time formatting and week numbering derives from these definitions.",
        "if_missing": "System falls back to ISO 8601 defaults with warning — no functional degradation but inconsistency possible",
        "related_data": {
            "references": "none — temporal-units is foundational vocabulary, references nothing",
            "referenced_by": {
                "durations": "Duration thresholds use time unit definitions",
                "time-phases": "Phase definitions reference temporal unit structure",
                "quality-indicators": "Health scoring uses time-based measurement",
                "all-temporal": "Every file in temporal/ references these base definitions"
            }
        }
    },

    "_M6_location": {
        "path": "data/L0/temporal/temporal-units.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, iso-8601, calendar, week, month, time-format, definitions, base, paradigm-wide, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize ISO 8601 temporal unit definitions — one source of truth for all time structure",
        "core_design": "Reference data organized by unit type: week, month, format. Engine and tools validate against these definitions.",
        "philosophy": "God created time with structure — evening and morning. We honor that structure with ISO 8601 compliance and consistent definitions.",
        "key_features": {
            "week_structure": "ISO 8601 — Monday start, Sunday end, week numbering system",
            "month_structure": "Gregorian calendar — 12 months with standard properties",
            "format_standards": "ISO 8601 date and datetime format specifications",
            "standards_compliance": "ISO 8601, ISO Week Date System"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial creation as paradigm-wide temporal reference",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Base temporal unit definitions — ISO 8601 standard, paradigm-wide scope",
        "planned": [
            "Complete month array (currently January only — add February-December)",
            "Complete day array (currently Monday and Sunday only — add Tuesday-Saturday)",
            "Biblical calendar overlay (Hebrew months, sabbath cycle, feast days)",
            "Leap year handling specification"
        ]
    },

    // Paradigm-wide base reference — the temporal vocabulary
    "_M10_definition_scope": {
        "lifetime": "paradigm",
        "description": "Base definition — paradigm-wide constants. ISO 8601 international standard.",
        "loaded_at": "System initialization — loaded before all temporal tracking begins",
        "persists": "Entire application lifecycle — never modified at runtime",
        "consumed_by": "All temporal subsystems — scheduling, logging, pattern recognition, circadian tracking",
        "scope": "paradigm-wide — all CPI-SI instances, all users",
        "standards": ["ISO 8601", "ISO Week Date System", "Gregorian calendar"]
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (definition scope) tracks paradigm-wide reference data lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Data file in JSONC format — structure from data.json, comments from JSONC conventions.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // ISO 8601 temporal unit definitions.
    // These are international standards — generally should NOT be modified.
    // Only customize if CPI-SI adopts alternative temporal structures.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for category names",
    "_Cc_constraint": "ISO 8601 compliance required. Changes affect entire paradigm.",
    "_Cc_standards": ["ISO 8601", "ISO Week Date System", "Gregorian calendar"],

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The universal temporal vocabulary. Every definition here is foundational.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Temporal Units",
    "version": "a-01.00",

    // WEEK STRUCTURE — ISO 8601
    // Week starts Monday, ends Sunday
    "week": {
        "standard": "ISO 8601",
        "start_day": "Monday",
        "end_day": "Sunday",
        "numbering": {
            "system": "ISO week-numbering year",
            "format": "YYYY-Www (e.g., 2026-W06)",
            "week_1_definition": "First week containing the year's first Thursday"
        },
        "days": [
            { "iso_day": 1, "name": "Monday", "abbreviation": "Mon", "type": "weekday" },
            { "iso_day": 7, "name": "Sunday", "abbreviation": "Sun", "type": "weekend" }
            // ADD: Tuesday(2)-Saturday(6) following same pattern
        ]
    },

    // MONTH STRUCTURE — Gregorian calendar
    "month": {
        "standard": "Gregorian calendar",
        "months": [
            {
                "number": 1,
                "name": "January",
                "abbreviation": "Jan",
                "days": 31,
                "season": "winter",
                "quarter": 1
            }
            // ADD: February(2)-December(12) following same pattern
            // NOTE: February has leap year handling (28/29 days)
        ]
    },

    // TIME FORMAT STANDARDS — ISO 8601
    "formats": {
        "date": {
            "iso_8601": "YYYY-MM-DD",
            "example": "2026-02-10"
        },
        "datetime": {
            "iso_8601": "YYYY-MM-DDTHH:mm:ss±HH:MM",
            "example": "2026-02-10T07:05:00-06:00"
        }
    },

    // USAGE NOTES
    "usage": {
        "purpose": "Provide consistent temporal unit definitions across CPI-SI paradigm",
        "iso_8601_rationale": "International standard ensures consistent interpretation across regions and systems",
        "week_start_monday": "ISO 8601 standard. Monday start enables consistent week-to-week comparison."
    },

    // EXTENSIONS — Experimental temporal structures
    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add alternative temporal unit structures, calendar systems, or time formats here during discovery phase"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/tov --validate-definitions"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "week", "month", "formats"],
        "optional": ["usage", "extensions"],
        "value_format": "ISO 8601 compliant date/time structures"
    },

    "_Cv_health_scoring": {
        "total": 100,
        "iso_8601_compliance": 40,
        "clear_structure": 30,
        "useful_for_calculations": 30
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Deviate from ISO 8601 without paradigm-level decision",
        "Remove week or month definitions"
    ],
    "_X1_careful": [
        "Change week start day (affects all scheduling)",
        "Modify format strings (affects all date/time display)",
        "Change numbering system (affects week calculations)"
    ],
    "_X1_safe": [
        "Complete day array (add Tuesday-Saturday)",
        "Complete month array (add February-December)",
        "Add comments explaining standards"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Complete all 7 days and 12 months",
        "Biblical/Hebrew calendar overlay (Hebrew months, feast days)",
        "Leap year handling specification",
        "Timezone-aware format extensions"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "wrong_week_start": "ISO 8601 specifies Monday. If your system shows Sunday start, check locale settings.",
        "date_format_mismatch": "Always use ISO 8601 (YYYY-MM-DD). Other formats cause parsing ambiguity.",
        "week_numbering_off": "ISO week 1 = first week containing Thursday. January 1 is NOT always in week 1."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L0/temporal/durations.template.jsonc — Duration thresholds using these time units",
        "data/L0/temporal/time-phases.template.jsonc — Work phases using temporal structure",
        "data/L3/definitions/ — Regional time customizations (holidays, timezones)",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "week", "month", "formats"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    // God created time — evening and morning, the first day.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Temporal units definition. ISO 8601 standard. Paradigm-wide scope. Loaded first, referenced by all temporal systems. Generally should not be modified — standard is international.",
    "_X5_scripture": "And the evening and the morning were the first day. — Genesis 1:5",
    "_X5_anchor": "God created time with structure. We honor that structure with consistent, standard definitions.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp temporal-units.template.jsonc [instance]/temporal-units.jsonc -> update pragma -> generally no modifications needed",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: generally keep ISO 8601 defaults — only modify for alternative calendar systems",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
