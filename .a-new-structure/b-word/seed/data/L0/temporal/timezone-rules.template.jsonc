    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "wrong_offset": "Timestamp shows wrong time. Check if DST is in effect — offset changes twice per year.",
        "ambiguous_time": "Time during fall-back exists twice. Use UTC or specify offset explicitly.",
        "non_existent_time": "Time during spring-forward doesn't exist. Skip to next valid time."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
