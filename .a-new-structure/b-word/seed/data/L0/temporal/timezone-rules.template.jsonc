        "data/L0/celestial/ — Celestial data using timezone for local calculations",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "timezone", "daylight_saving_time"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Timezone rules definition. IANA names + UTC offsets + DST rules. Use timezone libraries for calculations. Update DST transition dates annually.",
    "_X5_scripture": "He appointed the moon for seasons: the sun knoweth his going down. — Psalm 104:19",
    "_X5_anchor": "The sun knoweth his going down. Timezones recognize God's created rhythm across the earth.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp timezone-rules.template.jsonc regional/<continent>/<country>/<region>/timezone-rules.jsonc -> update all placeholder values",
    "_X6_update": [
        "_P1_key: unique identifier (e.g., B-tov-definitions-regional-us-central-timezone)",
        "_M1_identity: file, key, title with region name",
        "timezone section: IANA name, abbreviations, UTC offsets",
        "daylight_saving_time: DST rules for this region (or set observes_dst: false)",
        "dst_transitions: specific dates for upcoming years",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
