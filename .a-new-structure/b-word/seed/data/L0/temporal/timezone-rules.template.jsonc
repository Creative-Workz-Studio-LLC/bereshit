    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Timezone Rules — Regional Timezone & DST Definitions",
    "_P5_brief": "Template for defining timezone behavior for a specific region. IANA timezone name, UTC offsets, DST rules, and transition dates. Critical for accurate timestamp interpretation.",
    "_P5_usage": "cp timezone-rules.template.jsonc regional/<continent>/<country>/<region>/timezone-rules.jsonc -> update pragma -> define timezone and DST rules",

