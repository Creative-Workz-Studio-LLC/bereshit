    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "IANA timezone names, ISO 8601 timestamps",
    "_Cc_constraint": "Use IANA timezone names (not abbreviations alone). UTC offsets in ±HH:MM format. Always use timezone libraries for calculations.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Region Timezone Rules",
    "version": "a-01.00",

    // TIMEZONE INFORMATION
    "timezone": {
        "iana_name": "Continent/City",
        "standard_abbreviation": "STD",
        "standard_name": "Standard Time Name",
        "daylight_abbreviation": "DLT",
        "daylight_name": "Daylight Time Name",
        "utc_offset_standard": "-06:00",
        "utc_offset_daylight": "-05:00"
    },

    // DAYLIGHT SAVING TIME RULES
    "daylight_saving_time": {
        "observes_dst": true,
        "start_rule": {
            "description": "Second Sunday in March at 2:00 AM local time",
            "month": 3,
            "week": "second",
            "day_of_week": "Sunday",
            "time": "02:00",
            "offset_change": "Spring forward 1 hour",
            "utc_offset_before": "-06:00",
            "utc_offset_after": "-05:00"
        },
        "end_rule": {
            "description": "First Sunday in November at 2:00 AM local time",
            "month": 11,
            "week": "first",
            "day_of_week": "Sunday",
            "time": "02:00",
            "offset_change": "Fall back 1 hour",
            "utc_offset_before": "-05:00",
            "utc_offset_after": "-06:00"
        }
    },

    // DST TRANSITION DATES — Specific dates for upcoming years
    "dst_transitions": {
        "2025": {
            "spring_forward": "2025-03-09T02:00:00-06:00",
            "fall_back": "2025-11-02T02:00:00-05:00"
        },
        "2026": {
            "spring_forward": "2026-03-08T02:00:00-06:00",
            "fall_back": "2026-11-01T02:00:00-05:00"
        }
        // ADD: Additional years as needed
    },

    "usage": {
        "purpose": "Provide accurate timezone rules for temporal calculations in this region",
        "dst_complexity": "DST transitions create ambiguous and non-existent times — handle carefully",
        "library_recommendation": "Use robust timezone libraries rather than manual offset calculations"
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add timezone-specific discoveries, DST edge cases, or temporal calculation patterns here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": ["make", "./bin/tov --validate-definitions"]
    },

    "_Cv_schema": {
        "required": ["name", "version", "timezone", "daylight_saving_time"],
        "optional": ["dst_transitions", "usage", "extensions"],
        "value_format": "IANA timezone names, UTC offsets in ±HH:MM, ISO 8601 timestamps"
    },

    "_Cv_health_scoring": {
        "total": 100,
        "accurate_timezone_rules": 40,
        "dst_handling_correctness": 30,
        "useful_for_timestamp_interpretation": 30
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

