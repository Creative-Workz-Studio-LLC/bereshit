    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "timezone-rules.template.jsonc",
        "key": "B-tov-definitions-regional-timezone-rules",
        "title": "Timezone Rules — Regional Timezone & DST Definitions",
        "type": "Data (Template)",
        "component": "Scaffold — timezone and DST rules for a specific region",
        "role": "Define timezone behavior for accurate temporal calculations"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "He appointed the moon for seasons: the sun knoweth his going down."
    "_M4_grounding": {
        "scripture": "Psalm 104:19 — He appointed the moon for seasons: the sun knoweth his going down.",
        "principle": "God set the celestial bodies to mark time. Timezones are human recognition of the sun's going down at different places. DST is human adjustment — handle it carefully.",
        "anchor": "Genesis 1:14 — And God said, Let there be lights in the firmament of the heaven... for signs, and for seasons, and for days, and years."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, robust timezone library (Go: time.LoadLocation, Rust: chrono-tz)",
        "consumers": "All temporal calculations, session timestamps, log timestamps, scheduled events",
        "integration": "Timezone rules enable accurate UTC conversion. DST transitions create ambiguous times — handle with library support.",
        "if_missing": "System defaults to UTC with warning — all local times will be wrong",
        "related_data": {
            "references": {
                "temporal-units": "ISO 8601 format standards for timestamps"
            },
            "referenced_by": {
                "time-categories": "Time-of-day categories anchored to this timezone",
                "celestial-data": "Celestial calculations use timezone for local time",
                "all-timestamps": "Every timestamp in the system references timezone rules"
            }
        }
    },

    "_M6_location": {
        "path": "data/L0/temporal/timezone-rules.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "timezone, dst, daylight-saving, utc-offset, iana, regional, definitions, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize timezone rules for a region — one source of truth for offset calculations",
        "core_design": "IANA timezone name + UTC offsets + DST rules + transition dates. Use timezone libraries for calculations — this file provides configuration.",
        "philosophy": "The sun knoweth his going down. Timezones recognize God's created rhythm across the earth. Handle DST with care — human adjustments to divine timing.",
        "key_features": {
            "iana_name": "Standard timezone identifier (America/Chicago, Europe/London)",
            "utc_offsets": "Standard and daylight time offsets from UTC",
            "dst_rules": "When DST starts and ends (calculation rules)",
            "transition_dates": "Specific dates for upcoming years"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation with US Central timezone example",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Timezone rules template — scaffold for region-specific instantiation",
        "planned": [
            "US Central timezone instance (first instantiation)",
            "Historical DST rule changes",
            "Timezone-less regions support (e.g., Arizona, parts of Indiana)"
        ]
    },

    "_M10_definition_scope": {
        "lifetime": "regional",
        "description": "Regional definition — timezone behavior for a specific geographic area.",
        "loaded_at": "System initialization — loaded for the user's configured region",
        "persists": "Entire application lifecycle — DST transition dates updated annually",
        "consumed_by": "All temporal calculation subsystems",
        "scope": "regional — specific timezone area"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (definition scope) tracks regional reference data lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

