{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-definitions-base-time-phases",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-definitions",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Ladder — universal work state phase categories for temporal awareness",
    "_P3_layer": "data/L0/temporal",
    "_P3_includes": "none",
    "_P3_provides": ["TIME_PHASES_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Time Phases — Universal Work State Categories",
    "_P5_brief": "Universal categorization of work state phases — peak, focus, downtime. Phases are states (WHAT), not times (WHEN). When phases occur for specific people is discovered in the patterns layer. Honors sabbath as essential, not optional.",
    "_P5_usage": "cp time-phases.template.jsonc [instance]/time-phases.jsonc -> update pragma -> define work phase categories as discovered",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "time-phases.template.jsonc",
        "key": "B-tov-definitions-base-time-phases",
        "title": "Time Phases — Universal Work State Categories",
        "type": "Data (Template)",
        "component": "Ladder — universal work state phase categories for temporal awareness",
        "role": "Define work state phase vocabulary for rhythm recognition and optimization"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Remember the sabbath day, to keep it holy."
    "_M4_grounding": {
        "scripture": "Exodus 20:8-11 — Remember the sabbath day, to keep it holy. Six days shalt thou labour, and do all thy work: But the seventh day is the sabbath of the LORD thy God.",
        "principle": "Work and rest are both commanded. Peak productivity is not the goal — faithful rhythm is. Downtime is not weakness but obedience. Phases describe states, not prescribe schedules.",
        "anchor": "Genesis 2:2 — And on the seventh day God ended his work which he had made; and he rested on the seventh day from all his work."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Session tracking, circadian analysis, task scheduling, session-awareness skill",
        "integration": "Phase definitions provide the vocabulary for work state classification. Circadian patterns discover WHEN these phases occur for individuals.",
        "if_missing": "System uses generic phase categories with warning — rhythm recognition still functions but less nuanced",
        "related_data": {
            "references": {
                "temporal-units": "Time unit structure for temporal context",
                "durations": "Duration thresholds overlap with phase duration awareness"
            },
            "referenced_by": {
                "circadian-learned": "Circadian patterns map WHEN these phases occur for individuals",
                "work-style-learned": "Work style patterns reference phase optimization",
                "session-current": "Active session phase tracking"
            }
        }
    },

    "_M6_location": {
        "path": "data/L0/temporal/time-phases.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, phases, work-state, peak, focus, downtime, sabbath, rhythm, definitions, base, paradigm-wide, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize work state phase definitions — vocabulary for understanding productivity rhythms",
        "core_design": "Named phases with characteristics, optimal work types, and biblical grounding. Phases are states (WHAT), not times (WHEN) — WHEN varies by person.",
        "philosophy": "God worked six days and rested the seventh. The rhythm of peak, focus, and rest is built into creation. We honor it, not fight it.",
        "key_features": {
            "peak": "Highest cognitive capacity — complex problem solving, architectural decisions",
            "focus": "Good concentration — sustained implementation work, documentation",
            "downtime": "Rest and recovery — essential for sustainable rhythm, biblically commanded"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial creation with peak, focus, downtime phases",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Base time phases — three core phases, paradigm-wide scope",
        "planned": [
            "Add transition phase (moving between states)",
            "Add creative phase (ideation, brainstorming — distinct from focus)",
            "Add collaborative phase (pair work, discussion)",
            "Phase transition triggers and indicators"
        ]
    },

    // Paradigm-wide base reference — phase vocabulary
    "_M10_definition_scope": {
        "lifetime": "paradigm",
        "description": "Base definition — paradigm-wide work state categories. States, not schedules.",
        "loaded_at": "System initialization — loaded before session phase tracking begins",
        "persists": "Entire application lifecycle — categories may expand over time",
        "consumed_by": "Session tracking, circadian analysis, task scheduling subsystems",
        "scope": "paradigm-wide — all CPI-SI instances, all users",
        "key_distinction": "Phases are states (WHAT), not times (WHEN). WHEN is learned per person in the patterns layer."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (definition scope) tracks paradigm-wide reference data lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Data file in JSONC format — structure from data.json, comments from JSONC conventions.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Work state phase definitions.
    // Phases are states, not times. WHEN varies by person.
    // Define phases as discovery produces them — these are starting categories.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for phase names",
    "_Cc_constraint": "Phases describe states (capacity), not times (clock hours). Each phase must include characteristics and optimal work types.",
    "_Cc_key_distinction": "WHAT (state) defined here. WHEN (timing) learned in patterns layer per person.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The universal phase vocabulary. States the system can be in.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Time Phases",
    "version": "a-01.00",

    // WORK PHASE DEFINITIONS
    // Phases are states (WHAT), not times (WHEN) — WHEN varies by person
    "work_phases": {
        "peak": {
            "name": "Peak Productivity",
            "description": "Highest cognitive capacity — best time for challenging work",
            "characteristics": [
                "Maximum mental clarity and focus",
                "High energy and engagement"
            ],
            "optimal_work_types": [
                "Complex problem solving",
                "Architectural design decisions"
            ],
            "duration_note": "Peak phases typically limited duration — protect and use wisely"
        },
        "focus": {
            "name": "Focus Time",
            "description": "Good concentration — suitable for sustained work requiring attention",
            "characteristics": [
                "Solid concentration capacity",
                "Good energy for sustained work"
            ],
            "optimal_work_types": [
                "Implementation work",
                "Writing documentation"
            ]
        },
        "downtime": {
            "name": "Downtime / Rest",
            "description": "Rest, recovery, non-work time — essential for sustainable rhythm",
            "characteristics": [
                "Intentional rest from work",
                "Recovery and renewal"
            ],
            "biblical_foundation": "Exodus 20:8-11 — Remember the sabbath day"
        }
        // ADD: transition, creative, collaborative phases as discovered
    },

    // USAGE NOTES
    "usage": {
        "purpose": "Provide universal phase categories for work state awareness",
        "not_clock_based": "Phases are states, not times. 'Peak' might be 6am for one person, 10pm for another.",
        "learned_individually": "WHEN phases occur for specific people is discovered in patterns layer",
        "flexibility": "Not rigid rules — framework for understanding and optimizing natural rhythms"
    },

    // EXTENSIONS — Experimental phase patterns
    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal definitions or removed",
        "usage_guidance": "Add new work phase categories, energy states, or phase transition patterns here during discovery phase"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/tov --validate-definitions"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "work_phases"],
        "optional": ["usage", "extensions"],
        "value_format": "Each phase must have name, description, characteristics, and optimal_work_types"
    },

    "_Cv_health_scoring": {
        "total": 100,
        "clear_phase_definitions": 35,
        "useful_for_rhythm_recognition": 35,
        "integration_with_work_patterns": 30
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove downtime/rest as a phase",
        "Prescribe clock hours for phases (phases are states, not times)"
    ],
    "_X1_careful": [
        "Rename phases (breaks references in pattern data)",
        "Change phase characteristics (affects historical classification)",
        "Merge phases (may lose nuance in pattern recognition)"
    ],
    "_X1_safe": [
        "Add new phases (transition, creative, collaborative)",
        "Add optimal work types to existing phases",
        "Add biblical grounding to phases"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Transition phase (moving between states)",
        "Creative phase (ideation, brainstorming — distinct from focus)",
        "Collaborative phase (pair work, discussion)",
        "Phase transition triggers and indicators",
        "Energy level gradients within phases"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "wrong_phase_detected": "Phase classification doesn't match felt state. Check if new phase category needed (transition, creative). Add to extensions.",
        "phases_confused_with_times": "Phases are WHAT (state), not WHEN (clock). If system prescribes '9am is peak', that's wrong — learn from patterns.",
        "no_downtime": "If patterns show no downtime, something is broken. Rest is commanded (Exodus 20:8-11). System should flag this."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L0/temporal/temporal-units.template.jsonc — Time unit structure for temporal context",
        "data/L0/temporal/durations.template.jsonc — Duration categories overlapping with phase awareness",
        "data/L3/patterns/user/circadian-learned.template.jsonc — Learns WHEN phases occur per person",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "work_phases"],
    "_X4_validate": "make && ./bin/tov --validate-definitions",

    // God worked six days and rested the seventh.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Time phases definition. Work states, not clock times. Peak, focus, downtime — each has its place. Rest is commanded, not optional. Rhythm is the goal, not constant peak productivity.",
    "_X5_scripture": "And on the seventh day God ended his work which he had made; and he rested. — Genesis 2:2",
    "_X5_anchor": "God's rhythm: work, then rest. Phases honor creation's pattern — not every moment must be peak.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp time-phases.template.jsonc [instance]/time-phases.jsonc -> update pragma -> add phase categories as discovered",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: add new phases, expand characteristics and optimal work types",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
