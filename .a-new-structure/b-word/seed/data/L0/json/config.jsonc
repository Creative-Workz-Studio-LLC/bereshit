{
    // #!omni template --jsonc
    "$schema": "../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-seed-data-json-3block-config",
    "_P1_from": "b-word/seed/data/toml/config.toml",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "config",
    "_P2_role": "seed",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "templates",
    "_P3_layer": "b-word/seed/data/json/3block",
    "_P3_includes": "none",
    "_P3_provides": ["JSON_3BLOCK_CONFIG_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "JSONC 3-Block Configuration Template",
    "_P5_brief": "Base template for all JSONC configuration files following OmniCode 3-block structure",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "config.jsonc",
        "key": "B-seed-data-json-3block-config",
        "title": "JSONC 3-Block Configuration Template",
        "type": "Data (Template)",
        "component": "Seed",
        "role": "Anchor template for all JSONC config files — Genesis 1:1 of JSONC structure"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING — "Study to shew thyself approved unto God, a workman that
    //   needeth not to be ashamed, rightly dividing the word of truth." — 2 Timothy 2:15
    "_M4_grounding": {
        "scripture": "2 Timothy 2:15 — Study to shew thyself approved unto God, a workman that needeth not to be ashamed, rightly dividing the word of truth.",
        "principle": "Configuration rightly divided enables systems rightly built. Comments exist to teach, not decorate."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "JSONC parser (JSON parser that strips comments)",
        "consumers": "Any JSONC configuration file in the Kingdom Technology Stack",
        "cross_format": {
            "role": "JSON defines data (what things are). TOML defines configuration (how things work). Both share OmniCode 3-block structure.",
            "toml_source": "seed/data/L0/toml/config.toml — TOML root (this template derives from it)",
            "json_sibling": "seed/data/L0/json/3block/data.json — Pure JSON sibling (same concept, no comments)",
            "relationship": "This JSONC template derives from the TOML root for data expression with comments."
        }
    },

    // M.ext — Extension Contract
    // M1-M5 are the base contract. Derived files inherit all five
    // and may extend with M6+ for content their domain requires.
    // Adding M sections to the BASE template requires a schema version bump.
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "examples": ["_M6_operational (runtime behavior)", "_M7_paradigm (domain philosophy)"],
        "rule": "M1-M5 are the base contract. Derived files inherit all five and may extend with M6+ for content their domain requires. Adding M sections to the BASE template requires a schema version bump."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // JSONC advantage: comments supplement the _ fields with human explanation.
    // Structure lives in _ fields. Explanation lives in comments.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Format rules and conventions for this configuration.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",

    "name": "JSONC 3-Block Configuration Template",
    "type": "template",
    "scope": "global",
    "version": "a-01.00",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Configuration values organized by purpose.
    // Real settings replace this section on instantiation.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "defaults": {
        "encoding": "utf-8",
        "line_endings": "lf",
        "indent": "4 spaces"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Verification commands and expected state.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "npx jsonc-parser validate config.jsonc",
    "_Cv_expected_state": "Valid JSONC with all pragma, metadata, content, and closing blocks present.",
    "_Cv_required_keys": ["name", "type", "scope", "version"],

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Remove pragma or metadata _ fields",
        "Break 3-block structure (pragma → metadata → content → closing)",
        "Remove required _ fields without updating the schema"
    ],
    "_X1_careful": [
        "Changing key names (breaks consuming code)",
        "Changing value types (breaks parsing)",
        "Adding new M sections (requires schema version bump)"
    ],
    "_X1_safe": [
        "Adding settings in Co section",
        "Adding // comments for human explanation",
        "Adding _ documentation fields for machine structure"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Environment-specific override patterns (dev/staging/prod)",
        "JSON Schema $ref composition for shared config blocks"
    ],
    "_X2_considered": [
        "JSONC → JSON stripping tool for production deployment"
    ],

    // X.3 TROUBLESHOOTING
    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "parse error on comments": "Use a JSONC-aware parser. Standard JSON.parse rejects comments. Go: jsonc package. Node: jsonc-parser.",
        "trailing comma error": "JSONC still rejects trailing commas. Remove them.",
        "settings not applied": "Verify consumer reads from correct path. Check key names match struct tags."
    },

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema",
        "b-word/seed/data/json/3block/data.json — Pure JSON sibling (cross-format)",
        "b-word/seed/data/toml/config.toml — TOML root template (cross-format source)",
        "cornerstone/data/base/config-settings.jsonc — JSONC config specialization (child)",
        "root-files/.devcontainer/devcontainer.json — First JSON instance"
    ],
    "_X4_validate": "npx jsonc-parser validate config.jsonc",

    // X.5 NOTE
    // Both JSON and JSONC converge on the same _ field structure.
    // JSONC adds comments for human explanation alongside machine structure.
    // Copy and modify — the template teaches by being complete.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "JSONC base template. Comments supplement _ fields — human explanation alongside machine structure. Both JSON and JSONC converge on the same standard, expressed in each medium's native tongue.",
    "_X5_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X5_anchor": "Structure before content. Boundaries before configuration. This template is the boundary.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
