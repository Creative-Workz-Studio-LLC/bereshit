# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT BLOCK [CONTENT]
# ═══════════════════════════════════════════════════════════════════════════════
#
# Cc — Configuration syntax and loading patterns
# Co — The actual KEY=VALUE pairs organized by category
# Cv — Validation and security verification
#
# IMPORTANT: This is a TEMPLATE — copy to .env and fill in real values.
# NEVER commit .env files with real secrets. Use .env.example with placeholders.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Cc — Syntax Rules and Loading
# ───────────────────────────────────────────────────────────────────────────────
#
# Format Rules:
#   - KEY=value (no spaces around =)
#   - Quotes optional for simple values
#   - Use quotes for values with spaces: KEY="value with spaces"
#   - Comments start with #
#   - Blank lines are ignored
#   - No variable interpolation in most loaders
#
# Loading Order (typical):
#   1. System environment variables (highest priority)
#   2. .env.local (local overrides)
#   3. .env.[environment] (environment-specific)
#   4. .env (base defaults, lowest priority)
#
# Loading Patterns:
#
#   # Node.js
#   require('dotenv').config()
#   process.env.APP_NAME
#
#   # Go
#   godotenv.Load()
#   os.Getenv("APP_NAME")
#
#   # Python
#   from dotenv import load_dotenv
#   load_dotenv()
#   os.getenv('APP_NAME')
#
# File Variants:
#   .env            — Default environment (gitignored)
#   .env.example    — Template with placeholders (committed)
#   .env.local      — Local overrides (gitignored)
#   .env.development — Development settings (gitignored)
#   .env.production  — Production settings (gitignored)
#   .env.test        — Test environment (gitignored)

# ───────────────────────────────────────────────────────────────────────────────
# Co — Environment Variables
# ───────────────────────────────────────────────────────────────────────────────

# ─── Application Configuration ───────────────────────────────────────────────
# Core application settings that vary by environment.

# Application name and environment
APP_NAME=[Your Application Name]
APP_ENV=development
# Options: development, staging, production, test

# Server configuration
PORT=3000
HOST=localhost
# HOST=0.0.0.0 for container/production

# Base URL for the application
APP_URL=http://localhost:3000
# Production: https://yourdomain.com

# ─── Database Configuration ──────────────────────────────────────────────────
# Database connection settings — NEVER commit real credentials!

# Database type
DB_CONNECTION=postgres
# Options: postgres, mysql, sqlite, mongodb

# Connection details
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=[database_name]
DB_USERNAME=[username]
DB_PASSWORD=[password]

# Full connection string (alternative to individual settings)
# DATABASE_URL=postgres://user:password@localhost:5432/database

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Authentication & Security ───────────────────────────────────────────────
# Security-sensitive configuration — MUST be kept secret!

# JWT configuration
JWT_SECRET=[generate-strong-random-secret]
JWT_EXPIRES_IN=24h

# Session configuration
SESSION_SECRET=[generate-strong-random-secret]
SESSION_LIFETIME=86400

# Encryption key (for sensitive data at rest)
ENCRYPTION_KEY=[32-byte-hex-key]

# CORS settings
CORS_ORIGIN=http://localhost:3000
# Production: https://yourdomain.com

# ─── External Services & APIs ────────────────────────────────────────────────
# Third-party service credentials — NEVER commit real keys!

# [Service Name] API
# [SERVICE]_API_KEY=[your-api-key]
# [SERVICE]_API_SECRET=[your-api-secret]
# [SERVICE]_API_URL=https://api.service.com

# Email service
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=[email-username]
MAIL_PASSWORD=[email-password]
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="[Your Application]"

# Cloud storage (S3, GCS, etc.)
STORAGE_DRIVER=local
# Options: local, s3, gcs
# AWS_ACCESS_KEY_ID=[access-key]
# AWS_SECRET_ACCESS_KEY=[secret-key]
# AWS_BUCKET=[bucket-name]
# AWS_REGION=us-east-1

# ─── Logging & Debugging ─────────────────────────────────────────────────────
# Development and debugging configuration.

# Log level
LOG_LEVEL=debug
# Options: debug, info, warn, error

# Debug mode (enables verbose output)
DEBUG=true
# Production: false

# Log output
LOG_OUTPUT=stdout
# Options: stdout, file, both
LOG_FILE=./logs/app.log

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Enable/disable features by environment.

FEATURE_NEW_UI=false
FEATURE_BETA_API=false
FEATURE_ANALYTICS=true

# ─── CPI-SI Configuration ────────────────────────────────────────────────────
# CPI-SI framework configuration for covenant-grounded applications.

# Health scoring
HEALTH_SCORING_ENABLED=true
HEALTH_LOG_LEVEL=info

# Covenant thresholds
CPI_DENIED_THRESHOLD=-50
CPI_GRANTED_THRESHOLD=50

# ─── Project-Specific Configuration ──────────────────────────────────────────
# [Add project-specific environment variables below]

# [EXAMPLE_SERVICE_URL=http://localhost:8080]
# [EXAMPLE_API_KEY=your-key-here]

# ───────────────────────────────────────────────────────────────────────────────
# Cv — Validation and Security
# ───────────────────────────────────────────────────────────────────────────────
#
# Verify environment variables are loaded:
#
#   # Shell
#   source .env && echo $APP_NAME
#
#   # Node.js
#   require('dotenv').config()
#   console.log(process.env.APP_NAME)
#
# Common Issues:
#   "Variable undefined" — Check file is loaded, no typos in key name
#   "Wrong value" — Check loading order, system env may override
#   "Quotes in value" — Some loaders include quotes literally
#   "Spaces break value" — Use quotes: KEY="value with spaces"
#
# Security Checklist (before deploying):
#   - .env is in .gitignore
#   - .env.example has placeholder values only
#   - Real secrets are NEVER in git history
#   - Production secrets use secure secrets manager
#   - API keys are scoped to minimum required permissions
#   - Secrets are rotated periodically
#
# If secrets were accidentally committed:
#   1. Rotate ALL exposed credentials immediately
#   2. Use git filter-branch or BFG to remove from history
#   3. Force push (coordinate with team)
#   4. Review access logs for unauthorized use

# ═══════════════════════════════════════════════════════════════════════════════
# END CONTENT [END]
