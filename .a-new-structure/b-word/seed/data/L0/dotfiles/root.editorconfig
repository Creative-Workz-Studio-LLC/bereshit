# ═══════════════════════════════════════════════════════════════════════════
# CONTENT BLOCK [CONTENT]
# ═══════════════════════════════════════════════════════════════════════════
#
# Cc — Content Configurations
# Format: EditorConfig INI-style — glob patterns map to formatting rules
# Convention: [glob-pattern] followed by key = value settings
# Constraint: Full stack — C, Go, Rust, C#, TypeScript, Python

# ───────────────────────────────────────────────────────────────────────────
# Root Declaration
# ───────────────────────────────────────────────────────────────────────────

root = true

# ───────────────────────────────────────────────────────────────────────────
# Co — Default Settings — All Files
# ───────────────────────────────────────────────────────────────────────────

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ───────────────────────────────────────────────────────────────────────────
# Cv — Language-specific overrides
# ───────────────────────────────────────────────────────────────────────────

# C/C++ — 4 spaces
[*.{c,h,cpp,hpp,cc,hh,cxx,hxx}]
indent_size = 4

# Go — tabs (gofmt standard)
[*.go]
indent_style = tab

# Rust — 4 spaces (rustfmt standard)
[*.rs]
indent_size = 4

# C# — 4 spaces
[*.cs]
indent_size = 4

# TypeScript/JavaScript — 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON/YAML/TOML — 2 spaces
[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

# Markdown — preserve trailing whitespace (for line breaks)
[*.md]
trim_trailing_whitespace = false

# AsciiDoc — 2 spaces
[*.adoc]
indent_size = 2

# Makefiles — must use tabs
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Shell scripts — 4 spaces
[*.sh]
indent_size = 4

# SQL — 2 spaces
[*.sql]
indent_size = 2

# Protocol Buffers — 2 spaces
[*.proto]
indent_size = 2

# ═══════════════════════════════════════════════════════════════════════════
# END CONTENT [END]
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# CLOSING BLOCK [CLOSING]
# ═══════════════════════════════════════════════════════════════════════════
#
# --- X1: Policy ---
# scripture: Remove not the ancient landmark, which thy fathers have set — Proverbs 22:28
# never:
#   - charset = utf-8 (universal standard)
#   - end_of_line = lf (Linux-first principle)
#   - root = true (breaks hierarchy)
#   - Makefile tab requirement (syntax)
#   - 3-block structure (METADATA → CONTENT → CLOSING)
# careful:
#   - Indent style changes for established languages
#   - Go must stay tabs (gofmt)
# safe:
#   - Add new language sections
#   - Adjust indent_size per language
#
# --- X4: Reference ---
# related_files:
#   - template.editorconfig — parent template (source)
#   - compiler-project.editorconfig — compiler-specific variant (sibling)
#   - layer.mk — Bereshit root Makefile
# validate: editorconfig <filename>
# required_sections: root, [*], C/C++, Go, Rust, TypeScript, Makefiles
#
# --- X5: Note ---
# note:      Bereshit root EditorConfig — consistent formatting across the full
#            Kingdom Technology stack from C to C# to Go to TypeScript
# scripture: Let all things be done decently and in order — 1 Corinthians 14:40
# anchor:    Genesis 1:1 anchors everything
#
