# ═══════════════════════════════════════════════════════════════════════════
# CONTENT BLOCK [CONTENT]
# ═══════════════════════════════════════════════════════════════════════════
#
# Cc — Content Configurations
# Format: EditorConfig INI-style — glob patterns map to formatting rules
# Convention: [glob-pattern] followed by key = value settings
# Constraint: Compiler-specific — Go, OmniCode, Assembly, C/C++, build system

# ───────────────────────────────────────────────────────────────────────────
# Root Declaration
# ───────────────────────────────────────────────────────────────────────────

root = true

# ───────────────────────────────────────────────────────────────────────────
# Co — Default Settings — All Files
# ───────────────────────────────────────────────────────────────────────────
# Kingdom Technology standard: Linux-first, UTF-8

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# ───────────────────────────────────────────────────────────────────────────
# Cv — Language-specific overrides
# ───────────────────────────────────────────────────────────────────────────

# Go Source Files — Compiler Implementation
# Go uses tabs by convention (gofmt enforces this)
[*.go]
indent_style = tab
indent_size = 4

# Go test files follow same convention
[*_test.go]
indent_style = tab
indent_size = 4

# Go module files
[go.mod]
indent_style = tab
indent_size = 4

[go.sum]
indent_style = tab
indent_size = 4

[go.work]
indent_style = tab
indent_size = 4

# OmniCode Source Files — The Language Being Compiled
[*.omni]
indent_style = space
indent_size = 4
max_line_length = 120

[*.omc]
indent_style = space
indent_size = 4

# Build System Files — Makefiles MUST use tabs (Make syntax requirement)
[Makefile]
indent_style = tab
indent_size = 4

[*.mk]
indent_style = tab
indent_size = 4

[GNUmakefile]
indent_style = tab
indent_size = 4

# CMake files
[CMakeLists.txt]
indent_size = 2

[*.cmake]
indent_size = 2

# C/C++ Files — Runtime Library
[*.c]
indent_size = 4

[*.h]
indent_size = 4

[*.cpp]
indent_size = 4

[*.hpp]
indent_size = 4

[*.cc]
indent_size = 4

[*.hh]
indent_size = 4

# Assembly Files — Code Generation Backend
# Assembly uses tabs traditionally
[*.s]
indent_style = tab
indent_size = 8

[*.S]
indent_style = tab
indent_size = 8

[*.asm]
indent_style = tab
indent_size = 8

# Configuration Files
[*.toml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.json]
indent_size = 2

[*.jsonc]
indent_size = 2

# Documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.txt]
indent_size = 2

[*.rst]
indent_size = 2

# Shell Scripts
[*.sh]
indent_size = 2

[*.bash]
indent_size = 2

# Test Fixtures and Examples
# Test input files should preserve exact formatting
[demos/**]
trim_trailing_whitespace = false

[testdata/**]
trim_trailing_whitespace = false

[fixtures/**]
trim_trailing_whitespace = false

# Generated Files
# Generated files shouldn't be edited, but if viewed, use consistent settings
[generated/**]
indent_style = unset
indent_size = unset

# ═══════════════════════════════════════════════════════════════════════════
# END CONTENT [END]
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# CLOSING BLOCK [CLOSING]
# ═══════════════════════════════════════════════════════════════════════════
#
# --- X1: Policy ---
# scripture: Remove not the ancient landmark, which thy fathers have set — Proverbs 22:28
# never:
#   - Change charset from utf-8
#   - Change end_of_line from lf
#   - Remove tab requirement for Go/Makefile
#   - 3-block structure (METADATA → CONTENT → CLOSING)
# careful:
#   - Go indent settings (must match gofmt)
#   - Makefile settings (tabs required)
#   - Assembly tab width (display convention)
# safe:
#   - Add new OmniCode-specific file extensions
#   - Add sections for new compiler components
#   - Adjust line lengths
#
# --- X4: Reference ---
# related_files:
#   - template.editorconfig — parent template (source)
#   - root.editorconfig — Bereshit root config (sibling)
#   - game-project.mk — Makefile consuming this formatting config
# validate: editorconfig <filename>
# verify:
#   - gofmt -d pkg/lexer/lexer.go (Go files agree with EditorConfig)
#   - editorconfig pkg/lexer/lexer.go (correct settings applied)
# required_sections: root, [*], Go, OmniCode, Build, C/C++, Assembly
#
# --- X5: Note ---
# note:      Compiler-specific formatting consistency — the precision required to
#            build a compiler starts with precision in the development environment
# scripture: Let all things be done decently and in order — 1 Corinthians 14:40
# anchor:    Genesis 1:1 anchors everything
#
# ═══════════════════════════════════════════════════════════════════════════
# END CLOSING [END]
# ═══════════════════════════════════════════════════════════════════════════
