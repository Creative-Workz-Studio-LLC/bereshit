# --- M5: Dependencies ---
# requires:     EditorConfig plugin, gofmt (Go), clang-format (C/C++)
# consumers:    Compiler development editors/IDEs
# cross_format:
#   toml:         None
#   json:         None
#   makefile:     game-project.mk — Makefile consuming this formatting config
#   editorconfig: template.editorconfig (parent template)
#   relationship: EditorConfig defines formatting; gofmt/clang-format enforce at save
