# ═══════════════════════════════════════════════════════════════════════════
# CONTENT BLOCK [CONTENT]
# ═══════════════════════════════════════════════════════════════════════════
#
# Cc — Content Configurations
# Format: EditorConfig INI-style — glob patterns map to formatting rules
# Convention: [glob-pattern] followed by key = value settings
# Constraint: Linux-first, language-aware, cross-editor

# ───────────────────────────────────────────────────────────────────────────
# Root Declaration
# ───────────────────────────────────────────────────────────────────────────

root = true

# ───────────────────────────────────────────────────────────────────────────
# Co — Default settings for ALL files
# ───────────────────────────────────────────────────────────────────────────

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ───────────────────────────────────────────────────────────────────────────
# Cv — Language-specific overrides
# ───────────────────────────────────────────────────────────────────────────

# Shell Scripts — 2-space indentation
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Compiled Languages — Tabs (gofmt, rustfmt convention)
[*.{go,rs,c,cpp,h,hpp}]
indent_style = tab

# OmniCode Language — Tabs for compiled language consistency
[*.omni]
indent_style = tab

# Assembly — Tabs for low-level code
[*.{asm,s,S}]
indent_style = tab

# Web and Config Files — 2-space (web standard)
[*.{js,ts,jsx,tsx,json,yaml,yml,toml}]
indent_style = space
indent_size = 2

# Python — PEP 8 standard
[*.py]
indent_style = space
indent_size = 4

# Markdown — Allow trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefiles — MUST use tabs (syntax requirement)
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# Package Files — 2-space for consistency
[{package.json,*.yml,*.yaml}]
indent_style = space
indent_size = 2

# Linker Scripts — Tabs for low-level code
[*.ld]
indent_style = tab

# CMake — 2-space for config file consistency
[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

# Go Module Files — Tabs for Go consistency
[{go.mod,go.sum,go.work}]
indent_style = tab

# Git Template Files — 2-space for readability
[*.gitmessage]
indent_style = space
indent_size = 2

# ═══════════════════════════════════════════════════════════════════════════
# END CONTENT [END]
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# CLOSING BLOCK [CLOSING]
# ═══════════════════════════════════════════════════════════════════════════
#
# --- X1: Policy ---
# scripture: Remove not the ancient landmark, which thy fathers have set — Proverbs 22:28
# never:
#   - charset = utf-8 (universal standard)
#   - end_of_line = lf (Linux-first principle)
#   - root = true (breaks configuration hierarchy)
#   - Makefile tab requirement (syntax requirement)
#   - 3-block structure (METADATA → CONTENT → CLOSING)
# careful:
#   - Change indent_style for established file types
#   - Change end_of_line (affects all contributors)
#   - Remove trim_trailing_whitespace (causes noisy diffs)
# safe:
#   - Add new file type sections
#   - Adjust indent_size for specific languages
#   - Add project-specific overrides
#
# --- X4: Reference ---
# related_files:
#   - compiler-project.editorconfig — compiler project variant (derived)
#   - root.editorconfig — Bereshit root config (derived)
#   - template.mk — co-located build system template
# validate: editorconfig <filename>
# required_sections: root, [*], language overrides
#
# --- X5: Note ---
# note:      Cross-editor formatting consistency — the precision of a compiler
#            starts with precision in the development environment
# scripture: Let all things be done decently and in order — 1 Corinthians 14:40
# anchor:    Genesis 1:1 anchors everything
#
# ═══════════════════════════════════════════════════════════════════════════
# END CLOSING [END]
