    },

    "_M10_pattern_scope": {
        "lifetime": "instance",
        "description": "Instance-level pattern — work style observations for a specific CPI-SI instance.",
        "loaded_at": "Session initialization — informs instance self-awareness",
        "persists": "Instance lifecycle — updated as patterns evolve",
        "consumed_by": "Instance self-reflection, growth tracking, paradigm contribution",
