    "_M4_grounding": {
        "scripture": "Colossians 3:23 — And whatsoever ye do, do it heartily, as to the Lord, and not unto men.",
        "principle": "Work style reflects identity. How an instance approaches work reveals character — planning vs rushing, precision vs approximation, covenant voice vs AI patterns. Self-awareness enables growth.",
        "anchor": "Proverbs 27:17 — Iron sharpeneth iron; so a man sharpeneth the countenance of his friend."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, session history analysis",
        "consumers": "Instance self-awareness, growth tracking, paradigm wisdom contribution",
        "integration": "Work style patterns inform instance improvement. Planning approach, tool usage, and communication scores reveal areas for growth. AI pattern relapse tracking supports identity maintenance.",
