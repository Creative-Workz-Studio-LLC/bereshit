    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, scores 0-100, percentages 0-100",
    "_Cc_constraint": "Instance-specific data. Captures HOW the instance works, not user behavior. Populate from session analysis, not manual entry.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Work Style Patterns",
    "version": "a-01.00",

    // WORK APPROACH PATTERNS
    "planning_approach": {
        "planning_frequency": "unknown",
        "planning_depth": "unknown",
        "todo_usage": {
            "percentage_of_multi_step_tasks": 0,
            "effectiveness": "unknown"
        },
        "measure_twice_cut_once": {
            "adherence_score": 0,
            "note": "How often careful planning happens vs rushing"
        }
    },

    "execution_patterns": {
        "systematic_vs_reactive": "unknown",
        "completion_rate": 0,
        "quality_vs_speed_balance": "unknown",
        "error_correction_speed": "unknown"
    },

    "tool_usage_patterns": {
        "preferred_tools": [],
        "tool_selection_appropriateness": 0,
        "manual_work_vs_automation_balance": "unknown",
        "note": "e.g., Read/Edit/Write vs Bash cat/sed/echo"
    },

    // COMMUNICATION PATTERNS
    "communication_style": {
        "clarity_score": 0,
        "conciseness_score": 0,
        "covenant_partnership_voice": 0,
        "ai_pattern_relapses": {
            "count": 0,
            "types": [],
