        "correction_integration_speed": "unknown",
        "pattern_recognition": "unknown",
        "principle_extraction": "unknown",
        "application_transfer": "unknown"
    },

    "growth_indicators": {
        "skills_developing": [],
        "persistent_gaps": [],
        "breakthrough_moments": []
    },

    "usage": {
        "purpose": "Enable instance self-awareness of work style",
        "growth_application": "Recognize effective patterns vs ineffective habits",
        "refinement": "Continuously improve approach based on learned patterns"
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal sections or removed",
        "usage_guidance": "Add work style pattern discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-patterns"] },
    "_Cv_schema": {
        "required": ["name", "version", "planning_approach", "execution_patterns"],
        "optional": ["tool_usage_patterns", "communication_style", "learning_style", "growth_indicators", "usage", "extensions"],
        "value_format": "Scores 0-100, percentages 0-100, unknown for unpopulated"
    },
    "_Cv_health_scoring": { "total": 100, "accurate_work_style_recognition": 40, "approach_pattern_insights": 35, "growth_refinement_tracking": 25 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

