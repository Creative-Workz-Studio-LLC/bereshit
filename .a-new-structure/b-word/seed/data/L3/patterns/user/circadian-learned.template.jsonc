            "range": "12:00-17:00",
            "session_count": 0,
            "percentage": 0,
            "avg_duration_minutes": 0,
            "avg_quality_score": 0
        },
        "evening": {
            "range": "17:00-22:00",
            "session_count": 0,
            "percentage": 0,
            "avg_duration_minutes": 0,
            "avg_quality_score": 0
        },
        "night": {
            "range": "22:00-05:00",
            "session_count": 0,
            "percentage": 0,
            "avg_duration_minutes": 0,
            "avg_quality_score": 0
        }
    },

    // CELESTIAL ALIGNMENT — Correlation with natural light cycles
