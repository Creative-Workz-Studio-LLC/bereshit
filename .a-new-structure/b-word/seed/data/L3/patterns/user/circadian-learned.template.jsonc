    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times 24-hour, percentages 0-100, quality scores 0-100, timezone in IANA format",
    "_Cc_constraint": "Data aggregated from session history. NOT manually populated. Time categories reference regional definitions. Quality scores 0-100.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Circadian Patterns",
    "version": "a-01.00",

    // WORK HOURS — Primary and secondary work windows
    "work_hours": {
        "primary_window": {
            "description": "Most common work period",
            "start_time": "09:00",
            "end_time": "17:00",
            "timezone": "America/Chicago",
            "time_category": "morning",
            "percentage_of_sessions": 0,
            "session_count": 0
