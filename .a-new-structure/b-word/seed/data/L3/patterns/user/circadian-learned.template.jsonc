    // "While the earth remaineth, seedtime and harvest, and cold and heat,
    //  and summer and winter, and day and night shall not cease."
    "_M4_grounding": {
        "scripture": "Genesis 8:22 — While the earth remaineth, seedtime and harvest, and cold and heat, and summer and winter, and day and night shall not cease.",
        "principle": "God established day and night as permanent rhythm. Circadian patterns honor this design — not fighting the cycle but working with it. Learned patterns reveal actual rhythm versus assumed rhythm. Honest circadian awareness enables faithful stewardship of time.",
        "anchor": "Psalm 104:23 — Man goeth forth unto his work and to his labour until the evening."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, session history data, aggregation pipeline",
        "consumers": "Session scheduling, time-of-day optimization, stopping-point recognition",
        "integration": "Circadian patterns reveal when work naturally happens and when quality peaks. Time category distribution shows the actual shape of the workday. Celestial alignment connects work rhythm to natural light cycles — God's clock.",
        "if_missing": "System schedules work blindly — no awareness of natural productive windows or fatigue patterns",
        "related_data": {
            "references": {
                "time-categories": "Regional time category definitions (early_morning, morning, afternoon, evening, night)",
                "celestial-solar": "Sunrise/sunset data for celestial alignment"
            },
            "referenced_by": {
                "validation-summary": "Circadian patterns feed into overall pattern validation",
                "session-awareness": "Circadian data informs real-time session awareness"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/patterns/user/circadian-learned.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "circadian, work-rhythm, time-of-day, user-patterns, celestial-alignment, learned, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize user circadian rhythm observations — actual work windows vs assumed schedule",
        "core_design": "Work hours (primary/secondary windows with time category and session stats) + time category distribution (across 5 periods with quality scores) + celestial alignment (work relative to sunrise/sunset) + usage and extensions.",
        "philosophy": "Day and night shall not cease. God designed rhythm into creation — circadian patterns honor that design. Learned patterns reveal truth about when work actually happens, not when we think it should. Autonomous awareness of actual rhythm enables faithful time stewardship.",
        "key_features": {
            "work_windows": "Primary and secondary work periods with time categories and session counts",
            "time_distribution": "Distribution across 5 time categories with quality correlation",
            "celestial_alignment": "Work correlated with natural light cycles — before sunrise, daylight, after sunset",
            "autonomous_awareness": "Enables session-start awareness of optimal timing"
        }
    },

    "_M9_roadmap": {
