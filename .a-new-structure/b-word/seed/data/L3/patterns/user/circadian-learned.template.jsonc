    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Circadian Learned — User Work Rhythm Patterns",
    "_P5_brief": "Template for aggregating user circadian rhythm patterns from observed session data. Primary and secondary work windows, time category distribution, celestial alignment correlation. Generated from session history, NOT manually created. Enables autonomous awareness of actual work rhythms.",
    "_P5_usage": "cp circadian-learned.template.jsonc patterns/user/<username>/circadian/learned.jsonc -> populate from session aggregation",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
