        "description": "User-level pattern — circadian rhythm observations for a specific user.",
        "loaded_at": "Session initialization — informs time-of-day awareness",
        "persists": "Updated weekly or after significant pattern shifts",
        "consumed_by": "Session scheduling, time-of-day optimization, stopping-point recognition",
        "scope": "user — specific person's observed work rhythm patterns",
