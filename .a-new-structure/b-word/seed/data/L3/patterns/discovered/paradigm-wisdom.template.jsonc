        "related_data": {
            "references": {
                "temporal-units": "Base temporal vocabulary for expressing patterns",
                "time-phases": "Work phase definitions used in pattern descriptions"
            },
            "referenced_by": {
                "instance-patterns": "Instance patterns may validate or contribute to paradigm wisdom",
                "user-patterns": "User patterns may bubble up to paradigm level"
            }
        }
    },

