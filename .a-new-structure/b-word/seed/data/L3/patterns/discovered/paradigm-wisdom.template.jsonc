    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for pattern identifiers",
    "_Cc_constraint": "Evidence-based: 2+ instances or strong single-instance validation. Confidence levels: low, medium, high. Status: experimental, testing, validated, proven.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Paradigm Temporal Wisdom",
    "version": "a-01.00",

    // UNIVERSAL TEMPORAL PRINCIPLES
    "foundational_truths": [
        {
            "principle": "Example: Natural rhythms exist and matter",
            "description": "Detailed description of universal truth",
            "discovered_by": "instance-name",
            "date_discovered": "2025-01-01",
            "biblical_basis": "Scripture reference",
            "application": "How to apply this truth",
            "evidence": "What validates this principle"
        }
    ],

    // PATTERN DISCOVERIES
    "discovered_patterns": [
        {
            "pattern_name": "Example pattern name",
            "description": "What the pattern reveals",
            "instances_observed": ["instance-1", "instance-2"],
            "confidence": "low",
            "actionable_insight": "What to do with this knowledge",
            "status": "experimental"
        }
    ],

    // ANTI-PATTERNS
    "anti_patterns": [
        {
            "anti_pattern_name": "Example anti-pattern",
            "description": "What the harmful pattern looks like",
            "harm": "Why this causes problems",
            "correction": "How to fix or avoid",
            "biblical_warning": "Relevant Scripture warning"
        }
    ],

    // COLLECTIVE WISDOM
    "collective_insights": {
        "note": "Wisdom emerging from multiple instances",
        "wisdom_items": [
            {
                "insight": "Universal insight discovered",
                "source": "Where this came from",
                "application": "How to apply",
                "paradigm_impact": "What this means for CPI-SI"
            }
        ]
    },

    "usage": {
        "purpose": "Share temporal wisdom across all CPI-SI instances",
        "update_trigger": "When universal pattern discovered across multiple instances",
        "evidence_requirement": "Pattern observed in 2+ instances OR strong single-instance validation",
        "kingdom_principle": "Collective wisdom honoring God's created order"
    },

    "extensions": {
        "note": "Experimental patterns and discoveries — may be promoted to formal sections or removed",
        "usage_guidance": "Add paradigm-level temporal discoveries here before promoting to formal sections"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-patterns"] },
    "_Cv_schema": {
        "required": ["name", "version", "foundational_truths"],
        "optional": ["discovered_patterns", "anti_patterns", "collective_insights", "usage", "extensions"],
        "value_format": "Confidence: low/medium/high. Status: experimental/testing/validated/proven."
    },
    "_Cv_health_scoring": { "total": 100, "universal_applicability": 40, "actionable_insights": 35, "biblical_alignment": 25 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

