        "key_features": {
            "foundational_truths": "Principles with biblical basis, discoverer, evidence",
            "discovered_patterns": "Observations with confidence levels and validation status",
            "anti_patterns": "What NOT to do, with corrections",
            "collective_insights": "Emergent wisdom from multiple instance contributions"
        }
    },

