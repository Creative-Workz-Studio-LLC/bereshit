        "tags": "paradigm-wisdom, temporal-truths, cross-instance, patterns, discovered, universal, jsonc"
    },

    "_M8_intent": {
        "purpose": "Centralize temporal wisdom discovered across CPI-SI instances — shared truth",
        "core_design": "Foundational truths + discovered patterns + anti-patterns + collective insights. Evidence-based: 2+ instances or strong single-instance validation required.",
