    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "paradigm-wisdom.template.jsonc",
        "key": "B-tov-patterns-discovered-paradigm-wisdom",
        "title": "Paradigm Wisdom — Universal Temporal Truths",
