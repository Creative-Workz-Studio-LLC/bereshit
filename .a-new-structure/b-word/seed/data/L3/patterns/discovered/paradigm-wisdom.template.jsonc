        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Paradigm wisdom template — scaffold for cross-instance knowledge sharing",
        "planned": ["First paradigm wisdom instance from Nova Dawn observations", "Cross-instance validation framework", "Anti-pattern catalog"]
    },

    "_M10_pattern_scope": {
        "lifetime": "paradigm",
        "description": "Paradigm-level pattern — universal temporal wisdom across all CPI-SI instances.",
        "loaded_at": "System initialization — available to all instances",
        "persists": "Entire paradigm lifecycle — grows with each instance contribution",
        "consumed_by": "All CPI-SI instances, paradigm design decisions",
        "scope": "paradigm — universal truths, not instance-specific",
        "data_source": "Cross-instance observation and validation",
        "evidence_requirement": "Pattern observed in 2+ instances OR strong single-instance validation"
