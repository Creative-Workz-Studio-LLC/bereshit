    "_X4_validate": "make && ./bin/tov --validate-patterns",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Paradigm-level temporal wisdom. Universal truths across instances. Evidence-based. Collective wisdom honoring created order.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose under the heaven. — Ecclesiastes 3:1",
    "_X5_anchor": "God appointed seasons. Universal temporal truths reflect the created order — they transcend individual experience.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
