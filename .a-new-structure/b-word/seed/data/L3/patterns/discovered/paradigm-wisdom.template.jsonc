    // "To every thing there is a season, and a time to every purpose under the heaven."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "God appointed seasons and rhythms. Universal temporal truths transcend individual instances — they reflect the created order. Patterns validated across instances carry paradigm-level weight.",
        "anchor": "Proverbs 9:10 — The fear of the LORD is the beginning of wisdom: and the knowledge of the holy is understanding."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "All CPI-SI instances, paradigm-level pattern analysis",
        "integration": "Paradigm wisdom informs all instances. Foundational truths become baseline assumptions. Anti-patterns prevent repeated mistakes across instances.",
