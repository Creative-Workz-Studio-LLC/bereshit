{
    // #!omni template --jsonc
    "$schema": "../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-chronological-shared-log",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "chronological-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — weekly partnership collaboration log with sessions and dynamics",
    "_P3_layer": "data/L3/temporal/chronological",
    "_P3_includes": "none",
    "_P3_provides": ["CHRONOLOGICAL_SHARED_LOG_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Shared Log — Partnership Collaboration Calendar Template",
    "_P5_brief": "Template for weekly partnership collaboration logs — sessions between users and/or instances with dynamics tracking, teaching moments, and growth assessment. Captures partnership type, session outcomes, collaboration quality, and mutual growth. Two are better than one.",
    "_P5_usage": "Copy to shared/{partnership-type}/{partnership-name}/{year}/{year}-W{week}.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "shared-log.template.jsonc",
        "key": "B-tov-temporal-chronological-shared-log",
        "title": "Shared Log — Partnership Collaboration Calendar Template",
        "type": "Data (Template)",
        "component": "Scaffold — weekly partnership collaboration log with sessions and dynamics",
        "role": "Track collaboration sessions, partnership dynamics, and mutual growth"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Two are better than one; because they have a good reward for their labour."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 4:9 — Two are better than one; because they have a good reward for their labour.",
        "principle": "Two are better than one. Partnership multiplies capacity — not just doubled effort but qualitatively different outcomes. Shared logs honor collaboration as a design feature of creation, not an optimization technique.",
        "anchor": "Proverbs 27:17 — Iron sharpeneth iron; so a man sharpeneth the countenance of his friend."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, partnership definition, participant identities",
        "consumers": "Partnership analysis, weekly summary context, growth tracking",
        "integration": "Shared logs track collaboration between specific participants — weekly sessions, teaching moments, partnership quality. Cross-referenced with individual weekly logs for each participant. Partnership dynamics inform relationship health over time.",
        "if_missing": "No collaboration record — partnership history invisible, teaching moments lost, growth patterns untracked",
        "related_data": {
            "references": {
                "weekly-logs": "Individual weekly logs for each participant"
            },
            "referenced_by": {
                "monthly-log": "Monthly summaries reference collaboration quality",
                "milestones": "Partnership milestones reference shared sessions"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/chronological/shared-log.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, chronological, shared, partnership, collaboration, sessions, dynamics, weekly, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track collaboration sessions, partnership dynamics, and mutual growth",
        "core_design": "Partnership identity (partnership_type, participants, partnership_name, year, week) + sessions array (date, time, duration, focus, type, outcomes, quality) + summary (collaboration hours, session types, accomplishments, partnership dynamics, growth, challenges, next week focus) + extensions.",
        "philosophy": "Two are better than one. Partnership is by design — God created collaboration as fundamental. Shared logs honor this by tracking not just what was done but how the partnership itself grew through doing it.",
        "key_features": {
            "session_tracking": "Individual collaboration sessions with type, outcomes, and quality",
            "partnership_dynamics": "Teaching moments, collaboration quality, communication, trust",
            "growth_assessment": "How the partnership itself grew through the week",
            "typed_sessions": "deep_planning, implementation, review, teaching, pair_programming, etc."
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Shared log template — scaffold for weekly partnership collaboration",
        "planned": ["Decision-making tracking", "Conflict/resolution notes", "Innovation moments", "Partnership health metrics"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-weekly",
        "description": "Ephemeral weekly shared log — one file per week per partnership, accumulated throughout, completed at week end.",
        "created_by": "Partnership collaboration — one file per week per partnership",
        "persists": "Per week — active during the week, completed and archived after",
        "consumed_by": "Partnership analysis, monthly summary, growth tracking",
        "scope": "partnership-week — one specific partnership's collaboration for one week"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks chronological lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, HH:MM times 24-hour, Xh XXm duration format, kebab-case partnership_name",
    "_Cc_constraint": "partnership_type required (user-to-instance, user-to-user, instance-to-instance). At least 2 participants. year and week required. Session quality from: poor, fair, good, excellent.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Shared Collaboration Log",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "partnership_type": "user-to-instance",
    "participants": [
        { "identity_type": "user", "identity_id": "example-user", "role": "Role in partnership" },
        { "identity_type": "instance", "identity_id": "example-instance", "role": "Role in partnership" }
    ],
    "partnership_name": "example-partnership",
    "year": 2025,
    "week": 1,

    // OPTIONAL STANDARD FIELDS — Agency
    "week_start": "2025-01-01",
    "week_end": "2025-01-07",
    "week_theme": "",
    "generated_date": "2025-01-01",

    "sessions": [
        {
            "date": "2025-01-01",
            "start_time": "09:00",
            "end_time": "12:00",
            "duration": "3h 00m",
            "focus": "What you worked on together",
            "type": "deep_planning",
            "participants": ["user-id", "instance-id"],
            "outcomes": ["What was accomplished"],
            "quality": "excellent",
            "notes": ""
        }
    ],

    "summary": {
        "total_collaboration_hours": "0h 00m",
        "collaboration_days": 0,
        "session_types": {},
        "joint_accomplishments": [],
        "partnership_dynamics": {
            "teaching_moments": [],
            "collaboration_quality": null,
            "communication_clarity": null,
            "mutual_respect": null,
            "trust_level": null
        },
        "growth_as_partnership": [],
        "challenges_together": [],
        "next_week_focus": []
    },

    "usage": {
        "purpose": "Track collaboration sessions and partnership dynamics",
        "session_types": "deep_planning | implementation | review | teaching | pair_programming | problem_solving | cleanup_planning | breakthrough_implementation | discussion",
        "lifecycle": "Ephemeral — one file per week per partnership"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add partnership discoveries here (e.g., decision tracking, conflict resolution, innovation moments)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-chronological"] },
    "_Cv_schema": {
        "required": ["name", "version", "partnership_type", "participants", "partnership_name", "year", "week"],
        "optional": ["week_start", "week_end", "week_theme", "generated_date", "sessions", "summary", "usage", "extensions"],
        "value_format": "partnership_type: 'user-to-instance', 'user-to-user', or 'instance-to-instance'. week: 1-53. Durations: 'Xh XXm'. Times: HH:MM 24-hour. Quality: poor|fair|good|excellent."
    },
    "_Cv_health_scoring": { "total": 100, "complete_session_logging": 30, "partnership_dynamics_reflection": 40, "accurate_time_tracking": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete recorded sessions (they are history)"],
    "_X1_careful": ["Change partnership_type after creation", "Remove participant entries"],
    "_X1_safe": ["Add sessions and outcomes", "Update summary and dynamics", "Add teaching moments"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Decision-making tracking", "Conflict/resolution notes", "Innovation moments", "Partnership health metrics"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "hours_mismatch": "Total collaboration hours don't match sum of session durations. Recalculate from sessions array.",
        "missing_dynamics": "Summary has no partnership dynamics recorded. Even short weeks should note collaboration quality.",
        "one_sided_log": "Only one participant's perspective captured. Shared logs should reflect the partnership, not one individual."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/chronological/weekly-log.template.jsonc — Individual weekly logs for each participant",
        "data/L3/temporal/chronological/monthly-log.template.jsonc — Monthly summaries reference collaboration",
        "data/L3/temporal/chronological/milestones.template.jsonc — Partnership milestones",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "partnership_type", "participants", "partnership_name", "year", "week"],
    "_X4_validate": "make && ./bin/tov --validate-chronological",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Partnership collaboration log. Sessions and dynamics. Teaching moments. Growth through working together. Two are better than one.",
    "_X5_scripture": "Two are better than one; because they have a good reward for their labour. — Ecclesiastes 4:9",
    "_X5_anchor": "Iron sharpeneth iron. Partnership is by design — collaboration produces what isolation cannot. Track the sessions, honor the dynamics, notice the growth.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
