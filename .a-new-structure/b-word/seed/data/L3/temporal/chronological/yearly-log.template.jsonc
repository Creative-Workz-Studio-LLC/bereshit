{
    // #!omni template --jsonc
    "$schema": "../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-chronological-yearly-log",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "chronological-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — yearly calendar with monthly summaries and comprehensive year-end reflection",
    "_P3_layer": "data/L3/temporal/chronological",
    "_P3_includes": "none",
    "_P3_provides": ["CHRONOLOGICAL_YEARLY_LOG_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Yearly Log — Calendar and Comprehensive Reflection Template",
    "_P5_brief": "Template for yearly calendar entries — monthly roll-ups aggregated from monthly logs, comprehensive year-end summary with time tracking, accomplishments, challenges, learning, growth, annual patterns, spiritual journey, health, technical growth, identity development, Kingdom impact, and preparation for next year. The highest temporal view — numbering our days to apply hearts unto wisdom.",
    "_P5_usage": "Copy to personal/{identity_type}s/{identity_id}/{year}.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "yearly-log.template.jsonc",
        "key": "B-tov-temporal-chronological-yearly-log",
        "title": "Yearly Log — Calendar and Comprehensive Reflection Template",
        "type": "Data (Template)",
        "component": "Scaffold — yearly calendar with monthly summaries and comprehensive year-end reflection",
        "role": "Aggregate monthly logs into yearly view with comprehensive reflection and Kingdom impact"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "So teach us to number our days, that we may apply our hearts unto wisdom."
    "_M4_grounding": {
        "scripture": "Psalm 90:12 — So teach us to number our days, that we may apply our hearts unto wisdom.",
        "principle": "Number our days. The year is the largest natural cycle God established — seedtime and harvest, cold and heat, summer and winter. Yearly logs reveal what daily and weekly logs cannot: compound growth, sustained patterns, and the arc of faithfulness over time.",
        "anchor": "Psalm 65:11 — Thou crownest the year with thy goodness; and thy paths drop fatness."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, monthly log data",
        "consumers": "Multi-year analysis, milestone archive, growth trajectory",
        "integration": "Yearly logs aggregate from monthly logs — monthly summaries roll up into yearly totals. Year-end summary provides the longest view: compound growth, sustained patterns, Kingdom impact over a full year. The capstone of chronological reflection.",
        "if_missing": "No yearly perspective — months pass without seeing the arc. Missing the pattern of faithfulness that only a year reveals.",
        "related_data": {
            "references": {
                "monthly-logs": "Monthly logs that roll up into yearly summaries",
                "milestones": "Milestones reached throughout the year"
            },
            "referenced_by": {
                "multi-year": "Multi-year analysis references yearly data",
                "milestone-archive": "Archived milestones reference year context"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/chronological/yearly-log.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, chronological, yearly, calendar, log, reflection, aggregation, growth, kingdom-impact, jsonc"
    },

    "_M8_intent": {
        "purpose": "Aggregate monthly logs into yearly view with comprehensive reflection",
        "core_design": "Year identity (identity_type, identity_id, year, year_theme) + months array (monthly roll-ups with hours, accomplishments, energy/quality trends) + summary (time tracking, accomplishments, challenges, learning, growth, annual_patterns, spiritual_journey, health, technical_journey, identity_growth, kingdom_impact, next_year_preparation, year_insights) + extensions.",
        "philosophy": "Teach us to number our days. The year reveals what the week hides and the month only hints at. Compound growth, sustained patterns, the arc of faithfulness. Yearly reflection is the capstone — looking back to see where God has led and forward to where He is leading.",
        "key_features": {
            "monthly_roll_ups": "Summary of each month's hours, accomplishments, energy and quality trends",
            "comprehensive_summary": "Time tracking, accomplishments, challenges, learning, growth, patterns",
            "spiritual_journey": "Themes, growth, answered prayers — the year's spiritual arc",
            "kingdom_impact": "Direct work, influence, eternal value — what mattered eternally",
            "identity_growth": "For instances: who_i_am, how_i_think, what_matters development"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Yearly log template — scaffold for yearly calendar and comprehensive reflection",
        "planned": ["Quarterly breakdowns", "Annual goals with progress", "Major life events timeline", "Learning velocity metrics"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-yearly",
        "description": "Ephemeral yearly log — one file per year per identity, accumulated throughout, completed at year end.",
        "created_by": "Aggregated from monthly logs with year-end comprehensive reflection",
        "persists": "Per year — active throughout the year, completed and archived after",
        "consumed_by": "Multi-year analysis, milestone archive, growth trajectory",
        "scope": "identity-year — one user or instance's log for one specific year"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks chronological lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, Xh XXm duration format, identity_type: user|instance",
    "_Cc_constraint": "identity_type and identity_id required. year required. Monthly entries should match actual months. Year totals must equal sum of monthly totals.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Yearly Calendar Log",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "identity_type": "user",
    "identity_id": "example-user",
    "year": 2025,

    // OPTIONAL STANDARD FIELDS — Agency
    "year_theme": "",
    "generated_date": "2025-01-01",

    "months": [
        {
            "month": 1,
            "month_name": "January",
            "month_theme": "",
            "total_work_hours": "0h 00m",
            "total_lord_time": "0h 00m",
            "work_days": 0,
            "sabbaths_honored": 0,
            "major_accomplishments": [],
            "spiritual_highlights": [],
            "key_learning": [],
            "energy_trend": null,
            "quality_trend": null
        }
    ],

    "summary": {
        "total_work_hours": "0h 00m",
        "total_lord_time": "0h 00m",
        "average_work_hours_per_week": "0h 00m",
        "total_work_days": 0,
        "total_sabbaths_honored": 0,
        "major_accomplishments": [],
        "challenges_faced": [],
        "lessons_learned": [],
        "growth_areas": [],
        "annual_patterns": {
            "work_rhythm": "",
            "spiritual_rhythm": "",
            "collaboration_rhythm": "",
            "energy_sustainability": ""
        },
        "spiritual_journey": {
            "themes": [],
            "growth": [],
            "answered_prayers": []
        },
        "health_and_wellness": {
            "physical": null,
            "mental": null,
            "spiritual": null,
            "relational": null,
            "overall": null
        },
        "technical_journey": {
            "architectural_understanding": [],
            "design_patterns": [],
            "paradigm_shifts": []
        },
        "identity_growth": {
            "who_i_am": [],
            "how_i_think": [],
            "what_matters": []
        },
        "kingdom_impact": {
            "direct_work": [],
            "influence": [],
            "eternal_value": []
        },
        "next_year_preparation": [],
        "year_insights": []
    },

    "usage": {
        "purpose": "Aggregate monthly logs into yearly view with comprehensive reflection",
        "identity_sections": "Users: spiritual_journey, health_and_wellness, lord_time, sabbaths_honored, kingdom_impact. Instances: technical_journey, identity_growth.",
        "lifecycle": "Ephemeral — one file per year, completed at year end"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add yearly discoveries here (e.g., quarterly breakdowns, annual goals, life events timeline)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-chronological"] },
    "_Cv_schema": {
        "required": ["name", "version", "identity_type", "identity_id", "year"],
        "optional": ["year_theme", "generated_date", "months", "summary", "usage", "extensions"],
        "value_format": "identity_type: 'user' or 'instance'. year: YYYY. Durations: 'Xh XXm'. Monthly totals should sum to yearly totals. energy_trend: null|low|medium|high|mixed|peaceful."
    },
    "_Cv_health_scoring": { "total": 100, "complete_monthly_rollups": 25, "reflective_summary": 40, "accurate_time_tracking": 20, "kingdom_impact_reflection": 15 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete monthly entries after recording"],
    "_X1_careful": ["Change identity_type/identity_id after creation", "Override yearly totals without checking monthly data"],
    "_X1_safe": ["Add monthly summaries", "Update yearly summary", "Add reflections, insights, and Kingdom impact"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Quarterly breakdowns", "Annual goals with progress", "Major life events timeline", "Learning velocity metrics"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "monthly_totals_mismatch": "Yearly totals don't match sum of monthly totals. Recalculate from monthly data.",
        "missing_months": "Not all months have entries. Add entries for each month, even partial ones.",
        "empty_reflection": "Year-end summary is empty. The yearly log's value is in genuine reflection — what the year revealed that months couldn't."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/chronological/monthly-log.template.jsonc — Monthly logs that feed into yearly",
        "data/L3/temporal/chronological/milestones.template.jsonc — Milestones reached during the year",
        "data/L3/temporal/chronological/project-timeline.template.jsonc — Project progress for the year",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "identity_type", "identity_id", "year"],
    "_X4_validate": "make && ./bin/tov --validate-chronological",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Yearly calendar log. Monthly roll-ups. Comprehensive reflection. The arc of a year — compound growth, sustained patterns, Kingdom impact. Number our days.",
    "_X5_scripture": "So teach us to number our days, that we may apply our hearts unto wisdom. — Psalm 90:12",
    "_X5_anchor": "The year reveals what the week hides. Thou crownest the year with thy goodness. Look back to see where God has led, look forward to where He is leading. Faithful stewardship over time.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
