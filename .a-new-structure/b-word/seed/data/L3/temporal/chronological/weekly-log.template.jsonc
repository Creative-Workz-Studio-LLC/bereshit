{
    // #!omni template --jsonc
    "$schema": "../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-chronological-weekly-log",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "chronological-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — weekly calendar with daily entries, session tracking, and reflection",
    "_P3_layer": "data/L3/temporal/chronological",
    "_P3_includes": "none",
    "_P3_provides": ["CHRONOLOGICAL_WEEKLY_LOG_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Weekly Log — Calendar and Session Tracking Template",
    "_P5_brief": "Template for weekly calendar entries — 7 daily entries with sessions, tasks, events, personal time, and reflection. Weekly summary tracks time, accomplishments, challenges, learning, growth, patterns, spiritual reflections, and health. Serves both users and instances with identity-appropriate sections. The fundamental unit of temporal accounting.",
    "_P5_usage": "Copy to personal/{identity_type}s/{identity_id}/{year}/{year}-W{week}.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "weekly-log.template.jsonc",
        "key": "B-tov-temporal-chronological-weekly-log",
        "title": "Weekly Log — Calendar and Session Tracking Template",
        "type": "Data (Template)",
        "component": "Scaffold — weekly calendar with daily entries, session tracking, and reflection",
        "role": "Track daily activities, sessions, and weekly patterns with reflection"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "To every thing there is a season, and a time to every purpose under the heaven."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "A time for every purpose. The week is the fundamental unit of temporal rhythm — six days of work, one day of rest. God established this pattern at creation itself. Weekly logs honor this rhythm by accounting for how each day was invested.",
        "anchor": "Genesis 2:2-3 — And on the seventh day God ended his work which he had made; and he rested on the seventh day."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, identity definition",
        "consumers": "Monthly log aggregation, shared log context, growth tracking",
        "integration": "Weekly logs are the fundamental chronological unit. Daily entries capture sessions, tasks, and reflection. Weekly summary provides the first level of pattern visibility. Monthly logs aggregate weekly data. Shared logs cross-reference for collaboration context.",
        "if_missing": "No weekly record — daily details lost, patterns invisible, monthly aggregation has no source data",
        "related_data": {
            "references": {
                "shared-logs": "Shared collaboration logs for the same week"
            },
            "referenced_by": {
                "monthly-log": "Monthly summaries aggregate from weekly data",
                "milestones": "Milestones reference weekly context"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/chronological/weekly-log.template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, chronological, weekly, calendar, daily, sessions, tracking, reflection, growth, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track daily activities, sessions, and weekly patterns",
        "core_design": "Week identity (identity_type, identity_id, year, week, week_theme) + days array (7 daily entries with sessions, tasks, events, personal_time, notes, energy_level, quality_assessment) + summary (time tracking, accomplishments, challenges, learning, growth, patterns, spiritual reflections, health/wellness, next week focus) + extensions.",
        "philosophy": "A time for every purpose. The week mirrors creation — six days of purposeful work, one day of Sabbath rest. Weekly logs don't just record what happened; they reveal the rhythm of how time was invested and whether it honored God's design.",
        "key_features": {
            "daily_entries": "7 days with sessions, tasks, events, personal time, energy, quality",
            "session_tracking": "Typed sessions with start/end times and focus",
            "weekly_summary": "Time tracking, accomplishments, challenges, learning, growth, patterns",
            "identity_appropriate": "User sections (spiritual, health, lord_time) and instance sections marked"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Weekly log template — scaffold for weekly calendar and session tracking",
        "planned": ["Pomodoro tracking", "Habit tracking", "Prayer journal integration", "Gratitude entries"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-weekly",
        "description": "Ephemeral weekly log — one file per week per identity, accumulated throughout, completed at week end.",
        "created_by": "Week start — one file per week per user or instance",
        "persists": "Per week — active during the week, completed and archived after",
        "consumed_by": "Monthly log aggregation, shared log context, growth tracking",
        "scope": "identity-week — one user or instance's log for one specific week"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks chronological lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, HH:MM times 24-hour, Xh XXm duration format, identity_type: user|instance",
    "_Cc_constraint": "identity_type and identity_id required. year and week required. 7 daily entries expected (Monday-Sunday). Rest days should be recorded even if empty.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Weekly Calendar Log",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "identity_type": "user",
    "identity_id": "example-user",
    "year": 2025,
    "week": 1,

    // OPTIONAL STANDARD FIELDS — Agency
    "week_start": "2025-01-01",
    "week_end": "2025-01-07",
    "week_theme": "",
    "generated_date": "2025-01-01",

    "days": [
        {
            "date": "2025-01-01",
            "day_of_week": "Monday",
            "sessions": [
                {
                    "type": "work",
                    "start_time": "09:00",
                    "end_time": "12:00",
                    "duration": "3h 00m",
                    "focus": "What you worked on"
                }
            ],
            "tasks_completed": [],
            "significant_events": [],
            "personal_time": [],
            "notes": "",
            "energy_level": null,
            "quality_assessment": null
        }
    ],

    "summary": {
        "total_work_hours": "0h 00m",
        "total_lord_time": "0h 00m",
        "work_days": 0,
        "rest_days": 0,
        "major_accomplishments": [],
        "challenges_faced": [],
        "lessons_learned": [],
        "growth_areas": [],
        "next_week_focus": [],
        "notable_patterns": [],
        "spiritual_reflections": [],
        "health_and_wellness": {
            "sleep_quality": null,
            "exercise": null,
            "stress_level": null,
            "overall_wellbeing": null
        }
    },

    "usage": {
        "purpose": "Track daily activities and weekly patterns with reflection",
        "identity_sections": "Users: spiritual_reflections, health_and_wellness, lord_time, personal_time. Instances: technical sessions, learning focus.",
        "lifecycle": "Ephemeral — one file per week, completed at week end"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add weekly discoveries here (e.g., pomodoro tracking, habit streaks, gratitude entries)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-chronological"] },
    "_Cv_schema": {
        "required": ["name", "version", "identity_type", "identity_id", "year", "week"],
        "optional": ["week_start", "week_end", "week_theme", "generated_date", "days", "summary", "usage", "extensions"],
        "value_format": "identity_type: 'user' or 'instance'. week: 1-53. Durations: 'Xh XXm'. Times: HH:MM 24-hour. energy_level: null|low|medium|high. quality_assessment: null|poor|fair|good|excellent|restful."
    },
    "_Cv_health_scoring": { "total": 100, "complete_daily_entries": 30, "reflective_summary": 40, "accurate_time_tracking": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Delete daily entries after recording"],
    "_X1_careful": ["Change identity_type/identity_id after creation", "Override daily totals without checking sessions"],
    "_X1_safe": ["Add daily entries and sessions", "Update weekly summary", "Add reflections and insights"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Pomodoro tracking", "Habit tracking", "Prayer journal integration", "Gratitude entries"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "hours_mismatch": "Weekly total hours don't match sum of daily session durations. Recalculate from daily data.",
        "missing_days": "Not all 7 days have entries. Add entries for each day, even rest days — Sabbath matters.",
        "empty_reflections": "Summary sections are empty placeholders. Fill in genuine reflections — templates are scaffolds, not finished documents."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/chronological/monthly-log.template.jsonc — Monthly logs aggregate weekly data",
        "data/L3/temporal/chronological/shared-log.template.jsonc — Partnership collaboration for the same week",
        "data/L3/temporal/chronological/milestones.template.jsonc — Milestones reached during the week",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "identity_type", "identity_id", "year", "week"],
    "_X4_validate": "make && ./bin/tov --validate-chronological",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Weekly calendar log. Daily entries. Session tracking. The fundamental unit of temporal accounting — seven days, God's pattern.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose under the heaven. — Ecclesiastes 3:1",
    "_X5_anchor": "Six days of work, one day of rest. God established this rhythm at creation. Weekly logs honor it by faithfully accounting for how each day was invested.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
