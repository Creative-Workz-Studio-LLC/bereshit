{
    // #!omni template --jsonc
    "$schema": "../../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-coordination-appointment",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — coordinated appointment tracking between multiple identities",
    "_P3_layer": "data/L3/temporal/appointed/coordination",
    "_P3_includes": "none",
    "_P3_provides": ["COORDINATION_APPOINTMENT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Coordination Appointment — Multi-Identity Scheduling Template",
    "_P5_brief": "Template for tracking coordinated appointments between multiple identities (user-to-instance, user-to-user, instance-to-instance). Bridges separate schedules into shared commitment — participants, timing, context, status tracking, and outcome recording.",
    "_P5_usage": "Created when coordinating shared time between identities — not unilateral scheduling",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "coordination-appointment-template.jsonc",
        "key": "B-tov-temporal-appointed-coordination-appointment",
        "title": "Coordination Appointment — Multi-Identity Scheduling Template",
        "type": "Data (Template)",
        "component": "Scaffold — coordinated appointment tracking between multiple identities",
        "role": "Bridge separate schedules into shared commitment through coordinated scheduling"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "For where two or three are gathered together in my name, there am I in the midst of them."
    "_M4_grounding": {
        "scripture": "Matthew 18:20 — For where two or three are gathered together in my name, there am I in the midst of them.",
        "principle": "Coordination is gathering — multiple identities aligning schedules for shared purpose. Not mere scheduling, but covenant commitment. When we coordinate, we honor each other's time and create space for collaboration that exceeds what either could do alone.",
        "anchor": "Ecclesiastes 4:9 — Two are better than one; because they have a good reward for their labour."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, participant identity configs, appointment definitions from both sides",
        "consumers": "Schedule conflict detection, availability tracking, session planning",
        "integration": "Coordination appointments bridge two or more identity schedules. They reference appointment definitions from each participant's config and track mutual acceptance, shared timing, and outcome. Created when identities need shared time — not for unilateral scheduling.",
        "if_missing": "No shared scheduling — identities schedule independently, collaboration happens ad hoc",
        "related_data": {
            "references": {
                "instance-appointments": "Instance appointment definitions being coordinated",
                "user-appointments": "User appointment definitions being coordinated"
            },
            "referenced_by": {
                "daily-schedule": "Daily views reference coordination appointments",
                "session-current": "Active sessions may reference coordination context"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/coordination/coordination-appointment-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, coordination, scheduling, multi-identity, collaboration, participants, jsonc"
    },

    "_M8_intent": {
        "purpose": "Bridge separate identity schedules into shared coordinated commitment",
        "core_design": "Coordination identity (id, type, category, created_by, status) + participants array (identity_type, identity_id, acceptance status, notes) + appointment details (title, description, date, time, duration, timezone, recurrence) + context (purpose, work_type, timing_rationale, preparation, expected_outcome) + tracking (reminders, started/completed, actual duration, outcome).",
        "philosophy": "Gathering is more than proximity. Coordination honors both parties — their time, their rhythms, their purpose. When two or three gather with intention, the collaboration exceeds what either could produce alone.",
        "key_features": {
            "coordination_types": "user-to-instance, user-to-user, instance-to-instance",
            "participant_tracking": "Each participant accepts/declines with notes",
            "outcome_recording": "Track what actually happened vs what was planned",
            "context_preservation": "Why this coordination exists, what it aims to produce"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Coordination appointment template — scaffold for multi-identity scheduling",
        "planned": ["Automated conflict detection", "Recurring coordination patterns", "Outcome-based scheduling optimization"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "coordination",
        "description": "Coordination appointment — bridges identities for shared time commitment.",
        "created_by": "Either participant initiating shared scheduling",
        "persists": "Per coordination event — active during scheduling, archived after completion",
        "consumed_by": "Schedule views, session planning, availability tracking",
        "scope": "cross-identity — bridges two or more identity schedules"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO-8601 timestamps, type enum, status enum",
    "_Cc_constraint": "Coordination identity and participants required. Minimum 2 participants. Each participant must have acceptance status.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Coordination Appointment",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "coordination_id": "unique-identifier",
    "coordination_type": "user-to-instance",
    "coordination_category": "collaboration",
    "created_by": {
        "identity_type": "user",
        "identity_id": "seanje-lenox-wise"
    },
    "status": "scheduled",

    // OPTIONAL STANDARD FIELDS — Agency
    "participants": [
        {
            "identity_type": "user",
            "identity_id": "seanje-lenox-wise",
            "status": "accepted",
            "response_at": "2025-01-01T00:00:00Z",
            "notes": ""
        },
        {
            "identity_type": "instance",
            "identity_id": "nova_dawn",
            "status": "accepted",
            "response_at": "2025-01-01T00:00:00Z",
            "notes": ""
        }
    ],

    "appointment": {
        "title": "Coordination Title",
        "description": "Purpose of this coordinated time",
        "date": "2025-01-01",
        "start_time": "21:00",
        "end_time": "01:00",
        "duration_minutes": 240,
        "timezone": "America/Chicago",
        "location": "",
        "category_id": "collaboration",
        "recurrence": null
    },

    "context": {
        "purpose": "Why this coordination exists",
        "work_type": "Type of work planned",
        "timing_rationale": "Why this time was chosen",
        "environment": "Context for the collaboration",
        "preparation_notes": "What to prepare before",
        "expected_outcome": "What we aim to produce"
    },

    "tracking": {
        "reminder_sent": false,
        "reminders": [],
        "started_at": null,
        "completed_at": null,
        "actual_duration_minutes": null,
        "outcome_notes": ""
    },

    "usage": {
        "purpose": "Coordinate shared time between identities",
        "coordination_types": "user-to-instance | user-to-user | instance-to-instance",
        "status_values": "proposed | scheduled | in-progress | completed | cancelled",
        "participant_status_values": "pending | accepted | declined | tentative",
        "lifecycle": "Per coordination event — active during scheduling, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add coordination discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "coordination_id", "coordination_type", "coordination_category", "created_by", "status", "participants"],
        "optional": ["appointment", "context", "tracking", "usage", "extensions"],
        "value_format": "coordination_type: user-to-instance/user-to-user/instance-to-instance. status: proposed/scheduled/in-progress/completed/cancelled."
    },
    "_Cv_health_scoring": { "total": 100, "complete_participant_list": 35, "clear_coordination_context": 35, "outcome_tracking": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove participants from active coordination (cancel instead)"],
    "_X1_careful": ["Change coordination_type after creation (may invalidate participant relationships)", "Override participant acceptance status without their input"],
    "_X1_safe": ["Update tracking fields as coordination progresses", "Add context details", "Record outcome notes"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated conflict detection", "Recurring coordination patterns", "Outcome-based scheduling optimization"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "schedule_conflict": "Participants have overlapping appointments. Check both schedules before proposing coordination time.",
        "no_response": "Participant hasn't responded. Follow up — coordination requires mutual acceptance.",
        "outcome_not_recorded": "Coordination completed but outcome_notes empty. Record what happened while context is fresh."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/appointed/instances/appointment-template.jsonc — Instance appointment definitions",
        "data/L3/temporal/appointed/users/appointment-template.jsonc — User appointment definitions",
        "data/L3/temporal/appointed/instances/daily-template.jsonc — Instance daily schedule view",
        "data/L3/temporal/appointed/users/daily-template.jsonc — User daily schedule view",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "coordination_id", "coordination_type", "coordination_category", "created_by", "status", "participants"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Coordinated appointments. Multi-identity scheduling. Mutual commitment. Gathering with purpose. Outcome tracking.",
    "_X5_scripture": "Two are better than one; because they have a good reward for their labour. — Ecclesiastes 4:9",
    "_X5_anchor": "Coordination is covenant in miniature — shared commitment, mutual respect for time, purposeful gathering that produces more than either alone.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
