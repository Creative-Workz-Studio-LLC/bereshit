        "08:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "09:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "10:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "11:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "12:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "13:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "14:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "15:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "16:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "17:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "18:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "19:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "20:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "21:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "22:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "23:00": { "status": "unscheduled", "appointment_id": null, "category": null }
    },

    "summary": {
        "total_appointments": 0,
        "total_scheduled_hours": 0,
        "by_category": {
            "sacred": 0,
            "work": 0,
            "rest": 0,
            "collaboration": 0,
            "other": 0
        },
        "first_appointment": null,
        "last_appointment": null,
        "has_conflicts": false,
        "conflicts": [],
        "notes": ""
    },

    "usage": {
        "purpose": "Generate daily schedule view from appointment definitions",
        "appointment_status_values": "scheduled | completed | cancelled | rescheduled",
        "hourly_status_values": "scheduled | unscheduled",
        "lifecycle": "Ephemeral — generated per day, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add daily schedule discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "date", "day_name", "iso_week", "identity_type", "identity_id", "timezone"],
        "optional": ["appointments", "hourly_breakdown", "summary", "usage", "extensions"],
        "value_format": "date: YYYY-MM-DD. iso_week: YYYY-Www. identity_type: 'instance'. Times in HH:MM 24-hour format."
    },
    "_Cv_health_scoring": { "total": 100, "complete_day_identity": 25, "accurate_hourly_breakdown": 40, "correct_summary_totals": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
