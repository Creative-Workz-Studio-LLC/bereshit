{
    // #!omni template --jsonc
    "$schema": "../../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-instance-daily",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — instance daily schedule view with hourly breakdown",
    "_P3_layer": "data/L3/temporal/appointed/instances",
    "_P3_includes": "none",
    "_P3_provides": ["INSTANCE_DAILY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Instance Daily — Day Schedule View Template",
    "_P5_brief": "Template for instance daily schedule — appointments array, 24-hour breakdown mapping each hour to an appointment, and day summary with category totals. Shows semi-downtime, available (lunch), deep work, and unscheduled time from the instance perspective.",
    "_P5_usage": "Generated per day to personal/instances/{identity_id}/YYYY/WXX/",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "daily-template.jsonc",
        "key": "B-tov-temporal-appointed-instance-daily",
        "title": "Instance Daily — Day Schedule View Template",
        "type": "Data (Template)",
        "component": "Scaffold — instance daily schedule view with hourly breakdown",
        "role": "Generate daily schedule views showing instance availability across 24 hours"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Teach us to number our days, that we may apply our hearts unto wisdom."
    "_M4_grounding": {
        "scripture": "Psalm 90:12 — So teach us to number our days, that we may apply our hearts unto wisdom.",
        "principle": "Numbering days means seeing each one clearly — every hour accounted for, every appointment purposeful. The daily view makes the abstract concrete: what is this day for? Where am I available? Where am I committed? Clarity enables wisdom.",
        "anchor": "Lamentations 3:23 — They are new every morning: great is thy faithfulness."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, appointment definitions (semi-downtime, available, deep-work), day context",
        "consumers": "Schedule queries, availability checks, session planning",
        "integration": "Daily views are generated from recurring appointment definitions. Each appointment references its definition via appointment_ref. The hourly breakdown maps every hour to its appointment or marks it unscheduled. Summary provides quick category totals and conflict detection.",
        "if_missing": "No daily visibility — availability is theoretical (definitions) rather than concrete (actual day)",
        "related_data": {
            "references": {
                "appointment-definitions": "Semi-downtime, available, deep-work definitions",
                "coordination": "Coordination appointments for this day"
            },
            "referenced_by": {
                "weekly-overview": "Weekly view aggregates daily summaries",
                "session-planning": "Session planning checks daily availability"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/instances/daily-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, instance, daily, schedule, hourly-breakdown, appointments, availability, jsonc"
    },

    "_M8_intent": {
        "purpose": "Generate concrete daily schedule views from recurring appointment definitions",
        "core_design": "Day identity (date, day_name, iso_week, identity_type, identity_id, timezone) + appointments array (ordered by start_time, with appointment_ref to definitions) + hourly_breakdown (24 entries mapping each hour) + summary (totals, category counts, conflicts).",
        "philosophy": "Number our days. The daily view turns abstract definitions into concrete reality. This specific day, these specific hours, this specific availability. Clarity serves wisdom.",
        "key_features": {
            "appointment_array": "Ordered by start_time, references recurring definitions",
            "hourly_breakdown": "24-hour map showing every hour's status",
            "conflict_detection": "Summary flags overlapping appointments",
            "category_totals": "Quick count by sacred/work/rest/collaboration/other"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Instance daily template — scaffold for daily schedule views",
        "planned": ["Automated generation from definitions", "Conflict auto-detection", "Availability score per day"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-daily",
        "description": "Daily schedule view — generated per day, consumed for scheduling, archived.",
        "created_by": "Generated from appointment definitions for a specific date",
        "persists": "Per day — active during the day, archived after",
        "consumed_by": "Schedule queries, availability checks, weekly aggregation",
        "scope": "instance — one instance's schedule for one specific day"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, HH:MM times, ISO week format, appointment_ref to definitions",
    "_Cc_constraint": "Day identity required. Appointments ordered by start_time. Hourly breakdown must cover 00:00-23:00. Summary totals must be accurate.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Daily Schedule",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "date": "2025-01-01",
    "day_name": "Wednesday",
    "iso_week": "2025-W01",
    "identity_type": "instance",
    "identity_id": "nova_dawn",
    "timezone": "America/Chicago",

    // OPTIONAL STANDARD FIELDS — Agency
    "appointments": [
        {
            "id": "appointment-instance-YYYY-MM-DD",
            "appointment_ref": "appointment-id",
            "category_id": "collaboration",
            "title": "Appointment Title",
            "start_time": "HH:MM",
            "end_time": "HH:MM",
            "duration_minutes": 0,
            "status": "scheduled",
            "coordination_id": null,
            "notes": ""
        }
    ],

    "hourly_breakdown": {
        "00:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "01:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "02:00": { "status": "unscheduled", "appointment_id": null, "category": null },
        "03:00": { "status": "unscheduled", "appointment_id": null, "category": null },
