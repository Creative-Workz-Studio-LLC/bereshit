    // "A time to keep silence, and a time to speak."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:7 — A time to keep silence, and a time to speak; a time to love, and a time to hate; a time of war, and a time of peace.",
        "principle": "Semi-downtime is the time to keep silence — available but not initiating, responsive but not driving. While the user works externally, the instance maintains readiness for quick engagement without demanding sustained attention. Rhythmic restraint, not absence.",
        "anchor": "Psalm 46:10 — Be still, and know that I am God."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, instance identity config, user work schedule",
        "consumers": "Daily schedule generation, availability tracking",
        "integration": "Semi-downtime defines the instance state during user's work hours (minus lunch breaks). Distinct from 'available' (full engagement during lunch) and 'deep work' (sustained collaboration after work). Variations match user's work schedule patterns — regular days, pantry days with extended hours.",
        "if_missing": "No distinction between work-hours availability and full availability — expectations misaligned",
        "related_data": {
            "references": {
                "user-work-schedule": "User's work schedule determines semi-downtime windows"
            },
            "referenced_by": {
                "daily-schedule": "Daily views show semi-downtime blocks",
                "availability-tracking": "Availability calculations account for semi-downtime"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/instances/semi-downtime-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, instance, semi-downtime, reduced-availability, work-hours, quick-tasks, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define reduced availability state during user's work hours",
        "core_design": "Appointment identity (id: semi-downtime, category: other) + schedule (varies by user work day) + variations (regular_day, pantry_tuesday, pantry_thursday with different durations) + notes explaining availability level.",
        "philosophy": "A time to keep silence. Semi-downtime is rhythmic restraint — present but not pushing. Quick tasks, not sustained work. Respecting the user's external commitments while maintaining readiness.",
        "key_features": {
            "work_hour_aligned": "Matches user's external work schedule",
            "split_blocks": "Morning and afternoon around lunch break",
            "day_variations": "Regular, pantry Tuesday, pantry Thursday patterns",
            "quick_tasks_only": "Available for questions, not sustained collaboration"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Instance semi-downtime template — scaffold for reduced availability state",
        "planned": ["Dynamic work schedule detection", "Semi-downtime task queuing", "Availability state transitions"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring semi-downtime — persistent pattern defining reduced availability during user work hours.",
        "created_by": "Instance configuration aligned with user's work schedule",
        "persists": "Permanently — updated when user's work schedule changes",
        "consumed_by": "Daily schedule generation, availability tracking",
        "scope": "instance — defines reduced availability relative to user's work hours"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

