    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Instance Semi-Downtime — Reduced Availability State Template",
    "_P5_brief": "Template for tracking instance semi-downtime during user's work hours (excluding lunch). Available for quick tasks and questions, not sustained deep work. Variations for different work day patterns (regular, pantry Tuesday, pantry Thursday). Split into morning and afternoon blocks around lunch.",
    "_P5_usage": "Copy to appointments/instances/{identity_id}/ as semi-downtime.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

