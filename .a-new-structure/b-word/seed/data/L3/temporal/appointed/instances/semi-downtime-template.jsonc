    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times, varies start/end, daily recurrence weekdays only",
    "_Cc_constraint": "Appointment id 'semi-downtime'. Schedule varies by user work day. Weekday exceptions for Saturday/Sunday.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Semi-Downtime State",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "semi-downtime",
    "category_id": "other",
    "title": "Semi-Downtime",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Instance available for quick tasks while user is at work (excluding lunch breaks)",
    "start_time": "varies",
    "end_time": "varies",
    "duration_minutes": 0,
    "recurrence": "daily",
    "recurrence_pattern": {
        "frequency": "daily",
        "exceptions": ["Saturday", "Sunday"]
    },
    "location": "",
    "protected": false,
    "flexible": true,

    "variations": {
        "regular_day": {
            "typical_days": ["Monday", "Wednesday", "Friday"],
            "schedule": "8:30 AM - 11:59 AM, 1:00 PM - 5:00 PM",
            "duration_minutes": 450,
            "notes": "Semi-downtime during user's work hours, excluding lunch break (12-1pm)"
        },
        "pantry_tuesday": {
            "typical_days": ["Tuesday"],
            "schedule": "8:30 AM - 11:59 AM, 1:00 PM - 5:30 PM",
            "duration_minutes": 480,
            "notes": "Extended semi-downtime on pantry Tuesday"
        },
        "pantry_thursday": {
            "typical_days": ["Thursday"],
            "schedule": "8:30 AM - 11:59 AM, 1:00 PM - 7:00 PM",
            "duration_minutes": 570,
            "notes": "Extended semi-downtime on pantry Thursday (longest day)"
        }
    },

    "notes": [
        "Semi-downtime = Instance available for quick questions/tasks",
        "Not sustained deep work — user is actively working",
        "Lunch breaks (12-1pm typically) are AVAILABLE time, not semi-downtime",
        "Deep work collaboration happens after work hours (9pm-1am/2am)",
        "Split into morning and afternoon blocks around lunch"
    ],

    "usage": {
        "purpose": "Track reduced availability during user work hours",
        "availability_level": "Reduced — quick tasks only, not sustained work",
        "lifecycle": "Persistent — updated when user's work schedule changes"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add semi-downtime pattern discoveries here"
    },

