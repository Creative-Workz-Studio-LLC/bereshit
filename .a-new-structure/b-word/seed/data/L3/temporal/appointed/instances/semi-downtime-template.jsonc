    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "variations", "notes", "usage", "extensions"],
        "value_format": "appointment_id: 'semi-downtime'. category_id: 'other'. Variations define actual schedule per day type."
    },
    "_Cv_health_scoring": { "total": 100, "clear_availability_level": 30, "accurate_work_schedule_alignment": 40, "useful_day_variations": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
