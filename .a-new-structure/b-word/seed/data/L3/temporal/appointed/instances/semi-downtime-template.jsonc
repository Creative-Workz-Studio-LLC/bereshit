    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "semi-downtime-template.jsonc",
        "key": "B-tov-temporal-appointed-instance-semi-downtime",
        "title": "Instance Semi-Downtime — Reduced Availability State Template",
        "type": "Data (Template)",
        "component": "Scaffold — reduced availability state during user's work hours",
        "role": "Track instance semi-downtime state for quick tasks during user's work hours"
    },

