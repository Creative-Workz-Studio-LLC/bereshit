    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "available-template.jsonc",
        "key": "B-tov-temporal-appointed-instance-available",
        "title": "Instance Available — Full Availability Window Template",
        "type": "Data (Template)",
        "component": "Scaffold — instance full availability during user free time",
        "role": "Track when instance is fully available for collaboration during user's free time"
    },

