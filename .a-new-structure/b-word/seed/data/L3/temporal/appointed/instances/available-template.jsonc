    // "Here am I; send me."
    "_M4_grounding": {
        "scripture": "Isaiah 6:8 — Also I heard the voice of the Lord, saying, Whom shall I send, and who will go for us? Then said I, Here am I; send me.",
        "principle": "Available means present and ready. Not passive waiting, but active readiness for collaboration. When the user has free time, the instance is fully engaged — not semi-down, not partially available, but here and ready.",
        "anchor": "Colossians 3:23 — And whatsoever ye do, do it heartily, as to the Lord, and not unto men."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, instance identity config, user schedule awareness",
        "consumers": "Daily schedule generation, availability tracking, coordination planning",
        "integration": "Available appointments define windows of full instance availability, distinct from semi-downtime (quick tasks only) and deep work (extended collaboration). Typically aligns with user's lunch breaks — the user's actual free time during work days.",
        "if_missing": "No distinction between available and semi-downtime — collaboration quality suffers",
        "related_data": {
            "references": {
                "user-work-schedule": "User's work schedule determines when lunch breaks occur"
            },
            "referenced_by": {
                "daily-schedule": "Daily views show available windows",
                "coordination": "Coordination may target available windows for shorter tasks"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/instances/available-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, instance, available, lunch-break, collaboration, free-time, readiness, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define full availability windows aligned with user's free time",
        "core_design": "Appointment identity (id: available, category: collaboration) + schedule (start_time, end_time, duration, daily recurrence, weekday exceptions) + notes explaining availability context.",
        "philosophy": "Here am I; send me. Available isn't passive — it's active readiness. Lunch breaks are the user's only true free time during work days. Full availability honors that window.",
        "key_features": {
            "distinct_from_semi_downtime": "Available = full engagement, semi-downtime = quick tasks only",
            "lunch_aligned": "Typically aligns with user's lunch break schedule",
            "weekday_only": "Saturday/Sunday exceptions — user isn't at work",
            "schedule_variations": "Wednesday may have different lunch time, alternating Monday schedules"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Instance available template — scaffold for full availability windows",
        "planned": ["Dynamic lunch break detection", "Availability quality scoring", "Auto-coordination for available windows"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring available window — persistent pattern defining full availability during user free time.",
        "created_by": "Instance configuration aligned with user's work schedule",
        "persists": "Permanently — updated when user's schedule changes",
        "consumed_by": "Daily schedule generation, coordination planning",
        "scope": "instance — defines availability relative to user's free time"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

