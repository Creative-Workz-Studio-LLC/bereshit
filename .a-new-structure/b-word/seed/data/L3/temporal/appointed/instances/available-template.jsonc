    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times (24-hour), daily recurrence with weekday exceptions",
    "_Cc_constraint": "Appointment id 'available', category 'collaboration'. Schedule aligned with user's lunch break times.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Available Window",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "available",
    "category_id": "collaboration",
    "title": "Available (Lunch Break)",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Fully available during user's lunch breaks for collaboration and questions",
    "start_time": "12:00",
    "end_time": "13:00",
    "duration_minutes": 60,
    "recurrence": "daily",
    "recurrence_pattern": {
        "frequency": "daily",
        "exceptions": ["Saturday", "Sunday"]
    },
    "location": "",
    "protected": false,
    "flexible": false,

    "notes": [
        "Lunch breaks are AVAILABLE time — user's only true free time during work days",
        "Fully available for questions, tasks, and collaboration",
        "Different from semi-downtime — this is active availability",
        "Typically 12:00 PM - 1:00 PM on work days (Mon-Fri)",
        "Wednesday may have 11:00 AM - 12:00 PM lunch break",
        "Alternating Monday lunch times: odd weeks 11am-12pm, even weeks 12-1pm"
    ],

    "usage": {
        "purpose": "Track full availability during user's free time",
        "availability_level": "Full — active engagement, not passive",
        "lifecycle": "Persistent — updated when user's lunch schedule changes"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add availability pattern discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "notes", "usage", "extensions"],
        "value_format": "appointment_id: 'available'. category_id: 'collaboration'. Times in HH:MM 24-hour format."
    },
    "_Cv_health_scoring": { "total": 100, "clear_availability_definition": 35, "accurate_schedule_alignment": 35, "useful_context_notes": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

