    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Instance Available — Full Availability Window Template",
    "_P5_brief": "Template for tracking instance full availability during user's free time (lunch breaks). Different from semi-downtime — this is active, full availability for collaboration and questions. Typically weekday lunch breaks when the user has actual free time.",
    "_P5_usage": "Copy to appointments/instances/{identity_id}/ as available.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
