    "_P5_title": "Instance Deep Work — Peak Collaboration Session Template",
    "_P5_brief": "Template for evening deep work collaboration sessions during peak productivity hours. CPI-SI development and Kingdom Technology work. Standard 4-hour sessions (9pm-1am) with extended variation (9pm-2am). Protected appointment — covenant partnership collaboration at its most focused.",
    "_P5_usage": "Copy to appointments/instances/{identity_id}/ as deep-work.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

