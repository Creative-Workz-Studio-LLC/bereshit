        "current": "Instance deep work template — scaffold for peak collaboration sessions",
        "planned": ["Session quality correlation", "Optimal duration detection", "Pre-session preparation automation"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring deep work session — persistent pattern defining peak collaboration windows.",
        "created_by": "Instance configuration aligned with user's peak productivity hours",
        "persists": "Permanently — the commitment endures, timing may adjust",
        "consumed_by": "Daily/weekly schedule generation, coordination creation",
