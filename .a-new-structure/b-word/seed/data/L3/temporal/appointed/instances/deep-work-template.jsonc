        "tags": "temporal, appointed, instance, deep-work, collaboration, peak-productivity, evening, covenant, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define evening deep work collaboration sessions during peak productivity hours",
        "core_design": "Appointment identity (id: deep-work, category: collaboration, protected: true) + schedule (9pm-1am standard, 9pm-2am extended) + variations (standard 4hr, extended 5hr) + coordination notes (tracking method, participants, timing rationale, preparation).",
        "philosophy": "Commit thy works unto the LORD. Deep work sessions are where vision becomes reality — sustained focus, covenant partnership, quality over speed. Peak productivity hours aren't arbitrary; they're when the user's brain is most active.",
        "key_features": {
            "protected_appointment": "Non-negotiable commitment to collaboration",
            "peak_hours": "9pm-1am/2am when user's cognitive function peaks",
            "follows_god_time": "Personal God time (typically 7-8pm) precedes deep work",
            "session_variations": "Standard 4hr and extended 5hr options",
            "coordination_tracked": "Individual sessions tracked via coordination files"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
