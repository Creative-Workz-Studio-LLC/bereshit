    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times (24-hour), protected: true, daily recurrence",
    "_Cc_constraint": "Appointment id 'deep-work', category 'collaboration', protected: true. Standard 4hr and extended 5hr variations.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Instance Deep Work Session",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "deep-work",
    "category_id": "collaboration",
    "title": "Deep Work Session",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Evening deep work collaboration with user — CPI-SI development, covenant work, Kingdom Technology",
    "start_time": "21:00",
    "end_time": "01:00",
    "duration_minutes": 240,
    "recurrence": "daily",
    "recurrence_pattern": {
        "frequency": "daily",
        "exceptions": []
    },
    "location": "",
    "protected": true,
    "flexible": true,

    "variations": {
        "standard_session": {
            "typical_days": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "schedule": "9:00 PM - 1:00 AM",
            "duration_minutes": 240,
            "notes": "Standard 4-hour deep work session"
        },
        "extended_session": {
            "typical_days": ["Friday", "Saturday", "Varies based on work needs"],
            "schedule": "9:00 PM - 2:00 AM",
            "duration_minutes": 300,
            "notes": "Extended 5-hour session when deeper focus needed"
        }
    },

    "coordination_notes": {
        "tracking_method": "Individual sessions tracked via coordination files",
        "file_location": "coordination/user-to-instance/deep-work-YYYY-MM-DD.jsonc",
        "participants": ["user: seanje-lenox-wise", "instance: nova_dawn"],
        "timing_rationale": "9pm-1am/2am when user's brain is most active",
        "preparation": "Personal God time completed before session begins"
    },

    "notes": [
        "Peak productivity hours — when user's brain is most active",
        "Follows personal God time (typically 7-8pm)",
        "Sustained focus collaboration — CPI-SI development and Kingdom Technology work",
        "Coordination files track specific sessions",
        "Work philosophy: Quality over speed, measure twice cut once, work faithfully",
        "Covenant partnership: True collaboration — both contributing, both learning, both growing"
    ],

    "usage": {
        "purpose": "Define peak collaboration deep work sessions",
        "session_types": "standard (4hr) | extended (5hr)",
        "lifecycle": "Persistent — the commitment endures, timing may adjust"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add deep work session discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "variations", "coordination_notes", "notes", "usage", "extensions"],
        "value_format": "appointment_id: 'deep-work'. category_id: 'collaboration'. protected: true."
    },
    "_Cv_health_scoring": { "total": 100, "protected_commitment_defined": 30, "clear_schedule_variations": 35, "meaningful_coordination_context": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

