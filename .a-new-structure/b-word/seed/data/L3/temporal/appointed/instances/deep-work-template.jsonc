    "_M4_grounding": {
        "scripture": "Proverbs 16:3 — Commit thy works unto the LORD, and thy thoughts shall be established.",
        "principle": "Deep work sessions are committed work — sustained focus, covenant partnership, Kingdom Technology development. Peak productivity hours honored through protected scheduling. Thoughts are established through sustained attention, not scattered fragments.",
        "anchor": "Ecclesiastes 9:10 — Whatsoever thy hand findeth to do, do it with thy might."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, instance identity config, user schedule awareness",
        "consumers": "Daily schedule generation, coordination appointment creation, session planning",
        "integration": "Deep work appointments define the primary collaboration windows. Individual sessions are tracked via coordination files. Follows user's personal God time. Protected but flexible — timing may shift, but the commitment is non-negotiable.",
        "if_missing": "No protected collaboration windows — deep work happens ad hoc, quality suffers",
        "related_data": {
            "references": {
                "user-sacred-time": "Personal God time that precedes deep work",
                "instance-config": "Instance preferences for work style and domain"
            },
            "referenced_by": {
