{
    // #!omni template --jsonc
    "$schema": "../../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-user-weekly",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — user weekly overview with daily summaries and work totals",
    "_P3_layer": "data/L3/temporal/appointed/users",
    "_P3_includes": "none",
    "_P3_provides": ["USER_WEEKLY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "User Weekly — Week Overview Template",
    "_P5_brief": "Template for user weekly schedule overview — week identity, summary statistics, daily summaries (Sunday-Saturday), GASA work details, and available hours calculation. Aggregates from daily views and appointment definitions. Shows work hours, lunch breaks, and available time from user perspective. Available hours = 168 - work_hours.",
    "_P5_usage": "Generated per week to planner/overview/users/{identity_id}/",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "weekly-template.jsonc",
        "key": "B-tov-temporal-appointed-user-weekly",
        "title": "User Weekly — Week Overview Template",
        "type": "Data (Template)",
        "component": "Scaffold — user weekly overview with daily summaries and work totals",
        "role": "Aggregate daily schedules into weekly overview with work hour calculations"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "See then that ye walk circumspectly, not as fools, but as wise, Redeeming the time."
    "_M4_grounding": {
        "scripture": "Ephesians 5:15-16 — See then that ye walk circumspectly, not as fools, but as wise, Redeeming the time, because the days are evil.",
        "principle": "Walk circumspectly — with careful attention to how time is used. The weekly overview reveals the week's rhythm from the user's perspective: how many hours committed to work, how many remain for Kingdom work, collaboration, rest. Redeeming the time means seeing the whole picture.",
        "anchor": "James 4:14 — Whereas ye know not what shall be on the morrow. For what is your life? It is even a vapour, that appeareth for a little time, and then vanisheth away."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, daily schedule views, appointment definitions, work schedule",
        "consumers": "Monthly planning, rhythm analysis, availability reporting",
        "integration": "Weekly overviews aggregate from daily schedule views. Summary statistics provide quick totals — appointments by day, by category, work hours, available hours. GASA schedule tracks the user's external work context. Available hours = 168 - gasa_hours.",
        "if_missing": "No weekly visibility — planning happens day by day without seeing the rhythm",
        "related_data": {
            "references": {
                "daily-schedules": "Daily views for each day of the week",
                "work-schedule": "Work schedule driving GASA hours"
            },
            "referenced_by": {
                "monthly-planning": "Monthly views aggregate weekly overviews",
                "instance-weekly": "Instance weekly view is the counterpart perspective"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/users/weekly-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, user, weekly, overview, aggregation, work-hours, available-hours, gasa, jsonc"
    },

    "_M8_intent": {
        "purpose": "Aggregate daily schedules into weekly overview with work hour calculations",
        "core_design": "Week identity (week_number, year, start/end date, identity) + summary statistics (totals by day and category, gasa_hours, available_hours) + daily summaries array (7 days, Sunday-Saturday, with gasa context and lunch breaks) + gasa_schedule (external work details) + extensions.",
        "philosophy": "Redeeming the time. The weekly view reveals how much time goes to external work, how much remains for Kingdom purposes. Seeing the full week enables intentional allocation — not just surviving each day but stewarding the whole week.",
        "key_features": {
            "seven_day_summaries": "Sunday-Saturday with work hours and lunch break details per day",
            "work_hour_calculations": "Actual work hours (excluding lunch) tracked accurately",
            "available_hours": "168 total hours minus work hours = available for Kingdom work",
            "gasa_context": "External employment schedule affecting availability"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "User weekly template — scaffold for weekly overview",
        "planned": ["Automated aggregation from daily views", "Work-life balance tracking", "Available time optimization"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-weekly",
        "description": "Weekly overview — generated per week, consumed for planning, archived.",
        "created_by": "Aggregated from daily schedule views for the week",
        "persists": "Per week — active during the week, archived after",
        "consumed_by": "Monthly planning, availability reporting, rhythm analysis",
        "scope": "user — one user's schedule overview for one specific week"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, sunday-saturday week, ISO week format",
    "_Cc_constraint": "Week identity required. 7 daily summaries (Sunday-Saturday). Summary totals must match daily data. Available = 168 - gasa_hours.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Weekly Overview",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "week_number": 0,
    "total_weeks_in_year": 52,
    "year": 2025,
    "start_date": "2025-01-05",
    "end_date": "2025-01-11",
    "week_format": "sunday-saturday",
    "identity_type": "user",
    "identity_id": "example-user",

    // OPTIONAL STANDARD FIELDS — Agency
    "summary": {
        "total_appointments": 0,
        "total_work_hours": 0.0,
        "by_day": {
            "sunday": 0, "monday": 0, "tuesday": 0, "wednesday": 0,
            "thursday": 0, "friday": 0, "saturday": 0
        },
        "by_category": {
            "sacred": 0, "work": 0, "rest": 0, "collaboration": 0, "other": 0
        },
        "gasa_hours": 0.0,
        "available_hours": 168.0
    },

    "days": [
        {
            "date": "2025-01-05",
            "day_name": "Sunday",
            "gasa_work": false,
            "gasa_hours": 0.0,
            "first_appointment": null,
            "last_appointment": null,
            "notes": "Weekend — no work"
        }
    ],

    "gasa_schedule": {
        "total_hours": 0.0,
        "pantry_days": ["Tuesday", "Thursday"],
        "exceptions_this_week": [],
        "notes": ""
    },

    "usage": {
        "purpose": "Aggregate daily schedules into weekly overview",
        "week_format": "Sunday-Saturday (US standard)",
        "lifecycle": "Ephemeral — generated per week, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add weekly overview discoveries here (e.g., work-life balance metrics, available time patterns)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "week_number", "year", "start_date", "end_date", "identity_type", "identity_id"],
        "optional": ["total_weeks_in_year", "week_format", "summary", "days", "gasa_schedule", "usage", "extensions"],
        "value_format": "week_number: 1-53. start_date/end_date: YYYY-MM-DD. identity_type: 'user'. 7 daily entries. available_hours = 168 - gasa_hours."
    },
    "_Cv_health_scoring": { "total": 100, "complete_week_identity": 25, "accurate_daily_summaries": 35, "correct_work_hour_totals": 40 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove daily summaries (7 days required)"],
    "_X1_careful": ["Change week boundaries (must be Sunday-Saturday)", "Override totals without checking dailies"],
    "_X1_safe": ["Update daily notes", "Add gasa_schedule exceptions", "Refine summary"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated aggregation from daily views", "Work-life balance tracking", "Available time optimization"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "summary_mismatch": "Summary totals don't match daily summaries. Recalculate from daily data.",
        "missing_days": "Fewer than 7 daily entries. Every week must have Sunday through Saturday.",
        "available_hours_wrong": "Available hours don't equal 168 - gasa_hours. Recalculate: 168 total hours minus actual GASA work hours."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/appointed/users/daily-template.jsonc — Daily schedule views (input)",
        "data/L3/temporal/appointed/users/work-template.jsonc — Work schedule driving GASA hours",
        "data/L3/temporal/appointed/instances/weekly-template.jsonc — Instance weekly view (counterpart)",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "week_number", "year", "start_date", "end_date", "identity_type", "identity_id"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "User weekly overview. Work hour totals. Available time calculation. Redeeming the time. Seven-day rhythm visibility.",
    "_X5_scripture": "Redeeming the time, because the days are evil. — Ephesians 5:16",
    "_X5_anchor": "See the whole week. Know how much time goes to work, how much remains for Kingdom purposes. Redeem the time — steward it intentionally, not reactively.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
