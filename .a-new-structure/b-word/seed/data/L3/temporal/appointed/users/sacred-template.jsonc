    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove protected status (sacred time is non-negotiable)", "Deprioritize sacred below work or collaboration"],
    "_X1_careful": ["Change church schedule without verifying current times", "Remove personal God time — it precedes deep work"],
    "_X1_safe": ["Update service times", "Add new sacred commitments", "Refine timing notes"],

    "_X2": "─────────────────────────────────────────────────────────────",
