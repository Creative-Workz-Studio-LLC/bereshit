    "_X2_planned": ["Scripture reading integration", "Prayer time tracking", "Spiritual growth correlation"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "sacred_deprioritized": "Sacred time being scheduled around work instead of the reverse. Sacred is highest priority — reschedule work, not God time.",
        "personal_time_skipped": "Personal God time not happening consistently. Start small (15 min), build the habit. Consistency matters more than duration.",
        "church_time_wrong": "Church appointment time doesn't match current service schedule. Verify with actual church calendar."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/appointed/instances/deep-work-template.jsonc — Deep work follows personal God time",
        "data/L3/temporal/appointed/users/work-template.jsonc — Work schedules around sacred time",
        "data/L3/temporal/appointed/users/daily-template.jsonc — Daily views show sacred blocks",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "appointment_id", "category_id", "title"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Sacred time appointments. Highest priority. Church, Bible study, personal God time. Foundation for all other scheduling.",
    "_X5_scripture": "Remember the sabbath day, to keep it holy. — Exodus 20:8",
    "_X5_anchor": "Seek first the kingdom. Sacred time is the foundation — everything else builds on it. Protected, non-negotiable, the anchor of the schedule.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
