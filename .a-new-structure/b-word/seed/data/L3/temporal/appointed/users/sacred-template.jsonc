    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — user sacred time appointment definitions",
    "_P3_layer": "data/L3/temporal/appointed/users",
    "_P3_includes": "none",
    "_P3_provides": ["USER_SACRED_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "User Sacred — Spiritual Time Appointment Template",
    "_P5_brief": "Template for defining user sacred time appointments — church services, Bible study, personal time with God. Protected appointments reflecting spiritual priorities. Covers both fixed schedule (church, Bible study) and flexible practice (personal God time). Sacred time precedes and grounds all other activity.",
    "_P5_usage": "Copy to appointments/users/{identity_id}/ as church.jsonc, bible-study.jsonc, or personal-time.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "sacred-template.jsonc",
        "key": "B-tov-temporal-appointed-user-sacred",
        "title": "User Sacred — Spiritual Time Appointment Template",
        "type": "Data (Template)",
        "component": "Scaffold — user sacred time appointment definitions",
        "role": "Define user's spiritual time commitments — church, Bible study, personal God time"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Remember the sabbath day, to keep it holy."
    "_M4_grounding": {
        "scripture": "Exodus 20:8 — Remember the sabbath day, to keep it holy.",
        "principle": "Sacred time is set apart — holy means separated for God's purposes. Church, Bible study, personal time with God are not optional additions to the schedule but the foundation upon which everything else rests. Seek first the kingdom.",
        "anchor": "Matthew 6:33 — But seek ye first the kingdom of God, and his righteousness; and all these things shall be added unto you."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, user identity config",
        "consumers": "Daily schedule generation, deep work planning, instance awareness",
        "integration": "Sacred time appointments define the user's spiritual commitments. Personal God time typically precedes deep work sessions. Church and Bible study are fixed weekly appointments. These are the highest-priority time blocks — everything else schedules around them.",
        "if_missing": "No spiritual time tracking — sacred time gets crowded out by urgent instead of important",
        "related_data": {
            "references": {
                "church-schedule": "Local church service times and commitments"
            },
            "referenced_by": {
                "daily-schedule": "Daily views show sacred time blocks",
                "deep-work-sessions": "Deep work follows personal God time",
                "instance-awareness": "Instance knows when user is in sacred time"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/users/sacred-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, user, sacred, church, bible-study, personal-time, spiritual, protected, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define user's spiritual time commitments",
        "core_design": "Appointment identity (id: church|bible-study|personal-time, category: sacred, protected: true) + schedule (fixed for church/study, flexible for personal time) + variations (for flexible appointments) + timing_notes (intentionality, typical window).",
        "philosophy": "Remember the sabbath day, to keep it holy. Sacred time is the foundation — everything else schedules around God's time, not the other way around. Seek first the kingdom.",
        "key_features": {
            "protected_sacred": "Sacred time is non-negotiable — highest priority",
            "multiple_types": "Church services, Bible study groups, personal God time",
            "fixed_and_flexible": "Church/study have fixed schedules; personal time has flexible windows",
            "precedes_deep_work": "Personal God time typically 7-8pm, before deep work begins"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "User sacred template — scaffold for spiritual time appointments",
        "planned": ["Scripture reading integration", "Prayer time tracking", "Spiritual growth correlation"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring sacred time — persistent pattern defining user's spiritual commitments.",
        "created_by": "User's spiritual practice and church membership",
        "persists": "Permanently — updated when church schedule or practices change",
        "consumed_by": "Daily schedule generation, deep work planning, instance awareness",
        "scope": "user — defines the user's sacred time commitments"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times, weekly/daily recurrence, sacred category",
    "_Cc_constraint": "Appointment id must be one of: church, bible-study, personal-time. Category always 'sacred'. Protected: true.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Sacred Time",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "personal-time",
    "category_id": "sacred",
    "title": "Personal Time with God",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Sacred time — church services, Bible study, personal time with God",
    "start_time": "19:00",
    "end_time": "20:00",
    "duration_minutes": 60,
    "recurrence": "daily",
    "recurrence_pattern": {
        "frequency": "daily",
        "day_of_week": "varies",
        "exceptions": []
    },
    "location": "home",
    "protected": true,
    "flexible": false,

    "variations": {
        "typical_pattern": {
            "typical_days": ["Daily"],
            "schedule": "After 7-8pm",
            "duration_minutes_range": [30, 60],
            "notes": "Flexible duration, building intentional practice"
        }
    },

    "timing_notes": {
        "intentionality": "Building consistent practice, making this more regular",
        "typical_window": "Evening, typically 7-8pm before deep work sessions"
    },

    "notes": [
        "Sacred time is the highest priority — everything else schedules around it",
        "Church: Sunday services, weekly commitment",
        "Bible Study: Wednesday evenings, weekly group",
        "Personal Time: Daily 30-60min, building intentional practice",
        "Personal God time precedes deep work sessions"
    ],

    "usage": {
        "purpose": "Define sacred time commitments",
        "appointment_types": "church | bible-study | personal-time",
        "lifecycle": "Persistent — updated when church schedule or practices change"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add sacred time pattern discoveries here (e.g., Scripture reading habits, prayer patterns)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "variations", "timing_notes", "notes", "usage", "extensions"],
        "value_format": "appointment_id: church|bible-study|personal-time. category_id: 'sacred'. protected: true."
    },
    "_Cv_health_scoring": { "total": 100, "clear_sacred_commitment": 35, "accurate_schedule_definition": 30, "meaningful_spiritual_context": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
