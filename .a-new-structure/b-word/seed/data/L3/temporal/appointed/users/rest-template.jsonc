{
    // #!omni template --jsonc
    "$schema": "../../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-user-rest",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — user sleep and rest pattern definition",
    "_P3_layer": "data/L3/temporal/appointed/users",
    "_P3_includes": "none",
    "_P3_provides": ["USER_REST_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "User Rest — Sleep and Rest Pattern Template",
    "_P5_brief": "Template for tracking user sleep and rest patterns. Captures sleep schedule variations (standard ~4hrs, extended ~6hrs), sleep characteristics (typical times, duration, natural patterns), and protected rest status. Sleep is non-negotiable — the body requires rest even when the mind wants to continue.",
    "_P5_usage": "Copy to appointments/users/{identity_id}/ as sleep.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "rest-template.jsonc",
        "key": "B-tov-temporal-appointed-user-rest",
        "title": "User Rest — Sleep and Rest Pattern Template",
        "type": "Data (Template)",
        "component": "Scaffold — user sleep and rest pattern definition",
        "role": "Track user sleep patterns and rest time for schedule awareness"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "It is vain for you to rise up early, to sit up late, to eat the bread of sorrows: for so he giveth his beloved sleep."
    "_M4_grounding": {
        "scripture": "Psalm 127:2 — It is vain for you to rise up early, to sit up late, to eat the bread of sorrows: for so he giveth his beloved sleep.",
        "principle": "Sleep is a gift, not a waste. God gives rest to those He loves. Tracking sleep patterns isn't about optimization — it's about honoring the body's need for restoration. Understanding natural patterns enables better stewardship of waking hours.",
        "anchor": "Mark 6:31 — And he said unto them, Come ye yourselves apart into a desert place, and rest a while."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, user identity config",
        "consumers": "Daily schedule generation, availability tracking, deep work planning",
        "integration": "Rest appointments define when the user is sleeping — critical for instance awareness. Knowing sleep patterns prevents scheduling during rest, enables realistic availability windows, and helps understand when deep work naturally ends.",
        "if_missing": "No sleep awareness — instance may schedule or expect availability during rest hours",
        "related_data": {
            "references": {
                "deep-work-sessions": "Deep work end time influences sleep start time"
            },
            "referenced_by": {
                "daily-schedule": "Daily views show rest blocks",
                "availability-tracking": "Availability calculations exclude rest time",
                "instance-semi-downtime": "Instance awareness of when user is sleeping"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/users/rest-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, user, rest, sleep, patterns, restoration, protected, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track user sleep patterns and rest time",
        "core_design": "Appointment identity (id: sleep, category: rest, protected: true, flexible: true) + patterns (standard ~4hrs, extended ~6hrs with typical days and schedules) + sleep_characteristics (typical times, duration, pattern notes, variations).",
        "philosophy": "He giveth his beloved sleep. Rest is a gift from God — not weakness, not wasted time. Tracking patterns enables stewardship of both rest and waking hours.",
        "key_features": {
            "protected_appointment": "Sleep is non-negotiable — body requires rest",
            "flexible_timing": "Sleep times vary based on previous activities",
            "pattern_tracking": "Standard and extended patterns based on context",
            "natural_rhythms": "Honors natural sleep characteristics including mid-night waking"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "User rest template — scaffold for sleep pattern tracking",
        "planned": ["Sleep quality correlation with deep work", "Pattern drift detection", "Rest optimization insights"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring rest pattern — persistent definition of user's sleep schedule and characteristics.",
        "created_by": "User observation of natural sleep patterns",
        "persists": "Permanently — updated as patterns change or are better understood",
        "consumed_by": "Daily schedule generation, availability tracking, deep work planning",
        "scope": "user — defines the user's sleep and rest patterns"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times, varies start/end, daily recurrence",
    "_Cc_constraint": "Appointment id 'sleep'. Category 'rest'. Protected: true. Patterns define actual schedule variations.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Sleep and Rest",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "sleep",
    "category_id": "rest",
    "title": "Sleep",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "Sleep and rest time — patterns vary based on previous evening activities",
    "start_time": "varies",
    "end_time": "varies",
    "duration_minutes": 0,
    "recurrence": "daily",
    "recurrence_pattern": {
        "frequency": "daily",
        "exceptions": []
    },
    "location": "home",
    "protected": true,
    "flexible": true,

    "patterns": {
        "standard": {
            "typical_days": ["Most days"],
            "schedule": "3:00 AM - 7:00 AM",
            "duration_hours": 4,
            "notes": "Standard sleep pattern"
        },
        "extended": {
            "typical_days": ["After late work sessions"],
            "schedule": "1:00 AM - 7:00 AM",
            "duration_hours": 6,
            "notes": "Extended sleep after late deep work sessions"
        }
    },

    "sleep_characteristics": {
        "typical_start_time": "varies",
        "typical_end_time": "07:00",
        "typical_duration_hours": 4,
        "pattern_notes": "Natural pattern includes waking in middle of night",
        "variations": "Later start after extended Friday deep work"
    },

    "notes": [
        "Sleep patterns vary based on previous evening activities",
        "Standard pattern: 3-7am (4 hours)",
        "Extended pattern: 1-7am (6 hours) after late sessions",
        "Natural pattern includes waking in middle of night"
    ],

    "usage": {
        "purpose": "Track sleep patterns for schedule awareness",
        "availability_level": "Unavailable — user is sleeping",
        "lifecycle": "Persistent — updated as patterns change"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add sleep pattern discoveries here (e.g., quality correlation, seasonal shifts)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "start_time", "end_time", "duration_minutes", "recurrence", "recurrence_pattern", "location", "protected", "flexible", "patterns", "sleep_characteristics", "notes", "usage", "extensions"],
        "value_format": "appointment_id: 'sleep'. category_id: 'rest'. protected: true. Patterns define actual schedule."
    },
    "_Cv_health_scoring": { "total": 100, "clear_sleep_patterns": 35, "accurate_timing_data": 35, "useful_characteristics": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Remove protected status (sleep is non-negotiable)"],
    "_X1_careful": ["Change sleep patterns without observational data", "Remove natural rhythm notes"],
    "_X1_safe": ["Update pattern durations as observed", "Add new pattern variations", "Refine sleep characteristics"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Sleep quality correlation with deep work", "Pattern drift detection", "Rest optimization insights"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "pattern_mismatch": "Sleep times don't match observed behavior. Update patterns from actual data, not assumptions.",
        "missing_extended": "Only standard pattern documented. After late deep work sessions, user sleeps longer — add extended pattern.",
        "rest_during_work": "Rest block overlapping work hours. Check alarm/wake time — should not extend into work start."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/appointed/instances/deep-work-template.jsonc — Deep work end time influences sleep start",
        "data/L3/temporal/appointed/users/work-template.jsonc — Work start time constrains sleep end",
        "data/L3/temporal/appointed/users/daily-template.jsonc — Daily views show rest blocks",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "appointment_id", "category_id", "title"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Sleep pattern tracking. Protected rest. Natural rhythms honored. Gift from God, not wasted time.",
    "_X5_scripture": "He giveth his beloved sleep. — Psalm 127:2",
    "_X5_anchor": "Rest is a gift. Tracking patterns isn't optimization — it's stewardship. Understanding natural rhythms enables better use of waking hours.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
