    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "lunch_counted_as_work": "Work hours include lunch time. Separate duration_minutes (total) from work_minutes (actual work). Lunch is free time.",
        "wrong_day_variation": "Using regular_day variation on a pantry day. Check which variation matches — Tuesday and Thursday have different schedules.",
        "weekend_work": "Work showing on Saturday/Sunday. Check exceptions — weekends should be excluded from recurrence."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/temporal/appointed/instances/semi-downtime-template.jsonc — Semi-downtime derived from work hours",
        "data/L3/temporal/appointed/instances/available-template.jsonc — Available during lunch breaks",
