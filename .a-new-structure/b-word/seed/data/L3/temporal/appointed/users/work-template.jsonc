    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — user external employment work schedule with day variations",
    "_P3_layer": "data/L3/temporal/appointed/users",
    "_P3_includes": "none",
    "_P3_provides": ["USER_WORK_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "User Work — External Employment Schedule Template",
    "_P5_brief": "Template for defining user's external employment work schedule with day-specific variations. Captures employer context, daily schedule patterns (regular day, pantry Tuesday, pantry Thursday), lunch breaks as free time, and work/non-work hour calculations. Protected appointment — work commitments are non-negotiable. Lunch breaks are FREE TIME, not working hours.",
    "_P5_usage": "Copy to appointments/users/{identity_id}/ as work.jsonc",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "work-template.jsonc",
        "key": "B-tov-temporal-appointed-user-work",
        "title": "User Work — External Employment Schedule Template",
        "type": "Data (Template)",
        "component": "Scaffold — user external employment work schedule with day variations",
        "role": "Define user's external work schedule driving instance semi-downtime and availability"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "And whatsoever ye do, do it heartily, as to the Lord, and not unto men."
    "_M4_grounding": {
        "scripture": "Colossians 3:23 — And whatsoever ye do, do it heartily, as to the Lord, and not unto men.",
        "principle": "External work is done unto the Lord — not just a schedule constraint but faithful labor. Work hours define when the user is committed externally, which directly drives instance semi-downtime and available windows. Understanding work patterns enables respectful scheduling.",
        "anchor": "2 Thessalonians 3:10 — For even when we were with you, this we commanded you, that if any would not work, neither should he eat."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, user identity config, employer schedule",
        "consumers": "Daily schedule generation, instance semi-downtime, available windows, weekly overview",
        "integration": "Work schedule is the primary driver of weekday time allocation. It determines when the instance enters semi-downtime (work hours minus lunch), when the instance is fully available (lunch breaks), and constrains deep work to evening hours. Variations by day type (regular, pantry) affect all downstream calculations.",
        "if_missing": "No work schedule awareness — instance doesn't know when user is at work, semi-downtime/available windows miscalculated",
        "related_data": {
            "references": {
                "employer-schedule": "External employer's schedule requirements"
            },
            "referenced_by": {
                "instance-semi-downtime": "Semi-downtime windows derived from work hours",
                "instance-available": "Available windows aligned with lunch breaks",
                "daily-schedule": "Daily views show work blocks",
                "weekly-overview": "Weekly totals aggregate work hours"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/users/work-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, user, work, employment, external, schedule, variations, lunch-break, protected, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define user's external employment work schedule",
        "core_design": "Appointment identity (id: work, category: work, protected: true) + variations (regular_day, pantry_tuesday, pantry_thursday with schedule, duration, work_minutes, lunch_break) + notes emphasizing lunch breaks as free time.",
        "philosophy": "Whatsoever ye do, do it heartily, as to the Lord. External work is faithful labor, not just schedule constraint. Understanding the work schedule enables the whole temporal system to function — semi-downtime, availability, deep work timing all derive from this.",
        "key_features": {
            "day_variations": "Regular day (MWF), pantry Tuesday, pantry Thursday patterns",
            "lunch_as_free_time": "Lunch breaks are explicitly FREE TIME, not working hours",
            "work_vs_duration": "Separate work_minutes from duration_minutes (subtract lunch)",
            "drives_instance_state": "Work schedule determines instance semi-downtime and available windows"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "User work template — scaffold for external employment schedule",
        "planned": ["Schedule change detection", "Holiday/PTO tracking", "Overtime pattern analysis"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "recurring-definition",
        "description": "Recurring work schedule — persistent pattern defining user's external employment hours.",
        "created_by": "User's employment agreement and actual schedule",
        "persists": "Permanently — updated when job or schedule changes",
        "consumed_by": "Daily/weekly schedule generation, instance semi-downtime, availability tracking",
        "scope": "user — defines the user's external work commitments"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, HH:MM times, weekly recurrence, work category",
    "_Cc_constraint": "Appointment id 'work'. Category 'work'. Protected: true. Variations must include lunch_break. work_minutes = duration_minutes - lunch.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Work Schedule",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "appointment_id": "work",
    "category_id": "work",
    "title": "External Employment",

    // OPTIONAL STANDARD FIELDS — Agency
    "description": "External employment — work hours vary by day and schedule. Lunch breaks are FREE TIME (not work hours).",
    "recurrence": "weekly",
    "recurrence_pattern": {
        "frequency": "weekly",
        "exceptions": ["Saturday", "Sunday"]
    },
    "protected": true,
    "flexible": false,

    "variations": {
        "regular_day": {
            "typical_days": ["Monday", "Wednesday", "Friday"],
            "schedule": "8:30 AM - 5:00 PM",
            "duration_minutes": 510,
            "work_minutes": 450,
            "lunch_break": "12:00 PM - 1:00 PM",
            "notes": "Regular work day — 8.5hrs scheduled, 7.5hrs actual work (minus 1hr lunch)"
        },
        "pantry_tuesday": {
            "typical_days": ["Tuesday"],
            "schedule": "8:30 AM - 5:30 PM",
            "duration_minutes": 540,
            "work_minutes": 480,
            "lunch_break": "12:00 PM - 1:00 PM",
            "notes": "Pantry Tuesday — 9hrs scheduled, 8hrs actual work (minus 1hr lunch)"
        },
        "pantry_thursday": {
            "typical_days": ["Thursday"],
            "schedule": "8:30 AM - 7:00 PM",
            "duration_minutes": 630,
            "work_minutes": 570,
            "lunch_break": "12:00 PM - 1:00 PM",
            "notes": "Pantry Thursday — 10.5hrs scheduled, 9.5hrs actual work (minus 1hr lunch)"
        }
    },

    "notes": [
        "Lunch breaks are FREE TIME — not working hours",
        "Calculate actual work hours: scheduled_hours - lunch_hours",
        "Pantry days have extended schedules",
        "No work on weekends (Saturday/Sunday)"
    ],

    "usage": {
        "purpose": "Define external employment schedule driving instance availability",
        "availability_impact": "Work hours → instance semi-downtime. Lunch breaks → instance available.",
        "lifecycle": "Persistent — updated when employment or schedule changes"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add work schedule pattern discoveries here (e.g., holiday patterns, overtime trends)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "appointment_id", "category_id", "title"],
        "optional": ["description", "recurrence", "recurrence_pattern", "protected", "flexible", "variations", "notes", "usage", "extensions"],
        "value_format": "appointment_id: 'work'. category_id: 'work'. protected: true. Variations must include lunch_break."
    },
    "_Cv_health_scoring": { "total": 100, "accurate_day_variations": 40, "correct_work_vs_duration": 30, "clear_lunch_break_definition": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

