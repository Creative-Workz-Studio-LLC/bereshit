        "data/L3/temporal/appointed/users/daily-template.jsonc — Daily views show work blocks",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "appointment_id", "category_id", "title"],
    "_X4_validate": "make && ./bin/tov --validate-temporal",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "External employment schedule. Day variations. Lunch breaks as free time. Drives instance semi-downtime and availability.",
    "_X5_scripture": "And whatsoever ye do, do it heartily, as to the Lord. — Colossians 3:23",
    "_X5_anchor": "Work done unto the Lord. External employment is faithful labor. Understanding the schedule enables the whole temporal system — semi-downtime, availability, deep work timing all derive from this.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
