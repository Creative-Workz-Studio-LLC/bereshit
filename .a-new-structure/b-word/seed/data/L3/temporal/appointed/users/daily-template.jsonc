    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, YYYY-MM-DD dates, HH:MM times (24-hour), ISO week format",
    "_Cc_constraint": "Day identity required. Appointments ordered by start_time. 24-hour hourly breakdown. Summary totals must match appointments.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "User Daily Schedule",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "date": "2025-01-01",
    "day_name": "Wednesday",
    "iso_week": "2025-W01",
    "identity_type": "user",
    "identity_id": "example-user",
    "timezone": "America/Chicago",

    // OPTIONAL STANDARD FIELDS — Agency
    "appointments": [
        {
            "id": "example-2025-01-01",
            "appointment_ref": "work",
            "category_id": "work",
            "title": "Work",
            "start_time": "08:30",
            "end_time": "17:00",
