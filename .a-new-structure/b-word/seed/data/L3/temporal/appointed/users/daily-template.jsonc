        "total_appointments": 0,
        "total_scheduled_hours": 0.0,
        "by_category": {
            "sacred": 0, "work": 0, "rest": 0, "collaboration": 0, "other": 0
        },
        "first_appointment": null,
        "last_appointment": null,
        "has_conflicts": false,
        "conflicts": [],
        "notes": ""
    },

    "usage": {
        "purpose": "Render user's daily schedule with appointments and 24-hour view",
        "naming": "{month}_{DD}_{dayname}.jsonc (e.g., nov_07_friday.jsonc)",
        "lifecycle": "Ephemeral — generated per day, archived after"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add daily schedule discoveries here (e.g., time utilization patterns)"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-temporal"] },
    "_Cv_schema": {
        "required": ["name", "version", "date", "day_name", "identity_type", "identity_id"],
        "optional": ["iso_week", "timezone", "appointments", "hourly_breakdown", "summary", "usage", "extensions"],
        "value_format": "date: YYYY-MM-DD. identity_type: 'user'. 24-hour hourly_breakdown. Appointments ordered by start_time."
    },
    "_Cv_health_scoring": { "total": 100, "complete_day_identity": 20, "accurate_appointments": 35, "correct_hourly_breakdown": 25, "matching_summary_totals": 20 },

