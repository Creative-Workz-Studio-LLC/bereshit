{
    // #!omni template --jsonc
    "$schema": "../../../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-temporal-appointed-user-daily",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "temporal-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — user daily schedule with appointments and hourly breakdown",
    "_P3_layer": "data/L3/temporal/appointed/users",
    "_P3_includes": "none",
    "_P3_provides": ["USER_DAILY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "User Daily — Day Schedule Template",
    "_P5_brief": "Template for user daily schedule views with appointments and 24-hour hourly breakdown. Captures day identity (date, day_name, iso_week), ordered appointments with references to recurring definitions, hour-by-hour status mapping, and day summary statistics. Shows the user's actual committed time from their perspective.",
    "_P5_usage": "Generated per day to personal/users/{identity_id}/YYYY/WXX/",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "daily-template.jsonc",
        "key": "B-tov-temporal-appointed-user-daily",
        "title": "User Daily — Day Schedule Template",
        "type": "Data (Template)",
        "component": "Scaffold — user daily schedule with appointments and hourly breakdown",
        "role": "Render user's daily schedule with appointments and 24-hour view"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "This is the day which the LORD hath made; we will rejoice and be glad in it."
    "_M4_grounding": {
        "scripture": "Psalm 118:24 — This is the day which the LORD hath made; we will rejoice and be glad in it.",
        "principle": "Each day is made by the Lord — a gift to steward. The daily schedule reveals how committed time is distributed across 24 hours. Seeing the whole day at once enables intentional use of each hour, not reactive stumbling through commitments.",
        "anchor": "Proverbs 27:1 — Boast not thyself of to morrow; for thou knowest not what a day may bring forth."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, user appointment definitions, coordination files",
        "consumers": "Weekly overview, instance daily schedule, availability reporting",
        "integration": "Daily schedules assemble from appointment definitions (work, sacred, rest, collaboration). Each appointment references its recurring definition via appointment_ref. Hourly breakdown maps every hour to its appointment or marks it unscheduled. Summary provides quick statistics.",
        "if_missing": "No daily visibility — user navigates the day without seeing their full commitment picture",
        "related_data": {
            "references": {
                "appointment-definitions": "Recurring appointment definitions populate daily entries",
                "coordination-files": "Coordination appointments link to coordination tracking"
            },
            "referenced_by": {
                "weekly-overview": "Weekly views aggregate from daily schedules",
                "instance-daily": "Instance daily view is the counterpart perspective"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/temporal/appointed/users/daily-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "temporal, appointed, user, daily, schedule, appointments, hourly-breakdown, summary, jsonc"
    },

    "_M8_intent": {
        "purpose": "Render user's daily schedule with appointments and 24-hour view",
        "core_design": "Day identity (date, day_name, iso_week, identity_type, identity_id, timezone) + appointments array (ordered by start_time, with appointment_ref, category, status) + hourly_breakdown (24 hours 00:00-23:00, each with status/appointment_id/category) + summary (totals, by_category, first/last appointment, conflicts).",
        "philosophy": "This is the day which the LORD hath made. Each day is a gift to steward — seeing all 24 hours reveals the rhythm. Work, sacred time, rest, collaboration — each has its place.",
        "key_features": {
            "appointment_references": "Each entry references its recurring appointment definition",
            "hourly_breakdown": "Full 24-hour mapping showing what occupies each hour",
            "day_summary": "Quick statistics — totals, categories, conflicts",
            "coordination_tracking": "Coordinated appointments link to coordination files"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "User daily template — scaffold for daily schedule views",
        "planned": ["Automated generation from appointment definitions", "Conflict detection", "Time utilization analysis"]
    },

    "_M10_temporal_scope": {
        "lifecycle": "ephemeral-daily",
        "description": "Daily schedule view — generated per day, consumed for planning, archived.",
        "created_by": "Assembled from appointment definitions for the specific day",
        "persists": "Per day — active during the day, archived after",
        "consumed_by": "Weekly overview, instance awareness, availability reporting",
        "scope": "user — one user's schedule for one specific day"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (temporal scope) tracks scheduling lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
