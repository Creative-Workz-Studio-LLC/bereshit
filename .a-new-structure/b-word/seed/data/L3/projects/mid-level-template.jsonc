{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-projects-mid-level",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "project-tracking",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — weeks-to-months subsystem project tracking",
    "_P3_layer": "data/L3/projects",
    "_P3_includes": "none",
    "_P3_provides": ["MID_LEVEL_PROJECT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Mid-Level Project — Subsystem-Scope Project Template",
    "_P5_brief": "Template for weeks-to-months major subsystem projects. Significant components with clear deliverables, multiple low-level tasks, velocity tracking. References high-level parent and contains low-level subprojects.",
    "_P5_usage": "cp mid-level-template.jsonc projects/<project-id>.jsonc -> set core fields, link to parent",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "mid-level-template.jsonc",
        "key": "B-tov-projects-mid-level",
        "title": "Mid-Level Project — Subsystem-Scope Project Template",
        "type": "Data (Template)",
        "component": "Scaffold — weeks-to-months subsystem project tracking",
        "role": "Track subsystem-scope projects with estimates, velocity, and progress"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Except the LORD build the house, they labour in vain that build it."
    "_M4_grounding": {
        "scripture": "Psalm 127:1 — Except the LORD build the house, they labour in vain that build it: except the LORD keep the city, the watchman waketh but in vain.",
        "principle": "Building subsystems requires the Lord's guidance. Velocity and estimates matter, but sustained progress comes from faithful work aligned with purpose. Track honestly — vain labour produces nothing lasting.",
        "anchor": "Luke 14:28 — For which of you, intending to build a tower, sitteth not down first, and counteth the cost?"
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Project tracking, session planning, velocity analysis",
        "integration": "Mid-level projects reference high-level parents and contain low-level tasks. Estimates and velocity tracking enable realistic planning. Progress feeds up to parent project completion.",
        "if_missing": "No subsystem-level tracking — work happens without velocity awareness or realistic estimates",
        "related_data": {
            "references": {
                "high-level-project": "Parent project providing direction and context"
            },
            "referenced_by": {
                "low-level-tasks": "Low-level tasks reference mid-level as parent",
                "session-planning": "Active mid-level project informs session focus"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/projects/mid-level-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "project, mid-level, subsystem, tracking, velocity, estimates, milestones, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track subsystem-scope projects with velocity and realistic estimates",
        "core_design": "Same core structure as high-level + estimates (days, sessions, hours) + detailed progress + velocity tracking. Mid-level bridges paradigm vision and concrete tasks.",
        "philosophy": "Except the Lord build the house. Subsystem projects bridge vision and execution. Honest velocity tracking prevents vain labour — planning based on actual pace.",
        "key_features": {
            "estimates": "Total days, sessions, hours — realistic capacity planning",
            "velocity": "Planned vs actual sessions per week, trend assessment",
            "progress": "Days elapsed, sessions completed, uptime hours, completion %",
            "hierarchy": "References parent high-level, contains child low-level tasks"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Mid-level project template — scaffold for subsystem-scope tracking",
        "planned": ["First mid-level instance (libtrit Phase 2)", "Velocity analysis integration", "Automated estimate refinement"]
    },

    "_M10_project_scope": {
        "level": "mid",
        "typical_timeframe": "Weeks to months",
        "description": "Subsystem-scope project — significant components with clear deliverables.",
        "parent": "High-level paradigm project",
        "children": "Low-level task projects",
        "consumed_by": "Project tracking, velocity analysis, session planning"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (project scope) tracks project hierarchy and timeframe.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "kebab-case for project_id, lowercase_with_underscores for fields",
    "_Cc_constraint": "Core fields required. Estimates in whole numbers. Velocity trend: on_track, ahead, behind, learning.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Mid-Level Project Template",
    "version": "a-01.00",

    // CORE (REQUIRED) — The Created Order
    "schema_version": "1.0.0",
    "project_id": "unique-identifier",
    "project_name": "Project Name",
    "level": "mid",
    "parent_id": "parent-project-id",
    "status": "active",

    "identity": {
        "primary_user_id": "user-id",
        "primary_instance_id": "instance-id",
        "collaborators": []
    },

    "biblical_foundation": {
        "scripture": "Book Chapter:Verse",
        "text": "Actual Scripture text here",
        "principle": "How this Scripture illuminates THIS specific work"
    },

    // OPTIONAL STANDARD FIELDS — Agency Within Constraints
    "workspace": {
        "path": "/path/to/workspace",
        "repository_url": null,
        "branch": "main"
    },

    "inherited_preferences": {
        "workflow": "build-first",
        "thinking_style": "building-blocks",
        "session_defaults": {
            "thinking_enabled": false,
            "plan_mode": false,
            "auto_accept": false
        },
        "work_hours": {
            "timezone": "America/Chicago",
            "preferred_times": ["morning", "evening"]
        }
    },

    "project_type": "system_architecture",

    "technical_context": {
        "languages": ["go", "rust", "markdown"],
        "frameworks": [],
        "tools": ["git", "claude-code"]
    },

    "scope": {
        "description": "What this subsystem accomplishes",
        "deliverables": ["Concrete deliverable 1", "Concrete deliverable 2"],
        "impact": "How this contributes to parent project"
    },

    "dates": {
        "start_date": "2025-01-01",
        "estimated_end_date": "2025-03-01",
        "actual_end_date": null
    },

    "estimates": {
        "total_days": 30,
        "total_sessions": 20,
        "total_uptime_hours": 40,
        "avg_session_uptime_minutes": 120
    },

    "progress": {
        "phase": "Current phase",
        "current_focus": "Current task/area",
        "days_elapsed": 0,
        "sessions_completed": 0,
        "uptime_hours_actual": 0,
        "completion_percentage": 0
    },

    "milestones": [
        {
            "name": "Milestone 1",
            "target_date": "2025-02-01",
            "status": "pending",
            "description": "What this achieves"
        }
    ],

    "subprojects": [],
    "dependencies": [],

    "velocity": {
        "planned_sessions_per_week": 7,
        "actual_sessions_per_week": null,
        "trend": null
    },

    "notes": ["Context, insights, observations"],

    "usage": {
        "purpose": "Track subsystem-scope projects with velocity awareness",
        "level_guidance": "Mid-level = weeks to months, concrete deliverables. Contains low-level tasks, references high-level parent.",
        "velocity_values": "on_track | ahead | behind | learning"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "When validated broadly, promote to optional standard fields in next schema version"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-projects"] },
    "_Cv_schema": {
        "required": ["name", "version", "project_id", "project_name", "level", "parent_id", "status", "identity", "biblical_foundation"],
        "optional": ["workspace", "inherited_preferences", "project_type", "technical_context", "scope", "dates", "estimates", "progress", "milestones", "subprojects", "dependencies", "velocity", "notes", "usage", "extensions"],
        "value_format": "project_id: kebab-case. Status: planned/active/paused/completed. Velocity trend: on_track/ahead/behind/learning."
    },
    "_Cv_health_scoring": { "total": 100, "complete_core_fields": 30, "realistic_estimates": 35, "honest_velocity_tracking": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Inflate velocity to look productive (truth over comfort)"],
    "_X1_careful": ["Change estimates after project start (document why)", "Change parent_id (affects project hierarchy)"],
    "_X1_safe": ["Update progress and velocity", "Add milestones", "Add subproject references", "Add notes"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["First mid-level instance", "Automated velocity calculation from sessions", "Estimate refinement based on actual pace"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "behind_schedule": "Velocity shows 'behind'. Adjust estimates or scope — don't rush quality. Honest assessment enables course correction.",
        "no_parent": "Mid-level project without parent. Either create high-level parent or reconsider if this is actually a high-level project.",
        "stale_progress": "Progress not updated. Update after each session — stale data is worse than no data."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/projects/high-level-template.jsonc — Parent project template",
        "data/L3/projects/low-level-template.jsonc — Child task template",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "project_id", "project_name", "level", "parent_id", "status", "identity", "biblical_foundation"],
    "_X4_validate": "make && ./bin/tov --validate-projects",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Subsystem-scope project tracking. Weeks to months. Velocity and estimates. Honest progress. Bridges paradigm vision and concrete tasks.",
    "_X5_scripture": "Except the LORD build the house, they labour in vain. — Psalm 127:1",
    "_X5_anchor": "Faithful building with honest tracking. Velocity reveals pace. Estimates refined by reality.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp mid-level-template.jsonc projects/<project-id>.jsonc -> set core fields, link to parent",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title with project name",
        "project_id, project_name, parent_id, identity, biblical_foundation: set for this project",
        "estimates: realistic capacity planning",
        "Remove _X6 section when instantiating"
    ],

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
