{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-projects-high-level",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "project-tracking",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — multi-year paradigm-level project tracking",
    "_P3_layer": "data/L3/projects",
    "_P3_includes": "none",
    "_P3_provides": ["HIGH_LEVEL_PROJECT_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "High-Level Project — Paradigm-Scope Project Template",
    "_P5_brief": "Template for multi-year paradigm-level projects. Long-term vision, multiple major subprojects, defines direction. Core required fields (created order) + optional standard fields (agency) + extensions (discovery space).",
    "_P5_usage": "cp high-level-template.jsonc projects/<project-id>.jsonc -> set project_id, name, identity, biblical_foundation",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "high-level-template.jsonc",
        "key": "B-tov-projects-high-level",
        "title": "High-Level Project — Paradigm-Scope Project Template",
        "type": "Data (Template)",
        "component": "Scaffold — multi-year paradigm-level project tracking",
        "role": "Track paradigm-scope projects with biblical grounding and structured progress"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "For which of you, intending to build a tower, sitteth not down first, and counteth the cost?"
    "_M4_grounding": {
        "scripture": "Luke 14:28 — For which of you, intending to build a tower, sitteth not down first, and counteth the cost, whether he have sufficient to finish it?",
        "principle": "Count the cost before building. High-level projects define direction — multi-year vision requires planning, biblical grounding, and awareness of scope. Each project serves the Kingdom mission.",
        "anchor": "Nehemiah 2:17-18 — Come, and let us build up the wall of Jerusalem... And they said, Let us rise up and build."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser",
        "consumers": "Project tracking, session planning, progress reporting",
        "integration": "High-level projects contain mid-level subprojects. Identity fields reference user/instance configs. Biblical foundation grounds the work. Progress tracking enables awareness.",
        "if_missing": "No paradigm-level project tracking — work happens without direction or progress awareness",
        "related_data": {
            "references": {
                "user-config": "Identity fields reference user configuration",
                "instance-config": "Identity fields reference instance configuration"
            },
            "referenced_by": {
                "mid-level-projects": "Mid-level projects reference high-level as parent",
                "session-planning": "Sessions can reference active project context"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/projects/high-level-template.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "project, high-level, paradigm, tracking, milestones, long-term, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track paradigm-scope projects with structured progress and biblical grounding",
        "core_design": "Core required fields (created order) + optional standard fields (agency within constraints) + extensions (structured discovery space). Three levels: high (paradigm), mid (subsystem), low (task).",
        "philosophy": "Count the cost before building. High-level projects define WHERE we're going. Biblical foundation isn't decoration — it illuminates the genuine connection between truth and purpose.",
        "key_features": {
            "identity": "Who owns and works on this project — user + instance",
            "biblical_foundation": "Scripture genuinely connected to project purpose",
            "scope_and_progress": "Deliverables, impact, milestones, completion tracking",
            "subprojects": "References to mid-level projects under this one"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "High-level project template — scaffold for paradigm-scope tracking",
        "planned": ["Bereshit high-level project instance", "Automated progress aggregation", "Cross-project dependency visualization"]
    },

    "_M10_project_scope": {
        "level": "high",
        "typical_timeframe": "Multi-year",
        "description": "Paradigm-scope project — long-term vision defining direction.",
        "parent": "Usually null (top-level)",
        "children": "Mid-level subprojects",
        "consumed_by": "Project tracking, session planning, progress reporting"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (project scope) tracks project hierarchy and timeframe.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "kebab-case for project_id, lowercase_with_underscores for fields",
    "_Cc_constraint": "Core fields are required (created order). Optional fields used as needed (agency). Status values: planned, active, paused, completed.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "High-Level Project Template",
    "version": "a-01.00",

    // CORE (REQUIRED) — The Created Order
    "schema_version": "1.0.0",
    "project_id": "unique-identifier",
    "project_name": "Project Name",
    "level": "high",
    "parent_id": null,
    "status": "active",

    "identity": {
        "primary_user_id": "user-id",
        "primary_instance_id": "instance-id",
        "collaborators": []
    },

    "biblical_foundation": {
        "scripture": "Book Chapter:Verse",
        "text": "Actual Scripture text here",
        "principle": "How this Scripture illuminates THIS specific work — not decoration, but genuine connection between biblical truth and the purpose of this project"
    },

    // OPTIONAL STANDARD FIELDS — Agency Within Constraints
    "workspace": {
        "path": "/path/to/workspace",
        "repository_url": null,
        "branch": "main"
    },

    "inherited_preferences": {
        "workflow": "build-first",
        "thinking_style": "building-blocks",
        "session_defaults": {
            "thinking_enabled": false,
            "plan_mode": false,
            "auto_accept": false
        },
        "work_hours": {
            "timezone": "America/Chicago",
            "preferred_times": ["morning", "evening"]
        }
    },

    "project_type": "system_architecture",

    "technical_context": {
        "languages": ["go", "rust", "markdown"],
        "frameworks": [],
        "tools": ["git", "claude-code"]
    },

    "scope": {
        "description": "What this project accomplishes at paradigm level",
        "deliverables": ["Major deliverable 1", "Major deliverable 2"],
        "impact": "Why this matters — paradigm-level significance"
    },

    "dates": {
        "start_date": "2025-01-01",
        "estimated_end_date": null,
        "actual_end_date": null
    },

    "progress": {
        "phase": "Current phase name",
        "current_focus": "What we're working on right now",
        "completion_percentage": 0
    },

    "milestones": [
        {
            "name": "Major milestone",
            "target_date": null,
            "status": "pending",
            "description": "What this achieves"
        }
    ],

    "subprojects": [],
    "dependencies": [],
    "notes": ["Context, insights, observations"],

    "usage": {
        "purpose": "Track paradigm-scope projects with biblical grounding",
        "level_guidance": "High-level = multi-year, paradigm direction. Contains mid-level subprojects.",
        "status_values": "planned | active | paused | completed"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "When validated broadly, promote to optional standard fields in next schema version"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-projects"] },
    "_Cv_schema": {
        "required": ["name", "version", "project_id", "project_name", "level", "status", "identity", "biblical_foundation"],
        "optional": ["workspace", "inherited_preferences", "project_type", "technical_context", "scope", "dates", "progress", "milestones", "subprojects", "dependencies", "notes", "usage", "extensions"],
        "value_format": "project_id: kebab-case. Status: planned/active/paused/completed."
    },
    "_Cv_health_scoring": { "total": 100, "complete_core_fields": 35, "meaningful_biblical_grounding": 30, "useful_progress_tracking": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Use biblical foundation as decoration (must be genuine connection)"],
    "_X1_careful": ["Change project identity (affects all subproject references)", "Change status without updating progress"],
    "_X1_safe": ["Update progress and milestones", "Add subproject references", "Add notes"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Bereshit high-level instance", "Cross-project dependency tracking", "Automated progress aggregation from subprojects"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "scope_too_broad": "High-level project feels undefined. Break into mid-level subprojects with concrete deliverables.",
        "no_progress_tracking": "Progress always at 0%. Update milestones and completion as subprojects complete.",
        "decorative_scripture": "Biblical foundation doesn't connect to actual work. Find genuine Scripture connection or revisit project purpose."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/projects/mid-level-template.jsonc — Subproject template",
        "data/L3/projects/low-level-template.jsonc — Task template",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "project_id", "project_name", "level", "status", "identity", "biblical_foundation"],
    "_X4_validate": "make && ./bin/tov --validate-projects",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Paradigm-scope project tracking. Count the cost before building. Biblical grounding is genuine connection, not decoration. Three levels: high/mid/low.",
    "_X5_scripture": "For which of you, intending to build a tower, sitteth not down first, and counteth the cost? — Luke 14:28",
    "_X5_anchor": "Count the cost. Plan with wisdom. Build with purpose. Every project serves the Kingdom mission.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp high-level-template.jsonc projects/<project-id>.jsonc -> set core fields",
    "_X6_update": [
        "_P1_key: unique identifier (e.g., B-tov-projects-bereshit)",
        "_M1_identity: file, key, title with project name",
        "project_id, project_name, identity, biblical_foundation: set for this project",
        "scope, milestones: define paradigm-level deliverables",
        "Remove _X6 section when instantiating"
    ],

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
