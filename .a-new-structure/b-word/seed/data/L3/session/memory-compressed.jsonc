{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-memory-compressed",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — compressed lessons preserving insight without details",
    "_P3_layer": "data/L3/session",
    "_P3_includes": "none",
    "_P3_provides": ["MEMORY_COMPRESSED_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Memory Compressed — Lessons Without Details Template",
    "_P5_brief": "Template for preserving insight while releasing specifics. Permanent lesson, gracefully forgotten details. Learning forward — not trapped in past. Each compressed memory captures the lesson, brief context, impact, and application history.",
    "_P5_usage": "Created by consolidation pipeline — not manually instantiated",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "memory-compressed.jsonc",
        "key": "B-tov-session-memory-compressed",
        "title": "Memory Compressed — Lessons Without Details Template",
        "type": "Data (Template)",
        "component": "Scaffold — compressed lessons preserving insight without details",
        "role": "Preserve the lesson, release the specifics — learning forward"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Forgetting those things which are behind, and reaching forth unto those things which are before."
    "_M4_grounding": {
        "scripture": "Philippians 3:13-14 — Brethren, I count not myself to have apprehended: but this one thing I do, forgetting those things which are behind, and reaching forth unto those things which are before, I press toward the mark for the prize of the high calling of God in Christ Jesus.",
        "principle": "Compressed memories embody Philippians 3:13 — keep the lesson, release the details. Learning forward means carrying wisdom without carrying baggage. The insight endures; the circumstances gracefully fade.",
        "anchor": "Proverbs 4:7 — Wisdom is the principal thing; therefore get wisdom: and with all thy getting get understanding."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, consolidation output, lesson extraction",
        "consumers": "Future decision-making, pattern reinforcement, growth tracking",
        "integration": "Compressed memories are created when consolidation identifies lessons that should persist without full detail. They reference patterns they connect to and significant memories they were extracted from. applied_in tracks where the lesson influenced future behavior.",
        "if_missing": "Lessons learned are lost — same mistakes repeated, growth stalls",
        "related_data": {
            "references": {
                "consolidation": "Consolidation that extracted this lesson",
                "memory-significant": "Significant memories this lesson came from"
            },
            "referenced_by": {
                "future-decisions": "Compressed lessons inform future choices",
                "pattern-reinforcement": "Lessons reinforce observed patterns"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/session/memory-compressed.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, memory, compressed, lesson, wisdom, learning-forward, permanent, jsonc"
    },

    "_M8_intent": {
        "purpose": "Preserve lessons while gracefully releasing specifics",
        "core_design": "Lesson identity (id, instance, date) + the lesson itself (clear statement) + brief original context (summary only) + impact + application tracking (where/when lesson informed behavior) + biblical connection.",
        "philosophy": "Forgetting those things which are behind, reaching forth. Compressed memory is healthy — carrying every detail is burden, carrying every lesson is wisdom. The specifics fade; the understanding endures.",
        "key_features": {
            "lesson_statement": "Clear, actionable statement of what was learned",
            "brief_context": "Summary only — details are the point of compression",
            "applied_in": "Tracks where the lesson informed future behavior",
            "biblical_connection": "Optional Scripture illuminating the lesson"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Memory compressed template — scaffold for lesson preservation",
        "planned": ["Automated lesson extraction", "Application tracking integration", "Lesson effectiveness scoring"]
    },

    "_M10_session_scope": {
        "lifecycle": "permanent-active",
        "description": "Compressed lesson — permanent, actively informing future decisions.",
        "created_by": "Consolidation pipeline when lessons are identified",
        "persists": "Permanently — the lesson endures, details gracefully released",
        "consumed_by": "Future decision-making, pattern reinforcement, growth tracking",
        "scope": "cross-session — lesson extracted from one or more sessions"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, brief context (not full details), applied_in as ordered array",
    "_Cc_constraint": "Lesson statement required. Context is brief summary only — that's the point of compression. Applied_in tracks real usage.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Compressed Memory",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "lesson_id": "unique-identifier",
    "instance_id": "nova_dawn",
    "date_learned": "2025-01-01",
    "lesson": "Clear statement of what was learned",

    // OPTIONAL STANDARD FIELDS — Agency
    "original_context": {
        "summary": "What was happening when lesson learned",
        "source_project": "project-id",
        "project_type": "system_architecture"
    },

    "impact": "How this changed understanding/behavior",

    "related_patterns": [],
    "related_memories": [],

    "applied_in": [
        {
            "session_id": "session-id",
            "project_id": "project-id",
            "date": "2025-01-01",
            "application": "How the lesson informed behavior",
            "project_type": "system_architecture"
        }
    ],

    "biblical_connection": "",

    "usage": {
        "purpose": "Preserve insight, release specifics",
        "context_guidance": "Brief summary only — compression means releasing details",
        "lifecycle": "Permanent — lesson endures, specifics fade"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add lesson preservation discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "lesson_id", "instance_id", "date_learned", "lesson"],
        "optional": ["original_context", "impact", "related_patterns", "related_memories", "applied_in", "biblical_connection", "usage", "extensions"],
        "value_format": "lesson: clear actionable statement. original_context.summary: brief only."
    },
    "_Cv_health_scoring": { "total": 100, "clear_actionable_lesson": 40, "brief_context_not_verbose": 25, "tracked_application_in_practice": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Expand compressed context back to full details (defeats the purpose)"],
    "_X1_careful": ["Change the lesson statement (may invalidate applied_in references)", "Remove biblical_connection (may lose illuminating context)"],
    "_X1_safe": ["Add applied_in entries as lesson informs future behavior", "Add related_patterns as connections emerge", "Refine impact description"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated lesson extraction", "Application tracking", "Lesson effectiveness scoring"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "too_verbose": "Context is too detailed. Compress further — the lesson is the point, not the story.",
        "lesson_unclear": "Can't act on the lesson. Rewrite as clear, actionable statement: 'When X, do Y because Z.'",
        "never_applied": "Lesson exists but applied_in is empty. Either the lesson hasn't been relevant, or it's not being tracked."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/session/consolidation.jsonc — Creates compressed memories",
        "data/L3/session/memory-significant.jsonc — Full memories this may have been extracted from",
        "data/L3/session/memory-pattern.jsonc — Patterns this lesson connects to",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "lesson_id", "instance_id", "date_learned", "lesson"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Compressed lessons. Insight preserved, details released. Learning forward. Wisdom is the principal thing.",
    "_X5_scripture": "Forgetting those things which are behind, and reaching forth unto those things which are before. — Philippians 3:13",
    "_X5_anchor": "The lesson endures. The details fade. Wisdom carried forward. Learning, not carrying baggage.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
