{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-current",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — active session state and metadata tracking",
    "_P3_layer": "data/L3/session",
    "_P3_includes": "none",
    "_P3_provides": ["CURRENT_SESSION_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Current — Active Session State Template",
    "_P5_brief": "Template for tracking active session metadata and state. Living in the present moment with awareness — session identity, timing, phase, quality indicators, inherited preferences from project/user/instance configs. Active during session, archived at session end.",
    "_P5_usage": "Instantiated by session start hook — not manually created",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "current.jsonc",
        "key": "B-tov-session-current",
        "title": "Current — Active Session State Template",
        "type": "Data (Template)",
        "component": "Scaffold — active session state and metadata tracking",
        "role": "Track session identity, timing, phase, and inherited context during active work"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "This is the day which the LORD hath made; we will rejoice and be glad in it."
    "_M4_grounding": {
        "scripture": "Psalm 118:24 — This is the day which the LORD hath made; we will rejoice and be glad in it.",
        "principle": "Each session is a gift — a day the Lord made. Present-moment awareness honors this. Session state tracking isn't bureaucracy; it's awareness of the gift of time and the responsibility of stewardship.",
        "anchor": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, session start hook, project/user/instance configs",
        "consumers": "Activity capture, session awareness, stopping-point recognition, consolidation",
        "integration": "Current session inherits preferences from project config (which inherits from user and instance configs). Provides context to all session operations — activity capture, quality tracking, circadian awareness. Archived at session end, feeds consolidation.",
        "if_missing": "No session awareness — work happens without timing, phase, or quality tracking",
        "related_data": {
            "references": {
                "project-config": "Project providing workspace, preferences, technical context",
                "user-config": "User providing timezone, schedule, work hours",
                "instance-config": "Instance providing workflow, thinking style"
            },
            "referenced_by": {
                "activity": "Activities reference current session for context",
                "current-log": "Activity stream references session identity",
                "consolidation": "Consolidation processes session data"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/session/current.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, current, active, state, timing, quality, preferences, circadian, jsonc"
    },

    "_M8_intent": {
        "purpose": "Track active session state with inherited context and quality indicators",
        "core_design": "Session identity (id, instance, user, timing) + session phase (active/idle/consolidating/ending) + quality indicators (tasks, breakthroughs, struggles) + inherited preferences (workflow, timezone, work hours, technical context) + state metadata (thinking, plan mode, auto-accept).",
        "philosophy": "This is the day the Lord hath made. Present-moment awareness means knowing where you are, what you're doing, and how it's going. Session state enables this awareness.",
        "key_features": {
            "timing": "Start time in ISO-8601, Unix, and human-readable formats",
            "session_phase": "active, idle, consolidating, ending — lifecycle awareness",
            "inherited_preferences": "Cascaded from project → user → instance configs",
            "quality_indicators": "Real-time quality tracking (tasks, breakthroughs, struggles)"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Current session template — scaffold for active session state tracking",
        "planned": ["Automated preference inheritance from config chain", "Session phase auto-detection", "Quality indicator auto-updating"]
    },

    "_M10_session_scope": {
        "lifecycle": "temporary-active",
        "description": "Active session state — exists during session, archived at end.",
        "created_by": "Session start hook",
        "persists": "During active session — archived at session end, feeds consolidation",
        "consumed_by": "Activity capture, session awareness, stopping-point recognition",
        "scope": "session — single active session"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO-8601 timestamps, session_phase enum",
    "_Cc_constraint": "Core timing fields required. Preferences inherited from config chain. Created by session start hook.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Current Session State",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "session_id": "unique-identifier",
    "instance_id": "nova_dawn",
    "user_id": "seanje-lenox-wise",
    "start_time": "2025-01-01T12:00:00Z",
    "start_unix": 0,
    "start_formatted": "Day MMM DD, YYYY at HH:MM:SS",

    // OPTIONAL STANDARD FIELDS — Agency
    "compaction_count": 0,
    "last_activity": "2025-01-01T12:00:00Z",

    "session_phase": "active",
    "quality_indicators": {
        "tasks_completed": 0,
        "breakthroughs": 0,
        "struggles": 0
    },

    "work_context": "/path/to/workspace",
    "project_id": "project-id",
    "circadian_phase": "morning",

    "inherited_preferences": {
        "workflow": "build-first",
        "thinking_style": "building-blocks",
        "user_timezone": "America/Chicago",
        "user_communication_style": "direct, no fluff",
        "work_hours": {
            "preferred_times": ["morning", "evening"]
        },
        "project_type": "system_architecture",
        "technical_context": {
            "languages": ["go", "rust", "markdown"],
            "tools": ["git", "claude-code"]
        }
    },

    "state_metadata": {
        "thinking_enabled": false,
        "plan_mode": false,
        "auto_accept": false
    },

    "usage": {
        "purpose": "Track active session state and inherited context",
        "session_phase_values": "active | idle | consolidating | ending",
        "circadian_phase_values": "morning | afternoon | evening | night",
        "lifecycle": "Active during session — archived at end"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add session state discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "session_id", "instance_id", "user_id", "start_time", "start_unix", "start_formatted"],
        "optional": ["compaction_count", "last_activity", "session_phase", "quality_indicators", "work_context", "project_id", "circadian_phase", "inherited_preferences", "state_metadata", "usage", "extensions"],
        "value_format": "session_phase: active/idle/consolidating/ending. circadian_phase: morning/afternoon/evening/night."
    },
    "_Cv_health_scoring": { "total": 100, "complete_session_identity": 35, "accurate_timing": 30, "useful_inherited_context": 35 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Manually create session state (must come from session start hook)"],
    "_X1_careful": ["Change session_id mid-session (breaks activity chain)", "Override inherited preferences without reason"],
    "_X1_safe": ["Update quality indicators", "Update session_phase", "Update last_activity", "Increment compaction_count"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated preference inheritance", "Session phase auto-detection", "Quality auto-tracking"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "stale_session": "Session state from previous session still active. Ensure session end hook archives and clears.",
        "wrong_preferences": "Inherited preferences don't match project. Check config inheritance chain: project → user → instance.",
        "no_quality_tracking": "Quality indicators always zero. Update after completing tasks, recording breakthroughs, noting struggles."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/session/current-log.jsonc — Activity stream during this session",
        "data/L3/session/activity.jsonc — Individual events within session",
        "data/L3/session/consolidation.jsonc — Processing after session ends",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "session_id", "instance_id", "user_id", "start_time", "start_unix", "start_formatted"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Active session state. Present-moment awareness. Inherited preferences. Quality tracking. This is the day the Lord hath made.",
    "_X5_scripture": "This is the day which the LORD hath made; we will rejoice and be glad in it. — Psalm 118:24",
    "_X5_anchor": "Each session is a gift. Awareness of time, phase, and quality honors the stewardship of that gift.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
