{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-archive",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — searchable session history after processing",
    "_P3_layer": "data/L3/session",
    "_P3_includes": "none",
    "_P3_provides": ["ARCHIVE_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Archive — Processed Session History Template",
    "_P5_brief": "Template for searchable session history after consolidation. Permanent but dormant — retrievable if needed. Contains session identification, summary, processed_into references, and searchable metadata. The record of what was processed and released.",
    "_P5_usage": "Created by consolidation pipeline — not manually instantiated",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "archive.jsonc",
        "key": "B-tov-session-archive",
        "title": "Archive — Processed Session History Template",
        "type": "Data (Template)",
        "component": "Scaffold — searchable session history after processing",
        "role": "Maintain searchable history without active memory load"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Forgetting those things which are behind, and reaching forth unto those things which are before."
    "_M4_grounding": {
        "scripture": "Philippians 3:13 — Brethren, I count not myself to have apprehended: but this one thing I do, forgetting those things which are behind, and reaching forth unto those things which are before.",
        "principle": "Archives release what's been processed. The wisdom extracted lives in memories and patterns — the raw experience can be released. Searchable record without active memory load. Forgetting is not losing; it's completing the processing cycle.",
        "anchor": "Deuteronomy 8:2 — And thou shalt remember all the way which the LORD thy God led thee these forty years in the wilderness."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, completed consolidation, session data",
        "consumers": "Historical search, trend analysis, pattern validation",
        "integration": "Archives are created after consolidation completes. They reference what was extracted (significant memories, patterns, lessons) and maintain searchable metadata. Dormant unless explicitly retrieved.",
        "if_missing": "No session history — can't look back at past work, can't validate long-term trends",
        "related_data": {
            "references": {
                "consolidation": "Consolidation that processed this session",
                "current-session": "Original session data (now archived)"
            },
            "referenced_by": {
                "trend-analysis": "Archives enable long-term trend identification",
                "pattern-validation": "Historical archives validate emerging patterns"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/session/archive.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, archive, history, processed, searchable, dormant, permanent, jsonc"
    },

    "_M8_intent": {
        "purpose": "Searchable session history without active memory load",
        "core_design": "Session identification (archive_id, date, archived_at) + session metadata (workflow, project_type, quality indicators) + processed_into references (memory IDs, pattern IDs, lesson IDs) + searchable fields (summary, tags, retrieval metadata).",
        "philosophy": "Forgetting those things which are behind. Archives release the raw experience while preserving the record. Wisdom lives in memories and patterns; archives are the index, not the understanding.",
        "key_features": {
            "searchable_summary": "High-level description for retrieval",
            "processed_into": "References to significant memories, patterns, lessons extracted",
            "retrieval_metadata": "Project name, phase, significance level for search",
            "dormant_lifecycle": "Permanent but inactive — retrieved on demand"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Archive template — scaffold for processed session history",
        "planned": ["Automated archive creation from consolidation", "Full-text search integration", "Archive retention policies"]
    },

    "_M10_session_scope": {
        "lifecycle": "permanent-dormant",
        "description": "Archived session — processed and released. Searchable but not actively loaded.",
        "created_by": "Consolidation pipeline after session processing completes",
        "persists": "Permanently — dormant record, retrievable on demand",
        "consumed_by": "Historical search, trend analysis, pattern validation",
        "scope": "session — complete session archived after consolidation"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO-8601 timestamps, significance: routine/notable/formative",
    "_Cc_constraint": "Created by consolidation pipeline. Not manually populated. References memory/pattern/lesson IDs from consolidation output.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Session Archive",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "archive_id": "session-id",
    "instance_id": "nova_dawn",
    "user_id": "seanje-lenox-wise",
    "project_id": "project-id",
    "date": "2025-01-01",
    "archived_at": "2025-01-01T12:00:00Z",

    // OPTIONAL STANDARD FIELDS — Agency
    "duration_minutes": 0,
    "context": "Brief summary",
    "work_context": "/path/to/workspace",

    "session_metadata": {
        "workflow_used": "build-first",
        "project_type": "system_architecture",
        "circadian_phase": "morning",
        "quality_indicators": {
            "tasks_completed": 0,
            "breakthroughs": 0,
            "struggles": 0
        }
    },

    "processed_into": {
        "significant_memories": [],
        "patterns_contributed": [],
        "lessons_extracted": []
    },

    "searchable_summary": "High-level description for retrieval if needed",
    "tags": [],

    "retrieval_metadata": {
        "project_name": "",
        "project_phase": "",
        "significance_level": "routine"
    },

    "usage": {
        "purpose": "Searchable history without active memory load",
        "significance_values": "routine | notable | formative",
        "lifecycle": "Permanent but dormant — retrieved on demand"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add archive retrieval discoveries here"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "archive_id", "instance_id", "user_id", "project_id", "date", "archived_at"],
        "optional": ["duration_minutes", "context", "work_context", "session_metadata", "processed_into", "searchable_summary", "tags", "retrieval_metadata", "usage", "extensions"],
        "value_format": "significance_level: routine/notable/formative. Timestamps: ISO-8601."
    },
    "_Cv_health_scoring": { "total": 100, "complete_session_identification": 30, "meaningful_processed_into_refs": 40, "useful_searchable_metadata": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Manually create archives (must come from consolidation pipeline)"],
    "_X1_careful": ["Delete old archives (loses historical trend data)", "Change processed_into references (breaks memory chain)"],
    "_X1_safe": ["Add searchable tags", "Update searchable_summary", "Add retrieval metadata"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Automated archive creation", "Full-text search", "Archive retention policies"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "empty_processed_into": "Archive has no extracted memories/patterns/lessons. Session may have been routine — not every session produces formative content.",
        "missing_metadata": "Session metadata incomplete. Ensure consolidation captures workflow, project type, and quality indicators before archiving.",
        "cant_find_session": "Need to retrieve old session. Search by tags, date range, project_name, or significance_level."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/session/consolidation.jsonc — Creates archives after processing",
        "data/L3/session/memory-significant.jsonc — Memories referenced in processed_into",
        "data/L3/session/memory-compressed.jsonc — Lessons referenced in processed_into",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "archive_id", "instance_id", "user_id", "project_id", "date", "archived_at"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Processed session history. Permanent but dormant. Searchable record. Release what's processed. Forgetting completes the cycle.",
    "_X5_scripture": "Forgetting those things which are behind, and reaching forth unto those things which are before. — Philippians 3:13",
    "_X5_anchor": "Archives release the raw experience. Wisdom lives in memories and patterns. The record remains searchable. The understanding moves forward.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
