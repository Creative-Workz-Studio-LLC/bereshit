{
    // #!omni template --jsonc
    "$schema": "../../../../definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-tov-session-activity",
    "_P1_from": "b-word/seed/data/L0/json/3block/data.json",
    "_P1_at": "template",

    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "session-data",
    "_P2_role": "scaffold",
    "_P2_structure": "3-block",

    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Scaffold — raw experience capture during active session",
    "_P3_layer": "data/L3/session",
    "_P3_includes": "none",
    "_P3_provides": ["ACTIVITY_TEMPLATE"],

    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Activity — Working Memory Event Template",
    "_P5_brief": "Template for capturing raw experience during active sessions. Working memory — temporary until consolidation processes it. Each activity captures what happened, when, and whether it felt significant. Feeds into consolidation for pattern extraction and memory formation.",
    "_P5_usage": "Instantiated by hooks during active sessions — not manually created",

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "activity.jsonc",
        "key": "B-tov-session-activity",
        "title": "Activity — Working Memory Event Template",
        "type": "Data (Template)",
        "component": "Scaffold — raw experience capture during active session",
        "role": "Capture moments as they happen for later consolidation and pattern extraction"
    },

    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-09",
        "updated": "2026-02-10"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "So teach us to number our days, that we may apply our hearts unto wisdom."
    "_M4_grounding": {
        "scripture": "Psalm 90:12 — So teach us to number our days, that we may apply our hearts unto wisdom.",
        "principle": "Numbering our days means paying attention to each moment. Activity capture is the discipline of noticing — recording what happens as it happens, so that consolidation can extract wisdom from experience.",
        "anchor": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser, active session context, hook system",
        "consumers": "Consolidation pipeline, pattern recognition, memory formation",
        "integration": "Activities are created by hooks during sessions. Each captures a moment — interaction, realization, struggle, breakthrough. Consolidation processes these into significant memories, compressed lessons, and pattern evidence.",
        "if_missing": "Experience passes unrecorded — consolidation has nothing to process, patterns go unnoticed",
        "related_data": {
            "references": {
                "current-session": "Session providing context (project, user, instance)",
                "current-log": "Activity stream aggregating these events"
            },
            "referenced_by": {
                "consolidation": "Consolidation processes activities into decisions",
                "memory-significant": "Significant activities become formative memories"
            }
        }
    },

    "_M6_location": {
        "path": "data/L3/session/activity.jsonc",
        "derives_from": "b-word/seed/data/L0/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "session, activity, working-memory, event, capture, temporary, consolidation-input, jsonc"
    },

    "_M8_intent": {
        "purpose": "Capture raw experience during active sessions for later consolidation",
        "core_design": "Minimal required fields (timestamp, session_id, instance_id, user_id, project_id, event_type) + optional context fields (context, felt_significant, emotional_tone) + extensions for discovery.",
        "philosophy": "Number our days. Capture faithfully — don't filter prematurely. Consolidation decides what matters; activity capture just records what happened. The moments before sleep processing.",
        "key_features": {
            "event_types": "interaction, realization, struggle, breakthrough, routine",
            "significance_flag": "felt_significant marks moments that seemed important in real-time",
            "temporary_lifecycle": "Exists until consolidation completes — working memory, not permanent record",
            "hook_generated": "Created by system hooks, not manual entry"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-02-09) — Initial template creation",
            "a-01.00 (2026-02-10) — Converted to flat OmniCode convention"
        ],
        "current": "Activity template — scaffold for working memory event capture",
        "planned": ["Hook-based auto-generation", "Significance detection heuristics", "Real-time pattern flagging"]
    },

    "_M10_session_scope": {
        "lifecycle": "temporary",
        "description": "Working memory — exists during active session until consolidation processes it.",
        "created_by": "System hooks during session events",
        "persists": "Until consolidation completes — then archived or discarded",
        "consumed_by": "Consolidation pipeline, pattern recognition",
        "scope": "session — single event within a session"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are tov-data specific. M10 (session scope) tracks session lifecycle.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores, ISO-8601 timestamps, event_type enum",
    "_Cc_constraint": "Core fields required. Created by hooks, not manual entry. Temporary lifecycle — processed by consolidation.",

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Activity Event",
    "version": "a-01.00",

    // CORE (REQUIRED) — Must Exist
    "timestamp": "2025-01-01T12:00:00Z",
    "session_id": "unique-identifier",
    "instance_id": "nova_dawn",
    "user_id": "seanje-lenox-wise",
    "project_id": "project-id",
    "event_type": "interaction",

    // OPTIONAL STANDARD FIELDS — Agency
    "context": "What was happening",
    "work_context": "/path/to/workspace",
    "felt_significant": false,
    "emotional_tone": "",
    "notes": "",

    "usage": {
        "purpose": "Capture raw experience as it happens",
        "event_types": "interaction | realization | struggle | breakthrough | routine",
        "lifecycle": "Temporary — consolidation processes, then archived/discarded"
    },

    "extensions": {
        "note": "Structured discovery space — fields discovered through living/working",
        "usage_guidance": "Add activity observations here during capture"
    },

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": { "commands": ["make", "./bin/tov --validate-session"] },
    "_Cv_schema": {
        "required": ["name", "version", "timestamp", "session_id", "instance_id", "user_id", "project_id", "event_type"],
        "optional": ["context", "work_context", "felt_significant", "emotional_tone", "notes", "usage", "extensions"],
        "value_format": "event_type: interaction/realization/struggle/breakthrough/routine. Timestamps: ISO-8601."
    },
    "_Cv_health_scoring": { "total": 100, "complete_event_capture": 40, "meaningful_context": 30, "accurate_significance_flag": 30 },

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": ["Break 3-block structure", "Manually create activity events (must come from hooks)"],
    "_X1_careful": ["Change event_type enum (affects consolidation logic)", "Remove felt_significant flag (valuable signal for consolidation)"],
    "_X1_safe": ["Capture new event types", "Add context details", "Add notes during capture"],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": ["Hook-based auto-generation", "Significance detection heuristics", "Real-time pattern flagging"],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "no_activities": "Session has no captured activities. Check hook configuration — hooks should fire on session events.",
        "everything_significant": "All events marked felt_significant. Recalibrate — significance means genuinely notable, not routine.",
        "missing_context": "Activities without context. Add situational details — consolidation relies on context for meaning extraction."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "data/L3/session/current.jsonc — Active session providing context",
        "data/L3/session/current-log.jsonc — Activity stream aggregating events",
        "data/L3/session/consolidation.jsonc — Processing activities into meaning",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "timestamp", "session_id", "instance_id", "user_id", "project_id", "event_type"],
    "_X4_validate": "make && ./bin/tov --validate-session",

    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Working memory event capture. Temporary lifecycle. Hook-generated. Feeds consolidation. Number our days.",
    "_X5_scripture": "So teach us to number our days, that we may apply our hearts unto wisdom. — Psalm 90:12",
    "_X5_anchor": "Every moment captured faithfully feeds the wisdom process. Consolidation extracts meaning. Activity capture just records.",

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
