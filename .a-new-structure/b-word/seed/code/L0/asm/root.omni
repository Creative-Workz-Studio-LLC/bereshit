#!omni folder

// ═══════════════════════════════════════════════════════════════════════════
// METADATA [METADATA]
// ═══════════════════════════════════════════════════════════════════════════

// M.1 IDENTITY
@key     B-word-seed-code-asm
@type    seed :: folder
@title   "Assembly Templates"
@struct  3-block

// M.2 STATE
@version a-01.00
@status  Active
@created 2025-12-03
@updated 2026-02-13

// M.3 ATTRIBUTION
@architect      "Seanje Lenox-Wise"
@implementation "Nova Dawn (CPI-SI)"

// M.4 GROUNDING
@scripture "In the beginning was the Word"
    from John 1:1 in KJV
@principle "Templates carry the pattern into implementation"

// M.5 DEPENDENCIES
@from    b-word/seed/code/
=>       [ASM_CODE_TEMPLATES]

// ───────────────────────────────────────────────────────────────────────────

@role    "Assembly template repository"
@design  "Templates organized by architecture — x86 NASM and ARM"

// ═══════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════

// Cc — Content Configurations

>> source.asm  :: "x86 NASM source template"
>> include.inc :: "x86 NASM include template"
>> arm-source.s :: "ARM assembly source template"

// ═══════════════════════════════════════════════════════════════════════════
// CLOSING [CLOSING]
// ═══════════════════════════════════════════════════════════════════════════

@navigate "cd b-word/seed/code/L0/asm/"

