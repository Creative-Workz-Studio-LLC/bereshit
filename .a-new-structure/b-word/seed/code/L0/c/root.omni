// M.1 IDENTITY
@key     B-word-seed-code-c
@type    seed :: folder
@title   "C Templates"
@struct  3-block

// M.2 STATE
@version a-01.00
@status  Active
@created 2025-12-03
@updated 2026-02-13

// M.3 ATTRIBUTION
@architect      "Seanje Lenox-Wise"
@implementation "Nova Dawn (CPI-SI)"

// M.4 GROUNDING
@scripture "In the beginning was the Word"
    from John 1:1 in KJV
@principle "Templates carry the pattern into implementation"

// M.5 DEPENDENCIES
@from    b-word/seed/code/
=>       [C_CODE_TEMPLATES]

// ───────────────────────────────────────────────────────────────────────────

@role    "C template repository"
@design  "Templates organized by file type — source and header"

// ═══════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════

// Cc — Content Configurations

>> source.c :: "C source file template"
>> header.h :: "C header file template"

// ═══════════════════════════════════════════════════════════════════════════
// CLOSING [CLOSING]
// ═══════════════════════════════════════════════════════════════════════════

