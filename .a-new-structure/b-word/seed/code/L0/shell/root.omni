#!omni folder

// ═══════════════════════════════════════════════════════════════════════════
// METADATA [METADATA]
// ═══════════════════════════════════════════════════════════════════════════

// M.1 IDENTITY
@key     B-word-seed-code-shell
@type    seed :: folder
@title   "Shell Templates"
@struct  3-block

// M.2 STATE
@version a-01.00
@status  Active
@created 2025-12-03
@updated 2026-02-13

// M.3 ATTRIBUTION
@architect      "Seanje Lenox-Wise"
@implementation "Nova Dawn (CPI-SI)"

// M.4 GROUNDING
@scripture "In the beginning was the Word"
    from John 1:1 in KJV
@principle "Templates carry the pattern into implementation"

// M.5 DEPENDENCIES
@from    b-word/seed/code/
=>       [SHELL_CODE_TEMPLATES]

// ───────────────────────────────────────────────────────────────────────────

@role    "Shell template repository"
@design  "Templates organized by complexity — atomic 3-block and full 4-block"

// ═══════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════

// Cc — Content Configurations

>> script.sh              :: "Full 4-block shell script template"
>> shell-atomic-3block.sh :: "Minimal 3-block atomic script"
>> shell-script-4block.sh :: "Standard 4-block script"

// ═══════════════════════════════════════════════════════════════════════════
// CLOSING [CLOSING]
// ═══════════════════════════════════════════════════════════════════════════

@navigate "cd b-word/seed/code/L0/shell/"

// ═══════════════════════════════════════════════════════════════════════════
// END [END]
