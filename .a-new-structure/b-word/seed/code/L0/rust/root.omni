#!omni folder

// ═══════════════════════════════════════════════════════════════════════════
// METADATA [METADATA]
// ═══════════════════════════════════════════════════════════════════════════

// M.1 IDENTITY
@key     B-seed-code-L0-rust
@type    seed :: folder
@title   "Rust Templates"
@struct  3-block

// M.2 STATE
@version a-01.00
@status  Active
@created 2026-02-14
@updated 2026-02-14

// M.3 ATTRIBUTION
@architect      "Seanje Lenox-Wise"
@implementation "Nova Dawn (CPI-SI)"

// M.4 GROUNDING
@scripture "In the beginning was the Word"
    from John 1:1 in KJV
@principle "Templates carry the pattern into implementation"

// M.5 DEPENDENCIES
@from    b-word/seed/code/
=>       [RUST_CODE_TEMPLATES]

// ───────────────────────────────────────────────────────────────────────────

@role    "Rust template repository"
@design  "Templates organized by function type — library, executable, demo-test"
@note    "Adapted from Go templates; cli/src/lib.rs is the living example"

// ═══════════════════════════════════════════════════════════════════════════
// CONTENT [CONTENT]
// ═══════════════════════════════════════════════════════════════════════════

// Cc — Content Configurations

>> library.rs    :: "Rust library crate template (4-block, typestate pattern)"
>> executable.rs :: "Rust executable template (4-block, main->run pattern)"
>> demo-test.rs  :: "Rust demo-test template (inline + integration patterns)"

// ═══════════════════════════════════════════════════════════════════════════
// CLOSING [CLOSING]
// ═══════════════════════════════════════════════════════════════════════════

@navigate "cd b-word/seed/code/L0/rust/"
@parallel "b-word/seed/code/L0/go/"

// ═══════════════════════════════════════════════════════════════════════════
// END [END]
// ═══════════════════════════════════════════════════════════════════════════
