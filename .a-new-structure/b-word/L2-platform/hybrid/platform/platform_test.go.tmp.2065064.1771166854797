// ───────────────────────────────────────────────────────────────────────────
// Thread Safety — concurrent reads should not panic
// ───────────────────────────────────────────────────────────────────────────

func TestConcurrentReads(t *testing.T) {
	db := openTestDB(t)
	done := make(chan bool, 10)

	for i := 0; i < 10; i++ {
		go func() {
			defer func() { done <- true }()
			_, _ = db.AllHealthLevels()
			_, _ = db.AllSpecs()
			_, _ = db.SpecCount()
		}()
	}

	for i := 0; i < 10; i++ {
		<-done
	}
}

