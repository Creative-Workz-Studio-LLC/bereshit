{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-base-3block-schema",
    "_P1_from": "b-word/seed/data/json/config.jsonc",
    "_P1_at": "a-03.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas",
    "_P3_includes": "none",
    "_P3_provides": ["BASE_3BLOCK_SCHEMA", "SHARED_DEFS", "PRAGMA_ROUTING", "FORMAT_REGISTRY", "FORM_REGISTRY"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Base 3-Block Schema",
    "_P5_brief": "Format-independent foundation for OmniCode 3-block structure. Provides pragma_routing (inner pragma), format_registry (all 3-block formats), form_registry (bare-bone + Cargo forms with active/reserved sections). Defines shared $defs using unified I/C metadata (I1-I4 identity, C1-C7 context), content Cc/Co/Cv zones, and X1-X5 closing with field-level requirements.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "base-3block-schema.jsonc",
        "key": "B-definitions-omni-base-3block-schema",
        "title": "Base 3-Block Schema",
        "type": "Data (Schema Foundation)",
        "component": "Ladder",
        "role": "Define format-independent 3-block structure with unified I/C metadata"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-03.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-20"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING — "In the beginning God created the heaven and the earth."
    //   — Genesis 1:1
    "_M4_grounding": {
        "scripture": "Genesis 1:1 — In the beginning God created the heaven and the earth.",
        "principle": "Before format, before syntax, before representation — there is structure. This schema defines the structure that every format must express."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "none — this is the root schema",
        "consumers": "json-3block-schema.jsonc, toml-3block-schema.jsonc, future format schemas",
        "relationship": "Base provides shared $defs. Format schemas inherit concepts and map to format-specific representation."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract. This file defines the contract itself."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // The 3-block structure uses UNIFIED METADATA (I/C):
    //   _metadata — single block containing both Identity (I) and Context (C)
    //   _content  — data with Cc/Co/Cv zones
    //   _closing  — guidance with X1-X5 sections
    //
    // The OLD pragma+metadata split has been MERGED:
    //   OLD: _pragma (P1-P5) + _metadata (M1-M5+) → NEW: _metadata (I1-I4 + C1-C7 + _contract)
    //
    // Each format expresses this differently:
    //   TOML  — nested tables ([_metadata.I1_core], [_closing.X1_policy])
    //   JSON  — flat _ keys (_M1_identity) or nested objects
    //   Go    — comments (// I.1 CORE, // C.1 STATE)
    //   C     — comments (/* I.1 CORE */, /* C.1 STATE */)
    //
    // The $defs below define WHAT each section contains.
    // Format schemas define HOW to represent it.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Schema identity and structure overview.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/base-3block.schema.json",
    "title": "OmniCode Base 3-Block Structure",
    "description": "Format-independent definition of OmniCode 3-block structure. Uses unified I/C metadata: I1-I4 (Identity — what IS this file) + C1-C7 (Context — what do I need to KNOW) + _contract. Content uses Cc/Co/Cv zones. Closing uses X1-X5 with required/defined classification.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Shared type definitions ($defs). Each definition describes
    // WHAT a section contains, independent of format.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "$defs": {

        // ═══════════════════════════════════════════════════════
        // 1. PRAGMA ROUTING — The inner pragma
        // ═══════════════════════════════════════════════════════
        //
        // How #!omni parameters route to the correct schema chain.
        // This IS the inner pragma — the routing table from file
        // identity to validation rules.

        "pragma_routing": {
            "type": "object",
            "description": "How the #!omni pragma line routes to the correct schema chain for 3-block data files. The inner pragma — the routing table that maps file identity to validation.",

            "syntax": "#!omni {type} --{format} [--{derivation}] [-{form}]",
            "example_data": "# #!omni data --toml",
            "example_derived": "# #!omni code --toml --cargo --library",
            "example_template": "# #!omni template --toml --cargo --bare-bone",

            "parameters": {
                "type": {
                    "position": 1,
                    "purpose": "Block structure selection — which architectural pattern",
                    "values": {
                        "code":     { "structure": "4-block", "base_schema": "code/base/base-4block-schema.jsonc" },
                        "data":     { "structure": "3-block", "base_schema": "data/base/base-3block-schema.jsonc" },
                        "document": { "structure": "5-block", "base_schema": "doc/base/base-5block-schema.jsonc" }
                    }
                },
                "format": {
                    "position": 2,
                    "prefix": "--",
                    "purpose": "Format-specific schema — which syntax rules, key naming, comment style",
                    "note": "Routes to format schema within the block type directory. See format_registry for available formats."
                },
                "derivation": {
                    "position": "2+",
                    "prefix": "--",
                    "purpose": "Host format derivation — remaps table paths for host-format extension points (Cargo, npm, pyproject)",
                    "note": "Optional. When present, overrides standard 3-block layout with derivation-specific table structure."
                },
                "form": {
                    "position": 3,
                    "prefix": "--",
                    "purpose": "Subtype/variant — which sections are required/reserved for this form",
                    "note": "Routes to form config within format. See form_registry for available forms."
                }
            },

            "routing_chain": [
                "1. type → block structure (3/4/5-block) → base schema",
                "2. format → format-specific schema → syntax rules, key naming, comment style",
                "3. derivation → host format layout → required/defined/reserved host sections, table remapping",
                "4. form → form config → which sections are active vs reserved for this variant"
            ],

            "template_variant": {
                "keyword": "template",
                "replaces": "type",
                "syntax": "#!omni template --{format} [--{derivation}] [-{form}]",
                "note": "Templates use 'template' instead of type. The form template is a usable schema — all values describe the template ITSELF."
            }
        },

        // ═══════════════════════════════════════════════════════
        // 2. FORMAT REGISTRY — Master list of format schemas
        // ═══════════════════════════════════════════════════════
        //
        // Every 3-block format schema that inherits from this base.
        // Each format maps the same concepts to different syntax.

        "format_registry": {
            "type": "object",
            "description": "Master register of all 3-block format schemas that inherit from this base. The base defines WHAT each block contains; format schemas define HOW to represent it.",

            "formats": {
                "toml": {
                    "schema": "data/format/toml-3block-schema.jsonc",
                    "linter": "c-tov/cws-struct/lib/handlers/toml.ts",
                    "comment_syntax": "#",
                    "identity_construct": "[_metadata] tables (generic) or [package.metadata.omni] tables (Cargo)",
                    "status": "active",
                    "available_derivations": ["cargo", "compiler"],
                    "available_forms": ["bare-bone", "library", "executable"],
                    "templates": "b-word/seed/data/L0/toml/"
                },
                "json": {
                    "schema": "data/format/json-3block-schema.jsonc",
                    "linter": null,
                    "comment_syntax": "// (JSONC only)",
                    "identity_construct": "_P{N}, _M{N} prefix keys",
                    "status": "active",
                    "available_derivations": [],
                    "available_forms": ["bare-bone", "config", "schema"],
                    "templates": "b-word/seed/data/L0/json/"
                },
                "yaml": {
                    "schema": null,
                    "status": "planned"
                },
                "env": {
                    "schema": null,
                    "comment_syntax": "#",
                    "status": "planned"
                }
            },

            "parent_schema": {
                "sibling": "code/base/base-4block-schema.jsonc",
                "relationship": "This 3-block base is the sibling of the 4-block base — shared I/C metadata vocabulary, different block architecture",
                "shared": "I/C metadata definitions (I1-I4, C1-C7), closing documentation (X1-X5), shared types"
            }
        },

        // ═══════════════════════════════════════════════════════
        // 3. FORM REGISTRY — Subtypes with bare-bone awareness
        // ═══════════════════════════════════════════════════════
        //
        // All recognized 3-block form variants. bare-bone is the
        // foundation — every other form is bare-bone plus promoted
        // sections. The cheat code: cp bare-bone → change pragma →
        // promote what you need → structurally complete day one.

        "form_registry": {
            "type": "object",
            "description": "All 3-block form variants. bare-bone defines the absolute minimum. Forms build ON TOP by promoting Reserved Omission sections. Completeness check: active + reserved = bare-bone's full set.",

            "derivation_principle": "bare-bone is the blueprint. Forms are the houses. cp bare-bone → change pragma → promote sections → structurally complete.",

            "forms": {

                "bare_bone": {
                    "purpose": "Absolute minimum valid 3-block data file — foundation all forms derive from",
                    "is_foundation": true,

                    "metadata": {
                        "active": ["I1_core", "I2_family", "I3_instance", "C1_state", "C2_attribution", "C3_grounding", "C4_dependencies"],
                        "reserved": ["I4_architecture", "C5_intent", "C6_roadmap", "C7_classification"],
                        "reserved_omission_required": true
                    },
                    "content": {
                        "active": ["identity", "_validation"],
                        "reserved": ["settings", "resources", "behavior", "integrations"],
                        "reserved_omission_required": true
                    },
                    "closing": {
                        "active": ["X1_policy", "X5_note"],
                        "reserved": ["X2_extension", "X3_troubleshooting", "X4_reference"],
                        "reserved_omission_required": true
                    },

                    "note": "The cheat code — structurally complete before a single line of real data. Boundaries before content (badal)."
                },

                "cargo_library": {
                    "purpose": "Cargo.toml for library crate — exposes public API, holds crate/package identity",
                    "derivation": "cargo",
                    "content_ordering": "cargo_convention",

                    "promotes_from_bare_bone": {
                        "metadata": ["I4_architecture", "C5_intent", "C6_roadmap", "C7_classification"],
                        "content": [],
                        "closing": ["X2_extension", "X3_troubleshooting", "X4_reference"]
                    },

                    "host_sections": {
                        "required": {
                            "package": "Crate identity — name, version, edition. MUST exist.",
                            "dependencies": "Crate dependencies. Most libraries need at least one."
                        },
                        "defined": {
                            "dev-dependencies": "Test/build dependencies. Expected for testable crates.",
                            "lints": "Code quality rules. Expected for workspace-consistent linting.",
                            "features": "Feature flags. Expected for configurable crates."
                        },
                        "reserved": {
                            "bin": "Binary target [[bin]] — reserved for executable form. Libraries expose lib, not binaries.",
                            "workspace": "Workspace root [workspace] — reserved for workspace manifests, not member crates."
                        }
                    },

                    "omni_metadata": {
                        "location": "package.metadata.omni",
                        "required": "Full I1-I4, C1-C7, _contract — Cargo.toml IS the crate identity, metadata must be complete",
                        "note": "Cargo's sanctioned extension point. Cargo ignores everything under package.metadata."
                    },

                    "note": "Library Cargo.toml promotes ALL metadata sections to required because the manifest IS the crate's identity document."
                },

                "cargo_executable": {
                    "purpose": "Cargo.toml for binary crate — orchestrates via main() entry point",
                    "derivation": "cargo",
                    "content_ordering": "cargo_convention",

                    "promotes_from_bare_bone": {
                        "metadata": ["I4_architecture", "C5_intent", "C6_roadmap", "C7_classification"],
                        "content": [],
                        "closing": ["X2_extension", "X3_troubleshooting", "X4_reference"]
                    },

                    "host_sections": {
                        "required": {
                            "package": "Crate identity — MUST exist.",
                            "bin": "Binary target [[bin]] — executables need at least one binary target."
                        },
                        "defined": {
                            "dependencies": "Crate dependencies. Most binaries depend on libraries.",
                            "dev-dependencies": "Test/build dependencies.",
                            "lints": "Code quality rules.",
                            "features": "Feature flags."
                        },
                        "reserved": {
                            "workspace": "Workspace root [workspace] — reserved for workspace manifests."
                        }
                    },

                    "omni_metadata": {
                        "location": "package.metadata.omni",
                        "required": "Full I1-I4, C1-C7, _contract",
                        "note": "Same metadata requirements as library — executable Cargo.toml is also a full identity document."
                    },

                    "note": "Executable Cargo.toml requires [[bin]] (which library reserves) and puts [dependencies] as defined (still important, but not structurally required)."
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // SHARED TYPES — Reusable patterns
        // ═══════════════════════════════════════════════════════

        "living_version": {
            "type": "string",
            "pattern": "^[abc]-[0-9]{2}\\.[0-9]{2}$|^template$",
            "description": "Living version format: stage-phase.completion (a=alpha, b=beta, c=stable) or 'template' for seed files"
        },

        "iso_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "ISO 8601 date format: YYYY-MM-DD"
        },

        "bereshit_key": {
            "type": "string",
            "pattern": "^B-",
            "description": "Unique Bereshit identifier with B- prefix, derived from file path"
        },

        "content_type": {
            "type": "string",
            "enum": ["data", "code", "documentation"],
            "description": "Primary content classification"
        },

        "block_structure": {
            "type": "string",
            "enum": ["3-block", "4-block", "5-block"],
            "description": "Block pattern: 3-block (data), 4-block (code), 5-block (documentation)"
        },

        "architectural_role": {
            "type": "string",
            "enum": ["ladder", "rung", "rails", "seed", "scaffold"],
            "description": "Position in architecture: ladder=foundation, rung=builds-on, rails=infrastructure, seed=template, scaffold=temporary"
        },

        "lifecycle_status": {
            "type": "string",
            "enum": ["Draft", "Active", "Deprecated", "Archived"],
            "description": "Document lifecycle state"
        },

        // ═══════════════════════════════════════════════════════
        // METADATA — Unified I/C Structure
        // ═══════════════════════════════════════════════════════
        //
        // Metadata uses TWO namespaces in one block:
        //   I — Identity: What IS this file (I1-I4)
        //   C — Context:  What do I need to KNOW (C1-C7)
        //   _contract:    Structural self-description
        //
        // Classification:
        //   REQUIRED identity:  I1_core, I2_family, I3_instance
        //   EXTENSION identity: I4_architecture
        //   REQUIRED context:   C1_state, C2_attribution, C3_grounding, C4_dependencies
        //   EXTENSION context:  C5_intent, C6_roadmap, C7_classification, _contract
        //
        // Valid key pattern: I{N}_{name} | C{N}_{name} | _{name}
        // Regex: /^(?:I\d+_[a-z][a-z_]*|C\d+_[a-z][a-z_]*|_[a-z][a-z_]*)$/

        // ─── I — Identity sections ───

        "I1_core": {
            "type": "object",
            "description": "I.1 CORE — File identity: unique key, format declaration, template derivation, lifecycle position",
            "properties": {
                "key": { "$ref": "#/$defs/bereshit_key", "description": "Unique Bereshit key (B- prefix)" },
                "format": { "type": "string", "description": "OmniCode format declaration (@omni template --toml, @omni document --toml)" },
                "from": { "type": "string", "description": "Template derivation path or 'none' for roots" },
                "at": { "type": "string", "description": "Lifecycle position: 'template' for seeds, living version for instances" }
            },
            "required": ["key", "format", "from", "at"]
        },

        "I2_family": {
            "type": "object",
            "description": "I.2 FAMILY — Classification: content type, subtype, architectural role, block structure",
            "properties": {
                "type": { "$ref": "#/$defs/content_type" },
                "subtype": { "type": "string", "description": "Subtype (config, schema, types, constants, etc.)" },
                "role": { "type": "string", "description": "Architectural role (seed, scaffold, ladder, rung, rails)" },
                "structure": { "$ref": "#/$defs/block_structure" }
            },
            "required": ["type", "structure"]
        },

        "I3_instance": {
            "type": "object",
            "description": "I.3 INSTANCE — File details: filename, title, component description, path, capabilities",
            "properties": {
                "file": { "type": "string", "description": "Filename" },
                "title": { "type": "string", "description": "Human-readable title" },
                "component": { "type": "string", "description": "What this file IS in the system" },
                "path": { "type": "string", "description": "Relative path within project" },
                "provides": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Capabilities (UPPER_SNAKE constants)"
                },
                "brief": { "type": "string", "description": "One-line description" }
            },
            "required": ["file", "title"]
        },

        "I4_architecture": {
            "type": "object",
            "description": "I.4 ARCHITECTURE — Scaling context: layer mapping, anchor chain [EXTENSION]",
            "properties": {
                "layers": { "type": "string", "description": "Layer-to-language mapping (L0:C, L1:C, ...)" },
                "anchor": { "type": "string", "description": "Anchor chain (genesis_1_1 -> ...)" }
            }
        },

        // ─── C — Context sections ───

        "C1_state": {
            "type": "object",
            "description": "C.1 STATE — Version and lifecycle: living version, status, dates",
            "properties": {
                "version": { "$ref": "#/$defs/living_version" },
                "status": { "$ref": "#/$defs/lifecycle_status" },
                "created": { "$ref": "#/$defs/iso_date" },
                "updated": { "$ref": "#/$defs/iso_date" }
            },
            "required": ["version", "status"]
        },

        "C2_attribution": {
            "type": "object",
            "description": "C.2 ATTRIBUTION — Authorship: architect, implementation, organization, copyright",
            "properties": {
                "architect": { "type": "string" },
                "implementation": { "type": "string" },
                "organization": { "type": "string" },
                "copyright": { "type": "string" }
            },
            "required": ["organization"]
        },

        "C3_grounding": {
            "type": "object",
            "description": "C.3 GROUNDING — Biblical foundation: scripture reference, derived principle, anchor statement",
            "properties": {
                "scripture": { "type": "string", "description": "Scripture reference with text" },
                "principle": { "type": "string", "description": "Principle derived from scripture" },
                "anchor": { "type": "string", "description": "How this grounds the file's purpose" }
            },
            "required": ["scripture"]
        },

        "C4_dependencies": {
            "type": "object",
            "description": "C.4 DEPENDENCIES — Dependency graph: what this file needs, who consumes it, integration notes",
            "properties": {
                "requires": { "type": "string", "description": "What this file depends on" },
                "consumers": { "type": "string", "description": "What depends on this file" },
                "integration": { "type": "string", "description": "How to integrate" },
                "if_missing": { "type": "string", "description": "Behavior when not found" },
                "related": {
                    "type": "object",
                    "description": "Parent/children relationships",
                    "properties": {
                        "parent": { "type": "string" },
                        "children": { "type": "array", "items": { "type": "string" } }
                    }
                },
                "cross_format": {
                    "type": "object",
                    "description": "Cross-format relationships (TOML ↔ JSON, etc.)"
                }
            },
            "required": ["requires", "consumers"]
        },

        "C5_intent": {
            "type": "object",
            "description": "C.5 INTENT — Purpose, design philosophy, key features [EXTENSION]",
            "properties": {
                "purpose": { "type": "string" },
                "core_design": { "type": "string" },
                "philosophy": { "type": "string" },
                "key_features": { "type": "object" }
            }
        },

        "C6_roadmap": {
            "type": "object",
            "description": "C.6 ROADMAP — History, current state, planned work [EXTENSION]",
            "properties": {
                "history": { "type": "array", "items": { "type": "string" } },
                "current": { "type": "string" },
                "planned": { "type": "array", "items": { "type": "string" } }
            }
        },

        "C7_classification": {
            "type": "object",
            "description": "C.7 CLASSIFICATION — Tags and categorization [EXTENSION]",
            "properties": {
                "tags": { "type": "array", "items": { "type": "string" } }
            }
        },

        "_contract": {
            "type": "object",
            "description": "Structural self-description — declares which sections are required/extension/closing [EXTENSION]",
            "properties": {
                "required_identity": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Required I sections: [I1_core, I2_family, I3_instance]"
                },
                "required_context": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Required C sections: [C1_state, C2_attribution, C3_grounding, C4_dependencies]"
                },
                "extension_identity": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Extension I sections: [I4_architecture]"
                },
                "extension_context": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Extension C sections: [C5_intent, C6_roadmap, C7_classification]"
                },
                "required_closing": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Required X sections: [X1_policy, X5_note]"
                },
                "defined_closing": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Defined X sections: [X2_extension, X3_troubleshooting, X4_reference]"
                },
                "valid_patterns": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Valid naming patterns: [I{N}_{name}, C{N}_{name}, X{N}_{name}, _{name}]"
                },
                "rule": { "type": "string" }
            }
        },

        // ═══════════════════════════════════════════════════════
        // CONTENT — Cc (config) + Co (operations) + Cv (validation)
        // ═══════════════════════════════════════════════════════
        //
        // Content is WHERE the actual data lives.
        // Three zones, always in this order:
        //   Cc = Configurations (identity, settings, resources)
        //   Co = Operations (behavior, integrations, domain data)
        //   Cv = Validation (_validation — schema, health scoring, content rules)
        //
        // Content header declares: format, key_convention, constraint, Cc, Co, Cv

        "content_header": {
            "type": "object",
            "description": "Content block header — declares format conventions and Cc/Co/Cv zone labels",
            "properties": {
                "format": { "type": "string", "description": "Format declaration (e.g., TOML — UTF-8, LF line endings)" },
                "key_convention": { "type": "string" },
                "constraint": { "type": "string" },
                "Cc": { "type": "string", "description": "Label for Content Configurations zone" },
                "Co": { "type": "string", "description": "Label for Content Operations zone" },
                "Cv": { "type": "string", "description": "Label for Content Validation zone" }
            },
            "required": ["Cc", "Co", "Cv"]
        },

        "content_identity": {
            "type": "object",
            "description": "Cc.1 IDENTITY — What this config IS [REQUIRED in Cc zone]",
            "properties": {
                "name": { "type": "string", "description": "Config name" },
                "version": { "$ref": "#/$defs/living_version" },
                "description": { "type": "string" },
                "type": { "type": "string" }
            },
            "required": ["name", "version"]
        },

        "content_validation": {
            "type": "object",
            "description": "Cv.1 VALIDATION — Schema, health scoring, content rules [REQUIRED in Cv zone]",
            "properties": {
                "commands": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Validation commands to run"
                },
                "schema": {
                    "type": "object",
                    "description": "Self-describing schema contract",
                    "properties": {
                        "required": { "type": "array", "items": { "type": "string" }, "description": "Sections that MUST exist" },
                        "defined": { "type": "array", "items": { "type": "string" }, "description": "Sections expected to exist" },
                        "optional": { "type": "array", "items": { "type": "string" }, "description": "Sections that MAY exist" },
                        "fields": {
                            "type": "object",
                            "description": "Per-section field requirements",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "required": { "type": "array", "items": { "type": "string" } },
                                    "defined": { "type": "array", "items": { "type": "string" } }
                                }
                            }
                        }
                    }
                },
                "health_scoring": {
                    "type": "object",
                    "description": "Health scoring weights (sum to 100)",
                    "properties": {
                        "total": { "type": "integer", "const": 100 }
                    }
                },
                "content": {
                    "type": "object",
                    "description": "Content-specific validation rules (enums, ranges, etc.)"
                }
            },
            "required": ["commands"]
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING — X.1–X.5 (+ X.6 template-only)
        // ═══════════════════════════════════════════════════════
        //
        // Closing provides guidance for LIVING with this file.
        //
        // Classification:
        //   REQUIRED: X1_policy, X5_note — every file needs guardrails and an anchor
        //   DEFINED:  X2_extension, X3_troubleshooting, X4_reference — expected, info if missing
        //   TEMPLATE: X6_template — only in seed/template files, removed on instantiation
        //
        // Valid key pattern: X{N}_{name} | _{name}
        // Regex: /^(?:X\d+_[a-z][a-z_]*|_[a-z][a-z_]*)$/

        "X1_policy": {
            "type": "object",
            "description": "X.1 POLICY — Modification guidelines [REQUIRED]",
            "properties": {
                "scripture": { "type": "string" },
                "never": { "type": "array", "items": { "type": "string" }, "description": "Actions that must NEVER be taken" },
                "careful": { "type": "array", "items": { "type": "string" }, "description": "Actions requiring caution" },
                "safe": { "type": "array", "items": { "type": "string" }, "description": "Actions that are always safe" }
            },
            "required": ["never", "careful", "safe"]
        },

        "X2_extension": {
            "type": "object",
            "description": "X.2 EXTENSION — Future ideas and planned work [DEFINED]",
            "properties": {
                "planned": { "type": "array", "items": { "type": "string" } },
                "considered": { "type": "array", "items": { "type": "string" } }
            }
        },

        "X3_troubleshooting": {
            "type": "object",
            "description": "X.3 TROUBLESHOOTING — Common problems and solutions [DEFINED]",
            "properties": {
                "scripture": { "type": "string" }
            },
            "additionalProperties": { "type": "string" }
        },

        "X4_reference": {
            "type": "object",
            "description": "X.4 REFERENCE — Quick lookup [DEFINED]",
            "properties": {
                "related_files": { "type": "array", "items": { "type": "string" } },
                "required_sections": { "type": "array", "items": { "type": "string" } },
                "validate": { "type": "string" },
                "env_pattern": { "type": "string" }
            }
        },

        "X5_note": {
            "type": "object",
            "description": "X.5 NOTE — Final anchor [REQUIRED]",
            "properties": {
                "note": { "type": "string", "description": "Closing thought" },
                "scripture": { "type": "string", "description": "Scripture anchor" },
                "anchor": { "type": "string", "description": "How this grounds the file" }
            },
            "required": ["note", "scripture"]
        },

        "X6_template": {
            "type": "object",
            "description": "X.6 TEMPLATE — Instantiation guide [TEMPLATE-ONLY: remove when instantiating]",
            "properties": {
                "note": { "type": "string" },
                "usage": { "type": "string" },
                "update": { "type": "array", "items": { "type": "string" } }
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // This is the base schema — it defines $defs only.
    // Format-specific schemas compose these into properties/required.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "This schema provides $defs only. Validate format-specific schemas against their targets.",
    "_Cv_expected_state": "All $defs present with correct types, patterns, required fields, and field-level requirements.",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy [REQUIRED] → X.2 Extension [DEFINED] → X.3 Troubleshooting [DEFINED] → X.4 Reference [DEFINED] → X.5 Note [REQUIRED]",

    // X.1 POLICY [REQUIRED]
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X1_never": [
        "Remove a $def that format schemas reference",
        "Change required fields without updating all format schemas",
        "Remove the base contract (I1-I4, C1-C7, _contract, Cc/Co/Cv, X1-X5)"
    ],
    "_X1_careful": [
        "Adding new $defs (format schemas need to adopt them)",
        "Changing enum values (affects all formats)",
        "Modifying required arrays in $defs (cascades to all validated files)"
    ],
    "_X1_safe": [
        "Adding optional properties to existing $defs",
        "Adding description fields",
        "Adding new optional $defs that don't affect existing schemas"
    ],

    // X.2 EXTENSION [DEFINED]
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "5-block base schema (documentation: METADATA → HEADER → CONTEXT → CONTENT → FOOTER)",
        "JSON Schema $ref composition across format schemas",
        "Content-based health scoring — sections as containers with measured completeness"
    ],
    "_X2_delivered": [
        "4-block base schema → base-4block-schema.jsonc (2026-02-17)",
        "pragma_routing + format_registry + form_registry → 3-block base (2026-02-20)"
    ],

    // X.3 TROUBLESHOOTING [DEFINED]
    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "defs_not_found": "Format schemas reference $defs by path: #/$defs/I1_core. Verify the $def name matches.",
        "old_refs": "If you see P1_core, M1_identity, M5_dependencies — those are OLD names. Use I1_core, I3_instance, C4_dependencies.",
        "format_mismatch": "This is the BASE — it doesn't validate files directly. Use toml-3block-schema.jsonc or json-3block-schema.jsonc.",
        "which_schema": "JSON/JSONC files → json-3block-schema. TOML files → toml.ts handler. This file defines what both share."
    },

    // X.4 REFERENCE [DEFINED]
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/L1-omnicode/ladder/schemas/base-4block-schema.jsonc — 4-block base schema (sibling)",
        "b-word/L1-omnicode/ladder/schemas/json-3block-schema.jsonc — JSON format schema (child)",
        "b-word/L1-omnicode/ladder/schemas/toml-3block-schema.jsonc — TOML format schema (child)",
        "c-tov/cws-struct/lib/formats/json.ts — JSON runtime linter",
        "c-tov/cws-struct/lib/formats/toml.ts — TOML runtime linter (implements these rules)"
    ],

    // X.5 NOTE [REQUIRED]
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "Before format, before syntax, before representation — there is structure. This schema defines the structure that every format must express. Genesis 1 separated light from darkness before filling either. We separate structure from content before filling the formats.",
    "_X5_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X5_anchor": "The base of all bases. Every 3-block file traces back here. I/C metadata mirrors Genesis: Identity (what IS) and Context (what is KNOWN) — being precedes doing.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
