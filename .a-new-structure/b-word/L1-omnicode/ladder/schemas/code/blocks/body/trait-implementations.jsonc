    "_P5_title": "BODY Section 2: Trait Implementations — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Trait Implementations IS, not how it manifests in any language. See format/blocks/{lang}/body/trait-implementations.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "TraitImplementations",
        "position": 2,
        "label": "Trait Implementations",
        "block": "BODY",
        "overview_text": "Fulfilling contracts from SETUP",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "contract fulfillment",
                "description": "Making types honor the behavioral contracts defined in SETUP",
                "distinguisher": "SETUP said 'this behavior is possible.' This section delivers on that promise."
            },
            {
                "concept": "standard interface implementations",
                "description": "Display, Error, conversion, comparison — the common behavioral contracts",
                "distinguisher": "The language's standard contracts. Every type needs some."
            },
            {
                "concept": "custom trait implementations",
                "description": "Fulfilling project-specific behavioral contracts",
                "distinguisher": "Domain-specific promises kept. Not just standard — your own contracts too."
            }
        ],

        "cannot": [
            {
                "concept": "trait definitions",
                "reason": "Defining and fulfilling are separate. Define in SETUP, fulfill here.",
                "defer_to": "SETUP.TraitDefs"
            },
            {
                "concept": "constructors",
                "reason": "Creation is distinct from contract fulfillment",
                "defer_to": "BODY.Constructors"
            },
            {
                "concept": "core business logic",
                "reason": "Trait impls connect structure to behavior. Core logic IS the behavior.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "test-only implementations",
                "reason": "Mock implementations for testing belong with the tests",
                "defer_to": "CLOSING.Cv"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Trait Implementations",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton has no contracts to fulfill yet). REQUIRED in all declared forms."
