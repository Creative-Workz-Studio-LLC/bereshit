    "_P5_title": "BODY Section 1: Identity Access — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Identity Access IS, not how it manifests in any language. See format/blocks/{lang}/body/identity-access.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "IdentityAccess",
        "position": 1,
        "label": "Identity Access",
        "block": "BODY",
        "overview_text": "OmniCode static accessor functions",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "PRAGMA accessors",
                "description": "Functions that expose compile-time PRAGMA identity at runtime",
                "distinguisher": "The bridge between METADATA and BODY. Identity becomes queryable."
            },
            {
                "concept": "METADATA accessors",
                "description": "Functions that expose compile-time METADATA fields at runtime",
                "distinguisher": "Same bridge, different statics. PRAGMA is core identity; METADATA is context."
            },
            {
                "concept": "key lookup",
                "description": "Retrieve a specific field by name from identity statics",
                "distinguisher": "Point access. Ask for one thing, get one answer."
            }
        ],

        "cannot": [
            {
                "concept": "identity mutation",
                "reason": "Identity statics are immutable. You can read them, not change them.",
                "defer_to": "Never — identity is fixed"
            },
            {
                "concept": "derived computations",
                "reason": "Accessors are pure reads. Computing FROM identity is logic, not access.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "non-identity functions",
                "reason": "This section is exclusively for PRAGMA/METADATA access. Nothing else.",
                "defer_to": "BODY.FreeFunctions or BODY.CoreLogic"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Identity Access",
            "reserved_reason": null,
            "note": "Identity Access is REQUIRED in all forms. Every OmniCode file exposes its identity at runtime."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Identity Access bridges compile-time identity into runtime. METADATA says who you are; these functions let the running code know.",
    "_X5_scripture": "Exodus 3:14 — And God said unto Moses, I AM THAT I AM."
