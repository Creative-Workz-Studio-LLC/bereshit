{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-body-core-logic",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "BODY Section 4: Core Logic — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Core Logic IS, not how it manifests in any language. See format/blocks/{lang}/body/core-logic.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "CoreLogic",
        "position": 4,
        "label": "Core Logic",
        "block": "BODY",
        "overview_text": "Primary operations, state transforms",

        // ─────────────────────────────────────
        // Header Generation
        // ─────────────────────────────────────

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        // ─────────────────────────────────────
        // Abstract Contract (language-agnostic)
        // ─────────────────────────────────────
        //
        // These define WHAT belongs here conceptually.
        // Language-specific HOW lives in format/blocks/.

        "can": [
            {
                "concept": "primary operations",
                "description": "Methods/functions that perform the module's core work",
                "distinguisher": "The verb, not the noun. Does things, not defines things."
            },
            {
                "concept": "state transforms",
                "description": "Operations that change internal state",
                "distinguisher": "Mutation with purpose. Side effects that ARE the point."
            },
            {
                "concept": "private helpers (scoped)",
                "description": "Small helpers that serve a single core operation",
                "distinguisher": "If it serves ONE operation and is small, it stays here. If it serves MANY or is large, defer."
            }
        ],

        "cannot": [
            {
                "concept": "type definitions",
                "reason": "Existence belongs in SETUP — SETUP makes things EXIST, BODY makes things HAPPEN",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "behavioral contracts",
                "reason": "Shape belongs in SETUP — contracts define what CAN be done, not what IS done",
                "defer_to": "SETUP.TraitDefs"
            },
            {
                "concept": "constructors",
                "reason": "Creation is distinct from operation — new() creates, core logic transforms",
                "defer_to": "BODY.Constructors"
            },
            {
                "concept": "read-only accessors",
                "reason": "Observation is distinct from mutation — get() reads, core logic writes",
                "defer_to": "BODY.Queries"
            },
            {
                "concept": "contract fulfillment",
                "reason": "Implementing contracts is fulfilling shape, not operating",
                "defer_to": "BODY.TraitImplementations"
            },
            {
                "concept": "tests",
                "reason": "Tests validate; they don't operate. CLOSING ensures correctness.",
                "defer_to": "CLOSING.Cv"
            },
            {
                "concept": "imports / dependencies",
                "reason": "Dependencies are existence, not operation",
                "defer_to": "SETUP.Imports"
            },
            {
                "concept": "constants / fixed values",
                "reason": "Fixed values are existence, not operation",
                "defer_to": "SETUP.Constants"
            }
        ],

        "defer": [
            {
                "signal": "pure read with no side effects",
                "to": "BODY.Queries",
                "why": "Observation, not mutation"
            },
            {
                "signal": "creates and returns a new instance",
                "to": "BODY.Constructors",
                "why": "Creation, not operation"
            },
            {
                "signal": "standalone utility not tied to a type",
                "to": "BODY.FreeFunctions",
                "why": "Module-level, not type-level"
            },
            {
                "signal": "large helper serving multiple operations",
                "to": "BODY.Helpers or extract to module",
                "why": "Shared utility, not single-operation support"
            }
        ],

        // ─────────────────────────────────────
        // Form Availability
        // ─────────────────────────────────────

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        // ─────────────────────────────────────
        // Reserved Omission
        // ─────────────────────────────────────

        "ro": {
            "available_label": "Core Logic",
            "reserved_reason": null,
            "note": "Core Logic is REQUIRED in all declared forms. If empty, question the file's purpose."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Core Logic is the engine room. SETUP declares, Constructors create, Core Logic transforms, Queries observe.",
    "_X5_scripture": "Ecclesiastes 9:10 — Whatsoever thy hand findeth to do, do it with thy might."
}
