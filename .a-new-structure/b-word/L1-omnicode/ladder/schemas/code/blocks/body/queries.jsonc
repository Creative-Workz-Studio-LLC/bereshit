{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-body-queries",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "BODY Section 5: Queries — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Queries IS, not how it manifests in any language. See format/blocks/{lang}/body/queries.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Queries",
        "position": 5,
        "label": "Queries",
        "block": "BODY",
        "overview_text": "Read-only observation methods",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "state observation",
                "description": "Methods that read internal state without changing it",
                "distinguisher": "The adjective. Describes what IS, never changes what IS."
            },
            {
                "concept": "computed properties",
                "description": "Values derived from internal state but not stored",
                "distinguisher": "Calculated on demand. The truth exists in the fields; this presents it."
            },
            {
                "concept": "boolean checks",
                "description": "is_valid(), has_items(), is_empty() — state as yes/no question",
                "distinguisher": "The simplest observation. One bit of truth."
            }
        ],

        "cannot": [
            {
                "concept": "state mutation",
                "reason": "Queries observe. They never change what they observe.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "side effects",
                "reason": "Logging, IO, network calls — these change the world. Queries only look.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "constructors",
                "reason": "Creating new instances is birth, not observation",
                "defer_to": "BODY.Constructors"
            },
            {
                "concept": "display formatting",
                "reason": "How something looks is output. How something IS is a query.",
                "defer_to": "BODY.OutputDisplay"
            }
        ],

        "defer": [
            {
                "signal": "method changes internal state as side effect",
                "to": "BODY.CoreLogic",
                "why": "If it mutates, it's an operation, not a query"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Queries",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton has no state to observe yet). REQUIRED in all declared forms."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Queries are pure observation. Command-Query Separation at the section level — what changes state and what reads state never mix.",
    "_X5_scripture": "Psalm 139:1 — O LORD, thou hast searched me, and known me."
}
