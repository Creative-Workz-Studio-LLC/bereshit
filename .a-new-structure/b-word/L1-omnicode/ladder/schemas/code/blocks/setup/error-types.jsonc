    "_P2_role": "container-structure",
    "_P5_title": "SETUP Section 6: Error Types — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Error Types IS, not how it manifests in any language. See format/blocks/{lang}/setup/error-types.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "ErrorTypes",
        "position": 6,
        "label": "Error Types",
        "block": "SETUP",
        "overview_text": "Error definitions with display and conversion",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "error enumeration",
                "description": "Named variants covering all failure modes of this file",
                "distinguisher": "Every way this code can fail has a name. No anonymous errors."
            },
            {
                "concept": "display formatting",
                "description": "Human-readable error messages for each variant",
                "distinguisher": "Errors speak to humans, not just compilers."
            },
            {
                "concept": "conversion from upstream",
                "description": "Transforming errors from dependencies into this file's error type",
                "distinguisher": "Errors flow inward. External errors become local errors."
            }
        ],

        "cannot": [
            {
                "concept": "error handling logic",
                "reason": "SETUP defines errors; BODY handles them. Existence before operation.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "non-error types",
                "reason": "Core types have their own section. Errors are special — they need Display and conversion.",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "string-typed error fields",
                "reason": "Use enums for error variants. Strings are unstructured — enums are matchable.",
                "defer_to": "Define an enum variant instead"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Error Types",
            "reserved_reason": null,
            "note": "Error Types is REQUIRED in all forms. Every file that can fail must name its failures."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Error types name failure. A named error is a diagnosed error. Unnamed errors are just panics in disguise.",
    "_X5_scripture": "Proverbs 27:12 — A prudent man foreseeth the evil, and hideth himself; but the simple pass on, and are punished."
