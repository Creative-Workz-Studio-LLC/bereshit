{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-setup-feature-gates",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "SETUP Section 10: Feature Gates — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Feature Gates IS, not how it manifests in any language. See format/blocks/{lang}/setup/feature-gates.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "FeatureGates",
        "position": 10,
        "label": "Feature Gates",
        "block": "SETUP",
        "overview_text": "Feature gate configuration",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "conditional compilation",
                "description": "Sections of code included or excluded based on build features",
                "distinguisher": "The door that opens or closes at compile time. Feature on = code included."
            },
            {
                "concept": "platform-specific paths",
                "description": "Alternative implementations for different targets",
                "distinguisher": "Same interface, different implementation per platform."
            }
        ],

        "cannot": [
            {
                "concept": "runtime feature toggling",
                "reason": "Feature gates are compile-time. Runtime toggles are BODY logic.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "configuration loading",
                "reason": "Reading config at runtime is not feature gating",
                "defer_to": "BODY.CoreLogic"
            }
        ],

        "defer": [
            {
                "signal": "file is not a crate root or platform module",
                "to": "RESERVED — feature gates belong at crate level",
                "why": "Feature configuration is crate-level. Individual modules may be GATED, but don't ORGANIZE gates."
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "RESERVED",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "RESERVED"
        },

        "ro": {
            "available_label": "Feature Gates",
            "reserved_reason": "Feature flags are crate-level config, not leaf module concerns",
            "reserved_explanation": "Feature gates are defined in Cargo.toml and organized in lib.rs. Modules may be gated but don't organize gates."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Feature gates are compile-time doors. They decide what code exists in the binary before it runs.",
    "_X5_scripture": "Revelation 3:8 — Behold, I have set before thee an open door, and no man can shut it."
}
