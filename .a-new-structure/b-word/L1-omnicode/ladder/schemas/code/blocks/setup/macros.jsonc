{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-setup-macros",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "SETUP Section 9: Macros — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Macros IS, not how it manifests in any language. See format/blocks/{lang}/setup/macros.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Macros",
        "position": 9,
        "label": "Macros",
        "block": "SETUP",
        "overview_text": "Macro definitions",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "code generation patterns",
                "description": "Reusable patterns that generate code at compile time",
                "distinguisher": "Code that writes code. Patterns reused enough to justify abstraction."
            },
            {
                "concept": "DSL fragments",
                "description": "Domain-specific syntax extensions for the module's concern",
                "distinguisher": "Making the language speak the domain's vocabulary."
            }
        ],

        "cannot": [
            {
                "concept": "runtime logic",
                "reason": "Macros generate code at compile time; they don't execute at runtime",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "type definitions via macro",
                "reason": "If the type is simple enough to define directly, don't macro it",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "single-use macros",
                "reason": "A macro used once is just obfuscation. Inline the code.",
                "defer_to": "Inline the code at point of use"
            }
        ],

        "defer": [
            {
                "signal": "macro is used across multiple crates",
                "to": "Dedicated macro crate or module",
                "why": "Cross-crate macros need specific export handling"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "RESERVED",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "RESERVED"
        },

        "ro": {
            "available_label": "Macros",
            "reserved_reason": "Macros belong in dedicated macro modules or crate root, not leaf modules",
            "reserved_explanation": "Individual modules should USE macros, not DEFINE them. A module defining macros signals it should be a separate concern."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Macros are patterns made reusable. Code that writes code — powerful, but only when the pattern truly repeats.",
    "_X5_scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
}
