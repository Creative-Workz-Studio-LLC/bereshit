{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-closing-closing-note",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Closing Note (X5) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Closing Note IS, not how it manifests in any language. See format/blocks/{lang}/closing/closing-note.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "X5",
        "position": "X5",
        "label": "Closing Note",
        "block": "CLOSING",
        "zone": "documentation",
        "overview_text": "Anchoring scripture and summary",

        "header": {
            "section_comment": "// X5 — Closing Note",
            "bracket_format": "[X5]  Closing Note{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "anchoring scripture",
                "description": "A verse that grounds this file's purpose in eternal truth",
                "distinguisher": "The last word is God's word. The file's purpose connected to eternal purpose."
            },
            {
                "concept": "purpose reflection",
                "description": "2-4 sentences connecting the scripture to this file's specific domain",
                "distinguisher": "Not generic. The reflection is ABOUT this file's work."
            },
            {
                "concept": "bookend with METADATA",
                "description": "X5's grounding mirrors the METADATA scripture — opening and closing anchor",
                "distinguisher": "The file begins grounded and ends grounded. Everything between is anchored."
            }
        ],

        "cannot": [
            {
                "concept": "executable code",
                "reason": "X5 is the final anchor. Comments only.",
                "defer_to": "CLOSING.Cv or BODY.*"
            },
            {
                "concept": "placeholder scripture",
                "reason": "Generic verses disconnected from the domain are decoration, not grounding",
                "defer_to": "Choose a verse that illuminates THIS file's purpose"
            },
            {
                "concept": "lengthy prose",
                "reason": "X5 is a note, not an essay. 2-4 sentences max.",
                "defer_to": "Keep it brief and pointed"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Closing Note",
            "reserved_reason": null,
            "note": "X5 is REQUIRED in all forms. Every file ends anchored in eternal truth."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "X5 is the anchor at the end. The file's last word is grounded truth — not code, not comments, but purpose.",
    "_X5_scripture": "Revelation 22:13 — I am Alpha and Omega, the beginning and the end, the first and the last."
}
