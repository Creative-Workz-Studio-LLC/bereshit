    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-closing-reference",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Reference (X4) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Reference IS, not how it manifests in any language. See format/blocks/{lang}/closing/reference.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "X4",
        "position": "X4",
        "label": "Reference",
        "block": "CLOSING",
        "zone": "documentation",
        "overview_text": "Related files and validation commands",

        "header": {
            "section_comment": "// X4 — Reference",
            "bracket_format": "[X4]  Reference{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "dependency listing",
                "description": "What this file depends on and what depends on this file",
                "distinguisher": "The navigation map. Where am I in the system? What connects to me?"
            },
            {
                "concept": "template provenance",
                "description": "Which template this file was created from",
                "distinguisher": "Traceability. Every file knows its origin."
            },
            {
                "concept": "validation commands",
                "description": "How to verify this file is correct — build, test, lint commands",
                "distinguisher": "The proof commands. Run these to know the file is sound."
            }
        ],

        "cannot": [
            {
                "concept": "executable code",
                "reason": "X4 is documentation. Comments only.",
                "defer_to": "CLOSING.Cv or BODY.*"
            },
            {
                "concept": "placeholder values",
                "reason": "References must be real. Fake paths are worse than no paths.",
                "defer_to": "Fill with real references"
            },
            {
                "concept": "outdated information",
                "reason": "Wrong references are worse than no references. Keep X4 current.",
                "defer_to": "Update when dependencies change"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Reference",
            "reserved_reason": null,
            "note": "X4 is REQUIRED in all forms. Every file exists in relationship to other files."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "X4 is the navigation map. Every file knows where it came from, what it depends on, and how to verify itself.",
    "_X5_scripture": "Proverbs 4:26 — Ponder the path of thy feet, and let all thy ways be established."
}
