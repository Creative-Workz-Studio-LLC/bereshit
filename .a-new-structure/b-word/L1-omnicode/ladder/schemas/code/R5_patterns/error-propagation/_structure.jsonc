    "_P2_role": "schema",
    "_P5_title": "Concept — Error Propagation",
    "_P5_brief": "Universal concept: passing an error from a callee to the caller without handling it locally. Rust ?, Go if err != nil, C return code checks.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "error_propagation",
    "description": "Propagate an error from a called function to the current function's caller",

    "universal_shape": {
        "expr": "the fallible expression that may produce an error",
        "ok_binding": "variable receiving the success value",
        "error_action": "what happens with the error (return it, wrap it, log it)"
    },

    "semantic_notes": [
        "Rust: expr? — unwraps Ok or early-returns Err. Single character, huge semantic weight.",
        "Go: val, err := expr; if err != nil { return zeroVal, err } — explicit, verbose, clear.",
        "C: ret = func(); if (ret < 0) { return ret; } — return code convention.",
        "The Rust ? is syntactic sugar for a match + early return.",
        "Go has no sugar — the pattern is always explicit."
    ],

    "container_map": {
        "_note": "granted (+1) = belongs here. denied (-1) = does not belong. defer (0) = context-dependent.",

