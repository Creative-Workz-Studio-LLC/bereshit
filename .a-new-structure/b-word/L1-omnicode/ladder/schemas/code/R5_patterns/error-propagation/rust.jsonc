{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-rust-error-propagation",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Rust — Error Propagation",

    "concept": "error_propagation",
    "language": "rust",

    "patterns": [
        {
            "id": "question_mark_binding",
            "syntax": "let {name} = {expr}?;",
            "detect": "^\\s*let\\s+(\\w+)\\s*=\\s*(.+)\\?;",
            "emit": "let {name} = {expr}?;",
            "captures": { "name": 1, "expr": 2 },
            "notes": "Bind the Ok value, early-return on Err.",
            "priority": 1
        },
        {
            "id": "question_mark_chain",
            "syntax": "{expr}?",
            "detect": "(.+)\\?",
            "emit": "{expr}?",
            "captures": { "expr": 1 },
            "notes": "Inline ? — unwrap or propagate. May appear mid-expression.",
            "priority": 2
        }
    ],

    "go_to_rust_mapping": {
        "val, err := expr; if err != nil { return err }": "let val = expr?; — full if-err block → single ?",
        "if err := expr; err != nil { return err }": "expr?; — inline init form → ? operator"
    },

    "_X5_note": "Rust ? operator — the most concise error propagation in any systems language."
}
