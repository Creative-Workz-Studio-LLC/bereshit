{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-return-value",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Return Value",

    "concept": "return_value",
    "language": "go",

    "patterns": [
        {
            "id": "return_value",
            "syntax": "return {expr}",
            "detect": "^\\s*return\\s+([^,]+)\\s*$",
            "emit": "return {expr}",
            "captures": { "expr": 1 },
            "notes": "Single value return — always explicit return keyword in Go.",
            "priority": 1
        },
        {
            "id": "return_void",
            "syntax": "return",
            "detect": "^\\s*return\\s*$",
            "emit": "return",
            "captures": {},
            "notes": "Bare return for void functions.",
            "priority": 2
        },
        {
            "id": "return_error_tuple",
            "syntax": "return {value}, nil",
            "detect": "^\\s*return\\s+(.+),\\s*nil\\s*$",
            "emit": "return {value}, nil",
            "captures": { "value": 1 },
            "notes": "Success tuple — value with nil error. Maps to Rust Ok(val).",
            "priority": 3
        },
        {
            "id": "return_nil_only",
            "syntax": "return nil",
            "detect": "^\\s*return\\s+nil\\s*$",
            "emit": "return nil",
            "captures": {},
            "notes": "Void success — only the error return, and it's nil. Maps to Rust Ok(()).",
            "priority": 4
        }
    ],

    "rust_to_go_mapping": {
        "return expr;": "return expr — explicit return translates directly",
        "expr (implicit)": "return expr — Go always needs explicit return keyword",
        "Ok(val)": "return val, nil — Result::Ok → value + nil error",
        "Ok(())": "return nil — void Ok → nil error only"
    },

    "_X5_note": "Go returns — always explicit keyword. No implicit last-expression returns."
}
