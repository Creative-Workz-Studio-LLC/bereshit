    // ===================================================================

    "concept": "return_value",
    "description": "Return a value from a function, method, or block",

    "universal_shape": {
        "expr": "the expression being returned",
        "explicit": "whether the return keyword is used",
        "void": "whether this is a void/unit return (no value)"
    },

    "semantic_notes": [
        "Rust has implicit returns (last expression without semicolon).",
        "Go always requires explicit 'return' keyword.",
        "C always requires explicit 'return' keyword.",
        "Some returns are references (&PRAGMA), some are values.",
        "Void returns: Rust () maps to Go (nothing), C void."
    ],

