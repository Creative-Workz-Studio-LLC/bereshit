    "concept": "err_wrap",
    "description": "Create and return an error value",

    "universal_shape": {
        "error_type": "the type/kind of error being created",
        "message": "human-readable error description",
        "cause": "optional underlying error being wrapped",
        "args": "format arguments for the error message"
    },

    "semantic_notes": [
        "Rust: Err(io::Error::new(kind, msg)) — typed error with kind enum and message.",
        "Go: fmt.Errorf('msg: %w', err) — formatted error with optional wrapping.",
        "Go: errors.New('msg') — simple error without wrapping.",
        "C: errno = ENOENT; return -1 — global errno + return code convention.",
        "Error wrapping preserves the causal chain for debugging."
    ],

