{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-err-wrap",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Err Wrap (Error Return)",

    "concept": "err_wrap",
    "language": "go",

    "patterns": [
        {
            "id": "fmt_errorf",
            "syntax": "fmt.Errorf(\"{message}\", {args})",
            "detect": "fmt\\.Errorf\\(\"([^\"]+)\"(?:,\\s*(.+))?\\)",
            "emit": "fmt.Errorf(\"{message}\", {args})",
            "captures": { "message": 1, "args": 2 },
            "notes": "Formatted error — use %w to wrap inner errors. Maps to Rust Err(io::Error::new(kind, format!(...))).",
            "priority": 1
        },
        {
            "id": "errors_new",
            "syntax": "errors.New(\"{message}\")",
            "detect": "errors\\.New\\(\"([^\"]+)\"\\)",
            "emit": "errors.New(\"{message}\")",
            "captures": { "message": 1 },
            "notes": "Simple static error string. Maps to Rust Err(io::Error::new(kind, msg)).",
            "priority": 2
        },
        {
            "id": "return_err",
            "syntax": "return err",
            "detect": "return\\s+(\\w+)\\s*$",
            "emit": "return err",
            "captures": { "err": 1 },
            "notes": "Direct error propagation — return the error as-is. Maps to Rust Err(e).",
            "priority": 3
        },
        {
            "id": "return_zero_err",
            "syntax": "return {zero_value}, err",
            "detect": "return\\s+(.+),\\s*(\\w+)\\s*$",
            "emit": "return {zero_value}, err",
            "captures": { "zero_value": 1, "err": 2 },
            "notes": "Error from function with value+error return — must include zero value.",
            "priority": 4
        }
    ],

    "rust_to_go_mapping": {
        "Err(io::Error::new(kind, format!(msg, args)))": "fmt.Errorf(msg, args) — constructed Err → Errorf",
        "Err(io::Error::new(kind, msg))": "errors.New(msg) — simple Err → errors.New",
        "Err(e)": "return err — re-wrap → direct propagation"
    },

    "rust_error_kind_mapping": {
        "io::ErrorKind::AlreadyExists": "os.ErrExist",
        "io::ErrorKind::NotFound": "os.ErrNotExist",
        "io::ErrorKind::PermissionDenied": "os.ErrPermission"
    },

    "_X5_note": "Go errors — fmt.Errorf, errors.New, or direct propagation. No Err() wrapper."
}
