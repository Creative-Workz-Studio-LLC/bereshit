    "_P5_title": "Concept — Self Access (Receiver Field Access)",
    "_P5_brief": "Universal concept: accessing a field or property through the receiver (self/this). Rust self.field, Go r.Field, C self->field.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "self_access",
    "description": "Access a field or property on the current receiver (self/this)",

    "universal_shape": {
        "receiver": "the self/this/receiver reference",
        "field": "the field name being accessed",
        "mutable": "whether this is a mutable access (write vs read)"
    },

    "semantic_notes": [
        "Rust: self.field — always explicit self keyword.",
        "Go: r.Field — short receiver name (convention: first letter of type, lowercase).",
        "C: self->field (pointer) or self.field (value) — explicit struct variable.",
        "Python: self.field — always explicit self parameter.",
        "Some languages make the receiver implicit (Java, C++ 'this')."
    ],

