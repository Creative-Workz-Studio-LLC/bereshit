{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-self-access",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Self Access (Receiver Field/Method)",

    "concept": "self_access",
    "language": "go",

    "patterns": [
        {
            "id": "receiver_method",
            "emit": "{short}.{Method}({args})",
            "when": "calling a method through the receiver — Rust self.method(args)",
            "notes": "Go receiver is short name (first letter of type, lowercase): e.g., 'e' for Exists.",
            "priority": 1
        },
        {
            "id": "receiver_field",
            "emit": "{short}.{Field}",
            "when": "accessing a field through the receiver — Rust self.field",
            "notes": "Exported fields PascalCase, unexported camelCase.",
            "priority": 2
        }
    ],

    "_X5_note": "Go receiver access — short name convention, not 'self' or 'this'."
}
