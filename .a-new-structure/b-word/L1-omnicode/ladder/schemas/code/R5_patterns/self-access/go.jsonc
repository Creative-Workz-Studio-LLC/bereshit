{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-self-access",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Self Access (Receiver Field/Method)",

    "concept": "self_access",
    "language": "go",

    "patterns": [
        {
            "id": "receiver_method",
            "syntax": "{short}.{Method}({args})",
            "emit": "{short}.{Method}({args})",
            "notes": "Method through receiver — Go receiver names are short (1-3 chars, lowercase). e.g., e.Exists(). No detect: syntactically identical to any variable.Method() — requires function signature analysis.",
            "priority": 1
        },
        {
            "id": "receiver_field",
            "syntax": "{short}.{Field}",
            "emit": "{short}.{Field}",
            "notes": "Field through receiver — PascalCase exported, camelCase unexported. No detect: same reason.",
            "priority": 2
        }
    ],

    "rust_to_go_mapping": {
        "self.method(args)": "r.Method(args) — self → short receiver name, snake_case → PascalCase",
        "self.field": "r.Field — self → short receiver name, lowercase → PascalCase if exported"
    },

    "_X5_note": "Go receiver access — short name convention, not 'self' or 'this'. No detect: receiver vs local variable is semantic, not syntactic."
}
