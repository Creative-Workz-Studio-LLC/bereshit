    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-concepts-method-call",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "concept-definition",
    "_P2_role": "schema",
    "_P5_title": "Concept — Method Call",
    "_P5_brief": "Universal concept: invoking a method on a receiver (object/value). Distinguished from function calls by having a receiver.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "method_call",
    "description": "Invoke a method on a receiver value or reference",

    "universal_shape": {
        "receiver": "the value or reference the method is called on",
        "method": "the method name",
        "args": "argument expressions (excluding the receiver)",
        "result": "optional variable receiving the return value",
        "chain": "whether this is part of a method chain"
    },

    "semantic_notes": [
        "Rust: receiver.method(args) — &self is implicit in the call.",
        "Go: receiver.Method(args) — explicit receiver in definition, implicit in call.",
        "C: no methods — functions take explicit first argument (struct pointer).",
        "Method chains: a.b().c().d() — each call returns a value the next operates on.",
        "Rust path.exists() and Go path.Exists() are the same concept, different naming."
    ],

    "container_map": {
        "_note": "granted (+1) = belongs here. denied (-1) = does not belong. defer (0) = context-dependent.",

