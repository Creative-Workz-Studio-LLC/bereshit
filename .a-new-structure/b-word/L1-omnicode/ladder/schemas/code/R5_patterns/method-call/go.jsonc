{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-method-call",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Method Call",

    "concept": "method_call",
    "language": "go",

    "patterns": [
        {
            "id": "method_call",
            "syntax": "{receiver}.{Method}({args})",
            "detect": "([a-zA-Z_]\\w*)\\.([a-zA-Z_]\\w*)\\(([^)]*)\\)",
            "emit": "{receiver}.{Method}({args})",
            "captures": { "receiver": 1, "method": 2, "args": 3 },
            "notes": "Method call on value or pointer. Exported methods PascalCase.",
            "priority": 1
        },
        {
            "id": "method_chain",
            "syntax": "{receiver}.{Method1}({args1}).{Method2}({args2})",
            "detect": "([a-zA-Z_]\\w*)\\.([a-zA-Z_]\\w*)\\(([^)]*)\\)\\.([a-zA-Z_]\\w*)",
            "emit": "{receiver}.{Method1}({args1}).{Method2}({args2})",
            "captures": { "receiver": 1, "method1": 2, "args1": 3, "method2": 4 },
            "notes": "Chained method calls — less common in Go than Rust's builder pattern.",
            "priority": 2
        },
        {
            "id": "field_access",
            "syntax": "{receiver}.{Field}",
            "detect": "([a-zA-Z_]\\w*)\\.(\\w+)(?!\\s*\\()",
            "emit": "{receiver}.{Field}",
            "captures": { "receiver": 1, "field": 2 },
            "notes": "Struct field access — PascalCase exported, camelCase unexported.",
            "priority": 3
        }
    ],

    "rust_to_go_mapping": {
        "receiver.method(args)": "receiver.Method(args) — snake_case → PascalCase if exported",
        "receiver.method1().method2()": "receiver.Method1().Method2() — chaining translates directly",
        "receiver.field": "receiver.Field — lowercase → PascalCase if exported",
        "path.exists()": "exists(path) — Go has no Path.Exists(); use os.Stat helper",
        "path.is_dir()": "info.IsDir() — after os.Stat, check FileInfo",
        "e.kind()": "errors.Is(err, target) — Rust ErrorKind → Go sentinel errors"
    },

    "_X5_note": "Go methods — PascalCase for exported, receiver is explicit in definition but implicit in call."
}
