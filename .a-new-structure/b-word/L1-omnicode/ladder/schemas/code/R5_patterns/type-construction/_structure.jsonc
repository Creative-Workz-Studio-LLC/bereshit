    "semantic_notes": [
        "Rust: TypeName { field: value, .. } — struct literal syntax.",
        "Go: TypeName{Field: value} — composite literal syntax.",
        "C: (struct TypeName){ .field = value } — designated initializer.",
        "Not function_call — no function invoked, literal syntax only.",
        "Not variable_binding — naming vs value-building. type_construction is the 'create' atom.",
        "Read counterpart is field_access. Write is type_construction."
    ],

