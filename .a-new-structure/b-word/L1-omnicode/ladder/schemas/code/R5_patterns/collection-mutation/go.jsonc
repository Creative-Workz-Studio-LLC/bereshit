{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-collection-mutation",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Collection Mutation",

    "concept": "collection_mutation",
    "language": "go",

    "patterns": [
        {
            "id": "map_assign",
            "syntax": "{map}[{key}] = {value}",
            "detect": "(\\w+)\\[(.+?)\\]\\s*=\\s*(.+)",
            "emit": "{map}[{key}] = {value}",
            "captures": { "map": 1, "key": 2, "value": 3 },
            "notes": "Map assignment — insert or update. Go's equivalent of .insert().",
            "priority": 1
        },
        {
            "id": "append",
            "syntax": "{slice} = append({slice}, {values}...)",
            "detect": "(\\w+)\\s*=\\s*append\\(\\1,\\s*(.+?)\\)",
            "emit": "{slice} = append({slice}, {values}...)",
            "captures": { "slice": 1, "values": 2 },
            "notes": "Slice append — grows the slice. Must reassign (append may reallocate).",
            "priority": 2
        },
        {
            "id": "delete",
            "syntax": "delete({map}, {key})",
            "detect": "delete\\((\\w+),\\s*(.+?)\\)",
            "emit": "delete({map}, {key})",
            "captures": { "map": 1, "key": 2 },
            "notes": "Map delete — removes a key. No-op if key doesn't exist.",
            "priority": 3
        }
    ],

    "rust_to_go_mapping": {
        "map.insert(key, value)": "m[key] = value",
        "vec.push(value)": "slice = append(slice, value)",
        "map.remove(&key)": "delete(m, key)",
        "vec.pop()": "slice = slice[:len(slice)-1]"
    },

    "_X5_note": "Go collection mutation — map assignment, append, delete. No method syntax."
}
