    "concept": "loop_iteration",
    "description": "Bounded repetition over collections or conditions — for, while, loop constructs",

    "universal_shape": {
        "iterator": "the collection or range being iterated",
        "binding": "variable(s) bound per iteration",
        "body": "statements executed per iteration",
        "condition": "optional termination condition (while loops)"
    },

    "semantic_notes": [
        "Rust: for item in collection, while condition, loop (infinite).",
        "Go: for _, item := range collection, for i := 0; i < n; i++, for condition.",
        "C: for (init; cond; incr), while (cond), do-while.",
        "Distinct from conditional_if: repetition vs branching. Only pattern producing bounded repetition.",
        "Iterator chains (.iter().map()) are composite: method_call + loop_iteration."
    ],

