{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-conditional-match",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Conditional Match (Switch)",

    "concept": "conditional_match",
    "language": "go",

    "patterns": [
        {
            "id": "switch_value",
            "syntax": "switch {scrutinee} {\n{cases}\n}",
            "detect": "^\\s*switch\\s+(.+)\\s*\\{",
            "emit": "switch {scrutinee} {\n{cases}\n}",
            "captures": { "scrutinee": 1 },
            "notes": "Value switch — no fallthrough by default (opposite of C).",
            "priority": 1
        },
        {
            "id": "switch_type",
            "syntax": "switch {scrutinee}.(type) {\n{cases}\n}",
            "detect": "^\\s*switch\\s+(.+)\\.\\(type\\)\\s*\\{",
            "emit": "switch {scrutinee}.(type) {\n{cases}\n}",
            "captures": { "scrutinee": 1 },
            "notes": "Type switch — interface type assertion. Maps to Rust match on enum variant.",
            "priority": 2
        },
        {
            "id": "case_with_guard",
            "syntax": "case {pattern}:\n\tif {guard} {\n\t\t{body}\n\t}",
            "detect": "^\\s*case\\s+(.+):",
            "emit": "case {pattern}:\n\tif {guard} {\n\t\t{body}\n\t}",
            "captures": { "pattern": 1 },
            "notes": "Go has no case guards — Rust arm guards become nested if inside case body.",
            "priority": 3
        },
        {
            "id": "case_simple",
            "syntax": "case {pattern}:\n\t{body}",
            "detect": "^\\s*case\\s+(.+):",
            "emit": "case {pattern}:\n\t{body}",
            "captures": { "pattern": 1 },
            "notes": "Simple case without guard.",
            "priority": 4
        },
        {
            "id": "case_default",
            "syntax": "default:\n\t{body}",
            "detect": "^\\s*default:",
            "emit": "default:\n\t{body}",
            "captures": {},
            "notes": "Default case — maps to Rust wildcard _ => arm.",
            "priority": 5
        }
    ],

    "rust_to_go_mapping": {
        "match scrutinee {": "switch scrutinee { — match → switch",
        "pattern => body": "case pattern: body — arm → case",
        "_ => body": "default: body — wildcard → default",
        "Ok(val) if guard =>": "case with nested if — Go has no case guards",
        "match on Result": "if err != nil pattern or switch on error — Go has no Result type"
    },

    "_X5_note": "Go switch: no fallthrough by default, no parens needed, no break needed."
}
