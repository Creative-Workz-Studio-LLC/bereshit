{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-rust-conditional-match",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Rust — Conditional Match (Pattern Matching)",

    "concept": "conditional_match",
    "language": "rust",

    "patterns": [
        {
            "id": "match_expr",
            "syntax": "match {scrutinee} {",
            "detect": "^\\s*match\\s+(.+)\\s*\\{",
            "captures": { "scrutinee": 1 },
            "notes": "Match header — arms follow inside braces.",
            "priority": 1
        },
        {
            "id": "arm_with_guard_and_binding",
            "syntax": "{pattern}({binding}) if {guard} => {body}",
            "detect": "^\\s*(\\w+)\\(([^)]+)\\)\\s+if\\s+(.+)\\s*=>\\s*(.+)",
            "captures": { "pattern": 1, "binding": 2, "guard": 3, "body": 4 },
            "notes": "e.g., Ok(meta) if meta.is_dir() => Ok(()). Binding + guard.",
            "priority": 2
        },
        {
            "id": "arm_with_binding",
            "syntax": "{pattern}({binding}) => {body}",
            "detect": "^\\s*(\\w+)\\(([^)]+)\\)\\s*=>\\s*(.+)",
            "captures": { "pattern": 1, "binding": 2, "body": 3 },
            "notes": "e.g., Ok(_) => ..., Err(e) => Err(e). Binding without guard.",
            "priority": 3
        },
        {
            "id": "arm_simple",
            "syntax": "{pattern} => {body}",
            "detect": "^\\s*([^=]+)\\s*=>\\s*(.+)",
            "captures": { "pattern": 1, "body": 2 },
            "notes": "Simple arm without binding — value match or wildcard.",
            "priority": 4
        },
        {
            "id": "arm_wildcard",
            "syntax": "_ => {body}",
            "detect": "^\\s*_\\s*=>\\s*(.+)",
            "captures": { "body": 1 },
            "notes": "Wildcard / default arm.",
            "priority": 5
        }
    ],

    "_X5_note": "Rust match: exhaustive pattern matching with destructuring and guards."
}
