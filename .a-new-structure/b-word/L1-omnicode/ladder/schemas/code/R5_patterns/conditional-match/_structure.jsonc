    "_P2_role": "schema",
    "_P5_title": "Concept — Conditional Match (Pattern Matching)",
    "_P5_brief": "Universal concept: multi-way branching by matching an expression against patterns. Rust match, Go switch, C switch.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "conditional_match",
    "description": "Multi-way branching by matching an expression against patterns or values",

    "universal_shape": {
        "scrutinee": "the expression being matched against",
        "arms": "array of (pattern, guard, body) triples",
        "default": "optional catch-all arm (wildcard / default case)"
    },

    "arm_shape": {
        "pattern": "the pattern to match (value, destructor, wildcard)",
        "guard": "optional additional condition on the pattern",
        "body": "statements or expression to execute when matched",
        "bindings": "variables bound by destructuring the pattern"
    },

    "semantic_notes": [
        "Rust match: exhaustive, pattern destructuring, guards with 'if', is expression.",
        "Go switch: non-exhaustive (unless all cases covered), value or type switch, fallthrough explicit.",
        "C switch: non-exhaustive, integer/enum only, fallthrough default, break required.",
        "Rust Ok(meta) if meta.is_dir() → Go case with inner if check.",
        "Rust Err(e) if e.kind() == ... → Go error type assertion or kind check."
    ],

    "container_map": {
        "_note": "granted (+1) = belongs here. denied (-1) = does not belong. defer (0) = context-dependent.",

