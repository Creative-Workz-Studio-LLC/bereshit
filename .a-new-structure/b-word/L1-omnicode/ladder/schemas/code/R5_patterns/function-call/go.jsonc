{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-function-call",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Function Call",

    "concept": "function_call",
    "language": "go",

    "patterns": [
        {
            "id": "qualified_call",
            "syntax": "{package}.{Function}({args})",
            "detect": "([a-zA-Z_]\\w*)\\.([A-Z]\\w*)\\(([^)]*)\\)",
            "emit": "{package}.{Function}({args})",
            "captures": { "package": 1, "function": 2, "args": 3 },
            "notes": "Package-qualified call — PascalCase function means exported. e.g., os.Stat(path).",
            "priority": 1
        },
        {
            "id": "unqualified_call",
            "syntax": "{function}({args})",
            "detect": "(?<!\\.)(\\b[a-z_]\\w*)\\(([^)]*)\\)",
            "emit": "{function}({args})",
            "captures": { "function": 1, "args": 2 },
            "notes": "Unqualified call — same-package function or builtin (make, len, append).",
            "priority": 2
        }
    ],

    "rust_to_go_mapping": {
        "pkg::function(args)": "pkg.Function(args) — :: to dot, PascalCase for exported",
        "function(args)": "function(args) — same for unqualified, keep camelCase",
        "format!(tmpl, args)": "fmt.Sprintf(tmpl, args) — Rust macro → Go fmt package"
    },

    "_X5_note": "Go function calls — dot-qualified, PascalCase for exported functions."
}
