    "_P5_title": "Concept — Function Call",
    "_P5_brief": "Universal concept: invoking a free function (not a method on a receiver). Module-qualified or imported.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "function_call",
    "description": "Invoke a free function (not bound to a receiver/object)",

    "universal_shape": {
        "module": "optional module/package qualifier",
        "function": "the function name being called",
        "args": "argument expressions passed to the function",
        "result": "optional variable receiving the return value"
    },

    "semantic_notes": [
        "Rust: module::function(args) — path-qualified with double-colon.",
        "Go: package.Function(args) — dot-qualified, function capitalized if exported.",
        "C: function(args) — no module qualifier (headers provide declarations).",
        "Some calls are used for their return value, others for side effects.",
        "Constructor calls (Type::new()) may be a function_call or a distinct concept."
    ],

