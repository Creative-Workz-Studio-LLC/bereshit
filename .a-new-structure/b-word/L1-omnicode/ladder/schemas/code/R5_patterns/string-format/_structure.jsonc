    "_P5_title": "Concept — String Format (Interpolation)",
    "_P5_brief": "Universal concept: building a string from a template and arguments. Rust format!(), Go fmt.Sprintf(), C sprintf().",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "string_format",
    "description": "Build a string from a format template and argument expressions",

    "universal_shape": {
        "template": "the format string with placeholders",
        "args": "expressions to substitute into placeholders",
        "placeholders": "the placeholder syntax used ({}, %s, %d, etc.)"
    },

    "semantic_notes": [
        "Rust: format!('template {}', args) — macro, {} placeholders, Display trait.",
        "Go: fmt.Sprintf('template %s', args) — function, %verb placeholders.",
        "C: sprintf(buf, 'template %s', args) — writes to buffer, %verb placeholders.",
        "Rust {} maps to Go %v (default formatting) or %s (string) or %d (integer).",
        "Rust {:.2} maps to Go %.2f — precision formatting.",
        "Rust path.display() is needed for Path types; Go uses path directly."
    ],

    "container_map": {
