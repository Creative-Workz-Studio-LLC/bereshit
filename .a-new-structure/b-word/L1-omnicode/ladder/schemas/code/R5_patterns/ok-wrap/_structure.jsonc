    "_P5_title": "Concept — Ok Wrap (Success Result)",
    "_P5_brief": "Universal concept: wrapping a value in a success result type. Rust Ok(val), Go (val, nil), C return 0.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "concept": "ok_wrap",
    "description": "Wrap a value as a successful result",

    "universal_shape": {
        "expr": "the success value to wrap (may be unit/void)",
        "void": "whether wrapping the unit/void value (Ok(()), nil with no value)"
    },

    "semantic_notes": [
        "Rust: Ok(expr) — wraps in Result::Ok variant. Ok(()) for void success.",
        "Go: return expr, nil — success value paired with nil error. return nil for void.",
        "C: return 0 or return SUCCESS — convention-based, no type wrapper.",
        "Often appears at the end of functions that return Result/error."
    ],

