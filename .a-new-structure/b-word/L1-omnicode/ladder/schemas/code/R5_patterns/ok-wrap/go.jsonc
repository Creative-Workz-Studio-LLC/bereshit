{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-ok-wrap",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Ok Wrap (Success Return)",

    "concept": "ok_wrap",
    "language": "go",

    "patterns": [
        {
            "id": "return_nil_error",
            "syntax": "return nil",
            "detect": "^\\s*return\\s+nil\\s*$",
            "emit": "return nil",
            "captures": {},
            "notes": "Void success — return nil (error is nil). Maps to Rust Ok(()).",
            "priority": 1
        },
        {
            "id": "return_value_nil",
            "syntax": "return {expr}, nil",
            "detect": "^\\s*return\\s+(.+),\\s*nil\\s*$",
            "emit": "return {expr}, nil",
            "captures": { "expr": 1 },
            "notes": "Success with value — the pair (value, nil). Maps to Rust Ok(val).",
            "priority": 2
        }
    ],

    "rust_to_go_mapping": {
        "Ok(())": "return nil — void Ok → nil error",
        "Ok(val)": "return val, nil — value Ok → value + nil error"
    },

    "_X5_note": "Go success — nil error means 'it worked'. No Result type wrapper."
}
