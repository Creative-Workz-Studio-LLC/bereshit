{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-ok-wrap",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Ok Wrap (Success Return)",

    "concept": "ok_wrap",
    "language": "go",

    "patterns": [
        {
            "id": "return_nil_error",
            "emit": "return nil",
            "when": "function returns only error — Ok(()) maps to return nil",
            "notes": "Void success in Go: return nil (the error is nil).",
            "priority": 1
        },
        {
            "id": "return_value_nil",
            "emit": "return {expr}, nil",
            "when": "function returns (T, error) — Ok(val) maps to return val, nil",
            "notes": "Success with value: the pair (value, nil).",
            "priority": 2
        }
    ],

    "_X5_note": "Go success — nil error means 'it worked'. No Result type wrapper."
}
