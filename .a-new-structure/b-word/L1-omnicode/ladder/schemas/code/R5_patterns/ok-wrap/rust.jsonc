{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-rust-ok-wrap",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Rust — Ok Wrap",

    "concept": "ok_wrap",
    "language": "rust",

    "patterns": [
        {
            "id": "ok_unit",
            "syntax": "Ok(())",
            "detect": "Ok\\(\\(\\)\\)",
            "emit": "Ok(())",
            "captures": {},
            "void": true,
            "notes": "Void success — Ok(()) is Rust idiom for 'no error, no value'.",
            "priority": 1
        },
        {
            "id": "ok_expr",
            "syntax": "Ok({expr})",
            "detect": "Ok\\(([^)]+)\\)",
            "emit": "Ok({expr})",
            "captures": { "expr": 1 },
            "void": false,
            "notes": "Success with value — Ok(result), Ok(vec), etc.",
            "priority": 2
        }
    ],

    "go_to_rust_mapping": {
        "return nil": "Ok(()) — nil error only → void success",
        "return val, nil": "Ok(val) — value + nil error → Ok with value"
    },

    "_X5_note": "Rust Ok() — wrapping in Result::Ok variant."
}
