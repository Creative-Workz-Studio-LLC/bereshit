{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-rust-conditional-if",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Rust — Conditional If",

    "concept": "conditional_if",
    "language": "rust",

    "patterns": [
        {
            "id": "if_else",
            "syntax": "if {condition} { {then_body} } else { {else_body} }",
            "detect": "^\\s*if\\s+(.+)\\s*\\{",
            "emit": "if {condition} {\n    {then_body}\n} else {\n    {else_body}\n}",
            "captures": { "condition": 1 },
            "notes": "Body captured by brace matching, not regex. else/else if detected by continuation lines.",
            "priority": 1
        },
        {
            "id": "else_if",
            "syntax": "} else if {condition} {",
            "detect": "^\\s*\\}\\s*else\\s+if\\s+(.+)\\s*\\{",
            "emit": "} else if {condition} {\n    {body}\n}",
            "captures": { "condition": 1 },
            "notes": "Continuation of an if chain.",
            "priority": 2
        },
        {
            "id": "else",
            "syntax": "} else {",
            "detect": "^\\s*\\}\\s*else\\s*\\{",
            "emit": "} else {\n    {body}\n}",
            "captures": {},
            "notes": "Final else branch.",
            "priority": 3
        }
    ],

    "go_to_rust_mapping": {
        "if condition {": "if condition { — same syntax, no parens in either",
        "if init; condition {": "let init; if condition { — Go init statement → separate let binding",
        "} else if condition {": "} else if condition { — identical syntax"
    },

    "_X5_note": "Rust if: no parens around condition, braces required, can be expression."
}
