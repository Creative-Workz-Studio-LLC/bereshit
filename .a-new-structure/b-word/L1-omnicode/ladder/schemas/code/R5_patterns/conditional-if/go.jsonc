{
    // #!omni data --jsonc

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-transform-lang-go-conditional-if",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "language-expression",
    "_P2_role": "schema",
    "_P5_title": "Go — Conditional If",

    "concept": "conditional_if",
    "language": "go",

    "patterns": [
        {
            "id": "if_else",
            "emit": "if {condition} {\n\t{then_body}\n} else {\n\t{else_body}\n}",
            "when": "branching with both true and false paths",
            "notes": "Go if: no parens, braces required, opening brace on same line.",
            "priority": 1
        },
        {
            "id": "if_only",
            "emit": "if {condition} {\n\t{then_body}\n}",
            "when": "branching with only true path",
            "notes": "Simple if without else.",
            "priority": 2
        },
        {
            "id": "if_init",
            "emit": "if {init}; {condition} {\n\t{then_body}\n}",
            "when": "if with initialization statement (Go-specific)",
            "notes": "Go allows an init statement before condition: if err := f(); err != nil { ... }",
            "priority": 3
        }
    ],

    "_X5_note": "Go if — no parens around condition, opening brace MUST be on same line as if."
}
