    // ===================================================================

    "concept": "conditional_if",
    "description": "Branch execution based on a boolean condition",

    "universal_shape": {
        "condition": "boolean expression to evaluate",
        "then_body": "statements to execute when condition is true",
        "else_body": "optional statements when condition is false",
        "else_if": "optional chained condition (else if / elif)"
    },

    "semantic_notes": [
        "Nearly identical syntax across C-family languages (Rust, Go, C, Java).",
        "Rust: no parentheses around condition, braces required.",
        "Go: no parentheses around condition, braces required, init statement possible.",
        "C: parentheses required, braces optional (but always use them).",
        "Some languages allow if as expression (Rust), others only as statement (Go, C)."
    ],

