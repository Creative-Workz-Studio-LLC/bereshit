    "concept": "field_access",
    "description": "Reading a property from a structure — struct.field dot access without invocation",

    "universal_shape": {
        "receiver": "the struct/object being accessed",
        "field": "the property name being read",
        "result": "the value of the field"
    },

    "semantic_notes": [
        "Rust: instance.field — direct field access, no parens.",
        "Go: instance.Field — exported fields PascalCase, unexported lowercase.",
        "C: instance.field or ptr->field — direct vs pointer access.",
        "Distinct from method_call: no parens, no behavior invoked.",
        "Distinct from variable_binding: no new binding created.",
        "Read counterpart to type_construction (write). Together they form the struct I/O pair."
    ],

