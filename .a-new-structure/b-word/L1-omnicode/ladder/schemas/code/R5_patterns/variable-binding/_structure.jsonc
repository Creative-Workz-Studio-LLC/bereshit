    "concept": "variable_binding",
    "description": "Introduce a new named value into scope",

    "universal_shape": {
        "name": "identifier being bound",
        "expr": "value expression being assigned",
        "type": "optional explicit type annotation",
        "mutable": "whether the binding can be reassigned after creation"
    },

    "semantic_notes": [
        "Immutability is the default in some languages (Rust, OCaml) but not others (Go, C, JS).",
        "Some languages have no distinction (Go: all variables are mutable).",
        "Type inference may eliminate the need for explicit type annotation.",
        "Shadowing (re-binding same name) is distinct from mutation."
    ],

