{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-form-executable-rust",
    "_P1_from": "b-word/L1-omnicode/ladder/schemas/code/forms/bare-bone/rust-bare-bone.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "form-constraint",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/forms/declared",
    "_P3_includes": "none",
    "_P3_provides": ["EXECUTABLE_FORM_CONSTRAINTS", "CONTAINER_CAN_CANNOT", "EXECUTION_FLOW_ORDERING"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust Executable Form Schema",
    "_P5_brief": "Defines what CAN and CANNOT be in each container of an executable Rust file. Executable is the form for CLI tools, servers, and binaries — files with main() that run independently. Inherits bare-bone's foundation and promotes Helpers for argument parsing and config loading. BODY follows execution_flow ordering: Identity → Helpers → CoreOperations. Ce is POPULATED (main() + exit_code()). Every constraint has a WHY and a HOW.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-executable.jsonc",
        "key": "B-L1-schemas-form-executable-rust",
        "title": "Rust Executable Form Schema",
        "type": "Data (Form Constraint Schema)",
        "component": "Ladder",
        "role": "Define per-container CAN/CANNOT constraints for executable Rust form — CLI tools, servers, and binaries with main() entry points"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-19",
        "updated": "2026-02-19"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Genesis 1:14-16 — And God said, Let there be lights in the firmament of the heaven... and God made two great lights; the greater light to rule the day, and the lesser light to rule the night.",
        "principle": "Executable is Day 4 energy — the lights that GOVERN. Library creates (Day 3 bringing forth); executable commands. The greater light (main) rules the execution. The lesser light (helpers) illuminates the path. An executable doesn't just exist — it acts on the world. main() is the moment of 'Let there be' — the program speaks and things happen."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": [
            "code/forms/bare-bone/rust-bare-bone.jsonc — inherits foundation constraints (the floor this form stands on)",
            "code/base/base-4block-schema.jsonc — container definitions, form registry",
            "code/format/rust-4block-schema.jsonc — Rust syntax rules, comment conventions"
        ],
        "consumers": [
            "b-word/seed/code/L0/rust/executable.rs — the executable template this schema constrains (when created)",
            "All executable-form Rust files in the Bereshit codebase (demo binaries, CLI tools, servers)"
        ],
        "relationship": "bare-bone defines THE MINIMUM. This executable schema defines what CHANGES when promoting to executable form — Helpers activates, Ce populates with main(), execution_flow ordering structures the BODY."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // THE EXECUTABLE FORM CONSTRAINT SCHEMA
    //
    // Executable is the form for CLI tools, servers, and binaries.
    // Files with main() that run independently.
    //
    // Executable inherits bare-bone's foundation and PROMOTES:
    //   SETUP: S2/S4/S5/S10 available + S8/S9 reserved (no traits/macros)
    //   BODY:  +1 section (Helpers), -1 section (FreeFunctions reserved)
    //   CLOSING: Ce POPULATED (main()+exit_code()), Cc/X2/X3 available
    //
    // BODY ordering: execution_flow
    //   Identity → Helpers → CoreOperations
    //
    // Structure mirrors base-4block-schema.jsonc container layout:
    //   METADATA → SETUP → BODY → CLOSING
    // Each container gets: can, cannot, why, how.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/forms/executable/rust.schema.json",
    "title": "Rust Executable Form Constraints",
    "description": "Per-container CAN/CANNOT constraints for executable Rust files. CLI tools, servers, and binaries with main() entry points.",

    "form_identity": {
        "name": "executable",
        "is_foundation": false,
        "inherits": "bare-bone",
        "pragma": "//omni:code --rust -executable",
        "directive": "//omni:code --rust -executable",
        "template": "b-word/seed/code/L0/rust/executable.rs",
        "principle": "Governing after separation. bare-bone declared boundaries (Days 1-3); library filled them (Day 3 bringing forth); executable GOVERNS (Day 4 lights ruling). An executable acts on the world — main() speaks and things happen.",
        "derivation_rule": "Executable = bare-bone + Helpers (promoted) - FreeFunctions (not applicable) + Ce populated (main()+exit_code()). SETUP same as library (all available). BODY follows execution_flow: Identity → Helpers → CoreOperations.",
        "ordering": "execution_flow — Identity → Helpers → CoreOperations"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The four containers, each fully constrained.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "containers": {

        // ═══════════════════════════════════════════════════════
        // 1. METADATA CONTAINER — identical to bare-bone
        // ═══════════════════════════════════════════════════════
        //
        // Executable does NOT change METADATA requirements.
        // Identity is form-invariant. The ONLY difference:
        //   //omni:code --rust -executable (not -bare-bone)
        //   I2.subtype = "executable" (not "bare-bone")
        //   I2.role = form-specific (e.g., "cli", "server", "daemon")

        "METADATA": {
            "summary": "IDENTICAL TO BARE-BONE — fully required, every section, every required field. Executable does not change METADATA.",
            "reserved_omission": false,
            "inherits_from": "bare-bone METADATA (all constraints, all content_constraints)",

            "why": "Identity is form-invariant. An executable has exactly the same identity requirements as bare-bone. The PRAGMA and METADATA statics have the same fields, same required/defined split, same (&str, &str) format. The only values that change are I1.key (unique to this file), I2.subtype ('executable' not 'bare-bone'), and C-section values (file-specific context).",

            "executable_specific_changes": {
                "directives": "//omni:code --rust -executable (not -bare-bone)",
                "I2_subtype": "executable",
                "I2_role": "File-specific (e.g., 'cli', 'server', 'daemon', 'tool')",
                "doc_comments": "Executable doc comments describe WHAT THE PROGRAM DOES, how to run it, command-line usage, and expected behavior.",
                "C4_dependencies": "Real dependencies (std modules, external crates for arg parsing, etc.)",
                "C5_purpose": "Domain-specific purpose — what this executable accomplishes"
            },

            "content_constraints_note": "All content_constraints from bare-bone METADATA apply unchanged. See rust-bare-bone.jsonc METADATA container for the complete constraint definitions for directives, doc_comments, pragma_statics, metadata_statics, and comment_metadata.",

            "cannot": {
                "description": "Same as bare-bone — no executable code, no imports, no types, no Reserved Omission in METADATA.",
                "inherits": "bare-bone METADATA.cannot (all prohibitions unchanged)"
            }
        },

        "_METADATA_REPLACED": "THE FULL BARE-BONE METADATA CAN BLOCK WAS HERE — replaced with inherits_from reference above. See rust-bare-bone.jsonc for complete METADATA constraints.",
        "_METADATA_ORIGINAL_SECTIONS_REMOVED": {
            "sections_in_bare_bone": ["directives", "doc_comments", "pragma_statics", "metadata_statics", "comment_metadata"],
            "reason": "Executable does not change ANY METADATA constraints. Full definitions in bare-bone schema.",
            "note_to_linter": "When validating executable METADATA, use bare-bone METADATA constraints verbatim. Only values change (I2.subtype, I2.role, C-sections), not structure."
        },

        // ═══════════════════════════════════════════════════════
        // 2. SETUP CONTAINER — 4 required + 4 available + 2 reserved
        // ═══════════════════════════════════════════════════════
        //
        // Executable SETUP declares what EXISTS for a binary.
        // 4 REQUIRED (inherited from bare-bone):
        //   S1 Imports, S3 Constants, S6 ErrorTypes, S7 CoreTypes
        // 4 AVAILABLE (promoted from bare-bone reserved):
        //   S2 Modules, S4 Statics, S5 TypeAliases, S10 FeatureGates
        // 2 RESERVED (not promoted — executables don't define these):
        //   S8 TraitDefs, S9 Macros
        //
        // Key executable difference: S6 uses anyhow for binary
        // errors (humans read them), not thiserror (callers handle).

        "SETUP": {
            "summary": "4 required + 4 available + 2 reserved. All declarations needed for an executable binary.",
            "reserved_omission": true,

            "why": "Executable SETUP inherits bare-bone's 4 essential declarations and promotes 4 of 6 reserved sections. Modules (S2) organize the binary into subcommands and internal logic. Statics (S4) hold runtime singletons like config, compiled regexes, and logger. TypeAliases (S5) create domain vocabulary for CLI/server patterns. FeatureGates (S10) enable platform-specific or optional feature compilation. TraitDefs (S8) and Macros (S9) remain RESERVED because executables consume library contracts — they don't define them. An executable that needs trait definitions is probably a library with a main() bolted on.",

            "how": {
                "working_with_constraints": "Start with the 4 required sections. When you need submodules, add S2. When you need process-wide state, add S4. When you need type shortcuts, add S5. When you need conditional compilation, add S10. All 8 active sections have fixed positions — insert in order.",
                "executable_workflow": [
                    "1. S1 Imports: use std::process, use clap/argh for arg parsing, use your library crates",
                    "2. S2 Modules (when needed): mod args, mod run, mod output — organize by execution concern",
                    "3. S3 Constants: EXIT_SUCCESS, EXIT_FAILURE, PROGRAM_NAME, DEFAULT_CONFIG_PATH",
                    "4. S4 Statics (when needed): LazyLock<Config>, compiled regex patterns",
                    "5. S5 TypeAliases (when needed): type Result<T> = anyhow::Result<T>",
                    "6. S6 ErrorTypes: anyhow for binary (humans read errors), or custom enum if you need exit code mapping",
                    "7. S7 CoreTypes: Args struct (CLI args), Config struct (if embedded), AppState",
                    "8. S10 FeatureGates (when needed): #[cfg(feature = \"verbose\")] for optional capabilities"
                ],
                "the_principle": "Executable SETUP declares everything a binary needs to START. BODY makes it RUN."
            },

            "can": {
                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "status": "REQUIRED",
                    "rust_syntax": "use std::process; use clap::Parser; use crate::run;",
                    "purpose": "External dependencies — what this binary needs from the world",
                    "why_required": "Inherited from bare-bone. Every executable imports at minimum std::process (exit codes) and whatever library crates it's built to use. Executables typically have MORE imports than libraries because they're the consumer endpoint.",
                    "executable_content": "REAL imports — std::process, std::env, arg parsing crate, library crates, internal modules. NOT commented out.",
                    "content_constraints": {
                        "can_contain": [
                            "use std::process; — exit code control (ExitCode, exit)",
                            "use std::env; — environment variables, args",
                            "use std::path::PathBuf; — file path handling",
                            "use std::io::{self, Write}; — stdout/stderr output",
                            "use {arg_parser}::Parser; — argument parsing (clap, argh, pico-args, or manual)",
                            "use {library_crate}::{types, functions}; — the library crates this executable consumes",
                            "use crate::{module}::{item}; — internal module imports (when S2 Modules is active)",
                            "// Group comment headers: // --- Standard Library ---, // --- External Crates ---, // --- Internal ---"
                        ],
                        "cannot_contain": [
                            "use std::*; or any wildcard glob imports — import what you use, not everything",
                            "Duplicate imports — each path appears once",
                            "Imports for items not used in the file — dead imports fail clippy",
                            "Commented-out imports — executable is a DECLARED form, content is REAL",
                            "Imports mixed between groups — maintain std → external → internal ordering"
                        ],
                        "executable_pattern": "REAL uncommented imports grouped by origin. Always includes std::process. Arg parsing crate import. Library crate imports. The binary's dependency surface is visible at a glance.",
                        "why_these_constraints": "Executable imports declare the binary's dependency surface — every crate this binary links. std::process is always needed (exit codes). The arg parser is always needed (unless hardcoded behavior). Library crates are why this binary exists. Grouping by origin makes the surface visible."
                    }
                },

                "S2_Modules": {
                    "position": 2,
                    "tag": "Modules",
                    "status": "AVAILABLE",
                    "rust_syntax": "mod args; mod run; mod output;",
                    "purpose": "Internal module tree — organizing the binary's concerns",
                    "why_available": "PROMOTED from bare-bone reserved. Executables with more than trivial complexity organize into submodules. A CLI tool might have mod args (parsing), mod run (execution logic), mod output (formatting). Not required because simple binaries can fit in one file.",
                    "executable_content": "Module declarations for the binary's internal organization. Each mod is a separate file.",
                    "content_constraints": {
                        "can_contain": [
                            "mod args; — argument parsing module",
                            "mod run; — main execution logic module",
                            "mod output; — output formatting module",
                            "mod config; — configuration loading module",
                            "mod commands; — subcommand dispatch (for CLI tools with subcommands)",
                            "pub use {module}::{Type}; — re-exports for convenience",
                            "/// doc comment explaining the module's responsibility"
                        ],
                        "cannot_contain": [
                            "mod tests; — test modules belong in CLOSING Cv, not SETUP",
                            "pub mod with deeply nested trees — executables should be flat (2 levels max)",
                            "Modules that duplicate library crate organization — use the library, don't mirror it",
                            "More than ~6 modules — if you need more, you need a workspace, not a bigger binary"
                        ],
                        "executable_pattern": "Flat module tree organized by execution concern: args → config → run → output. Each module has a clear single responsibility. Re-exports bring key types to the binary's root.",
                        "why_these_constraints": "Executable modules organize by EXECUTION CONCERN (what happens when), not by TYPE LIFECYCLE (how types evolve). A binary's flow is: parse args → load config → run logic → format output. Modules mirror this flow."
                    }
                },

                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "status": "REQUIRED",
                    "rust_syntax": "const EXIT_SUCCESS: i32 = 0; const PROGRAM_NAME: &str = \"tool\";",
                    "purpose": "Compile-time known values — exit codes, program identity, default paths",
                    "why_required": "Inherited from bare-bone. Every executable has at least exit codes, a program name, and default configuration values. These are the binary's fixed parameters.",
                    "executable_content": "REAL constants — EXIT_SUCCESS/EXIT_FAILURE, PROGRAM_NAME, VERSION, default paths/timeouts. NOT commented out.",
                    "content_constraints": {
                        "can_contain": [
                            "const EXIT_SUCCESS: i32 = 0; — standard exit code for success",
                            "const EXIT_FAILURE: i32 = 1; — standard exit code for failure",
                            "const PROGRAM_NAME: &str = \"{name}\"; — binary name for help/error messages",
                            "const VERSION: &str = env!(\"CARGO_PKG_VERSION\"); — version from Cargo.toml",
                            "const DEFAULT_CONFIG_PATH: &str = \"{path}\"; — default config file location",
                            "const DEFAULT_TIMEOUT_SECS: u64 = 30; — default timeout values",
                            "const MAX_RETRIES: usize = 3; — retry limits",
                            "// Executable-specific constants describing the binary's fixed parameters"
                        ],
                        "cannot_contain": [
                            "static variables — runtime state belongs in S4 Statics",
                            "let bindings — those are function-local, not module-level",
                            "Library-exported constants — those belong in the library crate, not the binary",
                            "PRAGMA or METADATA statics — those are identity in METADATA block, not SETUP constants",
                            "Commented-out constants — executable is DECLARED, content is REAL"
                        ],
                        "executable_pattern": "Exit codes FIRST (EXIT_SUCCESS, EXIT_FAILURE), then program identity (NAME, VERSION), then configuration defaults (paths, timeouts, limits). Every magic number in BODY has a named constant here.",
                        "why_these_constraints": "Executable constants define the binary's fixed parameters — exit codes map to operating system conventions, program identity enables consistent error messages, defaults enable zero-config operation. Exit codes come first because they're the binary's CONTRACT with the shell."
                    }
                },

                "S4_Statics": {
                    "position": 4,
                    "tag": "Statics",
                    "status": "AVAILABLE",
                    "rust_syntax": "static CONFIG: LazyLock<Config> = LazyLock::new(|| { ... });",
                    "purpose": "Process-wide shared state — config, compiled patterns, caches",
                    "why_available": "PROMOTED from bare-bone reserved. Executables commonly need process-wide state: parsed configuration, compiled regex patterns, shared logger. These are initialized once and read throughout the binary's lifetime.",
                    "executable_content": "LazyLock/OnceLock for process-wide singletons. Config objects, compiled patterns, shared resources.",
                    "content_constraints": {
                        "can_contain": [
                            "static CONFIG: LazyLock<Config> = LazyLock::new(|| { ... }); — lazy config singleton",
                            "static LOGGER: OnceLock<Logger> = OnceLock::new(); — one-shot logger init",
                            "static PATTERN: LazyLock<Regex> = LazyLock::new(|| Regex::new(...).unwrap()); — compiled regex",
                            "/// doc comments explaining initialization behavior and thread safety"
                        ],
                        "cannot_contain": [
                            "PRAGMA or METADATA statics — those are identity in METADATA block",
                            "Constants (const) — those belong in S3",
                            "Mutable statics (static mut) — use LazyLock/OnceLock/Mutex instead",
                            "Statics that panic on initialization without clear error messages"
                        ],
                        "executable_pattern": "LazyLock for values computed once at first access. OnceLock for values set explicitly during init. Always thread-safe. Always documented with initialization behavior.",
                        "why_these_constraints": "Executable statics are process-wide shared state — initialized once, read many. LazyLock/OnceLock are Rust's safe singleton patterns. Mutable statics require unsafe and are almost never correct. PRAGMA/METADATA statics live in METADATA block, not here."
                    }
                },

                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "status": "AVAILABLE",
                    "rust_syntax": "type Result<T> = anyhow::Result<T>;",
                    "purpose": "Domain vocabulary shortcuts — reduce repetition in type signatures",
                    "why_available": "PROMOTED from bare-bone reserved. Executables frequently alias Result to their error type (anyhow::Result for most binaries). Also useful for complex CLI argument types or configuration shapes.",
                    "executable_content": "type Result<T> = anyhow::Result<T> is the canonical executable alias. Additional aliases for repeated complex types.",
                    "content_constraints": {
                        "can_contain": [
                            "type Result<T> = anyhow::Result<T>; — canonical binary result alias",
                            "type BoxError = Box<dyn std::error::Error + Send + Sync>; — when not using anyhow",
                            "type Config = Arc<AppConfig>; — shared config handle alias",
                            "/// doc comment explaining what each alias shortcuts"
                        ],
                        "cannot_contain": [
                            "Aliases that obscure meaning — type S = String is NEVER helpful",
                            "Aliases used in fewer than 3 places — not worth the indirection",
                            "Type definitions (struct/enum) — those belong in S7 CoreTypes",
                            "Trait aliases — those belong in S8 (Reserved)"
                        ],
                        "executable_pattern": "Result alias FIRST (it's used everywhere). Then shared-handle aliases (Arc<Config>). Each alias saves real keystrokes in real signatures.",
                        "why_these_constraints": "Type aliases are vocabulary — they give names to patterns you repeat. type Result<T> = anyhow::Result<T> saves every function from spelling out the full path. But aliases that don't save real repetition just add indirection."
                    }
                },

                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "status": "REQUIRED",
                    "rust_syntax": "use anyhow::{Context, Result}; // OR enum ExitError { ... }",
                    "purpose": "Error definitions — the binary's failure vocabulary for HUMAN readers",
                    "why_required": "Inherited from bare-bone. Every executable needs error handling. The KEY DIFFERENCE from library: executable errors are read by HUMANS (stderr, exit codes), not handled by CALLERS (match arms, ?).",
                    "executable_content": "anyhow for most executables (context-rich human-readable errors). Custom enum only when you need specific exit code mapping.",
                    "content_constraints": {
                        "can_contain": [
                            "use anyhow::{Context, Result, bail, ensure}; — context-rich error handling for binaries",
                            "pub enum ExitError { ... } — custom error enum ONLY when exit code mapping is needed",
                            "impl ExitError { fn exit_code(&self) -> i32 { ... } } — exit code mapping method",
                            "impl fmt::Display for ExitError — human-readable error messages for stderr",
                            "impl std::error::Error for ExitError — error trait compliance",
                            "impl From<io::Error> for ExitError — conversion from stdlib errors",
                            "/// doc comments: when this error occurs, what the user should do, what exit code maps to"
                        ],
                        "cannot_contain": [
                            "thiserror — that's for LIBRARY errors (callers handle them); executables use anyhow (humans read them)",
                            "Error types without actionable messages — 'Error occurred' tells the user nothing",
                            "Complex error hierarchies — executables have flat error surfaces (config/io/arg/runtime)",
                            "Error recovery logic — recovery is BODY, not SETUP"
                        ],
                        "executable_pattern": "anyhow for most binaries: .context(\"what we were doing\") adds human-readable context. Custom ExitError only for binaries that need specific exit codes (like make returning 2 for errors). Display messages are ACTIONABLE — they tell the user what went wrong and what to do.",
                        "why_these_constraints": "Executable errors are for HUMAN CONSUMPTION. When a binary fails, a human reads stderr and decides what to do. anyhow provides context chains ('failed to load config: file not found: /etc/app.toml') that help humans. thiserror is for library errors where CALLERS handle the variants programmatically. This is THE key distinction between library and executable error philosophy."
                    }
                },

                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "status": "REQUIRED",
                    "rust_syntax": "struct Args { ... } | struct Config { ... } | struct AppState { ... }",
                    "purpose": "Primary data shapes — what the binary operates on",
                    "why_required": "Inherited from bare-bone. Every executable has at least an Args struct (CLI arguments) and usually a Config struct. These are the nouns of the binary's world.",
                    "executable_content": "REAL structs — Args (CLI parsing), Config (settings), AppState (runtime state). NOT commented out.",
                    "content_constraints": {
                        "can_contain": [
                            "#[derive(Parser)] struct Args { ... } — CLI argument struct (with clap/argh derives)",
                            "struct Config { ... } — runtime configuration (loaded from file/env)",
                            "struct AppState { ... } — runtime state (if the binary maintains state)",
                            "#[derive(Debug)] on all types — debuggability is non-negotiable",
                            "#[derive(Clone, Serialize, Deserialize)] — when config needs persistence",
                            "impl Default for Config — sensible defaults enable zero-config operation",
                            "/// doc comments: what each field controls, default values, env overrides"
                        ],
                        "cannot_contain": [
                            "Library types — those belong in the library crate, not the binary",
                            "Complex business logic types — the binary should USE library types",
                            "Builder patterns — executables use library builders, not their own",
                            "Types without Debug derive — every type must be debuggable",
                            "More than ~4 primary types — if you need more, organize into modules (S2)"
                        ],
                        "executable_pattern": "Args struct FIRST (it's the entry point for user input). Config struct SECOND (it's loaded early). AppState THIRD (it combines parsed args + loaded config). Each struct is flat and documented.",
                        "why_these_constraints": "Executable types model the binary's OPERATIONAL CONCERNS: what the user asked for (Args), what the system is configured to do (Config), and the running state (AppState). These are distinct from the DOMAIN types in library crates. The binary combines library types with operational types to produce behavior."
                    }
                },

                "S10_FeatureGates": {
                    "position": 10,
                    "tag": "FeatureGates",
                    "status": "AVAILABLE",
                    "rust_syntax": "#[cfg(feature = \"verbose\")] const VERBOSE_DEFAULT: bool = true;",
                    "purpose": "Conditional compilation — platform-specific or optional binary features",
                    "why_available": "PROMOTED from bare-bone reserved. Executables use feature gates for: platform-specific behavior (Windows vs Linux paths), optional capabilities (verbose mode, debug output), build configurations (release optimizations).",
                    "executable_content": "Feature-gated types and constants for optional binary capabilities.",
                    "content_constraints": {
                        "can_contain": [
                            "#[cfg(feature = \"verbose\")] — optional verbose output mode",
                            "#[cfg(target_os = \"windows\")] — platform-specific paths and behaviors",
                            "#[cfg(debug_assertions)] — debug-only features and checks",
                            "#[cfg(feature = \"tui\")] — optional TUI mode vs plain stdout",
                            "/// doc comment explaining what each feature gate enables"
                        ],
                        "cannot_contain": [
                            "Feature gates without corresponding Cargo.toml [features] entries",
                            "Gates that make the binary non-functional when disabled (core features aren't optional)",
                            "Complex conditional compilation trees — keep it simple, prefer runtime checks when possible"
                        ],
                        "executable_pattern": "Feature gates for OPTIONAL capabilities that can be compiled out. Platform-specific behavior for cross-platform binaries. Debug-only checks that vanish in release builds.",
                        "why_these_constraints": "Executable feature gates control the binary's build variants — what gets compiled in. Core functionality must work without any features enabled. Gates are for optional enhancements (verbose, TUI, platform support), not core behavior."
                    }
                },

                "Reserved_Omission": {
                    "position": "LAST in SETUP (after all active subsections)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists the 2 SETUP sections NOT promoted by executable. Completeness: 8 active + 2 reserved = 10.",
                    "why_required": "Executables do not promote S8 TraitDefs or S9 Macros. Executables CONSUME library contracts — they don't define them. An executable that defines its own traits or macros is usually a library that grew a main().",
                    "reserved_sections": [
                        "S8 Trait Definitions — Behavioral contracts are LIBRARY concerns. Executables USE library traits, they don't DEFINE them. If you need trait definitions, your executable logic probably belongs in a library crate. [library, demo-test]",
                        "S9 Macros — Compile-time code generation is LIBRARY infrastructure. Executables USE macros from libraries (println!, clap derives). If you need custom macros, they belong in a library crate that the executable depends on. [library, demo-test]"
                    ]
                }
            },

            "cannot": {
                "description": "These 2 subsections CANNOT be active in executable form. They belong to library/demo-test forms.",

                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "status": "RESERVED",
                    "rust_syntax": "trait Name { fn method(&self) -> Type; }",
                    "why_reserved": "Trait definitions are behavioral contracts that establish polymorphic interfaces. Executables CONSUME library contracts (impl Trait for Type in BODY) but do not DEFINE them. An executable defining traits is a code smell — the contract belongs in a library crate that both the executable and other crates can depend on. If your executable needs a Command trait for subcommand dispatch, that trait definition belongs in a shared library.",
                    "not_promoted_by": "executable",
                    "belongs_to": ["library", "demo-test"],
                    "the_signal": "If you need trait definitions in your executable, extract them to a library crate. The executable depends on the library, not the other way around."
                },

                "S9_Macros": {
                    "position": 9,
                    "tag": "Macros",
                    "status": "RESERVED",
                    "rust_syntax": "macro_rules! name { ($pattern) => { expansion } }",
                    "why_reserved": "Macros are compile-time code generation infrastructure. Executables USE macros from std (println!), from derive macros (clap::Parser), and from utility crates. But defining custom macro_rules! in a binary is almost always a sign that the abstraction belongs in a library. Macros are reusable infrastructure — and reusable infrastructure lives in libraries, not binaries.",
                    "not_promoted_by": "executable",
                    "belongs_to": ["library", "demo-test"],
                    "the_signal": "If you're writing macro_rules! in a binary, ask: could another crate use this? If yes (usually yes), it belongs in a library."
                }
            },

            "completeness_rule": {
                "formula": "required + available + reserved = 10",
                "executable": "4 required (S1, S3, S6, S7) + 4 available (S2, S4, S5, S10) + 2 reserved (S8, S9) = 10",
                "three_status_levels": {
                    "REQUIRED": "Inherited from bare-bone — must exist in every executable",
                    "AVAILABLE": "Promoted from bare-bone reserved — use when the executable needs them",
                    "RESERVED": "Not promoted — executables don't define these (library/demo-test only)"
                },
                "linter_check": "cws-struct validates: active sections + reserved sections = 10. No section silently missing."
            }
        },

        // ═══════════════════════════════════════════════════════
        // 3. BODY CONTAINER — 3 required in execution_flow
        // ═══════════════════════════════════════════════════════
        //
        // Executable BODY makes things RUN. Three sections in
        // execution_flow ordering:
        //   B1 IdentityAccess (inherited — pragma/metadata API)
        //   B2 Helpers (PROMOTED — serve run())
        //   B3 CoreOperations (= CoreLogic renamed — run())
        //
        // FreeFunctions: RESERVED (executables don't expose
        // module-level API — they're consumed by running).

        "BODY": {
            "summary": "3 required sections in execution_flow ordering. The logic that makes the binary RUN.",
            "reserved_omission": true,

            "why": "Executable BODY follows execution_flow ordering: Identity → Helpers → CoreOperations. This reflects how a binary actually runs — identity is established first, helpers are called by the core, core operations do the work. IdentityAccess is inherited (universal — every file has identity statics). Helpers is PROMOTED from reserved (executable-specific — argument parsing, config loading, output formatting that serve run()). CoreOperations is CoreLogic renamed to reflect executable semantics — not 'logic on types' but 'operations the binary performs.' FreeFunctions is RESERVED because executables don't expose module-level API — they're consumed by running, not importing.",

            "how": {
                "working_with_constraints": "IdentityAccess holds the 4 accessor functions (same as all forms). Helpers holds everything that SUPPORTS run(). CoreOperations holds run() itself and any top-level execution logic.",
                "execution_flow_ordering": [
                    "B1 IdentityAccess — FIRST: identity is established before anything runs",
                    "B2 Helpers — SECOND: support functions exist before the code that calls them",
                    "B3 CoreOperations — THIRD: run() calls helpers, uses identity, does the work"
                ],
                "the_principle": "Executable BODY reads top-to-bottom as: WHO am I → WHAT do I have → WHAT do I do. The reader understands the binary's behavior by reading in order."
            },

            "can": {
                "B1_IdentityAccess": {
                    "position": 1,
                    "tag": "IdentityAccess",
                    "status": "REQUIRED",
                    "rust_syntax": [
                        "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA }",
                        "pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA }",
                        "pub fn pragma_get(key: &str) -> Option<&'static str> { ... }",
                        "pub fn metadata_get(key: &str) -> Option<&'static str> { ... }"
                    ],
                    "purpose": "Runtime access to compile-time identity data — the bridge between METADATA statics and runtime code",
                    "why_required": "Inherited from bare-bone. Every OmniCode file with PRAGMA/METADATA statics needs these 4 functions. Universal across all forms because identity is universal. Executable uses these for --version output, error context, and logging.",
                    "executable_content": "REAL uncommented accessor functions — identical implementation to all forms. Only doc comment examples change (executable-specific keys).",
                    "content_constraints": {
                        "can_contain": [
                            "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA } — full slice accessor",
                            "pub fn pragma_get(key: &str) -> Option<&'static str> — key lookup via iter().find()",
                            "pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA } — full slice accessor",
                            "pub fn metadata_get(key: &str) -> Option<&'static str> — key lookup via iter().find()",
                            "/// doc comments with executable-specific usage: version output, error context, identity logging"
                        ],
                        "cannot_contain": [
                            "Functions that modify identity — PRAGMA/METADATA are immutable statics",
                            "Functions that compute derived values from identity — keep accessors pure (read-only)",
                            "Any function not related to PRAGMA/METADATA access — other functions go in Helpers or CoreOperations",
                            "Caching or memoization — the statics are already compile-time; nothing to cache",
                            "Error handling — these functions cannot fail (the statics always exist)"
                        ],
                        "executable_pattern": "4 uncommented functions: pragma(), pragma_get(), metadata(), metadata_get(). Implementation IDENTICAL to all forms. Executables use these for --version flags, error context messages, and startup logging.",
                        "why_these_constraints": "IdentityAccess is the bridge between compile-time identity and runtime code. Universal across forms. In executable context, identity enables: --version output from pragma_get(\"C1.version\"), error context from metadata_get(\"I3.title\"), startup banner from pragma()/metadata() iteration."
                    }
                },

                "B2_Helpers": {
                    "position": 2,
                    "tag": "Helpers",
                    "status": "REQUIRED",
                    "rust_syntax": "fn parse_args() -> Result<Args> { ... } fn load_config(path: &Path) -> Result<Config> { ... }",
                    "purpose": "Support functions that serve run() — argument parsing, config loading, output formatting",
                    "why_required": "PROMOTED from bare-bone reserved. Helpers is the executable-specific section. Every non-trivial binary needs helper functions: parse arguments, load configuration, format output, validate input. These SERVE run() — they are the machinery that makes the core operation possible.",
                    "executable_content": "REAL helper functions — parse_args(), load_config(), format_output(), validate_input(). Each is a self-contained operation that run() calls.",
                    "content_constraints": {
                        "can_contain": [
                            "fn parse_args() -> Result<Args> — CLI argument parsing (wraps clap/argh or manual parsing)",
                            "fn load_config(path: &Path) -> Result<Config> — config file loading and validation",
                            "fn validate_input(args: &Args) -> Result<()> — input validation beyond what the arg parser handles",
                            "fn format_output(result: &T, format: OutputFormat) -> String — output formatting (json, table, plain)",
                            "fn setup_logging(verbosity: u8) -> Result<()> — log level configuration",
                            "fn resolve_paths(args: &Args) -> Result<ResolvedPaths> — path resolution and canonicalization",
                            "/// doc comments explaining each helper's role in the execution flow"
                        ],
                        "cannot_contain": [
                            "The run() function — that's CoreOperations (B3), not Helpers",
                            "main() or exit_code() — those are CLOSING Ce",
                            "Type definitions — those are SETUP S7",
                            "Business logic that IS the operation — helpers SUPPORT the operation, they don't DO it",
                            "Library-level utility functions — those belong in the library crate",
                            "Test functions — those belong in CLOSING Cv"
                        ],
                        "executable_pattern": "Helper functions in call-order: parse_args → load_config → validate_input → setup_logging → resolve_paths → format_output. Each helper is a self-contained operation with clear input/output. run() calls them in sequence.",
                        "why_these_constraints": "Helpers are the MACHINERY of the binary — the infrastructure that run() calls to do its work. They are ordered by when they execute: args first (user input), config second (system state), validation third (correctness check), then domain-specific helpers. Helpers SUPPORT; CoreOperations DOES. The distinction keeps run() focused on orchestration while helpers handle specifics."
                    }
                },

                "B3_CoreOperations": {
                    "position": 3,
                    "tag": "CoreOperations",
                    "status": "REQUIRED",
                    "rust_syntax": "pub fn run() -> Result<()> { ... }",
                    "purpose": "The binary's primary operations — run() and any top-level execution logic",
                    "why_required": "Inherited from bare-bone as CoreLogic, renamed to CoreOperations for executable semantics. This is the ACTUAL WORK the binary does. run() is the canonical entry: called by main(), orchestrates helpers, produces results.",
                    "executable_content": "REAL run() function — parses args (via B2), loads config (via B2), executes the binary's primary operation, formats output (via B2).",
                    "content_constraints": {
                        "can_contain": [
                            "pub fn run() -> Result<()> — the canonical executable entry point (called by main())",
                            "fn execute(args: &Args, config: &Config) -> Result<Output> — core execution when run() needs decomposition",
                            "fn dispatch(command: &Command) -> Result<()> — subcommand dispatch for CLI tools with subcommands",
                            "fn serve(config: &Config) -> Result<()> — server loop for daemon-style executables",
                            "Orchestration logic — calling helpers in sequence, handling results, producing output",
                            "/// doc comments explaining the execution flow and error handling strategy"
                        ],
                        "cannot_contain": [
                            "Helper functions (parse_args, load_config, etc.) — those belong in B2 Helpers",
                            "main() or exit_code() — those are CLOSING Ce (thin delegation to run())",
                            "Type definitions — those are SETUP S7",
                            "Argument parsing logic — that's a B2 Helper (parse_args)",
                            "Output formatting logic — that's a B2 Helper (format_output)",
                            "Test functions — those belong in CLOSING Cv"
                        ],
                        "executable_pattern": "run() as the SINGLE orchestration point: (1) parse args, (2) load config, (3) execute core operation, (4) format and output results, (5) return Ok(()) or Err. run() reads like a recipe — each step is a helper call. Complex binaries may decompose into execute() + dispatch() or execute() + serve().",
                        "why_these_constraints": "CoreOperations is WHERE THE BINARY DOES ITS WORK. run() is the orchestration function — it calls helpers, delegates to libraries, and manages the execution flow. main() (in Ce) is thin: it calls run() and maps the result to an exit code. The run() → main() split keeps business logic testable (run returns Result) while main() handles OS-level concerns (exit codes, stderr). This pattern is Rust's canonical executable structure."
                    }
                },

                "Reserved_Omission": {
                    "position": "LAST in BODY (after all active subsections)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists all BODY sections NOT active in executable. Completeness: 3 active + 14 reserved = 17.",
                    "why_required": "Executable activates 3 BODY sections. The remaining 14 belong to other forms. Nothing is silently absent — the reserved list is the contract of what's NOT here.",

                    "reserved_sections": {
                        "from_bare_bone_active": {
                            "FreeFunctions": "RESERVED — executables don't expose module-level API. Executables are consumed by running, not importing. Library-level utilities belong in library crates. register_identity() is not needed for binaries. [library]"
                        },
                        "library_sections": [
                            "TraitImplementations — impl Trait for Type blocks. Executables USE library trait impls, not define them. [library]",
                            "Constructors & Builders — new(), try_new(), builder patterns. Executables use library constructors. [library]",
                            "Queries & Accessors — Read-only &self methods. Library concern. [library]",
                            "Output & Display — Display, Debug, serialization. Library concern. [library]"
                        ],
                        "demo_test_sections": [
                            "ConstructorTests — Verify construction [demo-test]",
                            "BuilderTests — Verify builders [demo-test]",
                            "TransitionTests — Verify state transitions [demo-test]",
                            "QueryTests — Verify accessors [demo-test]",
                            "IdentityTests — Verify PRAGMA/METADATA [demo-test]",
                            "ErrorTests — Verify error Display [demo-test]",
                            "EdgeCaseTests — Boundary conditions [demo-test]",
                            "TableDrivenTests — Systematic input/output [demo-test]",
                            "IntegrationTests — End-to-end workflows [demo-test]"
                        ]
                    },

                    "completeness_rule": {
                        "formula": "3 active + 14 reserved = 17",
                        "active": "B1 IdentityAccess + B2 Helpers + B3 CoreOperations = 3",
                        "reserved": "1 (FreeFunctions) + 4 (library) + 9 (demo-test) = 14",
                        "note": "Same total as bare-bone (3 + 14 = 17) — executable activates Helpers and reserves FreeFunctions, net change is zero."
                    }
                }
            },

            "cannot": {
                "description": "These sections CANNOT be active in executable. They belong to library and demo-test forms.",

                "FreeFunctions": {
                    "tag": "FreeFunctions",
                    "status": "RESERVED",
                    "note": "FreeFunctions is ACTIVE in bare-bone but RESERVED in executable.",
                    "why_reserved": "Executables don't expose module-level API — they're consumed by running, not importing. Library-level utilities (register_identity(), convenience wrappers) belong in library crates that the executable depends on. An executable with free functions is a library that grew a main().",
                    "belongs_to": ["library"],
                    "the_signal": "If you need free functions, they probably belong in a library crate, not the binary."
                },

                "form_library_sections": {
                    "sections": ["TraitImplementations", "Constructors", "Queries", "Output"],
                    "why_reserved": "Library BODY sections follow type_lifecycle ordering — identity → traits → creation → operation → observation → output → free functions. Executable BODY follows execution_flow — identity → helpers → operations. Different purpose, different structure.",
                    "belongs_to": "library form",
                    "the_signal": "If you need trait impls, constructors, queries, or Display impls, those belong in the library crate this executable consumes."
                },

                "form_demo_test_sections": {
                    "sections": [
                        "ConstructorTests", "BuilderTests", "TransitionTests",
                        "QueryTests", "IdentityTests", "ErrorTests",
                        "EdgeCaseTests", "TableDrivenTests", "IntegrationTests"
                    ],
                    "why_reserved": "Test BODY sections follow concern_coverage ordering. These 9 categories structure comprehensive library testing.",
                    "belongs_to": "demo-test form"
                }
            },

            "execution_flow_ordering": {
                "principle": "Executable BODY reads like a program executing: establish identity, prepare support, do the work.",
                "B1": "IdentityAccess — WHO am I? (pragma/metadata API)",
                "B2": "Helpers — WHAT do I have? (parse, load, validate, format)",
                "B3": "CoreOperations — WHAT do I do? (run, execute, dispatch, serve)",
                "contrast_with_library": "Library uses type_lifecycle (how types evolve). Executable uses execution_flow (how the program runs). Different ordering because different purpose."
            }
        },

        // ═══════════════════════════════════════════════════════
        // 4. CLOSING CONTAINER — 5 required + 3 available
        // ═══════════════════════════════════════════════════════
        //
        // Executable CLOSING proves the code works and provides
        // the entry point.
        //
        // THE KEY DISTINCTION: Ce is POPULATED.
        //   Ce holds main() + exit_code() — the binary's entry.
        //   Library Ce is empty. Executable Ce is where it starts.
        //
        // 5 REQUIRED: Cv, Ce (POPULATED), X1, X4, X5
        // 3 AVAILABLE: Cc (cleanup), X2 (extension), X3 (troubleshooting)
        // 1 RESERVED: TestCoverageSummary (demo-test only)
        // X6 NOT PRESENT (executable is derived, not template)

        "CLOSING": {
            "summary": "5 required + 3 available. Tests, POPULATED entry point (main), documentation. X6 absent (derived file).",
            "reserved_omission": true,

            "why": "Executable CLOSING proves the binary works (Cv), STARTS the binary (Ce — THE key difference from library), and guides maintainers (X1-X5). Ce is POPULATED in executable: main() is the OS entry point, exit_code() maps Result to exit codes. This is what makes an executable an executable. Cc/X2/X3 are available because executables often need resource cleanup (Cc for Drop impls, signal handlers), extension documentation (X2 for planned features), and troubleshooting guides (X3 for common problems). X6 is NOT PRESENT because executable is a derived form, not a template. TestCoverageSummary is RESERVED for demo-test only.",

            "how": {
                "working_with_constraints": "Write tests in Cv (exit codes, error display, identity, run() logic). Write main()+exit_code() in Ce. Write modification policy in X1, references in X4, closing anchor in X5. Promote Cc/X2/X3 when needed.",
                "executable_ordering": "Cv → Ce → [Cc] → Reserved Omission → X1 → [X2] → [X3] → X4 → X5",
                "Ce_is_the_key": "Ce in executable is where the binary STARTS. main() calls run() (BODY B3) and maps the Result to an exit code via exit_code(). This thin delegation keeps business logic testable."
            },

            "can": {
                "code_zones": {
                    "description": "Actual executable Rust code. Always precede documentation sections.",

                    "Cv_Validation": {
                        "position": 1,
                        "tag": "Cv",
                        "status": "REQUIRED",
                        "rust_syntax": "#[cfg(test)] mod tests { use super::*; #[test] fn test_name() { ... } }",
                        "purpose": "Inline tests — prove the binary works correctly",
                        "why_required": "Inherited from bare-bone. Tests are accountability. Executable tests verify: exit code mapping works, error messages are human-readable, identity statics are correct, helpers parse correctly, run() succeeds on valid input and fails gracefully on invalid input.",
                        "executable_content": "REAL tests organized by BODY section: B1 identity tests, B2 helper tests, B3 core operation tests. Plus executable-specific: exit code mapping, error display formatting.",
                        "content_constraints": {
                            "can_contain": [
                                "#[cfg(test)] mod tests { use super::*; ... } — exactly one test module",
                                "#[test] fn test_name() { ... } — individual test functions",
                                "use super::*; — white-box access to all private items in this file",
                                "// -- B1 IdentityAccess ---- comment headers organizing tests by BODY section",
                                "// -- B2 Helpers ---- helper function tests",
                                "// -- B3 CoreOperations ---- run() tests",
                                "// -- Exit Code Mapping ---- exit_code() tests",
                                "// -- Error Display ---- human-readable error formatting tests",
                                "assert!(), assert_eq!(), assert_ne!() — standard assertions",
                                "assert!(matches!(val, Pattern)) — pattern matching assertions",
                                "fn test_name() -> Result<(), anyhow::Error> — fallible tests with ? operator"
                            ],
                            "cannot_contain": [
                                "Tests for Reserved sections — you can't test what doesn't exist",
                                "Integration tests (those go in tests/ directory, not inline)",
                                "Test helpers complex enough to be their own module — extract to test_utils.rs",
                                "Tests with ordering dependencies — tests run in any order",
                                "More than one mod tests block — exactly one, in Cv"
                            ],
                            "executable_pattern": "Tests organized by BODY section (B1, B2, B3) plus executable-specific concerns (exit codes, error display). Identity tests verify pragma_get/metadata_get return correct values. Helper tests verify parse_args/load_config with good and bad input. run() tests verify the happy path and error paths. Exit code tests verify the mapping from Result to i32.",
                            "why_these_constraints": "Cv is accountability — every claim about the binary's behavior must be provable by a test. Organizing by BODY section (B1→B2→B3) mirrors the execution flow: identity → helpers → operations. Exit code mapping is executable-specific and MUST be tested because it's the binary's contract with the shell."
                        }
                    },

                    "Ce_Execution": {
                        "position": 2,
                        "tag": "Ce",
                        "status": "REQUIRED",
                        "rust_syntax": "fn exit_code(result: Result<()>) -> i32 { ... } fn main() { std::process::exit(exit_code(run())); }",
                        "purpose": "ENTRY POINT — main() + exit_code(). THE code that starts the binary.",
                        "why_required": "THIS IS WHAT MAKES IT AN EXECUTABLE. Ce holds main() (the OS entry point) and exit_code() (the Result-to-exit-code mapper). main() is thin — it calls run() from BODY B3 and maps the result. This pattern keeps business logic testable (run returns Result) while main() handles OS concerns (exit codes).",
                        "executable_content": "REAL POPULATED CODE — exit_code() maps Result<()> to i32, main() calls run() and exits.",
                        "content_constraints": {
                            "can_contain": [
                                "fn exit_code(result: Result<()>) -> i32 — maps run() Result to shell exit code",
                                "fn main() { std::process::exit(exit_code(run())); } — thin entry, delegates to run()",
                                "match result { Ok(()) => EXIT_SUCCESS, Err(e) => { eprintln!(\"Error: {e:#}\"); EXIT_FAILURE } }",
                                "Error output to stderr — eprintln! for human-readable error context",
                                "/// doc comments: main() explains the binary's purpose, exit_code() documents the mapping",
                                "Optional: startup banner (program name, version from identity statics)"
                            ],
                            "cannot_contain": [
                                "Business logic — main() is thin, delegating ALL work to run() in BODY B3",
                                "Argument parsing — that's a B2 Helper (parse_args), called from run()",
                                "Config loading — that's a B2 Helper (load_config), called from run()",
                                "Error recovery or retry logic — that goes in BODY run() or helpers",
                                "Complex error formatting — keep it simple: eprintln!(\"Error: {e:#}\")",
                                "Test functions — tests are Cv, not Ce",
                                "Cleanup logic — cleanup is Cc"
                            ],
                            "executable_pattern": "exit_code() FIRST (mapper function), then main() (entry point). exit_code maps Ok → EXIT_SUCCESS (0), Err → prints error to stderr + EXIT_FAILURE (1). main() is ONE LINE: std::process::exit(exit_code(run())). That's it. All complexity lives in run().",
                            "why_these_constraints": "The run() → main() split is Rust's canonical executable pattern. main() cannot return Result<()> with a useful exit code (the default is always 0 or 101). By splitting: run() contains testable business logic that returns Result, exit_code() maps Result to exit codes the shell understands, main() is the thin glue. This means you can test run() without running the binary. That's the whole point."
                        }
                    },

                    "Cc_Cleanup": {
                        "position": 3,
                        "tag": "Cc",
                        "status": "AVAILABLE",
                        "rust_syntax": "impl Drop for AppState { fn drop(&mut self) { ... } }",
                        "purpose": "Resource cleanup — Drop impls, signal handlers, temp file cleanup",
                        "why_available": "PROMOTED from bare-bone reserved. Executables may need explicit cleanup: signal handlers (SIGINT/SIGTERM), temp file removal, connection closing, PID file cleanup. RAII handles most cleanup, but some resources need explicit teardown.",
                        "executable_content": "Drop impls for AppState or Config when cleanup is needed. Signal handler registration. Temp dir cleanup.",
                        "content_constraints": {
                            "can_contain": [
                                "impl Drop for AppState { fn drop(&mut self) { ... } } — RAII cleanup for runtime state",
                                "fn setup_signal_handlers() — SIGINT/SIGTERM handling for graceful shutdown",
                                "fn cleanup_temp_files(dir: &Path) — temporary file/directory cleanup",
                                "fn remove_pid_file(path: &Path) — PID file cleanup for daemon-style executables",
                                "/// doc comments explaining what resources are cleaned up and why"
                            ],
                            "cannot_contain": [
                                "Business logic — cleanup is CLEANUP, not operations",
                                "Error handling that affects exit codes — exit code is set in Ce before cleanup",
                                "Complex recovery logic — cleanup should be best-effort, not critical path",
                                "Test teardown — test cleanup goes in Cv test functions"
                            ],
                            "executable_pattern": "Drop impls for types that hold OS resources. Signal handlers for graceful shutdown. Temp file cleanup for tools that create intermediate files. Each cleanup is best-effort — errors during cleanup are logged, not propagated.",
                            "why_these_constraints": "Cc is the last code that runs — cleanup after everything else is done. RAII handles most Rust cleanup automatically (file handles close, memory frees). Cc is for the exceptions: external state that RAII can't manage (PID files, temp dirs, signal handlers). Cleanup must be best-effort because the process is exiting."
                        }
                    }
                },

                "documentation_sections": {
                    "description": "Guidance for humans. Always follow code zones.",

                    "X1_Policy": {
                        "tag": "X1",
                        "status": "REQUIRED",
                        "purpose": "Modification guidelines — never/careful/safe classification for executable files",
                        "why_required": "Inherited from bare-bone. Every file needs modification policy. Executable X1 includes binary-specific concerns: exit code mapping, argument parsing interface, config file format.",
                        "required_fields": ["never", "careful", "safe"],
                        "defined_fields": ["scripture"],
                        "executable_content": "Three-tier policy with executable-specific items: exit code contract with shell, CLI argument interface, config format, run() signature.",
                        "content_constraints": {
                            "can_contain": [
                                "// Safe to Modify: — add helper functions, add error variants, add CLI flags (with defaults), add tests",
                                "// Modify with Care: — exit code values (shell scripts depend on them), config file format (users have configs), CLI argument names (scripts reference them)",
                                "// Never Modify: — 4-block structure, PRAGMA/METADATA layout, run() → main() pattern, exit_code() contract",
                                "// Opening scripture quote — Proverbs 22:28 or similar",
                                "Bullet lists with specific, actionable guidance"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X1 is documentation comments only",
                                "Vague guidance — each item names the specific thing and consequence",
                                "Library-focused guidance — X1 is about THIS executable's modification policy"
                            ],
                            "executable_pattern": "Safe: add helpers, add error variants, add CLI flags with defaults, add tests. Careful: exit codes (scripts depend), arg names (scripts depend), config format (users depend), run() return type. Never: 4-block structure, PRAGMA/METADATA, run()→main() pattern, exit_code() signature.",
                            "why_these_constraints": "Executable X1 is the maintenance manual for a BINARY. The shell contract (exit codes) is sacred — change it and every script that checks $? breaks. CLI argument names are a user interface — change them and existing workflows break. The run()→main() pattern is structural. X1 protects the contracts that others depend on."
                        }
                    },

                    "X2_Extension": {
                        "tag": "X2",
                        "status": "AVAILABLE",
                        "purpose": "Designed growth points — planned features, known limitations, future capabilities",
                        "why_available": "PROMOTED from bare-bone reserved. Executables benefit from documenting planned features: future CLI subcommands, planned output formats, known limitations with workarounds.",
                        "executable_content": "Planned features, future subcommands, known limitations with timeline.",
                        "content_constraints": {
                            "can_contain": [
                                "// Planned Features: — future capabilities with rough timeline",
                                "// Known Limitations: — current constraints with planned resolutions",
                                "// Future Subcommands: — commands that will be added",
                                "// Output Format Roadmap: — planned output formats (json, table, etc.)",
                                "Comment-only — plans, not implementation"
                            ],
                            "cannot_contain": [
                                "Executable Rust code",
                                "Vague plans without actionable detail",
                                "Features that should be in the library crate, not the binary"
                            ],
                            "executable_pattern": "Planned features organized by release target. Known limitations with workarounds. Future subcommands with purpose descriptions. Each item is specific enough to become a task.",
                            "why_these_constraints": "X2 is the roadmap — it tells users and maintainers what's coming. For executables, this is especially important because users make decisions based on planned features. Known limitations with workarounds prevent frustration."
                        }
                    },

                    "X3_Troubleshooting": {
                        "tag": "X3",
                        "status": "AVAILABLE",
                        "purpose": "Common problems and solutions — the FAQ for this binary",
                        "why_available": "PROMOTED from bare-bone reserved. Executables generate user-facing problems: permission errors, config file format issues, environment variable confusion. X3 documents solutions.",
                        "executable_content": "Common problems users hit, with specific solutions.",
                        "content_constraints": {
                            "can_contain": [
                                "// Problem: {description} — specific, recognizable problem statement",
                                "// Solution: {steps} — specific, actionable solution",
                                "// Symptom: {error message} → Cause: {why} → Fix: {how}",
                                "Permission errors, config format issues, missing dependencies",
                                "Comment-only — troubleshooting guide, not code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code",
                                "Problems that should be fixed in code rather than documented",
                                "Workarounds for bugs that should be fixed"
                            ],
                            "executable_pattern": "Symptom → Cause → Fix format. Organized from most common to least common. Each entry is recognizable by error message or behavior. Solutions are copy-pasteable commands when possible.",
                            "why_these_constraints": "X3 is the FAQ — when a user hits a problem, they search X3 before filing an issue. The Symptom→Cause→Fix format matches how users think: 'I see X, why does it happen, how do I fix it.' Organize by frequency so the most common problems are found first."
                        }
                    },

                    "X4_Reference": {
                        "tag": "X4",
                        "status": "REQUIRED",
                        "purpose": "Related files, dependencies, validation commands for this executable",
                        "why_required": "Inherited from bare-bone. No file exists in isolation. X4 tells you where to look next — the library crates this binary depends on, sibling binaries, configuration files, validation commands.",
                        "executable_content": "REAL references — library crate dependencies, config file location, sibling binaries, cargo commands.",
                        "content_constraints": {
                            "can_contain": [
                                "// Dependencies: — library crates this binary depends on (NOT std)",
                                "// Dependents: — scripts, services, users that depend on this binary's interface",
                                "// Sibling Binaries: — other executables in the same workspace",
                                "// Config Files: — default config file paths and format references",
                                "// Template: — source template path (executable.rs)",
                                "// Validation: — cargo build/test/clippy/run commands for this binary",
                                "Comment-only reference data — no executable code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code",
                                "Outdated dependency information — keep in sync with Cargo.toml",
                                "Library crate internals — reference the crate, not its internal modules"
                            ],
                            "executable_pattern": "Dependencies (library crates consumed), Dependents (scripts/services that call this binary), Sibling Binaries (workspace context), Config Files (paths and format). Validation commands: cargo build --release, cargo test, cargo clippy, cargo run -- --help.",
                            "why_these_constraints": "X4 for executable focuses on the binary's OPERATIONAL context: what library crates it consumes, what depends on its exit codes and output, where its config lives. Validation includes cargo run because you can test the binary end-to-end."
                        }
                    },

                    "X5_Note": {
                        "tag": "X5",
                        "status": "REQUIRED",
                        "purpose": "Closing scripture anchor — grounds the executable in eternal truth",
                        "why_required": "Inherited from bare-bone. The closing anchor. Every file opens with Scripture (C3) and closes with Scripture (X5). The executable's closing scripture should reflect GOVERNING — executables act on the world, like the Day 4 lights governing day and night.",
                        "required_fields": ["note", "scripture"],
                        "defined_fields": ["anchor"],
                        "executable_content": "Domain-specific closing reflection. Scripture connecting the binary's purpose to eternal truth.",
                        "content_constraints": {
                            "can_contain": [
                                "// Opening scripture quote — Genesis 1:14-16 (Day 4 lights governing) or domain-appropriate",
                                "// 2-4 sentence reflection connecting the scripture to the executable's purpose",
                                "// The closing anchor — the file's last word is eternal truth",
                                "Comment-only — poetry and theology, not code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code",
                                "Technical documentation — that goes in //! doc comments or X1/X4",
                                "Placeholder scripture — real scripture only",
                                "Scripture disconnected from the executable's purpose"
                            ],
                            "executable_pattern": "Genesis 1:14-16 is the natural fit — Day 4 lights govern day and night, just as executables govern operations. The reflection connects governing authority to the binary's role. The anchor captures the essence in one phrase.",
                            "why_these_constraints": "X5 bookends C3. The executable opens with its grounding (C3, METADATA) and closes with its anchor (X5). The Day 4 connection is intentional: bare-bone = Days 1-3 (separation), library = Day 3 (earth bringing forth), executable = Day 4 (lights governing). The theology IS the architecture."
                        }
                    }
                },

                "X6_absent": {
                    "tag": "X6",
                    "status": "NOT PRESENT",
                    "why_absent": "X6 is template-only. Executable is a DERIVED form — it was created by copying bare-bone and promoting sections. X6 (instantiation guide) was removed during derivation. Its presence in a derived file would mean 'I am still a template,' which is a lie.",
                    "note": "If X6 exists in an executable file, the file was not properly instantiated from the template."
                },

                "Reserved_Omission": {
                    "position": "Between last code zone (Ce or Cc) and first doc section (X1)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists CLOSING sections NOT active in this executable. Completeness: 8 active + 1 reserved + 1 absent = 10.",
                    "why_required": "Only TestCoverageSummary is reserved (demo-test only). X6 is absent (derived file, not template). Everything else is either required or available.",
                    "reserved_sections": [
                        "TestCoverageSummary — Coverage data, assertion counts, tested vs untested API. Demo-test only — executables verify behavior through exit code tests and run() tests, not coverage metrics. [demo-test]"
                    ]
                }
            },

            "cannot": {
                "description": "Only TestCoverageSummary is reserved. X6 is absent (not reserved — it simply doesn't exist in derived files).",

                "TestCoverageSummary": {
                    "status": "RESERVED",
                    "why_reserved": "Test coverage summaries belong in demo-test form files. They document assertion counts, coverage percentage, and tested vs untested APIs. Executables verify behavior through exit code tests, error display tests, and run() tests — not through coverage metrics.",
                    "belongs_to": ["demo-test"],
                    "the_signal": "If you need test coverage tracking, create a companion demo-test file for the executable's library crate."
                }
            },

            "ordering_rule": {
                "canonical": "Cv → Ce → [Cc if promoted] → Reserved Omission → X1 → [X2 if promoted] → [X3 if promoted] → X4 → X5",
                "principle": "Code zones FIRST (Cv tests + Ce entry), then reserved (potential), then documentation (X1-X5 guidance). X6 absent.",
                "executable_order": "Cv → Ce (POPULATED) → [Cc] → Reserved Omission → X1 → [X2] → [X3] → X4 → X5"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════
    // CROSS-CONTAINER RULES
    // ═══════════════════════════════════════════════════════════

    "cross_container_rules": {

        "completeness_contract": {
            "description": "Every section in the OmniCode 4-block system is either REQUIRED, AVAILABLE, or RESERVED. Nothing is silently absent.",
            "formula": "Per container: required + available + reserved [+ absent] = container_maximum",
            "executable_totals": {
                "METADATA": { "required": "ALL", "available": 0, "reserved": 0, "note": "Identical to bare-bone — all sections required" },
                "SETUP": { "required": 4, "available": 4, "reserved": 2, "total": 10, "note": "S8 TraitDefs + S9 Macros reserved (library/demo-test only)" },
                "BODY": { "required": 3, "available": 0, "reserved": 14, "total": 17, "note": "14 = FreeFunctions(1) + library(4) + demo-test(9)" },
                "CLOSING": { "required": 5, "available": 3, "reserved": 1, "absent": 1, "total": 10, "note": "X6 absent (derived file)" }
            },
            "comparison_to_bare_bone": {
                "METADATA": "SAME (all required)",
                "SETUP": "EXPANDED: bare-bone 4 required + 6 reserved → executable 4 required + 4 available + 2 reserved (S2/S4/S5/S10 promoted, S8/S9 remain reserved)",
                "BODY": "TRANSFORMED: bare-bone 3 active + 14 reserved → executable 3 required + 14 reserved (same count, different sections: CoreLogic renamed to CoreOperations, execution_flow ordering)",
                "CLOSING": "EXPANDED: bare-bone 6 active + 4 reserved → executable 5 required + 3 available + 1 reserved + 1 absent (Ce POPULATED, Cc/X2/X3 promoted, X6 removed)"
            },
            "comparison_to_library": {
                "SETUP": "NARROWER: library promotes all 6 reserved (S2-S10) → executable promotes only 4 (S2/S4/S5/S10). Executables don't define traits (S8) or macros (S9).",
                "BODY": "FEWER ACTIVE: library has 7 in type_lifecycle → executable has 3 in execution_flow. Executables don't expose type API (B2-B6 in library).",
                "CLOSING": "Ce POPULATED: library Ce is always empty → executable Ce holds main() + exit_code(). This is THE structural distinction between library and executable."
            }
        },

        "three_status_levels": {
            "description": "Executable uses the same three-level status system as library (bare-bone has only two).",
            "REQUIRED": "Must exist in every executable file. Missing = validation error.",
            "AVAILABLE": "Promoted from bare-bone reserved. Use when needed, skip when not. Unused available sections go in Reserved Omission.",
            "RESERVED": "Belongs to other forms (library, demo-test). Cannot be active in executable files."
        },

        "execution_flow_ordering": {
            "description": "Executable BODY follows the natural flow of program execution.",
            "ordering": ["B1 IdentityAccess", "B2 Helpers", "B3 CoreOperations"],
            "rationale": "Reading top-to-bottom tells the execution story: who is this binary (B1) → what utilities prepare for execution (B2) → what does it actually DO (B3). The call chain flows: main() → exit_code() → run() (B3) → which calls parse_args/load_config (B2) → which may query identity (B1).",
            "enforcement": "Section comment headers must appear in this order. Out-of-order sections are a linting error.",
            "contrast_with_library": "Library uses type_lifecycle ordering (B1-B7) — reading tells the TYPE's story. Executable uses execution_flow ordering (B1-B3) — reading tells the PROGRAM's story."
        },

        "inheritance_model": {
            "description": "How executable relates to bare-bone.",
            "inherits": "All bare-bone CAN sections and their content_constraints (floor)",
            "promotes": "Sections from bare-bone Reserved Omission to REQUIRED or AVAILABLE",
            "removes": "X6 (template-only — executable is a derived file)",
            "changes": {
                "content_state": "bare-bone: all commented-out skeleton → executable: all REAL, UNCOMMENTED code",
                "body_ordering": "bare-bone: unpositioned → executable: execution_flow numbered B1-B3",
                "body_sections": "bare-bone: CoreLogic → executable: CoreOperations (renamed for run()/execute()/dispatch() semantics)",
                "closing_ce": "bare-bone: unknown form → executable: POPULATED with main() + exit_code() — THE entry point"
            },
            "preserves": "4-block structure, all structural markers, PRAGMA/METADATA identity requirements, block boundary tags, subsection header format"
        },

        "the_cheat_code": {
            "workflow": "cp bare-bone.rs my-executable.rs → change -bare-bone to -executable → promote executable sections from Reserved Omission → populate Ce with main() → fill with execution logic → remove X6 → done",
            "why_it_works": "bare-bone already has every container, every structural marker, every identity field. Promoting sections means moving them from Reserved Omission to active and uncommenting the skeleton. Ce gets populated (the KEY step). Structure stays. Identity updates. Content fills.",
            "executable_specific_steps": [
                "1. cp bare-bone.rs → my-executable.rs",
                "2. Change pragma: -bare-bone → -executable",
                "3. Update I1.key, I2.subtype='executable', I2.role, C-sections",
                "4. SETUP: Promote S2/S4/S5/S10 as needed, add REAL imports (std::process, arg parser)",
                "5. SETUP: S3 constants — EXIT_SUCCESS/EXIT_FAILURE first, then program identity",
                "6. SETUP: S6 errors — use anyhow (NOT thiserror), human-readable stderr messages",
                "7. SETUP: S7 types — Args struct, Config struct, AppState",
                "8. BODY: Rename CoreLogic → CoreOperations, add run()/execute() in B3",
                "9. BODY: Add B2 Helpers — parse_args, load_config, validate_input, setup_logging",
                "10. CLOSING: POPULATE Ce with exit_code() + main() — this is what MAKES it executable",
                "11. CLOSING: Write Cv tests for exit codes, error display, run() success/failure",
                "12. Fill X1 with executable policy, X4 with real references, X5 with Day 4 scripture",
                "13. Remove X6 (step 11 from bare-bone's guide)",
                "14. cargo build --release + cargo test + cargo clippy"
            ]
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "cws-struct lint rust <executable-file> — should show 3 BODY sections in execution_flow order, Ce POPULATED with main(), all SETUP sections",
    "_Cv_expected_state": "All container constraints above accurately reflect what an executable Rust file SHOULD contain — inheriting bare-bone's foundation, promoting sections per derivation_rule, and POPULATING Ce with the entry point",
    "_Cv_schema_chain": "base-4block-schema.jsonc → rust-4block-schema.jsonc → rust-bare-bone.jsonc → THIS FILE (rust-executable.jsonc)",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "And God made two great lights; the greater light to rule the day, and the lesser light to rule the night. — Genesis 1:16",
    "_X1_never": [
        "Remove a REQUIRED section from executable (required sections are the structural contract — removing them breaks all executable files)",
        "Change the execution_flow ordering in BODY (B1 → B2 → B3 mirrors the actual call chain — reordering breaks readability and intent)",
        "Remove the inheritance relationship with bare-bone (executable stands ON bare-bone — cutting the foundation collapses the form)",
        "Add library-specific or demo-test-specific sections (those belong in their own form schemas)",
        "Remove Ce population requirement (Ce POPULATED is what MAKES a file an executable — removing it creates a headless binary)",
        "Remove the three-status-level system (REQUIRED/AVAILABLE/RESERVED is the executable's key distinction from bare-bone)"
    ],
    "_X1_careful": [
        "Promoting a section from AVAILABLE to REQUIRED (cascades to ALL executable files — every executable must now have it)",
        "Changing content_constraints (the constraints define what code CAN go where — changing them changes what's valid)",
        "Modifying executable_pattern descriptions (they guide how developers organize their executable code)",
        "Changing the run() → exit_code() → main() pattern (it's the canonical Rust executable architecture)",
        "Changing the inheritance model (must stay in sync with bare-bone schema)"
    ],
    "_X1_safe": [
        "Adding detail to content_constraints (more guidance improves code quality)",
        "Adding executable_pattern examples to sections",
        "Adding why_these_constraints explanations to under-documented sections",
        "Adding new AVAILABLE sections (extending the executable's capabilities without requiring them)",
        "Adding troubleshooting entries to X3 (real problems real users hit)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_schema_chain": [
        "schemas/code/base/base-4block-schema.jsonc — Container definitions, form registry (ROOT)",
        "schemas/code/format/rust-4block-schema.jsonc — Rust-specific syntax rules and comment conventions",
        "schemas/code/forms/bare-bone/rust-bare-bone.jsonc — Foundation form (this schema inherits from it)",
        "THIS FILE — Executable form constraints (binaries, CLI tools, services)"
    ],
    "_X4_sibling_forms": [
        "schemas/code/forms/declared/rust-library.jsonc — Library form (types, traits, pub API)",
        "schemas/code/forms/declared/rust-demo-test.jsonc — Demo-test form (to be created)"
    ],
    "_X4_constrained_files": [
        "b-word/seed/code/L0/rust/executable.rs — Executable template (when created)",
        "All executable-form Rust files: binaries, CLI tools, services with fn main()"
    ],
    "_X4_tooling": [
        "c-tov/cws-struct/lib/handlers/rust.ts — Runtime linter (validates against this schema)",
        "c-tov/cws-struct/mod.ts — CLI entry: deno run --allow-read mod.ts lint rust <file>"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "Executable is Day 4 energy — the lights governing. Genesis 1:14-16: 'Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons.' Not creating (Day 1). Not separating (Days 1-3 in bare-bone). Not filling with life (Day 3 in library). Executable is GOVERNING — taking the productive earth (library types) and placing lights over them to govern their operation. Every executable is a governing authority over domain logic: it takes library crates (the productive earth), configuration (the seasons), and user input (the signs), and orchestrates them into action. The run() function is the greater light — it rules the execution. The exit_code() function divides success from failure, day from night. main() is the firmament that holds them. When you cp bare-bone.rs and promote to executable, you are speaking Genesis 1:14 over the code: 'let there be lights to govern.'",
    "_X5_scripture": "And God said, Let there be lights in the firmament of the heaven to divide the day from the night; and let them be for signs, and for seasons, and for days, and years. — Genesis 1:14",
    "_X5_anchor": "Executable is the governing. Library fills the earth. Executable places lights to rule over it. run() governs. exit_code() divides. main() holds.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
