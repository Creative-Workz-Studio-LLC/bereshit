                    },

                    "Cc_Cleanup": {
                        "position": 3,
                        "tag": "Cc",
                        "status": "AVAILABLE (PROMOTED from bare-bone reserved)",
                        "rust_syntax": "impl Drop for TypeName { fn drop(&mut self) { /* cleanup */ } }",
                        "purpose": "Resource deallocation — explicit teardown that RAII can't handle alone",
                        "why_available": "Libraries with resources (file handles, network connections, temp directories, lock files, database connections) need explicit cleanup beyond what Rust's ownership model handles automatically. Not every library has such resources, so Cc is available rather than required.",
                        "content_constraints": {
                            "can_contain": [
                                "impl Drop for {TypeName} { fn drop(&mut self) { ... } } — explicit resource cleanup",
                                "Graceful shutdown sequences (flush buffers, close connections, release locks)",
                                "Cleanup helper functions called by Drop impls",
                                "// Comment explaining WHY this type needs explicit cleanup beyond RAII",
                                "/// doc comments on Drop impl explaining cleanup ordering and guarantees"
                            ],
                            "cannot_contain": [
                                "Business logic in Drop — Drop is cleanup, not operation",
                                "Panicking in Drop — Drop must not panic (double-panic = abort)",
                                "Blocking I/O in Drop without timeout — Drop should complete promptly",
                                "Drop impls for types without resources — if RAII handles it, don't add Drop"
                            ],
                            "library_pattern": "One Drop impl per type that holds resources. Order by cleanup criticality: data integrity first (flush), then connections (close), then temporary artifacts (delete). Each Drop impl gets a comment explaining what resource it manages and what happens if cleanup fails (best-effort, log, ignore).",
                            "why_these_constraints": "Drop impls are the last code that runs for a value. They must be reliable, non-panicking, and focused solely on cleanup. RAII handles most Rust cleanup — Cc exists for the exceptions where ownership transfer alone isn't sufficient (external resources, lock files, temp directories)."
                        }
                    }
                },

                "documentation_sections": {
                    "description": "Guidance for humans. Always follow code zones.",

                    "X1_Policy": {
                        "tag": "X1",
                        "status": "REQUIRED",
                        "inherits_constraints": "bare-bone X1_Policy content_constraints (updated for library context)",
                        "library_difference": "Library X1 reflects REAL API contracts — pub function signatures, trait contracts, error type shape, semver implications. Not bare-bone's skeleton guidance but production modification policy.",
                        "content_constraints": {
                            "can_contain": [
                                "// Safe to Modify: — additive changes (new pub fns, new error variants, new trait impls, new tests, internal refactoring)",
                                "// Modify with Care: — interface-affecting changes (struct fields, method signatures, error type variants, return types, trait method signatures)",
                                "// Never Modify: — structural invariants (4-block structure, PRAGMA/METADATA layout, block boundaries, pub trait contracts already in use by consumers)",
                                "// Opening scripture quote — Proverbs 22:28 or similar",
                                "// Semver implications: Safe = patch, Careful = minor, Never = major (breaking)",
                                "Bullet lists with specific items and consequence explanations"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X1 is documentation comments only",
                                "Vague guidance — each item must name the specific thing and the consequence of changing it",
                                "Policy contradicting the block structure or schema constraints"
                            ],
                            "library_pattern": "Three-tier with semver alignment: Safe (patch-level: add functions, add variants, add tests), Careful (minor-level: new fields with defaults, deprecations, signature changes with compatibility), Never (major-level: remove pub items, change pub trait contracts, alter error type shape). This makes version decisions mechanical.",
                            "why_these_constraints": "Library X1 is an API stability contract. Consumers depend on these interfaces. The three-tier + semver mapping means any modification has a clear version implication. This protects consumers and makes release decisions straightforward."
                        }
                    },

                    "X2_Extension": {
                        "tag": "X2",
                        "status": "AVAILABLE (PROMOTED from bare-bone reserved)",
                        "purpose": "Designed growth points — where the library SHOULD grow",
                        "why_available": "Mature libraries have a roadmap. X2 documents planned features, known limitations that will be addressed, and designed extension points. Not every library has clear growth plans yet, so X2 is available rather than required.",
                        "content_constraints": {
                            "can_contain": [
                                "// Planned Features: — features on the roadmap with brief descriptions",
                                "// Extension Points: — designed interfaces where consumers can extend behavior",
                                "// Known Limitations: — current limitations with planned resolution",
                                "// Version Targets: — which version is expected to address each item",
                                "Comment-only — roadmap documentation, not executable code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X2 is documentation comments only",
                                "Wishful thinking without concrete plans — each item should be actionable",
                                "Features that contradict X1 Never items — don't plan to break your own contracts",
                                "Stale items never updated — X2 must stay current with actual development"
                            ],
                            "library_pattern": "Group by timeline: (1) next release (concrete, scoped), (2) near-term (planned, designed), (3) long-term (directional, aspirational). Each item gets a one-line description. Extension points describe the interface pattern (trait to implement, callback to provide, etc.).",
                            "why_these_constraints": "X2 serves consumers AND contributors. Consumers learn what's coming (so they don't build workarounds for features in progress). Contributors learn where to focus effort. Stale X2 is worse than no X2 — it creates false expectations."
                        }
                    },

                    "X3_Troubleshooting": {
                        "tag": "X3",
                        "status": "AVAILABLE (PROMOTED from bare-bone reserved)",
                        "purpose": "Common problems and solutions — known issues with documented fixes",
                        "why_available": "Libraries with real consumers encounter real problems. X3 documents the issues that come up repeatedly so developers don't rediscover the same solutions. Not every library has enough usage to generate known issues, so X3 is available rather than required.",
                        "content_constraints": {
                            "can_contain": [
                                "// Problem: {description} → Solution: {fix} — issue/resolution pairs",
                                "// Common Mistake: {what people do wrong} → Correct: {what to do instead}",
                                "// Platform-specific: {OS/arch issue} → Workaround: {fix}",
                                "// Compilation Issues: {build error} → Fix: {resolution}",
                                "Comment-only — troubleshooting documentation, not executable code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X3 is documentation comments only",
                                "Known bugs without workarounds — file an issue instead; X3 has SOLUTIONS",
                                "Issues caused by consumer misuse of the API — that's documentation, not troubleshooting",
                                "Obsolete issues from old versions — keep X3 current"
                            ],
                            "library_pattern": "Organize by category: (1) compilation/build issues, (2) runtime behavior, (3) platform-specific, (4) common mistakes. Each entry: Problem → Cause → Solution. Brevity matters — this is a quick reference, not a tutorial.",
                            "why_these_constraints": "X3 is the 'FAQ for developers.' Every entry saves someone 30 minutes of debugging. The Problem → Cause → Solution format is fast to scan. Entries without solutions are just complaints — X3 is about ANSWERS."
                        }
                    },

                    "X4_Reference": {
                        "tag": "X4",
                        "status": "REQUIRED",
                        "inherits_constraints": "bare-bone X4_Reference content_constraints (updated for library context)",
                        "library_difference": "X4 references are REAL — actual crate dependencies, actual consumers, actual validation commands. Not bare-bone placeholders but production navigation data.",
                        "content_constraints": {
                            "can_contain": [
                                "// Dependencies: — real std modules and external crates used",
                                "// Dependents: — real crates that depend on this one",
                                "// Supersedes: — actual prior implementation path (if applicable)",
                                "// Parallel: — Go/C implementations of the same concept",
                                "// Template: — bare-bone.rs (source template)",
                                "// Schema: — form schema path (this file's constraints)",
                                "// Validation: — cargo build/test/clippy/doc commands for THIS crate",
                                "Comment-only reference data — no executable code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X4 is documentation comments only",
                                "Placeholder values ('TBD', '[fill in]') — library X4 must have real data",
                                "Validation commands for other crates — only THIS crate",
                                "Outdated dependency information — must match Cargo.toml"
                            ],
                            "library_pattern": "All 6 reference categories filled with real values. Validation section includes the exact cargo commands: build, test, clippy, doc, and all-in-one. Add cws-struct lint command if applicable.",
                            "why_these_constraints": "Library X4 is the production navigation map. Every reference must be real and current. A developer opening this file should be able to: find upstream deps (Dependencies), find downstream consumers (Dependents), find parallel implementations (Parallel), and validate the code (Validation) — all from X4."
                        }
                    },

                    "X5_Note": {
                        "tag": "X5",
                        "status": "REQUIRED",
                        "inherits_constraints": "bare-bone X5_Note content_constraints (updated for library context)",
                        "library_difference": "X5 scripture is domain-specific to this library's purpose — not bare-bone's generic Psalm 127:1 but a verse that GROUNDS this specific library's work. The reflection connects the library's domain to eternal truth.",
                        "content_constraints": {
                            "can_contain": [
                                "// Opening scripture quote — domain-appropriate verse grounding this library's work",
                                "// 2-4 sentence reflection connecting the scripture to this library's specific purpose",
                                "// The closing anchor — the library's last word is eternal truth",
                                "Comment-only — poetry and theology, not code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X5 is the closing meditation",
                                "Placeholder scripture — every library must have a REAL, CHOSEN verse",
                                "Generic scripture disconnected from the library's domain — the verse should illuminate the work",
                                "Technical documentation — that goes in //! doc comments or X1/X4"
                            ],
                            "library_pattern": "Choose a verse that illuminates THIS library's domain. A config loader might use Psalm 139 (God knows every path). A database crate might use Ecclesiastes 3:1 (a time for everything). An identity crate might use Genesis 1:1 (the beginning of beginnings). The reflection connects the domain to the eternal principle.",
                            "why_these_constraints": "X5 bookends C3 — the file opens with Scripture (grounding) and closes with Scripture (anchor). Library X5 is personal to the library's purpose, not generic. A verse chosen FOR this specific work has more weight than a default. Quality as worship. The code will change; the truth won't."
                        }
                    }
                },

                "Reserved_Omission": {
                    "position": "Between code zones (Cv/Ce/Cc) and documentation sections (X1-X5)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists CLOSING sections NOT active in this library file",
                    "why_required": "Completeness contract. active + available_unused + reserved = full CLOSING set.",
                    "library_content": [
                        "TestCoverageSummary — Coverage data, assertions summary [demo-test only]",
                        "X6 — Template Guide [NOT APPLICABLE — library is a derived file, not a template]",
                        "Any of Cc, X2, X3 that are not used in THIS specific library file"
                    ],
                    "note": "Unlike bare-bone where 4 sections are always reserved, library's Reserved Omission varies per file. A library with Drop impls uses Cc; one without doesn't. The AVAILABLE sections (Cc, X2, X3) go here when unused."
                }
            },

            "cannot": {
                "description": "These sections CANNOT be active in library form.",

                "TestCoverageSummary": {
                    "status": "RESERVED",
                    "why_reserved": "Coverage summaries belong in demo-test form files. Library test coverage is tracked by tooling (cargo tarpaulin, etc.), not by inline documentation.",
                    "promoted_by": "demo-test form only"
                },

                "X6_Template": {
                    "tag": "X6",
                    "status": "NOT APPLICABLE",
                    "why_absent": "X6 is template-only. Library is a derived file — it was CREATED from bare-bone by following X6's instructions and then REMOVING X6 (step 11 of the instantiation guide). X6's presence in a library file would mean 'I am still a template, not a real file' — which is false."
                }
            },

            "ordering_rule": {
                "canonical": "Cv → Ce → [Cc if used] → Reserved Omission → X1 → [X2 if used] → [X3 if used] → X4 → X5",
                "principle": "Code zones FIRST (they prove the work), then reserved (they mark potential), then documentation (they guide maintenance). X6 absent.",
                "library_minimum": "Cv → Ce (empty) → Reserved Omission → X1 → X4 → X5",
                "library_full": "Cv → Ce (empty) → Cc → Reserved Omission → X1 → X2 → X3 → X4 → X5"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════
    // CROSS-CONTAINER RULES
    // ═══════════════════════════════════════════════════════════

    "cross_container_rules": {

        "completeness_contract": {
            "description": "Every section in the OmniCode 4-block system is either REQUIRED, AVAILABLE, or RESERVED. Nothing is silently absent.",
            "formula": "Per container: required + available_active + available_unused + reserved = container_maximum",
            "library_totals": {
                "METADATA": { "required": "ALL", "available": 0, "reserved": 0, "note": "Identical to bare-bone — all sections required" },
                "SETUP": { "required": 5, "available": 5, "reserved": 0, "total": 10, "note": "All 10 sections accessible — 5 required, 5 available" },
                "BODY": { "required": 7, "available": 0, "reserved": 10, "total": 17, "note": "10 reserved = 1 executable + 9 demo-test" },
                "CLOSING": { "required": 5, "available": 3, "reserved": 2, "total": 10, "note": "2 reserved = TestCoverageSummary + X6" }
            },
            "comparison_to_bare_bone": {
                "METADATA": "SAME (all required)",
                "SETUP": "EXPANDED: bare-bone 4 required + 6 reserved → library 5 required + 5 available (S2 promoted, all accessible)",
                "BODY": "EXPANDED: bare-bone 3 active + 14 reserved → library 7 required + 10 reserved (4 sections promoted)",
                "CLOSING": "EXPANDED: bare-bone 6 active + 4 reserved → library 5 required + 3 available + 2 reserved (X6 removed, Cc/X2/X3 promoted)"
            }
        },

        "three_status_levels": {
            "description": "Library introduces a three-level status system (bare-bone has only two).",
            "REQUIRED": "Must exist in every library file. Missing = validation error.",
            "AVAILABLE": "Promoted from bare-bone reserved. Use when needed, skip when not. Unused available sections go in Reserved Omission.",
            "RESERVED": "Belongs to other forms (executable, demo-test). Cannot be active in library files."
        },

        "type_lifecycle_ordering": {
            "description": "Library BODY follows the natural lifecycle of a Rust type.",
            "ordering": ["B1 IdentityAccess", "B2 TraitImplementations", "B3 Constructors", "B4 CoreLogic", "B5 Queries", "B6 Output", "B7 FreeFunctions"],
            "rationale": "Reading top-to-bottom tells the story: who is this file (B1) → what contracts does it honor (B2) → how do you create instances (B3) → what do they DO (B4) → what can you observe (B5) → how do you display them (B6) → what module-level utilities exist (B7).",
            "enforcement": "Section comment headers must appear in this order. Out-of-order sections are a linting error."
        },

        "inheritance_model": {
            "description": "How library relates to bare-bone.",
            "inherits": "All bare-bone CAN sections and their content_constraints (floor)",
            "promotes": "Sections from bare-bone Reserved Omission to REQUIRED or AVAILABLE",
            "removes": "X6 (template-only — library is a derived file)",
            "changes": {
                "content_state": "bare-bone: all commented-out skeleton → library: all REAL, UNCOMMENTED code",
                "body_ordering": "bare-bone: unpositioned → library: type_lifecycle numbered B1-B7",
                "closing_ce": "bare-bone: unknown form → library: always empty (no entry point)"
            },
            "preserves": "4-block structure, all structural markers, PRAGMA/METADATA identity requirements, block boundary tags, subsection header format"
        },

        "the_cheat_code": {
            "workflow": "cp bare-bone.rs my-library.rs → change -bare-bone to -library → promote library sections from Reserved Omission → uncomment skeleton code → fill with domain logic → remove X6 → done",
            "why_it_works": "bare-bone already has every container, every structural marker, every identity field. Promoting sections means moving them from Reserved Omission to active and uncommenting the skeleton. Structure stays. Identity updates. Content fills.",
            "library_specific_steps": [
                "1. cp bare-bone.rs → my-library.rs",
                "2. Change pragma: -bare-bone → -library",
                "3. Update I1.key, I2.subtype='library', I2.role, C-sections",
                "4. SETUP: Promote S2 to required, add S4/S5/S8/S9/S10 as needed",
                "5. BODY: Add B2 TraitImplementations, B3 Constructors, B5 Queries, B6 Output in type_lifecycle order",
                "6. Uncomment all skeleton code, fill with real domain logic",
                "7. Write real tests in Cv organized by BODY section",
                "8. Fill X1 with real policy, X4 with real references, X5 with domain scripture",
                "9. Remove X6 (step 11 from bare-bone's guide)",
                "10. cargo clippy + cargo test"
            ]
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "cws-struct lint rust <library-file> — should show 7 BODY sections in type_lifecycle order, all SETUP sections, comprehensive Cv tests",
    "_Cv_expected_state": "All container constraints above accurately reflect what a library Rust file SHOULD contain — inheriting bare-bone's foundation and promoting sections per the derivation_rule in form_identity",
    "_Cv_schema_chain": "base-4block-schema.jsonc → rust-4block-schema.jsonc → rust-bare-bone.jsonc → THIS FILE (rust-library.jsonc)",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "And God said, Let the earth bring forth grass, the herb yielding seed, and the fruit tree yielding fruit after his kind. — Genesis 1:11",
    "_X1_never": [
        "Remove a REQUIRED section from library (required sections are the structural contract — removing them breaks all library files)",
        "Change the type_lifecycle ordering in BODY (the ordering IS the architecture — B1 through B7 in that sequence)",
        "Remove the inheritance relationship with bare-bone (library stands ON bare-bone — cutting the foundation collapses the form)",
        "Add executable-specific or demo-test-specific sections (those belong in their own form schemas)",
        "Remove the three-status-level system (REQUIRED/AVAILABLE/RESERVED is the library's key distinction from bare-bone)"
    ],
    "_X1_careful": [
        "Promoting a section from AVAILABLE to REQUIRED (cascades to ALL library files — every library must now have it)",
        "Changing content_constraints (the constraints define what code CAN go where — changing them changes what's valid)",
        "Modifying library_pattern descriptions (they guide how developers organize their library code)",
        "Changing the inheritance model (must stay in sync with bare-bone schema)"
    ],
    "_X1_safe": [
        "Adding detail to content_constraints (more guidance improves code quality)",
        "Adding library_pattern examples to sections",
        "Adding why_these_constraints explanations to under-documented sections",
        "Adding new AVAILABLE sections (extending the library's capabilities without requiring them)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_schema_chain": [
        "schemas/code/base/base-4block-schema.jsonc — Container definitions, form registry (ROOT)",
        "schemas/code/format/rust-4block-schema.jsonc — Rust-specific syntax rules and comment conventions",
        "schemas/code/forms/bare-bone/rust-bare-bone.jsonc — Foundation form (this schema inherits from it)",
        "THIS FILE — Library form constraints (most common declared form)"
    ],
    "_X4_sibling_forms": [
        "schemas/code/forms/declared/rust-executable.jsonc — Executable form (to be created)",
        "schemas/code/forms/declared/rust-demo-test.jsonc — Demo-test form (to be created)"
    ],
    "_X4_constrained_files": [
        "b-word/seed/code/L0/rust/library.rs — Library template (when created)",
        "All library-form Rust files: spec/config/src/*.rs, spec/database/src/*.rs, b-spiral/identity/src/*.rs"
    ],
    "_X4_tooling": [
        "c-tov/cws-struct/lib/handlers/rust.ts — Runtime linter (validates against this schema)",
        "c-tov/cws-struct/mod.ts — CLI entry: deno run --allow-read mod.ts lint rust <file>"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "Library is Day 3 energy — the earth bringing forth. Genesis 1:11: 'Let the earth bring forth.' Not creating from nothing (that was Day 1). Not separating (that was Days 1-3 in bare-bone). Library is the first FILLING — taking the separated, bounded earth (bare-bone) and causing it to produce. Types grow from declarations. Traits root behaviors. Constructors bear fruit. The library doesn't create the ground — bare-bone did that. The library makes the ground productive. Every pub fn is a seed yielding after its kind. The type_lifecycle ordering mirrors growth: identity (seed) → traits (roots) → constructors (germination) → logic (growth) → queries (observation) → output (fruit) → free functions (scattered seeds). When you cp bare-bone.rs and promote to library, you are speaking Genesis 1:11 over the code: 'bring forth.'",
    "_X5_scripture": "And God said, Let the earth bring forth grass, the herb yielding seed, and the fruit tree yielding fruit after his kind, whose seed is in itself, upon the earth: and it was so. — Genesis 1:11",
    "_X5_anchor": "Library is the filling. bare-bone bounded the earth. Library makes it bring forth. Fruit after its kind.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
