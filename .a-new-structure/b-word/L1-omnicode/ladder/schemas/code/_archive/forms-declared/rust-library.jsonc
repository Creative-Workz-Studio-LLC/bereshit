        // Ordering: Cv → Ce → [Cc] → Reserved → X1 → [X2] → [X3] → X4 → X5

        "CLOSING": {
            "summary": "5 required + 3 available + Reserved Omission. Tests, policy, references, closing anchor. Cc/X2/X3 promoted from bare-bone reserved. X6 absent (library is not a template).",
            "reserved_omission": true,
            "inherits_from": "bare-bone CLOSING (Cv, Ce, X1, X4, X5 — content is library-specific, not bare-bone skeleton)",

            "why": "CLOSING proves the code works and guides maintainers. Library inherits bare-bone's 5 core CLOSING sections (Cv tests, Ce entry, X1 policy, X4 reference, X5 anchor) and PROMOTES 3 more to AVAILABLE: Cc (libraries with file handles, connections, or temp resources need explicit cleanup), X2 (mature libraries have designed growth points consumers should know about), X3 (libraries with known edge cases need documented solutions). X6 is NOT PRESENT because library is a derived file — X6 only exists in templates. TestCoverageSummary remains reserved (demo-test only).",

            "how": {
                "working_with_constraints": "Write comprehensive tests in Cv organized by BODY section. Leave Ce empty (libraries have no entry point). Write library-specific policy in X1 (pub API contract stability, semver implications). Fill X4 with real dependencies and consumers. Close with domain-appropriate Scripture in X5. Add Cc/X2/X3 when needed.",
                "content_is_real": "Library CLOSING content is REAL and domain-specific. Tests verify actual behavior, not skeleton stubs. Policy reflects actual API contracts. References point to real crates, not placeholders."
            },

            "can": {
                "code_zones": {
                    "description": "Actual executable Rust code. Always precede documentation sections.",

                    "Cv_Validation": {
                        "position": 1,
                        "tag": "Cv",
                        "status": "REQUIRED",
                        "inherits_constraints": "bare-bone Cv_Validation content_constraints (updated for library context)",
                        "library_difference": "Tests are REAL, organized by BODY section (B1-B7). White-box tests with use super::*. Comprehensive coverage — not 2-3 skeleton stubs but full behavioral verification.",
                        "content_constraints": {
                            "can_contain": [
                                "#[cfg(test)] mod tests { use super::*; ... } — exactly one test module",
                                "#[test] fn test_name() { ... } — individual test functions (REAL tests, not stubs)",
                                "use super::*; — white-box access to all private items",
                                "// -- B1 Identity Access ---- organized by BODY section",
                                "// -- B2 Trait Implementations ----",
                                "// -- B3 Constructors ----",
                                "// -- B4 Core Logic ----",
                                "// -- B5 Queries ----",
                                "// -- B6 Output ----",
                                "// -- B7 Free Functions ----",
                                "assert!(), assert_eq!(), assert_ne!() — standard assertion macros",
                                "assert!(matches!(val, Pattern)) — pattern matching assertions",
                                "#[should_panic(expected = \"msg\")] — panic verification",
                                "fn test_name() -> Result<(), ErrorType> — fallible tests with ?",
                                "Test helpers (private functions within mod tests) for common setup/teardown",
                                "use tempfile::TempDir; — when tests need filesystem isolation"
                            ],
                            "cannot_contain": [
