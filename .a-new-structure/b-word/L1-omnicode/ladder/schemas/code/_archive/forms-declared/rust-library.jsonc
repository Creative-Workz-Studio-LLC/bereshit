        // ═══════════════════════════════════════════════════════
        // 3. BODY CONTAINER — 7 required + Reserved Omission
        // ═══════════════════════════════════════════════════════
        //
        // Library BODY follows TYPE LIFECYCLE ordering:
        //   Identity → Traits → Constructors → CoreLogic →
        //   Queries → Output → FreeFunctions
        //
        // 3 inherited from bare-bone (IdentityAccess, CoreLogic,
        // FreeFunctions) + 4 PROMOTED (TraitImplementations,
        // Constructors, Queries, Output).
        //
        // Content is REAL (not commented-out like bare-bone).

        "BODY": {
            "summary": "7 required subsections + Reserved Omission. Type lifecycle ordering — from identity through full lifecycle to free functions.",
            "reserved_omission": true,
            "inherits_from": "bare-bone BODY (IdentityAccess, CoreLogic, FreeFunctions — content is REAL not commented-out)",

            "why": "Library BODY follows the type lifecycle — the natural progression of how types LIVE in a crate. First you access identity (who is this file?). Then you implement traits (what contracts does it honor?). Then you construct instances (how do you create them?). Then you operate on them (what do they DO?). Then you query them (what can you observe?). Then you format output (how do you display them?). Finally, free functions provide module-level API. This ordering means reading top-to-bottom tells the story of a type's life from birth to representation.",

            "how": {
                "working_with_constraints": "Follow type_lifecycle ordering strictly. If you find yourself writing a constructor in CoreLogic — move it to Constructors. If a Display impl is in CoreLogic — move it to Output. The ordering IS the architecture. Trust it.",
                "content_is_real": "Unlike bare-bone where all content is commented-out skeleton, library content is REAL, UNCOMMENTED Rust code. The constraint patterns still apply — but the code is live and domain-specific.",
                "ordering_rationale": "type_lifecycle ordering serves reading comprehension: a new developer reads Identity → Traits → Constructors → CoreLogic → Queries → Output → Free and understands the full type from creation to representation. This is NOT arbitrary — it mirrors the natural lifecycle of a Rust type."
            },

            "can": {
                "B1_IdentityAccess": {
                    "position": 1,
                    "tag": "IdentityAccess",
                    "status": "REQUIRED (inherited from bare-bone)",
                    "inherits_constraints": "bare-bone B_IdentityAccess content_constraints (same rules apply)",
                    "library_difference": "Accessor functions are REAL, UNCOMMENTED code. Doc comment examples reference this library's actual PRAGMA keys.",
                    "content_constraints": {
                        "can_contain": [
                            "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA } — full slice accessor (REAL code)",
                            "pub fn pragma_get(key: &str) -> Option<&'static str> — key lookup via iter().find() (REAL code)",
                            "pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA } — full slice accessor (REAL code)",
                            "pub fn metadata_get(key: &str) -> Option<&'static str> — key lookup via iter().find() (REAL code)",
                            "/// doc comments with domain-specific usage examples referencing this library's actual keys"
                        ],
                        "cannot_contain": [
                            "Functions that modify identity — PRAGMA/METADATA are immutable statics",
                            "Functions that compute derived values from identity — keep accessors pure (read-only)",
                            "Any function not related to PRAGMA/METADATA access — other functions go in CoreLogic or FreeFunctions",
                            "Caching or memoization — the statics are already compile-time; nothing to cache"
                        ],
                        "library_pattern": "IDENTICAL implementation to bare-bone but UNCOMMENTED. The 4 accessor functions are universal — copy exactly from bare-bone, uncomment, update doc examples to reference this library's actual keys.",
                        "why_these_constraints": "Same as bare-bone — IdentityAccess is the bridge between compile-time identity and runtime code. Library difference: the code is live, not commented-out skeleton."
                    }
                },

                "B2_TraitImplementations": {
                    "position": 2,
                    "tag": "TraitImplementations",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "impl TraitName for TypeName { fn method(&self) -> Type { ... } }",
                    "purpose": "Behavioral implementations — making SETUP types honor contracts",
                    "why_required": "Libraries define behavior through traits. After defining types (SETUP S7) and traits (SETUP S8), you implement those traits on those types HERE. This is the connection between WHAT (types) and HOW (behavior). Without trait implementations, types are inert data structures.",
                    "content_constraints": {
                        "can_contain": [
                            "impl {TraitName} for {TypeName} { ... } — trait implementation blocks",
                            "impl fmt::Display for {TypeName} — display formatting (ALSO valid in B6 Output if complex)",
                            "impl From<{Source}> for {TypeName} — type conversion implementations",
                            "impl TryFrom<{Source}> for {TypeName} — fallible conversions",
                            "impl Default for {TypeName} — default construction (when not in S7 directly)",
                            "impl Iterator, IntoIterator, etc. — standard library trait impls",
                            "impl crate-defined traits — honoring contracts from S8 TraitDefs",
                            "/// doc comments explaining why this type implements this trait"
                        ],
                        "cannot_contain": [
                            "Trait DEFINITIONS (pub trait ...) — those are SETUP S8 TraitDefs",
                            "Constructors (new(), build()) — those are B3 Constructors & Builders",
                            "Business logic methods (impl Type { ... } without a trait) — those are B4 CoreLogic",
                            "Test-only trait impls — those go in #[cfg(test)] within Cv",
                            "Orphan implementations (trait and type both from external crates)"
                        ],
                        "library_pattern": "Group implementations by TYPE, not by TRAIT. All impls for TypeA together, then all impls for TypeB. Within each type, order by: std traits first (Display, From, Default), then crate-specific traits. Each impl block gets a comment header naming the trait and explaining the behavioral contract.",
                        "why_these_constraints": "Trait implementations are the connection between structure (types) and behavior (contracts). Grouping by type means you see ALL of a type's behaviors in one place. Ordering std traits first provides predictable structure — Display and From are the most commonly read."
                    }
                },

                "B3_Constructors": {
                    "position": 3,
                    "tag": "Constructors & Builders",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": [
                        "impl TypeName { pub fn new(args) -> Self { ... } }",
                        "impl TypeName { pub fn from_config(config: &Config) -> Result<Self, Error> { ... } }",
                        "impl TypeNameBuilder { pub fn build(self) -> Result<TypeName, Error> { ... } }"
                    ],
                    "purpose": "Type creation — how instances come into existence",
                    "why_required": "Libraries create instances. new(), builders, and factory functions are the birth of every value. Separating construction from operation (CoreLogic) makes both clearer — you can see ALL the ways to create a type without wading through its methods.",
                    "content_constraints": {
                        "can_contain": [
                            "impl {TypeName} { pub fn new(...) -> Self } — infallible construction (when valid by construction)",
                            "impl {TypeName} { pub fn try_new(...) -> Result<Self, Error> } — fallible construction with validation",
                            "impl {TypeName} { pub fn from_{source}(...) -> Result<Self, Error> } — named constructors from specific sources",
                            "pub struct {TypeName}Builder { ... } — builder type definition",
                            "impl {TypeName}Builder { pub fn new() -> Self } — builder constructor",
                            "impl {TypeName}Builder { pub fn field(mut self, val) -> Self } — builder methods (method chaining)",
                            "impl {TypeName}Builder { pub fn build(self) -> Result<{TypeName}, Error> } — builder finalization",
                            "Factory functions: pub fn create_{variant}() -> TypeName — convenience constructors",
                            "/// doc comments: what each constructor validates, when to use which one, examples"
                        ],
                        "cannot_contain": [
                            "Simple new() that just assigns fields with no validation — that stays in SETUP S7 (it's declaration, not logic)",
                            "Methods that operate on existing instances (&self, &mut self) — those are B4 CoreLogic",
                            "Query methods (&self → read-only observation) — those are B5 Queries & Accessors",
                            "Constructors for test fixtures — those go in #[cfg(test)] test_utils or Cv"
                        ],
                        "library_pattern": "Order by construction complexity: (1) infallible new() or Default, (2) fallible try_new() with validation, (3) named from_* constructors for specific sources, (4) builder pattern for complex multi-step construction. Each constructor's doc comment explains WHEN to use it over the others.",
                        "why_these_constraints": "Constructors are the BIRTH of a type — they deserve their own section because construction is a distinct concern from operation. A library consumer's first question is 'how do I create one of these?' — B3 answers that question without mixing in operational methods."
                    }
                },

                "B4_CoreLogic": {
                    "position": 4,
                    "tag": "CoreLogic",
                    "status": "REQUIRED (inherited from bare-bone, repositioned)",
                    "inherits_constraints": "bare-bone B_CoreLogic content_constraints (updated for library context)",
                    "library_difference": "CoreLogic is now position 4 (was unpositioned in bare-bone). It contains REAL domain logic operating on REAL types. The 'cannot' list expands because library has dedicated sections for what bare-bone lumped into CoreLogic.",
                    "content_constraints": {
                        "can_contain": [
                            "impl {TypeName} { ... } — method implementations for primary operations",
                            "pub fn method(&mut self, ...) -> Result<(), Error> — mutation operations returning S6 error type",
                            "pub fn method(&self, ...) -> Result<T, Error> — fallible operations",
                            "fn helper(&self, ...) -> ... — private helper methods (near the pub fns that call them)",
                            "State machine transitions, data processing, validation logic",
                            "/// doc comments on every public method: what it does, errors it returns, examples"
                        ],
                        "cannot_contain": [
                            "Type definitions — SETUP S7",
                            "Trait definitions — SETUP S8",
                            "Trait implementations — B2 TraitImplementations",
                            "Constructors (new, try_new, from_*, builders) — B3 Constructors",
                            "Pure read-only queries (&self → T with no mutation or side effects) — B5 Queries",
                            "Display/formatting implementations — B6 Output",
                            "Free-standing functions — B7 FreeFunctions",
                            "Test code — CLOSING Cv"
                        ],
                        "library_pattern": "Group impl blocks by type. Within each type: primary operations first, then transformations, then state transitions. Each pub fn that returns Result should document all error variants it can return. Private helpers live directly above the pub fn that calls them.",
                        "why_these_constraints": "CoreLogic is the VERBS — what the type DOES. In library form, it's narrower than in bare-bone because construction (B3), queries (B5), and output (B6) each have their own sections. This narrowing makes CoreLogic more focused: it contains ONLY the operations that mutate state, transform data, or perform the library's primary work."
                    }
                },

                "B5_Queries": {
                    "position": 5,
                    "tag": "Queries & Accessors",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": [
                        "impl TypeName { pub fn field(&self) -> &FieldType { &self.field } }",
                        "impl TypeName { pub fn is_valid(&self) -> bool { ... } }",
                        "impl TypeName { pub fn count(&self) -> usize { self.items.len() } }"
                    ],
                    "purpose": "Read-only observation — pure &self methods that reveal state without changing it",
                    "why_required": "Libraries expose state for consumers to observe. Queries are the ADJECTIVES — they describe what IS without changing it. Separating queries from mutations (CoreLogic) makes the API contract crystal clear: 'these methods only look, those methods change things.'",
                    "content_constraints": {
                        "can_contain": [
                            "pub fn field(&self) -> &FieldType { &self.field } — field accessors (getters)",
                            "pub fn is_something(&self) -> bool { ... } — boolean state checks",
                            "pub fn count(&self) -> usize { ... } — computed scalar values from state",
                            "pub fn get_something(&self, key: &K) -> Option<&V> { ... } — lookup operations",
                            "pub fn iter(&self) -> impl Iterator<Item = &T> { ... } — iteration over internal collections",
                            "pub fn contains(&self, item: &T) -> bool { ... } — containment checks",
                            "/// doc comments: what the query reveals, O(n) complexity if non-trivial"
                        ],
                        "cannot_contain": [
                            "Methods taking &mut self — if it mutates, it's CoreLogic (B4), not a query",
                            "Methods with side effects (file I/O, network, logging) — queries are pure observation",
                            "Methods returning Result where the error is operational — queries that can fail are CoreLogic",
                            "Constructors — B3",
                            "Display/formatting — B6"
                        ],
                        "library_pattern": "Group queries by concern: (1) field accessors (direct state exposure), (2) computed properties (derived from state), (3) collection queries (iteration, containment, counting). Each query's doc comment explains what aspect of state it reveals.",
                        "why_these_constraints": "Queries are the read-only API. Separating them from mutations gives consumers confidence: 'calling any B5 method is always safe — it won't change anything.' This is the Command-Query Separation principle applied to section organization. In a code review, you can audit all mutations (B4) without reading B5."
                    }
                },

                "B6_Output": {
                    "position": 6,
                    "tag": "Output & Display",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": [
                        "impl fmt::Display for TypeName { fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { ... } }",
                        "impl TypeName { pub fn to_json(&self) -> Result<String, Error> { ... } }"
                    ],
                    "purpose": "Human and machine representation — how types become visible",
                    "why_required": "Libraries need to present their types to the world. Display for humans, serialization for machines, formatting for logs. Output is the LAST thing a type does before leaving the library — it becomes a String, JSON, bytes, or formatted text.",
                    "content_constraints": {
                        "can_contain": [
                            "impl fmt::Display for {TypeName} — human-readable formatting",
                            "impl fmt::Debug for {TypeName} — debug formatting (when custom Debug needed beyond #[derive(Debug)])",
                            "pub fn to_json(&self) -> Result<String, Error> — JSON serialization",
                            "pub fn to_toml(&self) -> Result<String, Error> — TOML serialization",
                            "pub fn write_to(&self, writer: &mut impl Write) -> io::Result<()> — streaming output",
                            "pub fn summary(&self) -> String — concise human-readable summary",
                            "Formatting helper functions (private) that serve Display/serialization",
                            "/// doc comments: format specification, output examples"
                        ],
                        "cannot_contain": [
                            "Parsing (from_str, from_json) — those are B3 Constructors (from_* pattern)",
                            "State mutation during formatting — Display must be &self (immutable observation)",
                            "Business logic that happens to produce output — if the logic is the point, it's CoreLogic (B4)",
                            "Test-only formatting — those go in Cv test assertions"
                        ],
                        "library_pattern": "Order by audience: (1) Display (human-readable, the most common), (2) Debug (developer-readable, when #[derive] isn't sufficient), (3) serialization (machine-readable: JSON, TOML, etc.), (4) streaming output (writer-based). Display should be the first impl in this section — it's what consumers see first.",
                        "why_these_constraints": "Output is the type's public face — how it appears to the world. Grouping all formatting together means you can review ALL representations in one place. The ordering (Display → Debug → Serialize → Stream) follows frequency of use. Display is almost always needed; streaming is specialized."
                    }
                },

                "B7_FreeFunctions": {
                    "position": 7,
                    "tag": "FreeFunctions",
                    "status": "REQUIRED (inherited from bare-bone, repositioned)",
