{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-form-library-rust",
    "_P1_from": "b-word/L1-omnicode/ladder/schemas/code/forms/bare-bone/rust-bare-bone.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "form-constraint",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/forms/declared",
    "_P3_includes": "none",
    "_P3_provides": ["LIBRARY_FORM_CONSTRAINTS", "CONTAINER_CAN_CANNOT", "TYPE_LIFECYCLE_ORDERING"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust Library Form Schema",
    "_P5_brief": "Defines what CAN and CANNOT be in each container of a library Rust file. Library is the most common declared form — public API crates with types, traits, constructors, queries, and documentation. Inherits bare-bone's foundation and promotes 4 additional BODY sections for type lifecycle ordering. Every constraint has a WHY and a HOW.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-library.jsonc",
        "key": "B-L1-schemas-form-library-rust",
        "title": "Rust Library Form Schema",
        "type": "Data (Form Constraint Schema)",
        "component": "Ladder",
        "role": "Define per-container CAN/CANNOT constraints for library Rust form — public API crates with type lifecycle ordering"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-19",
        "updated": "2026-02-19"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Genesis 1:11-12 — And God said, Let the earth bring forth... and the earth brought forth.",
        "principle": "Library is the filling — Day 3 energy, where the separated earth brings forth fruit. bare-bone declared boundaries (Days 1-3 separation); library fills them with types, traits, and public APIs. The earth was separated, now it produces. The structure was declared, now it serves."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": [
            "code/forms/bare-bone/rust-bare-bone.jsonc — inherits foundation constraints (the floor this form stands on)",
            "code/base/base-4block-schema.jsonc — container definitions, form registry",
            "code/format/rust-4block-schema.jsonc — Rust syntax rules, comment conventions"
        ],
        "consumers": [
            "b-word/seed/code/L0/rust/library.rs — the library template this schema constrains (when created)",
            "All library-form Rust files in the Bereshit codebase (spec/config, spec/database, b-spiral/identity, etc.)"
        ],
        "relationship": "bare-bone defines THE MINIMUM. This library schema defines what CHANGES when promoting to library form — which sections activate, what content fills the skeletons, what the type lifecycle ordering looks like."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // THE LIBRARY FORM CONSTRAINT SCHEMA
    //
    // Library is the most common declared form — public API crates
    // with types, traits, constructors, queries, and documentation.
    //
    // Library inherits bare-bone's foundation and PROMOTES:
    //   SETUP: S2 Modules (required) + S4/S5/S8/S9/S10 (available)
    //   BODY:  +4 sections (TraitImpls, Constructors, Queries, Output)
    //   CLOSING: Cc (available), X2/X3 (available)
    //
    // BODY ordering: type_lifecycle
    //   Identity → Traits → Constructors → CoreLogic → Queries → Output → Free
    //
    // Structure mirrors base-4block-schema.jsonc container layout:
    //   METADATA → SETUP → BODY → CLOSING
    // Each container gets: can, cannot, why, how.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/forms/library/rust.schema.json",
    "title": "Rust Library Form Constraints",
    "description": "Per-container CAN/CANNOT constraints for library Rust files. Public API crates with type lifecycle ordering.",

    "form_identity": {
        "name": "library",
        "is_foundation": false,
        "inherits": "bare-bone",
        "pragma": "//omni:code --rust -library",
        "directive": "//omni:code --rust -library",
        "template": "b-word/seed/code/L0/rust/library.rs",
        "principle": "Filling after separation. bare-bone declared boundaries (Days 1-3); library fills them with types, traits, and public APIs (Days 4-6). The earth brings forth.",
        "derivation_rule": "Library = bare-bone + promoted SETUP sections (S2 required, S4/S5/S8/S9/S10 available) + 4 promoted BODY sections in type_lifecycle order + Cc/X2/X3 available in CLOSING.",
        "ordering": "type_lifecycle — Identity → Traits → Constructors → CoreLogic → Queries → Output → FreeFunctions"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The four containers, each fully constrained.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "containers": {

        // ═══════════════════════════════════════════════════════
        // 1. METADATA CONTAINER — identical to bare-bone
        // ═══════════════════════════════════════════════════════
        //
        // Library does NOT change METADATA requirements.
        // Identity is form-invariant. The ONLY difference:
        //   //omni:code --rust -library (not -bare-bone)
        //   I2.subtype = "library" (not "bare-bone")
        //   I2.role = form-specific (e.g., "crate", "utility")

        "METADATA": {
            "summary": "IDENTICAL TO BARE-BONE — fully required, every section, every required field. Library does not change METADATA.",
            "reserved_omission": false,
            "inherits_from": "bare-bone METADATA (all constraints, all content_constraints)",

            "why": "Identity is form-invariant. A library has exactly the same identity requirements as bare-bone. The PRAGMA and METADATA statics have the same fields, same required/defined split, same (&str, &str) format. The only values that change are I1.key (unique to this file), I2.subtype ('library' not 'bare-bone'), and C-section values (file-specific context).",

            "library_specific_changes": {
                "directives": "//omni:code --rust -library (not -bare-bone)",
                "I2_subtype": "library",
                "I2_role": "File-specific (e.g., 'crate', 'utility', 'foundation')",
                "doc_comments": "Library doc comments describe the crate's PUBLIC API, not the template. Include: what the crate does, how to use it, key types and functions, examples.",
                "C4_dependencies": "Real dependencies (std modules, external crates, internal crates) — not 'none'",
                "C5_purpose": "Domain-specific purpose — not 'foundation template'"
            },

            "content_constraints_note": "All content_constraints from bare-bone METADATA apply unchanged. See rust-bare-bone.jsonc METADATA container for the complete constraint definitions for directives, doc_comments, pragma_statics, metadata_statics, and comment_metadata.",

            "cannot": {
                "description": "Same as bare-bone — no executable code, no imports, no types, no Reserved Omission in METADATA.",
                "inherits": "bare-bone METADATA.cannot (all prohibitions unchanged)"
            }
        },

        // ═══════════════════════════════════════════════════════
        // 2. SETUP CONTAINER — 5 required + 5 available
        // ═══════════════════════════════════════════════════════
        //
        // Library PROMOTES S2 (Modules) from bare-bone's reserved
        // to REQUIRED — libraries need module trees for public API.
        //
        // The remaining 5 bare-bone reserved sections become
        // AVAILABLE — library CAN use all 10 SETUP sections,
        // but only 5 are required (S1, S2, S3, S6, S7).
        //
        // Content is REAL (not commented-out like bare-bone).

        "SETUP": {
            "summary": "5 required + 5 available. Library promotes S2 Modules to required; all SETUP sections available.",
            "reserved_omission": true,
            "inherits_from": "bare-bone SETUP (S1, S3, S6, S7 content_constraints apply; content is REAL not commented-out)",

            "why": "Library is a public API crate. It NEEDS a module tree (S2) to organize its public surface. The 4 bare-bone sections (S1, S3, S6, S7) are still required — a library still needs imports, constants, errors, and types. The 5 remaining sections (S4, S5, S8, S9, S10) are AVAILABLE because libraries CAN use statics, aliases, traits, macros, and feature gates — but not every library needs all of them. Reserved Omission lists what's not active in THIS library file.",

            "how": {
                "working_with_constraints": "Every library file has at minimum: imports, modules, constants, error types, core types. Add statics/aliases/traits/macros/features as needed — they're available, not required.",
                "content_is_real": "Unlike bare-bone where all content is commented-out skeleton, library content is REAL, UNCOMMENTED Rust code. The patterns from bare-bone's content_constraints still apply — but the code is live."
            },

            "can": {
                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S1_Imports content_constraints (same rules apply)",
                    "library_difference": "Imports are REAL, not commented-out. Library files have actual dependencies.",
                    "content_constraints": {
                        "can_contain": [
                            "use std::{module}; — standard library imports (REAL, not commented-out)",
                            "use {external_crate}::{item}; — external crate imports (serde, toml, etc.)",
                            "use {internal_crate}::{item}; — sibling crate imports (bereshit_l0_config, etc.)",
                            "use crate::{module}::{item}; — crate-internal imports for submodule access",
                            "// Group comment headers: // --- Standard Library ---, etc."
                        ],
                        "cannot_contain": [
                            "Wildcard glob imports (use foo::*) — import what you use",
                            "Dead imports — every use must be referenced (clippy enforces)",
                            "Imports outside their origin group — maintain std → external → internal → crate ordering"
                        ],
                        "why_these_constraints": "Same as bare-bone — imports are dependency graph edges. Library difference: the imports are REAL code, not commented-out patterns."
                    }
                },

                "S2_Modules": {
                    "position": 2,
                    "tag": "Modules",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "mod name; pub use name::Type; pub mod name;",
                    "purpose": "Module tree and re-exports — the crate's public surface",
                    "why_required": "Libraries define public APIs. The module tree IS the public API structure. Without S2, a library has no organized public surface — just a flat list of items. Modules enable: (1) organization by concern, (2) visibility control (pub vs pub(crate) vs private), (3) re-exports for ergonomic access.",
                    "content_constraints": {
                        "can_contain": [
                            "mod {name}; — private submodule declarations",
                            "pub mod {name}; — public submodule declarations",
                            "pub use {name}::{Type}; — re-exports for consumer convenience",
                            "pub(crate) use {name}::{Type}; — crate-internal re-exports",
                            "#[cfg(test)] mod test_utils; — test support modules (cfg-gated)",
                            "// Section comment explaining module organization rationale"
                        ],
                        "cannot_contain": [
                            "Inline module bodies (mod name { ... }) for non-trivial code — use separate files",
                            "Circular module dependencies — the module tree is a DAG",
                            "Re-exports of private items — if it's re-exported, the source should be pub(crate) or pub",
                            "Module declarations without corresponding files — every mod needs its .rs file"
                        ],
                        "library_pattern": "Group modules by layer: (1) internal implementation modules, (2) public API modules, (3) re-exports flattening the public surface. lib.rs is the root — it should be thin (declarations and re-exports, not logic).",
                        "why_these_constraints": "The module tree IS the library's architecture made visible. A flat lib.rs with 1000 lines means the library has no internal organization. Modules create boundaries, control visibility, and enable separate compilation. The re-export pattern (pub use) creates ergonomic access while hiding internal structure."
                    }
                },

                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S3_Constants content_constraints (same rules apply)",
                    "library_difference": "Constants are REAL values, not commented-out examples. Domain-specific constants for this library's operations.",
                    "content_constraints": {
                        "can_contain": [
                            "const NAME: Type = value; — compile-time constants with REAL domain values",
                            "SCREAMING_SNAKE_CASE naming",
                            "Version constants, default configuration, format strings, capacity limits"
                        ],
                        "cannot_contain": [
                            "static variables (S4), let bindings, LazyLock/OnceLock (S4)",
                            "PRAGMA/METADATA statics (those are METADATA block identity)",
                            "Values that depend on runtime computation"
                        ],
                        "why_these_constraints": "Same as bare-bone — centralize hardcoded values. Library difference: these are REAL domain constants, not skeleton examples."
                    }
                },

                "S4_Statics": {
                    "position": 4,
                    "tag": "Statics",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "static NAME: LazyLock<Type> = LazyLock::new(|| { ... });",
                    "purpose": "Runtime-initialized shared state — process-wide singletons",
                    "why_available": "Libraries with shared state (connection pools, compiled regexes, caches) need statics. Not every library has shared state, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "static NAME: LazyLock<Type> = LazyLock::new(|| { ... }); — lazy initialization",
                            "static NAME: OnceLock<Type> = OnceLock::new(); — one-time initialization",
                            "// Comment explaining WHY this needs process-wide lifetime"
                        ],
                        "cannot_contain": [
                            "static mut — mutable statics are unsafe; use interior mutability (Mutex, RwLock) inside LazyLock/OnceLock",
                            "PRAGMA/METADATA statics — those live in METADATA, not SETUP",
                            "const values — those belong in S3 (compile-time, not runtime)"
                        ],
                        "why_these_constraints": "Statics are process-wide shared state. They exist for the lifetime of the program. LazyLock/OnceLock provide safe initialization. Mutable statics require unsafe — use interior mutability patterns instead."
                    }
                },

                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "type Result<T> = std::result::Result<T, Error>;",
                    "purpose": "Domain vocabulary shortcuts — named aliases for complex types",
                    "why_available": "Libraries with frequently-used complex types benefit from aliases. type Result<T> = ... is the canonical example. Not every library needs aliases, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "pub type Result<T> = std::result::Result<T, {ErrorType}>; — crate-level Result alias",
                            "pub type {Name} = {ComplexType}; — domain vocabulary aliases",
                            "/// doc comment explaining what the alias simplifies"
                        ],
                        "cannot_contain": [
                            "Type aliases that hide important information — the alias should clarify, not obscure",
                            "Aliases used in only one place — wait until 3+ uses before aliasing",
                            "Struct/enum definitions — those are S7 CoreTypes, not type aliases"
                        ],
                        "why_these_constraints": "Type aliases are vocabulary — they name complex type expressions for readability. The canonical Result<T> alias saves every function from repeating the error type. But aliases that are used once are just indirection."
                    }
                },

                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S6_ErrorTypes content_constraints (same rules apply)",
                    "library_difference": "Error types are REAL with domain-specific variants. Use thiserror for derive-based error creation. Enum variants should use typed fields, not stringly-typed.",
                    "content_constraints": {
                        "can_contain": [
                            "pub enum {ErrorType} { ... } — REAL error enum with domain-specific variants",
                            "#[derive(Debug, Clone, PartialEq, Eq)] — testability derives",
                            "impl fmt::Display — match on all variants with meaningful messages",
                            "impl std::error::Error — for error chaining",
                            "impl From<{SourceError}> — conversion from upstream errors (std::io::Error, toml::de::Error, etc.)",
                            "Enum-typed fields (op: LoadOp, kind: DepKind) — NOT stringly typed"
                        ],
                        "cannot_contain": [
                            "String-typed fields where enums would serve — op: String is a code smell; use op: LoadOp",
                            "anyhow::Error as the primary type — that's for binaries, not libraries",
                            "Error handling logic — BODY handles errors, SETUP defines them"
                        ],
                        "why_these_constraints": "Library errors are API contracts — callers match on them. Enum variants with typed fields enable exhaustive matching. Stringly-typed errors force callers to match on string content, which is fragile."
                    }
                },

                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S7_CoreTypes content_constraints (same rules apply)",
                    "library_difference": "Types are REAL with domain-specific fields. Derive Debug always. Add Clone, PartialEq, Eq, Hash as appropriate. Simple new() constructors stay here; complex builders go to BODY.",
                    "content_constraints": {
                        "can_contain": [
                            "pub struct {TypeName} { ... } — REAL data structures with domain fields",
                            "pub enum {TypeName} { ... } — REAL enumerations with domain variants",
                            "#[derive(Debug)] minimum, plus Clone/PartialEq/Eq/Hash as needed",
                            "#[derive(Serialize, Deserialize)] — when the type crosses serialization boundaries",
                            "impl Default — when a sensible default exists",
                            "impl {Type} { pub fn new(...) -> Self } — SIMPLE constructors only",
                            "/// doc comments: what the type represents, field purposes, lifecycle"
                        ],
                        "cannot_contain": [
                            "Complex constructors (validation, fallible creation) — those go to BODY Constructors",
                            "Builder patterns — BODY Constructors & Builders section",
                            "Business logic methods — BODY CoreLogic section",
                            "Trait definitions — S8 TraitDefs (when available)"
                        ],
                        "why_these_constraints": "Core types are the NOUNS. SETUP declares shapes; BODY operates on them. Simple new() that just assigns fields stays in SETUP. Anything with logic (validation, fallible construction, builder chains) goes to BODY."
                    }
                },

                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "pub trait Name { fn method(&self) -> Type; }",
                    "purpose": "Behavioral contracts — define what types CAN DO without specifying HOW",
                    "why_available": "Libraries with polymorphic APIs need trait definitions. Traits in SETUP, implementations in BODY. Not every library defines traits, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "pub trait {Name} { fn method(&self) -> Type; } — behavioral contracts",
                            "pub trait {Name}: {SuperTrait} — trait inheritance",
                            "Default method implementations — when a sensible default exists",
                            "Associated types (type Output;) — for flexible return types",
                            "/// doc comments: what the trait represents, when to implement it, examples"
                        ],
                        "cannot_contain": [
                            "Trait implementations (impl Trait for Type) — those go in BODY TraitImplementations",
                            "Concrete logic — traits define contracts, not implementations",
                            "More than ~3 traits per file — many traits signal the file needs decomposition into modules"
                        ],
                        "why_these_constraints": "Traits define WHAT, not HOW. They go in SETUP because they are type-level declarations (like structs and enums). Implementations go in BODY because they are logic. This separation means you can read SETUP to understand the contract without reading the implementation."
                    }
                },

                "S9_Macros": {
                    "position": 9,
                    "tag": "Macros",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "macro_rules! name { ($pattern) => { expansion } }",
                    "purpose": "Compile-time code generation — DRY for repetitive patterns",
                    "why_available": "Libraries with repetitive patterns benefit from macro_rules! to reduce boilerplate. Not every library needs macros, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "macro_rules! {name} { ... } — declarative macros for pattern generation",
                            "#[macro_export] — when the macro is part of the public API",
                            "/// doc comments with examples showing macro invocation and expansion"
                        ],
                        "cannot_contain": [
                            "Proc macros (those require a separate crate with proc-macro = true)",
                            "Macros that replace functions — if a function would work, use a function",
                            "Macros without documentation — macro syntax is opaque; document thoroughly"
                        ],
                        "why_these_constraints": "Macros are powerful but opaque — they operate at the syntax level, not the type level. Use them only when the pattern repetition is genuinely structural (not just lazy). The 3-times rule: write it manually 3 times, then macro it."
                    }
                },

                "S10_FeatureGates": {
                    "position": 10,
                    "tag": "FeatureGates",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "#[cfg(feature = \"name\")] pub mod feature_module;",
                    "purpose": "Conditional compilation — optional capabilities controlled at build time",
                    "why_available": "Libraries with optional features (serde support, async support, nightly features) use feature gates. Not every library needs conditional compilation, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "#[cfg(feature = \"name\")] — feature-gated items",
                            "#[cfg(test)] — test-only items (always available, not strictly a feature gate)",
                            "#[cfg(target_os = \"...\")] — platform-specific items",
                            "// Comment explaining what each feature enables and why it's optional"
                        ],
                        "cannot_contain": [
                            "Feature gates on core functionality — if it's needed for the basic API, it shouldn't be optional",
                            "Undocumented features — every feature must be documented in Cargo.toml [features]",
                            "#[cfg(feature)] without corresponding Cargo.toml feature definition"
                        ],
                        "why_these_constraints": "Feature gates control what gets compiled. Optional features keep the default build lean. But core functionality should never be gated — the basic API must work without enabling anything."
                    }
                },

                "Reserved_Omission": {
                    "position": "LAST in SETUP (after all active subsections)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists AVAILABLE SETUP sections NOT used in THIS library file",
                    "why_required": "Completeness contract. active_count + available_unused + reserved = 10. Nothing silently absent.",
                    "library_content": "Lists whichever of S4, S5, S8, S9, S10 are not used in this specific library file. Unlike bare-bone where 6 are always reserved, library's Reserved Omission varies per file."
                }
            },

            "cannot": {
                "description": "No SETUP sections are categorically forbidden in library form. All 10 are either required or available. Reserved Omission contains only sections not needed by THIS specific library file.",
                "note": "This is the key difference from bare-bone — library can use ALL SETUP sections. bare-bone reserves 6."
            },

            "completeness_rule": {
                "formula": "required + available_active + available_reserved = 10",
                "library_minimum": "5 required (S1, S2, S3, S6, S7) + 5 available (S4, S5, S8, S9, S10 — some active, some in Reserved Omission) = 10"
