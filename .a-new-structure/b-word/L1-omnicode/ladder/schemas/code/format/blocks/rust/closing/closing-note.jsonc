{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-closing-closing-note",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "CLOSING Section X5: Closing Note — Rust Content",
    "_P5_brief": "Rust-specific content rules for X5 (Closing Note). Domain-appropriate scripture with reflection connecting the file's purpose to eternal truth. The file's last word is the anchor.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "blocks/closing/closing-note.jsonc",
    "format": "rust",

    "content": {

        // ─────────────────────────────────────
        // Rust-specific CAN
        // ─────────────────────────────────────

        "can": [
            {
                "construct": "// opening scripture quote",
                "description": "Domain-appropriate verse grounding this file's work in eternal truth",
                "patterns": [
                    "// X5 — Closing Note\n//\n// \"Whatsoever thy hand findeth to do, do it with thy might.\"\n//   — Ecclesiastes 9:10",
                    "// X5 — Closing Note\n//\n// \"In the beginning God created the heaven and the earth.\"\n//   — Genesis 1:1"
                ],
                "visibility": "N/A — documentation"
            },
            {
                "construct": "// 2-4 sentence reflection",
                "description": "Connecting the scripture to this file's specific purpose — the module's spiritual grounding",
                "patterns": [
                    "// This module parses configuration — finding truth in text.\n// Like the Bereans who searched the scriptures daily,\n// we examine every field, every value, every constraint.\n// The parser doesn't assume; it verifies.",
                    "// Identity is not decoration — it is foundation.\n// Before content, before logic, before any operation,\n// the file declares who it is. Genesis 1:1 is first,\n// not last. Identity anchors everything."
                ],
                "visibility": "N/A"
            },
            {
                "construct": "// closing anchor",
                "description": "The file's final word — connecting back to the founding truth",
                "patterns": [
                    "// Foundation declared. Identity set. The work serves the whole."
                ],
                "visibility": "N/A"
            }
        ],

        // ─────────────────────────────────────
        // Rust-specific CANNOT
        // ─────────────────────────────────────

        "cannot": [
            {
                "construct": "executable Rust code",
                "reason": "X5 is the spiritual anchor — comments only, no code",
                "defer_to": "BODY or CLOSING Cv/Ce",
                "rust_signal": "^(pub\\s+)?(fn|impl|struct|enum|trait|const|static|type|use|mod)\\s+"
            },
            {
                "construct": "placeholder scripture",
                "reason": "Generic 'insert verse here' is worse than no verse. Choose a verse that connects to the file's domain.",
                "defer_to": "N/A — choose meaningful scripture",
                "rust_signal": "TODO|placeholder|insert"
            },
            {
                "construct": "generic scripture disconnected from domain",
                "reason": "The verse must illuminate THIS file's specific concern. A parser module shouldn't use a verse about building walls.",
                "defer_to": "N/A — choose domain-appropriate scripture",
                "rust_signal": "N/A — design judgment"
            }
        ],

        // ─────────────────────────────────────
        // Rust-specific Defer Signals
        // ─────────────────────────────────────

        "defer_signals": [
            {
                "pattern": "^(pub\\s+)?(fn|impl|struct|enum)\\s+",
                "to": "BODY or CLOSING Cv",
                "confidence": "high",
                "why": "Executable code after the closing note — belongs earlier in the file"
            }
        ],

        // ─────────────────────────────────────
        // Code Generation Templates
        // ─────────────────────────────────────

        "scaffold": {
            "empty_module": "// X5 — Closing Note\n//\n// \"But now hath God set the members every one of them in the body,\n//  as it hath pleased him.\"\n//   — 1 Corinthians 12:18\n//\n// This module is a member of the body. It does its one thing\n// with excellence. The body needs it exactly here.",
            "empty_library": "// X5 — Closing Note\n//\n// \"In the beginning God created the heaven and the earth.\"\n//   — Genesis 1:1\n//\n// Every crate begins with identity. Every identity traces\n// to the One who created. The foundation is set.\n// Build well upon it.",
            "comment_skeleton": "// X5 — Closing Note\n// \"Scripture verse\" — Book Chapter:Verse\n// 2-4 sentence reflection connecting to this file's purpose."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust X5 (Closing Note): the file's last word is eternal truth. Scripture chosen for the domain. Reflection connecting the file's purpose to the verse. The anchor that bookends what C3 (grounding) began.",
    "_X5_scripture": "Revelation 22:13 — I am Alpha and Omega, the beginning and the end, the first and the last."
}