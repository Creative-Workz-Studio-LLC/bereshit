{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-setup-statics",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "SETUP Section 4: Statics — Rust Content",
    "_P5_brief": "Rust-specific content rules for Statics. Runtime-initialized shared state using LazyLock/OnceLock. AVAILABLE in library and module forms.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "blocks/setup/statics.jsonc",
    "format": "rust",

    "content": {

        "can": [
            {
                "construct": "static NAME: LazyLock<Type> = LazyLock::new(|| { ... });",
                "description": "Lazy initialization — computed once on first access, thread-safe",
                "patterns": [
                    "static REGEX_PATTERN: LazyLock<Regex> = LazyLock::new(|| {\n    Regex::new(r\"^\\d+$\").expect(\"valid regex\")\n});",
                    "static DEFAULT_CONFIG: LazyLock<Config> = LazyLock::new(|| {\n    Config::load_defaults()\n});"
                ],
                "visibility": "pub for library API, pub(crate) for crate-internal, none for file-private"
            },
            {
                "construct": "static NAME: OnceLock<Type> = OnceLock::new();",
                "description": "One-time initialization — set once externally, then read-only",
                "patterns": [
                    "static LOGGER: OnceLock<Logger> = OnceLock::new();"
                ],
                "visibility": "pub(crate) typically — initialization happens at crate startup"
            },
            {
                "construct": "// Comment explaining WHY this needs module-level lifetime",
                "description": "Every static should justify its existence — why not a const or local variable?",
                "patterns": [
                    "// Compiled regex — too expensive to recompile per call",
                    "// Connection pool — shared across all handlers"
                ],
                "visibility": "N/A"
            }
        ],

        "cannot": [
            {
                "construct": "static mut",
                "reason": "Mutable statics are unsafe and require unsafe blocks to access. Use interior mutability (Mutex, RwLock) inside LazyLock/OnceLock.",
                "defer_to": "N/A — use LazyLock<Mutex<T>> instead",
                "rust_signal": "static\\s+mut\\s+"
            },
            {
                "construct": "PRAGMA / METADATA statics",
                "reason": "Identity statics live in METADATA block, not SETUP statics",
                "defer_to": "METADATA",
                "rust_signal": "PRAGMA|METADATA.*\\[\\("
            },
            {
                "construct": "const values",
                "reason": "Compile-time values belong in S3 Constants, not runtime statics",
                "defer_to": "SETUP.Constants",
                "rust_signal": "^(pub\\s+)?const\\s+"
            }
        ],

        "defer_signals": [
            {
                "pattern": "^(pub\\s+)?const\\s+",
                "to": "SETUP.Constants",
                "confidence": "high",
                "why": "Compile-time constant, not runtime static"
            },
            {
                "pattern": "static\\s+mut\\s+",
                "to": "N/A — refactor to LazyLock<Mutex<T>>",
                "confidence": "high",
                "why": "Mutable static is unsafe — use interior mutability pattern"
            }
        ],

        "scaffold": {
            "empty_module": "// No module-level statics needed.",
            "empty_library": "// No crate-level statics needed.",
            "comment_skeleton": "// static CACHE: LazyLock<HashMap<String, Value>> = LazyLock::new(|| {\n//     HashMap::new()\n// });"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust Statics: process-wide shared state with safe initialization. LazyLock for computed-once values, OnceLock for set-once-externally values. Every static must justify why a const or local wouldn't suffice.",
    "_X5_scripture": "Hebrews 13:8 — Jesus Christ the same yesterday, and to day, and for ever."
}