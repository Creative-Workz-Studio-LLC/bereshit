{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-setup-macros",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "SETUP Section 9: Macros — Rust Content",
    "_P5_brief": "Rust-specific content rules for Macros. Compile-time code generation via macro_rules!. AVAILABLE in library form, RESERVED in module form.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "blocks/setup/macros.jsonc",
    "format": "rust",

    "content": {

        "can": [
            {
                "construct": "macro_rules! {name} { ($pattern) => { expansion } }",
                "description": "Declarative macros for pattern generation — DRY for repetitive patterns",
                "patterns": [
                    "macro_rules! impl_display {\n    ($type:ty, $fmt:expr) => {\n        impl fmt::Display for $type {\n            fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n                write!(f, $fmt, self)\n            }\n        }\n    };\n}"
                ],
                "visibility": "N/A for non-exported, #[macro_export] for public"
            },
            {
                "construct": "#[macro_export]",
                "description": "Macro is part of the crate's public API",
                "patterns": [
                    "#[macro_export]\nmacro_rules! define_type { ... }"
                ],
                "visibility": "pub (via macro_export)"
            },
            {
                "construct": "/// doc comments with invocation examples",
                "description": "Macro syntax is opaque — document thoroughly with input/output examples",
                "patterns": [
                    "/// Creates a typed error variant.\n///\n/// # Example\n/// ```\n/// define_error!(NotFound, \"resource not found\");\n/// ```"
                ],
                "visibility": "N/A"
            }
        ],

        "cannot": [
            {
                "construct": "proc macros",
                "reason": "Proc macros require a separate crate with proc-macro = true in Cargo.toml",
                "defer_to": "N/A — create separate proc-macro crate",
                "rust_signal": "#\\[proc_macro|TokenStream"
            },
            {
                "construct": "macros replacing functions",
                "reason": "If a function would work, use a function. Macros operate at syntax level, not type level.",
                "defer_to": "BODY.FreeFunctions",
                "rust_signal": "N/A — design judgment"
            },
            {
                "construct": "macros without documentation",
                "reason": "Macro syntax is opaque — undocumented macros are unmaintainable",
                "defer_to": "N/A — add documentation",
                "rust_signal": "N/A"
            }
        ],

        "defer_signals": [
            {
                "pattern": "#\\[proc_macro",
                "to": "N/A — separate proc-macro crate",
                "confidence": "high",
                "why": "Proc macros need their own crate"
            }
        ],

        "scaffold": {
            "empty_module": "// RESERVED — module form does not define macros",
            "empty_library": "// No crate-level macros needed.",
            "comment_skeleton": "// macro_rules! name {\n//     ($pattern:expr) => { expansion };\n// }"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust Macros: compile-time code generation. macro_rules! for pattern repetition. The 3-times rule: write it manually 3 times, then macro it. Powerful but opaque — document thoroughly.",
    "_X5_scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
}