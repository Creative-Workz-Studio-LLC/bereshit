        "CLOSING content validation — required zones (X1/X5) + zone field content (never/careful/safe, note/scripture)",
        "SETUP/BODY content validation — header documentation, subtype-specific subsection names",
        "Scaling signals — SETUP > 200 lines, BODY > 500 lines early warnings"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
