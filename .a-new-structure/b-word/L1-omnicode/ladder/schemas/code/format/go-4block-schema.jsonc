{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-go-4block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-03.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/format",
    "_P3_includes": "none",
    "_P3_provides": ["GO_4BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Go 4-Block Schema",
    "_P5_brief": "Defines how Go source files implement OmniCode 4-block structure using // comments. Block boundaries, //omni: directives, Pragma/Metadata [][2]string identity vars (I1-I4, C1-C7), Go doc comments, three-tier comment discipline, and SETUP/BODY subsection ordering — all validated by the go.ts linter.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "go-4block-schema.jsonc",
        "key": "B-L1-schemas-go-4block-schema",
        "title": "Go 4-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define how Go source files express OmniCode 4-block structure through // comments and //omni: directives"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-03.00",
        "status": "Active",
        "created": "2026-02-15",
        "updated": "2026-02-18"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "1 Corinthians 14:40 — Let all things be done decently and in order.",
        "principle": "Go values simplicity and readability. The 4-block structure channels that philosophy — each block has a clear purpose, each subsection has a canonical order. Structure is not overhead; it's the discipline that makes Go code navigable at scale."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "code/base/base-4block-schema.jsonc — shared 4-block $defs + health scoring; data/base/base-3block-schema.jsonc — shared I/C metadata $defs",
        "consumers": "c-tov/cws-struct/lib/handlers/go.ts — runtime linter implements these rules",
        "cross_format": {
            "makefile_sibling": "schemas/code/format/makefile-4block-schema.jsonc — Makefile 4-block (also comment-based)",
            "rust_sibling": "schemas/code/format/rust-4block-schema.jsonc — Rust 4-block (also //-comment-based)",
            "relationship": "Same OmniCode 4-block concepts, Go-native expression via // comments and //omni: directives"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Go source files express 4-block structure through // comments:
    //   //omni:key B-package-name       — identity directive
    //   //omni:code --go -library        — type/format directive
    //   //omni:version a-01.00           — version directive
    //   // ====...====                   — block boundary (76 = chars)
    //   // METADATA                      — block label
    //   // ────...────                   — subsection boundary (74 ─ chars, U+2500)
    //   // 1. Imports                   — SETUP subsection header
    //   // END METADATA                 — block end marker
    //
    // Two file classifications:
    //   Template: // #!omni template --go -library + //go:build ignore
    //   Derived:  //omni:key + //omni:code + standard package declaration
    //
    // Package identity: doc.go holds var _pragma and var _metadata maps.
    // Other files in the package inherit identity from doc.go.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How Go conventions map to 4-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "Go — gofmt-formatted source, // comments carry all structural metadata",
    "_Cc_key_convention": "//omni: directives before package, // block labels after package",

    "format_mapping": {
        "note": "How OmniCode concepts map to Go syntax",
        "identity_directives": "//omni:key, //omni:code, //omni:version — before package declaration",
        "doc_comments": "// before exported declarations (Go 1.19+ format) — go doc/godoc parseable",
        "identity_vars": "var Pragma = [][2]string{...} and var Metadata = [][2]string{...} — I/C identity",
        "block_boundaries": "// ====...==== (76 =) separator + // BLOCK_NAME label",
        "end_markers": "// END BLOCK_NAME — marks block end",
        "setup_sections": "// ──────... (74 ─) divider + // N. Label — 10 numbered sections in SETUP",
        "body_subsections": "// ──────...────── (74 ─) + // N. Name — numbered subsections within BODY",
        "separators": "// ====...==== (76 =) for blocks, // ──────...────── (74 ─) for SETUP and BODY subsections",
        "template_directive": "// #!omni template --go -library (first structural line in templates)",
        "build_constraint": "//go:build ignore — required for template files (prevents compilation)"
    },

    "comment_conventions": {
        "block_separator": "// ============================================================================",
        "block_label": "// METADATA | // SETUP | // BODY | // CLOSING",
        "end_marker": "// END METADATA | // END SETUP | // END BODY | // END CLOSING",
        "setup_section_divider": "// ──────────────────────────────────────────────────────────────────────────",
        "setup_section_header": "// 1. Imports | // 2. Constants | ... | // 10. Build Tags",
        "body_subsection_divider": "// ──────────────────────────────────────────────────────────────────────────",
        "body_subsection_header": "// 1. Org Chart | // 2. Helpers | // 3. Core Operations | // 4. Error Handling | // 5. Public APIs",
        "omni_directive": "//omni:key B-package-name",
        "pragma_line": "// #!omni template --go -library"
    },

    "file_classification": {
        "template": {
            "markers": ["// #!omni template", "//go:build ignore"],
            "identity": "#!omni pragma + Pragma/Metadata [][2]string vars with self-describing I/C values",
            "subtypes": ["--go -library", "--go -executable", "--go -demo-test"],
            "package": "package packagename (or package main for executable, package packagename_test for demo-test)",
            "note": "Templates use 'usable schema' pattern — all values describe the template ITSELF (no [bracketed] placeholders). When copied, values are changed to describe the new file."
        },
        "derived": {
            "markers": ["//omni:key", "//omni:code"],
            "identity": "//omni:key directive + var Pragma/Metadata [][2]string in doc.go (package identity)",
            "doc_comments": "// package doc, // Pragma doc, // Metadata doc recommended",
            "package": "Standard package declaration",
            "note": "Derived files are compiled Go code with structural markers. Doc.go holds package identity; other files inherit."
        }
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete Go 4-block structure definition.
    // Each entry maps a structural element to its purpose
    // and what the linter validates.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "go_structure": {

        // ═══════════════════════════════════════════════════════
        // DIRECTIVES — //omni: identity lines
        // ═══════════════════════════════════════════════════════

        "directives": {
            "purpose": "OmniCode identity directives at top of file, before package declaration",

            "required": {
                "//omni:key": {
                    "purpose": "Bereshit key — unique file identifier",
                    "pattern": "//omni:key B-package-path-filename",
                    "severity": "error",
                    "example": "//omni:key B-L0-config-loader"
                }
            },

            "recommended": {
                "//omni:code": {
                    "purpose": "File type and format classification",
                    "pattern": "//omni:code --go -library | --go -executable | --go -demo-test",
                    "severity": "warn",
                    "known_values": ["--go -library", "--go -executable", "--go -demo-test"]
                },
                "//omni:version": {
                    "purpose": "Living version",
                    "pattern": "//omni:version a-01.00",
                    "severity": "warn"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK — Identity/Context via Pragma/Metadata vars
        // ═══════════════════════════════════════════════════════

        "METADATA": {
            "purpose": "File identity and context — OmniCode I/C sections in Go doc comments and Pragma/Metadata vars",
            "boundary": "// ============================================================================",
            "label": "// METADATA",
            "end_marker": "// END METADATA",
            "required": true,
            "severity": "error",

            "doc_comments": {
                "note": "Go doc comments (// before exported declarations) serve as portable API documentation via go doc and godoc. Three-tier comment discipline applies.",

                "package_doc": {
                    "purpose": "Package-level documentation — first // comment block before package declaration",
                    "format": "Go 1.19+ doc comment format: # Heading, tab-indented preformatted text, [Name] for doc links",
                    "contains": "Design summary, Usage examples, OmniCode Identity table (Pragma I1-I4, Metadata C1-C7)",
                    "severity": "warn"
                },
                "pragma_doc": {
                    "purpose": "Doc comment on var Pragma — describes I1-I4 sections with Required/Defined columns",
                    "format": "// Pragma carries the OmniCode identity sections (I1-I4)...",
                    "contains": "Section purpose table with Required/Defined columns, # Example with PragmaGet() usage",
                    "severity": "warn"
                },
                "metadata_doc": {
                    "purpose": "Doc comment on var Metadata — describes C1-C7 sections with Required/Defined columns",
                    "format": "// Metadata carries the OmniCode context sections (C1-C7)...",
                    "contains": "Section purpose table with Required/Defined columns, # Example with MetadataGet() usage",
                    "severity": "warn"
                },

                "three_tier_discipline": {
                    "doc_comments": "// before exported declarations — go doc/godoc parseable (first sentence = summary)",
                    "organizational_comments": "// section dividers — blank line separates from declarations so NOT parsed as doc comments",
                    "inline_comments": "// within code for navigation and clarification"
                }
            },

            "comment_fields": {
                "note": "Comment fields are SECONDARY to Pragma/Metadata vars. When I/C vars exist, these are informational only.",
                "Key": { "required": true, "severity": "warn", "note": "Downgraded to info if file has Pragma var with I1.key" },
                "Purpose": { "required": true, "severity": "warn", "note": "Downgraded to info if file has Metadata var with C5.purpose" },
                "Biblical/Scripture": { "recommended": true, "severity": "info", "note": "Downgraded to info if file has Metadata var with C3.scripture" },
                "Version": { "recommended": true, "severity": "info", "note": "Downgraded to info if file has Metadata var with C1.version" }
            },

            "identity_statics": {
                "note": "Pragma carries Identity (I1-I4), Metadata carries Context (C1-C7). Both are [][2]string slices — lightweight, zero-allocation, Go-idiomatic.",

                "pragma_sections": {
                    "I1_core": { "required": ["key", "format", "from", "at"], "purpose": "WHO — unique identity" },
                    "I2_family": { "required": ["type", "structure"], "defined": ["subtype", "role"], "purpose": "WHAT — classification" },
                    "I3_instance": { "required": ["file", "title"], "defined": ["component", "path", "provides", "brief"], "purpose": "THIS — file-specific" },
                    "I4_architecture": { "defined": ["layer", "position", "pattern"], "purpose": "WHERE — structural context" }
                },

                "metadata_sections": {
                    "C1_state": { "required": ["version", "status"], "defined": ["created", "updated"], "purpose": "WHEN — lifecycle" },
                    "C2_attribution": { "required": ["organization"], "defined": ["architect", "implementation", "copyright"], "purpose": "WHO MADE — credit" },
                    "C3_grounding": { "required": ["scripture"], "defined": ["principle", "anchor"], "purpose": "WHY — biblical foundation" },
                    "C4_dependencies": { "required": ["requires", "consumers"], "defined": ["integration", "if_missing"], "purpose": "NEEDS — dependency graph" },
                    "C5_intent": { "defined": ["purpose", "philosophy"], "purpose": "GOAL — design intent" },
                    "C6_roadmap": { "defined": ["current", "planned", "limitations"], "purpose": "NEXT — trajectory" },
                    "C7_classification": { "defined": ["tags", "category", "domain", "paradigm"], "purpose": "TAGS — discovery" }
                },

                "field_format": {
                    "pragma_keys": "I{section}.{field} — e.g., I1.key, I2.type, I3.file, I4.layer",
                    "metadata_keys": "C{section}.{field} — e.g., C1.version, C2.organization, C3.scripture",
                    "nested_keys": "C4.requires.{category} — e.g., C4.requires.stdlib, C4.requires.external, C4.requires.internal"
                },

                "slice_pattern": {
                    "pragma": "var Pragma = [][2]string{{\"I1.key\", \"...\"}, {\"I1.format\", \"...\"}, ...}",
                    "metadata": "var Metadata = [][2]string{{\"C1.version\", \"...\"}, {\"C1.status\", \"...\"}, ...}",
                    "accessor": "func PragmaGet(key string) string — linear scan over Pragma slice, returns value or empty string",
                    "note": "Slice pattern chosen for zero-allocation, compile-time-known identity. Go templates use exported Pragma/Metadata."
                },

                "delegated_identity": {
                    "pattern": "doc.go holds Pragma and Metadata — other package files inherit",
                    "note": "Go package identity convention — doc.go is the identity file. Other files in the package don't need their own Pragma/Metadata.",
                    "severity": "info"
                },

                "double_import_declare": {
                    "note": "Go requires imports before other declarations. Templates use a minimal import() block in METADATA area to satisfy syntax, with the full import block in SETUP. When instantiated, both merge or METADATA import is removed.",
                    "severity": "info"
                },

                "severity_package_root": "warn",
                "severity_other_files": "not checked (identity delegated to doc.go)"
            },

            "subtypes": {
                "note": "Three template subtypes — same I/C structure, different valid values for I2.subtype and file patterns",

                "library": {
                    "I2_subtype": "library",
                    "file_pattern": "*.go (any package file, doc.go for identity)",
                    "pragma_directive": "//omni:code --go -library",
                    "template_directive": "// #!omni template --go -library",
                    "package": "package packagename",
                    "has_public_api": true,
                    "purpose": "Library package — exposes public API, holds package identity"
                },
                "executable": {
                    "I2_subtype": "executable",
                    "file_pattern": "main.go",
                    "pragma_directive": "//omni:code --go -executable",
                    "template_directive": "// #!omni template --go -executable",
                    "package": "package main",
                    "has_public_api": false,
                    "purpose": "Binary — orchestrates via main() → run() → error pattern"
                },
                "demo_test": {
                    "I2_subtype": "demo-test",
                    "file_pattern": "*_test.go",
                    "pragma_directive": "//omni:code --go -demo-test",
                    "template_directive": "// #!omni template --go -demo-test",
                    "package": "package packagename_test (external) or package packagename (internal)",
                    "has_public_api": false,
                    "purpose": "Test file — validates package behavior, proves claims"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // SETUP BLOCK — declarations the BODY depends on
        // ═══════════════════════════════════════════════════════

        "SETUP": {
            "purpose": "SETUP makes things EXIST. BODY makes things HAPPEN. All declarations — imports, types, constants, errors, interfaces — go here. BODY contains only functions.",
            "boundary": "// ============================================================================",
            "label": "// SETUP",
            "end_marker": "// END SETUP",
            "required": true,
            "severity": "error",

            "subsection_order": {
                "note": "Canonical order follows the Go dependency chain — each subsection can reference only what came before it. Linter checks that present subsections appear in this sequence. Not all 10 are required — only those with content should appear.",
                "canonical_count": 10,
                "ordering_principle": "dependency_chain",

                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "pattern": "Imports",
                    "alt_patterns": ["Package Imports"],
                    "purpose": "What this file depends on. Groups: Standard Library → External → Internal → Package-Internal",
                    "production_note": "Group by origin: std → external → internal → package-internal. goimports handles formatting. Dot imports (. \"pkg\") are a code smell except in test files. Blank imports (_ \"pkg\") for side effects belong here, documented with purpose.",
                    "required_in": ["library", "executable", "demo-test"]
                },
                "S2_Constants": {
                    "position": 2,
                    "tag": "Constants",
                    "pattern": "Constants",
                    "alt_patterns": ["Consts"],
                    "purpose": "Compile-time fixed values. Don't depend on types — they come first.",
                    "production_note": "Every magic number in BODY should be a named constant here. Exit codes, buffer sizes, retry counts, version strings, default values — if it is hardcoded, it lives here. Use iota for enumerations. When the system scales, these migrate to config; BODY stays unchanged.",
                    "required_in": ["executable"]
                },
                "S3_Variables": {
                    "position": 3,
                    "tag": "Variables",
                    "pattern": "Variables",
                    "alt_patterns": ["Vars", "Package Variables"],
                    "purpose": "Package-level mutable state. Sentinel errors, registries, lazy singletons.",
                    "production_note": "Package-level vars are Go's process-wide shared state: sentinel errors (ErrNotFound), registries (sync.Map), lazy singletons (sync.Once). In production: prefer sync primitives for concurrent access. In tests: avoid mutable package vars — parallel test execution creates race conditions.",
                    "required_in": []
                },
                "S4_TypeAliases": {
                    "position": 4,
                    "tag": "TypeAliases",
                    "pattern": "Type Aliases",
                    "purpose": "Shorthand for complex signatures. type X = Y (true alias).",
                    "production_note": "True aliases (type X = Y) share identity with the original. Defined types (type X Y) create new types. Use aliases for migration compatibility, defined types for domain vocabulary. A well-aliased package tells you what it does by how its types read.",
                    "required_in": []
                },
                "S5_ErrorTypes": {
                    "position": 5,
                    "tag": "ErrorTypes",
                    "pattern": "Error Types",
                    "alt_patterns": ["Errors"],
                    "purpose": "Custom errors + Error() method. Before Core Types because methods return these.",
                    "production_note": "Error types define how your package fails. In production: sentinel errors (var ErrNotFound = errors.New(...)) for comparison, typed errors (type ValidationError struct{...}) for carrying context. Error() implementations go HERE with the type, not in BODY — they complete the type definition. A package's error type is its most important API surface after its happy path.",
                    "required_in": ["library"]
                },
                "S6_CoreTypes": {
                    "position": 6,
                    "tag": "CoreTypes",
                    "pattern": "Core Types",
                    "alt_patterns": ["Types", "Structures", "Data Types"],
                    "purpose": "struct definitions + simple constructors. The shapes this file works with.",
                    "production_note": "These are the nouns of your system. Structs carry state. In production: export only what consumers need. Keep types flat — deeply nested types are a sign of missing abstractions. Simple New*() constructors are defensible here; complex construction with validation belongs in BODY.",
                    "required_in": ["library"]
                },
                "S7_InterfaceDefs": {
                    "position": 7,
                    "tag": "InterfaceDefs",
                    "pattern": "Interface Definitions",
                    "alt_patterns": ["Interfaces", "Interface Defs"],
                    "purpose": "Behavioral contracts (shape, not fulfillment). Implementations go in BODY.",
                    "production_note": "Interfaces define the extension points of your system. In Go: accept interfaces, return structs. Keep interfaces small (1-3 methods) — the io.Reader/io.Writer pattern. Interface definitions are SETUP (they declare contracts); implementations are BODY (they fulfill contracts). Consumers should define the interfaces they need, not the provider.",
                    "required_in": []
                },
                "S8_TypeMethods": {
                    "position": 8,
                    "tag": "TypeMethods",
                    "pattern": "Type Methods",
                    "alt_patterns": ["Methods", "Receiver Methods"],
                    "purpose": "Structural behaviors — completing interface impls (Error, String, Unwrap). Business logic goes in BODY.",
                    "production_note": "Methods that complete a type's identity: Error(), String(), MarshalJSON(), Unwrap(). These are SETUP because removing them makes the type incomplete. Business logic methods (Process(), Execute(), Handle()) are BODY — removing them removes capability, not identity.",
                    "required_in": []
                },
                "S9_CodeGeneration": {
                    "position": 9,
                    "tag": "CodeGeneration",
                    "pattern": "Code Generation",
                    "alt_patterns": ["Assertion Helpers"],
                    "purpose": "go:generate directives. Go's equivalent of Rust macros.",
                    "production_note": "//go:generate directives trigger code generation tooling (stringer, mockgen, protoc). In test files: assertion helpers with t.Helper() are the Go equivalent of Rust assertion macros — they eliminate boilerplate without hiding logic. Document what each directive generates.",
                    "required_in": []
                },
                "S10_BuildTags": {
                    "position": 10,
                    "tag": "BuildTags",
                    "pattern": "Build Tags",
                    "purpose": "Conditional compilation items. //go:build constraints and tag-specific code.",
                    "production_note": "Build tags are SETUP's config mechanism at compile time. In production: //go:build constraints control what gets compiled — platform code, integration tests, debug tooling. Last in SETUP because they modify what earlier subsections declared. Use the new //go:build syntax (Go 1.17+), not the legacy // +build.",
                    "required_in": []
                }
            },

            "production_design": {
                "principle": "SETUP is the file's local config layer. Everything hardcoded lives here, not scattered through BODY. This creates a single address for every value, a clear upgrade path to external config, and a BODY block that is pure logic.",
                "storage_pattern": "The SETUP/BODY separation mirrors the data/logic split in database design. SETUP is your schema (what exists); BODY is your queries (what happens). When SETUP is clean, you can reason about data flow without reading logic.",
                "scaling_signal": "If SETUP grows past 200 lines, the file is doing too much. Extract types into a types.go file, errors into errors.go, constants into constants.go. The subsection structure tells you exactly where to cut."
            },

            "subtype_emphasis": {
                "note": "Each subtype leans on different SETUP subsections. The 10-subsection structure is universal; the weight distribution is subtype-specific.",
                "library": {
                    "heavy": ["Imports", "ErrorTypes", "CoreTypes", "InterfaceDefs"],
                    "light": ["Constants", "Variables", "CodeGeneration"],
                    "note": "Libraries are type-rich. Their SETUP defines the vocabulary consumers use."
                },
                "executable": {
                    "heavy": ["Imports", "Constants", "Variables"],
                    "light": ["CoreTypes", "InterfaceDefs", "CodeGeneration"],
                    "note": "Executables are config-rich. Their SETUP defines the runtime parameters."
                },
                "demo_test": {
                    "heavy": ["Imports", "Constants", "CoreTypes", "CodeGeneration"],
                    "light": ["Variables", "InterfaceDefs", "BuildTags"],
                    "note": "Tests are fixture-rich. Their SETUP defines expected values and assertion helpers."
                }
            },

            "placement_rules": {
                "must_be_in_setup": [
                    "import declarations",
                    "const blocks and individual const declarations",
                    "var blocks and package-level var declarations",
                    "type alias declarations (type X = Y)",
                    "type definitions (type X struct/interface/func)",
                    "Error type definitions and Error() method implementations",
                    "struct and interface definitions",
                    "Structural methods (Error, String, MarshalJSON, Unwrap)",
                    "go:generate directives",
                    "Build-tagged declarations"
                ],
                "must_not_be_in_setup": [
                    "func implementations with business logic (belongs in BODY)",
                    "Method implementations beyond structural completers (belongs in BODY)",
                    "Business logic of any kind",
                    "I/O operations",
                    "Network calls or database queries"
                ],
                "gray_area": {
                    "constructors": "New*() — defensible in SETUP for simple field assignment, BODY for complex construction with validation",
                    "type_methods": "Error()/String() complete the type → SETUP. Process()/Execute() add capability → BODY"
                }
            },

            "content_kind_mapping": {
                "_description": "Maps Go source-level content kinds to blocks and subsections. This is the machine-readable version of placement_rules — the linter reads this, not the human-readable lists above.",
                "block_placement": {
                    "import_decl": "SETUP",
                    "const_decl": "SETUP",
                    "var_decl": "SETUP",
                    "type_decl": "SETUP",
                    "func_decl": "BODY",
                    "method_decl": "BODY",
                    "init_func": "BODY"
                },
                "subsection_placement": {
                    "import_decl": "Imports",
                    "const_decl": "Constants",
                    "var_decl": "Variables",
                    "type_decl": "CoreTypes",
                    "method_decl": "TypeMethods"
                },
                "metadata_forbidden": [
                    "import_decl", "const_decl", "var_decl", "type_decl",
                    "func_decl", "method_decl", "init_func"
                ]
            },

            "go_requirements": {
                "package": { "required": true, "severity": "error", "note": "Templates have commented-out package declarations" },
                "import": { "recommended": true, "severity": "info" }
            }
        },

        // ═══════════════════════════════════════════════════════
        // BODY — core logic, APIs, operations
        // ═══════════════════════════════════════════════════════

        "BODY": {
            "purpose": "Core logic — helpers, operations, public APIs",
            "boundary": "// ============================================================================",
            "label": "// BODY",
            "end_marker": "// END BODY",
            "note": "BODY contains the actual Go functions — the reason the file exists",

            "subsection_order": {
                "note": "Unlike SETUP's universal 10-subsection structure, BODY subsections are subtype-specific. Each subtype has its own ordering principle reflecting the nature of its logic. Linter checks that present subsections appear in the documented sequence within each subtype.",
                "ordering_varies_by_subtype": true,
                "format": "// N. Name — numbered headers between 74-char ─ separators",
                "legacy_format": "§N — Name (backward-compatible, matched by BODY_SUBSECTION_LEGACY)",

                // ─── Library: execution flow (B1-B5) ───

                "library": {
                    "canonical_count": 5,
                    "ordering_principle": "execution_flow",
                    "note": "Library BODY follows the execution flow — from structure overview through helpers and core operations to the public surface. Consumers see the Public APIs; everything before serves them.",

                    "B1_OrgChart": {
                        "position": 1,
                        "tag": "OrgChart",
                        "pattern": "Org Chart",
                        "purpose": "Module structure overview — package relationships, internal organization, dependency graph",
                        "production_note": "Documents how the package fits in the larger system. In multi-file packages: shows which files handle what. Helps navigators understand the package before diving into code.",
                        "required_in": []
                    },
                    "B2_Helpers": {
                        "position": 2,
                        "tag": "Helpers",
                        "pattern": "Helpers",
                        "purpose": "Internal utility functions — private helpers that support core operations",
                        "production_note": "Private functions (lowercase) serving the core operations. Each does one thing. If a helper grows complex, extract to its own file. Helper tests belong in demo-test files, not inline.",
                        "required_in": []
                    },
                    "B3_CoreOperations": {
                        "position": 3,
                        "tag": "CoreOperations",
                        "pattern": "Core Operations",
                        "purpose": "Primary business logic — state transitions, computations, transformations",
                        "production_note": "Typically the heaviest BODY subsection. If it exceeds ~200 lines, extract into a separate file. Methods take receivers (value or pointer). Internal helpers belong in §2 when reused, inline when not.",
                        "required_in": []
                    },
                    "B4_ErrorHandling": {
                        "position": 4,
                        "tag": "ErrorHandling",
                        "pattern": "Error Handling",
                        "purpose": "Error processing, recovery, wrapping — functions that handle error conditions",
                        "production_note": "Error handling functions wrap, transform, or recover from errors. Error TYPES go in SETUP §5; error HANDLING goes here. Pattern: fmt.Errorf(\"package.Method: %w\", err) for consistent wrapping.",
                        "required_in": []
                    },
                    "B5_PublicAPIs": {
                        "position": 5,
                        "tag": "PublicAPIs",
                        "pattern": "Public APIs",
                        "purpose": "Exported functions — the package's public surface",
                        "production_note": "The functions consumers actually call. Keep thin — delegate to core operations (§3). Document every exported function with Go doc comments. If this section grows large, the package is doing too much.",
                        "required_in": ["library"]
                    }
                },

                // ─── Executable: execution flow (B1-B5) ───

                "executable": {
                    "canonical_count": 5,
                    "ordering_principle": "execution_flow",
                    "note": "Executable BODY follows execution flow — same structure as library. Entry point (main) and exit code mapping live in CLOSING Ce. BODY contains only the testable business logic.",

                    "B1_OrgChart": {
                        "position": 1,
                        "tag": "OrgChart",
                        "pattern": "Org Chart",
                        "purpose": "Module structure overview — command flow, subcommand relationships",
                        "production_note": "For CLI tools: documents the command tree. For servers: documents the route/handler structure.",
                        "required_in": []
                    },
                    "B2_Helpers": {
                        "position": 2,
                        "tag": "Helpers",
                        "pattern": "Helpers",
                        "purpose": "Internal utility functions — argument parsing, config loading, output formatting",
                        "production_note": "Private functions (fn, not pub fn) serving run(). Each does one thing run() needs. If a helper grows complex, extract to a library package.",
                        "required_in": []
                    },
                    "B3_CoreOperations": {
                        "position": 3,
                        "tag": "CoreOperations",
                        "pattern": "Core Operations",
                        "purpose": "The run() function — main business logic separated from main()",
                        "production_note": "run() → error pattern keeps logic testable. Structure: Initialize → Execute → Output → Return. If run() exceeds ~50 lines, extract steps into helpers (§2). Every fallible operation propagates errors up.",
                        "required_in": ["executable"]
                    },
                    "B4_ErrorHandling": {
                        "position": 4,
                        "tag": "ErrorHandling",
                        "pattern": "Error Handling",
                        "purpose": "Error processing and exit code mapping for the binary",
                        "production_note": "Maps internal errors to user-facing messages and exit codes. Pattern: func exitCode(err error) int. Exit codes defined in SETUP §2 Constants.",
                        "required_in": []
                    },
                    "B5_PublicAPIs": {
                        "position": 5,
                        "tag": "PublicAPIs",
                        "pattern": "Public APIs",
                        "purpose": "Exported functions — if the binary exposes a library interface",
                        "production_note": "Most executables have no public APIs. When present, they allow the binary's logic to be used as a library. Consider extracting to a separate package.",
                        "required_in": []
                    }
                },

                // ─── Demo-test: test concern coverage (B1-B5) ───

                "demo_test": {
                    "canonical_count": 5,
                    "ordering_principle": "concern_coverage",
                    "note": "Test BODY follows concern coverage — from structure through helpers and core tests to the test-specific functions that validate behavior.",

                    "B1_OrgChart": {
                        "position": 1,
                        "tag": "OrgChart",
                        "pattern": "Org Chart",
                        "purpose": "Test structure overview — what's being tested, test organization",
                        "production_note": "Documents the test strategy. Which aspects are covered, which are deferred. Helps future developers understand what's proven.",
                        "required_in": []
                    },
                    "B2_Helpers": {
                        "position": 2,
                        "tag": "Helpers",
                        "pattern": "Helpers",
                        "purpose": "Test helper functions — setup, teardown, assertion utilities",
                        "production_note": "Functions with t.Helper() call. Fixtures, temporary file creators, assertion wrappers. Keep them focused — a test helper that does too much hides what's actually being tested.",
                        "required_in": []
                    },
                    "B3_CoreOperations": {
                        "position": 3,
                        "tag": "CoreOperations",
                        "pattern": "Core Operations",
                        "purpose": "Core test operations — shared test logic and common patterns",
                        "production_note": "Functions that multiple tests call. Table-driven test runner wrappers, benchmark setup, common assertion sequences.",
                        "required_in": []
                    },
                    "B4_ErrorHandling": {
                        "position": 4,
                        "tag": "ErrorHandling",
                        "pattern": "Error Handling",
                        "purpose": "Error test helpers — functions that verify error conditions",
                        "production_note": "assertError(), requireError(), custom error matchers. Validates both that errors occur and that they carry the right context.",
                        "required_in": []
                    },
                    "B5_TestFunctions": {
                        "position": 5,
                        "tag": "TestFunctions",
                        "pattern": "Test Functions",
                        "purpose": "Test*() and Benchmark*() functions — the actual test cases",
                        "production_note": "The tests themselves. Name pattern: Test{Aspect}_{Scenario} (e.g., TestOpen_InvalidPath). Use subtests (t.Run) for table-driven patterns. Each test should be independent — no ordering dependency.",
                        "required_in": ["demo-test"]
                    }
                }
            },

            "production_design": {
                "principle": "BODY is the file's logic layer. Everything executable lives here, not scattered through SETUP. SETUP declares what exists; BODY defines what happens.",
                "scaling_signal": "If BODY exceeds ~500 lines, the file is doing too much. Extract logic into separate files. The subsection structure tells you where to cut.",
                "testing_pattern": "BODY code maps 1:1 to tests. Helper functions (§2) → helper tests. Core operations (§3) → operation tests. Public APIs (§5) → integration tests.",
                "refactoring_signal": "If methods for one type span multiple subsections (helpers in §2, core in §3, APIs in §5 for same type), that's correct — behavior organized by concern, not by type."
            },

            "subtype_emphasis": {
                "note": "Each subtype leans on different BODY subsections.",
                "library": {
                    "heavy": ["CoreOperations", "PublicAPIs"],
                    "light": ["OrgChart", "ErrorHandling"],
                    "note": "Libraries center on core operations and the public surface."
                },
                "executable": {
                    "heavy": ["Helpers", "CoreOperations"],
                    "light": ["OrgChart", "PublicAPIs"],
                    "note": "Executables center on the run() flow and its support functions."
                },
                "demo_test": {
                    "heavy": ["Helpers", "TestFunctions"],
                    "light": ["OrgChart", "CoreOperations"],
                    "note": "Tests center on fixtures/helpers and the test functions themselves."
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING — policy, reference, guidance
        // ═══════════════════════════════════════════════════════

        "CLOSING": {
            "purpose": "Validation → Execution → Cleanup. CLOSING proves the code works (tests), runs the code (entry point), and cleans up resources. Contains code zones (Cv/Ce/Cc) followed by documentation sections (X1-X6).",
            "principle": "CLOSING is the accountability block. Tests prove claims. Entry points handle the OS interface. Cleanup prevents leaks. Documentation sections guide maintainers. Code zones come FIRST (they do real work); documentation sections come AFTER (they guide future work).",
            "boundary": "// ============================================================================",
            "label": "// CLOSING",
            "end_marker": "// END CLOSING",
            "required": true,
            "severity": "error",

            "zone_ordering": {
                "note": "Code zones precede documentation sections. Ordering: Cv → Ce → Cc → X1 → X2 → X3 → X4 → X5 → X6.",
                "code_zones": ["Cv", "Ce", "Cc"],
                "documentation_sections": ["X1", "X2", "X3", "X4", "X5", "X6"],
                "ordering_principle": "prove_then_run_then_clean_then_document"
            },

            "code_zones": {
                "note": "Zones contain actual executable Go code. Zone NAMES are universal; zone CONTENT varies by subtype.",

                "Cv_Validation": {
                    "position": 1,
                    "tag": "Cv",
                    "pattern": "Cv — Closing Validation",
                    "purpose": "func Test* tests — prove code works",
                    "subtype_content": {
                        "library": "Package-level tests with table-driven patterns. Organize by BODY subsections.",
                        "executable": "Exit code mapping tests, error display tests, identity verification.",
                        "demo_test": "Meta-validation — tests that verify test infrastructure."
                    }
                },
                "Ce_Execution": {
                    "position": 2,
                    "tag": "Ce",
                    "pattern": "Ce — Closing Execution",
                    "purpose": "main(), init(), entry — the code that starts execution",
                    "subtype_content": {
                        "library": "init() for identity registration. Libraries have no main().",
                        "executable": "main() — thin entry delegating to run() (BODY). main() maps error to os.Exit; it contains no business logic.",
                        "demo_test": "TestMain() if needed for global test setup/teardown."
                    }
                },
                "Cc_Cleanup": {
                    "position": 3,
                    "tag": "Cc",
                    "pattern": "Cc — Closing Cleanup",
                    "purpose": "Close(), Shutdown(), defer cleanup — resource deallocation",
                    "subtype_content": {
                        "library": "Close/Shutdown methods for types owning resources (DB, files, network).",
                        "executable": "Process cleanup — temp files, buffer flushing, DB connections.",
                        "demo_test": "Test fixture teardown — cleanup functions, temp dir removal."
                    }
                }
            },

            "documentation_sections": {
                "note": "Documentation sections follow code zones. They guide maintainers, not compilers.",
                "X1_Policy": {
                    "tag": "X1", "pattern": "X1: Policy", "required": true,
                    "purpose": "Modification guidelines — never/careful/safe",
                    "fields": { "required": ["never", "careful", "safe"], "defined": ["scripture"] }
                },
                "X2_Extension": {
                    "tag": "X2", "pattern": "X2: Extension", "required": false,
                    "purpose": "Designed growth points"
                },
                "X3_Troubleshooting": {
                    "tag": "X3", "pattern": "X3: Troubleshooting", "required": false,
                    "purpose": "Common problems and solutions"
                },
                "X4_Reference": {
                    "tag": "X4", "pattern": "X4: Reference", "required": false,
                    "purpose": "Related files, deps, validation"
                },
                "X5_Note": {
                    "tag": "X5", "pattern": "X5: Note", "required": true,
                    "purpose": "Closing scripture anchor",
                    "fields": { "required": ["note", "scripture"], "defined": ["anchor"] }
                },
                "X6_Template": {
                    "tag": "X6", "pattern": "X6: Template", "required": false,
                    "template_only": true, "purpose": "Remove when instantiating"
                }
            },

            "subtype_emphasis": {
                "library": { "heavy": ["Cv"], "light": ["Ce", "Cc"], "note": "Libraries are test-rich." },
                "executable": { "heavy": ["Ce", "Cv"], "light": ["Cc"], "note": "Executables need entry points AND tests." },
                "demo_test": { "heavy": ["Cv", "Cc"], "light": ["Ce"], "note": "Test files need meta-validation AND fixture cleanup." }
            },

            "placement_rules": {
                "must_be_in_closing": [
                    "func Test* functions (Cv — package tests)",
                    "main() function (Ce — executable entry point)",
                    "init() function (Ce — identity registration for libraries)",
                    "Close/Shutdown methods (Cc — resource cleanup)",
                    "Test fixture teardown helpers (Cc — test cleanup)"
                ],
                "must_not_be_in_closing": [
                    "run() function (→ BODY — business logic must be testable independently)",
                    "Public API methods (→ BODY — they ARE the library)",
                    "Type definitions (→ SETUP — declarations belong in SETUP)",
                    "identity registration call site (→ Ce, not BODY)"
                ]
            }
        },

        // ═══════════════════════════════════════════════════════
        // FILL CONTENT — Schema-driven file generation templates
        // ═══════════════════════════════════════════════════════
        //
        // Used by `cws-struct create` and `cws-struct fill` to generate
        // complete 4-block Go files from schema alone. Placeholders use
        // {{name}} syntax — engine substitutes with context values.
        //
        // When this section can generate a file that `lint` validates
        // with 0 errors, the schema IS the complete specification.

        "fill_content": {
            "_description": "Templates for schema-driven file generation. Placeholders: {{key}}, {{title}}, {{format}}, {{subtype}}, {{version}}, {{date}}, {{organization}}, {{scripture}}, {{purpose}}, {{filename}}, {{package}}, {{consumers}}, {{from}}.",

            "defaults": {
                "version": "a-01.00",
                "status": "Active",
                "organization": "CreativeWorkzStudio LLC",
                "scripture": "Genesis 1:1",
                "scripture_text": "In the beginning God created the heaven and the earth.",
                "type": "code",
                "structure": "4-block"
            },

            "directives": [
                "//omni:key {{key}}",
                "//omni:code --go -{{subtype}}",
                "//omni:version {{version}}"
            ],

            "package_declaration": "package {{package}}",

            "identity_syntax": {
                "pragma": {
                    "declaration": "var Pragma = [][2]string{",
                    "entry": "\t{\"{{field}}\", \"{{value}}\"},",
                    "close": "}"
                },
                "metadata": {
                    "declaration": "var Metadata = [][2]string{",
                    "entry": "\t{\"{{field}}\", \"{{value}}\"},",
                    "close": "}"
                }
            },

            "pragma_entries": [
                ["I1.key", "{{key}}"],
                ["I1.format", "go"],
                ["I1.from", "{{from}}"],
                ["I1.at", "{{version}}"],
                ["I2.type", "code"],
                ["I2.structure", "4-block"],
                ["I2.subtype", "{{subtype}}"],
                ["I3.file", "{{filename}}"],
                ["I3.title", "{{title}}"]
            ],

            "metadata_entries": [
                ["C1.version", "{{version}}"],
                ["C1.status", "{{status}}"],
                ["C1.created", "{{date}}"],
                ["C1.updated", "{{date}}"],
                ["C2.organization", "{{organization}}"],
                ["C3.scripture", "{{scripture}}"],
                ["C4.requires.stdlib", "none"],
                ["C4.consumers", "{{consumers}}"]
            ],

            "metadata_comment": [
                "// Key:     {{key}}",
                "// Purpose: {{purpose}}"
            ],

            "closing_defaults": {
                "X1": {
                    "never": "Remove 4-block structure",
                    "careful": "Change public API signatures",
                    "safe": "Add new functions, types, constants"
                },
                "X5": {
                    "note": "{{purpose}}",
                    "scripture": "\"{{scripture_text}}\" — {{scripture}}"
                }
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Go validation is done by go.ts handler (14 checks → 77 atomic actions).
    // This section documents the validation contract and health scoring.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint go <file>",
    "_Cv_expected_state": "All block boundaries present in correct order (METADATA < SETUP < BODY < CLOSING) with //omni:key directive and END markers.",

    "validation_contract": {

        "checks_summary": {
            "total": 14,
            "version": "a-06.00",
            "checks": [
                "1. checkDirectives — //omni:key (required), //omni:code + //omni:version (recommended)",
                "2. checkBlockStructure — 4 blocks present, correct order, END markers",
                "3. checkPackageAndImports — package declaration, import statement",
                "4. checkPragmaMetadata — var Pragma (I1-I4) and var Metadata (C1-C7) [][2]string identity vars",
                "5. checkCommentMetadata — Key:, Purpose:, Biblical:, Version: in METADATA comments (secondary to Pragma/Metadata vars)",
                "6. checkSeparatorConsistency — 3-tier: = widths (76), ─ widths (74 U+2500), ASCII - (legacy)",
                "7. checkTemplateVsDerived — //go:build ignore for templates, not for derived",
                "8. checkSetupSectionOrder — 10-section dependency chain: Imports → Constants → Variables → TypeAliases → ErrorTypes → CoreTypes → InterfaceDefs → TypeMethods → CodeGeneration → BuildTags",
                "9. checkBodySubsectionOrder — ascending numeric // N. Name order (subtype-agnostic, matches Rust pattern)",
                "10. checkDirectiveFormat — //omni:code matches known patterns",
                "11. checkContentPlacement — declarations in correct blocks (imports in SETUP, funcs in BODY, etc.)",
                "12. checkClosingZoneOrder — Cv → Ce → Cc → X1 → X2 → X3 → X4 → X5 → X6 canonical order",
                "13. checkIdentityRegistration — Pragma exists but no init() runtime registration",
                "14. checkClosingContentPlacement — test funcs belong in Cv, main() belongs in Ce"
            ]
        },

        "directives": {
            "required_directives": ["//omni:key"],
            "recommended_directives": ["//omni:code", "//omni:version"],
            "template_directive": "// #!omni template --go -{subtype} + Pragma/Metadata vars with self-describing I/C values"
        },

        "blocks": {
            "required_markers": ["METADATA", "SETUP", "BODY", "CLOSING"],
            "end_markers": ["END METADATA", "END SETUP", "END BODY", "END CLOSING"],
            "order": "METADATA < SETUP < BODY < CLOSING",
            "block_severity": "error for derived, warn for templates",
            "end_severity": "warn"
        },

        "separators": {
            "block_width": 76,
            "block_char": "=",
            "setup_section_width": 74,
            "setup_section_char": "─",
            "setup_section_note": "Box Drawing Light Horizontal (U+2500) — 74 chars after '// '",
            "body_subsection_width": 74,
            "body_subsection_char": "─",
            "consistency_severity": "warn",
            "standard_severity": "info"
        },

        "identity": {
            "patterns": [
                "var Pragma = [][2]string{...} — Identity sections I1-I4",
                "var Metadata = [][2]string{...} — Context sections C1-C7"
            ],
            "field_requirements": {
                "I1_core": { "required": ["key", "format", "from", "at"] },
                "I2_family": { "required": ["type", "structure"], "defined": ["subtype", "role"] },
                "I3_instance": { "required": ["file", "title"], "defined": ["component", "path", "provides", "brief"] },
                "I4_architecture": { "defined": ["layer", "position", "pattern"] },
                "C1_state": { "required": ["version", "status"], "defined": ["created", "updated"] },
                "C2_attribution": { "required": ["organization"], "defined": ["architect", "implementation", "copyright"] },
                "C3_grounding": { "required": ["scripture"], "defined": ["principle", "anchor"] },
                "C4_dependencies": { "required": ["requires", "consumers"], "defined": ["integration", "if_missing"] },
                "C5_intent": { "defined": ["purpose", "philosophy"] },
                "C6_roadmap": { "defined": ["current", "planned", "limitations"] },
                "C7_classification": { "defined": ["tags", "category", "domain", "paradigm"] }
            },
            "delegation": "doc.go holds package-level identity — other files inherit",
            "severity_with_delegation": "info",
            "severity_without_delegation": "warn",
            "subtype_awareness": "I2.subtype determines valid file pattern, API surface, and block expectations — see subtypes in METADATA section"
        },

        "template_rules": {
            "pattern": "usable schema — template values describe the template itself, not placeholders",
            "build_ignore_required": true,
            "build_ignore_severity": "error",
            "derived_with_build_ignore_severity": "warn",
            "template_has_pragma_directive": "// #!omni template --go -{subtype}",
            "derived_has_omni_directive": "//omni:code --go -{subtype}",
            "identity_fields_self_describing": "I1.key = 'B-seed-code-L0-go-{subtype}', I3.file = '{subtype}.go', etc.",
            "copy_workflow": "cp template.go dest.go → change pragma → update I/C values for new file"
        },

        "transformer": {
            "capabilities": [
                "1. Fix block separator widths (= → 76 chars)",
                "2. Fix SETUP/BODY/CLOSING section divider widths (─ → 74 chars)",
                "3. Convert ASCII - separators to Unicode ─ (U+2500)",
                "4. Normalize separator prefix spacing (tab → 2 spaces)",
                "5. Add //go:build ignore to template files",
                "6. Move test functions from BODY to CLOSING Cv zone",
                "7. Move func main() from BODY to CLOSING Ce zone",
                "8. Reorder CLOSING zones to canonical order (Cv → Ce → Cc → X1-X5)",
                "9. Scaffold missing identity fields in Pragma/Metadata vars"
            ],
            "limitations": [
                "Does NOT inject missing block boundaries",
                "Does NOT add missing //omni: directives",
                "Does NOT reorder SETUP subsections (warns only)"
            ],
            "usage": "deno run --allow-read --allow-write mod.ts transform go <file>"
        },

        // ═══════════════════════════════════════════════════════
        // HEALTH SCORING — Go-specific extension of base contract
        // ═══════════════════════════════════════════════════════
        //
        // Extends: code/base/base-4block-schema.jsonc → $defs.health_scoring
        // Go adds 2 format-specific structural checks (package, import).
        //
        // File type variants:
        //   derived (non-doc.go): 99 total actions (full scoring)
        //   template: ~20 actions (block checks + build-ignore + template directives)
        //   doc.go: ~16 actions (block checks + separators only)

        "health_scoring": {
            "extends": "code/base/base-4block-schema.jsonc#/$defs/health_scoring",
            "description": "Go-specific health scoring — 99 atomic actions for derived non-doc.go files.",

            "go_specific_additions": {

                "structural": {
                    "container": "go-specific",
                    "block": "structural",
                    "checks": [
                        {
                            "check": "go/package",
                            "type": "atomic",
                            "count": 1,
                            "impact": "error",
                            "note": "package declaration present (skipped for templates)",
                            // atomic: 1 action. Pass: +1 × 2.0 = +2.0
                            "expected_pass_contribution": "+2.0"
                        },
                        {
                            "check": "go/import",
                            "type": "atomic",
                            "count": 1,
                            "impact": "info",
                            "note": "import statement present (informational)",
                            // atomic: 1 action. Pass: +1 × 0.25 = +0.25
                            "expected_pass_contribution": "+0.25"
                        }
                    ],
                    // 2 Go-specific structural actions
                    "expected_actions": 2,
                    "expected_pass_score_contribution": "+2.25"
                },

                "metadata_content": {
                    "description": "Go expresses I/C identity through var Pragma [][2]string and var Metadata [][2]string. The linter checks each field individually.",

                    "pragma_fields_I1_core": {
                        "required": ["key", "format", "from", "at"],
                        "defined": [],
                        "total_fields": 4,
                        "type": "compound",
                        "note": "I1 = WHO. Required fields are errors if missing; defined fields are info.",
                        // 4 atomic actions (all required → error weight 2.0 each)
                        "expected_pass_contribution": "+4.0"
                    },
                    "pragma_fields_I2_family": {
                        "required": ["type", "structure"],
                        "defined": ["subtype", "role"],
                        "total_fields": 4,
                        "type": "compound",
                        // 2 required (error 2.0) + 2 defined (info 0.25) = +4.5
                        "expected_pass_contribution": "+4.5"
                    },
                    "pragma_fields_I3_instance": {
                        "required": ["file", "title"],
                        "defined": ["component", "path", "provides", "brief"],
                        "total_fields": 6,
                        "type": "compound",
                        // 2 required (error 2.0) + 4 defined (info 0.25) = +5.0
                        "expected_pass_contribution": "+5.0"
                    },
                    "pragma_fields_I4_architecture": {
                        "required": [],
                        "defined": ["layer", "position", "pattern"],
                        "total_fields": 3,
                        "type": "compound",
                        // 3 defined (info 0.25) = +0.75
                        "expected_pass_contribution": "+0.75"
                    },

                    "metadata_fields_C1_state": {
                        "required": ["version", "status"],
                        "defined": ["created", "updated"],
                        "total_fields": 4,
                        "type": "compound",
                        // 2 required (error 2.0) + 2 defined (info 0.25) = +4.5
                        "expected_pass_contribution": "+4.5"
                    },
                    "metadata_fields_C2_attribution": {
                        "required": ["organization"],
                        "defined": ["architect", "implementation", "copyright"],
                        "total_fields": 4,
                        "type": "compound",
                        // 1 required (2.0) + 3 defined (0.25) = +2.75
                        "expected_pass_contribution": "+2.75"
                    },
                    "metadata_fields_C3_grounding": {
                        "required": ["scripture"],
                        "defined": ["principle", "anchor"],
                        "total_fields": 3,
                        "type": "compound",
                        // 1 required (2.0) + 2 defined (0.25) = +2.5
                        "expected_pass_contribution": "+2.5"
                    },
                    "metadata_fields_C4_dependencies": {
                        "required": ["requires", "consumers"],
                        "defined": ["integration", "if_missing"],
                        "total_fields": 4,
                        "type": "compound",
                        // 2 required (2.0) + 2 defined (0.25) = +4.5
                        "expected_pass_contribution": "+4.5"
                    },
                    "metadata_fields_C5_intent": {
                        "required": [],
                        "defined": ["purpose", "philosophy"],
                        "total_fields": 2,
                        "type": "compound",
                        // 2 defined (0.25) = +0.5
                        "expected_pass_contribution": "+0.5"
                    },
                    "metadata_fields_C6_roadmap": {
                        "required": [],
                        "defined": ["current", "planned", "limitations"],
                        "total_fields": 3,
                        "type": "compound",
                        // 3 defined (0.25) = +0.75
                        "expected_pass_contribution": "+0.75"
                    },
                    "metadata_fields_C7_classification": {
                        "required": [],
                        "defined": ["tags", "category", "domain", "paradigm"],
                        "total_fields": 4,
                        "type": "compound",
                        // 4 defined (0.25) = +1.0
                        "expected_pass_contribution": "+1.0"
                    },

                    "identity_total": {
                        "pragma_fields": 17,
                        "metadata_fields": 24,
                        "base_checks": 3,
                        "total": 44,
                        "note": "3 base (Pragma/empty + Metadata/empty + upgrade) + 17 Pragma I-fields + 24 Metadata C-fields"
                    }
                }
            },

            "action_summary_derived": {
                "structural_blocks": { "actions": 9, "type": "atomic", "note": "4 starts + 4 ends + 1 order" },
                "structural_separators": { "actions": 5, "type": "atomic", "note": "2 eq-width/standard + 2 box-width/standard + 1 dash-width" },
                "structural_go_specific": { "actions": 2, "type": "atomic", "note": "package + import" },
                "metadata_directives": { "actions": 4, "type": "atomic", "note": "1 required + 2 recommended + 1 code-format" },
                "metadata_identity": { "actions": 44, "type": "compound", "note": "3 base + 17 Pragma + 24 Metadata field checks" },
                "metadata_field_values": { "actions": 14, "type": "atomic", "note": "8 Pragma content (I1.key/format/from/at, I2.type/structure, I3.file/title) + 6 Metadata content (C1.version/status/created/updated, C2.org, C3.scripture)" },
                "metadata_comment_meta": { "actions": 2, "type": "atomic", "note": "biblical + version" },
                "metadata_derived": { "actions": 1, "type": "atomic", "note": "build-ignore check" },
                "setup_ordering": { "actions": 1, "type": "atomic", "note": "subsection order" },
                "setup_content": { "actions": 1, "type": "atomic", "note": "header-doc presence" },
                "placement": { "actions": 3, "type": "atomic", "note": "metadata-leak + block-placement + subsection-placement" },
                "body_ordering": { "actions": 1, "type": "atomic", "note": "subsection order" },
                "body_content": { "actions": 1, "type": "atomic", "note": "subtype subsection coverage" },
                "closing_zone_ordering": { "actions": 3, "type": "atomic", "note": "zone-order + code-zone-order + doc-section-order" },
                "closing_content_placement": { "actions": 2, "type": "atomic", "note": "test-placement + main-placement" },
                "closing_required_zones": { "actions": 2, "type": "atomic", "note": "X1 + X5 presence" },
                "closing_zone_content": { "actions": 2, "type": "atomic", "note": "X1 fields (never/careful/safe) + X5 fields (note/scripture)" },
                "scaling": { "actions": 2, "type": "atomic", "note": "setup-size + body-size" },
                "TOTAL": 99,
                "full_pass_score": "100/±100"
            },

            "action_summary_template": {
                "structural_blocks": 9,
                "structural_separators": 5,
                "metadata_directives": 2,
                "metadata_template": 1,
                "note": "Templates skip: go-specific, identity, comment-meta, derived, setup, placement, body, closing content",
                "TOTAL": 17,
                "full_pass_score": "100/±100"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════════
