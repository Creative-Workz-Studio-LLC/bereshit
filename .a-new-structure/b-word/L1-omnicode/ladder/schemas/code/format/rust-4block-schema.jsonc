{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-rust-4block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "b-03.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/format",
    "_P3_includes": "none",
    "_P3_provides": ["RUST_4BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust 4-Block Schema",
    "_P5_brief": "Defines how Rust source files implement OmniCode 4-block structure using // comments. Block boundaries, //omni: directives, PRAGMA/METADATA statics (slice or BTreeMap), //! doc comments, SETUP subsection ordering, BODY subtype-specific subsections, and CLOSING code zones (Cv/Ce/Cc) + documentation sections (X1-X6) — validated by the rust.ts linter.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-4block-schema.jsonc",
        "key": "B-L1-schemas-rust-4block-schema",
        "title": "Rust 4-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define how Rust source files express OmniCode 4-block structure through // comments, //omni: directives, and //! doc comments"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "b-03.00",
        "status": "Active",
        "created": "2026-02-15",
        "updated": "2026-02-18"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "1 Corinthians 14:40 — Let all things be done decently and in order.",
        "principle": "Rust enforces correctness at compile time. The 4-block structure extends that philosophy to file-level organization — the compiler catches logic errors, the linter catches structural drift. Two layers of accountability, both serving the same truth: order precedes creation."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "code/base/base-4block-schema.jsonc — shared 4-block $defs + health scoring; data/base/base-3block-schema.jsonc — shared I/C metadata $defs",
        "consumers": "c-tov/cws-struct/lib/handlers/rust.ts — runtime linter implements these rules",
        "cross_format": {
            "go_sibling": "b-word/L1-omnicode/ladder/schemas/go-4block-schema.jsonc — Go 4-block (also //-comment-based)",
            "makefile_sibling": "b-word/L1-omnicode/ladder/schemas/makefile-4block-schema.jsonc — Makefile 4-block (also comment-based)",
            "relationship": "Same OmniCode 4-block concepts, Rust-native expression via // comments, //! doc comments, and static identity"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Rust source files express 4-block structure through // comments:
    //   //omni:key B-crate-name            — identity directive
    //   //omni:code --rust -library         — type/format directive
    //   //omni:version a-01.00              — version directive
    //   //! Crate-level documentation       — Rust doc comments
    //   // ====...====                      — block boundary (76 = chars)
    //   // METADATA                         — block label
    //   // ────...────                      — subsection boundary (74 ─ chars)
    //   // END METADATA                     — block end marker
    //
    // Three file classifications:
    //   Template:    // #!omni template --rust -library (no compilation)
    //   Crate root:  lib.rs or main.rs — holds crate identity (PRAGMA/METADATA statics)
    //   Module file: Other .rs files — identity delegated to lib.rs
    //
    // Identity patterns:
    //   Slice-based:    pub static PRAGMA: &[(&str, &str)] = &[...]
    //   LazyLock-based: static PRAGMA: LazyLock<BTreeMap<&str, &str>>
    //   Both are valid — slice for lightweight, BTreeMap for runtime-queryable.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How Rust conventions map to 4-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "Rust — rustfmt-formatted source, // comments carry structural metadata, //! for doc comments",
    "_Cc_key_convention": "//omni: directives before first use/mod/fn, // block labels after doc comments",

    "format_mapping": {
        "note": "How OmniCode concepts map to Rust syntax",
        "identity_directives": "//omni:key, //omni:code, //omni:version — before first code or block marker",
        "doc_comments": "//! crate/module-level documentation — Rust-native, appears early in file",
        "block_boundaries": "// ====...==== (76 =) separator + // BLOCK_NAME label",
        "end_markers": "// END BLOCK_NAME — marks block end",
        "subsection_markers": "// ────...Label — Unicode box-drawing for subsection headers",
        "separators": "// ====...==== (76 chars) for blocks, // ────...──── (74 ─ chars) for subsections",
        "template_directive": "// #!omni template --rust -library (first structural line in templates)"
    },

    "comment_conventions": {
        "block_separator": "// ============================================================================",
        "block_label": "// METADATA | // SETUP | // BODY | // CLOSING",
        "end_marker": "// END METADATA | // END SETUP | // END BODY | // END CLOSING",
        "subsection_separator_unicode": "// ────────────────────────────────────────────────────────────────",
        "subsection_separator_ascii": "// ----------------------------------------------------------------",
        "doc_comment": "//! Crate-level or module-level documentation",
        "omni_directive": "//omni:key B-crate-name",
        "pragma_line": "// #!omni template --rust -library"
    },

    "file_classification": {
        "template": {
            "markers": ["// #!omni template"],
            "identity": "#!omni meta.key + PRAGMA/METADATA statics with self-describing values",
            "subtypes": ["--rust -library", "--rust -executable", "--rust -module", "--rust -demo-test", "--rust -bare-bone"],
            "note": "Templates use 'usable schema' pattern — all values describe the template ITSELF (no [bracketed] placeholders). When copied, values are changed to describe the new file."
        },
        "crate_root": {
            "files": ["lib.rs", "main.rs"],
            "identity": "PRAGMA/METADATA statics + //omni:key directive",
            "doc_comments": "//! crate-level docs recommended",
            "note": "Crate root holds identity for the entire crate. //omni:key is required here."
        },
        "module_file": {
            "identity": "Inherited from crate root (lib.rs)",
            "directives": "Optional — //omni: directives not required for module files",
            "blocks": "Optional — module files without block markers are valid",
            "note": "Module files that DO have //omni: or block markers get full validation"
        }
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete Rust 4-block structure definition.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "rust_structure": {

        // ═══════════════════════════════════════════════════════
        // DIRECTIVES — //omni: identity lines
        // ═══════════════════════════════════════════════════════

        "directives": {
            "purpose": "OmniCode identity directives — before first use/mod/fn or block marker",

            "required": {
                "//omni:key": {
                    "purpose": "Bereshit key — unique crate/file identifier",
                    "pattern": "//omni:key B-crate-path-name",
                    "severity_crate_root": "error",
                    "severity_module": "warn",
                    "example": "//omni:key B-L0-config"
                }
            },

            "recommended": {
                "//omni:code": {
                    "purpose": "File type and format classification",
                    "pattern": "//omni:code --rust -library | --rust -executable | --rust -module | --rust -demo-test | --rust -bare-bone",
                    "severity": "warn",
                    "known_values": ["--rust -library", "--rust -executable", "--rust -module", "--rust -demo-test", "--rust -bare-bone"]
                },
                "//omni:version": {
                    "purpose": "Living version",
                    "pattern": "//omni:version a-01.00",
                    "severity": "warn"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK
        // ═══════════════════════════════════════════════════════

        "METADATA": {
            "purpose": "File identity and context in // comments",
            "boundary": "// ============================================================================",
            "label": "// METADATA",
            "end_marker": "// END METADATA",
            "required": true,
            "severity": "error",

            "doc_comments": {
                "purpose": "//! crate-level or module-level Rust doc comments",
                "location": "Typically at the top of the file, before or near METADATA block",
                "crate_root_severity": "warn",
                "module_severity": "info"
            },

            "comment_fields": {
                "note": "Comment fields are SECONDARY to PRAGMA/METADATA statics. When I/C statics exist, these are informational only.",
                "Key": { "required": true, "severity": "warn", "note": "Downgraded to info if file has PRAGMA static with I1.key" },
                "Purpose": { "required": true, "severity": "warn", "note": "Downgraded to info if file has METADATA static with C5.purpose" },
                "Biblical/Scripture": { "recommended": true, "severity": "info", "note": "Downgraded to info if file has METADATA static with C3.scripture" },
                "Version": { "recommended": true, "severity": "info", "note": "Downgraded to info if file has METADATA static with C1.version" }
            },

            "identity_statics": {
                "note": "PRAGMA carries Identity (I1-I4), METADATA carries Context (C1-C7). Both are &[(&str, &str)] slices or BTreeMap statics.",

                "pragma_sections": {
                    "I1_core": { "required": ["key", "format", "from", "at"], "purpose": "WHO — unique identity" },
                    "I2_family": { "required": ["type", "structure"], "defined": ["subtype", "role"], "purpose": "WHAT — classification" },
                    "I3_instance": { "required": ["file", "title"], "defined": ["component", "path", "provides", "brief"], "purpose": "THIS — file-specific" },
                    "I4_architecture": { "defined": ["layer", "position", "pattern"], "purpose": "WHERE — structural context" }
                },

                "metadata_sections": {
                    "C1_state": { "required": ["version", "status"], "defined": ["created", "updated"], "purpose": "WHEN — lifecycle" },
                    "C2_attribution": { "required": ["organization"], "defined": ["architect", "implementation", "copyright"], "purpose": "WHO MADE — credit" },
                    "C3_grounding": { "required": ["scripture"], "defined": ["principle", "anchor"], "purpose": "WHY — biblical foundation" },
                    "C4_dependencies": { "required": ["requires", "consumers"], "defined": ["integration", "if_missing"], "purpose": "NEEDS — dependency graph" },
                    "C5_intent": { "defined": ["purpose", "philosophy"], "purpose": "GOAL — design intent" },
                    "C6_roadmap": { "defined": ["current", "planned", "limitations"], "purpose": "NEXT — trajectory" },
                    "C7_classification": { "defined": ["tags", "category", "domain", "paradigm"], "purpose": "TAGS — discovery" }
                },

                "field_format": {
                    "pragma_keys": "I{section}.{field} — e.g., I1.key, I2.type, I3.file, I4.layer",
                    "metadata_keys": "C{section}.{field} — e.g., C1.version, C2.organization, C3.scripture",
                    "nested_keys": "C4.requires.{category} — e.g., C4.requires.stdlib, C4.requires.external, C4.requires.internal"
                },

                "slice_pattern": {
                    "pragma": "pub static PRAGMA: &[(&str, &str)] = &[(\"I1.key\", \"...\"), (\"I1.format\", \"...\"), ...]",
                    "metadata": "pub static METADATA: &[(&str, &str)] = &[(\"C1.version\", \"...\"), (\"C1.status\", \"...\"), ...]",
                    "use_when": "Lightweight crates — no runtime allocation"
                },
                "btreemap_pattern": {
                    "pragma": "static PRAGMA: LazyLock<BTreeMap<&str, &str>> = LazyLock::new(|| { ... })",
                    "metadata": "static METADATA: LazyLock<BTreeMap<&str, &str>> = LazyLock::new(|| { ... })",
                    "use_when": "Crates needing runtime-queryable identity (lookups by key)"
                },
                "own_pattern": {
                    "pragma": "static OWN_PRAGMA: ... (identity crate self-registration)",
                    "note": "Identity crate uses OWN_PRAGMA to avoid naming collision with its public API"
                },
                "delegated_identity": {
                    "pattern": "pub mod identity;",
                    "note": "Config crate pattern — identity lives in a submodule",
                    "severity": "info"
                },
                "severity_crate_root": "warn",
                "severity_module": "not checked (identity delegated to lib.rs)"
            },

            "subtypes": {
                "note": "Five form subtypes — same I/C structure, different valid values for I2.subtype and file patterns. bare_bone is the foundation; all others derive from it.",

                "library": {
                    "I2_subtype": "library",
                    "file_pattern": "lib.rs",
                    "pragma_directive": "//omni:code --rust -library",
                    "template_directive": "// #!omni template --rust -library",
                    "has_public_api": true,
                    "has_tests_block": true,
                    "purpose": "Library crate root — exposes public API, holds crate identity"
                },
                "executable": {
                    "I2_subtype": "executable",
                    "file_pattern": "main.rs",
                    "pragma_directive": "//omni:code --rust -executable",
                    "template_directive": "// #!omni template --rust -executable",
                    "has_public_api": false,
                    "has_tests_block": false,
                    "purpose": "Binary crate — orchestrates via main() → run() → Result pattern"
                },
                "module": {
                    "I2_subtype": "module",
                    "file_pattern": "src/*.rs (non-root module files)",
                    "pragma_directive": "//omni:code --rust -module",
                    "template_directive": "// #!omni template --rust -module",
                    "has_public_api": false,
                    "has_tests_block": true,
                    "purpose": "Internal module — focused single-concern file within a crate (src/parser.rs, src/config.rs)"
                },
                "demo_test": {
                    "I2_subtype": "demo-test",
                    "file_pattern": "tests/*.rs or #[cfg(test)] mod tests",
                    "pragma_directive": "//omni:code --rust -demo-test",
                    "template_directive": "// #!omni template --rust -demo-test",
                    "has_public_api": false,
                    "has_tests_block": true,
                    "purpose": "Test file — validates crate behavior, proves claims"
                },
                "bare_bone": {
                    "I2_subtype": "bare-bone",
                    "file_pattern": "bare-bone.rs (template only — foundation all forms derive from)",
                    "pragma_directive": "//omni:code --rust -bare-bone",
                    "template_directive": "// #!omni template --rust -bare-bone",
                    "has_public_api": false,
                    "has_tests_block": false,
                    "purpose": "Foundation template — minimum valid file, all other forms derive from this"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // SETUP BLOCK
        // ═══════════════════════════════════════════════════════

        "SETUP": {
            "purpose": "Declarations and data — everything the BODY needs to EXIST before logic runs. SETUP makes things EXIST; BODY makes things HAPPEN.",
            "principle": "If BODY is pure logic, hardcoded values have exactly one address: SETUP. This is the file's local config layer — what lives in SETUP today moves to config tomorrow; BODY never changes.",
            "boundary": "// ============================================================================",
            "label": "// SETUP",
            "end_marker": "// END SETUP",
            "required": true,
            "severity": "error",

            "subsection_order": {
                "note": "Canonical order follows the Rust dependency chain — each subsection can reference only what came before it. Linter checks that present subsections appear in this sequence. Not all 10 are required — only those with content should appear.",
                "canonical_count": 10,
                "ordering_principle": "dependency_chain",

                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "pattern": "Imports",
                    "purpose": "use declarations — external crates, std library, internal modules",
                    "production_note": "Group by origin: std → external → internal → super/self. Wildcard imports (use foo::*) are a code smell in production — import what you use.",
                    "required_in": ["library", "executable", "demo-test"]
                },
                "S2_Modules": {
                    "position": 2,
                    "tag": "Modules",
                    "pattern": "Module Declarations",
                    "alt_patterns": ["Modules", "Re-exports"],
                    "purpose": "mod declarations and pub use re-exports — defines the crate's public surface",
                    "production_note": "Module tree IS the API. What you re-export here is what consumers see. Think about it like a storefront — curate deliberately.",
                    "required_in": ["library"]
                },
                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "pattern": "Constants",
                    "alt_patterns": ["Consts"],
                    "purpose": "const values — compile-time known, zero-cost, inlined by compiler",
                    "production_note": "Every magic number in BODY should be a named constant here. Exit codes, buffer sizes, retry counts, version strings, default values — if it is hardcoded, it lives here. When the system scales, these migrate to config; BODY stays unchanged.",
                    "required_in": ["executable"]
                },
                "S4_Statics": {
                    "position": 4,
                    "tag": "Statics",
                    "pattern": "Statics",
                    "purpose": "static values — runtime-initialized singletons (LazyLock, OnceLock, AtomicU64)",
                    "production_note": "Statics are your crate's process-wide shared state: connection pools, compiled regexes, metric counters, cached config. Use LazyLock for complex init, OnceLock for runtime-provided values, atomics for counters. In tests, AVOID mutable statics — parallel test execution creates race conditions.",
                    "required_in": []
                },
                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "pattern": "Type Aliases",
                    "purpose": "type aliases — domain vocabulary without new types (type Result<T> = std::result::Result<T, Error>)",
                    "production_note": "Type aliases are your crate's vocabulary layer. Result<T>, HashMap shortcuts, callback signatures — they make BODY code read like domain language. A well-aliased crate tells you what it does by how its types read.",
                    "required_in": []
                },
                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "pattern": "Error Types",
                    "alt_patterns": ["Errors"],
                    "purpose": "Error enums, Display/Error impls, From conversions — the crate's failure vocabulary",
                    "production_note": "Error types define how your crate fails. In production: thiserror for library errors (callers handle them), anyhow for binary errors (humans read them). From impls go HERE, not in BODY — they are type conversions, not logic. A crate's error type is its most important API surface after its happy path.",
                    "required_in": ["library"]
                },
                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "pattern": "Core Types",
                    "alt_patterns": ["Types", "Structs", "Data Types"],
                    "purpose": "Primary structs and enums — the data shapes BODY logic operates on",
                    "production_note": "These are the nouns of your system. Structs carry state; enums model choices. In production: derive Debug always, Clone when safe, Serialize/Deserialize for boundaries. Keep types flat — deeply nested types are a sign of missing abstractions. Builder pattern for complex construction belongs in BODY, not here.",
                    "required_in": ["library"]
                },
                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "pattern": "Trait Definitions",
                    "alt_patterns": ["Trait Defs", "Traits"],
                    "purpose": "Trait definitions and blanket impls — the contracts BODY implementations fulfill",
                    "production_note": "Traits define the extension points of your system. In production: keep trait surfaces small (1-3 methods), use associated types for output types, provide default implementations where the default is obvious. Trait definitions are SETUP (they declare contracts); trait implementations are BODY (they fulfill contracts).",
                    "required_in": []
                },
                "S9_Macros": {
                    "position": 9,
                    "tag": "Macros",
                    "pattern": "Macros",
                    "alt_patterns": ["Assertion Helpers"],
                    "purpose": "macro_rules! definitions — compile-time code generation for repeated patterns",
                    "production_note": "Macros are SETUP because they generate code that BODY uses. In production: prefer functions over macros unless you need compile-time codegen. In tests: assertion macros (assert_eq_json!, assert_db_state!) are the RIGHT use — they eliminate boilerplate without hiding logic. Document macro syntax — future you will forget.",
                    "required_in": []
                },
                "S10_FeatureGates": {
                    "position": 10,
                    "tag": "FeatureGates",
                    "pattern": "Feature Gates",
                    "purpose": "cfg(feature) conditional compilation and platform-specific declarations",
                    "production_note": "Feature gates are SETUP's config mechanism at compile time. In production: feature flags control what gets compiled into the binary — optional deps, platform code, debug-only tooling. Last in SETUP because they modify what earlier subsections declared. Keep feature names descriptive; 'extra' tells you nothing.",
                    "required_in": []
                }
            },

            "production_design": {
                "principle": "SETUP is the file's local config layer. Everything hardcoded lives here, not scattered through BODY. This creates a single address for every value, a clear upgrade path to external config, and a BODY block that is pure logic.",
                "caching_strategy": "Statics subsection (S4) holds process-wide cached state via LazyLock/OnceLock. This is NOT ad-hoc caching — it is the Rust equivalent of a singleton registry. Connection pools, compiled regexes, parsed config — initialize once, use everywhere.",
                "memory_model": "Constants (S3) are zero-cost — compiled away. Statics (S4) allocate once at process start. Core Types (S7) define the shapes that determine your memory layout. Production Rust cares about allocation: stack vs heap, owned vs borrowed, sized vs unsized. SETUP is where these decisions are declared.",
                "storage_pattern": "The SETUP/BODY separation mirrors the data/logic split in database design. SETUP is your schema (what exists); BODY is your queries (what happens). When SETUP is clean, you can reason about data flow without reading logic.",
                "scaling_signal": "If SETUP grows past 200 lines, the file is doing too much. Extract types into a types.rs module, errors into error.rs, constants into constants.rs. The subsection structure tells you exactly where to cut."
            },

            "subtype_emphasis": {
                "note": "Each subtype leans on different SETUP subsections. The 10-subsection structure is universal; the weight distribution is subtype-specific.",
                "library": {
                    "heavy": ["Imports", "Modules", "ErrorTypes", "CoreTypes", "TraitDefs"],
                    "light": ["Constants", "Statics", "Macros"],
                    "note": "Libraries are type-rich. Their SETUP defines the vocabulary consumers use."
                },
                "executable": {
                    "heavy": ["Imports", "Constants", "Statics"],
                    "light": ["Modules", "CoreTypes", "TraitDefs", "Macros"],
                    "note": "Executables are config-rich. Their SETUP defines the runtime parameters."
                },
                "module": {
                    "heavy": ["Imports", "CoreTypes", "TraitDefs"],
                    "light": ["Constants", "Statics", "TypeAliases"],
                    "note": "Modules are focused. Their SETUP imports what they need and defines the types for their single concern. No Modules/Macros/FeatureGates (crate-level)."
                },
                "demo_test": {
                    "heavy": ["Imports", "Constants", "CoreTypes", "Macros"],
                    "light": ["Modules", "Statics", "TraitDefs", "FeatureGates"],
                    "note": "Tests are fixture-rich. Their SETUP defines expected values and assertion helpers."
                },
                "bare_bone": {
                    "heavy": ["Imports"],
                    "light": ["Constants", "CoreTypes"],
                    "note": "Bare-bone is minimal. Most SETUP subsections are RESERVED (available for promotion in derived forms). Only Imports, Constants, CoreTypes are available."
                }
            },

            "placement_rules": {
                "must_be_in_setup": [
                    "use declarations (imports)",
                    "mod declarations and re-exports",
                    "const definitions",
                    "static definitions (LazyLock, OnceLock, atomic)",
                    "type aliases",
                    "Error enum definitions and Display/From impls",
                    "struct and enum definitions (data shapes)",
                    "trait definitions (contracts)",
                    "macro_rules! definitions",
                    "cfg(feature) conditional declarations"
                ],
                "must_not_be_in_setup": [
                    "fn implementations (logic belongs in BODY)",
                    "impl blocks with methods (behavior belongs in BODY)",
                    "trait implementations beyond From/Display (logic belongs in BODY)",
                    "Business logic of any kind",
                    "I/O operations",
                    "Network calls or database queries"
                ],
                "gray_area": {
                    "constructors": "new()/default() — defensible in SETUP for simple types, BODY for complex construction",
                    "from_impls": "From/Into conversions are type-level operations, not logic — SETUP is the right place",
                    "display_impls": "Display/Debug impls complete the type definition — SETUP"
                }
            },

            "content_kind_mapping": {
                "_description": "Maps Rust source-level content kinds to blocks and subsections. This is the machine-readable version of placement_rules — the linter reads this, not the human-readable lists above.",
                "block_placement": {
                    "use_decl": "SETUP",
                    "reexport_decl": "SETUP",
                    "mod_decl": "SETUP",
                    "const_decl": "SETUP",
                    "static_decl": "SETUP",
                    "type_alias": "SETUP",
                    "struct_decl": "SETUP",
                    "enum_decl": "SETUP",
                    "trait_decl": "SETUP",
                    "macro_decl": "SETUP",
                    "fn_decl": "BODY",
                    "impl_block": "BODY"
                },
                "subsection_placement": {
                    "use_decl": "Imports",
                    "reexport_decl": "Modules",
                    "mod_decl": "Modules",
                    "const_decl": "Constants",
                    "static_decl": "Statics",
                    "type_alias": "TypeAliases",
                    "struct_decl": "CoreTypes",
                    "enum_decl": "CoreTypes",
                    "trait_decl": "TraitDefs",
                    "macro_decl": "Macros"
                },
                "metadata_forbidden": [
                    "use_decl", "reexport_decl", "mod_decl", "const_decl", "static_decl", "type_alias",
                    "struct_decl", "enum_decl", "trait_decl", "macro_decl",
                    "fn_decl", "impl_block"
                ]
            }
        },

        // ═══════════════════════════════════════════════════════
        // BODY
        // ═══════════════════════════════════════════════════════

        "BODY": {
            "purpose": "Core logic — BODY makes things HAPPEN. SETUP made things EXIST.",
            "principle": "BODY/SETUP mirrors behavior/data: SETUP is the schema (what exists), BODY is the queries (what happens). If BODY needs a new type or constant, it belongs in SETUP. BODY only contains impl blocks, free functions, and trait implementations.",
            "boundary": "// ============================================================================",
            "label": "// BODY",
            "end_marker": "// END BODY",
            "required": true,
            "severity": "error",

            "subsection_order": {
                "note": "Unlike SETUP's universal 10-subsection structure, BODY subsections are subtype-specific. Each subtype has its own ordering principle reflecting the nature of its logic. Linter checks that present subsections appear in the documented sequence within each subtype.",
                "ordering_varies_by_subtype": true,

                // ─── Library: type lifecycle (B1-B7) ───

                "library": {
                    "canonical_count": 7,
                    "ordering_principle": "type_lifecycle",
                    "note": "Library BODY follows the type lifecycle — from identity through creation, operation, observation, to output. Mirrors how a consumer uses the library: discover identity, construct types, operate on them, query results, format output.",

                    "B1_IdentityAccess": {
                        "position": 1,
                        "tag": "IdentityAccess",
                        "pattern": "Identity Access",
                        "purpose": "OmniCode static accessor functions — pragma(), pragma_get(), metadata(), metadata_get()",
                        "production_note": "Universal — every crate has these. Four functions providing runtime access to compile-time identity data. Go first because they don't depend on any other BODY logic.",
                        "required_in": ["library"]
                    },
                    "B2_TraitImplementations": {
                        "position": 2,
                        "tag": "TraitImplementations",
                        "pattern": "Trait Implementations",
                        "alt_patterns": ["Trait Impls"],
                        "purpose": "Behavioral trait impls — fulfilling contracts declared in SETUP §8",
                        "production_note": "SETUP keeps completing impls (Display, Error, From, Default — they complete the type). BODY gets behavioral impls (Iterator, Read, Write, custom traits — they add capabilities). The test: removing it makes the type incomplete → SETUP. Removing it removes a capability → BODY.",
                        "required_in": []
                    },
                    "B3_Constructors": {
                        "position": 3,
                        "tag": "Constructors",
                        "pattern": "Constructors & Builders",
                        "alt_patterns": ["Constructors", "Builders"],
                        "purpose": "new(), builders, typestate transitions — how types come into existence",
                        "production_note": "Three patterns: simple (new → Self), builder (new.with_x.with_y → Self), typestate (new.with_x.transition → ValidatedType). Simple new() with field assignment only is defensible in SETUP §7. Complex construction with validation → always BODY §3.",
                        "required_in": ["library"]
                    },
                    "B4_CoreLogic": {
                        "position": 4,
                        "tag": "CoreLogic",
                        "pattern": "Core Logic",
                        "alt_patterns": ["Core Operations"],
                        "purpose": "Primary operations — state transitions, computations, transformations, business rules",
                        "production_note": "Typically the heaviest BODY subsection. If it exceeds ~200 lines, extract into a submodule. Methods take &self (read) or &mut self (mutate). Internal helpers (fn, not pub fn) belong here near the functions that call them.",
                        "required_in": []
                    },
                    "B5_Queries": {
                        "position": 5,
                        "tag": "Queries",
                        "pattern": "Queries & Accessors",
                        "alt_patterns": ["Queries", "Accessors"],
                        "purpose": "Read-only &self methods — getters, predicates, computed properties",
                        "production_note": "In typestate patterns, queries belong on the post-transition type. Naming: .name() for getters, .is_valid() for predicates, .count() for computed, .items() for slices. Keep thin — if a getter does significant computation, it's core logic (§4).",
                        "required_in": []
                    },
                    "B6_Output": {
                        "position": 6,
                        "tag": "Output",
                        "pattern": "Output & Display",
                        "alt_patterns": ["Output", "Output Helpers"],
                        "purpose": "Formatters, display helpers, serialization, output builder types",
                        "production_note": "Output is the user interface of a library. Includes free functions (fatal, error, warn), builder-pattern output types, serialization helpers. Use stderr for diagnostics, stdout for data. Simple Display stays in SETUP; complex formatting goes here.",
                        "required_in": []
                    },
                    "B7_FreeFunctions": {
                        "position": 7,
                        "tag": "FreeFunctions",
                        "pattern": "Free Functions",
                        "purpose": "Module-level public functions — convenience wrappers, facades, register_identity()",
                        "production_note": "Functions not attached to any type. Where register_identity() lives for L0 identity system. If this section grows large, consider whether types would make the API clearer.",
                        "required_in": []
                    }
                },

                // ─── Executable: execution flow (B1-B3) ───
                //
                // Entry point (main) and error-to-exit-code mapping (exit_code)
                // live in CLOSING Ce — they handle the OS interface, not business
                // logic. BODY contains only the testable business logic.

                "executable": {
                    "canonical_count": 3,
                    "ordering_principle": "execution_flow",
                    "note": "Executable BODY follows execution flow — code reads in the order it runs. Executables orchestrate; actual computation lives in library crates. Entry point (main) and exit code mapping live in CLOSING Ce.",

                    "B1_IdentityAccess": {
                        "position": 1,
                        "tag": "IdentityAccess",
                        "pattern": "Identity Access",
                        "purpose": "OmniCode static accessor functions — same four as library",
                        "production_note": "Optional for binaries that don't need runtime identity access. Recommended for project consistency.",
                        "required_in": []
                    },
                    "B2_Helpers": {
                        "position": 2,
                        "tag": "Helpers",
                        "pattern": "Helpers",
                        "purpose": "Argument parsing, config loading, output formatting — support for run()",
                        "production_note": "Private functions (fn, not pub fn) serving the core operation. Each does one thing run() needs. If a helper grows complex, extract to a library crate.",
                        "required_in": ["executable"]
                    },
                    "B3_CoreOperations": {
                        "position": 3,
                        "tag": "CoreOperations",
                        "pattern": "Core Operations",
                        "purpose": "The run() function — main business logic separated from main()",
                        "production_note": "run() → Result pattern keeps logic testable. Structure: Initialize → Execute → Output → Return. If run() exceeds ~50 lines, extract steps into helpers (§2). Every fallible operation uses ? to propagate errors.",
                        "required_in": ["executable"]
                    }
                },

                // ─── Module: type lifecycle (B1-B5, B7) ───
                //
                // Module follows library's type_lifecycle ordering but RESERVES
                // B6 (Output — crate-level concern). Modules are members of the
                // body (1 Cor 12:18), not the body itself.

                "module": {
                    "canonical_count": 6,
                    "ordering_principle": "type_lifecycle",
                    "note": "Module BODY follows the same type lifecycle as library — identity, traits, construction, logic, queries, free functions — but RESERVES B6 Output (crate-level display/formatting belongs in lib.rs). Modules are focused single-concern files.",

                    "B1_IdentityAccess": {
                        "position": 1,
                        "tag": "IdentityAccess",
                        "pattern": "Identity Access",
                        "purpose": "Optional — module-level identity accessors (rare, usually crate root only)",
                        "production_note": "Most modules don't need this. Include only if the module exposes its own identity.",
                        "required_in": []
                    },
                    "B2_TraitImplementations": {
                        "position": 2,
                        "tag": "TraitImplementations",
                        "pattern": "Trait Implementations",
                        "alt_patterns": ["Trait Impls"],
                        "purpose": "Behavioral trait impls for types defined in this module's SETUP",
                        "production_note": "Same SETUP/BODY split as library: completing impls (Display, From) stay in SETUP; behavioral impls (Iterator, custom traits) go here.",
                        "required_in": []
                    },
                    "B3_Constructors": {
                        "position": 3,
                        "tag": "Constructors",
                        "pattern": "Constructors & Builders",
                        "alt_patterns": ["Constructors", "Builders"],
                        "purpose": "new(), builders, typestate transitions for this module's types",
                        "production_note": "Same patterns as library. Simple new() defensible in SETUP §7; complex construction with validation → BODY §3.",
                        "required_in": []
                    },
                    "B4_CoreLogic": {
                        "position": 4,
                        "tag": "CoreLogic",
                        "pattern": "Core Logic",
                        "alt_patterns": ["Core Operations"],
                        "purpose": "Primary operations — the module's single concern expressed as logic",
                        "production_note": "This IS the module. If CoreLogic exceeds ~200 lines, the module may need splitting into sub-modules.",
                        "required_in": []
                    },
                    "B5_Queries": {
                        "position": 5,
                        "tag": "Queries",
                        "pattern": "Queries & Accessors",
                        "alt_patterns": ["Queries", "Accessors"],
                        "purpose": "Read-only &self methods for this module's types",
                        "production_note": "Same conventions as library. Thin getters, predicates, computed properties.",
                        "required_in": []
                    },
                    "B7_FreeFunctions": {
                        "position": 6,
                        "tag": "FreeFunctions",
                        "pattern": "Free Functions",
                        "purpose": "Module-level utility functions not attached to types",
                        "production_note": "Convenience wrappers and helpers. If this grows large, consider whether the module needs splitting.",
                        "required_in": []
                    }
                },

                // ─── Bare-bone: universal (B1, B4, B7) ───
                //
                // The foundation all forms derive from. Only three BODY
                // subsections — most are RESERVED for promotion in derived forms.

                "bare_bone": {
                    "canonical_count": 3,
                    "ordering_principle": "universal",
                    "note": "Bare-bone BODY is the minimum — identity, core logic, free functions. All other subsections are RESERVED, available for promotion in derived forms.",

                    "B1_IdentityAccess": {
                        "position": 1,
                        "tag": "IdentityAccess",
                        "pattern": "Identity Access",
                        "purpose": "OmniCode static accessor functions",
                        "production_note": "Universal across all forms. The one subsection every form inherits.",
                        "required_in": []
                    },
                    "B4_CoreLogic": {
                        "position": 2,
                        "tag": "CoreLogic",
                        "pattern": "Core Logic",
                        "purpose": "Primary operations — the absolute minimum logic",
                        "production_note": "Bare-bone keeps only the core. Trait impls, constructors, queries, output → promoted in derived forms.",
                        "required_in": []
                    },
                    "B7_FreeFunctions": {
                        "position": 3,
                        "tag": "FreeFunctions",
                        "pattern": "Free Functions",
                        "purpose": "Module-level utilities",
                        "production_note": "register_identity() and minimal utilities.",
                        "required_in": []
                    }
                },

                // ─── Demo-test: concern coverage (B1-B9) ───

                "demo_test": {
                    "canonical_count": 9,
                    "ordering_principle": "concern_coverage",
                    "note": "Test BODY follows concern coverage — from construction through the full type lifecycle to integration. Mirrors how the crate is built.",

                    "B1_ConstructorTests": {
                        "position": 1,
                        "tag": "ConstructorTests",
                        "pattern": "Constructor Tests",
                        "purpose": "Verify new() creates types with correct default state",
                        "production_note": "Baseline tests — if construction is wrong, everything after is meaningless. Test required params, optional fields (None/false), empty strings.",
                        "required_in": []
                    },
                    "B2_BuilderTests": {
                        "position": 2,
                        "tag": "BuilderTests",
                        "pattern": "Builder Tests",
                        "purpose": "Verify with_*() configuration methods individually and chained",
                        "production_note": "Builder methods consume self — verify chaining works and each method only affects its own field.",
                        "required_in": []
                    },
                    "B3_TransitionTests": {
                        "position": 3,
                        "tag": "TransitionTests",
                        "pattern": "Transition Tests",
                        "purpose": "Verify typestate transitions and validation logic",
                        "production_note": "Most important section — the transition is where validation happens and guarantees are established. Test both success and error paths.",
                        "required_in": []
                    },
                    "B4_QueryTests": {
                        "position": 4,
                        "tag": "QueryTests",
                        "pattern": "Query & Accessor Tests",
                        "alt_patterns": ["Query Tests", "Accessor Tests"],
                        "purpose": "Verify post-transition accessors return correct values",
                        "production_note": "Tests the read side — that the validated type exposes state correctly through its public API.",
                        "required_in": []
                    },
                    "B5_IdentityTests": {
                        "position": 5,
                        "tag": "IdentityTests",
                        "pattern": "Identity Tests",
                        "purpose": "Verify PRAGMA/METADATA static data integrity",
                        "production_note": "Catches typos, stale values, missing fields. Check I1.key, I1.format, missing keys → None, grounding scripture present.",
                        "required_in": []
                    },
                    "B6_ErrorTests": {
                        "position": 6,
                        "tag": "ErrorTests",
                        "pattern": "Error Tests",
                        "alt_patterns": ["Error Display Tests"],
                        "purpose": "Verify error Display formatting and error conditions",
                        "production_note": "Each variant should produce a clear message. Construct error → assert Display. Ensures error messages don't regress.",
                        "required_in": []
                    },
                    "B7_EdgeCaseTests": {
                        "position": 7,
                        "tag": "EdgeCaseTests",
                        "pattern": "Edge Case Tests",
                        "purpose": "Boundary conditions — Unicode, empty, long, special characters",
                        "production_note": "Catch assumptions that work for typical data but fail at edges. If an edge case reveals a bug, fix it AND keep the test.",
                        "required_in": []
                    },
                    "B8_TableDrivenTests": {
                        "position": 8,
                        "tag": "TableDrivenTests",
                        "pattern": "Table-Driven Tests",
                        "purpose": "Systematic input/output validation using Vec of test cases",
                        "production_note": "Use when multiple inputs produce different outputs and logic is the same. Name each case — failures are immediately diagnosable.",
                        "required_in": []
                    },
                    "B9_IntegrationTests": {
                        "position": 9,
                        "tag": "IntegrationTests",
                        "pattern": "Integration Tests",
                        "purpose": "End-to-end workflows — full construct → configure → transition → query pipeline",
                        "production_note": "For tests/ directory: public API only. For inline: full pipeline. If they pass, the crate works as documented.",
                        "required_in": []
                    }
                }
            },

            "production_design": {
                "principle": "BODY is the file's logic layer. Everything executable lives here, not scattered through SETUP. SETUP declares what exists; BODY defines what happens.",
                "scaling_signal": "If BODY exceeds ~500 lines, the file is doing too much. Extract logic into submodules (add to SETUP §2). The subsection structure tells you where to cut.",
                "testing_pattern": "BODY code maps 1:1 to tests. Constructor methods (§3) → constructor tests. Core logic (§4) → operation tests. Queries (§5) → accessor tests.",
                "refactoring_signal": "If impl blocks span multiple subsections (constructor in §3, core in §4, queries in §5 for same type), that's correct — behavior organized by concern, not by type."
            },

            "subtype_emphasis": {
                "note": "Each subtype leans on different BODY subsections.",
                "library": {
                    "heavy": ["Constructors", "CoreLogic", "Queries"],
                    "light": ["TraitImplementations", "Output", "FreeFunctions"],
                    "note": "Libraries are logic-rich. Their BODY defines how types behave."
                },
                "executable": {
                    "heavy": ["Helpers", "CoreOperations"],
                    "light": ["IdentityAccess"],
                    "note": "Executables are orchestration-rich. Their BODY wires library logic together. Entry point and exit code mapping live in CLOSING Ce."
                },
                "module": {
                    "heavy": ["CoreLogic", "Constructors", "Queries"],
                    "light": ["TraitImplementations", "FreeFunctions"],
                    "note": "Modules are focused. Their BODY handles one concern well. No Output section (crate-level)."
                },
                "demo_test": {
                    "heavy": ["TransitionTests", "QueryTests", "EdgeCaseTests"],
                    "light": ["ConstructorTests", "IdentityTests", "TableDrivenTests"],
                    "note": "Tests are coverage-rich. Their BODY proves correctness across the type lifecycle."
                },
                "bare_bone": {
                    "heavy": ["CoreLogic"],
                    "light": ["IdentityAccess", "FreeFunctions"],
                    "note": "Bare-bone is minimal. Most BODY subsections are RESERVED for promotion."
                }
            },

            "placement_rules": {
                "must_be_in_body": [
                    "fn and pub fn implementations (logic)",
                    "impl blocks with methods beyond completing impls",
                    "Behavioral trait implementations (Iterator, Read, Write, custom)",
                    "Complex constructors with validation or error paths",
                    "Builder pattern methods and typestate transitions",
                    "run() function (executables — business logic separated from main())",
                    "#[test] functions (demo-tests)",
                    "Free functions and module-level utilities"
                ],
                "must_not_be_in_body": [
                    "use declarations (→ SETUP §1)",
                    "const and static definitions (→ SETUP §3-§4)",
                    "struct and enum definitions (→ SETUP §7)",
                    "type aliases (→ SETUP §5)",
                    "trait definitions (→ SETUP §8)",
                    "macro_rules! definitions (→ SETUP §9)",
                    "Completing impls: Display, Error, From, Default (→ SETUP §6-§7)"
                ],
                "gray_area": {
                    "simple_constructors": "new() with field assignment only — defensible in SETUP §7 or BODY §3",
                    "helper_functions": "Small private fns — place in the BODY subsection of the caller",
                    "test_helpers": "Fixture fns/assertion helpers — SETUP §7/§9 for reusable, BODY for one-off"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING
        // ═══════════════════════════════════════════════════════

        "CLOSING": {
            "purpose": "Validation → Execution → Cleanup. CLOSING proves the code works (tests), runs the code (entry point), and cleans up resources (Drop/teardown). Contains code zones (Cv/Ce/Cc) followed by documentation sections (X1-X6).",
            "principle": "CLOSING is the accountability block. Tests prove claims. Entry points handle the OS interface. Cleanup prevents leaks. Documentation sections guide maintainers. Code zones come FIRST (they do real work); documentation sections come AFTER (they guide future work).",
            "boundary": "// ============================================================================",
            "label": "// CLOSING",
            "end_marker": "// END CLOSING",
            "required": true,
            "severity": "error",

            "zone_ordering": {
                "note": "Code zones precede documentation sections. Ordering: Cv → Ce → Cc → X1 → X2 → X3 → X4 → X5 → X6. Code zones contain actual Rust code (commented-out in templates). Documentation sections contain policy, reference, and guidance.",
                "code_zones": ["Cv", "Ce", "Cc"],
                "documentation_sections": ["X1", "X2", "X3", "X4", "X5", "X6"],
                "ordering_principle": "prove_then_run_then_clean_then_document"
            },

            "code_zones": {
                "note": "Zones contain actual executable Rust code (commented-out in templates, uncommented in production). Zone NAMES are universal; zone CONTENT varies by subtype.",

                "Cv_Validation": {
                    "position": 1,
                    "tag": "Cv",
                    "pattern": "Cv — Closing Validation",
                    "purpose": "#[cfg(test)] inline tests — prove code works",
                    "subtype_content": {
                        "library": "mod tests with use super::* — white-box access to private internals. Organize by BODY subsections.",
                        "executable": "Exit code mapping tests, error display tests, identity verification.",
                        "module": "mod tests with use super::* — focused tests for the module's single concern. White-box access to private internals.",
                        "demo_test": "Meta-validation — tests that verify test infrastructure (fixtures, helpers, assertions). BODY IS validation; Cv validates the validators.",
                        "bare_bone": "Minimal smoke tests — prove the template compiles and PRAGMA/METADATA are accessible."
                    }
                },
                "Ce_Execution": {
                    "position": 2,
                    "tag": "Ce",
                    "pattern": "Ce — Closing Execution",
                    "purpose": "Entry point, init, registration — the code that starts execution",
                    "subtype_content": {
                        "library": "Empty — libraries have no entry point. register_identity() stays in BODY §7 (public API, consumer-invoked).",
                        "executable": "exit_code() + main() — thin entry delegating to run() (BODY §3). main() maps Result to exit code; it contains no business logic.",
                        "module": "Empty — modules have no entry point. They are used by crate root, not invoked directly.",
                        "demo_test": "Empty — cargo test is the harness. No main() needed.",
                        "bare_bone": "Empty — foundation template has no entry point."
                    }
                },
                "Cc_Cleanup": {
                    "position": 3,
                    "tag": "Cc",
                    "pattern": "Cc — Closing Cleanup",
                    "purpose": "Drop impls, resource deallocation, teardown",
                    "subtype_content": {
                        "library": "Drop trait implementation — impl Drop for Type { fn drop(&mut self) { ... } }",
                        "executable": "Process cleanup — temp files, buffer flushing, DB connections.",
                        "module": "Drop trait implementation for module-owned types, if applicable.",
                        "demo_test": "Test fixture teardown — cleanup_temp_dir(), test resource deallocation.",
                        "bare_bone": "Empty — bare-bone has no resources to clean up."
                    }
                }
            },

            "documentation_sections": {
                "note": "Documentation sections follow code zones. They guide maintainers, not compilers.",
                "X1_Policy": { "tag": "X1", "pattern": "X.1 POLICY", "required": true, "purpose": "Modification guidelines — never/careful/safe", "fields": { "required": ["never", "careful", "safe"], "defined": ["scripture"] } },
                "X2_Extension": { "tag": "X2", "pattern": "X.2 EXTENSION", "required": false, "purpose": "Designed growth points" },
                "X3_Troubleshooting": { "tag": "X3", "pattern": "X.3 TROUBLESHOOTING", "required": false, "purpose": "Common problems and solutions" },
                "X4_Reference": { "tag": "X4", "pattern": "X.4 REFERENCE", "required": false, "purpose": "Related files, deps, validation" },
                "X5_Note": { "tag": "X5", "pattern": "X.5 NOTE", "required": true, "purpose": "Closing scripture anchor", "fields": { "required": ["note", "scripture"], "defined": ["anchor"] } },
                "X6_Template": { "tag": "X6", "pattern": "X.6 TEMPLATE", "required": false, "template_only": true, "purpose": "Remove when instantiating" }
            },

            "comment_style": {
                "///": "On pub items (when uncommented, generates rustdoc)",
                "//": "Structural markers, template guidance, test internals",
                "//!": "Not used in CLOSING (module-level only, lives in METADATA)"
            },

            "production_design": {
                "principle": "CLOSING is the accountability block — it proves, runs, and cleans up.",
                "scaling_signal": "If Cv (tests) exceeds ~300 lines, extract to tests/ directory.",
                "testing_pattern": "Cv maps to BODY subsections — constructor tests, core logic tests, query tests.",
                "cleanup_philosophy": "Cc should be minimal — RAII handles most cleanup. Cc is for resources needing explicit teardown."
            },

            "subtype_emphasis": {
                "library": { "heavy": ["Cv"], "light": ["Ce", "Cc"], "note": "Libraries are test-rich." },
                "executable": { "heavy": ["Ce", "Cv"], "light": ["Cc"], "note": "Executables need entry points AND tests." },
                "module": { "heavy": ["Cv"], "light": ["Cc"], "note": "Modules are test-rich. No Ce (no entry point)." },
                "demo_test": { "heavy": ["Cv", "Cc"], "light": ["Ce"], "note": "Test files need meta-validation AND fixture cleanup." },
                "bare_bone": { "heavy": ["Cv"], "light": ["Ce", "Cc"], "note": "Bare-bone: minimal smoke tests only." }
            },

            "placement_rules": {
                "must_be_in_closing": [
                    "#[cfg(test)] mod tests (Cv — inline tests)",
                    "main() function (Ce — executable entry point)",
                    "exit_code() function (Ce — error-to-exit-code mapping)",
                    "Drop trait implementations (Cc — resource cleanup)",
                    "Test fixture teardown helpers (Cc — test cleanup)"
                ],
                "must_not_be_in_closing": [
                    "run() function (→ BODY — business logic must be testable independently)",
                    "Public API methods (→ BODY — they ARE the library)",
                    "Type definitions (→ SETUP — declarations belong in SETUP)",
                    "register_identity() for libraries (→ BODY §7 — public API, consumer-invoked)"
                ]
            }
        },

        // ═══════════════════════════════════════════════════════
        // FILL CONTENT — Schema-driven file generation templates
        // ═══════════════════════════════════════════════════════
        //
        // Used by `cws-struct create` and `cws-struct fill` to generate
        // complete 4-block Rust files from schema alone. Placeholders use
        // {{name}} syntax — engine substitutes with context values.

        "fill_content": {
            "_description": "Templates for schema-driven file generation. Identity groups enable section headers, docstrings, and group comments. Column alignment is computed at generation time from the longest field name.",

            "defaults": {
                "version": "a-01.00",
                "status": "Active",
                "organization": "CreativeWorkzStudio LLC",
                "scripture": "Genesis 1:1",
                "scripture_text": "In the beginning God created the heaven and the earth.",
                "type": "code",
                "structure": "4-block",
                "architect": "Seanje Lenox-Wise",
                "implementation": "Nova Dawn (CPI-SI)",
                "role": "[role]",
                "layer": "[layer]",
                "position": "[position]",
                "pattern": "[pattern]",
                "domain": "bereshit",
                "paradigm": "CPI-SI"
            },

            "directives": [
                "//omni:key {{key}}",
                "//omni:code --rust -{{subtype}}",
                "//omni:version {{version}}"
            ],

            "module_doc": "//! {{title}}",

            "identity_syntax": {
                "pragma": {
                    "declaration": "pub static PRAGMA: &[(&str, &str)] = &[",
                    "entry": "    (\"{{field}}\", \"{{value}}\"),",
                    "close": "];"
                },
                "metadata": {
                    "declaration": "pub static METADATA: &[(&str, &str)] = &[",
                    "entry": "    (\"{{field}}\", \"{{value}}\"),",
                    "close": "];"
                }
            },

            "pragma_entries": [
                ["I1.key",       "{{key}}"],
                ["I1.format",    "rust"],
                ["I1.from",      "{{from}}"],
                ["I1.at",        "{{version}}"],
                ["I2.type",      "code"],
                ["I2.structure", "4-block"],
                ["I2.subtype",   "{{subtype}}"],
                ["I2.role",      "{{role}}"],
                ["I3.file",      "{{filename}}"],
                ["I3.title",     "{{title}}"],
                ["I3.component", "{{component}}"],
                ["I3.path",      "{{path}}"],
                ["I3.provides",  "{{provides}}"],
                ["I3.brief",     "{{brief}}"],
                ["I4.layer",     "{{layer}}"],
                ["I4.position",  "{{position}}"],
                ["I4.pattern",   "{{pattern}}"]
            ],

            "metadata_entries": [
                ["C1.version",           "{{version}}"],
                ["C1.status",            "{{status}}"],
                ["C1.created",           "{{date}}"],
                ["C1.updated",           "{{date}}"],
                ["C2.architect",         "{{architect}}"],
                ["C2.implementation",    "{{implementation}}"],
                ["C2.organization",      "{{organization}}"],
                ["C2.copyright",         "{{organization}}"],
                ["C3.scripture",         "{{scripture}}"],
                ["C3.principle",         "{{principle}}"],
                ["C3.anchor",            "Genesis 1:1"],
                ["C4.requires.stdlib",   "none"],
                ["C4.requires.external", "{{requires_external}}"],
                ["C4.requires.internal", "{{requires_internal}}"],
                ["C4.consumers",         "{{consumers}}"],
                ["C4.integration",       "{{integration}}"],
                ["C4.if_missing",        "{{if_missing}}"],
                ["C5.purpose",           "{{purpose}}"],
                ["C5.philosophy",        "{{philosophy}}"],
                ["C6.current",           "{{version}} — {{purpose}}"],
                ["C6.planned",           "{{planned}}"],
                ["C6.limitations",       "{{limitations}}"],
                ["C7.tags",              "{{tags}}"],
                ["C7.category",          "{{category}}"],
                ["C7.domain",            "{{domain}}"],
                ["C7.paradigm",          "{{paradigm}}"]
            ],

            "identity_groups": {
                "_description": "Group markers for structured METADATA block formatting. Each group defines a range prefix, label for inline comments, and optional docstring for the static declaration.",
                "pragma": [
                    { "range": "I1", "label": "Core",         "docstring": "/// OmniCode identity for this module." },
                    { "range": "I2", "label": "Family" },
                    { "range": "I3", "label": "Instance" },
                    { "range": "I4", "label": "Architecture" }
                ],
                "metadata": [
                    { "range": "C1", "label": "State",         "docstring": "/// OmniCode context for this module." },
                    { "range": "C2", "label": "Attribution" },
                    { "range": "C3", "label": "Grounding" },
                    { "range": "C4", "label": "Dependencies" },
                    { "range": "C5", "label": "Intent" },
                    { "range": "C6", "label": "Roadmap" },
                    { "range": "C7", "label": "Classification" }
                ],
                "section_headers": {
                    "pragma": "// Identity (I1-I4)",
                    "metadata": "// Context (C1-C7)"
                }
            },

            "transformer_modes": {
                "_description": "Named leniency levels for transformer output. strict = exists.rs production standard (0E 0W 0I). balance = correct structure, reasonable formatting (0E 0W). growth = minimal scaffolding that compiles (0E).",
                "strict": {
                    "linter_target": "0E 0W 0I",
                    "identity_formatting": true,
                    "section_headers": true,
                    "group_comments": true,
                    "docstrings": true,
                    "column_alignment": true,
                    "block_overviews": true,
                    "ro_grouped": true,
                    "closing_complete": true
                },
                "balance": {
                    "linter_target": "0E 0W",
                    "identity_formatting": true,
                    "section_headers": false,
                    "group_comments": false,
                    "docstrings": false,
                    "column_alignment": false,
                    "block_overviews": true,
                    "ro_grouped": false,
                    "closing_complete": true
                },
                "growth": {
                    "linter_target": "0E",
                    "identity_formatting": false,
                    "section_headers": false,
                    "group_comments": false,
                    "docstrings": false,
                    "column_alignment": false,
                    "block_overviews": false,
                    "ro_grouped": false,
                    "closing_complete": false
                }
            },

            "metadata_comment": [
                "// Key:     {{key}}",
                "// Purpose: {{purpose}}"
            ],

            "closing_defaults": {
                "X1": {
                    "never": "Break 4-block structure, Remove block boundaries, Remove identity statics",
                    "careful": "Function signatures (breaks callers), Error types (breaks match arms)",
                    "safe": "Function bodies, New functions, Comments, Tests"
                },
                "X5": {
                    "note": "{{purpose}}",
                    "scripture": "\"{{scripture_text}}\" — {{scripture}}"
                }
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Rust validation is done by rust.ts handler (14 checks → 93 atomic actions).
    // This section documents the validation contract and health scoring.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint rust <file>",
    "_Cv_expected_state": "All block boundaries present in correct order (METADATA < SETUP < BODY < CLOSING) with //omni:key directive and END markers.",

    "validation_contract": {

        "checks_summary": {
            "total": "14 check functions → 93 atomic actions (derived), 81 (template)",
            "version": "b-03.00",
            "checks": [
                "1. checkDirectives — //omni:key (required for crate root), //omni:code + //omni:version (recommended)",
                "2. checkBlockStructure — 4 blocks present, correct order, END markers",
                "3. checkDocComments — //! crate-level docs for lib.rs/main.rs, module-level for others",
                "4. checkPragmaMetadata — PRAGMA (I1-I4) and METADATA (C1-C7) statics (slice, BTreeMap, or OWN_) — field existence + field content validation (pattern, enum, non-empty, path-like)",
                "5. checkCommentMetadata — Key:, Purpose:, Biblical:, Version: in METADATA comments",
                "6. checkSeparatorConsistency — = widths (standard: 76), ─ widths (standard: 74), - widths",
                "7. checkTemplateVsDerived — template has #!omni pragma + self-describing values, derived has //omni: directive",
                "8. checkSetupSubsectionOrder — 10-subsection dependency chain: Imports → Modules → Constants → Statics → TypeAliases → ErrorTypes → CoreTypes → TraitDefs → Macros → FeatureGates",
                "9. checkIdentityRegistration — register_identity() for crates with PRAGMA",
                "10. checkDirectiveFormat — //omni:code matches known patterns",
                "11. checkContentPlacement — right constructs in right blocks (declarations→SETUP, logic→BODY, tests/entry/cleanup→CLOSING), no code in METADATA, subsection-level hints within SETUP, CLOSING zone-specific placement (main→Ce, tests→Cv, Drop→Cc)",
                "12. checkBodySubsectionOrder — subtype-aware BODY subsection ordering (library B1-B7, executable B1-B3, demo-test B1-B9)",
                "13. checkClosingZoneOrder — Cv → Ce → Cc → X1-X6 ordering, #[cfg(test)] placement enforcement",
                "14. checkClosingContentPlacement — main() in Ce, Drop in Cc, tests in Cv with line-aware traceback"
            ]
        },

        "directives": {
            "required_directives": ["//omni:key"],
            "recommended_directives": ["//omni:code", "//omni:version"],
            "template_directive": "// #!omni template --rust -{subtype} + PRAGMA/METADATA statics with self-describing I/C values",
            "module_files": "Directives optional — identity delegated to lib.rs"
        },

        "blocks": {
            "required_markers": ["METADATA", "SETUP", "BODY", "CLOSING"],
            "end_markers": ["END METADATA", "END SETUP", "END BODY", "END CLOSING"],
            "order": "METADATA < SETUP < BODY < CLOSING",
            "block_severity": "error for crate root, warn for templates",
            "end_severity": "warn",
            "module_files": "Block markers optional if file has no //omni: directives"
        },

        "separators": {
            "block_width": 76,
            "block_char": "=",
            "subsection_width": 74,
            "subsection_char_unicode": "─",
            "subsection_char_ascii": "-",
            "consistency_severity": "warn",
            "standard_severity": "info",
            "note": "Rust prefers Unicode box-drawing (─) for subsections but ASCII dash (-) is accepted"
        },

        "identity": {
            "patterns": [
                "pub static PRAGMA: &[(&str, &str)] — Identity sections I1-I4",
                "pub static METADATA: &[(&str, &str)] — Context sections C1-C7",
                "static PRAGMA: LazyLock<BTreeMap<...>> — runtime-queryable Identity",
                "static METADATA: LazyLock<BTreeMap<...>> — runtime-queryable Context",
                "static OWN_PRAGMA: ... (identity crate self-registration)",
                "pub mod identity; (delegated to submodule)"
            ],
            "field_requirements": {
                "I1_core": { "required": ["key", "format", "from", "at"] },
                "I2_family": { "required": ["type", "structure"], "defined": ["subtype", "role"] },
                "I3_instance": { "required": ["file", "title"], "defined": ["component", "path", "provides", "brief"] },
                "I4_architecture": { "defined": ["layer", "position", "pattern"] },
                "C1_state": { "required": ["version", "status"], "defined": ["created", "updated"] },
                "C2_attribution": { "required": ["organization"], "defined": ["architect", "implementation", "copyright"] },
                "C3_grounding": { "required": ["scripture"], "defined": ["principle", "anchor"] },
                "C4_dependencies": { "required": ["requires", "consumers"], "defined": ["integration", "if_missing"] },
                "C5_intent": { "defined": ["purpose", "philosophy"] },
                "C6_roadmap": { "defined": ["current", "planned", "limitations"] },
                "C7_classification": { "defined": ["tags", "category", "domain", "paradigm"] }
            },
            "severity": "warn for crate root, not checked for modules",
            "registration": "register_identity() — info severity",
            "subtype_awareness": "I2.subtype determines valid file pattern, API surface, and block expectations — see subtypes in METADATA section"
        },

        "template_rules": {
            "pattern": "usable schema — template values describe the template itself, not placeholders",
            "template_has_pragma_directive": "// #!omni template --rust -{subtype}",
            "derived_has_omni_directive": "//omni:code --rust -{subtype}",
            "derived_with_template_severity": "warn",
            "identity_fields_self_describing": "I1.key = 'B-seed-code-L0-rust-{subtype}', I3.file = '{subtype}.rs', etc.",
            "copy_workflow": "cp template.rs dest.rs → change pragma → update I/C values for new file"
        },

        "transformer": {
            "capabilities": [
                "Fix block separator widths (= → 76 chars)",
                "Fix Unicode subsection separator widths (─ → 74 chars)"
            ],
            "limitations": [
                "Does NOT inject missing block boundaries",
                "Does NOT add missing //omni: directives",
                "Does NOT fix ASCII dash (-) separators (only Unicode ─)",
                "Does NOT reorder subsections"
            ],
            "usage": "deno run --allow-read --allow-write mod.ts transform rust <file>"
        },

        // ═══════════════════════════════════════════════════════
        // HEALTH SCORING — Rust-specific extension of base contract
        // ═══════════════════════════════════════════════════════
        //
        // Extends: code/base/base-4block-schema.jsonc → $defs.health_scoring
        // Rust differs from Go: no package/import checks, has identity-registration,
        // has //! doc comment check, has 4 comment-meta fields (vs Go's 2).
        //
        // File type variants:
        //   derived (non-module): 93 total actions (full scoring)
        //   template: 81 actions (blocks + separators + directives + identity + field-values + doc + template)
        //   module file (without statics): ~14 actions (blocks + separators only)

        "health_scoring": {
            "extends": "code/base/base-4block-schema.jsonc#/$defs/health_scoring",
            "description": "Rust-specific health scoring — 93 atomic actions for derived non-module files.",

            "rust_specific_notes": {
                "vs_go": "Rust has no package/import structural checks (Go: +2). Rust has identity-registration (+1 in identity container), doc-comments (+1), and 4 comment-meta fields (Go has 2). Net: Rust 93 vs Go 91.",
                "identity_count": "Rust identity has 47 actions (3 base + 17 Pragma + 24 Metadata + 3 extra: identity-registration, Pragma/Metadata statics) vs Go's 44",
                "module_files": "Module files (mod.rs, submodules) without PRAGMA/METADATA statics get minimal scoring — block structure and separators only"
            },

            "metadata_content": {
                "description": "Rust expresses I/C identity through pub static PRAGMA: &[(&str, &str)] and pub static METADATA: &[(&str, &str)] (or LazyLock<BTreeMap>). Linter checks each field individually for existence AND content validity.",

                "pragma_fields_I1_core": {
                    "required": ["key", "format", "from", "at"],
                    "defined": [],
                    "total_fields": 4,
                    "type": "compound",
                    "note": "I1 = WHO. Required fields are errors if missing; defined fields are info.",
                    // 4 atomic actions (all required → error weight 2.0 each)
                    "expected_pass_contribution": "+4.0"
                },
                "pragma_fields_I2_family": {
                    "required": ["type", "structure"],
                    "defined": ["subtype", "role"],
                    "total_fields": 4,
                    "type": "compound",
                    // 2 required (error 2.0) + 2 defined (info 0.25) = +4.5
                    "expected_pass_contribution": "+4.5"
                },
                "pragma_fields_I3_instance": {
                    "required": ["file", "title"],
                    "defined": ["component", "path", "provides", "brief"],
                    "total_fields": 6,
                    "type": "compound",
                    // 2 required (error 2.0) + 4 defined (info 0.25) = +5.0
                    "expected_pass_contribution": "+5.0"
                },
                "pragma_fields_I4_architecture": {
                    "required": [],
                    "defined": ["layer", "position", "pattern"],
                    "total_fields": 3,
                    "type": "compound",
                    // 3 defined (info 0.25) = +0.75
                    "expected_pass_contribution": "+0.75"
                },

                "metadata_fields_C1_state": {
                    "required": ["version", "status"],
                    "defined": ["created", "updated"],
                    "total_fields": 4,
                    "type": "compound",
                    // 2 required (error 2.0) + 2 defined (info 0.25) = +4.5
                    "expected_pass_contribution": "+4.5"
                },
                "metadata_fields_C2_attribution": {
                    "required": ["organization"],
                    "defined": ["architect", "implementation", "copyright"],
                    "total_fields": 4,
                    "type": "compound",
                    // 1 required (2.0) + 3 defined (0.25) = +2.75
                    "expected_pass_contribution": "+2.75"
                },
                "metadata_fields_C3_grounding": {
                    "required": ["scripture"],
                    "defined": ["principle", "anchor"],
                    "total_fields": 3,
                    "type": "compound",
                    // 1 required (2.0) + 2 defined (0.25) = +2.5
                    "expected_pass_contribution": "+2.5"
                },
                "metadata_fields_C4_dependencies": {
                    "required": ["requires", "consumers"],
                    "defined": ["integration", "if_missing"],
                    "total_fields": 4,
                    "type": "compound",
                    // 2 required (2.0) + 2 defined (0.25) = +4.5
                    "expected_pass_contribution": "+4.5"
                },
                "metadata_fields_C5_intent": {
                    "required": [],
                    "defined": ["purpose", "philosophy"],
                    "total_fields": 2,
                    "type": "compound",
                    // 2 defined (0.25) = +0.5
                    "expected_pass_contribution": "+0.5"
                },
                "metadata_fields_C6_roadmap": {
                    "required": [],
                    "defined": ["current", "planned", "limitations"],
                    "total_fields": 3,
                    "type": "compound",
                    // 3 defined (0.25) = +0.75
                    "expected_pass_contribution": "+0.75"
                },
                "metadata_fields_C7_classification": {
                    "required": [],
                    "defined": ["tags", "category", "domain", "paradigm"],
                    "total_fields": 4,
                    "type": "compound",
                    // 4 defined (0.25) = +1.0
                    "expected_pass_contribution": "+1.0"
                },

                "identity_total": {
                    "pragma_fields": 17,
                    "metadata_fields": 24,
                    "base_checks": 6,
                    "total": 47,
                    "note": "6 base (Pragma/empty + Metadata/empty + upgrade + identity-registration + PRAGMA-static + METADATA-static) + 17 Pragma I-fields + 24 Metadata C-fields"
                }
            },

            "action_summary_derived": {
                "structural_blocks": { "actions": 9, "type": "atomic", "note": "4 starts + 4 ends + 1 order" },
                "structural_separators": { "actions": 5, "type": "atomic", "note": "2 eq-width/standard + 2 box-width/standard + 1 dash-width" },
                "metadata_directives": { "actions": 4, "type": "atomic", "note": "1 required + 2 recommended + 1 code-format" },
                "metadata_identity": { "actions": 47, "type": "compound", "note": "6 base + 17 Pragma + 24 Metadata field checks (includes identity-registration)" },
                "metadata_field_values": { "actions": 14, "type": "atomic", "note": "8 Pragma content (I1.key/format/from/at, I2.type/structure, I3.file/title) + 6 Metadata content (C1.version/status/created/updated, C2.org, C3.scripture)" },
                "metadata_comment_meta": { "actions": 4, "type": "atomic", "note": "key + purpose + biblical + version" },
                "setup_ordering": { "actions": 1, "type": "atomic", "note": "subsection order" },
                "body_ordering": { "actions": 1, "type": "atomic", "note": "subsection order" },
                "content_placement": { "actions": 3, "type": "atomic", "note": "metadata-leak + block-placement + subsection-placement" },
                "closing_zone_ordering": { "actions": 3, "type": "atomic", "note": "zone-order + code-zone-order + doc-section-order" },
                "closing_content_placement": { "actions": 2, "type": "atomic", "note": "test-placement + main-placement" },
                "TOTAL": 93,
                "full_pass_score": "100/±100"
            },

            "action_summary_template": {
                "structural_blocks": 9,
                "structural_separators": 5,
                "metadata_directives": 2,
                "metadata_identity": 47,
                "metadata_field_values": 14,
                "metadata_doc": 1,
                "metadata_template": 3,
                "note": "Templates skip: comment-meta, setup, body, content-placement, closing content. Include identity + field-values for templates with PRAGMA/METADATA statics.",
                "TOTAL": 81,
                "full_pass_score": "100/±100"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Let all things be done decently and in order. — 1 Corinthians 14:40",
    "_X1_never": [
        "Remove block boundary requirements (METADATA, SETUP, BODY, CLOSING)",
        "Change the // comment convention for structural markers",
        "Break the Rust schema ↔ rust.ts linter parallel without updating both"
    ],
    "_X1_careful": [
        "Adding new required //omni: directives (cascades to all Rust files)",
        "Changing SETUP subsection order (10-subsection dependency chain — see SETUP.subsection_order)",
        "Modifying separator width standards (76= / 74─)"
    ],
    "_X1_safe": [
        "Adding new identity static patterns to the recognized list",
        "Adding descriptions to structural element definitions",
        "Adding new //omni:code directive patterns to known list"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Cross-crate identity validation (lib.rs PRAGMA key matches Cargo.toml name)",
        "Unsafe block detection and documentation requirements",
        "Cross-field content validation (I1.at == C1.version consistency)",
        "Filename consistency (I3.file matches actual filename)"
    ],
    "_X2_completed": [
        "CLOSING zone ordering enforcement — checks 13-14 (Cv → Ce → Cc → X1-X6 + content placement)",
        "Health scoring — ternary -100/+100, 93 atomic actions for derived Rust files (see health_scoring)",
        "Content validation — field value checks (pattern, enum, non-empty, path-like) for I/C fields"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "schemas/data/base/base-3block-schema.jsonc — Base concepts (shared I/C $defs)",
        "schemas/code/base/base-4block-schema.jsonc — Base 4-block (SETUP/BODY/CLOSING $defs + health scoring contract)",
        "schemas/code/format/go-4block-schema.jsonc — Go 4-block sibling",
        "schemas/code/format/makefile-4block-schema.jsonc — Makefile 4-block sibling",
        "b-word/seed/code/L0/rust/ — Rust seed templates",
