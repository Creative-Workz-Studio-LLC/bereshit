{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-base-4block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/base",
    "_P3_includes": "none",
    "_P3_provides": ["BASE_4BLOCK_SCHEMA", "SHARED_CODE_DEFS"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Base 4-Block Schema",
    "_P5_brief": "Format-independent foundation for OmniCode 4-block (code) structure. Defines shared $defs for block ordering, SETUP subsections (S1-S10), BODY subtype-specific zones, CLOSING code zones (Cv/Ce/Cc) + documentation sections (X1-X6), placement rules, and identity (shared with base-3block).",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "base-4block-schema.jsonc",
        "key": "B-L1-schemas-base-4block-schema",
        "title": "Base 4-Block Schema",
        "type": "Data (Schema Foundation)",
        "component": "Ladder",
        "role": "Define format-independent 4-block (code) structure with SETUP subsections, BODY zones, and CLOSING code zones + documentation"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-17",
        "updated": "2026-02-17"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Exodus 25:40 — Look that thou make them after their pattern, which was shewed thee in the mount.",
        "principle": "The 4-block structure is the pattern shown on the mountain. METADATA declares identity. SETUP makes things EXIST. BODY makes things HAPPEN. CLOSING proves, runs, and cleans up. Every format expresses this differently, but the pattern is one."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "data/base/base-3block-schema.jsonc — shared $defs for I/C metadata (I1-I4, C1-C7) and closing docs (X1-X5)",
        "consumers": "code/format/rust-4block-schema.jsonc, code/format/go-4block-schema.jsonc, code/format/makefile-4block-schema.jsonc",
        "relationship": "Base provides shared code-specific $defs. Format schemas inherit concepts and map to format-specific syntax (// comments, # comments, etc.)."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract. This file defines the 4-block contract itself."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // The 4-block structure is for CODE files:
    //   METADATA — identity and context (same I/C as 3-block)
    //   SETUP   — declarations, types, imports (things EXIST)
    //   BODY    — logic, implementations, operations (things HAPPEN)
    //   CLOSING — validation, execution, cleanup, documentation
    //
    // Key difference from 3-block:
    //   3-block: METADATA → CONTENT → CLOSING (data files)
    //   4-block: METADATA → SETUP → BODY → CLOSING (code files)
    //   CONTENT splits into SETUP + BODY for code, separating
    //   declarations (schema) from logic (queries).
    //
    // Each format expresses this differently:
    //   Rust — // comments, //omni: directives, static PRAGMA/METADATA
    //   Go   — // comments, //omni: directives, var Pragma/Metadata maps
    //   Make — # comments, ##omni: directives
    //   C    — /* */ comments (future)
    //
    // The $defs below define WHAT each block/zone contains.
    // Format schemas define HOW to represent it.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Schema identity and structure overview.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/base-4block.schema.json",
    "title": "OmniCode Base 4-Block Structure",
    "description": "Format-independent definition of OmniCode 4-block (code) structure. Extends base-3block I/C metadata with code-specific concepts: SETUP subsection ordering (S1-S10), BODY subtype-specific zones, CLOSING code zones (Cv/Ce/Cc) + documentation sections (X1-X6), and placement rules.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Shared type definitions ($defs). Each definition describes
    // WHAT a block/zone contains, independent of format.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "$defs": {

        // ═══════════════════════════════════════════════════════
        // BLOCK ORDERING — The 4-block skeleton
        // ═══════════════════════════════════════════════════════

        "block_ordering": {
            "type": "object",
            "description": "The 4-block skeleton: METADATA → SETUP → BODY → CLOSING. Order is fixed. All four required for code files.",
            "properties": {
                "blocks": {
                    "type": "array",
                    "items": { "type": "string" },
                    "const": ["METADATA", "SETUP", "BODY", "CLOSING"],
                    "description": "Canonical block order — never changes"
                }
            },

            "METADATA": {
                "purpose": "Identity and context — WHO this file is, WHAT it needs",
                "required": true,
                "contains": "I/C sections (shared with base-3block), format-specific identity constructs",
                "note": "References $defs from base-3block-schema.jsonc for I1-I4, C1-C7"
            },
            "SETUP": {
                "purpose": "Declarations — everything BODY needs to EXIST before logic runs",
                "required": true,
                "contains": "Imports, constants, types, error types, trait/interface defs, macros",
                "principle": "SETUP makes things EXIST. BODY makes things HAPPEN. If BODY is pure logic, hardcoded values have one address: SETUP."
            },
            "BODY": {
                "purpose": "Core logic — implementations, operations, the actual work",
                "required": true,
                "contains": "Function implementations, trait/interface impls, constructors, queries, tests (demo-test)",
                "principle": "BODY/SETUP mirrors behavior/data. SETUP is the schema; BODY is the queries."
            },
            "CLOSING": {
                "purpose": "Accountability — prove it works, run it, clean up, document",
                "required": true,
                "contains": "Tests (Cv), entry points (Ce), cleanup (Cc), documentation (X1-X6)",
                "principle": "CLOSING is the accountability block. Tests prove claims. Entry points handle OS interface. Cleanup prevents leaks. Docs guide maintainers."
            }
        },

        // ═══════════════════════════════════════════════════════
        // SETUP — Universal 10-subsection structure
        // ═══════════════════════════════════════════════════════
        //
        // The 10-subsection structure follows the dependency chain:
        // each subsection can reference only what came before it.
        // Not all 10 are required — only those with content appear.
        // The ordering is universal across all 4-block formats.

        "setup_subsections": {
            "type": "object",
            "description": "Universal SETUP subsection ordering. 10 positions following the dependency chain — each can reference only what came before it. Format-independent.",

            "ordering_principle": "dependency_chain",
            "canonical_count": 10,

            "subsections": {
                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "purpose": "External dependencies — bringing in what exists elsewhere",
                    "universal": true
                },
                "S2_Modules": {
                    "position": 2,
                    "tag": "Modules",
                    "purpose": "Module declarations, re-exports — defining the public surface",
                    "universal": true
                },
                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "purpose": "Compile-time known values — zero-cost, inlined",
                    "universal": true
                },
                "S4_Statics": {
                    "position": 4,
                    "tag": "Statics",
                    "purpose": "Runtime-initialized singletons — process-wide shared state",
                    "universal": true
                },
                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "purpose": "Type aliases — domain vocabulary without new types",
                    "universal": true
                },
                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "purpose": "Error definitions — the crate/package failure vocabulary",
                    "universal": true
                },
                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "purpose": "Primary structs/enums/interfaces — the data shapes logic operates on",
                    "universal": true
                },
                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "purpose": "Trait/interface definitions — contracts that BODY fulfills",
                    "note": "Rust: trait, Go: interface, C: function pointer structs",
                    "universal": true
                },
                "S9_Macros": {
                    "position": 9,
                    "tag": "Macros",
                    "purpose": "Code generation — compile-time patterns for repeated structures",
                    "note": "Rust: macro_rules!, Go: go generate, C: #define macros",
                    "universal": true
                },
                "S10_FeatureGates": {
                    "position": 10,
                    "tag": "FeatureGates",
                    "purpose": "Conditional compilation — platform/feature-specific declarations",
                    "note": "Rust: cfg(feature), Go: //go:build, C: #ifdef",
                    "universal": true
                }
            },

            "production_design": {
                "principle": "SETUP is the file's local config layer. Everything hardcoded lives here, not scattered through BODY.",
                "scaling_signal": "If SETUP grows past 200 lines, the file is doing too much. Extract types, errors, constants into modules.",
                "refactoring_signal": "The subsection structure tells you exactly where to cut when extracting."
            }
        },

        // ═══════════════════════════════════════════════════════
        // BODY — Subtype-specific subsection structures
        // ═══════════════════════════════════════════════════════
        //
        // Unlike SETUP's universal 10-subsection structure,
        // BODY subsections vary by subtype. Each subtype has its
        // own ordering principle reflecting the nature of its logic.

        "body_zones": {
            "type": "object",
            "description": "BODY subsection structures vary by subtype. Each subtype defines its own ordering principle and subsection count.",

            "ordering_varies_by_subtype": true,

            "subtypes": {

                "library": {
                    "canonical_count": 7,
                    "ordering_principle": "type_lifecycle",
                    "note": "From identity through creation, operation, observation, to output. Mirrors how a consumer uses the library.",
                    "subsections": {
                        "B1_IdentityAccess":       { "position": 1, "purpose": "OmniCode static accessors — pragma(), metadata()" },
                        "B2_TraitImplementations":  { "position": 2, "purpose": "Behavioral trait/interface impls — fulfilling SETUP contracts" },
                        "B3_Constructors":          { "position": 3, "purpose": "new(), builders, factory methods — how types come into existence" },
                        "B4_CoreLogic":             { "position": 4, "purpose": "Primary operations — state transitions, computations, business rules" },
                        "B5_Queries":               { "position": 5, "purpose": "Read-only accessors — getters, predicates, computed properties" },
                        "B6_Output":                { "position": 6, "purpose": "Formatters, display helpers, serialization" },
                        "B7_FreeFunctions":         { "position": 7, "purpose": "Module-level public functions — convenience wrappers, facades" }
                    }
                },

                "executable": {
                    "canonical_count": 3,
                    "ordering_principle": "execution_flow",
                    "note": "Code reads in the order it runs. Executables orchestrate; computation lives in library crates/packages.",
                    "subsections": {
                        "B1_IdentityAccess":   { "position": 1, "purpose": "OmniCode static accessors (optional for binaries)" },
                        "B2_Helpers":          { "position": 2, "purpose": "Argument parsing, config loading, output formatting" },
                        "B3_CoreOperations":   { "position": 3, "purpose": "The run() function — main business logic separated from main()" }
                    }
                },

                "demo_test": {
                    "canonical_count": 9,
                    "ordering_principle": "concern_coverage",
                    "note": "From construction through full type lifecycle to integration. Mirrors how the crate/package is built.",
                    "subsections": {
                        "B1_ConstructorTests":   { "position": 1, "purpose": "Verify construction creates types with correct default state" },
                        "B2_BuilderTests":       { "position": 2, "purpose": "Verify builder/configuration methods" },
                        "B3_TransitionTests":    { "position": 3, "purpose": "Verify state transitions and validation logic" },
                        "B4_QueryTests":         { "position": 4, "purpose": "Verify post-transition accessors return correct values" },
                        "B5_IdentityTests":      { "position": 5, "purpose": "Verify PRAGMA/METADATA static data integrity" },
                        "B6_ErrorTests":         { "position": 6, "purpose": "Verify error formatting and error conditions" },
                        "B7_EdgeCaseTests":      { "position": 7, "purpose": "Boundary conditions — Unicode, empty, long, special chars" },
                        "B8_TableDrivenTests":   { "position": 8, "purpose": "Systematic input/output validation using test case collections" },
                        "B9_IntegrationTests":   { "position": 9, "purpose": "End-to-end workflows — full construct-configure-transition-query" }
                    }
                }
            },

            "production_design": {
                "principle": "BODY is the file's logic layer. Everything executable lives here.",
                "scaling_signal": "If BODY exceeds ~500 lines, the file is doing too much. Extract logic into submodules.",
                "testing_pattern": "BODY code maps 1:1 to tests. Constructor methods → constructor tests. Core logic → operation tests."
            }
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING — Code Zones + Documentation Sections
        // ═══════════════════════════════════════════════════════
        //
        // CLOSING contains two kinds of content:
        //   1. Code zones (Cv, Ce, Cc) — actual executable code
        //   2. Documentation sections (X1-X6) — guidance for humans
        //
        // Code zones ALWAYS precede documentation sections.
        // Within each category, order is fixed.

        "closing_code_zones": {
            "type": "object",
            "description": "CLOSING code zones — actual executable code for validation, execution, and cleanup. Code zones always precede documentation sections.",

            "ordering_principle": "prove_then_run_then_clean",

            "zones": {
                "Cv_Validation": {
                    "position": 1,
                    "tag": "Cv",
                    "name": "Closing Validation",
                    "purpose": "Tests — prove code works",
                    "subtype_content": {
                        "library": "Inline test module with white-box access to private internals",
                        "executable": "Exit code mapping tests, error display tests, identity verification",
                        "demo_test": "Meta-validation — tests verifying test infrastructure (fixtures, helpers)"
                    }
                },
                "Ce_Execution": {
                    "position": 2,
                    "tag": "Ce",
                    "name": "Closing Execution",
                    "purpose": "Entry point, init, registration — code that starts execution",
                    "subtype_content": {
                        "library": "Empty — libraries have no entry point",
                        "executable": "main() + exit_code() — thin entry delegating to run() (BODY)",
                        "demo_test": "Empty — test harness is the entry point"
                    }
                },
                "Cc_Cleanup": {
                    "position": 3,
                    "tag": "Cc",
                    "name": "Closing Cleanup",
                    "purpose": "Resource deallocation, teardown, Drop impls",
                    "subtype_content": {
                        "library": "Drop/Destructor implementations for resource cleanup",
                        "executable": "Process cleanup — temp files, buffer flushing, connections",
                        "demo_test": "Test fixture teardown — cleanup helpers, resource deallocation"
                    }
                }
            }
        },

        "closing_documentation": {
            "type": "object",
            "description": "CLOSING documentation sections — guidance for humans, not compilers. Always follow code zones.",

            "sections": {
                "X1_Policy": {
                    "position": 1,
                    "tag": "X1",
                    "name": "Policy",
                    "required": true,
                    "purpose": "Modification guidelines — never/careful/safe classification",
                    "fields": {
                        "required": ["never", "careful", "safe"],
                        "defined": ["scripture"]
                    }
                },
                "X2_Extension": {
                    "position": 2,
                    "tag": "X2",
                    "name": "Extension",
                    "required": false,
                    "purpose": "Designed growth points — planned features, expansion areas"
                },
                "X3_Troubleshooting": {
                    "position": 3,
                    "tag": "X3",
                    "name": "Troubleshooting",
                    "required": false,
                    "purpose": "Common problems and solutions"
                },
                "X4_Reference": {
                    "position": 4,
                    "tag": "X4",
                    "name": "Reference",
                    "required": false,
                    "purpose": "Related files, dependencies, validation commands"
                },
                "X5_Note": {
                    "position": 5,
                    "tag": "X5",
                    "name": "Note",
                    "required": true,
                    "purpose": "Closing scripture anchor — grounds the file in eternal truth",
                    "fields": {
                        "required": ["note", "scripture"],
                        "defined": ["anchor"]
                    }
                },
                "X6_Template": {
                    "position": 6,
                    "tag": "X6",
                    "name": "Template",
                    "required": false,
                    "template_only": true,
                    "purpose": "Instantiation guide — remove when copying from template"
                }
            }
        },

        "closing_zone_ordering": {
            "type": "object",
            "description": "Full CLOSING ordering: code zones first, then documentation sections. This is the canonical sequence.",
            "ordering_principle": "prove_then_run_then_clean_then_document",
            "canonical_order": ["Cv", "Ce", "Cc", "X1", "X2", "X3", "X4", "X5", "X6"],
            "code_zones": ["Cv", "Ce", "Cc"],
            "documentation_sections": ["X1", "X2", "X3", "X4", "X5", "X6"],
            "rule": "Code zones precede documentation sections. Within each group, order is fixed."
        },

        // ═══════════════════════════════════════════════════════
        // PLACEMENT RULES — Universal categories
        // ═══════════════════════════════════════════════════════
        //
        // Format-independent rules for what goes where.
        // Format schemas may add format-specific refinements.

        "placement_rules": {
            "type": "object",
            "description": "Universal placement rules for 4-block code files. What belongs in which block.",

            "SETUP": {
                "must_contain": [
                    "Import/use declarations",
                    "Module declarations and re-exports",
                    "Constant definitions",
                    "Static/singleton definitions",
                    "Type aliases",
                    "Error type definitions and completing implementations (Display, From)",
                    "Struct/enum/interface definitions (data shapes)",
                    "Trait/interface definitions (contracts)",
                    "Macro/code-generation definitions",
                    "Conditional compilation declarations"
                ],
                "must_not_contain": [
                    "Function implementations with logic",
                    "Business logic of any kind",
                    "I/O operations",
                    "Network calls or database queries"
                ]
            },

            "BODY": {
                "must_contain": [
                    "Function and method implementations (logic)",
                    "Behavioral trait/interface implementations",
                    "Complex constructors with validation",
                    "Builder pattern methods and state transitions",
                    "run() function (executables)",
                    "Free functions and module-level utilities"
                ],
                "must_not_contain": [
                    "Import/use declarations (SETUP S1)",
                    "Constant and static definitions (SETUP S3-S4)",
                    "Type definitions (SETUP S7)",
                    "Trait/interface definitions (SETUP S8)"
                ]
            },

            "CLOSING": {
                "must_contain": [
                    "Test modules/functions (Cv zone)",
                    "main() function — entry point (Ce zone, executable only)",
                    "exit_code() mapping (Ce zone, executable only)",
                    "Drop/destructor implementations (Cc zone)",
                    "Test fixture teardown (Cc zone)"
                ],
                "must_not_contain": [
                    "run() function (BODY — business logic must be testable)",
                    "Public API methods (BODY — they ARE the library)",
                    "Type definitions (SETUP)",
                    "Import declarations (SETUP)"
                ]
            },

            "METADATA": {
                "must_contain": [
                    "Identity directives (//omni:key, //omni:code, //omni:version)",
                    "Identity statics (PRAGMA, METADATA)",
                    "Comment-based metadata (Key:, Purpose:, Scripture:)",
                    "Doc comments (format-specific)"
                ],
                "must_not_contain": [
                    "Executable code of any kind",
                    "Import declarations",
                    "Type definitions"
                ]
            }
        },

        // ═══════════════════════════════════════════════════════
        // DIRECTIVES — OmniCode identity markers
        // ═══════════════════════════════════════════════════════

        "directives": {
            "type": "object",
            "description": "OmniCode identity directives — format-independent concept, format-specific syntax.",

            "required": {
                "key": {
                    "purpose": "Unique Bereshit identifier",
                    "pattern_concept": "omni:key B-{path}",
                    "severity_crate_root": "error",
                    "severity_module": "warn"
                }
            },

            "recommended": {
                "code": {
                    "purpose": "File type and format classification",
                    "pattern_concept": "omni:code --{language} -{subtype}",
                    "severity": "warn"
                },
                "version": {
                    "purpose": "Living version",
                    "pattern_concept": "omni:version {stage}-{phase}.{completion}",
                    "severity": "warn"
                }
            },

            "template_directive": {
                "purpose": "Marks file as a seed template",
                "pattern_concept": "omni template --{language} -{subtype}",
                "note": "Templates use 'usable schema' pattern — all values describe the template ITSELF"
            }
        },

        // ═══════════════════════════════════════════════════════
        // IDENTITY — I/C sections (references base-3block)
        // ═══════════════════════════════════════════════════════

        "identity": {
            "type": "object",
            "description": "Code files use the same I/C metadata as data files. I1-I4 Identity + C1-C7 Context. Shared with base-3block-schema.jsonc — format schemas $ref those $defs.",

            "note": "4-block files express I/C through format-specific constructs: Rust uses static PRAGMA/METADATA slices or BTreeMaps; Go uses var Pragma/Metadata maps; C uses /* comment blocks */. The CONTENT of I/C is the same; the REPRESENTATION differs.",

            "pragma_sections": {
                "I1_core":         { "required": ["key", "format", "from", "at"], "purpose": "WHO — unique identity" },
                "I2_family":       { "required": ["type", "structure"], "defined": ["subtype", "role"], "purpose": "WHAT — classification" },
                "I3_instance":     { "required": ["file", "title"], "defined": ["component", "path", "provides", "brief"], "purpose": "THIS — file-specific" },
                "I4_architecture": { "defined": ["layer", "position", "pattern"], "purpose": "WHERE — structural context" }
            },

            "metadata_sections": {
                "C1_state":          { "required": ["version", "status"], "defined": ["created", "updated"], "purpose": "WHEN — lifecycle" },
                "C2_attribution":    { "required": ["organization"], "defined": ["architect", "implementation", "copyright"], "purpose": "WHO MADE — credit" },
                "C3_grounding":      { "required": ["scripture"], "defined": ["principle", "anchor"], "purpose": "WHY — biblical foundation" },
                "C4_dependencies":   { "required": ["requires", "consumers"], "defined": ["integration", "if_missing"], "purpose": "NEEDS — dependency graph" },
                "C5_intent":         { "defined": ["purpose", "philosophy"], "purpose": "GOAL — design intent" },
                "C6_roadmap":        { "defined": ["current", "planned", "limitations"], "purpose": "NEXT — trajectory" },
                "C7_classification": { "defined": ["tags", "category", "domain", "paradigm"], "purpose": "TAGS — discovery" }
            }
        },

        // ═══════════════════════════════════════════════════════
        // SUBTYPES — File classification
        // ═══════════════════════════════════════════════════════

        "subtypes": {
            "type": "object",
            "description": "4-block file subtypes — same block structure, different BODY ordering and CLOSING emphasis.",

            "library": {
                "purpose": "Library/package — exposes public API, holds crate/package identity",
                "body_ordering": "type_lifecycle",
                "body_count": 7,
                "closing_emphasis": { "heavy": ["Cv"], "light": ["Ce", "Cc"] },
                "setup_emphasis": { "heavy": ["Imports", "Modules", "ErrorTypes", "CoreTypes", "TraitDefs"], "light": ["Constants", "Statics", "Macros"] }
            },

            "executable": {
                "purpose": "Binary — orchestrates via main() → run() → Result pattern",
                "body_ordering": "execution_flow",
                "body_count": 3,
                "closing_emphasis": { "heavy": ["Ce", "Cv"], "light": ["Cc"] },
                "setup_emphasis": { "heavy": ["Imports", "Constants", "Statics"], "light": ["Modules", "CoreTypes", "TraitDefs", "Macros"] }
            },

            "demo_test": {
                "purpose": "Test file — validates behavior, proves claims",
                "body_ordering": "concern_coverage",
                "body_count": 9,
                "closing_emphasis": { "heavy": ["Cv", "Cc"], "light": ["Ce"] },
                "setup_emphasis": { "heavy": ["Imports", "Constants", "CoreTypes", "Macros"], "light": ["Modules", "Statics", "TraitDefs", "FeatureGates"] }
            }
        },

        // ═══════════════════════════════════════════════════════
        // HEALTH SCORING — Universal 4-block contract
        // ═══════════════════════════════════════════════════════
        //
        // Ternary scoring: -100 (shavar) → 0 (yashar) → +100 (tov).
        // Each check produces an AtomicAction with direction × impact_weight.
        //   direction: +1 (aligned), 0 (neutral/not assessable), -1 (misaligned)
        //   impact_weight: error = 2.0, warn = 1.0, info = 0.25
        //
        // Atomic: single check → 1 action.
        // Compound: expands to N actions based on data (e.g., I/C fields).
        //
        // Score = (sum of direction × weight) / (sum of |weight|) × 100
        // Neutral actions are tracked but excluded from score calculation.
        //
        // Format schemas extend this with format-specific checks.
        // This base defines WHAT is checked; handlers define HOW.

        "health_scoring": {
            "type": "object",
            "description": "Universal health scoring contract for 4-block code files. Defines containers, checks, and expected action counts. Format schemas add format-specific checks.",

            "scoring_model": {
                "range": [-100, 100],
                "labels": { "-100": "shavar (broken)", "0": "yashar (neutral)", "100": "tov (perfect)" },
                "weights": { "error": 2.0, "warn": 1.0, "info": 0.25 },
                "formula": "sum(direction × weight) / sum(|weight|) × 100",
                "empty": 0,
                "neutral_rule": "direction=0 tracked in totals but excluded from score calculation"
            },

            "blocks": {

                "structural": {
                    "description": "Block skeleton — presence, ordering, separators. Universal across all 4-block formats.",

                    "containers": {
                        "blocks": {
                            "description": "4 block start markers + 4 end markers + 1 ordering check",
                            "checks": [
                                { "check": "block/{BLOCK}", "count": 4, "type": "atomic", "impact": "error", "note": "One per block: METADATA, SETUP, BODY, CLOSING" },
                                { "check": "block/end-{BLOCK}", "count": 4, "type": "atomic", "impact": "warn", "note": "END marker for each block" },
                                { "check": "block/order", "count": 1, "type": "atomic", "impact": "error", "note": "Blocks appear in canonical order" }
                            ],
                            // 9 atomic actions. Full pass: 9 × (+1 × 1.0) = +9 contribution
                            "expected_actions": 9,
                            "expected_pass_score_contribution": "+9.0"
                        },

                        "separators": {
                            "description": "Block and subsection separator consistency",
                            "checks": [
                                { "check": "style/eq-separator-width", "count": 1, "type": "atomic", "impact": "warn" },
                                { "check": "style/eq-separator-standard", "count": 1, "type": "atomic", "impact": "info" },
                                { "check": "style/box-separator-width", "count": 1, "type": "atomic", "impact": "warn" },
                                { "check": "style/box-separator-standard", "count": 1, "type": "atomic", "impact": "info" },
                                { "check": "style/dash-separator-width", "count": 1, "type": "atomic", "impact": "warn" }
                            ],
                            // 5 atomic actions. Full pass: 3×1.0 + 2×0.25 = +3.5
                            "expected_actions": 5,
                            "expected_pass_score_contribution": "+3.5"
                        }
                    },

                    // Structural total: 14 base actions (format schemas add more)
                    "expected_base_actions": 14,
                    "note": "Format schemas add format-specific structural checks (e.g., Go: package + import = +2)"
                },

                "metadata": {
                    "description": "Identity — directives, I/C field coverage, comment metadata. Most checks are compound (expand per field).",

                    "containers": {
                        "directives": {
                            "description": "OmniCode identity directives at file top",
                            "checks": [
                                { "check": "directive/{required}", "type": "atomic", "impact": "error", "note": "1 per required directive" },
                                { "check": "directive/{recommended}", "type": "atomic", "impact": "warn", "note": "1 per recommended directive" },
                                { "check": "directive/code-format", "count": 1, "type": "atomic", "impact": "warn" }
                            ],
                            // Derived non-template: 1 required + 2 recommended + 1 format = 4
                            // Template: 2 (meta.key + template-format)
                            "expected_actions_derived": 4,
                            "expected_actions_template": 2,
                            "expected_pass_score_contribution_derived": "+3.25"
                        },

                        "identity": {
                            "description": "Pragma (I1-I4) and Metadata (C1-C7) field coverage",
                            "checks": [
                                { "check": "identity/Pragma/empty", "count": 1, "type": "atomic", "impact": "warn" },
                                { "check": "identity/Metadata/empty", "count": 1, "type": "atomic", "impact": "warn" },
                                { "check": "identity/upgrade", "count": 1, "type": "atomic", "impact": "info" },
                                { "check": "identity/Pragma/{section}.{field}", "type": "compound", "impact": "warn/info", "note": "Expands to 1 action per I1-I4 field (required + defined)" },
                                { "check": "identity/Metadata/{section}.{field}", "type": "compound", "impact": "warn/info", "note": "Expands to 1 action per C1-C7 field (required + defined)" }
                            ],
                            // 3 base + 17 Pragma fields + 24 Metadata fields = 44
                            "expected_actions": 44,
                            "note": "Compound: Pragma has 17 fields (I1:4 + I2:4 + I3:6 + I4:3), Metadata has 24 (C1:4 + C2:4 + C3:3 + C4:4 + C5:2 + C6:3 + C7:4)"
                        },

                        "field-values": {
                            "description": "Content validation — field VALUES (not just existence). Structure → Existence → Content growth path.",
                            "checks": [
                                { "check": "value/Pragma/I1.key", "count": 1, "type": "atomic", "impact": "warn", "validation": "pattern", "note": "Key matches B-{identifier}" },
                                { "check": "value/Pragma/I1.format", "count": 1, "type": "atomic", "impact": "warn", "validation": "enum", "note": "Known format (go, rust, c, etc.)" },
                                { "check": "value/Pragma/I1.from", "count": 1, "type": "atomic", "impact": "info", "validation": "path-like", "note": "Contains /" },
                                { "check": "value/Pragma/I1.at", "count": 1, "type": "atomic", "impact": "warn", "validation": "pattern", "note": "Living version: stage-phase.completion" },
                                { "check": "value/Pragma/I2.type", "count": 1, "type": "atomic", "impact": "warn", "validation": "enum", "note": "code, data, documentation" },
                                { "check": "value/Pragma/I2.structure", "count": 1, "type": "atomic", "impact": "warn", "validation": "enum", "note": "3-block, 4-block, 5-block" },
                                { "check": "value/Pragma/I3.file", "count": 1, "type": "atomic", "impact": "warn", "validation": "non-empty" },
                                { "check": "value/Pragma/I3.title", "count": 1, "type": "atomic", "impact": "warn", "validation": "non-empty" },
                                { "check": "value/Metadata/C1.version", "count": 1, "type": "atomic", "impact": "warn", "validation": "pattern", "note": "Living version" },
                                { "check": "value/Metadata/C1.status", "count": 1, "type": "atomic", "impact": "warn", "validation": "enum", "note": "Active, Draft, Deprecated, Archived, Planned, Template" },
                                { "check": "value/Metadata/C1.created", "count": 1, "type": "atomic", "impact": "info", "validation": "pattern", "note": "YYYY-MM-DD" },
                                { "check": "value/Metadata/C1.updated", "count": 1, "type": "atomic", "impact": "info", "validation": "pattern", "note": "YYYY-MM-DD" },
                                { "check": "value/Metadata/C2.organization", "count": 1, "type": "atomic", "impact": "warn", "validation": "non-empty" },
                                { "check": "value/Metadata/C3.scripture", "count": 1, "type": "atomic", "impact": "info", "validation": "non-empty" }
                            ],
                            // 14 atomic actions: 10 warn-weight + 4 info-weight
                            // Full pass: 10 × 1.0 + 4 × 0.25 = +11.0
                            "expected_actions": 14,
                            "expected_pass_score_contribution": "+11.0",
                            "cascade_from": "identity — if field doesn't exist, content check is neutral",
                            "growth_path": "This is the first content scoring layer. Future: cross-field validation (I1.at == C1.version), filename consistency (I3.file matches actual), deeper semantic checks."
                        },

                        "comment-meta": {
                            "description": "Comment-based metadata fields (secondary to Pragma/Metadata vars)",
                            "checks": [
                                { "check": "comment-meta/biblical", "count": 1, "type": "atomic", "impact": "info" },
                                { "check": "comment-meta/version", "count": 1, "type": "atomic", "impact": "info" }
                            ],
                            "expected_actions": 2,
                            "expected_pass_score_contribution": "+0.5"
                        },

                        "derived_or_template": {
                            "description": "Template vs derived classification check",
                            "checks": [
                                { "check": "template/build-ignore | derived/build-ignore", "count": 1, "type": "atomic", "impact": "error|warn" }
                            ],
                            "expected_actions": 1
                        }
                    },

                    "expected_base_actions_derived": 65,
                    "note": "Directive(4) + Identity(44) + FieldValues(14) + CommentMeta(2) + Derived(1). Doc.go files skip most checks."
                },

                "setup": {
                    "description": "SETUP subsection ordering + header documentation.",

                    "containers": {
                        "ordering": {
                            "description": "SETUP subsection order validation",
                            "checks": [
                                { "check": "setup/subsection-order", "count": 1, "type": "atomic", "impact": "warn" }
                            ],
                            "expected_actions": 1,
                            "expected_pass_score_contribution": "+1.0"
                        },

                        "content": {
                            "description": "SETUP header documentation presence — section-order overview before first subsection",
                            "checks": [
                                { "check": "setup/header-doc", "count": 1, "type": "atomic", "impact": "info" }
                            ],
                            "expected_actions": 1,
                            "expected_pass_score_contribution": "+0.25"
                        }
                    },

                    "expected_actions": 2,
                    "note": "Placement checks (metadata-leak, block-placement, subsection-placement) also contribute to metadata/setup blocks."
                },

                "body": {
                    "description": "BODY subsection ordering + subtype-specific content validation.",

                    "containers": {
                        "ordering": {
                            "description": "BODY subsection order validation",
                            "checks": [
                                { "check": "body/subsection-order", "count": 1, "type": "atomic", "impact": "warn" }
                            ],
                            "expected_actions": 1,
                            "expected_pass_score_contribution": "+1.0"
                        },

                        "content": {
                            "description": "BODY subtype-specific subsection validation — canonical names match declared subtype",
                            "checks": [
                                { "check": "body/subtype-subsections", "count": 1, "type": "atomic", "impact": "info" }
                            ],
                            "expected_actions": 1,
                            "expected_pass_score_contribution": "+0.25"
                        }
                    },

                    "expected_actions": 2
                },

                "closing": {
                    "description": "CLOSING zone ordering, content placement, required zones, and zone content.",

                    "containers": {
                        "zone-ordering": {
                            "description": "Cv → Ce → Cc → X1-X6 canonical order",
                            "checks": [
                                { "check": "closing/zone-order", "count": 1, "type": "atomic", "impact": "warn", "note": "Code zones before doc sections" },
                                { "check": "closing/code-zone-order", "count": 1, "type": "atomic", "impact": "warn", "note": "Cv → Ce → Cc" },
                                { "check": "closing/doc-section-order", "count": 1, "type": "atomic", "impact": "warn", "note": "X1 → X2 → ... → X6" }
                            ],
                            "expected_actions": 3,
                            "expected_pass_score_contribution": "+3.0"
                        },

                        "content-placement": {
                            "description": "Tests in Cv zone, main() in Ce zone",
                            "checks": [
                                { "check": "closing/test-placement", "count": 1, "type": "atomic", "impact": "warn" },
                                { "check": "closing/main-placement", "count": 1, "type": "atomic", "impact": "warn" }
                            ],
                            "expected_actions": 2,
                            "expected_pass_score_contribution": "+2.0"
                        },

                        "required-zones": {
                            "description": "Required CLOSING documentation zones presence — X1 (Policy) and X5 (Note)",
                            "checks": [
                                { "check": "closing/required-X1", "count": 1, "type": "atomic", "impact": "info", "note": "X1 Policy zone required" },
                                { "check": "closing/required-X5", "count": 1, "type": "atomic", "impact": "info", "note": "X5 Note zone required" }
                            ],
                            "expected_actions": 2,
                            "expected_pass_score_contribution": "+0.5"
                        },

                        "zone-content": {
                            "description": "CLOSING zone internal content validation — required fields within X1 and X5",
                            "checks": [
                                { "check": "closing/X1-content", "count": 1, "type": "atomic", "impact": "info", "note": "X1 has Never/Careful/Safe" },
                                { "check": "closing/X5-content", "count": 1, "type": "atomic", "impact": "info", "note": "X5 has Note/Scripture" }
                            ],
                            "expected_actions": 2,
                            "expected_pass_score_contribution": "+0.5",
                            "cascade_from": "required-zones — if zone missing, content check is neutral"
                        }
                    },

                    "expected_actions": 9
                }
            },

            "placement": {
                "description": "Content placement — spans metadata and setup blocks.",
                "container": "placement",
                "checks": [
                    { "check": "content/metadata-leak", "block": "metadata", "count": 1, "type": "atomic", "impact": "warn" },
                    { "check": "content/block-placement", "block": "setup", "count": 1, "type": "atomic", "impact": "warn" },
                    { "check": "content/subsection-placement", "block": "setup", "count": 1, "type": "atomic", "impact": "warn" }
                ],
                "expected_actions": 3,
                "expected_pass_score_contribution": "+3.0"
            },

            "scaling": {
                "description": "File size scaling signals — early warning for files growing too large. Spans SETUP and BODY blocks.",
                "checks": [
                    { "check": "scaling/setup-size", "block": "setup", "count": 1, "type": "atomic", "impact": "info", "note": "SETUP > 200 lines suggests extraction" },
                    { "check": "scaling/body-size", "block": "body", "count": 1, "type": "atomic", "impact": "info", "note": "BODY > 500 lines suggests splitting" }
                ],
                "expected_actions": 2,
                "expected_pass_score_contribution": "+0.5"
            },

            "cascade_rules": {
                "description": "When a parent check fails, child checks become neutral (direction=0) to prevent score inflation.",
                "cascades": [
                    { "trigger": "block/{BLOCK} missing", "neutralizes": "All checks in that block", "note": "Missing METADATA → all metadata checks become neutral" },
                    { "trigger": "identity/Pragma/empty", "neutralizes": "All identity/Pragma/I*.field checks + content value checks", "note": "Can't check fields of empty var" },
                    { "trigger": "identity/Metadata/empty", "neutralizes": "All identity/Metadata/C*.field checks + content value checks", "note": "Can't check fields of empty var" },
                    { "trigger": "identity/{var}/{field} missing", "neutralizes": "Corresponding value/{var}/{field} check", "note": "Can't assess content of missing field" },
                    { "trigger": "closing/required-X1 failed", "neutralizes": "closing/X1-content", "note": "Can't assess X1 content if X1 zone missing" },
                    { "trigger": "closing/required-X5 failed", "neutralizes": "closing/X5-content", "note": "Can't assess X5 content if X5 zone missing" }
                ]
            },

            "expected_total_derived": {
                "base_actions": 99,
                "breakdown": "structural(14+format) + metadata(65) + setup(1+1) + placement(3) + body(1+1) + closing(5+4) + scaling(2)",
                "note": "99 for Go/Rust with standard format checks. All aligned = 100/±100.",
                "full_pass_score": 100
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // This is the base schema — it defines $defs only.
    // Format-specific schemas compose these into validation rules.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "This schema provides $defs only. Validate format-specific schemas against their targets.",
    "_Cv_expected_state": "All $defs present with correct structure: block ordering, SETUP 10 subsections, BODY 3 subtype variants, CLOSING code zones + docs, placement rules, directives, identity, subtypes.",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy [REQUIRED] → X.2 Extension [DEFINED] → X.3 Troubleshooting [DEFINED] → X.4 Reference [DEFINED] → X.5 Note [REQUIRED]",

    // X.1 POLICY [REQUIRED]
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Look that thou make them after their pattern. — Exodus 25:40",
    "_X1_never": [
        "Remove a $def that format schemas reference",
        "Change the 4-block ordering (METADATA → SETUP → BODY → CLOSING)",
        "Remove SETUP subsection ordering (S1-S10 dependency chain)",
        "Remove CLOSING zone ordering (Cv → Ce → Cc → X1-X6)"
    ],
    "_X1_careful": [
        "Adding new SETUP subsections (affects all 4-block formats)",
        "Changing BODY subtype structures (cascades to format schemas and linters)",
        "Adding new required CLOSING documentation sections",
        "Modifying placement rules (affects all format linters)"
    ],
    "_X1_safe": [
        "Adding optional properties to existing $defs",
        "Adding description fields and production notes",
        "Adding new optional $defs that don't affect existing schemas",
        "Adding new subtypes (extending, not changing)"
    ],

    // X.2 EXTENSION [DEFINED]
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "C language 4-block schema (/* */ comment-based)",
        "Python 4-block schema (# comment-based)",
        "TypeScript 4-block schema (// comment-based)",
        "Schema-driven Rust linter (load from rust-4block-schema.jsonc like TOML does)",
        "Cross-format identity validation (key in code matches key in config)"
    ],

    // X.3 TROUBLESHOOTING [DEFINED]
    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "4block_vs_3block": "Use 4-block for code files (Go, Rust, C, Python). Use 3-block for data files (TOML, JSON). Use 5-block for documentation (AsciiDoc, Markdown).",
        "setup_vs_body": "If it DECLARES something (type, constant, import), it belongs in SETUP. If it DOES something (logic, computation, I/O), it belongs in BODY.",
        "closing_ordering": "Code zones (Cv/Ce/Cc) come FIRST, then documentation (X1-X6). Tests before entry points. Entry before cleanup.",
        "body_subtypes": "Library = 7 subsections (type lifecycle). Executable = 3 (execution flow). Demo-test = 9 (concern coverage). Don't mix ordering principles.",
        "which_schema": "This is the BASE — it doesn't validate files directly. Use rust-4block-schema.jsonc, go-4block-schema.jsonc, etc."
    },

    // X.4 REFERENCE [DEFINED]
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "schemas/data/base/base-3block-schema.jsonc — Parent: shared I/C metadata $defs",
        "schemas/code/format/rust-4block-schema.jsonc — Child: Rust format expression",
        "schemas/code/format/go-4block-schema.jsonc — Child: Go format expression",
        "schemas/code/format/makefile-4block-schema.jsonc — Child: Makefile format expression",
        "c-tov/cws-struct/lib/handlers/rust.ts — Runtime Rust linter",
        "c-tov/cws-struct/lib/handlers/go.ts — Runtime Go linter"
    ],

    // X.5 NOTE [REQUIRED]
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "Code has a unique problem data doesn't: it DOES things. Data sits and describes. Code acts and transforms. The 4-block structure tames this by separating existence (SETUP) from action (BODY) — the same separation Genesis made between forming (day 1-3) and filling (day 4-6). SETUP forms the landscape. BODY fills it with life. CLOSING proves the creation is good.",
    "_X5_scripture": "And God saw every thing that he had made, and, behold, it was very good. — Genesis 1:31",
    "_X5_anchor": "SETUP forms. BODY fills. CLOSING declares 'it is good.' The pattern is Genesis. The structure is worship.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
