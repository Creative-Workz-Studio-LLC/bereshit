    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-structure-molded-library",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "form-structure-schema",
    "_P2_role": "structure-molded",
    "_P5_title": "Library Form Structure — The Public API",
    "_P5_brief": "Format-agnostic structural definition of library form. The fullest non-test form — exposes public API, holds crate/package identity, owns the output layer. All 10 SETUP sections available. 7 BODY sections in type_lifecycle order.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "form": {
        "name": "library",
        "extends": "structure/whole/4-block.jsonc",
        "derives_from": "structure/molded/bare-bone.jsonc",
        "is_foundation": false,
        "purpose": "Library/package — exposes public API, holds crate/package identity",

        "principle": "Library is the body itself — the crate root, the package entry. It declares the public surface, owns the output layer, and orchestrates modules. The fullest non-test form.",

        "SETUP": {
            "required": ["Imports", "Constants", "ErrorTypes", "CoreTypes"],
            "available": ["Modules", "Statics", "TypeAliases", "TraitDefs", "Macros", "FeatureGates"],
            "reserved": [],
            "required_count": 4,
            "available_count": 6,
            "reserved_count": 0,
            "total": 10,

            "promotes_from_bare_bone": {
                "to_available": ["Modules", "Statics", "TypeAliases", "TraitDefs", "Macros", "FeatureGates"]
            },

            "emphasis": {
                "heavy": ["Imports", "ErrorTypes", "CoreTypes"],
                "light": ["Constants", "Variables"]
            },

            "note": "Library has ALL 10 SETUP sections available. The crate root can declare modules, define macros, gate features — it owns the entire declaration surface."
        },

        "BODY": {
            "required": ["IdentityAccess", "TraitImplementations", "Constructors", "CoreLogic", "Queries", "Output", "FreeFunctions"],
            "reserved": ["Helpers", "ConstructorTests", "BuilderTests", "TransitionTests", "QueryTests", "IdentityTests", "ErrorTests", "EdgeCaseTests", "TableDrivenTests", "IntegrationTests"],
            "required_count": 7,
            "reserved_count": 10,
            "total": 17,
            "ordering": "type_lifecycle",
            "ordering_sequence": ["IdentityAccess", "TraitImplementations", "Constructors", "CoreLogic", "Queries", "Output", "FreeFunctions"],

            "promotes_from_bare_bone": {
                "to_required": ["TraitImplementations", "Constructors", "Queries", "Output"]
            },

            "note": "Type lifecycle: Identity → Traits → Constructors → CoreLogic → Queries → Output → Free. Mirrors how a consumer USES the library."
        },

        "CLOSING": {
            "required": ["Cv", "Ce", "X1", "X4", "X5"],
            "available": ["Cc", "X2", "X3"],
            "reserved": ["TestCoverageSummary", "X6"],
            "required_count": 5,
            "available_count": 3,
            "reserved_count": 2,
            "total": 10,
            "emphasis": { "heavy": ["Cv"], "light": ["Ce", "Cc"] },

            "promotes_from_bare_bone": {
                "to_available": ["Cc", "X2", "X3"]
            },

            "removes": {
                "X6": "Library is a derived file, not a template."
            },

            "ce_note": "Ce is structurally required. For libraries, Ce typically contains registration functions (register_identity). Libraries have no main()."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Library is the body itself — not a member but the whole. It declares what's public, orchestrates its modules, and presents the unified API to the world. The fullest expression of the 4-block structure, where every section serves the consumer.",
    "_X5_scripture": "Now ye are the body of Christ, and members in particular. — 1 Corinthians 12:27"
