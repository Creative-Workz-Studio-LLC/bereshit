{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-structure-molded-executable",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "form-structure-schema",
    "_P2_role": "structure-molded",
    "_P5_title": "Executable Form Structure — The Entry Point",
    "_P5_brief": "Format-agnostic structural definition of executable form. Binary — orchestrates via main() -> run() -> Result pattern. Lean BODY (3 sections, execution_flow ordering), heavy CLOSING (Ce owns main(), Cv validates exit codes).",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "form": {
        "name": "executable",
        "extends": "structure/whole/4-block.jsonc",
        "derives_from": "structure/molded/bare-bone.jsonc",
        "is_foundation": false,
        "purpose": "Binary — orchestrates via main() -> run() -> Result pattern",

        "principle": "Executables are thin. They parse args, call libraries, and report results. The logic lives in library crates. The executable is the bridge between the human (CLI) and the system (library).",

        "SETUP": {
            "required": ["Imports", "Constants", "ErrorTypes", "CoreTypes"],
            "available": ["Modules", "Statics", "TypeAliases", "FeatureGates"],
            "reserved": ["TraitDefs", "Macros"],
            "required_count": 4,
            "available_count": 4,
            "reserved_count": 2,
            "total": 10,

            "promotes_from_bare_bone": {
                "to_available": ["Modules", "Statics", "TypeAliases", "FeatureGates"]
            },

            "reserves_specifically": {
                "TraitDefs": "Executables consume traits, they don't define them. Trait definitions belong in libraries.",
                "Macros": "Executables use macros, they don't export them. Macro definitions belong in libraries."
            }
        },

        "BODY": {
            "required": ["IdentityAccess", "Helpers", "CoreLogic"],
            "reserved": ["TraitImplementations", "Constructors", "Queries", "Output", "FreeFunctions", "ConstructorTests", "BuilderTests", "TransitionTests", "QueryTests", "IdentityTests", "ErrorTests", "EdgeCaseTests", "TableDrivenTests", "IntegrationTests"],
            "required_count": 3,
            "reserved_count": 14,
            "total": 17,
            "ordering": "execution_flow",
            "ordering_sequence": ["IdentityAccess", "Helpers", "CoreLogic"],

            "promotes_from_bare_bone": {
                "to_required": ["Helpers"]
            },

            "renames": {
                "CoreLogic": "The run() function — main business logic separated from main(). Executables call it CoreOperations.",
                "Helpers": "Argument parsing, config loading, output formatting — setup for run()."
            },

            "note": "Execution flow: Identity → Helpers (parse args, load config) → Core (run()). Code reads in the order it runs. Executables orchestrate; computation lives in libraries."
        },

        "CLOSING": {
            "required": ["Cv", "Ce", "X1", "X4", "X5"],
            "available": ["Cc", "X2", "X3"],
            "reserved": ["TestCoverageSummary", "X6"],
            "required_count": 5,
            "available_count": 3,
            "reserved_count": 2,
            "total": 10,
            "emphasis": { "heavy": ["Ce", "Cv"], "light": ["Cc"] },

            "promotes_from_bare_bone": {
                "to_available": ["Cc", "X2", "X3"]
            },

            "removes": {
                "X6": "Executable is a derived file, not a template."
            },

            "ce_note": "Ce is the HEAVY zone for executables. Contains main() + exit_code() — thin entry delegating to run() in BODY."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Executables are doorways. They stand between the human and the system — receiving commands, translating them into library calls, and reporting results. A good doorway is thin and well-framed. The executable form enforces this: 3 BODY sections, execution_flow ordering. If the executable is getting fat, the logic belongs in a library.",
    "_X5_scripture": "I am the door: by me if any man enter in, he shall be saved, and shall go in and out, and find pasture. — John 10:9"
}
