{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-form-demo-test-rust",
    "_P1_from": "b-word/L1-omnicode/ladder/schemas/code/forms/bare-bone/rust-bare-bone.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "form-constraint",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/forms/declared",
    "_P3_includes": "none",
    "_P3_provides": ["DEMO_TEST_FORM_CONSTRAINTS", "CONTAINER_CAN_CANNOT", "CONCERN_COVERAGE_ORDERING"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust Demo-Test Form Schema",
    "_P5_brief": "Defines what CAN and CANNOT be in each container of a demo-test Rust file. Demo-test is the form for comprehensive test/demo files — files that validate a crate's public API through 9 concern-based test categories. Inherits bare-bone's foundation and promotes ALL 9 test categories as BODY sections. BODY follows concern_coverage ordering: ConstructorTests → BuilderTests → TransitionTests → QueryTests → IdentityTests → ErrorTests → EdgeCaseTests → TableDrivenTests → IntegrationTests. Ce is EMPTY (cargo test is the harness). TestCoverageSummary promoted. Every constraint has a WHY and a HOW.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-demo-test.jsonc",
        "key": "B-L1-schemas-form-demo-test-rust",
        "title": "Rust Demo-Test Form Schema",
        "type": "Data (Form Constraint Schema)",
        "component": "Ladder",
        "role": "Define per-container CAN/CANNOT constraints for demo-test Rust form — comprehensive test/demo files with 9 concern-based test categories validating a crate's public API"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-19",
        "updated": "2026-02-19"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Genesis 1:20-21 — And God said, Let the waters bring forth abundantly the moving creature that hath life... And God created great whales, and every living creature that moveth.",
        "principle": "Demo-test is Day 5 energy — the waters bringing forth ABUNDANTLY. Not a single creature but EVERY kind — the test suite is comprehensive, covering construction through integration. Day 5 fills the waters (test space) with life (test cases). Each test category is a species. The abundance is intentional: comprehensive coverage IS the form's purpose. bare-bone tests minimally (2-3). Demo-test tests ABUNDANTLY (9 categories × N tests each)."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": [
            "code/base/base-4block-schema.jsonc — container definitions, form registry, reserved omission contract",
            "code/format/rust-4block-schema.jsonc — Rust syntax rules, comment conventions, identity patterns",
            "code/forms/bare-bone/rust-bare-bone.jsonc — foundation form (demo-test inherits from bare-bone)"
        ],
        "consumers": [
            "b-word/seed/code/L0/rust/demo-test.rs — the actual template this schema constrains (when created)",
            "All demo-test-form Rust files: comprehensive test/demo files validating crate APIs"
        ],
        "relationship": "bare-bone defines THE MINIMUM. This demo-test schema defines what CHANGES when promoting to demo-test form — 9 test categories activate as BODY sections, TestCoverageSummary promoted, concern_coverage ordering structures the BODY."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // THE DEMO-TEST FORM CONSTRAINT SCHEMA
    //
    // This file answers one question per container:
    //   WHAT can be here? WHAT cannot? WHY? HOW to work with it?
    //
    // Demo-test inherits bare-bone's foundation and EXPANDS:
    //   SETUP: All 6 reserved promoted (same as library — test files need full type vocabulary)
    //   BODY:  +9 test categories in concern_coverage ordering, FreeFunctions renamed to IdentityAccess
    //   CLOSING: Ce EMPTY (cargo test is harness), TestCoverageSummary promoted, Cc/X2/X3 available
    //
    // BODY ordering: concern_coverage
    //   Construction → Building → Transition → Query → Identity →
    //   Error → Edge → Table → Integration
    //
    // Three-status-level system: REQUIRED, AVAILABLE, RESERVED
    //
    // Structure mirrors base-4block-schema.jsonc container layout:
    //   METADATA → SETUP → BODY → CLOSING
    // Each container gets: can, cannot, ordering_rule, completeness.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/forms/declared/demo-test/rust.schema.json",
    "title": "Rust Demo-Test Form Constraints",
    "description": "Per-container CAN/CANNOT constraints for demo-test Rust files. Comprehensive test/demo files with 9 concern-based test categories validating a crate's public API.",

    "form_identity": {
        "name": "demo-test",
        "is_foundation": false,
        "inherits": "bare-bone",
        "pragma": "//omni:code --rust -demo-test",
        "template": "b-word/seed/code/L0/rust/demo-test.rs",
        "ordering": "concern_coverage — ConstructorTests → BuilderTests → TransitionTests → QueryTests → IdentityTests → ErrorTests → EdgeCaseTests → TableDrivenTests → IntegrationTests",
        "principle": "Abundant coverage. Demo-test files exist to PROVE that a crate's API works. The 9 categories ensure nothing is untested — from construction through integration. Completeness is the virtue.",
        "derivation_rule": "Demo-test = bare-bone + 9 test categories (promoted) + TestCoverageSummary (promoted) + all SETUP reserved promoted. BODY follows concern_coverage: construction → building → transition → query → identity → error → edge → table → integration.",
        "ce_state": "EMPTY — cargo test is the harness. Demo-test files never have main(). The test runner IS the entry point.",
        "key_distinction": "Library: 7 BODY sections defining a type's API. Executable: 3 BODY sections running a program. Demo-test: 9 BODY sections PROVING the API works. Demo-test is the accountability layer."
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The four containers, each fully constrained.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "containers": {

        // ═══════════════════════════════════════════════════════
        // 1. METADATA CONTAINER — identical to bare-bone
        // ═══════════════════════════════════════════════════════
        //
        // Demo-test does NOT change METADATA requirements.
        // Identity is form-invariant. The PRAGMA says -demo-test,
        // the METADATA statics are complete, everything else
        // is structurally identical to bare-bone.

        "METADATA": {
            "summary": "IDENTICAL TO BARE-BONE — fully required, every section, every required field. Demo-test does not change METADATA.",
            "reserved_omission": false,
            "inherits_from": "bare-bone METADATA (all constraints, all content_constraints)",

            "why": "Identity is form-invariant. A demo-test file has exactly the same identity requirements as bare-bone. The PRAGMA and METADATA statics have the same fields, same required/defined split, same (&str, &str) format. The only values that change are I1.key (unique to this file), I2.subtype ('demo-test' not 'bare-bone'), and C-section values (file-specific context).",

            "demo_test_specific_changes": {
                "I2_subtype": "demo-test (not bare-bone)",
                "I2_role": "Describes what this test file validates",
                "C3_scripture": "Domain-appropriate — often the same scripture as the crate being tested",
                "C5_dependencies": "References the crate being tested + test utilities",
                "C7_notes": "Test coverage goals, what aspects are validated"
            },

            "content_constraints_note": "All content_constraints from bare-bone METADATA apply unchanged. See rust-bare-bone.jsonc METADATA container for the complete constraint definitions for directives, doc_comments, pragma_statics, metadata_statics, and comment_metadata.",

            "cannot": {
                "description": "Same as bare-bone — no executable code, no imports, no types, no Reserved Omission in METADATA.",
                "inherits": "bare-bone METADATA.cannot (all prohibitions unchanged)"
            }
        },

        "_METADATA_REPLACED": "THE FULL BARE-BONE METADATA CAN BLOCK WAS HERE — replaced with inherits_from reference above. See rust-bare-bone.jsonc for complete METADATA constraints.",
        "_METADATA_ORIGINAL_SECTIONS_REMOVED": {
            "sections": ["directives", "doc_comments", "pragma_statics", "metadata_statics", "comment_metadata"],
            "reason": "Demo-test does not change ANY METADATA constraints. Full definitions in bare-bone schema.",
            "note_to_linter": "When validating demo-test METADATA, use bare-bone METADATA constraints verbatim. Only values change (I2.subtype, I2.role, C-sections), not structure."
        },


        // ═══════════════════════════════════════════════════════
        // 2. SETUP CONTAINER — 5 required + 5 available = 10
        // ═══════════════════════════════════════════════════════
        //
        // Demo-test SETUP is effectively the same as library —
        // test files need the FULL type vocabulary to test it.
        // All 6 bare-bone reserved sections are promoted.
        //
        // 5 REQUIRED: S1 Imports, S3 Constants, S6 ErrorTypes,
        //             S7 CoreTypes, S2 Modules (test organization)
        // 5 AVAILABLE: S4 Statics, S5 TypeAliases, S8 TraitDefs,
        //              S9 Macros, S10 FeatureGates
        //
        // No reserved sections — demo-test can use everything.

        "SETUP": {
            "summary": "5 required + 5 available = 10. All bare-bone reserved sections promoted — test files need the full type vocabulary.",
            "reserved_omission": false,

            "why": "Demo-test files need the FULL type vocabulary to test. They import the crate's types (S1), organize tests into submodules (S2), define test constants and expected values (S3), may define mock statics (S4), alias test result types (S5), define test-specific error types (S6), declare test fixture types (S7), may define mock traits (S8), may use test helper macros (S9), and may use feature gates for conditional test compilation (S10). All 6 bare-bone reserved sections are promoted because comprehensive testing requires comprehensive setup.",

            "how": {
                "working_with_constraints": "Start with imports (the crate being tested), then add test constants, test fixture types, and any test-specific error types. Use modules to organize test categories when the file grows large. Add traits/macros/feature gates as testing patterns demand them.",
                "the_principle": "Demo-test SETUP mirrors the library it tests — if the library uses traits, the test file imports them. If the library uses macros, the test file exercises them."
            },

            "can": {
                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "status": "REQUIRED",
                    "why_required": "Inherited from bare-bone. Test files MUST import the crate they're testing. Without imports, there's nothing to test.",
                    "demo_test_content": "REAL imports — the crate being tested is the primary import. Plus std test utilities.",
                    "content_constraints": {
                        "can_contain": [
                            "use {crate_being_tested}::*; — the primary import, the reason this test file exists",
                            "use std::collections::{HashMap, BTreeMap}; — standard library utilities for test data",
                            "use std::path::PathBuf; — path utilities for filesystem tests",
                            "use {test_utility_crate}::{helpers}; — external test utilities if needed",
                            "// Group comment headers: // --- Crate Under Test ---, // --- Test Utilities ---, etc.",
                            "In demo-test: REAL IMPORTS — the crate being tested, uncommented, plus any test dependencies"
                        ],
                        "cannot_contain": [
                            "use std::*; or any wildcard glob imports — import what you use, even in tests",
                            "Imports for items not used in any test — dead imports fail clippy",
                            "Production dependencies that the test file shouldn't know about",
                            "Imports mixed between groups — maintain crate-under-test → std → external ordering"
                        ],
                        "demo_test_pattern": "Crate-under-test FIRST (this is why the file exists), then std utilities, then external test helpers. Every test category in BODY should have its imports visible here.",
                        "why_these_constraints": "Demo-test imports declare what's being TESTED. The crate-under-test is always first because it's the file's primary purpose. Test utilities are secondary. Keeping imports clean ensures the test file only tests what it claims to test."
                    }
                },

                "S2_Modules": {
                    "position": 2,
                    "tag": "Modules",
                    "status": "REQUIRED",
                    "why_required": "PROMOTED from bare-bone reserved to REQUIRED. Test files with 9 categories NEED module organization. Each test category can be a submodule for clarity.",
                    "demo_test_content": "Test organization modules — mod constructor_tests, mod builder_tests, etc. when categories are large enough.",
                    "content_constraints": {
                        "can_contain": [
                            "mod {category}_tests; — submodule declarations when test categories are large",
                            "pub use super::*; — re-export parent scope into test submodules",
                            "// -- Module Organization -- comment headers",
                            "In demo-test: Optional but AVAILABLE — use when test categories exceed ~10 tests each"
                        ],
                        "cannot_contain": [
                            "Production code modules — test files test, they don't define production modules",
                            "Deeply nested module trees — tests should be flat (1 level deep max)",
                            "Modules that hide test visibility — tests should be easy to find"
                        ],
                        "demo_test_pattern": "Flat module tree. One module per test category when categories are large. All test modules import from the parent scope.",
                        "why_these_constraints": "Module organization in test files serves findability. 9 test categories × N tests = potentially large files. Modules let you cargo test constructor_tests:: specifically."
                    }
                },

                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "status": "REQUIRED",
                    "why_required": "Inherited from bare-bone. Test files need constants for expected values, boundary conditions, and test data.",
                    "demo_test_content": "REAL test constants — expected values, boundary conditions, test fixture data.",
                    "content_constraints": {
                        "can_contain": [
                            "const VALID_{THING}: Type = value; — known-good test data",
                            "const INVALID_{THING}: Type = value; — known-bad test data for error tests",
                            "const BOUNDARY_{THING}: Type = value; — edge case values",
                            "const EXPECTED_{RESULT}: Type = value; — expected outputs for assertions",
                            "// Group comment headers: // --- Valid Data ---, // --- Invalid Data ---, // --- Boundaries ---"
                        ],
                        "cannot_contain": [
                            "Production constants — those live in the crate being tested",
                            "Magic numbers in test functions — extract to named constants here",
                            "Mutable test data — use const for immutable, static LazyLock for mutable shared state (S4)"
                        ],
                        "demo_test_pattern": "Valid data FIRST, invalid data SECOND, boundaries THIRD. Every magic number in a test function should be a named constant here. Tests read as: 'given VALID_X, expect EXPECTED_Y.'",
                        "why_these_constraints": "Test constants centralize test data. When the crate's behavior changes, you update constants here, not across 50 test functions. Named constants also make tests self-documenting: VALID_KEY is clearer than \"test-key\"."
                    }
                },

                "S4_Statics": {
                    "position": 4,
                    "tag": "Statics",
                    "status": "AVAILABLE",
                    "why_available": "PROMOTED from bare-bone reserved. Test files may need shared test fixtures that are expensive to construct (temp dirs, mock servers, large datasets).",
                    "demo_test_content": "Shared test fixtures — LazyLock for expensive setup, OnceLock for one-time initialization.",
                    "content_constraints": {
                        "can_contain": [
                            "static FIXTURE: LazyLock<Type> = LazyLock::new(|| { ... }); — shared test fixtures",
                            "static TEMP_DIR: LazyLock<PathBuf> = LazyLock::new(|| { ... }); — shared temp directory",
                            "// -- Shared Fixtures -- comment headers"
                        ],
                        "cannot_contain": [
                            "Mutable statics — test isolation requires each test to set up its own state",
                            "PRAGMA or METADATA statics — those are identity in METADATA block",
                            "Production singletons — test files should use the library's API, not bypass it"
                        ],
                        "demo_test_pattern": "Only for truly expensive setup (filesystem, network). Prefer per-test setup for isolation. Shared fixtures must be read-only.",
                        "why_these_constraints": "Test isolation is paramount. Shared state between tests creates order-dependent failures. Use statics only for genuinely expensive one-time setup (temp dirs, compiled regexes for test data parsing)."
                    }
                },

                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "status": "AVAILABLE",
                    "why_available": "PROMOTED from bare-bone reserved. Test files may alias common test result types for readability.",
                    "demo_test_content": "type TestResult = Result<(), Box<dyn std::error::Error>>; — common test return type.",
                    "content_constraints": {
                        "can_contain": [
                            "type TestResult = Result<(), Box<dyn std::error::Error>>; — standard test result alias",
                            "type TestResult<T> = Result<T, {CrateError}>; — crate-specific test result",
                            "Convenience aliases that appear 3+ times in test functions"
                        ],
                        "cannot_contain": [
                            "Aliases that shadow the crate's own type aliases — use the crate's vocabulary",
                            "Aliases for types used only once — inline the type"
                        ],
                        "demo_test_pattern": "TestResult alias if many tests return Result. Otherwise, inline.",
                        "why_these_constraints": "Type aliases in test files serve readability. If every test returns Result<(), Box<dyn Error>>, aliasing it as TestResult reduces noise."
                    }
                },

                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "status": "REQUIRED",
                    "why_required": "Inherited from bare-bone. Test files may define test-specific error types for organizing test failures.",
                    "demo_test_content": "Test-specific error enum if needed — or re-use the crate's error types.",
                    "content_constraints": {
                        "can_contain": [
                            "pub enum TestError { ... } — test-specific error type when needed",
                            "impl From<{CrateError}> for TestError — conversion from crate errors",
                            "In demo-test: May be MINIMAL — often the crate's error types suffice"
                        ],
                        "cannot_contain": [
                            "Production error types — those live in the crate being tested",
                            "Complex error hierarchies — tests should be simple",
                            "Error recovery logic — tests should fail clearly, not recover"
                        ],
                        "demo_test_pattern": "Often minimal or empty in demo-test. The crate's error type is the primary vocabulary. TestError exists for test-specific failure scenarios (setup failure, fixture creation failure).",
                        "why_these_constraints": "Test files primarily USE the crate's error types (testing them in ErrorTests category). They rarely need their own error vocabulary. When they do, it's for test infrastructure failures, not domain errors."
                    }
                },

                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "status": "REQUIRED",
                    "why_required": "Inherited from bare-bone. Test files define test fixture types, mock data structures, and test helper structs.",
                    "demo_test_content": "Test fixtures, mock types, builder test helpers.",
                    "content_constraints": {
                        "can_contain": [
                            "struct TestFixture { ... } — shared test setup data",
                            "struct MockConfig { ... } — mock configuration for testing",
                            "enum TestScenario { ... } — enumeration of test scenarios for table-driven tests",
                            "#[derive(Debug, Clone)] — testability derives",
                            "impl TestFixture { fn new() -> Self { ... } } — fixture constructors"
                        ],
                        "cannot_contain": [
                            "Production types — those live in the crate being tested",
                            "Complex business logic — test types are simple data holders",
                            "Types without Debug derive — test types must be debuggable for assertion messages"
                        ],
                        "demo_test_pattern": "TestFixture with setup data. TestScenario enum for table-driven tests. Keep test types SIMPLE — they're scaffolding for the real tests.",
                        "why_these_constraints": "Test types serve the tests, not the domain. TestFixture provides repeatable setup. TestScenario enables table-driven tests. Both should be simple — if your test types are complex, you're testing too much at once."
                    }
                },

                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "status": "AVAILABLE",
                    "why_available": "PROMOTED from bare-bone reserved. Test files may define mock traits for testing polymorphic behavior.",
                    "demo_test_content": "Mock traits when testing trait-based APIs. Usually imported from the crate being tested.",
                    "content_constraints": {
                        "can_contain": [
                            "trait Mock{Trait} { ... } — mock trait for testing",
                            "impl {CrateTrait} for Mock{Type} { ... } — mock implementations"
                        ],
                        "cannot_contain": [
                            "Production trait definitions — those live in the crate being tested",
                            "Complex trait hierarchies — keep test traits simple"
                        ],
                        "demo_test_pattern": "Usually empty. Import traits from the crate being tested. Define mock traits only when you need test-specific behavior not available in the crate.",
                        "why_these_constraints": "Test files exercise existing traits, they don't define production contracts. Mock traits exist for testing — they simulate behavior that's expensive or unavailable in test environments."
                    }
                },

                "S9_Macros": {
                    "position": 9,
                    "tag": "Macros",
                    "status": "AVAILABLE",
                    "why_available": "PROMOTED from bare-bone reserved. Test files may define helper macros for reducing test boilerplate.",
                    "demo_test_content": "Test helper macros — assert_matches!, setup!, parameterized test generators.",
                    "content_constraints": {
                        "can_contain": [
                            "macro_rules! assert_{condition} { ... } — custom assertion macros",
                            "macro_rules! test_case { ... } — parameterized test generation",
                            "macro_rules! setup { ... } — test fixture setup macros"
                        ],
                        "cannot_contain": [
                            "Production macros — those live in the crate being tested",
                            "Macros that hide test logic — tests should be transparent"
                        ],
                        "demo_test_pattern": "Only when the same test pattern appears 3+ times. Custom assert macros improve readability. Parameterized test macros reduce boilerplate for table-driven tests (B8).",
                        "why_these_constraints": "Test macros reduce boilerplate but hide logic. Use them for REPEATED patterns (custom assertions, parameterized tests) not for COMPLEX logic. Every macro expansion should be obvious from reading the macro call."
                    }
                },

                "S10_FeatureGates": {
                    "position": 10,
                    "tag": "FeatureGates",
                    "status": "AVAILABLE",
                    "why_available": "PROMOTED from bare-bone reserved. Test files may use feature gates for conditional test compilation.",
                    "demo_test_content": "Conditional tests — #[cfg(feature = \"expensive-tests\")], platform-specific tests.",
                    "content_constraints": {
                        "can_contain": [
                            "#[cfg(feature = \"expensive-tests\")] — gate slow tests behind a feature",
                            "#[cfg(target_os = \"linux\")] — platform-specific test support types",
                            "#[cfg(test)] — test-only types (usually implicit in test files)"
                        ],
                        "cannot_contain": [
                            "Production feature gates — those live in the crate being tested",
                            "Gates that silently skip important tests — all critical paths should be tested unconditionally"
                        ],
                        "demo_test_pattern": "Gate slow tests (network, filesystem) behind features. Gate platform-specific tests behind #[cfg(target_os)]. Never gate correctness tests.",
                        "why_these_constraints": "Feature gates in test files manage test suite speed and portability. Expensive tests (network, large datasets) should be optional. Core correctness tests should always run."
                    }
                }
            },

            "cannot": {
                "description": "NO reserved sections — demo-test promotes all 6 bare-bone reserved sections. Every SETUP section is accessible.",
                "note": "Demo-test has zero reserved SETUP sections. All 10 positions are either REQUIRED (5) or AVAILABLE (5). This is the same as library — comprehensive testing requires comprehensive type vocabulary."
            },

            "completeness_rule": {
                "formula": "required + available = 10",
                "demo_test": "5 required (S1, S2, S3, S6, S7) + 5 available (S4, S5, S8, S9, S10) = 10",
                "linter_check": "cws-struct validates this — no Reserved Omission needed for SETUP in demo-test"
            }
        },


        // ═══════════════════════════════════════════════════════
        // 3. BODY CONTAINER — 10 required in concern_coverage
        // ═══════════════════════════════════════════════════════
        //
        // Demo-test BODY follows CONCERN COVERAGE ordering:
        //   B1 IdentityAccess (inherited — pragma/metadata API)
        //   B2 ConstructorTests → B3 BuilderTests →
        //   B4 TransitionTests → B5 QueryTests →
        //   B6 IdentityTests → B7 ErrorTests →
        //   B8 EdgeCaseTests → B9 TableDrivenTests →
        //   B10 IntegrationTests
        //
        // 9 test categories PROMOTED from bare-bone reserved.
        // CoreLogic and FreeFunctions: RESERVED (test files
        // don't have "core logic" — the test categories ARE it).
        // Content is REAL test code (not commented-out).

        "BODY": {
            "summary": "10 required subsections + Reserved Omission. Concern coverage ordering — from construction through full lifecycle to integration.",
            "reserved_omission": true,
            "inherits_from": "bare-bone BODY (IdentityAccess — content is REAL not commented-out)",

            "why": "Demo-test BODY follows concern_coverage ordering — the natural progression of how types are TESTED. Identity first (every file has statics to verify). Then construction (types must be creatable). Builders (configuration must work). Transitions (state changes must be valid). Queries (observation must be accurate). Identity integrity (PRAGMA/METADATA must be correct). Errors (failure paths must be graceful). Edge cases (boundaries must hold). Table-driven (systematic coverage). Integration (end-to-end). This ordering mirrors the lifecycle of a TYPE CONSUMER — create, configure, transition, observe, verify, break, push limits, prove systematically, integrate.",

            "how": {
                "working_with_constraints": "Follow concern_coverage ordering strictly. Each test category maps to a library BODY section or cross-cutting concern. ConstructorTests validates Constructors, BuilderTests validates Builders, QueryTests validates Queries, etc. IntegrationTests validates the WHOLE lifecycle end-to-end.",
                "content_is_real": "Unlike bare-bone where all content is commented-out skeleton, demo-test content is REAL, UNCOMMENTED test code. #[test] functions with actual assertions proving the crate under test works correctly.",
                "ordering_rationale": "concern_coverage ordering serves test comprehension: a developer reading the test file sees tests in the order a type is USED — create it, build it, transition it, query it, verify identity, handle errors, test edges, systematic coverage, integrate. This is NOT arbitrary — it mirrors the consumer lifecycle."
            },

            "can": {
                "B1_IdentityAccess": {
                    "position": 1,
                    "tag": "IdentityAccess",
                    "status": "REQUIRED (inherited from bare-bone)",
                    "inherits_constraints": "bare-bone B_IdentityAccess content_constraints (same rules apply)",
                    "demo_test_difference": "Accessor functions are REAL, UNCOMMENTED code. Doc comment examples reference the CRATE UNDER TEST's identity keys — not this test file's own identity.",
                    "content_constraints": {
                        "can_contain": [
                            "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA } — full slice accessor (REAL code)",
                            "pub fn pragma_get(key: &str) -> Option<&'static str> — key lookup via iter().find() (REAL code)",
                            "pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA } — full slice accessor (REAL code)",
                            "pub fn metadata_get(key: &str) -> Option<&'static str> — key lookup via iter().find() (REAL code)",
                            "/// doc comments noting these access THIS FILE's identity, not the crate under test"
                        ],
                        "cannot_contain": [
                            "Functions that modify identity — PRAGMA/METADATA are immutable statics",
                            "Functions that compute derived values from identity — keep accessors pure (read-only)",
                            "Re-exports of the crate-under-test's identity functions — test file has its OWN identity",
                            "Any function not related to PRAGMA/METADATA access — other functions go in test modules"
                        ],
                        "demo_test_pattern": "IDENTICAL implementation to all forms but UNCOMMENTED. Demo-test files have their OWN identity (PRAGMA/METADATA about the test file itself). The crate-under-test's identity is accessed through the crate's API in B6 IdentityTests.",
                        "why_these_constraints": "Same as bare-bone — IdentityAccess is the bridge between compile-time identity and runtime code. Demo-test difference: the identity is about THIS test file, not the crate being tested."
                    }
                },

                "B2_ConstructorTests": {
                    "position": 2,
                    "tag": "ConstructorTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_new_creates_valid_instance() { ... }",
                    "purpose": "Verify that type construction creates correct initial state",
                    "why_required": "The first thing a consumer does with a type is CREATE it. If construction is wrong, nothing else matters. ConstructorTests verifies new(), try_new(), and all construction paths produce types in the expected initial state.",
                    "demo_test_content": "Tests for every constructor: new() returns correct defaults, try_new() validates input, from_X() conversions work, Default::default() matches expected state.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_new_creates_valid_instance() — verify default construction",
                            "#[test] fn test_try_new_with_valid_input() — verify validated construction succeeds",
                            "#[test] fn test_try_new_with_invalid_input() — verify validated construction fails correctly",
                            "#[test] fn test_from_conversion() — verify From/TryFrom implementations",
                            "#[test] fn test_default() — verify Default::default() matches expected state",
                            "assert_eq!(instance.field(), expected_value) — verify initial field values",
                            "assert!(matches!(result, Err(Error::InvalidInput(_)))) — verify error variants"
                        ],
                        "cannot_contain": [
                            "Tests for methods called AFTER construction — those belong in later categories (Query, Transition, etc.)",
                            "Builder tests — those belong in B3 BuilderTests",
                            "Tests that modify the constructed instance — construction tests verify INITIAL state only",
                            "Performance benchmarks — those belong outside the test file"
                        ],
                        "demo_test_pattern": "One test per constructor variant. new() test checks all field defaults. try_new() tests check both valid and invalid paths. From conversions test round-trip accuracy. Group by constructor type, not by field being verified.",
                        "why_these_constraints": "Construction is the FIRST lifecycle event. If new() is wrong, all other tests are testing a broken foundation. Separating constructor tests from method tests means you can verify the foundation independently. When constructor tests fail, you know the problem is in creation, not in usage."
                    }
                },

                "B3_BuilderTests": {
                    "position": 3,
                    "tag": "BuilderTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_builder_sets_field() { ... }",
                    "purpose": "Verify that builder configuration methods work correctly",
                    "why_required": "Builders are the configuration API — they let consumers customize instances before finalizing. BuilderTests verifies each builder method independently and that build() produces the expected result.",
                    "demo_test_content": "Tests for every builder method: each .field() sets the correct value, method chaining works, build() produces expected instance, build() with missing required fields fails.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_builder_default() — verify builder starts with correct defaults",
                            "#[test] fn test_builder_sets_field() — verify each builder method (one test per method)",
                            "#[test] fn test_builder_method_chaining() — verify fluent API works",
                            "#[test] fn test_build_succeeds_with_required_fields() — verify happy path",
                            "#[test] fn test_build_fails_without_required_fields() — verify validation",
                            "#[test] fn test_builder_overwrite() — verify last-write-wins for duplicate calls",
                            "assert_eq!(builder.field(value).build()?.field(), value) — chain + verify"
                        ],
                        "cannot_contain": [
                            "Direct constructor tests (new(), try_new()) — those belong in B2 ConstructorTests",
                            "Tests for methods on the BUILT instance — those belong in later categories",
                            "Builder performance benchmarks",
                            "Tests for builder IMPLEMENTATION details — test the API, not the internals"
                        ],
                        "demo_test_pattern": "One test per builder method. Then combination tests (chaining, overwrite). Then build() success and failure. Builder tests are ordered: defaults → individual methods → combinations → finalization. This mirrors the builder usage flow.",
                        "why_these_constraints": "Builders are the CONFIGURATION API. Each method should be tested independently (does .name(\"x\") set the name?) and in combination (does chaining work?). build() validation must be tested: missing required fields MUST fail. Builder tests give confidence in the configuration layer."
                    }
                },

                "B4_TransitionTests": {
                    "position": 4,
                    "tag": "TransitionTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_transition_from_a_to_b() { ... }",
                    "purpose": "Verify that state transitions and mutations work correctly",
                    "why_required": "After construction (B2) and configuration (B3), types CHANGE state. TransitionTests verifies that mutations produce correct new states, invalid transitions are rejected, and state invariants are maintained.",
                    "demo_test_content": "Tests for every &mut self method: state changes produce expected results, invalid transitions return errors, invariants hold after mutation.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_transition_valid() — verify state A → state B produces expected result",
                            "#[test] fn test_transition_invalid() — verify invalid transitions return errors",
                            "#[test] fn test_invariant_maintained() — verify type invariants hold after mutation",
                            "#[test] fn test_transition_sequence() — verify multi-step transition chains",
                            "#[test] fn test_transition_idempotent() — verify applying same transition twice is safe",
                            "assert_eq!(instance.state(), expected_after) — verify post-transition state"
                        ],
                        "cannot_contain": [
                            "Constructor tests — B2",
                            "Read-only query tests — B5 QueryTests",
                            "Tests that don't actually mutate state",
                            "Tests for Display/formatting of transitioned state — those go in B7 ErrorTests or B10 IntegrationTests"
                        ],
                        "demo_test_pattern": "Test each transition independently: initial state → apply transition → verify new state. Then test transition chains (A→B→C). Then test invalid transitions (A→C when B is required). Then test idempotency where applicable.",
                        "why_these_constraints": "Transitions are state MUTATIONS — the most dangerous operations because they change what exists. Each transition must be tested in isolation (does it work?) and in combination (do chains work?). Invalid transitions must be tested because the ERROR path is as important as the happy path."
                    }
                },

                "B5_QueryTests": {
                    "position": 5,
                    "tag": "QueryTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_query_returns_expected() { ... }",
                    "purpose": "Verify that read-only accessors return correct values",
                    "why_required": "After construction and transition, OBSERVATION must be accurate. QueryTests verifies that &self methods return correct values for all states — initial, post-transition, edge cases.",
                    "demo_test_content": "Tests for every &self method: queries on fresh instances, queries after transitions, queries on boundary states.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_query_on_default() — verify query returns correct value on fresh instance",
                            "#[test] fn test_query_after_transition() — verify query reflects state change",
                            "#[test] fn test_query_derived_value() — verify computed/derived accessors",
                            "#[test] fn test_query_collection() — verify iteration, length, contains on collection types",
                            "#[test] fn test_query_empty_state() — verify queries handle empty/minimal state",
                            "assert_eq!(instance.field(), expected) — direct comparison"
                        ],
                        "cannot_contain": [
                            "Tests that mutate state — queries are READ-ONLY (&self), mutations are B4 TransitionTests",
                            "Constructor verification — B2",
                            "Error path testing — B7 ErrorTests",
                            "Tests for Display/Debug output — Display testing goes in B7 ErrorTests"
                        ],
                        "demo_test_pattern": "Group queries by the state they observe: default state queries FIRST, post-transition queries SECOND, derived value queries THIRD. This mirrors how a consumer would use queries — check initial state, change something, check again.",
                        "why_these_constraints": "Queries are OBSERVATION — they must be accurate across all states. Testing queries independently from transitions means you can verify: (1) correct initial state, (2) correct post-mutation state, (3) derived computations work. If a query test fails, you know the problem is observation, not mutation."
                    }
                },

                "B6_IdentityTests": {
                    "position": 6,
                    "tag": "IdentityTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_pragma_key_correct() { ... }",
                    "purpose": "Verify PRAGMA/METADATA integrity of the crate under test",
                    "why_required": "Every OmniCode file has identity (PRAGMA/METADATA). IdentityTests verifies that the crate-under-test's identity statics are correct — keys match, values are valid, required fields exist. This is the accountability for the identity system.",
                    "demo_test_content": "Tests for crate-under-test's pragma_get() and metadata_get(): key exists, format correct, version parseable, scripture present.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_pragma_key_correct() — verify P1.key matches expected",
                            "#[test] fn test_pragma_format_correct() — verify P2.format matches expected",
                            "#[test] fn test_pragma_version_parseable() — verify version string is valid semver/living-version",
                            "#[test] fn test_metadata_scripture_present() — verify C3 scripture exists and is non-empty",
                            "#[test] fn test_pragma_get_missing_returns_none() — verify missing keys return None",
                            "#[test] fn test_metadata_required_fields() — verify all required metadata fields exist",
                            "use {crate_under_test}::{pragma_get, metadata_get} — import the crate's identity API"
                        ],
                        "cannot_contain": [
                            "Tests for THIS file's identity (B1 IdentityAccess handles this file's own statics)",
                            "Tests that modify identity — PRAGMA/METADATA are immutable",
                            "Tests for identity of OTHER crates — each test file tests ONE crate",
                            "Hardcoded identity values that will break on version updates — use patterns (non-empty, parseable)"
                        ],
                        "demo_test_pattern": "Test each required PRAGMA field: key format, version parse, type correct. Test each required METADATA field: scripture non-empty, title present. Test None return for missing keys. IMPORTANT: test PATTERNS not VALUES — test that version parses, not that version equals '1.0.0'.",
                        "why_these_constraints": "Identity is the foundation — if PRAGMA/METADATA is wrong, the file is misidentified. IdentityTests proves the crate-under-test's identity system works. Testing PATTERNS (non-empty, parseable) instead of VALUES (exact strings) makes tests resilient to version updates."
                    }
                },

                "B7_ErrorTests": {
                    "position": 7,
                    "tag": "ErrorTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_error_display() { ... }",
                    "purpose": "Verify error types, Display implementations, and error conditions",
                    "why_required": "Error handling is half the API. ErrorTests verifies that error types have correct Display output, error conditions trigger correctly, and error conversions work. If errors are wrong, debugging is impossible.",
                    "demo_test_content": "Tests for every error variant: Display output is human-readable, From conversions work, error conditions match expected triggers.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_error_display_variant() — verify each error variant's Display output",
                            "#[test] fn test_error_from_conversion() — verify From<Source> for Error works",
                            "#[test] fn test_error_is_send_sync() — verify error types implement Send + Sync",
                            "#[test] fn test_error_source_chain() — verify error source() chain for wrapped errors",
                            "#[test] fn test_error_condition_triggers() — verify specific operations produce specific errors",
                            "assert!(err.to_string().contains(\"expected substring\")) — verify error messages"
                        ],
                        "cannot_contain": [
                            "Tests for error RECOVERY (how to handle errors) — that's application logic, not error verification",
                            "Tests where errors are incidental (testing a function that happens to fail) — those belong in their functional category",
                            "Tests for panics — use #[should_panic] in the appropriate category, not here"
                        ],
                        "demo_test_pattern": "One test per error variant's Display. One test per From conversion. Then error condition tests: which operations produce which errors. Group by error TYPE, not by the operation that causes it.",
                        "why_these_constraints": "Errors are the API's COMMUNICATION with humans and callers. Display must be readable. From conversions must work. Error conditions must be predictable. Testing errors independently means you can verify the error SYSTEM without testing every function that might fail."
                    }
                },

                "B8_EdgeCaseTests": {
                    "position": 8,
                    "tag": "EdgeCaseTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_empty_input() { ... }",
                    "purpose": "Boundary conditions — empty, maximum, zero, overflow, Unicode, concurrent access",
                    "why_required": "Edge cases are where bugs live. EdgeCaseTests exercises the boundaries: empty inputs, maximum values, zero-length collections, Unicode edge cases, overflow conditions. These tests catch the bugs that normal usage doesn't reveal.",
                    "demo_test_content": "Tests for boundary conditions: empty strings, zero values, max values, Unicode (emoji, RTL, surrogate pairs), overflow, underflow.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_empty_input() — verify behavior with empty string/collection/option",
                            "#[test] fn test_max_value() — verify behavior at maximum bounds",
                            "#[test] fn test_zero_value() — verify behavior with zero/default",
                            "#[test] fn test_unicode_handling() — verify emoji, RTL, multi-byte characters work",
                            "#[test] fn test_overflow() — verify arithmetic overflow handling",
                            "#[test] fn test_concurrent_access() — verify thread safety if applicable",
                            "#[test] fn test_null_equivalent() — verify Option::None, empty vec, etc."
                        ],
                        "cannot_contain": [
                            "Normal happy-path tests — those belong in earlier categories (B2-B5)",
                            "Error type verification — that's B7 ErrorTests",
                            "Performance testing — edge cases test CORRECTNESS, not speed",
                            "Fuzz testing — edge cases are known boundaries, not random inputs"
                        ],
                        "demo_test_pattern": "Group by boundary type: empty inputs → zero values → max values → Unicode → overflow → concurrency. Each test should document WHY this edge case matters — what bug would it catch?",
                        "why_these_constraints": "Edge cases are the BOUNDARIES of the system — where behavior changes. Testing them independently means you can verify the boundary handling without cluttering functional tests. When an edge case test fails, you know exactly which boundary is broken."
                    }
                },

                "B9_TableDrivenTests": {
                    "position": 9,
                    "tag": "TableDrivenTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_conversion_table() { for (input, expected) in cases { ... } }",
                    "purpose": "Systematic input/output validation with test tables",
                    "why_required": "Table-driven tests provide systematic, comprehensive coverage that individual tests can't match. They test MANY inputs against expected outputs in a single test function, making it easy to add cases and spot patterns.",
                    "demo_test_content": "Test tables for: conversion functions (input → expected output), validation functions (input → expected error), display formatting (value → expected string).",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_conversion_table() { let cases = [(...), ...]; for (input, expected) in cases { ... } }",
                            "#[test] fn test_validation_table() — systematic valid/invalid input testing",
                            "#[test] fn test_display_table() — systematic formatting verification",
                            "#[test] fn test_roundtrip_table() — systematic encode/decode or to/from verification",
                            "const CASES: &[(Input, Expected)] = &[...]; — named case arrays for reuse",
                            "Each test case has a descriptive name or comment explaining what it tests"
                        ],
                        "cannot_contain": [
                            "Tables with only 1-2 cases — use individual tests for those (earlier categories)",
                            "Tables without descriptive case names — every case must say what it tests",
                            "Tables that duplicate earlier category tests — table tests add SYSTEMATIC coverage, not redundancy",
                            "Complex logic inside the test loop — keep the loop simple (assert), put setup in the table"
                        ],
                        "demo_test_pattern": "One table per function or behavior being tested. Cases ordered: normal → boundary → error. Each case array has at least 5 entries. Named constants (VALID_CASES, INVALID_CASES) for clarity. The loop body is ONE assertion — complexity lives in the test data, not the test logic.",
                        "why_these_constraints": "Table-driven tests are SYSTEMATIC — they test many cases with one test function. This makes it trivial to add new cases (add a row to the table) and easy to see patterns (all cases visible together). The constraint of 5+ entries ensures tables are worth the abstraction. Single-assertion loops keep the test logic simple."
                    }
                },

                "B10_IntegrationTests": {
                    "position": 10,
                    "tag": "IntegrationTests",
                    "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                    "rust_syntax": "#[test] fn test_full_lifecycle() { ... }",
                    "purpose": "End-to-end workflows proving the full type lifecycle works",
                    "why_required": "Individual category tests (B2-B9) verify parts. IntegrationTests verifies the WHOLE — create, configure, transition, query, display — in realistic workflows. These are the tests that prove 'it all works together.'",
                    "demo_test_content": "Full lifecycle tests: construct → build → transition → query → display. Realistic usage scenarios that a consumer would actually write.",
                    "content_constraints": {
                        "can_contain": [
                            "#[test] fn test_full_lifecycle() — create → configure → transition → query → verify",
                            "#[test] fn test_realistic_usage() — a consumer's actual usage pattern",
                            "#[test] fn test_multi_instance_interaction() — two or more instances interacting",
                            "#[test] fn test_persistence_roundtrip() — serialize → deserialize → verify equivalence",
                            "#[test] fn test_error_recovery_workflow() — trigger error → handle → continue",
                            "Multi-step assertions verifying state at each stage of the workflow"
                        ],
                        "cannot_contain": [
                            "Tests that only test ONE concern — those belong in earlier categories",
                            "Tests that duplicate functional tests — integration tests combine, not repeat",
                            "External service calls (database, network) — those are system tests, not integration tests",
                            "Tests longer than ~50 lines — decompose into helper functions if too long"
                        ],
                        "demo_test_pattern": "Scenario-based: each test represents a REAL usage scenario. 'Create a trit, transition it, verify the output.' 'Build a configuration, apply it, query the results.' Tests are ordered from simplest workflow to most complex. The LAST test is the most comprehensive lifecycle test.",
                        "why_these_constraints": "Integration tests are the CAPSTONE — they prove the whole system works together. They catch bugs that unit tests miss (interaction effects, ordering dependencies, state leakage). Placing them LAST in concern_coverage means all individual concerns are already tested — integration tests verify the COMBINATION."
                    }
                },

                "Reserved_Omission": {
                    "position": "LAST in BODY (after all active subsections)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists all BODY sections NOT active in demo-test. Completeness: 10 active + 7 reserved = 17.",
                    "why_required": "Demo-test activates 10 BODY sections. The remaining 7 belong to other forms or are absorbed. Nothing is silently absent — the reserved list is the contract of what's NOT here.",

                    "reserved_sections": {
                        "from_bare_bone_active": {
                            "CoreLogic": "RESERVED — demo-test files don't have 'core logic' in the traditional sense. The test CATEGORIES (B2-B10) ARE the logic. CoreLogic's role ('the actual work this file does') is fulfilled by the 9 test categories. A test file's 'work' IS testing. [library, executable]",
                            "FreeFunctions": "RESERVED — demo-test files don't expose module-level API. Test files are consumed by cargo test, not imported by other crates. Helper functions live inside #[cfg(test)] modules, not as free functions. [library]"
                        },
                        "library_sections": [
