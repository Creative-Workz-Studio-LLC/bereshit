            "cannot": {
                "description": "These sections CANNOT be active in demo-test. They belong to library, executable, or are absorbed by test categories.",

                "CoreLogic": {
                    "tag": "CoreLogic",
                    "status": "RESERVED",
                    "note": "CoreLogic is ACTIVE in bare-bone but RESERVED in demo-test.",
                    "why_reserved": "Demo-test files don't have 'core logic' — they have test CATEGORIES. In a library, CoreLogic holds impl blocks with business methods. In an executable, CoreOperations holds run(). In a demo-test, the 9 test categories (B2-B10) collectively ARE the logic. The 'actual work' of a test file is testing. CoreLogic's abstract purpose ('the file's actual work') is fulfilled by the test categories.",
                    "belongs_to": ["library", "executable"],
                    "the_signal": "If you need CoreLogic in a test file, you're probably implementing production code in the wrong place."
                },

                "FreeFunctions": {
                    "tag": "FreeFunctions",
                    "status": "RESERVED",
                    "note": "FreeFunctions is ACTIVE in bare-bone but RESERVED in demo-test.",
                    "why_reserved": "Demo-test files don't expose module-level API. Test files are consumed by cargo test (the harness), not imported by other crates. Helper functions for tests live inside #[cfg(test)] modules or as closures within test functions — not as pub fn at module level. register_identity() is not needed for test files.",
                    "belongs_to": ["library"],
                    "the_signal": "If you need free functions in a test file, they're probably test helpers that should be in a test_utils module or inside the #[cfg(test)] block."
                },

                "form_library_sections": {
                    "sections": ["TraitImplementations", "Constructors", "Queries", "Output"],
                    "why_reserved": "Library BODY sections define type APIs. Demo-test BODY sections TEST type APIs. A test file that implements traits, constructors, queries, or display is building production code in the wrong place.",
                    "belongs_to": "library form",
                    "the_signal": "If you're implementing type methods in a test file, they belong in the library crate."
                },

                "form_executable_sections": {
                    "sections": ["Helpers"],
                    "why_reserved": "Executable Helpers serve run(). Demo-test files don't have run(). Cargo test is the execution harness.",
                    "belongs_to": "executable form"
                }
            },

            "concern_coverage_ordering": {
                "principle": "Demo-test BODY reads like a type's usage lifecycle: create it, configure it, change it, observe it, verify identity, break it, push it, prove it systematically, integrate it.",
                "B1": "IdentityAccess — WHO is this file? (pragma/metadata API)",
                "B2": "ConstructorTests — Can I CREATE it?",
                "B3": "BuilderTests — Can I CONFIGURE it?",
                "B4": "TransitionTests — Can I CHANGE it?",
                "B5": "QueryTests — Can I OBSERVE it?",
                "B6": "IdentityTests — Is its IDENTITY correct?",
                "B7": "ErrorTests — Does it FAIL gracefully?",
                "B8": "EdgeCaseTests — Does it handle BOUNDARIES?",
                "B9": "TableDrivenTests — Can I PROVE it systematically?",
                "B10": "IntegrationTests — Does it all WORK TOGETHER?",
                "contrast_with_library": "Library uses type_lifecycle (how types evolve). Demo-test uses concern_coverage (how types are VERIFIED). Different ordering because different purpose.",
                "contrast_with_executable": "Executable uses execution_flow (how the program runs). Demo-test uses concern_coverage (how the program is PROVEN). Different ordering because different purpose."
            }
        },

        // ═══════════════════════════════════════════════════════
        // 4. CLOSING CONTAINER — 6 required + 3 available
        // ═══════════════════════════════════════════════════════
        //
        // Demo-test CLOSING proves the tests work and tracks
        // coverage.
        //
        // THE KEY DISTINCTION: TestCoverageSummary is PROMOTED.
        //   This is a test file — coverage metrics belong here.
        //   Ce remains EMPTY — cargo test is the harness.
        //
        // 6 REQUIRED: Cv, Ce (EMPTY), TestCoverageSummary, X1, X4, X5
        // 3 AVAILABLE: Cc (cleanup), X2 (extension), X3 (troubleshooting)
        // 0 RESERVED
        // X6 NOT PRESENT (demo-test is derived, not template)

        "CLOSING": {
            "summary": "6 required + 3 available. Tests, EMPTY entry point, coverage summary, documentation. X6 absent (derived file).",
            "reserved_omission": true,

            "why": "Demo-test CLOSING proves the test file works (Cv — meta-tests verifying test infrastructure), acknowledges no entry point (Ce EMPTY — cargo test is the harness), tracks coverage (TestCoverageSummary — THE key promotion), and guides maintainers (X1-X5). TestCoverageSummary is PROMOTED from bare-bone reserved because this IS a test file — coverage data belongs HERE. Cc/X2/X3 are available because test files may need cleanup (temp dirs, test databases), extension documentation (planned test expansions), and troubleshooting guides (flaky tests, environment issues).",

            "how": {
                "working_with_constraints": "Write meta-validation tests in Cv. Leave Ce empty (cargo test is the harness). Fill TestCoverageSummary with coverage metrics. Write modification policy in X1, references in X4, closing anchor in X5. Promote Cc/X2/X3 when needed.",
                "demo_test_ordering": "Cv → Ce (empty) → TestCoverageSummary → [Cc] → Reserved Omission → X1 → [X2] → [X3] → X4 → X5",
                "TestCoverageSummary_is_the_key": "TestCoverageSummary in demo-test tracks: total test count per category, assertion count, which APIs are tested vs untested, coverage percentage. This is the TEST FILE's accountability — it proves the tests are comprehensive."
            },

            "can": {
                "code_zones": {
                    "description": "Actual executable Rust code. Always precede documentation sections.",

                    "Cv_Validation": {
                        "position": 1,
                        "tag": "Cv",
                        "status": "REQUIRED",
                        "rust_syntax": "#[cfg(test)] mod meta_tests { ... }",
                        "purpose": "Meta-validation — tests that verify test infrastructure itself",
                        "why_required": "Inherited from bare-bone. Demo-test Cv is SPECIAL: it tests the TEST INFRASTRUCTURE, not the crate under test. Meta-tests verify: test fixtures work, test helpers produce correct results, test module organization is intact.",
                        "demo_test_content": "Meta-tests: fixture construction works, helper functions return expected values, test constants are consistent, this file's own identity statics are correct.",
                        "content_constraints": {
                            "can_contain": [
                                "#[cfg(test)] mod meta_tests { ... } — meta-validation module (separate from B2-B10 test categories)",
                                "#[test] fn test_fixture_construction() — verify TestFixture creates valid state",
                                "#[test] fn test_helper_correctness() — verify test helper functions work",
                                "#[test] fn test_constants_consistent() — verify test constants are internally consistent",
                                "#[test] fn test_own_identity() — verify THIS file's pragma/metadata statics",
                                "assert!() on test infrastructure, NOT on the crate under test"
                            ],
                            "cannot_contain": [
                                "Tests for the crate under test — those belong in B2-B10 BODY categories",
                                "More than one #[cfg(test)] module — Cv has one meta_tests module",
                                "Duplicate tests from BODY categories — Cv tests TEST INFRASTRUCTURE, not the crate",
                                "Complex test logic — meta-tests should be simple, verifying the tools work"
                            ],
                            "demo_test_pattern": "Cv in demo-test files tests the test infrastructure: fixtures, helpers, constants, own identity. If B2-B10 test the crate-under-test, Cv tests the testing tools themselves. Small, focused, and fast — typically 3-5 meta-tests.",
                            "why_these_constraints": "Cv is meta-accountability — tests testing the tests. If a test fixture is broken, all tests using it are unreliable. Cv catches this. Separating meta-tests (Cv) from functional tests (B2-B10) means you can verify the foundation before trusting the results."
                        }
                    },

                    "Ce_Execution": {
                        "position": 2,
                        "tag": "Ce",
                        "status": "REQUIRED (EMPTY)",
                        "purpose": "Entry point slot — EMPTY because cargo test is the harness",
                        "why_required": "Structural slot exists in every form. Demo-test Ce is ALWAYS empty — cargo test provides the execution harness. There is no main(), no exit_code(), no entry point. The section header exists; the content is a comment explaining WHY it's empty.",
                        "demo_test_content": "Empty section with comment: 'Ce is empty — cargo test is the execution harness for demo-test files.'",
                        "content_constraints": {
                            "can_contain": [
                                "// Ce — Execution Entry Point section header",
                                "// Comment explaining Ce is empty for demo-test files",
                                "// Cargo test is the harness — no manual entry point"
                            ],
                            "cannot_contain": [
                                "fn main() — demo-test files are NOT executables",
                                "fn exit_code() — no exit code mapping for test files",
                                "Any executable code — Ce is empty for demo-test, period",
                                "Test functions — tests are in BODY (B2-B10) or Cv"
                            ],
                            "demo_test_pattern": "Section header comment + one-line explanation of why Ce is empty. Nothing else. Three lines total.",
                            "why_these_constraints": "Demo-test files are run by cargo test, not by calling main(). The harness handles test discovery, execution, filtering, and reporting. There is literally nothing for Ce to contain. The empty section is honest: 'I have no entry point because my harness IS the entry point.'"
                        }
                    },

                    "TestCoverageSummary": {
                        "position": 3,
                        "tag": "TestCoverageSummary",
                        "status": "REQUIRED (PROMOTED from bare-bone reserved)",
                        "purpose": "Coverage data — assertion counts, tested APIs, coverage percentage",
                        "why_required": "THIS IS THE KEY PROMOTION FOR DEMO-TEST. TestCoverageSummary tracks comprehensive coverage metrics: how many tests per category, total assertion count, which APIs are tested vs untested, overall coverage confidence. It is the test file's self-accountability.",
                        "demo_test_content": "Comment-based coverage summary: test count per B-section, total assertions, tested vs untested API surface, coverage percentage, any known gaps.",
                        "content_constraints": {
                            "can_contain": [
                                "// Test Coverage Summary comment block",
                                "// Total tests: N (B2: x, B3: y, B4: z, ...)",
                                "// Total assertions: N",
                                "// API coverage: N/M functions tested (X%)",
                                "// Tested: list of tested API functions",
                                "// Untested: list of untested API functions with reason",
                                "// Known gaps: areas where coverage is intentionally incomplete + justification"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — TestCoverageSummary is documentation comments only",
                                "Inflated coverage claims — if it's not tested, say so",
                                "Coverage percentages without justification for gaps — explain WHY something isn't tested",
                                "Outdated counts — must be updated when tests are added or removed"
                            ],
                            "demo_test_pattern": "Structured comment block: total test count (broken down by B-section), total assertion count, API surface coverage (functions tested / total functions), known gaps with justification. Updated every time tests change.",
                            "why_these_constraints": "TestCoverageSummary is ACCOUNTABILITY for the test file itself. It answers: 'How thoroughly does this test file test the crate?' The structured format (per-section counts, API coverage, known gaps) makes coverage visible and maintainable. Honesty about gaps is more valuable than inflated numbers."
                        }
                    },

                    "Cc_Cleanup": {
                        "position": 4,
                        "tag": "Cc",
                        "status": "AVAILABLE",
                        "rust_syntax": "impl Drop for TestFixture { fn drop(&mut self) { ... } }",
                        "purpose": "Test cleanup — temp directories, test databases, shared fixtures",
                        "why_available": "PROMOTED from bare-bone reserved. Test files may need explicit cleanup: removing temp directories created by integration tests, closing database connections, cleaning up shared mutable state. Not all test files need cleanup, so it's available rather than required.",
                        "demo_test_content": "Drop impls for TestFixture, temp dir cleanup, database rollback.",
                        "content_constraints": {
                            "can_contain": [
                                "impl Drop for TestFixture { fn drop(&mut self) { ... } } — cleanup test fixtures",
                                "fn cleanup_temp_dir(path: &Path) — remove test artifacts",
                                "fn rollback_test_db(conn: &Connection) — undo test database changes",
                                "/// doc comments explaining what resources need cleanup and why"
                            ],
                            "cannot_contain": [
                                "Production cleanup code — that belongs in the library/executable crate",
                                "Test functions — tests are BODY or Cv, not Cc",
                                "Cleanup for resources from other test files — each file manages its own cleanup"
                            ],
                            "demo_test_pattern": "Drop impl for TestFixture (if using fixtures from S7). Temp dir cleanup function. Keep it simple — most Rust test cleanup is handled by RAII. Cc is for the exceptions.",
                            "why_these_constraints": "Test cleanup ensures tests don't leak resources or leave artifacts. Most cleanup is automatic (RAII), but integration tests with temp files, databases, or network resources may need explicit cleanup. Cc provides the structural location for this."
                        }
                    }
                },

                "documentation_sections": {
                    "description": "Guidance for humans. Always follow code zones.",

                    "X1_Policy": {
                        "tag": "X1",
                        "status": "REQUIRED",
                        "purpose": "Modification guidelines — never/careful/safe classification for the test file",
                        "why_required": "EVERY file needs modification guidelines. For demo-test: what test patterns must not change, what requires coordination, what can be freely added.",
                        "content_constraints": {
                            "can_contain": [
                                "// Safe to Modify: — adding new tests, expanding edge cases, adding table-driven cases",
                                "// Modify with Care: — test fixtures, test constants, import structure",
                                "// Never Modify: — concern_coverage ordering, test module structure, identity statics",
                                "// Opening scripture quote",
                                "Bullet lists under each category with test-file-specific guidance"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X1 is documentation comments only",
                                "Guidance about the crate-under-test — X1 is about THIS test file",
                                "Vague guidance — each item names the specific thing and consequence"
                            ],
                            "demo_test_pattern": "Safe: add new tests to any category, add table-driven cases, add edge cases. Careful: test fixtures (all tests depend on them), test constants (data consistency), assertion patterns (false positives/negatives). Never: B-section ordering (concern_coverage is architecture), #[cfg(test)] structure, identity statics.",
                            "why_these_constraints": "Test file modification policy focuses on what BREAKS TESTS vs what EXTENDS TESTS. Adding tests is always safe. Changing fixtures or constants can break many tests at once. Changing the structure breaks the concern_coverage architecture."
                        }
                    },

                    "X2_Extension": {
                        "tag": "X2",
                        "status": "AVAILABLE",
                        "purpose": "Planned test additions — growth points for the test file",
                        "why_available": "PROMOTED from bare-bone reserved. Test files often have planned coverage expansions: new API functions to test, planned property-based tests, fuzzing targets. X2 documents where the test file SHOULD grow.",
                        "content_constraints": {
                            "can_contain": [
                                "// Planned tests: — list of API functions not yet tested",
                                "// Property-based testing: — planned proptest/quickcheck additions",
                                "// Fuzz targets: — planned fuzz testing for parsing/deserialization",
                                "// Performance tests: — planned benchmark additions"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X2 is documentation comments only",
                                "Duplicate of TestCoverageSummary — X2 is PLANNED growth, not CURRENT coverage"
                            ],
                            "demo_test_pattern": "Categorized growth plan: functions to test, test types to add (property, fuzz, benchmark), categories to expand. Each item includes WHY it should be added.",
                            "why_these_constraints": "X2 documents INTENTIONAL growth — where the test file should expand next. This is different from TestCoverageSummary which documents current state. X2 is the roadmap; TestCoverageSummary is the map."
                        }
                    },

                    "X3_Troubleshooting": {
                        "tag": "X3",
                        "status": "AVAILABLE",
                        "purpose": "Common test problems and solutions",
                        "why_available": "PROMOTED from bare-bone reserved. Test files encounter recurring issues: flaky tests, environment dependencies, timing issues, test isolation problems. X3 documents solutions.",
                        "content_constraints": {
                            "can_contain": [
                                "// Flaky tests: — tests that intermittently fail + fix strategy",
                                "// Environment deps: — tests requiring specific setup (databases, files)",
                                "// Timing issues: — tests sensitive to execution order or speed",
                                "// Isolation: — tests that share state + how to keep them independent"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X3 is documentation comments only",
                                "Problems with the crate-under-test — X3 is about test problems, not crate bugs"
                            ],
                            "demo_test_pattern": "Problem-solution pairs organized by category: flaky → environment → timing → isolation. Each entry names the problem, explains the root cause, and provides the fix.",
                            "why_these_constraints": "Test troubleshooting is recurring — the same problems appear across test files. X3 captures solutions so they don't need to be rediscovered. This is maintenance knowledge about the test file itself."
                        }
                    },

                    "X4_Reference": {
                        "tag": "X4",
                        "status": "REQUIRED",
                        "purpose": "Related files, dependencies, validation commands for the test file",
                        "why_required": "Navigation map — where to find the crate being tested, the schema, the sibling test files.",
                        "content_constraints": {
                            "can_contain": [
                                "// Crate Under Test: — path to the library crate this file tests",
                                "// Dependencies: — test framework dependencies (if any beyond std)",
                                "// Template: — source template path (demo-test.rs)",
                                "// Schema: — this schema file path",
                                "// Validation: — cargo test commands for this test file",
                                "Comment-only reference data — no executable code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X4 is documentation comments only",
                                "Outdated dependency information",
                                "Validation commands for other crates"
                            ],
                            "demo_test_pattern": "Crate Under Test path FIRST (the most important reference). Then dependencies, template, schema. Validation section with: cargo test (full suite), cargo test --test specific_test (single test), cargo test -- --nocapture (with output).",
                            "why_these_constraints": "X4 for test files emphasizes the CRATE UNDER TEST — the most important reference. A developer opening a test file needs to quickly find what it's testing. Validation commands include test-specific flags (--nocapture, --test) that are unique to test file workflows."
                        }
                    },

                    "X5_Note": {
                        "tag": "X5",
                        "status": "REQUIRED",
                        "purpose": "Closing scripture anchor — grounds the test file in eternal truth",
                        "why_required": "The closing anchor. Every OmniCode file is grounded in Scripture.",
                        "content_constraints": {
                            "can_contain": [
                                "// Opening scripture quote — file-appropriate closing scripture",
                                "// 2-4 sentence reflection connecting the scripture to testing and accountability",
                                "// The closing anchor — the file's last word is eternal truth",
                                "Comment-only — poetry and theology, not code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X5 is the closing meditation, not logic",
                                "Technical documentation — architecture details go in X1/X4",
                                "Placeholder scripture"
                            ],
                            "demo_test_pattern": "Scripture connecting testing to accountability/truth-telling. The test file proves the code works — this is a form of truth-telling. The closing anchor connects testing discipline to the commitment to truth.",
                            "why_these_constraints": "X5 bookends C3 (METADATA grounding). The file opens with Scripture (C3) and closes with Scripture (X5). For test files, the closing reflects on testing as accountability — proving claims with evidence, which is a form of truth-telling."
                        }
                    },

                    "X6_Template": {
                        "status": "NOT APPLICABLE",
                        "why_absent": "X6 is template-only. Demo-test is a derived file — it was CREATED from bare-bone by following X6's instructions and then REMOVING X6. X6's presence in a demo-test file would mean 'I am still a template, not a real file' — which is false."
                    }
                },

                "Reserved_Omission": {
                    "position": "Between last code zone and first doc section",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists CLOSING sections NOT active in this specific demo-test file.",
                    "why_required": "Completeness contract. Lists whichever of Cc, X2, X3 are not used.",
                    "demo_test_content": "Lists whichever of Cc, X2, X3 are not active in this specific demo-test file. X6 is explicitly NOT APPLICABLE (not reserved, just absent)."
                }
            },

            "cannot": {
                "description": "No CLOSING sections are categorically RESERVED in demo-test. TestCoverageSummary is promoted to required. Cc/X2/X3 are available. X6 is absent.",
                "note": "Demo-test is UNIQUE: zero reserved CLOSING sections. Library reserves TestCoverageSummary + X6. Executable reserves TestCoverageSummary. Demo-test promotes TestCoverageSummary AND has no X6 — leaving zero reserved.",
                "X6_Template": {
                    "status": "NOT APPLICABLE",
                    "why_absent": "X6 is template-only. Demo-test is a derived file."
                }
            },

            "ordering_rule": {
                "canonical": "Cv → Ce (empty) → TestCoverageSummary → [Cc if used] → Reserved Omission → X1 → [X2 if used] → [X3 if used] → X4 → X5",
                "principle": "Code zones FIRST (Cv meta-tests, Ce empty, TestCoverageSummary metrics), then reserved, then documentation. X6 absent.",
                "demo_test_minimum": "Cv → Ce (empty) → TestCoverageSummary → Reserved Omission → X1 → X4 → X5",
                "demo_test_full": "Cv → Ce (empty) → TestCoverageSummary → Cc → Reserved Omission → X1 → X2 → X3 → X4 → X5"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════
    // CROSS-CONTAINER RULES
    // ═══════════════════════════════════════════════════════════

    "cross_container_rules": {

        "completeness_contract": {
            "description": "Every section in the OmniCode 4-block system is either REQUIRED, AVAILABLE, or NOT APPLICABLE. Nothing is silently absent.",
            "formula": "Per container: required + available + reserved + absent = container_maximum",
            "demo_test_totals": {
                "METADATA": { "required": "ALL", "available": 0, "reserved": 0, "note": "Identical to bare-bone — all sections required" },
                "SETUP": { "required": 5, "available": 5, "reserved": 0, "total": 10, "note": "All 10 sections accessible — 5 required, 5 available (same as library)" },
                "BODY": { "required": 10, "available": 0, "reserved": 7, "total": 17, "note": "10 = IdentityAccess + 9 test categories. 7 reserved = 2 bare-bone + 4 library + 1 executable" },
                "CLOSING": { "required": 6, "available": 3, "reserved": 0, "absent": 1, "total": 10, "note": "6 required includes TestCoverageSummary (promoted). X6 absent (derived file). Zero reserved." }
            },
            "comparison_to_bare_bone": {
                "METADATA": "SAME (all required)",
                "SETUP": "EXPANDED: bare-bone 4 required + 6 reserved → demo-test 5 required + 5 available (all 6 reserved promoted)",
                "BODY": "EXPANDED: bare-bone 3 active + 14 reserved → demo-test 10 required + 7 reserved (9 test categories promoted, CoreLogic + FreeFunctions moved to reserved)",
                "CLOSING": "EXPANDED: bare-bone 6 active + 4 reserved → demo-test 6 required + 3 available + 0 reserved (TestCoverageSummary promoted, X6 removed, Cc/X2/X3 available)"
            },
            "comparison_to_library": {
                "METADATA": "SAME (all required)",
                "SETUP": "SAME (5 required + 5 available = 10)",
                "BODY": "DIFFERENT SECTIONS: library 7 type_lifecycle vs demo-test 10 concern_coverage. Same structure, completely different content.",
                "CLOSING": "MORE PROMOTED: library 5 req + 3 avail + 2 reserved → demo-test 6 req + 3 avail + 0 reserved (TestCoverageSummary promoted to required)"
            },
            "comparison_to_executable": {
                "METADATA": "SAME (all required)",
                "SETUP": "MORE PROMOTED: executable 4 req + 4 avail + 2 reserved → demo-test 5 req + 5 avail + 0 reserved",
                "BODY": "DIFFERENT SECTIONS: executable 3 execution_flow vs demo-test 10 concern_coverage.",
                "CLOSING": "MORE PROMOTED: executable 5 req + 3 avail + 1 reserved → demo-test 6 req + 3 avail + 0 reserved"
            }
        },

        "three_status_levels": {
            "description": "Demo-test uses the three-level status system (same as library and executable).",
            "REQUIRED": "Must exist in every demo-test file. Missing = validation error.",
            "AVAILABLE": "Promoted from bare-bone reserved. Use when needed, skip when not. Unused available sections go in Reserved Omission.",
            "RESERVED": "Belongs to other forms (library, executable). Cannot be active in demo-test files."
        },

        "concern_coverage_ordering": {
            "description": "Demo-test BODY follows the natural progression of how types are TESTED.",
            "ordering": ["B1 IdentityAccess", "B2 ConstructorTests", "B3 BuilderTests", "B4 TransitionTests", "B5 QueryTests", "B6 IdentityTests", "B7 ErrorTests", "B8 EdgeCaseTests", "B9 TableDrivenTests", "B10 IntegrationTests"],
            "rationale": "Reading top-to-bottom tells the story: who is this file (B1) → can I create it (B2) → can I configure it (B3) → can I change it (B4) → can I observe it (B5) → is its identity correct (B6) → does it fail gracefully (B7) → does it handle boundaries (B8) → can I prove it systematically (B9) → does it all work together (B10).",
            "enforcement": "Section comment headers must appear in this order. Out-of-order sections are a linting error."
        },

        "inheritance_model": {
            "description": "How demo-test relates to bare-bone.",
            "inherits": "All bare-bone CAN sections and their content_constraints (floor)",
            "promotes": "9 test categories from Reserved Omission to REQUIRED. TestCoverageSummary from CLOSING reserved to REQUIRED. All 6 SETUP reserved to AVAILABLE.",
            "reserves": "CoreLogic and FreeFunctions from bare-bone ACTIVE to RESERVED (absorbed by test categories)",
            "removes": "X6 (template-only — demo-test is a derived file)",
            "changes": {
                "content_state": "bare-bone: all commented-out skeleton → demo-test: all REAL, UNCOMMENTED test code",
                "body_ordering": "bare-bone: unpositioned → demo-test: concern_coverage numbered B1-B10",
                "body_sections": "bare-bone: 3 universal → demo-test: 10 test-focused (IdentityAccess inherited, 9 categories promoted, CoreLogic + FreeFunctions reserved)",
                "closing_ce": "bare-bone: unknown form → demo-test: always empty (cargo test is harness)",
                "closing_new": "TestCoverageSummary promoted to required (bare-bone reserved → demo-test required)"
            },
            "preserves": "4-block structure, all structural markers, PRAGMA/METADATA identity requirements, block boundary tags, subsection header format"
        },

        "the_cheat_code": {
            "workflow": "cp bare-bone.rs my-demo-test.rs → change -bare-bone to -demo-test → promote test categories from Reserved Omission → uncomment skeleton code → fill with real tests → remove X6 → done",
            "why_it_works": "bare-bone already has every container, every structural marker, every identity field. Promoting sections means moving them from Reserved Omission to active and adding test content. Structure stays. Identity updates. Content fills.",
            "demo_test_specific_steps": [
                "1. cp bare-bone.rs → my-demo-test.rs",
                "2. Change pragma: -bare-bone → -demo-test",
                "3. Update I1.key, I2.subtype='demo-test', I2.role, C-sections (C3 scripture for testing/accountability)",
                "4. SETUP: Promote S2 to required, add S4/S5/S8/S9/S10 as available",
                "5. BODY: Remove CoreLogic and FreeFunctions. Add B2-B10 test categories in concern_coverage order",
                "6. Add use {crate_under_test}::*; to imports (S1)",
                "7. Write REAL tests in each B-section: constructors, builders, transitions, queries, identity, errors, edge cases, tables, integration",
                "8. CLOSING: Leave Ce empty. Add TestCoverageSummary with initial counts",
                "9. Write Cv meta-tests verifying test infrastructure",
                "10. Fill X1 with test-file policy, X4 with crate-under-test references, X5 with accountability scripture",
                "11. Remove X6 and placeholders",
                "12. cargo test -- --nocapture to verify all tests pass",
                "13. Update TestCoverageSummary with final counts",
                "14. cargo clippy -- -D warnings"
            ]
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "cws-struct lint rust <demo-test-file> — should show 10 BODY sections in concern_coverage order, TestCoverageSummary in CLOSING, Ce empty",
    "_Cv_expected_state": "All container constraints above accurately reflect what a demo-test Rust file SHOULD contain — inheriting bare-bone's foundation, promoting 9 test categories and TestCoverageSummary per the derivation_rule in form_identity",
