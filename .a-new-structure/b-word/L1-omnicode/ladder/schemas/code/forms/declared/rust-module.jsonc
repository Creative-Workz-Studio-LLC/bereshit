{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-form-module-rust",
    "_P1_from": "b-word/L1-omnicode/ladder/schemas/code/forms/bare-bone/rust-bare-bone.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "form-constraint",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/forms/declared",
    "_P3_includes": "none",
    "_P3_provides": ["MODULE_FORM_CONSTRAINTS", "CONTAINER_CAN_CANNOT", "TYPE_LIFECYCLE_ORDERING"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust Module Form Schema",
    "_P5_brief": "Defines what CAN and CANNOT be in each container of a module Rust file. Module is a focused, single-concern file within a crate (src/parser.rs, src/config.rs). Inherits bare-bone's foundation and follows type_lifecycle ordering like library, but RESERVES S2/S9/S10 (crate-level) and B6 (output layer). Every constraint has a WHY and a HOW.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-module.jsonc",
        "key": "B-L1-schemas-form-module-rust",
        "title": "Rust Module Form Schema",
        "type": "Data (Form Constraint Schema)",
        "component": "Ladder",
        "role": "Define per-container CAN/CANNOT constraints for module Rust form — focused internal files with type lifecycle ordering"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-20",
        "updated": "2026-02-20"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "1 Corinthians 12:18 — But now hath God set the members every one of them in the body, as it hath pleased him.",
        "principle": "Module is a member of the body (crate). Each module has a specific function — focused, single-concern, serving the whole. The body is not one member but many. Modules don't exist alone; they exist within the crate's body, each doing what it was placed to do."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": [
            "code/forms/bare-bone/rust-bare-bone.jsonc — inherits foundation constraints (the floor this form stands on)",
            "code/forms/declared/rust-library.jsonc — module derives from library pattern (same type_lifecycle, fewer sections)",
            "code/base/base-4block-schema.jsonc — container definitions, form registry",
            "code/format/rust-4block-schema.jsonc — Rust syntax rules, comment conventions"
        ],
        "consumers": [
            "b-word/seed/code/L0/rust/module.rs — the module template this schema constrains",
            "All module-form Rust files (src/*.rs files within crates — parsers, configs, handlers, etc.)"
        ],
        "relationship": "Module is library's focused sibling. Same type_lifecycle ordering, but RESERVES crate-level sections (S2 Modules, S9 Macros, S10 Features, B6 Output) because modules are members of the body, not the body itself."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // THE MODULE FORM CONSTRAINT SCHEMA
    //
    // Module is a focused, single-concern file within a crate
    // (src/parser.rs, src/config.rs, src/handler.rs).
    //
    // Module inherits bare-bone's foundation and follows library's
    // type_lifecycle ordering, but RESERVES crate-level sections:
    //   SETUP: S2 Modules, S9 Macros, S10 Feature Gates → RESERVED
    //   BODY:  B6 Output → RESERVED
    //   CLOSING: Same as library
    //
    // BODY ordering: type_lifecycle (same as library)
    //   Identity → Traits → Constructors → CoreLogic → Queries → [Output RESERVED] → Free
    //
    // Structure mirrors base-4block-schema.jsonc container layout:
    //   METADATA → SETUP → BODY → CLOSING
    // Each container gets: can, cannot, why, how.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/forms/module/rust.schema.json",
    "title": "Rust Module Form Constraints",
    "description": "Per-container CAN/CANNOT constraints for module Rust files. Focused internal files with type lifecycle ordering.",

    "form_identity": {
        "name": "module",
        "is_foundation": false,
        "inherits": "bare-bone",
        "derives_from_pattern": "library (same type_lifecycle, fewer sections)",
        "pragma": "//omni:code --rust -module",
        "directive": "//omni:code --rust -module",
        "template": "b-word/seed/code/L0/rust/module.rs",
        "principle": "A member of the body. 1 Corinthians 12:18 — God set the members every one of them in the body. Module is not the whole crate; it is a focused part within the crate. It doesn't declare submodules or own the output layer — those are the body's (crate root's) responsibilities. Module does its one thing well.",
        "derivation_rule": "Module = bare-bone + promoted SETUP sections (S4/S5/S8 available) + 3 promoted BODY sections (TraitImpls, Constructors, Queries) in type_lifecycle order. S2/S9/S10 RESERVED (crate-level). B6 RESERVED (output layer). Cc/X2/X3 available in CLOSING.",
        "ordering": "type_lifecycle — Identity → Traits → Constructors → CoreLogic → Queries → [Output RESERVED] → FreeFunctions"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The four containers, each fully constrained.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "containers": {

        // ═══════════════════════════════════════════════════════
        // 1. METADATA CONTAINER — identical to bare-bone
        // ═══════════════════════════════════════════════════════
        //
        // Module does NOT change METADATA requirements.
        // Identity is form-invariant. The ONLY difference:
        //   //omni:code --rust -module (not -bare-bone)
        //   I2.subtype = "module" (not "bare-bone")
        //   I2.role = form-specific (e.g., "parser", "config")

        "METADATA": {
            "summary": "IDENTICAL TO BARE-BONE — fully required, every section, every required field. Module does not change METADATA.",
            "reserved_omission": false,
            "inherits_from": "bare-bone METADATA (all constraints, all content_constraints)",

            "why": "Identity is form-invariant. A module has exactly the same identity requirements as bare-bone and library. The PRAGMA and METADATA statics have the same fields, same required/defined split, same (&str, &str) format. The only values that change are I1.key (unique to this file), I2.subtype ('module' not 'bare-bone'), and C-section values (file-specific context).",

            "module_specific_changes": {
                "directives": "//omni:code --rust -module (not -bare-bone or -library)",
                "I2_subtype": "module",
                "I2_role": "File-specific (e.g., 'parser', 'config', 'handler', 'types')",
                "doc_comments": "Module doc comments describe this module's focused purpose. Include: what the module does, key types, how it fits into the crate. Use //! (inner doc comments) for module-level documentation.",
                "C4_dependencies": "Real dependencies — often use super:: and use crate:: imports rather than external crates",
                "C5_purpose": "Domain-specific purpose — focused single-concern within the crate"
            },

            "content_constraints_note": "All content_constraints from bare-bone METADATA apply unchanged. See rust-bare-bone.jsonc METADATA container for the complete constraint definitions for directives, doc_comments, pragma_statics, metadata_statics, and comment_metadata.",

            "cannot": {
                "description": "Same as bare-bone — no executable code, no imports, no types, no Reserved Omission in METADATA.",
                "inherits": "bare-bone METADATA.cannot (all prohibitions unchanged)"
            }
        },

        // ═══════════════════════════════════════════════════════
        // 2. SETUP CONTAINER — 4 required + 3 available + 3 reserved
        // ═══════════════════════════════════════════════════════
        //
        // Module RESERVES S2 (Modules), S9 (Macros), S10 (Feature Gates)
        // because those are crate-level concerns — the crate root
        // (lib.rs) owns submodule declarations, macro exports, and
        // feature gate organization.
        //
        // Content is REAL (not commented-out like bare-bone).

        "SETUP": {
            "summary": "4 required + 3 available + 3 reserved. Module reserves S2/S9/S10 (crate-level); all other SETUP sections available.",
            "reserved_omission": true,
            "inherits_from": "bare-bone SETUP (S1, S3, S6, S7 content_constraints apply; content is REAL not commented-out)",

            "why": "Module is a focused member of the crate. It DOES NOT need a module tree (S2) — only lib.rs declares submodules. It DOES NOT need macros (S9) — macros belong in dedicated macro modules or crate root. It DOES NOT need feature gates (S10) — feature configuration is crate-level (Cargo.toml + lib.rs). The 4 required sections (S1, S3, S6, S7) serve the same purpose as in library — imports, constants, errors, and types are still needed. The 3 available sections (S4, S5, S8) may be used when needed.",

            "how": {
                "working_with_constraints": "Every module file has at minimum: imports (with use super::/use crate:: patterns), constants, error types, core types. Add statics/aliases/trait definitions as needed — they're available, not required.",
                "content_is_real": "Unlike bare-bone where all content is commented-out skeleton, module content is REAL, UNCOMMENTED Rust code. The patterns from bare-bone's content_constraints still apply — but the code is live.",
                "import_patterns": "Modules import primarily via use super:: (parent items) and use crate:: (crate-internal items). External crate imports are less common — the crate root re-exports what modules need, or modules import directly when they have specific external dependencies."
            },

            "can": {
                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S1_Imports content_constraints (same rules apply)",
                    "module_difference": "Imports are REAL, not commented-out. Module imports emphasize use super:: and use crate:: patterns. External crate imports are less common — modules access most functionality through the crate's internal API.",
                    "content_constraints": {
                        "can_contain": [
                            "use std::{module}; — standard library imports (REAL, not commented-out)",
                            "use super::{item}; — parent module imports (PRIMARY pattern for modules)",
                            "use super::shared::{item}; — sibling module imports via parent",
                            "use crate::{module}::{item}; — crate-internal imports for cross-module access",
                            "use {external_crate}::{item}; — external crate imports (when module has specific dependency)",
                            "// Group comment headers: // --- Standard Library ---, // --- Parent / Sibling ---, etc."
                        ],
                        "cannot_contain": [
                            "Wildcard glob imports (use foo::*) — import what you use",
                            "Dead imports — every use must be referenced (clippy enforces)",
                            "Imports outside their origin group — maintain std → parent/sibling → crate → external ordering"
                        ],
                        "module_pattern": "Group imports by relationship to this module: (1) std library, (2) parent and sibling modules (use super::), (3) crate-internal (use crate::), (4) external (use external_crate::). Parent/sibling imports are typically the largest group in a module.",
                        "why_these_constraints": "Same as bare-bone — imports are dependency graph edges. Module difference: the primary relationships are inward (use super::, use crate::) rather than outward (use external_crate::). This reflects modules' role as internal parts of a larger whole."
                    }
                },

                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S3_Constants content_constraints (same rules apply)",
                    "module_difference": "Constants are REAL values, not commented-out examples. Module constants are domain-specific to this module's focused concern.",
                    "content_constraints": {
                        "can_contain": [
                            "const NAME: Type = value; — compile-time constants with REAL domain values",
                            "SCREAMING_SNAKE_CASE naming",
                            "Module-specific defaults, limits, format strings, capacity constraints"
                        ],
                        "cannot_contain": [
                            "static variables (S4), let bindings, LazyLock/OnceLock (S4)",
                            "PRAGMA/METADATA statics (those are METADATA block identity)",
                            "Values that depend on runtime computation",
                            "Constants that belong in a shared constants module — if multiple modules need it, centralize it"
                        ],
                        "why_these_constraints": "Same as bare-bone — centralize hardcoded values. Module difference: these are constants for THIS module's concern only. Shared constants should live in a common module, not duplicated."
                    }
                },

                "S4_Statics": {
                    "position": 4,
                    "tag": "Statics",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "static NAME: LazyLock<Type> = LazyLock::new(|| { ... });",
                    "purpose": "Runtime-initialized shared state — module-level singletons",
                    "why_available": "Modules with module-level shared state (compiled regexes, cached computations) need statics. Not every module has shared state, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "static NAME: LazyLock<Type> = LazyLock::new(|| { ... }); — lazy initialization",
                            "static NAME: OnceLock<Type> = OnceLock::new(); — one-time initialization",
                            "// Comment explaining WHY this needs module-level lifetime"
                        ],
                        "cannot_contain": [
                            "static mut — mutable statics are unsafe; use interior mutability",
                            "PRAGMA/METADATA statics — those live in METADATA, not SETUP",
                            "const values — those belong in S3 (compile-time, not runtime)",
                            "Connection pools or crate-wide singletons — those belong in the crate root or a dedicated module"
                        ],
                        "why_these_constraints": "Same as library. Module statics should be limited to this module's concerns. Crate-wide shared state belongs in the crate root."
                    }
                },

                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "type Result<T> = std::result::Result<T, Error>;",
                    "purpose": "Module-level vocabulary shortcuts — named aliases for complex types",
                    "why_available": "Modules with frequently-used complex types benefit from aliases. Not every module needs aliases, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "pub(crate) type Result<T> = std::result::Result<T, {ErrorType}>; — module-level Result alias",
                            "type {Name} = {ComplexType}; — internal vocabulary aliases",
                            "/// doc comment explaining what the alias simplifies"
                        ],
                        "cannot_contain": [
                            "Type aliases that hide important information",
                            "Aliases used in only one place — wait until 3+ uses",
                            "Struct/enum definitions — those are S7 CoreTypes",
                            "Crate-wide aliases — those belong in lib.rs or a types module"
                        ],
                        "why_these_constraints": "Same as library. Module aliases should be limited to this module's internal vocabulary. Crate-wide aliases belong in the crate root."
                    }
                },

                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S6_ErrorTypes content_constraints (same rules apply)",
                    "module_difference": "Error types are REAL with module-specific variants. Module errors often convert to the crate's top-level error type via From impls.",
                    "content_constraints": {
                        "can_contain": [
                            "pub enum {ErrorType} { ... } — REAL error enum with module-specific variants",
                            "#[derive(Debug, Clone, PartialEq, Eq)] — testability derives",
                            "impl fmt::Display — match on all variants with meaningful messages",
                            "impl std::error::Error — for error chaining",
                            "impl From<{SourceError}> — conversion from upstream errors",
                            "Enum-typed fields (op: LoadOp, kind: DepKind) — NOT stringly typed"
                        ],
                        "cannot_contain": [
                            "String-typed fields where enums would serve",
                            "anyhow::Error as the primary type — that's for binaries, not library/module code",
                            "Error handling logic — BODY handles errors, SETUP defines them"
                        ],
                        "module_pattern": "Module errors are often wrapped by the crate's top-level error enum via From. Design module errors for composability — they should convert cleanly into the crate's error hierarchy.",
                        "why_these_constraints": "Same as library. Module errors participate in the crate's error hierarchy. They need enum variants with typed fields so the crate-level error can wrap them meaningfully."
                    }
                },

                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "status": "REQUIRED",
                    "inherits_constraints": "bare-bone S7_CoreTypes content_constraints (same rules apply)",
                    "module_difference": "Types are REAL with module-specific fields. Module types are focused on a single concern. Visibility is often pub(crate) or pub(super) rather than pub — the crate root decides what to re-export publicly.",
                    "content_constraints": {
                        "can_contain": [
                            "pub struct {TypeName} { ... } — or pub(crate) for internal-only types",
                            "pub enum {TypeName} { ... } — domain enumerations",
                            "#[derive(Debug)] minimum, plus Clone/PartialEq/Eq/Hash as needed",
                            "impl Default — when a sensible default exists",
                            "impl {Type} { pub fn new(...) -> Self } — SIMPLE constructors only",
                            "/// doc comments: what the type represents, field purposes"
                        ],
                        "cannot_contain": [
                            "Complex constructors (validation, fallible creation) — BODY B3",
                            "Builder patterns — BODY B3",
                            "Business logic methods — BODY B4",
                            "Trait definitions — S8 TraitDefs (when available)"
                        ],
                        "module_pattern": "Use pub(crate) for types that serve the crate but shouldn't be in the public API. The crate root (lib.rs) decides what to pub use re-export. Module types should be focused — if a module defines more than ~3 types, it may need splitting.",
                        "why_these_constraints": "Same as library. Module types are the NOUNS of this module's focused concern. Visibility control (pub(crate) vs pub) is more relevant for modules because they don't directly control the crate's public surface."
                    }
                },

                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "status": "AVAILABLE (promoted from bare-bone reserved when needed)",
                    "rust_syntax": "pub trait Name { fn method(&self) -> Type; }",
                    "purpose": "Behavioral contracts — define what types CAN DO without specifying HOW",
                    "why_available": "Some modules define trait contracts for their concern area. Not every module defines traits, so it's available rather than required.",
                    "content_constraints": {
                        "can_contain": [
                            "pub(crate) trait {Name} { ... } — internal behavioral contracts",
                            "pub trait {Name} { ... } — public contracts (re-exported by crate root)",
                            "Default method implementations — when a sensible default exists",
                            "/// doc comments: what the trait represents, when to implement it"
                        ],
                        "cannot_contain": [
                            "Trait implementations (impl Trait for Type) — those go in BODY B2",
                            "Concrete logic — traits define contracts, not implementations",
                            "More than ~3 traits per module — many traits signal the module needs splitting"
                        ],
                        "why_these_constraints": "Same as library. Traits define WHAT, not HOW. In modules, traits often use pub(crate) visibility since the crate root decides public API."
                    }
                },

                "Reserved_Omission": {
                    "position": "LAST in SETUP (after all active subsections)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists SETUP sections NOT active in this module file",
                    "why_required": "Completeness contract. active_count + available_unused + reserved = 10. Nothing silently absent.",
                    "module_content": {
                        "always_reserved": [
                            "S2  Modules       — Submodule declarations belong in lib.rs (crate root), not module files",
                            "S9  Macros        — Macros belong in dedicated macro modules or crate root",
                            "S10 Feature Gates — Feature flags are crate-level config (Cargo.toml + lib.rs)"
                        ],
                        "per_file_variable": "Additionally lists whichever of S4, S5, S8 are not used in THIS specific module file."
                    }
                }
            },

            "cannot": {
                "description": "These sections CANNOT be active in module form. They belong to the crate root.",

                "S2_Modules": {
                    "status": "RESERVED",
                    "why_reserved": "Submodule declarations (mod name; pub use name::Type;) belong in lib.rs or parent mod.rs — only module tree roots declare children. Individual modules are LEAVES of the tree, not branches.",
                    "active_in": "library form (crate root)"
                },

                "S9_Macros": {
                    "status": "RESERVED",
                    "why_reserved": "Macros (macro_rules!) belong in dedicated macro modules or the crate root. Individual modules should use macros, not define them. A module defining macros signals it should be a separate concern (e.g., macros.rs).",
                    "active_in": "library form (crate root or dedicated macro module)"
                },

                "S10_FeatureGates": {
                    "status": "RESERVED",
                    "why_reserved": "Feature gates (#[cfg(feature = ...)]) are crate-level configuration defined in Cargo.toml. Individual modules may be GATED BY features (the whole module behind #[cfg]), but they don't ORGANIZE feature-gated items — that's the crate root's job.",
                    "active_in": "library form (crate root)"
                }
            },

            "completeness_rule": {
                "formula": "required + available_active + available_reserved + form_reserved = 10",
                "module_minimum": "4 required (S1, S3, S6, S7) + 3 available (S4, S5, S8 — some active, some in Reserved Omission) + 3 form-reserved (S2, S9, S10 — always in Reserved Omission) = 10"
            }
        },

        // ═══════════════════════════════════════════════════════
        // 3. BODY CONTAINER — 6 required + Reserved Omission
        // ═══════════════════════════════════════════════════════
        //
        // Module BODY follows TYPE LIFECYCLE ordering (same as
        // library) but RESERVES B6 Output — modules return data,
        // the crate's output layer formats it.
        //
        // 3 inherited from bare-bone (IdentityAccess, CoreLogic,
        // FreeFunctions) + 3 PROMOTED (TraitImpls, Constructors,
        // Queries). B6 Output RESERVED.
        //
        // Content is REAL (not commented-out like bare-bone).

        "BODY": {
            "summary": "6 required subsections + Reserved Omission. Type lifecycle ordering — B6 Output reserved (crate output layer).",
            "reserved_omission": true,
            "inherits_from": "bare-bone BODY (IdentityAccess, CoreLogic, FreeFunctions — content is REAL not commented-out)",

            "why": "Module BODY follows the same type lifecycle as library — the natural progression of how types LIVE. But modules DON'T own the output layer. Modules return data; the crate root or a dedicated output module formats it. This separation keeps modules focused: they do their one thing and let the caller decide how to present the results. A parser module returns AST nodes, not formatted error messages. A config module returns Config structs, not pretty-printed tables.",

            "how": {
                "working_with_constraints": "Follow type_lifecycle ordering strictly, skipping B6. If you find yourself writing output formatting in a module — move it to the crate's output module or return data and let the caller format.",
                "content_is_real": "Unlike bare-bone where all content is commented-out skeleton, module content is REAL, UNCOMMENTED Rust code.",
                "ordering_rationale": "Same rationale as library — type_lifecycle serves reading comprehension. The gap at position 6 (Output reserved) is intentional and documented in Reserved Omission."
            },

            "can": {
