    // ═══════════════════════════════════════════════════════════
    // CROSS-CONTAINER RULES
    // ═══════════════════════════════════════════════════════════

    "cross_container_rules": {

        "completeness_contract": {
            "description": "Every section in the OmniCode 4-block system is either REQUIRED, AVAILABLE, or RESERVED. Nothing is silently absent.",
            "formula": "Per container: required + available_active + available_unused + reserved = container_maximum",
            "module_totals": {
                "METADATA": { "required": "ALL", "available": 0, "reserved": 0, "note": "Identical to bare-bone and library" },
                "SETUP": { "required": 4, "available": 3, "reserved": 3, "total": 10, "note": "3 reserved = S2 + S9 + S10 (crate-level)" },
                "BODY": { "required": 6, "available": 0, "reserved": 11, "total": 17, "note": "11 reserved = B6 module-reserved + 1 executable + 9 demo-test" },
                "CLOSING": { "required": 5, "available": 3, "reserved": 2, "total": 10, "note": "Same as library — 2 reserved = TestCoverageSummary + X6" }
            },
            "comparison_to_bare_bone": {
                "METADATA": "SAME (all required)",
                "SETUP": "PARTIALLY EXPANDED: bare-bone 4 required + 6 reserved → module 4 required + 3 available + 3 reserved (S4/S5/S8 promoted to available; S2/S9/S10 stay reserved for module form)",
                "BODY": "PARTIALLY EXPANDED: bare-bone 3 active + 14 reserved → module 6 required + 11 reserved (3 sections promoted; B6 stays reserved for module form)",
                "CLOSING": "EXPANDED: bare-bone 6 active + 4 reserved → module 5 required + 3 available + 2 reserved (same as library)"
            },
            "comparison_to_library": {
                "METADATA": "SAME",
                "SETUP": "NARROWER: library 5 required + 5 available → module 4 required + 3 available + 3 reserved (S2 demoted from required to reserved, S9/S10 demoted from available to reserved)",
                "BODY": "NARROWER: library 7 required + 10 reserved → module 6 required + 11 reserved (B6 Output demoted from required to reserved)",
                "CLOSING": "SAME (5 required + 3 available + 2 reserved)"
            }
        },

        "three_status_levels": {
            "description": "Module uses the same three-level status system as library.",
            "REQUIRED": "Must exist in every module file. Missing = validation error.",
            "AVAILABLE": "Promoted from bare-bone reserved. Use when needed, skip when not.",
            "RESERVED": "Belongs to other forms or crate root. Cannot be active in module files."
        },

        "type_lifecycle_ordering": {
            "description": "Module BODY follows the same type lifecycle as library, with B6 reserved.",
            "ordering": ["B1 IdentityAccess", "B2 TraitImplementations", "B3 Constructors", "B4 CoreLogic", "B5 Queries", "[B6 Output RESERVED]", "B7 FreeFunctions"],
            "rationale": "Same reading comprehension benefit as library. B6 gap is intentional — documented in Reserved Omission.",
            "enforcement": "Section comment headers must appear in this order (skipping B6). Out-of-order sections are a linting error."
        },

        "inheritance_model": {
            "description": "How module relates to bare-bone and library.",
            "inherits": "All bare-bone CAN sections and their content_constraints (floor)",
            "pattern_from": "Library schema — same type_lifecycle ordering, same CLOSING structure",
            "promotes": "B2/B3/B5 from bare-bone Reserved to REQUIRED; S4/S5/S8 to AVAILABLE; Cc/X2/X3 to AVAILABLE",
            "reserves": "S2 Modules, S9 Macros, S10 Feature Gates (crate-level); B6 Output (output layer)",
            "removes": "X6 (template-only — module is a derived file)",
            "changes": {
                "content_state": "bare-bone: all commented-out skeleton → module: all REAL, UNCOMMENTED code",
                "body_ordering": "bare-bone: unpositioned → module: type_lifecycle numbered B1-B5, B7 (B6 reserved)",
                "closing_ce": "bare-bone: unknown form → module: always empty (no entry point)",
                "import_pattern": "library: external crate focus → module: use super::/use crate:: focus"
            },
            "preserves": "4-block structure, all structural markers, PRAGMA/METADATA identity requirements, block boundary tags"
        },

        "the_cheat_code": {
            "workflow": "cp module.rs my-module.rs → change -module pragma values → promote available sections as needed → uncomment skeleton code → fill with domain logic → remove X6 → add mod my_module; to parent → done",
            "why_it_works": "module.rs template already has the right sections active and reserved. Instantiation is: update identity, fill content, wire into parent.",
            "module_specific_steps": [
                "1. cp module.rs → src/my_module.rs",
                "2. Change pragma: template → //omni:code --rust -module",
                "3. Update I1.key, I2.subtype='module', I2.role, C-sections",
                "4. SETUP: S1 imports (use super::, use crate::), S3 constants, S6 errors, S7 types",
                "5. SETUP: Add S4/S5/S8 as needed (they're available)",
                "6. BODY: B1 identity accessors (uncomment), B2-B5 type lifecycle, B7 free functions",
                "7. Uncomment all skeleton code, fill with real domain logic",
                "8. Write real tests in Cv organized by BODY section (skip B6)",
                "9. Fill X1 with real policy, X4 with real references, X5 with domain scripture",
                "10. Remove X6",
                "11. Add `mod my_module;` to parent (lib.rs or parent mod.rs)",
                "12. Add `pub use my_module::PublicType;` re-exports to parent as needed",
                "13. cargo clippy + cargo test"
            ]
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "cws-struct lint rust <module-file> — should show 6 BODY sections in type_lifecycle order (skip B6), 7 active SETUP sections, comprehensive Cv tests",
    "_Cv_expected_state": "All container constraints above accurately reflect what a module Rust file SHOULD contain — inheriting bare-bone's foundation, following library's type_lifecycle, reserving crate-level sections",
    "_Cv_schema_chain": "base-4block-schema.jsonc → rust-4block-schema.jsonc → rust-bare-bone.jsonc → THIS FILE (rust-module.jsonc)",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "But now hath God set the members every one of them in the body, as it hath pleased him. — 1 Corinthians 12:18",
    "_X1_never": [
        "Remove a REQUIRED section from module (required sections are the structural contract)",
        "Change the type_lifecycle ordering in BODY (the ordering IS the architecture — B1 through B5, B7 in that sequence)",
        "Remove the inheritance relationship with bare-bone (module stands ON bare-bone)",
        "Activate S2/S9/S10 in module form (those are crate-level — use library form instead)",
        "Activate B6 in module form (output belongs to the crate output layer)",
        "Remove the three-status-level system (REQUIRED/AVAILABLE/RESERVED)"
    ],
    "_X1_careful": [
        "Promoting a section from AVAILABLE to REQUIRED (cascades to ALL module files)",
        "Changing content_constraints (defines what code CAN go where)",
        "Changing the reserved sections (S2/S9/S10/B6) — would fundamentally change what module form means",
        "Changing the inheritance model (must stay in sync with bare-bone schema)"
    ],
    "_X1_safe": [
        "Adding detail to content_constraints (more guidance improves code quality)",
        "Adding module_pattern examples to sections",
        "Adding why_these_constraints explanations",
        "Adding new AVAILABLE sections (extending capabilities without requiring them)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_schema_chain": [
        "schemas/code/base/base-4block-schema.jsonc — Container definitions, form registry (ROOT)",
        "schemas/code/format/rust-4block-schema.jsonc — Rust-specific syntax rules and comment conventions",
        "schemas/code/forms/bare-bone/rust-bare-bone.jsonc — Foundation form (this schema inherits from it)",
        "schemas/code/forms/declared/rust-library.jsonc — Library form (module follows same type_lifecycle pattern)",
        "THIS FILE — Module form constraints (focused internal files)"
    ],
    "_X4_sibling_forms": [
        "schemas/code/forms/declared/rust-library.jsonc — Library form (crate root)",
        "schemas/code/forms/declared/rust-executable.jsonc — Executable form",
        "schemas/code/forms/declared/rust-demo-test.jsonc — Demo-test form"
    ],
    "_X4_constrained_files": [
        "b-word/seed/code/L0/rust/module.rs — Module template",
        "All module-form Rust files: src/*.rs files within crates (parsers, configs, handlers, etc.)"
    ],
    "_X4_tooling": [
        "c-tov/cws-struct/lib/handlers/rust.ts — Runtime linter (validates against this schema)",
        "c-tov/cws-struct/mod.ts — CLI entry: deno run --allow-read mod.ts lint rust <file>"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "Module is a member of the body. 1 Corinthians 12:18: 'But now hath God set the members every one of them in the body, as it hath pleased him.' Not every member is the eye. Not every module is the crate root. The eye cannot say unto the hand, 'I have no need of thee.' Each module has its place — parser, config, handler, types — set there as it pleased Him. The module doesn't try to be the whole crate. It does its one thing with excellence. A parser parses. A config loads. A handler handles. The focused purpose IS the excellence. When you cp module.rs and promote to a real file, you are setting a member in the body: 'This is your concern. Do it well. The body needs you exactly here.'",
    "_X5_scripture": "But now hath God set the members every one of them in the body, as it hath pleased him. And if they were all one member, where were the body? — 1 Corinthians 12:18-19",
    "_X5_anchor": "Module is a member. The body needs members. Each in its place. Focused excellence.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
