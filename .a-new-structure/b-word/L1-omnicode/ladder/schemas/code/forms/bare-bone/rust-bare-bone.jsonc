        // ═══════════════════════════════════════════════════════
        // 3. BODY CONTAINER — 3 active + Reserved Omission
        // ═══════════════════════════════════════════════════════
        //
        // BODY makes things HAPPEN. bare-bone has the minimum
        // logic needed for ANY code file:
        //   - IdentityAccess (every file with statics needs accessors)
        //   - CoreLogic (the actual work)
        //   - FreeFunctions (module-level public API)
        //
        // BODY sections vary wildly by form — library has 7,
        // executable has 3, demo-test has 9. bare-bone captures
        // the 3 that ALL forms share.

        "BODY": {
            "summary": "3 active subsections + Reserved Omission. The universal logic sections shared by all forms.",
            "reserved_omission": true,

            "why": "BODY is where things HAPPEN. bare-bone includes only the 3 sections that appear in EVERY form: IdentityAccess (runtime access to compile-time identity — universal because every OmniCode file has PRAGMA/METADATA statics), CoreLogic (the file's actual work — universal because every file DOES something), FreeFunctions (module-level functions — universal because every file has top-level API). Everything else is form-specific: library gets Constructors/Queries/Output, executable gets Helpers, demo-test gets 9 test categories. Including form-specific sections in bare-bone would be declaring behavior before knowing purpose.",

            "how": {
                "working_with_constraints": "Put identity accessors in IdentityAccess, your main logic in CoreLogic, any standalone functions in FreeFunctions. When you need constructors, trait impls, queries, or test categories — that is your signal to promote to the appropriate declared form.",
                "promotion_workflow": [
                    "1. Identify which form you're becoming (library needs Constructors, executable needs Helpers, etc.)",
                    "2. Copy the BODY section definitions from the declared form template",
                    "3. Insert them in the correct position (form-specific ordering)",
                    "4. Update Reserved Omission to reflect what was promoted",
                    "5. Update the pragma: -bare-bone → -library (or appropriate form)",
                    "6. Renumber B-sections to match the form's canonical ordering"
                ],
                "the_signal": "Needing more than 3 BODY sections IS the signal that this file has found its form."
            },

            "can": {
                "B_IdentityAccess": {
                    "tag": "IdentityAccess",
                    "status": "ACTIVE",
                    "rust_syntax": [
                        "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA }",
                        "pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA }",
                        "pub fn pragma_get(key: &str) -> Option<&'static str> { ... }",
                        "pub fn metadata_get(key: &str) -> Option<&'static str> { ... }"
                    ],
                    "purpose": "Runtime access to compile-time identity data — the bridge between METADATA statics and consumer code",
                    "why_active": "Every OmniCode file with PRAGMA/METADATA statics needs these 4 functions. They are the read-only API to identity. Universal across all forms because identity is universal.",
                    "bare_bone_content": "4 accessor functions: pragma(), metadata(), pragma_get(), metadata_get(). Exact same implementation across all forms.",
                    "content_constraints": {
                        "can_contain": [
                            "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA } — full slice accessor",
                            "pub fn pragma_get(key: &str) -> Option<&'static str> — key lookup via iter().find()",
                            "pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA } — full slice accessor",
                            "pub fn metadata_get(key: &str) -> Option<&'static str> — key lookup via iter().find()",
                            "/// doc comments with usage examples on each function",
