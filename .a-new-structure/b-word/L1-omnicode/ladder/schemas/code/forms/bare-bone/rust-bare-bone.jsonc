                "S5_TypeAliases": {
                    "position": 5,
                    "tag": "TypeAliases",
                    "status": "RESERVED",
                    "rust_syntax": "type Result<T> = std::result::Result<T, Error>;",
                    "why_reserved": "Type aliases are domain vocabulary — type Result<T> = ... saves everyone from typing the full path. But vocabulary requires a domain. bare-bone hasn't established its domain vocabulary yet. Aliases before domain understanding creates misleading shortcuts.",
                    "promoted_by": ["library", "executable", "demo-test"],
                    "promotion_signal": "You're repeating the same complex type in 3+ places — alias it"
                },

                "S8_TraitDefs": {
                    "position": 8,
                    "tag": "TraitDefs",
                    "status": "RESERVED",
                    "rust_syntax": "trait Name { fn method(&self) -> Type; }",
                    "why_reserved": "Trait definitions are contracts that BODY fulfills. bare-bone doesn't have enough logic to know what contracts it needs. Defining traits before understanding behavior creates abstractions that don't abstract anything useful. Let the code tell you what to abstract — don't guess.",
                    "promoted_by": ["library", "demo-test"],
                    "promotion_signal": "You need polymorphism — multiple types sharing a contract, or you need a plugin/extension point"
                },

                "S9_Macros": {
                    "position": 9,
                    "tag": "Macros",
                    "status": "RESERVED",
                    "rust_syntax": "macro_rules! name { ($pattern) => { expansion } }",
                    "why_reserved": "Macros are compile-time code generation — powerful but opaque. bare-bone doesn't have repeated patterns to generate code for yet. Macros before repetition is premature abstraction at the syntactic level. Wait until you've written the same pattern 3 times, then macro it.",
                    "promoted_by": ["library", "demo-test"],
                    "promotion_signal": "You're writing the same boilerplate pattern in 3+ places — codegen it"
                },

                "S10_FeatureGates": {
                    "position": 10,
                    "tag": "FeatureGates",
                    "status": "RESERVED",
                    "rust_syntax": "#[cfg(feature = \"name\")] struct ConditionalType { ... }",
                    "why_reserved": "Feature gates enable conditional compilation — what gets included in the binary depends on compile-time flags. bare-bone has exactly one configuration: all of it. Feature gates before knowing your deployment targets is premature platform awareness.",
                    "promoted_by": ["library", "executable", "demo-test"],
                    "promotion_signal": "You need platform-specific code, optional dependencies, or debug-only features"
                }
            },

            "completeness_rule": {
                "formula": "active_count + reserved_count = 10",
                "bare_bone": "4 active (S1, S3, S6, S7) + 6 reserved (S2, S4, S5, S8, S9, S10) = 10",
                "linter_check": "cws-struct validates this — if any section is neither active nor reserved, it's silently missing (error)"
            }
