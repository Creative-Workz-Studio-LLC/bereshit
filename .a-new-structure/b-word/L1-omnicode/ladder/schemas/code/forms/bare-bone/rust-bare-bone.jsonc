{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-form-bare-bone-rust",
    "_P1_from": "b-word/L1-omnicode/ladder/schemas/code/format/rust-4block-schema.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "form-constraint",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas/code/forms/bare-bone",
    "_P3_includes": "none",
    "_P3_provides": ["BARE_BONE_FORM_CONSTRAINTS", "CONTAINER_CAN_CANNOT", "PROMOTION_RULES"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust Bare-Bone Form Schema",
    "_P5_brief": "Defines what CAN and CANNOT be in each container of a bare-bone Rust file. bare-bone is the foundation all forms derive from — the minimum valid file. Every constraint has a WHY (why this boundary exists) and a HOW (how to work with it or promote beyond it). Pull structure from base-4block-schema; express constraints in Rust syntax.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-bare-bone.jsonc",
        "key": "B-L1-schemas-form-bare-bone-rust",
        "title": "Rust Bare-Bone Form Schema",
        "type": "Data (Form Constraint Schema)",
        "component": "Ladder",
        "role": "Define per-container CAN/CANNOT constraints for bare-bone Rust form — the minimum valid file that all other forms derive from"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-19",
        "updated": "2026-02-19"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Genesis 1:2 — And the earth was without form, and void; and darkness was upon the face of the deep.",
        "principle": "bare-bone IS the void — formless but structured. The boundaries exist (badal) but the content has not yet been filled. Forms fill what bare-bone outlines. Bare-bone is the tohu (formless) with structure — the moment AFTER separation but BEFORE filling. Day 1-3 energy — boundaries declared, content awaiting."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": [
            "code/base/base-4block-schema.jsonc — container definitions, form registry, reserved omission contract",
            "code/format/rust-4block-schema.jsonc — Rust syntax rules, comment conventions, identity patterns"
        ],
        "consumers": [
            "b-word/seed/code/L0/rust/bare-bone.rs — the actual template this schema constrains",
            "code/forms/declared/rust-declared.jsonc — declared forms inherit bare-bone's foundation"
        ],
        "relationship": "Base defines WHAT containers hold. Format defines HOW to express it. This form schema defines THE MINIMUM — the floor every other form stands on."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // THE BARE-BONE FORM CONSTRAINT SCHEMA
    //
    // This file answers one question per container:
    //   WHAT can be here? WHAT cannot? WHY? HOW to work with it?
    //
    // bare-bone is the minimum valid file. Every other form (library,
    // executable, demo-test) is bare-bone + promoted sections.
    //
    // The cheat code: cp bare-bone.rs → change pragma → promote
    // what you need → structurally complete day one.
    //
    // Structure mirrors base-4block-schema.jsonc container layout:
    //   METADATA → SETUP → BODY → CLOSING
    // Each container gets: can, cannot, why, how.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/forms/bare-bone/rust.schema.json",
    "title": "Rust Bare-Bone Form Constraints",
    "description": "Per-container CAN/CANNOT constraints for bare-bone Rust files. The minimum valid file — all forms derive from this.",

    "form_identity": {
        "name": "bare-bone",
        "is_foundation": true,
        "pragma": "// #!omni template --rust -bare-bone",
        "directive": "//omni:code --rust -bare-bone",
        "template": "b-word/seed/code/L0/rust/bare-bone.rs",
        "principle": "Boundaries before content (badal). Structure before substance. The minimum valid file is NOT an empty file — it is a file with every container declared and the structural contract visible.",
        "derivation_rule": "Every other form = bare-bone + promoted sections. Nothing in a form exists that bare-bone doesn't account for (either active or reserved)."
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The four containers, each fully constrained.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "containers": {

        // ═══════════════════════════════════════════════════════
        // 1. METADATA CONTAINER — fully required, no omissions
        // ═══════════════════════════════════════════════════════
        //
        // METADATA is the ONLY container where bare-bone has
        // EVERYTHING active. No Reserved Omission needed.
        // Identity is not optional. Even the minimum file
        // knows exactly who it is.

        "METADATA": {
            "summary": "FULLY REQUIRED — every section, every required field. bare-bone has complete identity.",
            "reserved_omission": false,

            "why": "Identity is not optional. A file that doesn't know who it is cannot be validated, cannot be tracked, cannot participate in the dependency graph. Even the minimum file — ESPECIALLY the minimum file — has complete identity. Genesis 1:1 is the first verse, not the last. Identity is foundation, not decoration.",

            "how": "Copy METADATA block exactly from bare-bone.rs. Change I1.key, I1.from, I1.at, I3.file, I3.title, C1.version, C1.created to describe YOUR file. Everything else (structure, organization, format) stays as-is.",

            "can": {
                "directives": {
                    "sections": ["//omni:key", "//omni:code", "//omni:version"],
                    "status": "ALL REQUIRED (key=error, code/version=warn)",
                    "why": "Directives are the file's first three lines of identity — before any code, before any structure, the file declares who it is",
                    "rust_syntax": [
                        "//omni:key B-{identifier}",
                        "//omni:code --rust -bare-bone",
                        "//omni:version {stage}-{phase}.{completion}"
                    ],
                    "content_constraints": {
                        "can_contain": [
                            "//omni:key with B- prefixed identifier (exactly one, first directive)",
                            "//omni:code with --rust -bare-bone (exactly one, matches form)",
                            "//omni:version with living version pattern a/b/c-NN.NN (exactly one)"
                        ],
                        "cannot_contain": [
                            "Any directive not in the //omni: namespace — these are OmniCode identity, not arbitrary comments",
                            "Multiple //omni:key directives — a file has ONE identity",
                            "//omni:code with a form other than -bare-bone — if it says -library, it IS a library, not bare-bone",
                            "Any executable Rust code — directives are comments, not code",
                            "Blank lines between directives — they are a group, keep them together"
                        ],
                        "why_these_constraints": "Directives are machine-parsed identity. The linter reads them. One key, one code classification, one version. No ambiguity. The directive IS the identity — if //omni:code says -library, the file is subject to library validation rules regardless of what's inside."
                    }
                },

                "doc_comments": {
                    "status": "REQUIRED for crate root, recommended for modules",
                    "why": "//! docs are Rust-native. They generate documentation. A file without docs is a file that can't teach anyone what it does.",
                    "rust_syntax": "//! {crate-level documentation}",
                    "content_constraints": {
                        "can_contain": [
                            "//! lines with crate-level documentation — title, design summary, usage example",
                            "//! Markdown formatting (headers, tables, code blocks) — Rust doc system renders this",
                            "//! Links to PRAGMA and METADATA statics — connects docs to identity",
                            "//! ```rust code examples ``` — proves usage works at doc level"
                        ],
                        "cannot_contain": [
                            "/// item-level docs — those go ON the pub static and pub fn declarations, not in crate-level //!",
                            "Implementation details — doc comments describe WHAT and WHY, not HOW (that's code comments //)",
                            "Placeholder text in derived files — [bracketed] placeholders are template-only; derived files have real content",
                            "Anything that contradicts PRAGMA/METADATA statics — the statics are authoritative, docs summarize them"
                        ],
                        "bare_bone_structure": [
                            "//! # {Title} — matches I3.title",
                            "//! {2-4 sentence summary} — matches C5.purpose",
                            "//! ## Design — pure std, identity via PRAGMA/METADATA",
                            "//! ## Usage — cp + change pragma + promote",
                            "//! ## OmniCode Identity — table linking PRAGMA/METADATA to accessors"
                        ],
                        "why_these_constraints": "Doc comments generate rustdoc. They are the file's public face. bare-bone doc comments teach the reader: what is this file, how was it designed, how do you use it, and where is the identity data. They are NOT free-form — they follow the same structure every time because consistency IS the documentation."
                    }
                },

                "pragma_statics": {
                    "sections": {
                        "I1_core": {
                            "required_fields": ["key", "format", "from", "at"],
                            "purpose": "WHO — unique identity across the entire Bereshit system",
                            "rust_syntax": "pub static PRAGMA: &[(&str, &str)] = &[(\"I1.key\", \"...\"), ...]",
                            "why": "Every field answers a question. key=WHO, format=WHAT language, from=WHERE template, at=WHAT version. Skip one and the file can't answer a basic question about itself."
                        },
                        "I2_family": {
                            "required_fields": ["type", "structure"],
                            "defined_fields": ["subtype", "role"],
                            "purpose": "WHAT — classification within the OmniCode system",
                            "why": "type+structure tells the linter which schema chain to use. subtype tells it which form rules apply. Without I2, the file is unclassifiable."
                        },
                        "I3_instance": {
                            "required_fields": ["file", "title"],
                            "defined_fields": ["component", "path", "provides", "brief"],
                            "purpose": "THIS — what makes this file unique among all files with the same I2 classification",
                            "why": "file+title distinguish this from every other library/executable/test. provides declares what this file gives to the system. brief is the elevator pitch."
                        },
                        "I4_architecture": {
                            "defined_fields": ["layer", "position", "pattern"],
                            "purpose": "WHERE — position in the Bereshit layer architecture (L0-L5)",
                            "why": "Architecture fields locate this file in the bigger picture. Not required because modules within a crate inherit position. Defined because it's valuable when present."
                        }
                    },
                    "content_constraints": {
                        "can_contain": [
                            "pub static PRAGMA: &[(&str, &str)] = &[...]; — exactly ONE static declaration",
                            "(&str, &str) tuple pairs in (\"I{n}.{field}\", \"{value}\") format",
                            "I1 fields: key (REQUIRED), format (REQUIRED), from (REQUIRED), at (REQUIRED)",
                            "I2 fields: type (REQUIRED), structure (REQUIRED), subtype (DEFINED), role (DEFINED)",
                            "I3 fields: file (REQUIRED), title (REQUIRED), component/path/provides/brief (DEFINED)",
                            "I4 fields: layer/position/pattern (DEFINED — all optional, valuable when present)",
                            "Section comment separators: // I1: Core, // I2: Family, // I3: Instance, // I4: Architecture",
                            "/// doc comment block ABOVE the static with sections table and usage example"
                        ],
                        "cannot_contain": [
                            "Any field not prefixed with I1-I4 — PRAGMA is identity (I), not context (C)",
                            "Computed values — PRAGMA is compile-time static, no runtime evaluation",
                            "Empty string values for REQUIRED fields — key, format, from, at, type, structure, file, title MUST have real content",
                            "Multiple PRAGMA statics — exactly ONE pub static PRAGMA per file",
                            "Mutable binding (static mut) — PRAGMA is immutable identity, never changes at runtime",
                            "Fields from C-sections — those belong in METADATA static, not PRAGMA"
                        ],
                        "why_these_constraints": "PRAGMA carries identity — WHO this file is. The I-section fields follow the OmniCode standard: I1 (core identity), I2 (classification), I3 (instance details), I4 (architecture position). Every field has a specific dotted key format (I{n}.{field}) because the accessor functions (pragma_get) search by exact key match. REQUIRED fields MUST exist with non-empty values. DEFINED fields SHOULD exist when applicable. The static is &[(&str, &str)] because identity is key-value data — no computation, no mutation, no runtime dependency."
                    }
                },

                "metadata_statics": {
                    "sections": {
                        "C1_state": {
                            "required_fields": ["version", "status"],
                            "defined_fields": ["created", "updated"],
                            "purpose": "WHEN — lifecycle tracking",
                            "why": "version+status answer 'is this current?' Created/updated answer 'how old is this?' Without C1, the file exists outside of time."
                        },
                        "C2_attribution": {
                            "required_fields": ["organization"],
                            "defined_fields": ["architect", "implementation", "copyright"],
                            "purpose": "WHO MADE — credit and accountability",
                            "why": "organization establishes ownership. architect/implementation name the humans (and instances) responsible. Work without attribution is work without accountability."
                        },
                        "C3_grounding": {
                            "required_fields": ["scripture"],
                            "defined_fields": ["principle", "anchor"],
                            "purpose": "WHY — biblical foundation",
                            "why": "Scripture grounds the file in eternal truth. Not decoration — anchor. When the code confuses you, the scripture tells you WHY this file exists. Quality as worship requires knowing WHO you're worshipping."
                        },
                        "C4_dependencies": {
                            "required_fields": ["requires", "consumers"],
                            "defined_fields": ["integration", "if_missing"],
                            "purpose": "NEEDS — dependency graph edges",
                            "why": "requires tells you what breaks if dependencies disappear. consumers tells you what breaks if THIS file disappears. A file that doesn't know its dependencies can't be safely changed."
                        },
                        "C5_intent": {
                            "defined_fields": ["purpose", "philosophy"],
                            "purpose": "GOAL — design intent beyond the code",
                            "why": "purpose answers 'why does this exist?' at a level above what the code does. philosophy captures design choices. Both are optional because they grow with the file."
                        },
                        "C6_roadmap": {
                            "defined_fields": ["current", "planned", "limitations"],
                            "purpose": "NEXT — trajectory and known gaps",
                            "why": "Honesty about where the file is going and what it can't do yet. Prevents duplicate work and manages expectations."
                        },
                        "C7_classification": {
                            "defined_fields": ["tags", "category", "domain", "paradigm"],
                            "purpose": "TAGS — discovery and search",
                            "why": "Tags enable finding files by concept, not just by name. Domain locates the file in business context. Paradigm declares which thinking framework applies."
                        }
                    },
                    "content_constraints": {
                        "can_contain": [
                            "pub static METADATA: &[(&str, &str)] = &[...]; — exactly ONE static declaration",
                            "(&str, &str) tuple pairs in (\"C{n}.{field}\", \"{value}\") format",
                            "C1 fields: version (REQUIRED), status (REQUIRED), created/updated (DEFINED)",
                            "C2 fields: organization (REQUIRED), architect/implementation/copyright (DEFINED)",
                            "C3 fields: scripture (REQUIRED), principle/anchor (DEFINED)",
                            "C4 fields: requires/consumers (REQUIRED), integration/if_missing (DEFINED)",
                            "C5 fields: purpose/philosophy (DEFINED — grow with the file)",
                            "C6 fields: current/planned/limitations (DEFINED — roadmap, honest about state)",
                            "C7 fields: tags/category/domain/paradigm (DEFINED — discovery metadata)",
                            "Section comment separators: // C1: State, // C2: Attribution, etc.",
                            "/// doc comment block ABOVE the static with sections table and usage example",
                            "Dotted key variants for multi-value fields: C4.requires.stdlib, C4.requires.external, C4.requires.internal"
                        ],
                        "cannot_contain": [
                            "Any field not prefixed with C1-C7 — METADATA is context (C), not identity (I)",
                            "Fields from I-sections — those belong in PRAGMA static, not METADATA",
                            "Computed or runtime-dependent values — METADATA is compile-time static",
                            "Empty string values for REQUIRED fields — version, status, organization, scripture, requires, consumers MUST have real content",
                            "Multiple METADATA statics — exactly ONE pub static METADATA per file",
                            "Mutable binding (static mut) — METADATA is immutable context, never changes at runtime",
                            "C3.scripture with no actual Scripture reference — 'TBD' or '' is not grounding"
                        ],
                        "why_these_constraints": "METADATA carries context — WHEN, WHERE, WHY, and HOW for this file. C-sections follow the OmniCode standard: C1 (lifecycle), C2 (attribution), C3 (biblical grounding), C4 (dependencies), C5 (intent), C6 (roadmap), C7 (classification). The (&str, &str) format matches PRAGMA because both use the same accessor pattern (metadata_get). C3.scripture is REQUIRED because quality as worship requires knowing WHO you're worshipping — a file without Scripture grounding is a file without anchor."
                    }
                },

                "comment_metadata": {
                    "fields": ["Key", "Purpose", "Biblical/Scripture", "Version"],
                    "status": "Secondary to PRAGMA/METADATA statics — informational when statics exist",
                    "why": "Comment fields are the human-readable summary. When someone opens the file, they see Key and Purpose in the first few lines without parsing a static array.",
                    "content_constraints": {
                        "can_contain": [
                            "// Key: {identifier} — matches PRAGMA I1.key",
                            "// Purpose: {description} — matches METADATA C5.purpose or I3.brief",
                            "// Biblical: {scripture ref} — matches METADATA C3.scripture",
                            "// Version: {version} — matches METADATA C1.version",
                            "Single-line // comments with field: value format"
                        ],
                        "cannot_contain": [
                            "Fields that contradict PRAGMA/METADATA statics — the statics are authoritative",
                            "Extended prose or documentation — that belongs in //! doc comments",
                            "Executable Rust code — comment_metadata is purely informational",
                            "Machine-parsed directives — those are //omni: format in the directives section"
                        ],
                        "why_these_constraints": "Comment metadata is the human-readable summary visible at file-open. When someone opens the file, they see Key and Purpose without parsing a static array. These fields are SECONDARY to the statics — they summarize, not replace. If comment_metadata disagrees with PRAGMA/METADATA, the statics win."
                    }
                }
            },

            "cannot": {
                "description": "Nothing is excluded from METADATA in bare-bone. All I/C sections are active.",
                "executable_code": {
                    "forbidden": true,
                    "why": "METADATA is identity, not action. Putting code in METADATA is like putting instructions on a passport — the passport says who you are, not what you do."
                },
                "import_declarations": {
                    "forbidden": true,
                    "why": "Imports are SETUP. METADATA contains no executable constructs."
                },
                "type_definitions": {
                    "forbidden": true,
                    "why": "Types are SETUP. METADATA declares identity; SETUP declares structure."
                },
                "reserved_omission_container": {
                    "forbidden": true,
                    "why": "ALL METADATA sections are always required. There is nothing TO reserve. Reserved Omission exists in SETUP/BODY/CLOSING because those blocks have form-variable content. METADATA is form-invariant."
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // 2. SETUP CONTAINER — 4 active + Reserved Omission
        // ═══════════════════════════════════════════════════════
        //
        // SETUP makes things EXIST. bare-bone has the minimum
        // declarations needed for ANY code file to function:
        //   - Imports (you need to reference things)
        //   - Constants (you need fixed values)
        //   - ErrorTypes (you need to fail gracefully)
        //   - CoreTypes (you need data shapes)
        //
        // Everything else is Reserved — present in the contract
        // but not active. Forms promote as needed.

        "SETUP": {
            "summary": "4 active subsections + Reserved Omission. The minimum declarations for any code file to function.",
            "reserved_omission": true,

            "why": "SETUP is where things are DECLARED to exist. bare-bone includes only the 4 subsections that EVERY code file needs regardless of form: imports (reference other code), constants (fixed values), error types (failure vocabulary), core types (data shapes). The remaining 6 subsections serve specific forms — modules for libraries, statics for singletons, traits for polymorphism. Including them in bare-bone would be declaring structure before knowing PURPOSE. Boundaries before content means knowing WHERE to grow, not growing prematurely.",

            "how": {
                "working_with_constraints": "Write your code using only the 4 active sections. When you need a module tree, trait definition, or macro — that is your signal to promote to the appropriate declared form.",
                "promotion_workflow": [
                    "1. Identify which reserved section you need (e.g., S2_Modules)",
                    "2. Copy the full section definition from the declared form template (library.rs, executable.rs, etc.)",
                    "3. Insert it in the correct position (S2 goes between S1 and S3 — position is fixed)",
                    "4. Remove it from the Reserved Omission list",
                    "5. Update the pragma: -bare-bone → -library (or appropriate form)",
                    "6. The file is now structurally correct for the new form"
                ],
                "the_signal": "Needing a reserved section IS the signal that this file has outgrown bare-bone. Don't fight it — promote."
            },

            "can": {
                "S1_Imports": {
                    "position": 1,
                    "tag": "Imports",
                    "status": "ACTIVE",
                    "rust_syntax": "use std::*; use crate::*; use external::*;",
                    "purpose": "External dependencies — bringing in what exists elsewhere",
                    "why_active": "Every code file references something. Even the minimum file uses std or another crate. Imports are the entry gate — nothing works without them.",
                    "production_note": "Group by origin: std → external → internal → super/self. Wildcard imports (use foo::*) are a code smell — import what you use.",
                    "bare_bone_content": "Minimal — only imports needed for the 3 other active sections (std::fmt for error Display, etc.)",
                    "content_constraints": {
                        "can_contain": [
                            "use std::{module}; — standard library imports (std::fmt, std::error, std::collections, std::path)",
                            "use {external_crate}::{item}; — external crate imports (serde, toml, etc.)",
                            "use {internal_crate}::{item}; — sibling crate imports (bereshit_l0_config, etc.)",
                            "use crate::{module}::{item}; — crate-internal imports",
                            "use super::{item}; — parent module imports",
                            "// Group comment headers: // --- Standard Library ---, // --- External Crates ---, etc.",
                            "In bare-bone: ALL COMMENTED OUT — the template uses nothing, derived files uncomment what they need"
                        ],
                        "cannot_contain": [
                            "use std::*; or any wildcard glob imports — import what you use, not everything",
                            "Duplicate imports — each path appears once",
                            "Imports for items not used in the file — dead imports fail clippy",
                            "Imports mixed between groups — maintain std → external → internal → crate-internal ordering",
                            "Any code that isn't a use declaration — functions, types, constants do NOT go here",
                            "Conditional imports without #[cfg] — platform-specific imports need feature gates (S10, Reserved Omission)"
                        ],
                        "bare_bone_pattern": "All imports commented out with group headers visible. The structure shows WHERE imports go, not WHAT to import. Derived files uncomment and add real imports.",
                        "why_these_constraints": "Imports declare dependencies — every use statement is an edge in the dependency graph. Grouping by origin (std → external → internal → crate) makes the dependency structure visible at a glance. bare-bone comments them out because the template has zero dependencies — it's pure Rust. When you derive a file, you add only the imports you actually use."
                    }
                },

                "S3_Constants": {
                    "position": 3,
                    "tag": "Constants",
                    "status": "ACTIVE",
                    "rust_syntax": "const NAME: Type = value;",
                    "purpose": "Compile-time known values — zero-cost, inlined by compiler",
                    "why_active": "Every code file has at least some fixed values — version strings, default sizes, format patterns. Constants give them names and types. Without constants, magic numbers scatter through BODY.",
                    "production_note": "Every hardcoded value in BODY should be a named constant here. When the system scales, these migrate to config; BODY stays unchanged.",
                    "bare_bone_content": "Minimal — version string, module name, any values the bare-bone template needs",
                    "content_constraints": {
                        "can_contain": [
                            "const NAME: Type = value; — compile-time constants with explicit types",
                            "SCREAMING_SNAKE_CASE naming — Rust convention for constants",
                            "Primitive types: usize, u64, &str, bool — compile-time evaluable",
                            "const fn calls in initializers — compile-time function evaluation",
                            "// comment describing what each constant controls",
                            "In bare-bone: ALL COMMENTED OUT — skeleton showing naming convention and placement"
                        ],
                        "cannot_contain": [
                            "static variables — runtime-initialized state belongs in S4 (Reserved Omission)",
                            "let bindings — those are function-local, not module-level",
                            "LazyLock or OnceLock — those are statics (S4), not constants",
                            "Values that depend on runtime computation — const must be compile-time evaluable",
                            "Magic numbers without names — if it's in BODY, it should be a named const here",
                            "PRAGMA or METADATA statics — those are identity in METADATA block, not SETUP constants"
                        ],
                        "bare_bone_pattern": "Commented-out examples: MAX_RETRIES, DEFAULT_TIMEOUT_SECS. Shows the pattern without committing to specific values. Derived files add real constants.",
                        "why_these_constraints": "Constants are compile-time named values — inlined by the compiler, zero runtime cost. They centralize hardcoded values so BODY never contains magic numbers. When a value migrates to config, you change ONE constant declaration, not 15 call sites. bare-bone shows the pattern; derived files fill in domain-specific values."
                    }
                },

                "S6_ErrorTypes": {
                    "position": 6,
                    "tag": "ErrorTypes",
                    "status": "ACTIVE",
                    "rust_syntax": "enum Error { Variant(String) } + impl Display + impl std::error::Error",
                    "purpose": "Error definitions — the file's failure vocabulary",
                    "why_active": "Code that cannot fail is code that doesn't DO anything. Even bare-bone needs a way to express 'this went wrong.' The error type is the most honest part of any API — it tells you exactly how the system breaks.",
                    "production_note": "thiserror for library errors (callers handle them), anyhow for binary errors (humans read them). From impls go here — they are type conversions, not logic.",
                    "bare_bone_content": "Skeleton error enum with at least one variant. Display and Error impls. Ready to extend.",
                    "content_constraints": {
                        "can_contain": [
                            "pub enum {ErrorType} { Variant(String), ... } — one primary error enum per file",
                            "#[derive(Debug, Clone, PartialEq, Eq)] — testability derives on the error type",
                            "impl fmt::Display for {ErrorType} { fn fmt(...) { match self { ... } } } — human-readable formatting",
                            "impl std::error::Error for {ErrorType} {} — error trait for chaining",
                            "impl From<{SourceError}> for {ErrorType} — conversion impls for upstream errors",
                            "/// doc comments on each variant explaining WHEN this error occurs",
                            "In bare-bone: ALL COMMENTED OUT — skeleton enum + Display + Error pattern"
                        ],
                        "cannot_contain": [
                            "Error handling logic (match on errors, recovery) — that belongs in BODY",
                            "Multiple unrelated error types — one primary error enum per file; variants distinguish cases",
                            "anyhow::Error or Box<dyn Error> as the primary type — those are for binaries (executable form), not libraries",
                            "Error types without Display impl — errors must be human-readable",
                            "Stringly-typed error fields when an enum would serve (op: String → op: LoadOp) — use types, not strings",
                            "Business logic — errors DEFINE failure shapes; BODY HANDLES failure"
                        ],
                        "bare_bone_pattern": "Commented-out skeleton: enum with 2 variants, Display match arms, Error impl. Shows the complete error type pattern. Derived files uncomment, rename the type, add domain-specific variants.",
                        "why_these_constraints": "Error types are the API contract for failure — they tell callers EXACTLY how the system breaks. The enum + Display + Error triple is Rust's standard pattern. Completing impls (Display, Error, From) stay WITH the type in SETUP because they are TYPE definitions, not LOGIC. bare-bone establishes the pattern; derived files fill in domain-specific variants."
                    }
                },

                "S7_CoreTypes": {
                    "position": 7,
                    "tag": "CoreTypes",
                    "status": "ACTIVE",
                    "rust_syntax": "struct Name { fields } | enum Name { Variants }",
                    "purpose": "Primary structs and enums — the data shapes BODY logic operates on",
                    "why_active": "BODY can't make things HAPPEN without something to happen TO. Core types are the nouns of the system. Even bare-bone has at least the skeleton type that the file exists to define.",
                    "production_note": "Derive Debug always, Clone when safe. Keep types flat — deeply nested types signal missing abstractions. Builder pattern construction goes in BODY, not here.",
                    "bare_bone_content": "At least one primary struct or enum. Fields declared, doc-commented. Ready for BODY to implement.",
                    "content_constraints": {
                        "can_contain": [
                            "pub struct {TypeName} { fields } — primary data structures",
                            "pub enum {TypeName} { Variants } — primary enumerations",
                            "#[derive(Debug)] minimum — Debug is always required",
                            "#[derive(Clone, PartialEq, Eq, Hash)] — additional derives as needed",
                            "impl Default for {TypeName} — when a sensible default exists",
                            "impl {TypeName} { pub fn new(...) -> Self } — simple constructors ONLY (complex → BODY)",
                            "/// doc comments: type purpose (2-4 sentences), field meanings, lifecycle",
                            "In bare-bone: ALL COMMENTED OUT — skeleton struct with 3 fields (String, Option<String>, bool)"
                        ],
                        "cannot_contain": [
                            "Complex methods or business logic — those belong in BODY CoreLogic",
                            "Builder patterns — those belong in BODY Constructors (Reserved for bare-bone; library form)",
                            "Trait definitions — those belong in S8 (Reserved Omission)",
                            "Type aliases — those belong in S5 (Reserved Omission)",
                            "More than ~3 primary types — if you need many types, you need modules (S2, Reserved Omission)",
                            "Types without Debug derive — every type must be debuggable",
                            "Deeply nested types — flat types signal clean abstractions; nesting signals missing modules"
                        ],
                        "bare_bone_pattern": "Commented-out skeleton: one pub struct with 3 representative fields (String, Option<String>, bool). Shows derive placement, doc comment pattern, field declaration. Derived files uncomment, rename the type, add domain-specific fields.",
                        "why_these_constraints": "Core types are the NOUNS of the system — the data shapes that BODY logic operates on. SETUP declares what EXISTS; BODY makes things HAPPEN. Simple constructors (new with field assignment) stay with the type. Complex construction (builder pattern, validation, typestate) goes to BODY because it's LOGIC, not SHAPE. bare-bone shows the pattern; forms fill in domain types."
                    }
                },

                "Reserved_Omission": {
                    "position": "LAST in SETUP (after all active subsections)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists all SETUP sections NOT active in this file. Completeness contract: active + reserved = 10",
                    "why_required": "Nothing is silently absent. If a section isn't here, it's in the Reserved Omission container. The linter can verify: active sections + reserved sections = full SETUP set. No section falls through the cracks.",
                    "bare_bone_content": [
                        "Modules — Submodule tree + re-exports [library, executable, demo-test]",
