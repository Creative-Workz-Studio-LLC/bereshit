                    "tag": "Statics",
                    "status": "RESERVED",
                    "rust_syntax": "static NAME: LazyLock<Type> = LazyLock::new(|| { ... });",
                    "why_reserved": "Statics are process-wide shared state — connection pools, compiled regexes, cached config. bare-bone doesn't have process-wide concerns yet. Statics before design is premature optimization. PRAGMA/METADATA statics (identity) live in METADATA, not here.",
                    "promoted_by": ["library", "executable", "demo-test"],
                    "promotion_signal": "You need process-wide shared state (connection pools, compiled regexes, caches)"
