        // ═══════════════════════════════════════════════════════
        // 4. CLOSING CONTAINER — 6 active + Reserved Omission
        // ═══════════════════════════════════════════════════════
        //
        // CLOSING is the accountability block. bare-bone has:
        //   Code zones: Cv (tests), Ce (entry point)
        //   Doc sections: X1 (policy), X4 (reference), X5 (note), X6 (template)
        //
        // Reserved: Cc (cleanup), TestCoverageSummary, X2, X3
        //
        // Reserved Omission sits between code zones and doc
        // sections — after Ce, before X1. This preserves the
        // canonical ordering: code → reserved → documentation.

        "CLOSING": {
            "summary": "6 active sections + Reserved Omission. Tests, entry point, core documentation.",
            "reserved_omission": true,

            "why": "CLOSING proves the code works and guides maintainers. bare-bone includes the 2 code zones that every file needs (Cv for tests — every file should be tested; Ce for entry point — every file needs a way to start) and the 4 documentation sections that form the structural minimum (X1 policy — modification guidelines are ALWAYS needed; X4 reference — related files are ALWAYS useful; X5 note — the closing scripture anchor is ALWAYS required; X6 template — instantiation guide for templates). The 4 reserved sections serve specific forms or optional depth — Cc (cleanup) only matters when there are resources to clean up, TestCoverageSummary only matters for test files with coverage data, X2 (extension) and X3 (troubleshooting) are valuable but not structurally required.",

            "how": {
                "working_with_constraints": "Write tests in Cv, entry point in Ce (or leave empty for libraries). Write policy in X1, references in X4, closing anchor in X5. Reserved sections go in the Reserved Omission container between Ce and X1.",
                "promotion_workflow": [
                    "1. Identify which reserved section you need (e.g., Cc for Drop impls)",
                    "2. Copy from the declared form template",
                    "3. Insert in correct position (Cc goes after Ce; X2 goes after X1; X3 goes after X2)",
                    "4. Remove from Reserved Omission list",
                    "5. The ordering is ALWAYS: Cv → Ce → [Cc] → [Reserved] → X1 → [X2] → [X3] → X4 → X5 → [X6]"
                ],
                "reserved_omission_position": "Between last code zone (Ce or Cc if promoted) and first doc section (X1). This preserves code → reserved → documentation ordering."
            },

            "can": {
                "code_zones": {
                    "description": "Actual executable Rust code. Always precede documentation sections.",

                    "Cv_Validation": {
                        "position": 1,
                        "tag": "Cv",
                        "status": "ACTIVE",
                        "rust_syntax": "#[cfg(test)] mod tests { use super::*; #[test] fn test_name() { ... } }",
                        "purpose": "Inline tests — prove the code works",
                        "why_active": "Tests are accountability. Code without tests is claims without evidence. Even bare-bone MUST have tests — at minimum, identity verification (PRAGMA/METADATA fields correct) and basic type construction.",
                        "bare_bone_content": "Skeleton #[cfg(test)] mod tests with identity verification tests and basic type construction tests. At least 2-3 tests to prove the file is alive.",
                        "form_specific_content": {
                            "library": "White-box tests with use super::* — organized by BODY subsections",
                            "executable": "Exit code mapping tests, error display tests, identity verification",
                            "demo_test": "Meta-validation — tests that verify test infrastructure itself"
                        },
                        "content_constraints": {
                            "can_contain": [
                                "#[cfg(test)] mod tests { use super::*; ... } — exactly one test module",
                                "#[test] fn test_name() { ... } — individual test functions",
                                "use super::*; — white-box access to all private items in this file",
                                "// -- Section Name ---- comment headers organizing tests by BODY concern",
                                "assert!(), assert_eq!(), assert_ne!() — standard assertion macros",
                                "assert!(matches!(val, Pattern)) — pattern matching assertions",
                                "#[should_panic(expected = \"msg\")] — panic verification tests",
                                "fn test_name() -> Result<(), ErrorType> — fallible tests with ? operator",
                                "In bare-bone: COMMENTED OUT — identity tests (pragma/metadata access) + core logic stubs"
                            ],
                            "cannot_contain": [
                                "Tests for Reserved Omission sections — you can't test what doesn't exist yet",
                                "Integration tests (those go in tests/ directory, not inline)",
                                "Test helpers complex enough to be their own module — extract to test_utils.rs",
                                "Shared mutable state between tests — each test is independent",
                                "Tests with ordering dependencies — tests run in any order",
                                "#[cfg(test)] mod tests blocks outside CLOSING Cv — Cv is THE test location",
                                "More than one mod tests block — exactly one, in Cv"
                            ],
                            "bare_bone_pattern": "Commented-out #[cfg(test)] mod tests with: (1) Identity tests — pragma_get returns correct key, pragma_get returns correct format, pragma_get returns None for missing, metadata_get returns scripture. (2) Core Logic stub — comment placeholder. (3) Error Display stub — commented-out error formatting test.",
                            "why_these_constraints": "Cv is accountability — code without tests is claims without evidence. Tests live in CLOSING (not BODY) because they VALIDATE what BODY creates. The #[cfg(test)] gate excludes tests from release builds. bare-bone provides identity tests because EVERY file has identity statics to verify. Form-specific tests are added when form-specific logic exists."
                        }
                    },

                    "Ce_Execution": {
                        "position": 2,
                        "tag": "Ce",
                        "status": "ACTIVE",
                        "purpose": "Entry point, init, registration — the code that starts execution",
                        "why_active": "Every file has a way to START. For libraries, Ce is empty (no entry point). For executables, Ce holds main() + exit_code(). For demo-tests, Ce is empty (cargo test is the harness). Ce exists in bare-bone because the ZONE exists — even when the content is empty, the structural slot is declared.",
                        "bare_bone_content": "Empty section marker — bare-bone doesn't know if it's a library (no entry point) or executable (main()) yet. The slot is present; the content awaits form.",
                        "form_specific_content": {
                            "library": "Empty — libraries have no entry point",
                            "executable": "exit_code() + main() — thin entry delegating to run() (BODY)",
                            "demo_test": "Empty — cargo test is the harness"
                        },
                        "content_constraints": {
                            "can_contain": [
                                "In bare-bone: EMPTY SECTION — just the section header comment",
                                "For library form: empty (libraries have no entry point)",
                                "For executable form: fn exit_code() -> i32 + fn main() { ... }",
                                "For demo-test form: empty (cargo test is the harness)",
                                "Section comment explaining WHY Ce is empty for this form"
                            ],
                            "cannot_contain": [
                                "Business logic — main() should be thin, delegating to BODY run() or similar",
                                "Error handling beyond exit code mapping — complex error handling goes in BODY",
                                "Library initialization code — registration is a pub API in BODY FreeFunctions, not automatic",
                                "Tests — tests are Cv, not Ce",
                                "Cleanup logic — cleanup is Cc (Reserved Omission)"
                            ],
                            "bare_bone_pattern": "Section header comment only. Explains that libraries have no entry point, executables use main()+exit_code(), and bare-bone doesn't know its form yet. The slot exists; the content awaits form commitment.",
                            "why_these_constraints": "Ce is where execution STARTS — but only executables have an entry point. Libraries are used, not run. Demo-tests are harnessed by cargo test. bare-bone can't commit to an entry point without knowing its form. The empty section is honest: 'I exist as a structural slot, but I have nothing to execute yet.'"
                        }
                    }
                },

                "documentation_sections": {
                    "description": "Guidance for humans. Always follow code zones.",

                    "X1_Policy": {
                        "tag": "X1",
                        "status": "ACTIVE",
                        "purpose": "Modification guidelines — never/careful/safe classification",
                        "why_active": "EVERY file needs modification guidelines. What breaks if you change this? What is safe to change? X1 is the maintenance manual. Without it, every change is a gamble.",
                        "required_fields": ["never", "careful", "safe"],
                        "defined_fields": ["scripture"],
                        "bare_bone_content": "Skeleton never/careful/safe lists appropriate for the file's current minimal state. Updated as the file grows.",
                        "content_constraints": {
                            "can_contain": [
                                "// Safe to Modify: — list of changes that add capability without breaking contracts",
                                "// Modify with Care: — list of changes that affect interfaces dependents rely on",
                                "// Never Modify: — list of changes that break the foundation",
                                "// Opening scripture quote — Proverbs 22:28 (boundary stone) or similar",
                                "// Explanatory paragraph connecting the metaphor to the policy",
                                "Bullet lists under each category with specific, actionable guidance"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X1 is documentation comments only",
                                "Vague guidance ('be careful') — each item must name the specific thing and WHY",
                                "Contradictions with the block structure (e.g., saying BODY can go before SETUP)",
                                "Guidance about files OTHER than this one — X1 is about THIS file's modification policy"
                            ],
                            "bare_bone_pattern": "Three-tier policy: Safe (add free functions, add error variants, add trait impls, add tests, promote from Reserved Omission), Careful (struct fields, method signatures, error type shape, return types), Never (4-block structure, PRAGMA/METADATA layout, block boundaries, public trait contracts). Each item explains the consequence.",
                            "why_these_constraints": "X1 is the maintenance manual — it tells future developers what breaks if they change things. The three-tier (safe/careful/never) structure gives clear guidance without requiring understanding of the full architecture. 'Never' items are structural invariants. 'Careful' items affect downstream consumers. 'Safe' items are additive by nature."
                        }
                    },

                    "X4_Reference": {
                        "tag": "X4",
                        "status": "ACTIVE",
                        "purpose": "Related files, dependencies, validation commands",
                        "why_active": "No file exists in isolation. X4 tells you where to look next — sibling files, upstream templates, validation commands. Navigation in a codebase is faster than reading from scratch.",
                        "bare_bone_content": "Links to: parent template (bare-bone.rs), base schema, format schema, linter",
                        "content_constraints": {
                            "can_contain": [
                                "// Dependencies: — std modules used (std::fmt, std::error, etc.)",
                                "// Dependents: — crates that depend on this one",
                                "// Supersedes: — prior implementation path if this replaced something",
                                "// Parallel: — Go/C implementations of the same concept",
                                "// Template: — source template path (bare-bone.rs for all Rust files)",
                                "// Validation: — cargo build/test/clippy/doc commands for this crate",
                                "Comment-only reference data — no executable code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X4 is documentation comments only",
                                "Outdated or incorrect dependency information — keep in sync with Cargo.toml",
                                "Validation commands for other crates — only THIS crate's commands",
                                "Internal implementation details — X4 is navigation, not architecture explanation"
                            ],
                            "bare_bone_pattern": "Five reference categories (Dependencies, Dependents, Supersedes, Parallel, Template) with placeholder values. Validation section with 5 cargo commands (build, test, clippy, doc, all-in-one). Derived files fill in real values.",
                            "why_these_constraints": "X4 is the navigation map — it tells you where to look next. Dependencies point upstream, Dependents point downstream, Parallel points sideways (other languages). Validation commands are copy-paste ready. The goal: open this file, read X4, know the full context without searching."
                        }
                    },

                    "X5_Note": {
                        "tag": "X5",
                        "status": "ACTIVE",
                        "purpose": "Closing scripture anchor — grounds the file in eternal truth",
                        "why_active": "The closing anchor. X5 is REQUIRED because every file in this system is grounded in Scripture. Not as decoration — as anchor. The last thing you read in the file is the truth that outlasts the code. C3 (METADATA) opens with Scripture; X5 closes with it. Bookends.",
                        "required_fields": ["note", "scripture"],
                        "defined_fields": ["anchor"],
                        "bare_bone_content": "A note summarizing the file's purpose + a closing scripture + an anchor phrase. The file's last word is eternal.",
                        "content_constraints": {
                            "can_contain": [
                                "// Opening scripture quote — Psalm 127:1 or file-appropriate closing scripture",
                                "// 2-4 sentence reflection connecting the scripture to the file's purpose",
                                "// The closing anchor — the file's last word is eternal truth",
                                "Comment-only — poetry and theology, not code"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X5 is the closing meditation, not logic",
                                "Technical documentation — architecture details go in //! doc comments or X1/X4",
                                "Placeholder scripture ('TBD', '[insert verse]') — derived files must have real scripture",
                                "Scripture disconnected from the file's purpose — the verse should GROUND the work"
                            ],
                            "bare_bone_pattern": "Psalm 127:1 quote ('Unless Yahweh builds the house...'), 3-sentence reflection connecting the house/foundation metaphor to bare-bone's role as foundation template.",
                            "why_these_constraints": "X5 bookends C3 (METADATA grounding) — the file opens with Scripture (C3) and closes with Scripture (X5). This is not decoration. The first thing you see is WHO you're building for (C3). The last thing you see is WHY it matters (X5). Every file in the system is grounded in eternal truth. Quality as worship. The code will change; the truth won't."
                        }
                    },

                    "X6_Template": {
                        "tag": "X6",
                        "status": "ACTIVE (template-only)",
                        "purpose": "Instantiation guide — remove when copying from template",
                        "why_active": "bare-bone IS a template. X6 guides the person copying it — what to change, what to keep. When the copy is made, X6 is removed. In derived files, this section doesn't exist.",
                        "bare_bone_content": "Step-by-step instantiation: (1) copy, (2) change pragma, (3) update I/C values, (4) fill sections, (5) remove X6",
                        "content_constraints": {
                            "can_contain": [
                                "// Instantiation: — numbered step-by-step guide (12 steps in bare-bone)",
                                "// Steps covering: copy, pragma change, identity update, section promotion, validation",
                                "// Form variant reference — which forms exist and how they relate to bare-bone",
                                "Comment-only — guidance for the person copying this template"
                            ],
                            "cannot_contain": [
                                "Executable Rust code — X6 is documentation comments only",
                                "In derived (non-template) files — X6 is removed when instantiating (step 11 of the guide)",
                                "References to sections that don't exist in this file — guide what's HERE",
                                "Ambiguous instructions — each step must be specific and actionable"
                            ],
                            "bare_bone_pattern": "12-step instantiation guide: (1) cp, (2) change pragma, (3) update meta, (4) fill PRAGMA I1-I4, (5) fill METADATA C1-C7, (6) promote Reserved Omission, (7) implement BODY, (8) uncomment tests, (9) create Cargo.toml, (10) add to workspace, (11) remove X6 and placeholders, (12) run cargo clippy+test.",
                            "why_these_constraints": "X6 is template-only — it exists in templates and ONLY in templates. When you cp bare-bone.rs, the LAST step is removing X6. It's self-erasing guidance: follow these steps, then delete the steps. Derived files should NEVER have X6 because its presence means 'I am still a template, not a real file.'"
                        }
                    }
                },

                "Reserved_Omission": {
                    "position": "Between code zones (Cv/Ce) and documentation sections (X1-X6)",
                    "status": "STRUCTURAL — required container",
                    "purpose": "Lists CLOSING sections NOT active in this file",
                    "why_required": "Completeness contract. active + reserved = full CLOSING set. Nothing silently absent.",
                    "bare_bone_content": [
                        "Cc — Closing Cleanup: Drop impls, resource deallocation [library, executable, demo-test]",
                        "Test Coverage Summary — Coverage data, assertions summary [demo-test]",
                        "X2 — Extension: Designed growth points, planned features [all forms]",
                        "X3 — Troubleshooting: Common problems and solutions [all forms]"
                    ]
                }
            },

            "cannot": {
                "description": "These 4 sections CANNOT be active in bare-bone. They must be in Reserved Omission.",

                "Cc_Cleanup": {
                    "tag": "Cc",
                    "status": "RESERVED",
                    "rust_syntax": "impl Drop for Type { fn drop(&mut self) { /* cleanup */ } }",
                    "why_reserved": "Cc is for resource deallocation — Drop impls, temp file cleanup, connection closing. bare-bone doesn't have resources to clean up yet. No resources = no cleanup needed. RAII (Rust's ownership model) handles most cleanup automatically. Cc is for the exceptions — explicit teardown that RAII can't handle.",
                    "promoted_by": ["library", "executable", "demo-test"],
                    "promotion_signal": "You have resources that need explicit cleanup (file handles, network connections, temp dirs)"
                },

                "TestCoverageSummary": {
                    "status": "RESERVED",
                    "why_reserved": "Test coverage summaries belong in demo-test form files — they document assertion counts, coverage percentage, and tested vs untested APIs. bare-bone has minimal tests (2-3), making a coverage summary premature.",
                    "promoted_by": ["demo-test"],
                    "promotion_signal": "You have 10+ tests and need to track coverage metrics"
                },

                "X2_Extension": {
                    "tag": "X2",
                    "status": "RESERVED",
                    "why_reserved": "Extension documents DESIGNED growth points — where the file SHOULD grow. bare-bone is itself the growth point for everything. Documenting future features of a minimum file is circular — everything is future when you're at minimum.",
                    "promoted_by": ["library", "executable", "demo-test"],
                    "promotion_signal": "You have a clear roadmap of planned features that consumers should know about"
                },

                "X3_Troubleshooting": {
                    "tag": "X3",
                    "status": "RESERVED",
                    "why_reserved": "Troubleshooting documents KNOWN problems and solutions. bare-bone doesn't have enough complexity to generate known problems. Troubleshooting a skeleton is troubleshooting structure, not behavior — and structure troubleshooting belongs in the schema, not the file.",
                    "promoted_by": ["library", "executable", "demo-test"],
                    "promotion_signal": "Users are hitting recurring issues that need documented solutions"
                }
            },

            "ordering_rule": {
                "canonical": "Cv → Ce → [Cc if promoted] → Reserved Omission → X1 → [X2 if promoted] → [X3 if promoted] → X4 → X5 → [X6 if template]",
                "principle": "Code zones FIRST (they do real work), then reserved (they mark potential), then documentation (they guide future work)",
                "bare_bone_order": "Cv → Ce → Reserved Omission → X1 → X4 → X5 → X6"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════
    // CROSS-CONTAINER RULES
    // ═══════════════════════════════════════════════════════════

    "cross_container_rules": {

        "completeness_contract": {
            "description": "Every section in the OmniCode 4-block system is either ACTIVE or RESERVED. Nothing is silently absent.",
            "formula": "Per container: active_count + reserved_count = container_maximum",
            "bare_bone_totals": {
                "METADATA": { "active": "ALL", "reserved": 0, "note": "No Reserved Omission — all sections required" },
                "SETUP": { "active": 4, "reserved": 6, "total": 10 },
                "BODY": { "active": 3, "reserved": 14, "note": "14 = library(4) + executable(1) + demo-test(9)" },
                "CLOSING": { "active": 6, "reserved": 4, "total": 10 }
            }
        },

        "promotion_is_form_transition": {
            "description": "Promoting a section is NOT just adding code. It is transitioning the file from bare-bone to a specific form.",
            "rule": "When you promote ANY section from Reserved Omission, update the pragma to reflect the new form. A file with Constructors is not a bare-bone — it's a library.",
            "exception": "Some sections are promoted by ALL forms (Modules, FeatureGates). Promoting these still requires choosing a form."
        },

        "the_cheat_code": {
            "workflow": "cp bare-bone.rs my-library.rs → change -bare-bone to -library → promote library sections → done",
            "why_it_works": "bare-bone already has every container, every structural marker, every identity field. The ONLY thing that changes when promoting is which sections are active vs reserved. Structure stays. Identity updates. Content fills.",
            "badal_principle": "Boundaries before content. bare-bone is all boundaries. Forms fill them."
        },

        "bare_bone_is_not_empty": {
            "description": "bare-bone is the MINIMUM VALID file, not the EMPTY file",
            "what_it_has": [
                "Complete METADATA (every I/C section, every required field)",
                "4 SETUP subsections with skeleton content",
                "3 BODY subsections with skeleton impl blocks",
                "2 code zones + 4 doc sections in CLOSING",
                "Reserved Omission containers in SETUP, BODY, CLOSING",
                "All structural markers (block boundaries, subsection headers, end markers)"
            ],
            "what_it_doesnt_have": [
                "Form-specific sections (they are in Reserved Omission)",
                "Deep implementation (skeleton only)",
                "Production logic (placeholder/todo bodies)",
                "Tests beyond basic identity verification"
            ]
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "cws-struct lint rust <bare-bone-file> — should show only bare-bone active sections",
    "_Cv_expected_state": "All container constraints above accurately reflect the actual bare-bone.rs template at b-word/seed/code/L0/rust/bare-bone.rs",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "And the earth was without form, and void. — Genesis 1:2",
    "_X1_never": [
        "Remove a CAN section from bare-bone (bare-bone defines the minimum — reducing the minimum breaks all derived forms)",
        "Add a form-specific section to bare-bone CAN (that section belongs in the declared form, not the foundation)",
        "Remove Reserved Omission from any container (the completeness contract is structural)",
        "Change bare-bone METADATA to be less than fully required (identity is never optional)"
    ],
    "_X1_careful": [
        "Adding a new universal section to bare-bone CAN (cascades to ALL forms — every form inherits bare-bone's floor)",
        "Changing a WHY explanation (the reasoning must stay accurate as the system evolves)",
        "Changing bare-bone_content descriptions (they must match the actual bare-bone.rs template)",
        "Modifying promotion signals (they guide developers in choosing when to transition forms)"
    ],
    "_X1_safe": [
        "Adding detail to HOW sections (more guidance never hurts)",
        "Adding production_note fields to CAN sections",
        "Updating bare_bone_content to match template improvements",
        "Adding new form-specific reserved sections (extending, not changing)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "schemas/code/base/base-4block-schema.jsonc — Container definitions, form registry, reserved omission contract",
        "schemas/code/format/rust-4block-schema.jsonc — Rust format rules this form constrains",
        "schemas/code/forms/declared/rust-declared.jsonc — Declared forms: library, executable, demo-test",
        "b-word/seed/code/L0/rust/bare-bone.rs — The actual template this schema constrains",
        "b-word/seed/code/L0/rust/library.rs — Library declared form",
        "b-word/seed/code/L0/rust/executable.rs — Executable declared form",
        "b-word/seed/code/L0/rust/demo-test.rs — Demo-test declared form",
        "c-tov/cws-struct/lib/handlers/rust.ts — Runtime linter"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "bare-bone is the void with structure — tohu (formless) with badal (boundaries). Genesis 1:2 describes the earth before filling: without form, and void. Not nothing — potential. The waters are there. The deep is there. The Spirit moves. bare-bone is that moment — every container declared, every structural marker present, every identity field filled. Nothing is missing. Nothing is filled. The form is latent, waiting for the day of filling. When you cp bare-bone.rs and change the pragma, you are performing Day 4-6 — filling what Days 1-3 separated. The cheat code works because the boundaries are already in place.",
    "_X5_scripture": "And the earth was without form, and void; and darkness was upon the face of the deep. And the Spirit of God moved upon the face of the waters. — Genesis 1:2",
    "_X5_anchor": "bare-bone is the structured void. Forms fill it. The Spirit moves over what has been bounded.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
