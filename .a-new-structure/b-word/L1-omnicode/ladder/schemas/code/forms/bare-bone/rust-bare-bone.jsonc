            "form_comparison": {
                "note": "BODY section counts vary dramatically by form. This shows what bare-bone BECOMES when promoted.",
                "bare_bone": { "active": 3, "reserved": 14, "ordering": "universal" },
                "library": { "active": 7, "ordering": "type_lifecycle" },
