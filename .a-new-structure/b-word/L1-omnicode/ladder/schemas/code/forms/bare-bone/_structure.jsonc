    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-structure-molded-bare-bone",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "form-structure-schema",
    "_P2_role": "structure-molded",
    "_P5_title": "Bare-Bone Form Structure — The Blueprint",
    "_P5_brief": "Format-agnostic structural definition of bare-bone form. The absolute minimum valid file — foundation all forms derive from. Defines which sections are active and which are reserved. cp bare-bone → change pragma → promote what you need → structurally complete day one.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "form": {
        "name": "bare-bone",
        "extends": "structure/whole/4-block.jsonc",
        "is_foundation": true,
        "purpose": "Absolute minimum valid file — foundation all forms derive from",

        "principle": "bare-bone is the blueprint. Forms are the houses. The cheat code: cp bare-bone → change pragma → promote sections → structurally complete before a single line of real code. Boundaries before content (badal).",

        "SETUP": {
            "active": ["Imports", "Constants", "ErrorTypes", "CoreTypes"],
            "reserved": ["Modules", "Statics", "TypeAliases", "TraitDefs", "Macros", "FeatureGates"],
            "reserved_omission_required": true,
            "active_count": 4,
            "reserved_count": 6,
            "total": 10,
            "note": "4 required sections establish the minimum: what you depend on (Imports), what's fixed (Constants), what can go wrong (ErrorTypes), what exists (CoreTypes). The other 6 are structurally present as Reserved Omission entries."
        },

        "BODY": {
            "active": ["IdentityAccess", "CoreLogic", "FreeFunctions"],
            "reserved": ["Helpers", "TraitImplementations", "Constructors", "Queries", "Output", "ConstructorTests", "BuilderTests", "TransitionTests", "QueryTests", "IdentityTests", "ErrorTests", "EdgeCaseTests", "TableDrivenTests", "IntegrationTests"],
            "reserved_omission_required": true,
            "active_count": 3,
            "reserved_count": 14,
            "total": 17,
            "ordering": "unpositioned — bare-bone doesn't specify ordering principle",
            "note": "3 universal sections: identity access (who am I at runtime), core logic (what I do), free functions (public API). All other BODY sections are form-specific."
        },

        "CLOSING": {
            "active": ["Cv", "Ce", "X1", "X4", "X5", "X6"],
            "reserved": ["Cc", "TestCoverageSummary", "X2", "X3"],
            "reserved_omission_required": true,
            "active_count": 6,
            "reserved_count": 4,
            "total": 10,
            "note": "Cv (tests) + Ce (entry) are always present structurally. X1 (policy) + X4 (references) + X5 (note) + X6 (template guide) provide the documentation minimum. Cc/X2/X3 are promoted by forms."
        },

        "derivation_rule": "All forms derive from bare-bone by PROMOTING reserved sections to active. active_sections(form) = active_sections(bare-bone) + promoted_sections. The completeness contract: active + reserved = bare-bone total."
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "bare-bone is the minimum pattern shown on the mountain. Before a single line of real code, the file is structurally complete. This is badal — boundaries before content. God separated before He filled. bare-bone separates before forms fill.",
    "_X5_scripture": "Look that thou make them after their pattern, which was shewed thee in the mount. — Exodus 25:40"
}
