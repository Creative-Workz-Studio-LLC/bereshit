    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-content-setup-code-generation",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "content-character-schema",
    "_P2_role": "content-section",
    "_P5_title": "SETUP.CodeGeneration Content Character — What Code Generation Content IS",
    "_P5_brief": "Format-independent definition of code generation content character. Code generation directives invoke external tooling to produce source code at build time. Unlike macros (language-native metaprogramming), code generation is tool-driven — directives trigger external processes whose output becomes compilable source.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "character": {
        "name": "code-generation",
        "block": "SETUP",
        "position": 14,
        "nature": "meta-directive",

        "description": "Code generation content consists of directives that instruct external tools to produce source code. This is meta-level content — instructions about code, not code itself. The directives trigger processes (code generators, mock generators, serialization tools) whose output is compilable source committed alongside the directive. Code generation differs from macros: macros are language-native pattern expansion; code generation invokes external tooling.",

        "invariants": {
            "description": "Properties true of ALL code generation content, regardless of language.",

            "directive": "Code generation content is instructions to tools, not instructions to compilers. The directive says 'run this tool'; the tool produces the actual code.",
            "external": "The generation process happens outside the normal compilation pipeline. An external tool reads the directive, generates source files, and those files are then compiled normally.",
            "reproducible": "Running the same directive against the same source must produce identical output. Code generation must be deterministic — no random, no timestamp, no environment-dependent output.",
            "committed": "Generated output is typically committed to version control alongside the directive. The generated code is part of the source tree, not a build artifact.",
            "thin": "Directives themselves are minimal — a comment line or annotation, not substantial code. The complexity lives in the tool, not the directive."
        },

        "content_forms": {
            "description": "What code generation content looks like across languages. The directive syntax varies; the tool-invocation pattern is invariant.",

            "rust": {
                "syntax": "// In build.rs: tonic_build::compile_protos(\"proto/service.proto\");  // In source: include!(concat!(env!(\"OUT_DIR\"), \"/service.rs\"));",
                "grouping": "Build script (build.rs) directives grouped by tool. In-source include! for generated files. Proc macro derive attributes (#[derive(Serialize)]) are borderline — language-native but tool-driven.",
                "notes": "Rust code generation primarily happens in build.rs (build scripts) with include! to pull generated code into source. Proc macro derives blur the line between macros and code generation. prost/tonic for protobuf, serde for serialization."
            },

            "go": {
                "syntax": "//go:generate stringer -type=State  //go:generate mockgen -source=reader.go -destination=mock_reader_test.go  //go:generate protoc --go_out=. service.proto",
                "grouping": "go:generate directives grouped by tool. One directive per line. Placed near the types or interfaces they generate from.",
                "notes": "Go's //go:generate is the canonical example — comment directives that invoke external tools via 'go generate ./...'. Output files are committed. Common tools: stringer, mockgen, protoc-gen-go, sqlc."
            },

            "c": {
                "syntax": "// Code generation typically handled in Makefile or CMake, not in-source directives. /* Generated by protoc-c from service.proto — DO NOT EDIT */",
                "grouping": "Generation rules in build system (Makefile targets, CMake custom commands). Generated files marked with DO NOT EDIT headers.",
                "notes": "C has no in-source generation directive. Code generation is build-system-driven — Makefile rules, CMake add_custom_command, or shell scripts. Generated files include provenance headers. lex/yacc for parser generation."
            }
        },

        "transpilation_role": {
            "description": "During transpilation, code generation directives change tool invocations but preserve the generated output shape. The same protobuf schema generates equivalent code in every language — only the tool and output syntax change.",
            "invariant": ["source schema (what the tool reads — proto files, interface definitions, type declarations)", "generated output purpose (what the generated code does)", "generation trigger (when generation runs — build time)"],
            "variable": ["directive syntax (//go:generate vs build.rs vs Makefile)", "tool invocation (stringer vs derive macro vs custom script)", "output format (language-specific generated code)", "placement (in-source vs build script vs build system)"]
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — code generation is meta-level, not pattern-level.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Code generation directives are instructions to tools, not to compilers. They sit at the meta-level — code about code. The directive is small; the output it triggers can be vast. Stewardship of generation means keeping directives minimal and output reproducible.",
    "_X5_scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
}
