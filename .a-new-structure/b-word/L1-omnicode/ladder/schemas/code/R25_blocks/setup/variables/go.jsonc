{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-setup-variables",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "SETUP Section 3: Variables -- Go Content",
    "_P5_brief": "Go-specific content rules for Variables. Package-level mutable state: sentinel errors, registries, sync primitives, lazy singletons. Go's equivalent of Rust statics. Extends the base structure at blocks/setup/statics.jsonc.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/setup/statics.jsonc",
    "format": "go",

    "content": {

        // -----------------------------------------
        // Go-specific CAN
        // -----------------------------------------

        "can": [
            {
                "construct": "var ErrName = errors.New(\"message\")",
                "description": "Sentinel errors -- package-level error values for comparison with errors.Is()",
                "patterns": [
                    "var ErrNotFound = errors.New(\"not found\")",
                    "var ErrInvalid = errors.New(\"invalid input\")",
                    "var ErrTimeout = errors.New(\"operation timed out\")"
                ],
                "visibility": "Exported (Err prefix) for package API errors, unexported for internal",
                "note": "Sentinel errors are the bridge between S3 Variables and S5 ErrorTypes. Simple comparison errors here; structured error types with fields in S5."
            },
            {
                "construct": "var name sync.Once / sync.Mutex / sync.Map",
                "description": "Synchronization primitives for concurrent access to package-level state",
                "patterns": [
                    "var initOnce sync.Once",
                    "var registryMu sync.RWMutex",
                    "var registry = make(map[string]Handler)"
                ],
                "visibility": "unexported typically -- sync primitives are internal implementation details"
            },
            {
                "construct": "var ( ... ) block",
                "description": "Grouped variables -- related package-level state declared together",
                "patterns": [
                    "var (\n\tregistry   = make(map[string]Handler)\n\tregistryMu sync.RWMutex\n)",
                    "var (\n\tErrNotFound = errors.New(\"not found\")\n\tErrInvalid  = errors.New(\"invalid\")\n)"
                ],
                "visibility": "varies"
            },
            {
                "construct": "// Comment explaining WHY this needs package-level lifetime",
                "description": "Every package-level var should justify its existence -- why not a const or local variable?",
                "patterns": [
                    "// Compiled regex -- too expensive to recompile per call.",
                    "// Registry -- shared across all handlers, protected by registryMu."
                ],
                "visibility": "N/A"
            }
        ],

        // -----------------------------------------
        // Go-specific CANNOT
        // -----------------------------------------

        "cannot": [
            {
                "construct": "mutable package vars without sync protection",
                "reason": "Package-level mutable state accessed from multiple goroutines requires sync primitives. Race conditions in production are silent until catastrophic.",
                "defer_to": "N/A -- add sync.Mutex/sync.RWMutex",
                "go_signal": "N/A -- detected by go test -race"
            },
            {
                "construct": "Pragma / Metadata identity vars",
                "reason": "Identity variables live in METADATA block, not SETUP variables",
                "defer_to": "METADATA",
                "go_signal": "Pragma|Metadata.*\\[\\]\\[2\\]string"
            },
            {
                "construct": "const values in var blocks",
                "reason": "Compile-time-known values belong in S2 Constants, not runtime variables",
                "defer_to": "SETUP.Constants",
                "go_signal": "^var\\s+\\w+\\s*=\\s*(\"[^\"]*\"|\\d+|true|false)$"
            },
            {
                "construct": "complex initialization logic",
                "reason": "Variables with complex initialization belong in init() (BODY) or constructor functions. var blocks should be simple assignments.",
                "defer_to": "BODY or CLOSING.Ce (init())",
                "go_signal": "N/A -- design judgment"
            }
        ],

        // -----------------------------------------
        // Go-specific Defer Signals
        // -----------------------------------------

        "defer_signals": [
            {
                "pattern": "^const\\s+",
                "to": "SETUP.Constants",
                "confidence": "high",
                "why": "Compile-time constant, not runtime variable"
            },
            {
                "pattern": "^func\\s+",
                "to": "BODY",
                "confidence": "high",
                "why": "Function definition in variables section"
            },
            {
                "pattern": "^type\\s+",
                "to": "SETUP.CoreTypes or SETUP.ErrorTypes",
                "confidence": "high",
                "why": "Type definition in variables section"
            }
        ],

        // -----------------------------------------
        // Code Generation Templates
        // -----------------------------------------

        "scaffold": {
            "empty_library": "// Sentinel errors.\nvar (\n\tErrNotFound = errors.New(\"not found\")\n)",
            "empty_executable": "// No package-level variables needed.",
            "comment_skeleton": "// var (\n// \tErrNotFound = errors.New(\"not found\")\n// )"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Go Variables: package-level mutable state. Sentinel errors for comparison, sync primitives for concurrent access, registries for shared state. Every var must justify why a const or local would not suffice. In production, prefer sync primitives -- parallel test execution creates race conditions without them.",
    "_X5_scripture": "Hebrews 13:8 -- Jesus Christ the same yesterday, and to day, and for ever."
}
