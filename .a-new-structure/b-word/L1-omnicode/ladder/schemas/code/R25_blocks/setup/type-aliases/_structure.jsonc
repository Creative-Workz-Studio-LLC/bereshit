    "section": {
        "tag": "TypeAliases",
        "position": 5,
        "label": "Type Aliases",
        "block": "SETUP",
        "overview_text": "Shorthand for complex signatures",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "vocabulary shortcuts",
                "description": "Named aliases that simplify complex type expressions",
                "distinguisher": "A short name for a long truth. Makes the complex readable."
            },
            {
                "concept": "domain-specific naming",
                "description": "Giving generic types domain meaning through aliasing",
                "distinguisher": "Result<T> becomes ParseResult<T>. The alias carries domain intent."
            }
        ],

        "cannot": [
            {
                "concept": "new type definitions",
                "reason": "Aliases rename; they don't create new structure",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "single-use aliases",
                "reason": "If only used once, the alias adds indirection without value",
                "defer_to": "Use the type directly"
            },
            {
                "concept": "error types",
                "reason": "Error types have their own section with Display/Error impls",
                "defer_to": "SETUP.ErrorTypes"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Type Aliases",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton has nothing complex to alias). AVAILABLE in all declared forms — use when complex types appear 3+ times."
        }
    },

    "concept_map": {
