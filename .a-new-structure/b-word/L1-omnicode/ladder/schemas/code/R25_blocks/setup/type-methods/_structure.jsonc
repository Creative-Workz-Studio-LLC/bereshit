    "section": {
        "tag": "TypeMethods",
        "position": 13,
        "label": "Type Methods",
        "block": "SETUP",
        "overview_text": "Structural completers (identity methods, not capability)",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "structural completers",
                "description": "Methods that complete a type's identity — removing them makes the type incomplete",
                "distinguisher": "Error(), String(), MarshalJSON(). The type is incomplete without these."
            },
            {
                "concept": "interface satisfaction checks",
                "description": "Compile-time assertions that types satisfy interfaces",
                "distinguisher": "Catches missing method implementations at compile time, not runtime."
            }
        ],

        "cannot": [
            {
                "concept": "business logic methods",
                "reason": "Methods that add CAPABILITY belong in BODY. TypeMethods are structural COMPLETERS.",
                "defer_to": "BODY.CoreOperations"
            },
            {
                "concept": "getter/setter methods",
                "reason": "Accessor patterns add capability, not identity",
                "defer_to": "BODY.CoreOperations"
            },
            {
                "concept": "methods with side effects",
                "reason": "Side-effectful methods are business logic, not type completion",
                "defer_to": "BODY.CoreOperations"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Type Methods",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton has no types to complete). AVAILABLE in module/library/executable/demo-test — use when types need structural completion."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
