    "_P5_title": "SETUP Section 12: Interface Definitions — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Interface Definitions IS, not how it manifests in any language. See format/blocks/{lang}/setup/interface-defs.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "InterfaceDefs",
        "position": 12,
        "label": "Interface Definitions",
        "block": "SETUP",
        "overview_text": "Behavioral contracts (shape, not fulfillment)",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "behavioral contracts",
                "description": "Interfaces defining what types CAN do without specifying HOW",
                "distinguisher": "The shape of behavior. The promise, not the delivery."
            },
            {
                "concept": "interface composition",
                "description": "Building contracts from smaller contracts via embedding",
                "distinguisher": "Small interfaces composed into larger ones. Composability over monoliths."
            }
        ],

        "cannot": [
            {
                "concept": "interface implementations",
                "reason": "Defining the contract and fulfilling it are separate concerns",
                "defer_to": "BODY.CoreOperations"
            },
            {
                "concept": "concrete business logic",
                "reason": "Interfaces define shape; concrete logic is BODY's domain",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "type definitions",
                "reason": "Interfaces are about behavior; types are about data structure",
                "defer_to": "SETUP.CoreTypes"
            }
        ],

        "defer": [
            {
                "signal": "more than ~3 interfaces in one file",
                "to": "Consider a dedicated interfaces module",
                "why": "Many interfaces signal this file has multiple behavioral concerns"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Interface Definitions",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton doesn't define contracts). AVAILABLE in module/library/executable/demo-test — use when behavioral contracts are needed."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

