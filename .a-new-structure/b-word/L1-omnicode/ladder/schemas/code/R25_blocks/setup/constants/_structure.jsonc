    "_P5_title": "SETUP Section 3: Constants — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Constants IS, not how it manifests in any language. See format/blocks/{lang}/setup/constants.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Constants",
        "position": 3,
        "label": "Constants",
        "block": "SETUP",
        "overview_text": "Compile-time fixed values",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "compile-time fixed values",
                "description": "Values known at compile time that never change at runtime",
                "distinguisher": "The immutable truth of this file. Known before execution begins."
            },
            {
                "concept": "named magic numbers",
                "description": "Replacing hardcoded values with meaningful names",
                "distinguisher": "Every number has a name. Every string has a reason."
            },
            {
                "concept": "configuration defaults",
                "description": "Default values for parameters when no override is provided",
                "distinguisher": "The baseline. What the system assumes when nothing is specified."
            }
        ],

        "cannot": [
            {
                "concept": "runtime-initialized values",
                "reason": "Values needing runtime computation are statics, not constants",
                "defer_to": "SETUP.Statics"
            },
            {
                "concept": "type definitions",
                "reason": "Types describe shape; constants describe fixed values",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "mutable variables",
                "reason": "Constants are by definition immutable. Mutable state is runtime behavior.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "identity statics (PRAGMA/METADATA)",
                "reason": "Identity declarations live in METADATA block, not SETUP",
                "defer_to": "METADATA"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Constants",
            "reserved_reason": null,
            "note": "Constants is REQUIRED in all forms. Every file has at least domain defaults."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "granted",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
