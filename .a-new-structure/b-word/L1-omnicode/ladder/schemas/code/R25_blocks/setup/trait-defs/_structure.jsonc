    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-setup-trait-defs",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "SETUP Section 8: Trait Definitions — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Trait Definitions IS, not how it manifests in any language. See format/blocks/{lang}/setup/trait-defs.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "TraitDefs",
        "position": 8,
        "label": "Trait Definitions",
        "block": "SETUP",
        "overview_text": "Behavioral contracts (shape, not fulfillment)",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "behavioral contracts",
                "description": "Interfaces/traits defining what types CAN do without specifying HOW",
                "distinguisher": "The shape of behavior. The promise, not the delivery."
            },
            {
                "concept": "default implementations",
                "description": "Sensible defaults that implementors can override",
                "distinguisher": "The common case built in. Override when the common case doesn't fit."
            }
        ],

        "cannot": [
            {
                "concept": "behavioral trait implementations",
                "reason": "Defining the contract and fulfilling it are separate concerns. EXCEPTION: completing impls (Display, Default, Error, From, Clone, PartialEq) stay WITH their type in §6-§7 — they complete the type's existence.",
                "defer_to": "BODY.TraitImplementations (behavioral impls) or SETUP.CoreTypes/ErrorTypes (completing impls)"
            },
            {
                "concept": "concrete business logic",
                "reason": "Traits define shape; concrete logic is BODY's domain",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "type definitions",
                "reason": "Traits are about behavior; types are about data structure",
                "defer_to": "SETUP.CoreTypes"
            }
        ],

        "defer": [
            {
                "signal": "more than ~3 traits in one file",
                "to": "Consider a dedicated traits module",
                "why": "Many traits signal this file has multiple behavioral concerns"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Trait Definitions",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton doesn't define contracts). AVAILABLE in module/library/executable/demo-test — use when behavioral contracts are needed."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "defer",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 0.91,
    "_weight_rationale": "|avg| of concept_map: 1F 10D. −10/11 ≈ −0.91. method_call defers (traits define method signatures).",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Trait definitions are promises. SETUP says 'this behavior is possible.' BODY says 'here is how.'",
    "_X5_scripture": "2 Timothy 2:13 — If we believe not, yet he abideth faithful: he cannot deny himself."
}
