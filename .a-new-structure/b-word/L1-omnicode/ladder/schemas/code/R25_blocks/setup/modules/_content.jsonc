        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — no code patterns in module declarations.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
