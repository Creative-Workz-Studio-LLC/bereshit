{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-setup-core-types",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "SETUP Section 7: Core Types — Rust Content",
    "_P5_brief": "Rust-specific content rules for Core Types. What Rust code CAN, CANNOT, and SHOULD DEFER within this section. Extends the base structure at blocks/setup/core-types.jsonc.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/setup/core-types.jsonc",
    "format": "rust",

    "content": {

        // ─────────────────────────────────────
        // Rust-specific CAN
        // ─────────────────────────────────────

        "can": [
            {
                "construct": "pub struct {TypeName} { fields... }",
                "description": "Primary data structures with domain-specific fields",
                "patterns": [
                    "pub struct Config {\n    pub path: PathBuf,\n    pub values: HashMap<String, Value>,\n}",
                    "pub(crate) struct InternalState {\n    buffer: Vec<u8>,\n    position: usize,\n}"
                ],
                "visibility": "pub for library API types, pub(crate) for module-internal types"
            },
            {
                "construct": "pub enum {TypeName} { Variant, ... }",
                "description": "Domain enumerations — finite sets of states or categories",
                "patterns": [
                    "pub enum Format { Toml, Json, Yaml }",
                    "pub enum Status { Pending, Active, Complete }"
                ],
                "visibility": "pub for library API, pub(crate) for internal"
            },
            {
                "construct": "#[derive(Debug)] minimum + additional derives",
                "description": "Derive macros — Debug always, others as needed for the type's usage",
                "patterns": [
                    "#[derive(Debug)]",
                    "#[derive(Debug, Clone, PartialEq, Eq)]",
                    "#[derive(Debug, Clone, PartialEq, Eq, Hash)]",
                    "#[derive(Debug, Serialize, Deserialize)]"
                ],
                "note": "Debug is minimum. Clone/PartialEq/Eq for testability. Serialize/Deserialize when crossing serialization boundaries. Hash when used as map keys."
            },
            {
                "construct": "impl Default for {TypeName}",
                "description": "Default construction when a sensible default exists",
                "patterns": [
                    "impl Default for Config {\n    fn default() -> Self {\n        Self { path: PathBuf::new(), values: HashMap::new() }\n    }\n}"
                ],
                "note": "Only when a sensible default exists. If default is meaningless, omit."
            },
            {
                "construct": "impl {Type} { pub fn new(...) -> Self }",
                "description": "SIMPLE constructors only — assigns fields, no validation, no logic",
                "patterns": [
                    "impl Config {\n    pub fn new(path: PathBuf) -> Self {\n        Self { path, values: HashMap::new() }\n    }\n}"
                ],
                "note": "Field assignment only. Any validation, fallible creation, or builder pattern goes to BODY.Constructors (B3)."
            },
            {
                "construct": "/// doc comments on every public type and field",
                "description": "What the type represents, field purposes, lifecycle expectations",
                "patterns": [
                    "/// Configuration loaded from a TOML file.\n///\n/// # Fields\n/// - `path`: Source file location\n/// - `values`: Parsed key-value pairs"
                ],
                "visibility": "N/A — doc comments, not code"
            }
        ],

        // ─────────────────────────────────────
        // Rust-specific CANNOT
        // ─────────────────────────────────────

        "cannot": [
            {
                "construct": "complex constructors (validation, fallible creation)",
                "reason": "Constructors with validation (try_new, from_config) belong in BODY B3",
                "defer_to": "BODY.Constructors",
                "rust_signal": "fn\\s+(try_new|from_|build).*->\\s*Result"
            },
            {
                "construct": "builder patterns",
                "reason": "Builder types and builder methods are construction logic, not type declaration",
                "defer_to": "BODY.Constructors",
                "rust_signal": "Builder|fn\\s+\\w+\\(mut\\s+self"
            },
            {
                "construct": "business logic methods (impl Type { fn operate... })",
                "reason": "Methods that operate on instances belong in BODY B4 CoreLogic",
                "defer_to": "BODY.CoreLogic",
                "rust_signal": "fn\\s+\\w+\\(&(mut\\s+)?self.*->.*Result|fn\\s+\\w+\\(&(mut\\s+)?self"
            },
            {
                "construct": "trait definitions (pub trait ...)",
                "reason": "Behavioral contracts belong in SETUP S8 TraitDefs",
                "defer_to": "SETUP.TraitDefs",
                "rust_signal": "^(pub\\s+)?trait\\s+"
            },
            {
                "construct": "error types (error enums, Display/Error impls)",
                "reason": "Error types have their own dedicated section S6",
                "defer_to": "SETUP.ErrorTypes",
                "rust_signal": "Error|impl\\s+fmt::Display|impl\\s+std::error::Error"
            }
        ],

        // ─────────────────────────────────────
        // Rust-specific Defer Signals
        // ─────────────────────────────────────

        "defer_signals": [
            {
                "pattern": "fn\\s+(?:try_new|from_\\w+|build)\\s*\\(",
                "to": "BODY.Constructors",
                "confidence": "high",
                "why": "Fallible/named constructor — belongs in BODY B3"
            },
            {
                "pattern": "fn\\s+\\w+\\(&(mut\\s+)?self",
                "to": "BODY.CoreLogic or BODY.Queries",
                "confidence": "medium",
                "why": "Instance method — belongs in BODY (CoreLogic if &mut self, Queries if &self read-only)"
            },
            {
                "pattern": "^(pub\\s+)?trait\\s+",
                "to": "SETUP.TraitDefs",
                "confidence": "high",
                "why": "Trait definition — behavioral contract, not data type"
            },
            {
                "pattern": "impl\\s+\\w+\\s+for\\s+\\w+",
                "to": "BODY.TraitImplementations",
                "confidence": "high",
                "why": "Trait implementation — belongs in BODY B2"
            }
        ],

        // ─────────────────────────────────────
        // Code Generation Templates
        // ─────────────────────────────────────

        "scaffold": {
            "empty_module": "/// TODO: Primary type for this module.\n#[derive(Debug)]\npub(crate) struct {{type_name}} {\n    // fields\n}",
            "empty_library": "/// TODO: Primary type for this crate.\n#[derive(Debug)]\npub struct {{type_name}} {\n    // fields\n}",
            "comment_skeleton": "// /// Primary type.\n// #[derive(Debug)]\n// pub struct TypeName {\n//     // fields\n// }"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust Core Types: the NOUNS of the codebase. Structs and enums declare shapes. SETUP defines what things ARE; BODY defines what they DO. Simple new() stays here; anything with logic moves to BODY.",
    "_X5_scripture": "Genesis 2:19 — And whatsoever Adam called every living creature, that was the name thereof."
}