{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-closing-execution",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Execution (Ce) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Execution IS, not how it manifests in any language. See format/blocks/{lang}/closing/execution.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Ce",
        "position": 2,
        "label": "Execution",
        "block": "CLOSING",
        "zone": "code",
        "overview_text": "Entry point or absence",

        "header": {
            "section_comment": "// Ce — Execution",
            "bracket_format": "[Ce]  Execution{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "program entry point",
                "description": "main() — where execution begins when this is a runnable program",
                "distinguisher": "The door. The OS calls main(), main() calls run(), run() does the work."
            },
            {
                "concept": "structural presence when empty",
                "description": "The section exists even when the file has no entry point",
                "distinguisher": "Libraries and modules have Ce as an empty slot — structure is form-invariant."
            }
        ],

        "cannot": [
            {
                "concept": "business logic in main",
                "reason": "main() delegates to run(). Keep it thin — error handling and exit codes only.",
                "defer_to": "BODY.CoreLogic (via run())"
            },
            {
                "concept": "test code",
                "reason": "Tests belong in Cv, not interleaved with execution",
                "defer_to": "CLOSING.Cv"
            }
        ],

        "defer": [
            {
                "signal": "file is a library or module (no main())",
                "to": "Ce remains structurally present but content-empty",
                "why": "The section header exists for structural completeness. No code inside."
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Execution",
            "reserved_reason": null,
            "note": "Ce is REQUIRED in all forms. In library/module it's empty (no entry point). In executable it contains main()."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "granted",
        "method_call": "granted",
        "self_access": "granted",
        "variable_binding": "granted",
        "conditional_if": "granted",
        "conditional_match": "granted",
        "return_value": "granted",
        "error_propagation": "granted",
        "err_wrap": "granted",
        "ok_wrap": "granted",
        "string_format": "granted"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns granted — execution entry points use any code pattern.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Execution is the door. Executables have main() here. Libraries and modules have an empty section — structurally present, content absent.",
    "_X5_scripture": "John 10:9 — I am the door: by me if any man enter in, he shall be saved."
}
