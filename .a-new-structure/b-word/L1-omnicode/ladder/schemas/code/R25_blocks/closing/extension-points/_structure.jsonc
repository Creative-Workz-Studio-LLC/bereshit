{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-closing-extension-points",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Extension Points (X2) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Extension Points IS, not how it manifests in any language. See format/blocks/{lang}/closing/extension-points.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "X2",
        "position": "X2",
        "label": "Extension Points",
        "block": "CLOSING",
        "zone": "documentation",
        "overview_text": "Where and how to extend",

        "header": {
            "section_comment": "// X2 — Extension Points",
            "bracket_format": "[X2]  Extension Points{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "designed growth points",
                "description": "Documented places where the code SHOULD grow when new needs arise",
                "distinguisher": "Intentional extensibility. Growth by design, not by accident."
            },
            {
                "concept": "planned features",
                "description": "Known future work, roadmap items, anticipated needs",
                "distinguisher": "The TODO list with architectural context. Not just what, but where."
            },
            {
                "concept": "known limitations",
                "description": "Current boundaries that may need expansion",
                "distinguisher": "Honest about what isn't done yet."
            }
        ],

        "cannot": [
            {
                "concept": "executable code",
                "reason": "X2 is documentation. Comments only.",
                "defer_to": "BODY.*"
            },
            {
                "concept": "stale items",
                "reason": "Completed features still listed as planned are lies",
                "defer_to": "Remove completed items"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Extension Points",
            "reserved_reason": "Bare-bone skeleton has no planned extensions — it IS the extension",
            "reserved_explanation": "Use when the file has documented growth points or a roadmap."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — extension points are documentation, not code.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "X2 documents where growth should happen. Intentional extensibility — the code tells you where to add, not just where to look.",
    "_X5_scripture": "Isaiah 54:2 — Enlarge the place of thy tent, and let them stretch forth the curtains of thine habitations."
}
