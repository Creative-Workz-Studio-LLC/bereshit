{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-closing-closing-note",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "CLOSING Section X5: Closing Note — Go Content",
    "_P5_brief": "Go-specific content rules for X5 (Closing Note). Domain-appropriate scripture with reflection connecting the file's purpose to eternal truth. The file's last word is the anchor.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/closing/closing-note.jsonc",
    "format": "go",

    "content": {

        "can": [
            {
                "construct": "// opening scripture quote",
                "description": "Domain-appropriate verse grounding this file's work in eternal truth",
                "patterns": [
                    "// X5 — Closing Note\n//\n// \"Whatsoever thy hand findeth to do, do it with thy might.\"\n//   — Ecclesiastes 9:10",
                    "// X5 — Closing Note\n//\n// \"In the beginning God created the heaven and the earth.\"\n//   — Genesis 1:1",
                    "// X5 — Closing Note\n//\n// \"Let all things be done decently and in order.\"\n//   — 1 Corinthians 14:40"
                ],
                "visibility": "N/A — documentation"
            },
            {
                "construct": "// 2-4 sentence reflection",
                "description": "Connecting the scripture to this file's specific purpose — the package's spiritual grounding",
                "patterns": [
                    "// This package handles configuration — finding truth in structured text.\n// Like the Bereans who searched the scriptures daily,\n// we examine every field, every value, every constraint.\n// The parser doesn't assume; it verifies.",
                    "// Identity is not decoration — it is foundation.\n// Before content, before logic, before any operation,\n// the file declares who it is. Genesis 1:1 is first,\n// not last. Identity anchors everything."
                ],
                "visibility": "N/A"
            },
            {
                "construct": "// closing anchor",
                "description": "The file's final word — connecting back to the founding truth",
                "patterns": [
                    "// Foundation declared. Identity set. The work serves the whole."
                ],
                "visibility": "N/A"
            }
        ],

        "cannot": [
            {
                "construct": "executable Go code",
                "reason": "X5 is the spiritual anchor — comments only, no code",
                "defer_to": "BODY or CLOSING Cv/Ce",
                "go_signal": "^(func|type|var|const|import)\\s+"
            },
            {
                "construct": "placeholder scripture",
                "reason": "Generic 'insert verse here' is worse than no verse. Choose a verse that connects to the file's domain.",
                "defer_to": "N/A — choose meaningful scripture",
                "go_signal": "TODO|placeholder|insert"
            },
            {
                "construct": "generic scripture disconnected from domain",
                "reason": "The verse must illuminate THIS file's specific concern. A config loader shouldn't use a verse about warfare.",
                "defer_to": "N/A — choose domain-appropriate scripture",
                "go_signal": "N/A — design judgment"
            }
        ],

        "defer_signals": [
            {
                "pattern": "^(func|type|var|const)\\s+",
                "to": "BODY or CLOSING Cv",
                "confidence": "high",
                "why": "Executable code after the closing note — belongs earlier in the file"
            }
        ],

        "scaffold": {
            "empty_library": "// X5 — Closing Note\n//\n// \"In the beginning God created the heaven and the earth.\"\n//   — Genesis 1:1\n//\n// Every package begins with identity. Every identity traces\n// to the One who created. The foundation is set.\n// Build well upon it.",
            "empty_executable": "// X5 — Closing Note\n//\n// \"Whatsoever thy hand findeth to do, do it with thy might.\"\n//   — Ecclesiastes 9:10\n//\n// This binary is the entry point — the moment where\n// intention becomes execution. Run it with excellence.\n// The work declares who made it.",
            "empty_demo_test": "// X5 — Closing Note\n//\n// \"Prove all things; hold fast that which is good.\"\n//   — 1 Thessalonians 5:21\n//\n// Tests are proof. Not bureaucracy — proof that the code\n// does what it claims. Every assertion is a claim tested.\n// Every pass is a truth verified.",
            "comment_skeleton": "// X5 — Closing Note\n// \"Scripture verse\" — Book Chapter:Verse\n// 2-4 sentence reflection connecting to this file's purpose."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Go X5 (Closing Note): the file's last word is eternal truth. Scripture chosen for the domain. Reflection connecting the file's purpose to the verse. Go files end with the anchor — the same pattern that begins with the identity pragma. Alpha and Omega.",
    "_X5_scripture": "Revelation 22:13 — I am Alpha and Omega, the beginning and the end, the first and the last."
}
