    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-closing-troubleshooting",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Troubleshooting (X3) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Troubleshooting IS, not how it manifests in any language. See format/blocks/{lang}/closing/troubleshooting.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "X3",
        "position": "X3",
        "label": "Troubleshooting",
        "block": "CLOSING",
        "zone": "documentation",
        "overview_text": "Common issues and solutions",

        "header": {
            "section_comment": "// X3 — Troubleshooting",
            "bracket_format": "[X3]  Troubleshooting{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "problem-solution pairs",
                "description": "Known issues with their resolutions — save future debugging time",
                "distinguisher": "Wisdom from experience. The mistake someone already made, and the fix."
            },
            {
                "concept": "common mistakes",
                "description": "Patterns that look right but are wrong, with correct alternatives",
                "distinguisher": "The gotchas. What bites you when you're not looking."
            }
        ],

        "cannot": [
            {
                "concept": "executable code",
                "reason": "X3 is documentation. Comments only.",
                "defer_to": "BODY.* or CLOSING.Cv"
            },
            {
                "concept": "known bugs without workarounds",
                "reason": "Documenting problems without solutions is just complaining",
                "defer_to": "Fix the bug or provide a workaround"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Troubleshooting",
            "reserved_reason": "Bare-bone skeleton has no known issues — it hasn't been used yet",
            "reserved_explanation": "Use when the file has documented gotchas or common mistakes."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — troubleshooting is documentation, not code.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "X3 saves debugging time. Every problem documented here is a problem someone won't have to rediscover.",
    "_X5_scripture": "Proverbs 27:12 — A prudent man foreseeth the evil, and hideth himself; but the simple pass on, and are punished."
