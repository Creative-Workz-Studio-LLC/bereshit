{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-closing-validation",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Validation (Cv) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Validation IS, not how it manifests in any language. See format/blocks/{lang}/closing/validation.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Cv",
        "position": 1,
        "label": "Validation",
        "block": "CLOSING",
        "zone": "code",
        "overview_text": "Tests and correctness checks",

        "header": {
            "section_comment": "// Cv — Validation",
            "bracket_format": "[Cv]  Validation{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "unit tests organized by section",
                "description": "Tests grouped by the BODY section they validate — coverage as checklist",
                "distinguisher": "Each group proves one section works. Missing group = missing coverage."
            },
            {
                "concept": "assertion-based verification",
                "description": "Concrete assertions that fail fast on incorrect behavior",
                "distinguisher": "Binary truth. The code either does what it claims or it doesn't."
            },
            {
                "concept": "edge case coverage",
                "description": "Boundary conditions, empty inputs, overflows, error paths",
                "distinguisher": "The places where bugs hide. Test the edges, not just the middle."
            }
        ],

        "cannot": [
            {
                "concept": "production logic",
                "reason": "Tests validate. They are not the thing they validate.",
                "defer_to": "BODY.*"
            },
            {
                "concept": "shared mutable state between tests",
                "reason": "Tests must be independent. Order-dependent tests are fragile lies.",
                "defer_to": "Refactor to isolated tests"
            },
            {
                "concept": "integration tests",
                "reason": "Cross-module testing belongs in a separate test directory",
                "defer_to": "tests/ directory (project level)"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Validation",
            "reserved_reason": null,
            "note": "Cv is REQUIRED in all forms. Code without tests is unverified code."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "granted",
        "method_call": "granted",
        "self_access": "granted",
        "variable_binding": "granted",
        "conditional_if": "granted",
        "conditional_match": "granted",
        "return_value": "granted",
        "error_propagation": "granted",
        "err_wrap": "granted",
        "ok_wrap": "granted",
        "string_format": "granted"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns granted — validation tests use any code pattern.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Validation is proof. BODY claims to work. Cv proves it. Every section tested, every edge case covered.",
    "_X5_scripture": "1 Thessalonians 5:21 — Prove all things; hold fast that which is good."
}
