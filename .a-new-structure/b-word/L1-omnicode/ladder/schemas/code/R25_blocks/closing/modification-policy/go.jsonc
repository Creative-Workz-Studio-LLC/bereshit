{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-closing-modification-policy",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "CLOSING Section X1: Modification Policy — Go Content",
    "_P5_brief": "Go-specific content rules for X1 (Modification Policy). Three-tier guidance: Safe, Careful, Never. Extends the base structure at blocks/closing/modification-policy.jsonc.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/closing/modification-policy.jsonc",
    "format": "go",

    "content": {

        "can": [
            {
                "construct": "// Safe to Modify: — additive changes",
                "description": "Changes that don't break existing callers or contracts",
                "patterns": [
                    "// Safe to Modify:\n//   - Add new exported functions (additive API growth)\n//   - Add new error sentinel values (errors.Is still works)\n//   - Add new interface implementations on existing types\n//   - Add new tests\n//   - Add new doc comments"
                ],
                "visibility": "N/A — documentation"
            },
            {
                "construct": "// Modify with Care: — interface-affecting changes",
                "description": "Changes that affect callers or contracts — require review",
                "patterns": [
                    "// Modify with Care:\n//   - Struct field changes (affects construction and reflection)\n//   - Method signature changes (affects all callers)\n//   - Exported → unexported (breaks external consumers)\n//   - Error type changes (affects type switches and errors.As)\n//   - Interface method additions (breaks all implementors)"
                ],
                "visibility": "N/A"
            },
            {
                "construct": "// Never Modify: — structural invariants",
                "description": "The 4-block structure, identity layout, and fundamental contracts",
                "patterns": [
                    "// Never Modify:\n//   - 4-block structure (METADATA → SETUP → BODY → CLOSING)\n//   - Pragma/Metadata identity variables (var Pragma, var Metadata)\n//   - Block boundary tags (// ════...════)\n//   - Section ordering within blocks"
                ],
                "visibility": "N/A"
            },
            {
                "construct": "// opening scripture quote",
                "description": "Scripture grounding the modification policy in wisdom",
                "patterns": [
                    "// X1 — Modification Policy\n//\n// \"Remove not the ancient landmark, which thy fathers have set.\"\n//   — Proverbs 22:28"
                ],
                "visibility": "N/A"
            },
            {
                "construct": "// visibility implications note (library form)",
                "description": "Library X1 notes that Uppercase changes affect external consumers; lowercase changes are internal",
                "patterns": [
                    "// Visibility note: lowercase (unexported) changes affect this package only.\n// Uppercase (exported) changes affect all importing packages — wider blast radius."
                ],
                "visibility": "N/A"
            }
        ],

        "cannot": [
            {
                "construct": "executable Go code",
                "reason": "X1 is documentation-only — no func, type, var, or executable code",
                "defer_to": "BODY or CLOSING Cv/Ce",
                "go_signal": "^(func|type|var|const|import)\\s+"
            },
            {
                "construct": "vague guidance",
                "reason": "\"Be careful\" is not policy. Each tier must say WHAT changes and WHY they're in that tier.",
                "defer_to": "N/A — be specific",
                "go_signal": "N/A"
            }
        ],

        "defer_signals": [
            {
                "pattern": "^(func|type|var|const)\\s+",
                "to": "BODY or CLOSING Cv",
                "confidence": "high",
                "why": "Executable code in documentation section"
            }
        ],

        "scaffold": {
            "empty_library": "// X1 — Modification Policy\n//\n// Safe to Modify:\n//   - New exported functions, error sentinels, interface impls, tests\n//\n// Modify with Care:\n//   - Struct fields, method signatures, exported → unexported\n//   - Affects: all importing packages\n//\n// Never Modify:\n//   - 4-block structure, Pragma/Metadata layout, block boundaries\n//   - Section ordering within blocks",
            "empty_executable": "// X1 — Modification Policy\n//\n// Safe to Modify:\n//   - New unexported functions, flag definitions, tests\n//\n// Modify with Care:\n//   - Exit codes, flag names, environment variable usage\n//   - Affects: scripts and CI pipelines that call this binary\n//\n// Never Modify:\n//   - 4-block structure, Pragma/Metadata layout, block boundaries\n//   - Section ordering within blocks",
            "empty_demo_test": "// X1 — Modification Policy\n//\n// Safe to Modify:\n//   - New test functions, new test helpers, table entries\n//\n// Modify with Care:\n//   - t.Helper() functions used by other tests\n//   - Test fixture setup/teardown (affects all tests)\n//\n// Never Modify:\n//   - 4-block structure, Pragma/Metadata layout, block boundaries\n//   - Section ordering within blocks",
            "comment_skeleton": "// X1 — Modification Policy\n// Safe / Careful / Never tiers"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Go X1 (Modification Policy): three-tier guidance protecting the code's contracts. Safe = additive. Careful = interface-affecting. Never = structural. Go's visibility (Uppercase/lowercase) makes the blast radius explicit in the name itself — exported changes always carry more weight.",
    "_X5_scripture": "Proverbs 22:28 — Remove not the ancient landmark, which thy fathers have set."
}
