    "_P2_role": "container-structure",
    "_P5_title": "CLOSING: Cleanup (Cc) — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Cleanup IS, not how it manifests in any language. See format/blocks/{lang}/closing/cleanup.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Cc",
        "position": 3,
        "label": "Cleanup",
        "block": "CLOSING",
        "zone": "code",
        "overview_text": "Resource teardown",

        "header": {
            "section_comment": "// Cc — Cleanup",
            "bracket_format": "[Cc]  Cleanup{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "resource deallocation",
                "description": "Explicit teardown that automatic cleanup can't handle alone",
                "distinguisher": "The goodbye. Connections closed, handles released, state persisted."
            },
            {
                "concept": "destructor implementations",
                "description": "Drop/finalize/cleanup methods for deterministic resource release",
                "distinguisher": "When the language's automatic cleanup isn't enough."
            }
        ],

        "cannot": [
            {
                "concept": "business logic",
                "reason": "Cleanup tears down. It doesn't compute or decide.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "error recovery",
                "reason": "Cleanup must be reliable. Don't panic or block indefinitely.",
                "defer_to": "Handle errors gracefully within cleanup"
            },
            {
                "concept": "new allocations",
                "reason": "Cleanup releases resources. It doesn't acquire new ones.",
                "defer_to": "BODY.Constructors"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "AVAILABLE",
            "library": "AVAILABLE",
            "executable": "AVAILABLE",
            "demo-test": "AVAILABLE"
        },

        "ro": {
            "available_label": "Cleanup",
            "reserved_reason": "Bare-bone skeleton has no resources to clean up",
            "reserved_explanation": "Use when the file manages resources that need explicit teardown beyond automatic cleanup."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "granted",
        "method_call": "granted",
