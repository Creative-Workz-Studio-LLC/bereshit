{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-closing-extension-points",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "CLOSING Section X2: Extension Points — Go Content",
    "_P5_brief": "Go-specific content rules for X2 (Extension Points). Designed growth points — where the file SHOULD grow. AVAILABLE in library and executable forms.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/closing/extension-points.jsonc",
    "format": "go",

    "content": {

        "can": [
            {
                "construct": "// Planned Features",
                "description": "Features that are designed for but not yet implemented",
                "patterns": [
                    "// X2 — Extension Points\n//\n// Planned Features:\n//   - Context-aware variant of Load() using context.Context\n//   - Caching layer for repeated config reads\n//   - Hot-reload support via fsnotify"
                ],
                "visibility": "N/A — documentation"
            },
            {
                "construct": "// Extension Points",
                "description": "Where the architecture is designed to accept new functionality",
                "patterns": [
                    "// Extension Points:\n//   - New handlers: implement Handler interface (S7), register in handlerMap (B3)\n//   - New formats: add case to format switch (S6), implement Parser for it (B2)"
                ],
                "visibility": "N/A"
            },
            {
                "construct": "// Known Limitations",
                "description": "Honest about what the current implementation doesn't handle",
                "patterns": [
                    "// Known Limitations:\n//   - No recursive config includes (single file only)\n//   - No environment variable interpolation\n//   - Max file size: 10MB (returns error above)"
                ],
                "visibility": "N/A"
            }
        ],

        "cannot": [
            {
                "construct": "executable Go code",
                "reason": "X2 is documentation — roadmap, not implementation",
                "defer_to": "BODY or CLOSING Cv/Ce",
                "go_signal": "^(func|type|var|const|import)\\s+"
            },
            {
                "construct": "stale items",
                "reason": "Extension points must be current — remove completed items, update planned ones",
                "defer_to": "N/A — maintain currency",
                "go_signal": "N/A"
            }
        ],

        "defer_signals": [
            {
                "pattern": "^(func|type|var|const)\\s+",
                "to": "BODY",
                "confidence": "high",
                "why": "Executable code in documentation section"
            }
        ],

        "scaffold": {
            "empty_library": "// X2 — Extension Points\n//\n// Planned: (none currently)\n// Extension Points: (describe where this package should grow)\n// Known Limitations: (honest about what's not handled)",
            "empty_executable": "// X2 — Extension Points\n//\n// Planned: (none currently)\n// Extension Points: (describe where this binary should grow)\n// Known Limitations: (honest about what's not handled)",
            "empty_demo_test": "// X2 — Extension Points\n//\n// Planned: (additional test scenarios)\n// Test Coverage Gaps: (areas not yet tested)",
            "comment_skeleton": "// X2 — Extension Points (document growth roadmap)"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Go X2 (Extension Points): where the code SHOULD grow. Planned features, designed extension points, known limitations. Go's interface-based extensibility makes extension points particularly clear — new implementations satisfy existing interfaces without modifying existing code.",
    "_X5_scripture": "Habakkuk 2:3 — For the vision is yet for an appointed time, but at the end it shall speak, and not lie."
}
