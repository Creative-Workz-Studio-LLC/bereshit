    "_P5_title": "Subtypes — Module Form",
    "_P5_brief": "Module form. Focused internal unit. Primarily for Rust (src/*.rs) — Go packages ARE modules, so Go rarely uses this form. Has METADATA, SETUP with imports and types, BODY with core logic, CLOSING with tests.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "module",
        "label": "Module — Internal Unit Form",
        "parent": "Subtypes",
        "I2_subtype": "module",

        "purpose": "Focused internal unit. One concern, well-bounded. Rust: src/*.rs files. Note: Go packages ARE modules — this form is primarily for Rust.",
        "distinguisher": "Internal, not public-facing. Has tests (Cv) but no public API surface. A member of the body, not the body itself.",

        "has_public_api": false,
        "has_tests_block": true,

        "language_notes": {
            "rust": "Primary consumer. src/*.rs files that are mod-declared by lib.rs. Each module is one concern.",
            "go": "Go packages ARE modules by nature. A Go file in a package is implicitly module-form. Rarely needs explicit module subtype — use library for package roots."
        },

        "section_availability": {

            "METADATA": {
                "Directives":      "REQUIRED",
                "CommentBlock":    "REQUIRED",
                "DocComments":     "AVAILABLE",
                "PragmaIdentity":  "REQUIRED",
                "MetadataContext":  "REQUIRED",
                "Subtypes":        "REQUIRED"
            },

            "SETUP": {
                "Imports":       "REQUIRED",
                "Modules":       "AVAILABLE",
                "Constants":     "REQUIRED",
                "Statics":       "AVAILABLE",
                "TypeAliases":   "AVAILABLE",
                "ErrorTypes":    "AVAILABLE",
                "CoreTypes":     "REQUIRED",
                "TraitDefs":     "AVAILABLE",
                "Macros":        "AVAILABLE",
                "FeatureGates":  "AVAILABLE"
            },

            "BODY": {
                "IdentityAccess":       "AVAILABLE",
                "TraitImplementations": "AVAILABLE",
                "Constructors":         "AVAILABLE",
                "CoreLogic":            "REQUIRED",
                "Queries":              "AVAILABLE",
                "OutputDisplay":        "AVAILABLE",
                "FreeFunctions":        "AVAILABLE",
                "Helpers":              "AVAILABLE",
                "Tests":                "RESERVED"
            },

            "CLOSING": {
                "Cv": "REQUIRED",
                "Ce": "RESERVED",
                "Cc": "AVAILABLE",
                "X1": "REQUIRED",
                "X2": "AVAILABLE",
                "X3": "AVAILABLE",
                "X4": "REQUIRED",
                "X5": "REQUIRED"
            }
        },

        "cascade": {
            "note": "Module form is the focused worker. Many sections AVAILABLE but fewer REQUIRED than library. DocComments AVAILABLE (not REQUIRED) because internal modules may document for teammates but don't have a public API contract. Cv REQUIRED — modules must prove their own correctness.",
            "principle": "The body is not one member, but many. Each module is one member — focused, bounded, tested. The body works because each part does its own work well."
        }
    },

    // ===================================================================
