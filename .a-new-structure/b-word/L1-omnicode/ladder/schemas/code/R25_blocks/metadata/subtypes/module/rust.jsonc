{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-subtypes-module",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Module Form — Rust Content",
    "_P5_brief": "Rust-specific module form. Focused internal unit. File: src/*.rs (non-root module files). One concern, well-bounded, self-tested. A member of the body, not the body itself.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/subtypes/module.jsonc",
    "format": "rust",

    "content": {
        "tag": "module",
        "parent": "Subtypes",
        "I2_subtype": "module",

        "file_pattern": "src/*.rs (non-root module files)",
        "pragma_directive": "//omni:code --rust -module",
        "template_directive": "// #!omni template --rust -module",

        "has_public_api": false,
        "has_tests_block": true,

        "purpose": "Internal module — focused single-concern file within a crate. Mod-declared by lib.rs. Each module is one concern.",

        "required_sections": {
            "METADATA": ["Directives", "CommentBlock", "PragmaIdentity", "MetadataContext", "Subtypes"],
            "SETUP": ["Imports"],
            "BODY": ["CoreLogic"],
            "CLOSING": ["Tests"]
        },

        "scaffold": {
            "pragma": "//omni:code --rust -module",
            "template": "// #!omni template --rust -module\n\n// ========================================================================\n// METADATA BLOCK [METADATA]\n// ========================================================================\n\n// {comment_block}\n\npub static PRAGMA: &[(&str, &str)] = &[\n    (\"I1.key\", \"{key}\"),\n    (\"I1.format\", \"rust\"),\n    (\"I1.from\", \"B-seed-code-L0-rust-module\"),\n    (\"I1.at\", \"{at}\"),\n    (\"I2.type\", \"code\"),\n    (\"I2.structure\", \"4-block\"),\n    (\"I2.subtype\", \"module\"),\n    (\"I3.file\", \"{file}\"),\n    (\"I3.title\", \"{title}\"),\n];\n\npub static METADATA: &[(&str, &str)] = &[\n    (\"C1.version\", \"{version}\"),\n    (\"C1.status\", \"{status}\"),\n    (\"C2.organization\", \"CreativeWorkzStudio LLC\"),\n    (\"C3.scripture\", \"{scripture}\"),\n    (\"C4.requires.stdlib\", \"{stdlib_deps}\"),\n    (\"C4.consumers\", \"{consumers}\"),\n];\n\n// ========================================================================\n// SETUP BLOCK [SETUP]\n// ========================================================================\n\n// --- Imports ---\n\n// ========================================================================\n// BODY BLOCK [BODY]\n// ========================================================================\n\n// --- Core Logic ---\n\n// ========================================================================\n// CLOSING BLOCK [CLOSING]\n// ========================================================================\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_pragma_exists() {\n        assert!(!PRAGMA.is_empty());\n    }\n}\n\n// X5: {closing_note}",
            "note": "Module scaffold is leaner than library. No doc comments (internal). Tests block included — modules must prove their own correctness."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust module: the focused member. Not the whole body, but an essential part. One concern, well-bounded, self-tested. The body works because each member does its work faithfully.",
    "_X5_scripture": "1 Corinthians 12:14 — For the body is not one member, but many."
}
