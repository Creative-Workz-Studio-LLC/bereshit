{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-metadata-context-container",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "container-content",
    "_P5_title": "METADATA Section 5: Metadata Context (C1-C7) -- Go Content Container",
    "_P5_brief": "Parent container for Go-specific Metadata context content. How Go carries C1-C7 context in var Metadata = [][2]string slices. Sub-containers: c1-state through c7-classification.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/_container.jsonc",
    "format": "go",

    "content": {

        // -----------------------------------------
        // Go-specific CANNOT
        // -----------------------------------------

        "cannot": [
            {
                "construct": "Metadata as map[string]string",
                "reason": "Context is compile-time known. map requires runtime initialization.",
                "defer_to": "N/A -- use [][2]string",
                "go_signal": "map\\[string\\]string"
            },
            {
                "construct": "C-sections out of order",
                "reason": "C-sections must appear in order: C1 -> C2 -> C3 -> C4 -> C5 -> C6 -> C7.",
                "defer_to": "N/A -- reorder fields",
                "go_signal": "N/A"
            },
            {
                "construct": "I-section fields in Metadata var",
                "reason": "Identity (I) lives in Pragma. Context (C) lives in Metadata.",
                "defer_to": "Pragma var",
                "go_signal": "\"I\\d\\."
            },
            {
                "construct": "unexported metadata (lowercase)",
                "reason": "Go templates export Metadata for downstream access.",
                "defer_to": "N/A -- capitalize: var Metadata (not var metadata)",
                "go_signal": "var\\s+metadata\\s+"
            }
        ],

        // -----------------------------------------
        // Field Format
        // -----------------------------------------

        "field_format": {
            "key_pattern": "C{section}.{field}",
            "nested_pattern": "C4.requires.{category}",
            "examples": ["C1.version", "C2.organization", "C3.scripture", "C4.requires.stdlib"],
            "note": "Same dot notation as Rust. C prefix for context, I prefix for identity."
        },

        // -----------------------------------------
        // Severity
        // -----------------------------------------

        "severity": {
            "package_root": "warn",
            "other_files": "not checked -- context delegated to doc.go",
            "note": "Only doc.go carries Metadata. Other files inherit."
        },

        // -----------------------------------------
        // Sub-containers
        // -----------------------------------------

        "sub_containers": {
            "c1-state": { "file": "c1-state.jsonc", "purpose": "WHEN -- lifecycle (Go version/status)" },
            "c2-attribution": { "file": "c2-attribution.jsonc", "purpose": "WHO MADE -- credit (Go org/architect)" },
            "c3-grounding": { "file": "c3-grounding.jsonc", "purpose": "WHY -- biblical foundation (Go scripture)" },
            "c4-dependencies": { "file": "c4-dependencies.jsonc", "purpose": "NEEDS -- dependency graph (Go import paths)" },
            "c5-intent": { "file": "c5-intent.jsonc", "purpose": "GOAL -- design intent (Go purpose)" },
            "c6-roadmap": { "file": "c6-roadmap.jsonc", "purpose": "NEXT -- trajectory (Go planned)" },
            "c7-classification": { "file": "c7-classification.jsonc", "purpose": "TAGS -- discovery (Go tags)" }
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Go Metadata context container -- parent for C1-C7 Go content sub-containers. Cannot rules (no map, no lowercase, correct order, no I-fields), field format, and severity all live here. Sub-containers carry the per-section Go-specific patterns and scaffolds.",
    "_X5_scripture": "Proverbs 16:11 -- A just weight and balance are the LORD's: all the weights of the bag are his work."
}
