        "parent": "Subtypes",
        "I2_subtype": "executable",

        "file_pattern": "main.go",
        "pragma_directive": "//omni:code --go -executable",
        "template_directive": "// #!omni template --go -executable",
        "package": "package main",
        "has_public_api": false,

        "purpose": "Binary -- orchestrates via main() -> run() -> error pattern",
        "distinguisher": "The only Go form with func main(). Thin by design -- logic belongs in library packages, not main.go.",

        "go_specifics": {
            "entry_point": "func main() { if err := run(); err != nil { os.Exit(1) } }",
            "pattern": "main() -> run() -> error -- separates entry from orchestration for testability",
            "no_doc_comments": "Executable packages are not imported -- no doc comments needed",
            "exports": "N/A -- package main is not importable"
        },

        "required_sections": {
            "METADATA": ["Directives", "CommentBlock", "PragmaIdentity", "MetadataContext", "Subtypes"],
            "SETUP": ["Imports"],
            "BODY": ["CoreOperations", "Orchestration"],
            "CLOSING": ["Execution"]
        },

        "scaffold": {
            "executable_go": "//omni:code --go -executable\npackage main\n\n// ========================================\n// {title}\n// ========================================\n//\n// {brief}\n//\n\nimport (\n\t\"fmt\"\n\t\"os\"\n)\n\nfunc main() {\n\tif err := run(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc run() error {\n\t// TODO: orchestration logic\n\treturn nil\n}"
        }
    },

