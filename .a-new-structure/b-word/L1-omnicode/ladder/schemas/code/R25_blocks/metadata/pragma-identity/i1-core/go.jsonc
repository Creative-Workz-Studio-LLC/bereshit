    "_P5_title": "Pragma Identity -- I1 Core (Unique Identity) -- Go Content",
    "_P5_brief": "Go-specific content for I1 Core identity fields. key, format, from, at carried in var Pragma = [][2]string slice with exported visibility.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/pragma-identity/i1-core.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "I1",
        "label": "I1 Core -- Unique Identity (Go)",
        "parent": "PragmaIdentity",

        "go_construct": "var Pragma = [][2]string{...}",
        "go_visibility": "exported -- Go convention: uppercase = exported",
        "go_note": "I1 fields are the first entries in the Pragma slice. Zero-allocation, compile-time-known.",

        "field_format": {
            "key_pattern": "I1.{field}",
            "examples": ["I1.key", "I1.format", "I1.from", "I1.at"],
            "note": "Same dot notation as Rust. The I1 prefix scopes to core identity."
        },

        "can": [
            {
                "construct": "I1 fields in Pragma slice",
                "description": "Core identity entries -- first four pairs in the Pragma var",
                "patterns": [
                    "var Pragma = [][2]string{",
                    "\t{\"I1.key\", \"B-my-package-key\"},",
                    "\t{\"I1.format\", \"go\"},",
                    "\t{\"I1.from\", \"B-seed-code-L0-go-library\"},",
                    "\t{\"I1.at\", \"a-01.00\"},",
                    "\t// ... I2, I3, I4 follow",
                    "}"
                ],
                "note": "I1 always appears first in the slice. key is the address, format is the language, from is the lineage, at is the birth version."
            }
        ],

        "scaffold": {
            "i1_fields": "\t{\"I1.key\", \"{key}\"},\n\t{\"I1.format\", \"go\"},\n\t{\"I1.from\", \"{from}\"},\n\t{\"I1.at\", \"{at}\"},"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "I1 Core in Go -- the four fields that make a file findable. key, format, from, at in [][2]string pairs. Exported Pragma var, first entries in the slice.",
