{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-metadata-directives",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "METADATA Section 1: Directives — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Directives ARE — the //omni: markers that declare a file's identity contract. See content/parts/{lang}/metadata/directives.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Directives",
        "position": 1,
        "label": "OmniCode Directives",
        "block": "METADATA",
        "overview_text": "Machine-readable identity markers",

        "header": {
            "section_comment": "// {position}. {label}",
            "separator_style": "none"
        },

        "can": [
            {
                "concept": "pragma directive",
                "description": "First line declaration — //omni:code --rust -module or // #!omni template --go -library",
                "distinguisher": "THE identity line. Tells every tool what this file IS. Line 1, always."
            },
            {
                "concept": "key directive",
                "description": "//omni:key B-... — unique file identifier in the project graph",
                "distinguisher": "The address. How any system finds THIS file among thousands."
            },
            {
                "concept": "version directive",
                "description": "//omni:version a-01.00 — living version stamp",
                "distinguisher": "Where this file is in its lifecycle. Stage-phase.completion."
            },
            {
                "concept": "from directive",
                "description": "//omni:from <template-key> — derivation chain link",
                "distinguisher": "Traceability. Every file knows what it was born from."
            }
        ],

        "cannot": [
            {
                "concept": "code or logic",
                "reason": "Directives are declarations, not instructions",
                "defer_to": "SETUP or BODY"
            },
            {
                "concept": "human-readable descriptions",
                "reason": "Directives are for tools. Human context goes in comment block or doc comments.",
                "defer_to": "METADATA.CommentBlock or METADATA.DocComments"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Directives",
            "reserved_reason": null,
            "note": "Directives are REQUIRED in all forms. Every file must declare what it is."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — no code patterns belong in directives.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Directives are the covenant between file and toolchain. The file declares its identity; tools read it and respond accordingly. No directive = no identity = no trust.",
    "_X5_scripture": "Genesis 1:3 — And God said, Let there be light: and there was light."
}
