    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-metadata-context-c3-grounding",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context -- C3 Grounding (Biblical Foundation) -- Go Content",
    "_P5_brief": "Go-specific content for C3 Grounding fields. scripture, principle, anchor carried in var Metadata = [][2]string slice. The truth this file stands on.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c3-grounding.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "C3",
        "label": "C3 Grounding -- Biblical Foundation (Go)",
        "parent": "MetadataContext",

        "go_construct": "C3 entries in var Metadata = [][2]string{...}",
        "go_visibility": "exported -- within exported Metadata var",
        "go_note": "C3 fields follow C2 in the Metadata slice. Scripture is required; principle and anchor are defined.",

        "field_format": {
            "key_pattern": "C3.{field}",
            "examples": ["C3.scripture", "C3.principle", "C3.anchor"],
            "note": "C3 section follows C2 in the Metadata slice."
        },

        "can": [
            {
                "construct": "C3 fields in Metadata slice",
                "description": "Grounding entries -- the truth this file stands on",
                "patterns": [
                    "\t// C3 Grounding -- biblical foundation",
                    "\t{\"C3.scripture\", \"Proverbs 9:10\"},",
                    "\t{\"C3.principle\", \"Wisdom begins with reverence\"},",
                    "\t{\"C3.anchor\", \"Fear of the LORD\"},"
                ],
                "note": "Section comment '// C3 Grounding -- biblical foundation' precedes the C3 entries."
            }
        ],

        "scaffold": {
            "c3_fields": "\t// C3 Grounding -- biblical foundation\n\t{\"C3.scripture\", \"{scripture}\"},"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C3 Grounding in Go -- the foundation. scripture, principle, anchor in [][2]string pairs. If the foundations be destroyed, what can the righteous do?",
    "_X5_scripture": "Psalm 11:3 -- If the foundations be destroyed, what can the righteous do?"
}
