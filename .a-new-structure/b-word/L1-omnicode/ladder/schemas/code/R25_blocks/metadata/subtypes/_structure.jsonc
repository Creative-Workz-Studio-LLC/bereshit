    "_P5_title": "METADATA Section 6: Subtypes — Container",
    "_P5_brief": "Parent container for Subtypes. Form classifications driven by I2.subtype — bare-bone is the foundation, declared forms add specialization. Sub-containers: one per form.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Subtypes",
        "position": 6,
        "label": "Subtypes (Form Definitions)",
        "block": "METADATA",
        "overview_text": "Form classifications driven by I2.subtype",

        "header": {
            "section_comment": "// Subtypes",
            "separator_style": "none"
        },

        "sub_containers": {
            "bare-bone": { "file": "bare-bone.jsonc", "purpose": "Foundation — minimum valid file" },
            "library": { "file": "library.jsonc", "purpose": "Library — exposes public API" },
            "executable": { "file": "executable.jsonc", "purpose": "Executable — entry point binary" },
            "module": { "file": "module.jsonc", "purpose": "Module — focused internal unit" },
            "demo-test": { "file": "demo-test.jsonc", "purpose": "Demo/Test — validates and proves" }
        },

        "cannot": [
            {
                "concept": "runtime behavior",
                "reason": "Subtypes are compile-time classification, not runtime logic",
                "defer_to": "BODY"
            },
            {
                "concept": "section content",
                "reason": "Subtypes declare WHICH sections exist. What goes IN sections is the content layer's concern.",
                "defer_to": "content/parts/{lang}/{block}/"
            }
        ],

        "cascade": {
            "note": "I2.subtype drives the entire form system. The cascade flows: pragma directive -> I2.subtype -> form constraints -> section availability. Identity determines structure.",
            "bare_bone_principle": "bare-bone is the anchor. It defines the minimum. Every declared form ADDS to bare-bone; none REMOVES from it."
        },

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Subtypes",
            "reserved_reason": null,
            "note": "Subtype classification is REQUIRED — the file must know its form to know its constraints."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

