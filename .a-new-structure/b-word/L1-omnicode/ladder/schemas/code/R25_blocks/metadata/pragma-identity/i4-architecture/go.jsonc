        "can": [
            {
                "construct": "I4 fields in Pragma slice",
                "description": "Architectural context entries -- layer, position, pattern",
                "patterns": [
                    "\t{\"I4.layer\", \"L1\"},",
                    "\t{\"I4.position\", \"foundation\"},",
                    "\t{\"I4.pattern\", \"service-layer\"},"
                ],
                "note": "I4 fields are the last identity entries before the Pragma slice closes. Not every Go file needs I4 -- but when present, it places the package in the architecture."
            }
        ],

        "scaffold": {
            "i4_fields": "\t{\"I4.layer\", \"{layer}\"},\n\t{\"I4.position\", \"{position}\"},\n\t{\"I4.pattern\", \"{pattern}\"},"
        }
    },

    // ===================================================================
