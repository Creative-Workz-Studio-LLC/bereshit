    "sub_container": {
        "tag": "I4",
        "label": "I4 Architecture -- Structural Context (Go)",
        "parent": "PragmaIdentity",

        "go_construct": "I4 entries in var Pragma = [][2]string{...}",
        "go_visibility": "exported -- within exported Pragma var",
        "go_note": "I4 fields are optional (defined, not required). When present, they enable architectural-level querying -- which Go packages sit at which layer, in which position of the dependency chain.",

        "field_format": {
            "key_pattern": "I4.{field}",
            "examples": ["I4.layer", "I4.position", "I4.pattern"],
            "note": "I4 section follows I3 in the Pragma slice. Last I-section."
