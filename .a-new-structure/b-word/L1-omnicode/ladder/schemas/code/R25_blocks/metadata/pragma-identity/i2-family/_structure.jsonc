    "sub_container": {
        "tag": "I2",
        "label": "I2 Family — Classification",
        "parent": "PragmaIdentity",

        "concept": "classification",
        "description": "type, structure, subtype, role — what category this file belongs to",
        "distinguisher": "The taxonomy. Code vs data vs doc, 3-block vs 4-block, library vs executable.",

        "fields": {
            "type": { "required": true, "purpose": "Content type (code, data, document)" },
            "structure": { "required": true, "purpose": "Block structure (3-block, 4-block, 5-block)" },
