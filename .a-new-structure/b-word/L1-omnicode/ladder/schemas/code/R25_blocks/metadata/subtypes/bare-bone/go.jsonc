    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-subtypes-bare-bone",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes -- Bare-Bone Form -- Go Content",
    "_P5_brief": "Go-specific bare-bone form. The minimum valid Go file -- package declaration, Pragma/Metadata in doc.go, basic constants and core logic. All other Go forms derive from this.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/subtypes/bare-bone.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "bare-bone",
        "label": "Bare-Bone -- Foundation Form (Go)",
        "parent": "Subtypes",
        "I2_subtype": "bare-bone",

        "file_pattern": "*.go (any package file)",
        "pragma_directive": "//omni:code --go -bare-bone",
        "template_directive": "// #!omni template --go -bare-bone",
        "package": "package packagename",
        "has_public_api": false,

        "purpose": "The minimum valid Go file. All other Go forms derive from this.",
        "distinguisher": "The anchor form for Go. Package declaration, identity in doc.go, basic structure. No specialization.",

        "go_specifics": {
            "identity_file": "doc.go -- holds Pragma and Metadata for the package",
            "other_files": "Carry directives and comment block only -- identity delegated to doc.go",
            "exports": "Pragma and Metadata exported (uppercase) for downstream access"
        },

        "scaffold": {
            "bare_bone_go": "//omni:code --go -bare-bone\npackage {packagename}\n\n// ========================================\n// {title}\n// ========================================\n//\n// {brief}\n//"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Bare-bone Go form -- the rock. Minimum valid Go file with package declaration, identity delegation to doc.go, and basic structure. Every Go form builds on this foundation.",
    "_X5_scripture": "Matthew 7:24 -- Therefore whosoever heareth these sayings of mine, and doeth them, I will liken him unto a wise man, which built his house upon a rock."
