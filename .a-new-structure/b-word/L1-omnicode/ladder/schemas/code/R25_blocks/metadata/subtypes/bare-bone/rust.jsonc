{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-subtypes-bare-bone",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Bare-Bone Form — Rust Content",
    "_P5_brief": "Rust-specific bare-bone form. Foundation template all other forms derive from. File: bare-bone.rs. Minimum valid file with identity, constants, core logic, and closing note.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/subtypes/bare-bone.jsonc",
    "format": "rust",

    "content": {
        "tag": "bare-bone",
        "parent": "Subtypes",
        "I2_subtype": "bare-bone",

        "file_pattern": "bare-bone.rs (template only — foundation all forms derive from)",
        "pragma_directive": "//omni:code --rust -bare-bone",
        "template_directive": "// #!omni template --rust -bare-bone",

        "has_public_api": false,
        "has_tests_block": false,

        "purpose": "Foundation template — minimum valid Rust file, all other forms derive from this. The anchor form.",

        "required_sections": {
            "METADATA": ["Directives", "CommentBlock", "PragmaIdentity", "MetadataContext", "Subtypes"],
            "SETUP": [],
            "BODY": [],
            "CLOSING": ["Validation"]
        },

        "scaffold": {
            "pragma": "//omni:code --rust -bare-bone",
            "template": "// #!omni template --rust -bare-bone\n\n// ========================================================================\n// METADATA BLOCK [METADATA]\n// ========================================================================\n\n// {comment_block}\n\npub static PRAGMA: &[(&str, &str)] = &[\n    (\"I1.key\", \"{key}\"),\n    (\"I1.format\", \"rust\"),\n    (\"I1.from\", \"B-seed-code-L0-rust-bare-bone\"),\n    (\"I1.at\", \"{at}\"),\n    (\"I2.type\", \"code\"),\n    (\"I2.structure\", \"4-block\"),\n    (\"I2.subtype\", \"bare-bone\"),\n    (\"I3.file\", \"{file}\"),\n    (\"I3.title\", \"{title}\"),\n];\n\npub static METADATA: &[(&str, &str)] = &[\n    (\"C1.version\", \"{version}\"),\n    (\"C1.status\", \"{status}\"),\n    (\"C2.organization\", \"CreativeWorkzStudio LLC\"),\n    (\"C3.scripture\", \"{scripture}\"),\n    (\"C4.requires.stdlib\", \"{stdlib_deps}\"),\n    (\"C4.consumers\", \"{consumers}\"),\n];\n\n// ========================================================================\n// SETUP BLOCK [SETUP]\n// ========================================================================\n\n// ========================================================================\n// BODY BLOCK [BODY]\n// ========================================================================\n\n// ========================================================================\n// CLOSING BLOCK [CLOSING]\n// ========================================================================\n\n// X5: {closing_note}",
            "note": "Bare-bone scaffold has empty SETUP and BODY blocks. The minimum: METADATA with identity + context, empty structure, closing note."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust bare-bone: the rock. Minimum valid Rust file — identity statics, empty structure, closing note. All other forms build on this foundation. A file must be valid bare-bone before it can be anything else.",
    "_X5_scripture": "Matthew 7:24 — Therefore whosoever heareth these sayings of mine, and doeth them, I will liken him unto a wise man, which built his house upon a rock."
}
