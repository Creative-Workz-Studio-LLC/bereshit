    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — no code patterns belong in subtype declarations.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "The subtype is a small declaration with large consequences. One field in the pragma static determines the entire shape of the file — which sections exist, which are reserved, what content is allowed. This is the principle of identity determining structure. The file declares what it is, and the standard responds by telling it what it can contain. Like the members of a body, each has its place and purpose.",
    "_X5_scripture": "1 Corinthians 12:18 — But now hath God set the members every one of them in the body, as it hath pleased him. Each form has its place."
}
