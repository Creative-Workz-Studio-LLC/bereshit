{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-metadata-context-c1-state",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context -- C1 State (Lifecycle) -- Go Content",
    "_P5_brief": "Go-specific content for C1 State lifecycle fields. version, status, created, updated carried in var Metadata = [][2]string slice.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c1-state.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "C1",
        "label": "C1 State -- Lifecycle (Go)",
        "parent": "MetadataContext",

        "go_construct": "C1 entries in var Metadata = [][2]string{...}",
        "go_visibility": "exported -- within exported Metadata var",
        "go_note": "C1 fields are the first entries in the Metadata slice. Living versioning (stage-phase.completion) tracks actual progress.",

        "field_format": {
            "key_pattern": "C1.{field}",
            "examples": ["C1.version", "C1.status", "C1.created", "C1.updated"],
            "note": "C1 is always the first C-section in the Metadata slice."
        },

        "can": [
            {
                "construct": "C1 fields in Metadata slice",
                "description": "Lifecycle entries -- version, status, dates",
                "patterns": [
                    "var Metadata = [][2]string{",
                    "\t// C1 State -- lifecycle",
                    "\t{\"C1.version\", \"a-01.00\"},",
                    "\t{\"C1.status\", \"active\"},",
                    "\t{\"C1.created\", \"2026-01-15\"},",
                    "\t{\"C1.updated\", \"2026-02-21\"},",
                    "\t// ... C2-C7 follow",
                    "}"
                ],
                "note": "Section comment '// C1 State -- lifecycle' precedes the C1 entries. Dates are ISO 8601."
            }
        ],

        "scaffold": {
            "c1_fields": "\t// C1 State -- lifecycle\n\t{\"C1.version\", \"{version}\"},\n\t{\"C1.status\", \"{status}\"},\n\t{\"C1.created\", \"{created}\"},\n\t{\"C1.updated\", \"{updated}\"},"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C1 State in Go -- the heartbeat. version, status, created, updated in [][2]string pairs. First entries in the Metadata slice. Without C1, the file exists outside time.",
    "_X5_scripture": "Ecclesiastes 3:1 -- To every thing there is a season, and a time to every purpose under the heaven."
}
