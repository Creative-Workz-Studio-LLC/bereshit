    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-metadata-context-c7-classification",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context -- C7 Classification (Discovery) -- Go Content",
    "_P5_brief": "Go-specific content for C7 Classification fields. tags, category, domain, paradigm carried in var Metadata = [][2]string slice. How to find this file across thousands.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c7-classification.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "C7",
        "label": "C7 Classification -- Discovery (Go)",
        "parent": "MetadataContext",

        "go_construct": "C7 entries in var Metadata = [][2]string{...}",
        "go_visibility": "exported -- within exported Metadata var",
        "go_note": "C7 fields are defined (not required) -- classification is emergent. Tags are comma-separated in the string value (Go [][2]string can only carry string pairs).",

        "field_format": {
            "key_pattern": "C7.{field}",
            "examples": ["C7.tags", "C7.category", "C7.domain", "C7.paradigm"],
            "note": "C7 is the last C-section in the Metadata slice."
        },

        "can": [
            {
                "construct": "C7 fields in Metadata slice",
                "description": "Classification entries -- discovery tags and categories",
                "patterns": [
                    "\t// C7 Classification -- discovery",
                    "\t{\"C7.tags\", \"hooks, session, lifecycle\"},",
                    "\t{\"C7.category\", \"infrastructure\"},",
                    "\t{\"C7.domain\", \"identity\"},",
                    "\t{\"C7.paradigm\", \"CPI-SI\"},"
                ],
                "note": "Section comment '// C7 Classification -- discovery' precedes the C7 entries. Tags are comma-separated within the string value."
            }
        ],

        "scaffold": {
            "c7_fields": "\t// C7 Classification -- discovery\n\t{\"C7.tags\", \"{tags}\"},\n\t{\"C7.category\", \"{category}\"},"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C7 Classification in Go -- the index. tags, category, domain, paradigm in [][2]string pairs. Tags are comma-separated. Without C7, discovery depends on file paths and naming conventions alone.",
    "_X5_scripture": "Proverbs 25:2 -- It is the glory of God to conceal a thing: but the honour of kings is to search out a matter."
}
