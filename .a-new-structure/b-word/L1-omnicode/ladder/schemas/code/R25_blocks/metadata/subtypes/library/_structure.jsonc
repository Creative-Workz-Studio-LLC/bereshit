{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-metadata-subtypes-library",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Library Form",
    "_P5_brief": "Library form. Exposes public API. Crate/package root. Requires doc comments, full SETUP with types and traits, BODY with public API surface, CLOSING with validation and tests.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "library",
        "label": "Library — Public API Form",
        "parent": "Subtypes",
        "I2_subtype": "library",

        "purpose": "Exposes public API. Crate root (Rust lib.rs) or package root (Go). Requires doc comments for public surface.",
        "distinguisher": "The most complete form. Full SETUP, full BODY, full CLOSING. If it's public-facing, it's a library.",

        "has_public_api": true,
        "has_tests_block": true,

        "section_availability": {

            "METADATA": {
                "Directives":      "REQUIRED",
                "CommentBlock":    "REQUIRED",
                "DocComments":     "REQUIRED",
                "PragmaIdentity":  "REQUIRED",
                "MetadataContext":  "REQUIRED",
                "Subtypes":        "REQUIRED"
            },

            "SETUP": {
                "Imports":       "REQUIRED",
                "Modules":       "AVAILABLE",
                "Constants":     "REQUIRED",
                "Statics":       "AVAILABLE",
                "TypeAliases":   "AVAILABLE",
                "ErrorTypes":    "AVAILABLE",
                "CoreTypes":     "REQUIRED",
                "TraitDefs":     "AVAILABLE",
                "Macros":        "AVAILABLE",
                "FeatureGates":  "AVAILABLE"
            },

            "BODY": {
                "IdentityAccess":       "AVAILABLE",
                "TraitImplementations": "AVAILABLE",
                "Constructors":         "REQUIRED",
                "CoreLogic":            "REQUIRED",
                "Queries":              "AVAILABLE",
                "OutputDisplay":        "AVAILABLE",
                "FreeFunctions":        "AVAILABLE",
                "Helpers":              "AVAILABLE",
                "Tests":                "RESERVED"
            },

            "CLOSING": {
                "Cv": "REQUIRED",
                "Ce": "RESERVED",
                "Cc": "AVAILABLE",
                "X1": "REQUIRED",
                "X2": "REQUIRED",
                "X3": "AVAILABLE",
                "X4": "REQUIRED",
                "X5": "REQUIRED"
            }
        },

        "cascade": {
            "note": "Library form has the widest surface — most sections are AVAILABLE or REQUIRED. DocComments are REQUIRED because the public API must be documented. Ce (Execution) is RESERVED because libraries don't have entry points.",
            "principle": "By wisdom a house is built. The library form builds room by room — every section available because a library may need any of them."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Library is the most complete form. It builds the house — types, traits, constructors, logic, queries, display, tests. Every room filled with knowledge and understanding. Public API demands documentation and validation.",
    "_X5_scripture": "Proverbs 24:3-4 — Through wisdom is an house builded; and by understanding it is established: And by knowledge shall the chambers be filled with all precious and pleasant riches."
}
