{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-metadata-comment-block",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "METADATA Section 3: Comment Block — Structure",
    "_P5_brief": "Format-agnostic structure definition. What the METADATA comment block IS — human-readable identity fields in // comments. Secondary to PRAGMA/METADATA statics when those exist. See content/parts/{lang}/metadata/comment-block.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "CommentBlock",
        "position": 3,
        "label": "Comment Block",
        "block": "METADATA",
        "overview_text": "Human-readable identity in comments",

        "header": {
            "section_comment": "// METADATA",
            "bracket_format": "// ============================================================================",
            "separator_style": "equals-76"
        },

        "can": [
            {
                "concept": "file identity fields",
                "description": "// file:, // key:, // title:, // type: — human-readable identity",
                "distinguisher": "The nameplate. When you open a file, you know immediately what it is."
            },
            {
                "concept": "version and state",
                "description": "// version:, // status:, // created:, // updated: — lifecycle tracking",
                "distinguisher": "Where this file has been and where it's going."
            },
            {
                "concept": "attribution",
                "description": "// authors:, // architect: — who made this and who designed it",
                "distinguisher": "Credit and accountability. Names on the work."
            },
            {
                "concept": "purpose and grounding",
                "description": "// purpose:, // biblical_foundation: — why this file exists and what truth anchors it",
                "distinguisher": "The WHY. Every file serves a purpose; the best files know what truth they stand on."
            }
        ],

        "cannot": [
            {
                "concept": "executable code",
                "reason": "Comments are documentation, not instructions",
                "defer_to": "SETUP or BODY"
            },
            {
                "concept": "structured data fields",
                "reason": "When PRAGMA/METADATA statics exist, structured identity lives there. Comments become secondary.",
                "defer_to": "METADATA.PragmaIdentity or METADATA.MetadataContext"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Comment Block",
            "reserved_reason": null,
            "note": "Comment block is REQUIRED in all forms. Every file needs human-readable identity."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — no code patterns belong in comment blocks.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "The comment block is the file's introduction. Before PRAGMA statics existed, this WAS the identity system. Now it serves as the human-readable layer — what statics carry in structured form, comments carry in prose.",
    "_X5_scripture": "Proverbs 22:1 — A good name is rather to be chosen than great riches."
}
