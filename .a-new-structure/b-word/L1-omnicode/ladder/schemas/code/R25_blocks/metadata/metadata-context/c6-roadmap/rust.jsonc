{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-metadata-context-c6-roadmap",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context — C6 Roadmap (Trajectory) — Rust Content",
    "_P5_brief": "How Rust carries C6 Roadmap fields (current, planned, limitations) in pub static METADATA slices. The trajectory in compiled statics.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c6-roadmap.jsonc",
    "format": "rust",

    "content": {
        "tag": "C6",
        "parent": "MetadataContext",
        "static_name": "METADATA",

        "can": {
            "description": "C6 fields carried as key-value pairs in METADATA static slice, immediately after C5",
            "patterns": [
                "(\"C6.current\", \"Phase 1 — core types implemented\"),",
                "(\"C6.planned\", \"Phase 2 — serialization support\"),",
                "(\"C6.limitations\", \"no async support yet\"),"
            ],
            "field_order": ["current", "planned", "limitations"],
            "note": "All three C6 fields are defined (not required). Present when the file has a meaningful trajectory — not every file needs a roadmap."
        },

        "cannot": [
            {
                "construct": "C6 fields before C5 in METADATA",
                "reason": "Section order: C1 -> C2 -> C3 -> C4 -> C5 -> C6. Roadmap follows intent.",
                "rust_signal": "C6\\. appearing before C5\\."
            },
            {
                "construct": "C6.limitations as TODO list",
                "reason": "limitations captures intentionally deferred work, not bugs. TODOs go in code comments.",
                "rust_signal": "N/A — semantic check"
            }
        ],

        "scaffold": {
            "slice_full": "// C6 Roadmap — trajectory\n    (\"C6.current\", \"{current}\"),\n    (\"C6.planned\", \"{planned}\"),\n    (\"C6.limitations\", \"{limitations}\"),",
            "slice_minimal": "(\"C6.current\", \"{current}\"),",
            "note": "Full scaffold includes all three with section comment. Minimal includes just current phase. Omit C6 entirely for stable files with no planned changes."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C6 in Rust: the vision. current tells you where the file is now, planned tells you where it's going, limitations tells you what was intentionally deferred. Without C6, every TODO is a mystery and every limitation looks like a bug.",
    "_X5_scripture": "Habakkuk 2:3 — For the vision is yet for an appointed time, but at the end it shall speak, and not lie."
}
