{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-subtypes-demo-test",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Demo/Test Form — Rust Content",
    "_P5_brief": "Rust-specific demo-test form. Validates behavior, proves claims. File: tests/*.rs or #[cfg(test)] mod tests. The proving ground — tests are the content, not a side effect.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/subtypes/demo-test.jsonc",
    "format": "rust",

    "content": {
        "tag": "demo-test",
        "parent": "Subtypes",
        "I2_subtype": "demo-test",

        "file_pattern": "tests/*.rs or #[cfg(test)] mod tests",
        "pragma_directive": "//omni:code --rust -demo-test",
        "template_directive": "// #!omni template --rust -demo-test",

        "has_public_api": false,
        "has_tests_block": true,

        "purpose": "Test file — validates crate behavior, proves claims. Integration tests, demos, examples, phase validation.",

        "required_sections": {
            "METADATA": ["Directives", "CommentBlock", "PragmaIdentity", "MetadataContext", "Subtypes"],
            "SETUP": ["Imports"],
            "BODY": ["Tests"],
            "CLOSING": ["Validation"]
        },

        "scaffold": {
            "pragma": "//omni:code --rust -demo-test",
            "template": "// #!omni template --rust -demo-test\n\n// ========================================================================\n// METADATA BLOCK [METADATA]\n// ========================================================================\n\n// {comment_block}\n\npub static PRAGMA: &[(&str, &str)] = &[\n    (\"I1.key\", \"{key}\"),\n    (\"I1.format\", \"rust\"),\n    (\"I1.from\", \"B-seed-code-L0-rust-demo-test\"),\n    (\"I1.at\", \"{at}\"),\n    (\"I2.type\", \"code\"),\n    (\"I2.structure\", \"4-block\"),\n    (\"I2.subtype\", \"demo-test\"),\n    (\"I3.file\", \"{file}\"),\n    (\"I3.title\", \"{title}\"),\n];\n\npub static METADATA: &[(&str, &str)] = &[\n    (\"C1.version\", \"{version}\"),\n    (\"C1.status\", \"{status}\"),\n    (\"C2.organization\", \"CreativeWorkzStudio LLC\"),\n    (\"C3.scripture\", \"{scripture}\"),\n    (\"C4.requires.stdlib\", \"{stdlib_deps}\"),\n    (\"C4.requires.internal\", \"{internal_deps}\"),\n    (\"C4.consumers\", \"CI pipeline, developers\"),\n];\n\n// ========================================================================\n// SETUP BLOCK [SETUP]\n// ========================================================================\n\n// --- Imports ---\n\n// ========================================================================\n// BODY BLOCK [BODY]\n// ========================================================================\n\n// --- Tests ---\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_example() {\n        // Prove the claim\n        assert!(true);\n    }\n}\n\n// ========================================================================\n// CLOSING BLOCK [CLOSING]\n// ========================================================================\n\n// --- Validation ---\n// All tests passing validates the claims made by the crate.\n\n// X5: {closing_note}",
            "note": "Demo-test scaffold puts tests in BODY, not CLOSING. Tests ARE the content. Cv in CLOSING validates that all tests pass. C4.requires.internal references the crate being tested."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust demo-test: the refining fire. Takes claims and proves them. The only form where tests are the main content. As the fining pot for silver — tests refine what is built.",
    "_X5_scripture": "Proverbs 27:21 — As the fining pot for silver, and the furnace for gold; so is a man to his praise."
}
