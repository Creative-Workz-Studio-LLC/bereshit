    "_P5_title": "Metadata Context — C1 State (Lifecycle)",
    "_P5_brief": "C1 State: when this file was born and where it's at. version, status, created, updated — the timeline that tracks actual progress.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "C1",
        "label": "C1 State — Lifecycle",
        "parent": "MetadataContext",

        "concept": "lifecycle",
        "description": "version, status, created, updated — when this file was born and where it's at",
        "distinguisher": "The timeline. Living versioning (stage-phase.completion) tracks actual progress, not aspirational targets.",

        "fields": {
            "version": { "required": true, "purpose": "Living version (stage-phase.completion, e.g., a-01.25)" },
            "status": { "required": true, "purpose": "Current lifecycle state (draft, active, stable, deprecated, archived)" },
            "created": { "defined": true, "purpose": "Date this file was first created (ISO 8601)" },
            "updated": { "defined": true, "purpose": "Date this file was last meaningfully changed (ISO 8601)" }
        },

        "purpose": "WHEN — lifecycle"
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C1 is the heartbeat. version tells you HOW FAR the file has come. status tells you WHERE in its lifecycle. created tells you WHEN it was born. updated tells you WHEN it last changed. Without C1, the file exists outside time.",
    "_X5_scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven."
}
