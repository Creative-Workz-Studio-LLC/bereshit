    "sub_container": {
        "tag": "demo-test",
        "label": "Demo/Test — Validation Form",
        "parent": "Subtypes",
        "I2_subtype": "demo-test",

        "purpose": "Validates behavior, proves claims. Integration tests, demos, examples, phase validation.",
        "distinguisher": "The proving ground. The only form where BODY test subsections (B9-B17) are AVAILABLE. Tests are the content, not a side effect.",

        "has_public_api": false,
        "has_tests_block": true,

        "section_availability": {

            "METADATA": {
                "Directives":      "REQUIRED",
                "CommentBlock":    "REQUIRED",
                "DocComments":     "RESERVED",
                "PragmaIdentity":  "REQUIRED",
                "MetadataContext":  "REQUIRED",
                "Subtypes":        "REQUIRED"
            },

            "SETUP": {
                "Imports":       "REQUIRED",
                "Modules":       "RESERVED",
                "Constants":     "REQUIRED",
                "Statics":       "AVAILABLE",
                "TypeAliases":   "RESERVED",
                "ErrorTypes":    "RESERVED",
                "CoreTypes":     "REQUIRED",
                "TraitDefs":     "RESERVED",
                "Macros":        "AVAILABLE",
                "FeatureGates":  "AVAILABLE"
            },

            "BODY": {
                "IdentityAccess":       "AVAILABLE",
                "TraitImplementations": "RESERVED",
                "Constructors":         "AVAILABLE",
                "CoreLogic":            "REQUIRED",
                "Queries":              "RESERVED",
                "OutputDisplay":        "AVAILABLE",
                "FreeFunctions":        "AVAILABLE",
                "Helpers":              "AVAILABLE",
                "Tests":                "AVAILABLE"
            },

            "CLOSING": {
                "Cv": "REQUIRED",
                "Ce": "AVAILABLE",
                "Cc": "AVAILABLE",
                "X1": "REQUIRED",
                "X2": "RESERVED",
                "X3": "AVAILABLE",
                "X4": "REQUIRED",
                "X5": "REQUIRED"
            }
        },

        "cascade": {
            "note": "Demo/test form is the only form where BODY Tests (B9-B17) are AVAILABLE — tests are the primary content. Cv is REQUIRED for validation. Ce is AVAILABLE because demos may have an entry point that runs the demonstration. X2 (Extension Points) is RESERVED — test files are not extended, they are replaced.",
            "principle": "As the refining pot for silver. Tests refine the code — they prove what is claimed, expose what is hidden, and validate what is built."
        }
    },

    // ===================================================================
