{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-metadata-context-c3-grounding",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context — C3 Grounding (Biblical Foundation) — Rust Content",
    "_P5_brief": "How Rust carries C3 Grounding fields (scripture, principle, anchor) in pub static METADATA slices. The truth this file stands on, in compiled statics.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c3-grounding.jsonc",
    "format": "rust",

    "content": {
        "tag": "C3",
        "parent": "MetadataContext",
        "static_name": "METADATA",

        "can": {
            "description": "C3 fields carried as key-value pairs in METADATA static slice, immediately after C2",
            "patterns": [
                "(\"C3.scripture\", \"Exodus 3:14 — I AM THAT I AM\"),",
                "(\"C3.principle\", \"Identity precedes function\"),",
                "(\"C3.anchor\", \"Genesis 1:1\"),"
            ],
            "field_order": ["scripture", "principle", "anchor"],
            "note": "scripture is required — every file must ground in truth. principle and anchor are defined. scripture format: 'Reference — Text' (e.g., 'Exodus 3:14 — I AM THAT I AM')."
        },

        "cannot": [
            {
                "construct": "C3 fields before C2 in METADATA",
                "reason": "Section order: C1 -> C2 -> C3. Grounding follows attribution.",
                "rust_signal": "C3\\. appearing before C2\\."
            },
            {
                "construct": "C3.scripture missing from METADATA",
                "reason": "Every file must declare its biblical foundation. If the foundations be destroyed, what can the righteous do?",
                "rust_signal": "METADATA missing C3\\.scripture"
            }
        ],

        "scaffold": {
            "slice_full": "// C3 Grounding — biblical foundation\n    (\"C3.scripture\", \"{scripture}\"),\n    (\"C3.principle\", \"{principle}\"),\n    (\"C3.anchor\", \"{anchor}\"),",
            "slice_minimal": "(\"C3.scripture\", \"{scripture}\"),",
            "note": "scripture is always present. Full scaffold adds principle and anchor for files with strong design rationale."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C3 in Rust: the foundation. scripture tells you what truth grounds the file, principle tells you what rule derives from that truth, anchor tells you what cannot be violated. Without C3, the file has no reason deeper than function.",
    "_X5_scripture": "Psalm 11:3 — If the foundations be destroyed, what can the righteous do?"
}
