    "_P5_title": "Metadata Context — C4 Dependencies (Dependency Graph)",
    "_P5_brief": "C4 Dependencies: the relationship map. requires, consumers, integration, if_missing — what this file needs and what needs this file. The body cannot say to the hand, I have no need of thee.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "C4",
        "label": "C4 Dependencies — Dependency Graph",
        "parent": "MetadataContext",

        "concept": "dependency graph",
        "description": "requires, consumers, integration, if_missing — the dependency web connecting this file to others",
        "distinguisher": "The relationship map. What this file needs and what needs this file. No file is an island.",

        "fields": {
            "requires": {
                "required": true,
                "purpose": "What this file depends on to compile or function",
                "nested": {
                    "stdlib": { "purpose": "Standard library imports (e.g., fmt, os, io)" },
                    "external": { "purpose": "Third-party dependencies (e.g., crates, modules)" },
                    "internal": { "purpose": "Project-internal dependencies (e.g., sibling packages, local crates)" }
                }
            },
            "consumers": { "required": true, "purpose": "What depends on this file (reverse dependency map)" },
            "integration": { "defined": true, "purpose": "How this file integrates with the broader system" },
            "if_missing": { "defined": true, "purpose": "What breaks or degrades if this file is absent" }
        },

        "purpose": "NEEDS — dependency graph"
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C4 is the web. requires tells you WHAT THIS FILE NEEDS — stdlib, external, internal. consumers tells you WHAT NEEDS THIS FILE. integration tells you HOW it connects. if_missing tells you WHAT BREAKS without it. The eye cannot say unto the hand, I have no need of thee.",
    "_X5_scripture": "1 Corinthians 12:21 — And the eye cannot say unto the hand, I have no need of thee: nor again the head to the feet, I have no need of you."
