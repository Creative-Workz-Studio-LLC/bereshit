    "_P5_title": "Metadata Context — C5 Intent (Design Intent)",
    "_P5_brief": "C5 Intent: beyond function — the design intention. purpose, philosophy — many devices in a man's heart, but the counsel of the LORD shall stand.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "C5",
        "label": "C5 Intent — Design Intent",
        "parent": "MetadataContext",

        "concept": "design intent",
        "description": "purpose, philosophy — what this file aims to achieve and the design thinking behind it",
        "distinguisher": "The mission statement. Beyond function — the design intention that survives refactoring.",

        "fields": {
            "purpose": { "defined": true, "purpose": "What this file exists to accomplish (the WHAT)" },
            "philosophy": { "defined": true, "purpose": "The design approach and reasoning (the WHY of the HOW)" }
        },

        "purpose": "GOAL — design intent",

        "note": "C5 fields are all 'defined' (not required) because intent can be implicit in simple files. But when present, they capture the design reasoning that comments alone cannot — the difference between WHAT the code does and WHY it was designed this way."
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C5 is the counsel. purpose tells you WHAT the file aims to achieve. philosophy tells you WHY it was designed this way and not another. Code without intent is code without direction — it works, but nobody knows why it was built that way.",
    "_X5_scripture": "Proverbs 19:21 — There are many devices in a man's heart; nevertheless the counsel of the LORD, that shall stand."
