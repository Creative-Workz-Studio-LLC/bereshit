{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-metadata-context-c4-dependencies",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context -- C4 Dependencies (Dependency Graph) -- Go Content",
    "_P5_brief": "Go-specific content for C4 Dependencies fields. requires (nested: stdlib, external, internal), consumers, if_missing in Metadata slice. Go uses full import paths (e.g., github.com/spf13/cobra).",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c4-dependencies.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "C4",
        "label": "C4 Dependencies -- Dependency Graph (Go)",
        "parent": "MetadataContext",

        "go_construct": "C4 entries in var Metadata = [][2]string{...}",
        "go_visibility": "exported -- within exported Metadata var",
        "go_note": "C4 uses dot-nested keys for dependency categories. Go import paths are full module paths (e.g., github.com/spf13/cobra), not crate names.",

        "field_format": {
            "key_pattern": "C4.{field}",
            "nested_pattern": "C4.requires.{category}",
            "examples": ["C4.requires.stdlib", "C4.requires.external", "C4.requires.internal", "C4.consumers", "C4.if_missing"],
            "note": "C4 uses nested keys same as Rust but with Go import paths."
        },

        "can": [
            {
                "construct": "C4 nested dependency keys",
                "description": "Dependency graph edges in Go style",
                "patterns": [
                    "\t// C4 Dependencies -- graph edges",
                    "\t{\"C4.requires.stdlib\", \"fmt, os, path/filepath\"},",
                    "\t{\"C4.requires.external\", \"github.com/spf13/cobra\"},",
                    "\t{\"C4.requires.internal\", \"pkg/config, pkg/types\"},",
                    "\t{\"C4.consumers\", \"main package, integration tests\"},",
                    "\t{\"C4.if_missing\", \"package identity unavailable\"},"
                ],
                "note": "Go stdlib imports use short names (fmt, os). External uses full module paths. Internal uses project-relative paths."
            }
        ],

        "scaffold": {
            "c4_fields": "\t// C4 Dependencies -- graph edges\n\t{\"C4.requires.stdlib\", \"{stdlib_deps}\"},\n\t{\"C4.consumers\", \"{consumers}\"},"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C4 Dependencies in Go -- the web. requires (stdlib, external, internal), consumers, if_missing in [][2]string pairs. Go import paths are full module paths. The eye cannot say unto the hand, I have no need of thee.",
    "_X5_scripture": "1 Corinthians 12:21 -- And the eye cannot say unto the hand, I have no need of thee: nor again the head to the feet, I have no need of you."
}
