        "scaffold": {
            "pragma": "//omni:code --rust -executable",
            "template": "// #!omni template --rust -executable\n\n// ========================================================================\n// METADATA BLOCK [METADATA]\n// ========================================================================\n\n// {comment_block}\n\npub static PRAGMA: &[(&str, &str)] = &[\n    (\"I1.key\", \"{key}\"),\n    (\"I1.format\", \"rust\"),\n    (\"I1.from\", \"B-seed-code-L0-rust-executable\"),\n    (\"I1.at\", \"{at}\"),\n    (\"I2.type\", \"code\"),\n    (\"I2.structure\", \"4-block\"),\n    (\"I2.subtype\", \"executable\"),\n    (\"I3.file\", \"main.rs\"),\n    (\"I3.title\", \"{title}\"),\n];\n\npub static METADATA: &[(&str, &str)] = &[\n    (\"C1.version\", \"{version}\"),\n    (\"C1.status\", \"{status}\"),\n    (\"C2.organization\", \"CreativeWorkzStudio LLC\"),\n    (\"C3.scripture\", \"{scripture}\"),\n    (\"C4.requires.stdlib\", \"{stdlib_deps}\"),\n    (\"C4.consumers\", \"end user\"),\n];\n\n// ========================================================================\n// SETUP BLOCK [SETUP]\n// ========================================================================\n\n// --- Imports ---\n\n// ========================================================================\n// BODY BLOCK [BODY]\n// ========================================================================\n\n// --- Core Logic ---\n\nfn run() -> Result<(), Box<dyn std::error::Error>> {\n    // Orchestration logic here\n    Ok(())\n}\n\n// ========================================================================\n// CLOSING BLOCK [CLOSING]\n// ========================================================================\n\n// --- Execution ---\n\nfn main() {\n    if let Err(e) = run() {\n        eprintln!(\"Error: {e}\");\n        std::process::exit(1);\n    }\n}\n\n// X5: {closing_note}",
            "note": "Executable scaffold uses main() -> run() -> Result pattern. Thin orchestration — delegates to libraries. Ce (Execution) section holds main()."
        }
    },

