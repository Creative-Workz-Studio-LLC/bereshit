    "_P5_title": "Metadata Context — C7 Classification (Discovery)",
    "_P5_brief": "C7 Classification: how to find this file across thousands. tags, category, domain, paradigm — the glory of God is to conceal a thing, the honour of kings is to search it out.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "C7",
        "label": "C7 Classification — Discovery",
        "parent": "MetadataContext",

        "concept": "discovery",
        "description": "tags, category, domain, paradigm — how to find this file across thousands",
        "distinguisher": "The search surface. Tags enable discovery at scale. When the codebase grows to thousands of files, C7 is how you find the one you need.",

        "fields": {
            "tags": { "defined": true, "purpose": "Freeform discovery tags for search and filtering (array of strings)" },
            "category": { "defined": true, "purpose": "Functional category (e.g., error-handling, serialization, auth)" },
            "domain": { "defined": true, "purpose": "Business or technical domain (e.g., identity, configuration, transport)" },
            "paradigm": { "defined": true, "purpose": "Programming paradigm or pattern family (e.g., CPI-SI, functional, OOP)" }
        },

        "purpose": "TAGS — discovery",

        "note": "C7 fields are all 'defined' (not required) because classification is emergent — you often discover the right tags after the file proves its role. But when present, they transform grep from guessing to precision."
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C7 is the index. tags give you FREEFORM search handles. category gives you FUNCTIONAL grouping. domain gives you BUSINESS context. paradigm gives you DESIGN family. Without C7, discovery depends on file paths and naming conventions alone — which break at scale.",
    "_X5_scripture": "Proverbs 25:2 — It is the glory of God to conceal a thing: but the honour of kings is to search out a matter."
