{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-metadata-subtypes-bare-bone",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Bare-Bone Form",
    "_P5_brief": "Foundation form. The minimum valid file — all other forms derive from this. Has identity, constants, core logic, and closing note. No specialization.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "bare-bone",
        "label": "Bare-Bone — Foundation Form",
        "parent": "Subtypes",
        "I2_subtype": "bare-bone",

        "purpose": "The minimum valid file. All other forms derive from this.",
        "distinguisher": "The anchor form. What every file MUST have before specialization. No SETUP/BODY elaboration beyond the universal minimum.",

        "has_public_api": false,
        "has_tests_block": false,

        "section_availability": {

            "METADATA": {
                "Directives":      "REQUIRED",
                "CommentBlock":    "REQUIRED",
                "DocComments":     "RESERVED",
                "PragmaIdentity":  "REQUIRED",
                "MetadataContext":  "REQUIRED",
                "Subtypes":        "REQUIRED"
            },

            "SETUP": {
                "Imports":       "REQUIRED",
                "Modules":       "RESERVED",
                "Constants":     "REQUIRED",
                "Statics":       "RESERVED",
                "TypeAliases":   "RESERVED",
                "ErrorTypes":    "RESERVED",
                "CoreTypes":     "REQUIRED",
                "TraitDefs":     "RESERVED",
                "Macros":        "RESERVED",
                "FeatureGates":  "RESERVED"
            },

            "BODY": {
                "IdentityAccess":       "AVAILABLE",
                "TraitImplementations": "RESERVED",
                "Constructors":         "RESERVED",
                "CoreLogic":            "REQUIRED",
                "Queries":              "RESERVED",
                "OutputDisplay":        "RESERVED",
                "FreeFunctions":        "RESERVED",
                "Helpers":              "RESERVED",
                "Tests":                "RESERVED"
            },

            "CLOSING": {
                "Cv": "RESERVED",
                "Ce": "RESERVED",
                "Cc": "RESERVED",
                "X1": "REQUIRED",
                "X2": "AVAILABLE",
                "X3": "AVAILABLE",
                "X4": "REQUIRED",
                "X5": "REQUIRED"
            }
        },

        "cascade": {
            "note": "bare-bone is the anchor. Every declared form ADDS to bare-bone; none REMOVES from it. RESERVED sections in bare-bone become AVAILABLE or REQUIRED in specialized forms.",
            "principle": "Identity before specialization. A file must be valid bare-bone before it can be anything else."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "bare-bone is the rock. The minimum structure that makes a file valid. All other forms build on this foundation — they add sections, they never remove them.",
    "_X5_scripture": "Matthew 7:24 — Therefore whosoever heareth these sayings of mine, and doeth them, I will liken him unto a wise man, which built his house upon a rock."
}
