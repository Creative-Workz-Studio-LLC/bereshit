{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-metadata-context-c5-intent",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context — C5 Intent (Design Intent) — Rust Content",
    "_P5_brief": "How Rust carries C5 Intent fields (purpose, philosophy) in pub static METADATA slices. The design intention that survives refactoring, in compiled statics.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c5-intent.jsonc",
    "format": "rust",

    "content": {
        "tag": "C5",
        "parent": "MetadataContext",
        "static_name": "METADATA",

        "can": {
            "description": "C5 fields carried as key-value pairs in METADATA static slice, immediately after C4",
            "patterns": [
                "(\"C5.purpose\", \"Verify file existence before operations\"),",
                "(\"C5.philosophy\", \"Check before act — look before you leap\"),"
            ],
            "field_order": ["purpose", "philosophy"],
            "note": "Both C5 fields are defined (not required). Present when the file has design intent worth preserving beyond what comments convey."
        },

        "cannot": [
            {
                "construct": "C5 fields before C4 in METADATA",
                "reason": "Section order: C1 -> C2 -> C3 -> C4 -> C5. Intent follows dependencies.",
                "rust_signal": "C5\\. appearing before C4\\."
            },
            {
                "construct": "C5.purpose duplicating I3.brief",
                "reason": "I3.brief is WHAT the file does. C5.purpose is WHY it exists. They complement, not duplicate.",
                "rust_signal": "N/A — semantic check"
            }
        ],

        "scaffold": {
            "slice_full": "// C5 Intent — design purpose\n    (\"C5.purpose\", \"{purpose}\"),\n    (\"C5.philosophy\", \"{philosophy}\"),",
            "slice_minimal": "(\"C5.purpose\", \"{purpose}\"),",
            "note": "purpose alone is the common case. philosophy is for files with strong design rationale worth preserving."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C5 in Rust: the counsel. purpose tells you what the file aims to achieve. philosophy tells you why it was designed this way. Code without intent is code without direction — it works, but nobody knows why it was built that way.",
    "_X5_scripture": "Proverbs 19:21 — There are many devices in a man's heart; nevertheless the counsel of the LORD, that shall stand."
}
