{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-go-metadata-metadata-context-c6-roadmap",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Metadata Context -- C6 Roadmap (Trajectory) -- Go Content",
    "_P5_brief": "Go-specific content for C6 Roadmap fields. current, planned, limitations carried in var Metadata = [][2]string slice. Where this file is going.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/metadata-context/c6-roadmap.jsonc",
    "format": "go",

    "sub_container": {
        "tag": "C6",
        "label": "C6 Roadmap -- Trajectory (Go)",
        "parent": "MetadataContext",

        "go_construct": "C6 entries in var Metadata = [][2]string{...}",
        "go_visibility": "exported -- within exported Metadata var",
        "go_note": "C6 fields are defined (not required) -- not every file has a roadmap. When present, they prevent the 'what was the plan here?' question.",

        "field_format": {
            "key_pattern": "C6.{field}",
            "examples": ["C6.current", "C6.planned", "C6.limitations"],
            "note": "C6 section follows C5 in the Metadata slice."
        },

        "can": [
            {
                "construct": "C6 fields in Metadata slice",
                "description": "Roadmap entries -- trajectory and deferred work",
                "patterns": [
                    "\t// C6 Roadmap -- trajectory",
                    "\t{\"C6.current\", \"Phase 1 complete\"},",
                    "\t{\"C6.planned\", \"Phase 2: add caching layer\"},",
                    "\t{\"C6.limitations\", \"No concurrent access support yet\"},"
                ],
                "note": "Section comment '// C6 Roadmap -- trajectory' precedes the C6 entries."
            }
        ],

        "scaffold": {
            "c6_fields": "\t// C6 Roadmap -- trajectory\n\t{\"C6.current\", \"{current}\"},\n\t{\"C6.planned\", \"{planned}\"},"
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "C6 Roadmap in Go -- the vision. current, planned, limitations in [][2]string pairs. Without C6, every TODO is a mystery and every limitation looks like a bug.",
    "_X5_scripture": "Habakkuk 2:3 -- For the vision is yet for an appointed time, but at the end it shall speak, and not lie."
}
