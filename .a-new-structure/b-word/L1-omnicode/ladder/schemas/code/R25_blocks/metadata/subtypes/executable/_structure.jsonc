{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-metadata-subtypes-executable",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Executable Form",
    "_P5_brief": "Executable form. Entry point binary. Orchestrates via main/run pattern. Has METADATA (no doc-comments), SETUP with imports, BODY with orchestration logic, CLOSING with execution entry point.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "sub_container": {
        "tag": "executable",
        "label": "Executable — Entry Point Form",
        "parent": "Subtypes",
        "I2_subtype": "executable",

        "purpose": "Entry point binary. Orchestrates via main/run pattern. Delegates to libraries and modules.",
        "distinguisher": "The only form with Ce (Execution) REQUIRED. Thin orchestration layer — logic belongs in libraries, not here.",

        "has_public_api": false,
        "has_tests_block": false,

        "section_availability": {

            "METADATA": {
                "Directives":      "REQUIRED",
                "CommentBlock":    "REQUIRED",
                "DocComments":     "RESERVED",
                "PragmaIdentity":  "REQUIRED",
                "MetadataContext":  "REQUIRED",
                "Subtypes":        "REQUIRED"
            },

            "SETUP": {
                "Imports":       "REQUIRED",
                "Modules":       "RESERVED",
                "Constants":     "REQUIRED",
                "Statics":       "AVAILABLE",
                "TypeAliases":   "RESERVED",
                "ErrorTypes":    "AVAILABLE",
                "CoreTypes":     "REQUIRED",
                "TraitDefs":     "RESERVED",
                "Macros":        "RESERVED",
                "FeatureGates":  "AVAILABLE"
            },

            "BODY": {
                "IdentityAccess":       "AVAILABLE",
                "TraitImplementations": "RESERVED",
                "Constructors":         "AVAILABLE",
                "CoreLogic":            "REQUIRED",
                "Queries":              "RESERVED",
                "OutputDisplay":        "AVAILABLE",
                "FreeFunctions":        "AVAILABLE",
                "Helpers":              "AVAILABLE",
                "Tests":                "RESERVED"
            },

            "CLOSING": {
                "Cv": "RESERVED",
                "Ce": "REQUIRED",
                "Cc": "AVAILABLE",
                "X1": "REQUIRED",
                "X2": "AVAILABLE",
                "X3": "AVAILABLE",
                "X4": "REQUIRED",
                "X5": "REQUIRED"
            }
        },

        "cascade": {
            "note": "Executable form is narrow by design. Ce (Execution) is REQUIRED — this is where main() lives. Cv (Validation/tests) is RESERVED because executables delegate testing to the libraries they orchestrate. DocComments RESERVED — no public API to document.",
            "principle": "Let us rise up and build. The executable is the builder — it orchestrates, delegates, and executes. Thin by design, powerful by delegation."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Executable is the point of action. It rises up and builds — not by doing everything itself, but by orchestrating libraries and modules. main() is the command. The rest is delegation.",
    "_X5_scripture": "Nehemiah 2:18 — Then I told them of the hand of my God which was good upon me... And they said, Let us rise up and build. So they strengthened their hands for this good work."
}
