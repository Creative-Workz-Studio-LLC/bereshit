{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-format-blocks-rust-metadata-subtypes-library",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-content",
    "_P2_role": "sub-container",
    "_P5_title": "Subtypes — Library Form — Rust Content",
    "_P5_brief": "Rust-specific library form. Crate root exposing public API. File: lib.rs. Requires doc comments, full SETUP with types and traits, BODY with public API surface, CLOSING with validation and tests.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "extends": "structure/parts/metadata/subtypes/library.jsonc",
    "format": "rust",

    "content": {
        "tag": "library",
        "parent": "Subtypes",
        "I2_subtype": "library",

        "file_pattern": "lib.rs",
        "pragma_directive": "//omni:code --rust -library",
        "template_directive": "// #!omni template --rust -library",

        "has_public_api": true,
        "has_tests_block": true,

        "purpose": "Library crate root — exposes public API, holds crate identity. The most complete form with full SETUP, BODY, and CLOSING.",

        "required_sections": {
            "METADATA": ["Directives", "DocComments", "CommentBlock", "PragmaIdentity", "MetadataContext", "Subtypes"],
            "SETUP": ["Imports", "Constants", "CoreTypes"],
            "BODY": ["PublicAPI"],
            "CLOSING": ["Validation", "Tests"]
        },

        "scaffold": {
            "pragma": "//omni:code --rust -library",
            "template": "// #!omni template --rust -library\n\n// ========================================================================\n// METADATA BLOCK [METADATA]\n// ========================================================================\n\n//! {crate_doc_comment}\n//!\n//! # Overview\n//!\n//! {overview}\n\n// {comment_block}\n\npub static PRAGMA: &[(&str, &str)] = &[\n    (\"I1.key\", \"{key}\"),\n    (\"I1.format\", \"rust\"),\n    (\"I1.from\", \"B-seed-code-L0-rust-library\"),\n    (\"I1.at\", \"{at}\"),\n    (\"I2.type\", \"code\"),\n    (\"I2.structure\", \"4-block\"),\n    (\"I2.subtype\", \"library\"),\n    (\"I2.role\", \"{role}\"),\n    (\"I3.file\", \"lib.rs\"),\n    (\"I3.title\", \"{title}\"),\n    (\"I3.brief\", \"{brief}\"),\n];\n\npub static METADATA: &[(&str, &str)] = &[\n    // C1 State\n    (\"C1.version\", \"{version}\"),\n    (\"C1.status\", \"{status}\"),\n    (\"C1.created\", \"{created}\"),\n    (\"C1.updated\", \"{updated}\"),\n    // C2 Attribution\n    (\"C2.organization\", \"CreativeWorkzStudio LLC\"),\n    (\"C2.architect\", \"{architect}\"),\n    // C3 Grounding\n    (\"C3.scripture\", \"{scripture}\"),\n    // C4 Dependencies\n    (\"C4.requires.stdlib\", \"{stdlib_deps}\"),\n    (\"C4.consumers\", \"{consumers}\"),\n    // C5 Intent\n    (\"C5.purpose\", \"{purpose}\"),\n];\n\n// ========================================================================\n// SETUP BLOCK [SETUP]\n// ========================================================================\n\n// --- Imports ---\n\n// --- Constants ---\n\n// --- Core Types ---\n\n// ========================================================================\n// BODY BLOCK [BODY]\n// ========================================================================\n\n// --- Public API ---\n\n// ========================================================================\n// CLOSING BLOCK [CLOSING]\n// ========================================================================\n\n// --- Validation ---\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_pragma_exists() {\n        assert!(!PRAGMA.is_empty());\n    }\n}\n\n// X5: {closing_note}",
            "note": "Library scaffold is the most complete. DocComments (//!) are REQUIRED for public API. Full PRAGMA + METADATA statics. Tests block included."
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Rust library: the most complete form. Builds the house — types, traits, constructors, logic, queries, display, tests. Every room filled with knowledge and understanding. Public API demands documentation and validation.",
    "_X5_scripture": "Proverbs 24:3-4 — Through wisdom is an house builded; and by understanding it is established: And by knowledge shall the chambers be filled with all precious and pleasant riches."
}
