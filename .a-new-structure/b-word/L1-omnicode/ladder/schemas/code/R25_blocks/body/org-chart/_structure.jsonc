{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-body-org-chart",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "BODY Section 0: Org Chart — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Org Chart IS, not how it manifests in any language. See format/blocks/{lang}/body/org-chart.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "OrgChart",
        "position": 0,
        "label": "Org Chart",
        "block": "BODY",
        "overview_text": "Module structure overview, package navigation",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "structural overview",
                "description": "Documenting how the package/module is organized — file responsibilities, relationships",
                "distinguisher": "The table of contents. Navigation, not content."
            },
            {
                "concept": "dependency documentation",
                "description": "Recording which packages this depends on and which depend on it",
                "distinguisher": "The map of relationships. Who talks to whom."
            },
            {
                "concept": "subsection roadmap",
                "description": "Listing which BODY subsections are active in this file and their order",
                "distinguisher": "The menu. Shows what's here before you scroll."
            }
        ],

        "cannot": [
            {
                "concept": "business logic",
                "reason": "Org Chart is for navigation and documentation — not operations",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "type definitions",
                "reason": "Types belong in SETUP, not in the org chart",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "state mutation",
                "reason": "Org Chart is read-only documentation. Mutation belongs in operations.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "identity accessor functions",
                "reason": "Runtime identity functions (pragma(), metadata_get()) are executable code, not documentation. They belong in Identity Access.",
                "defer_to": "BODY.IdentityAccess"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Org Chart",
            "reserved_reason": null,
            "note": "Org Chart is REQUIRED in all forms. Every file needs structural navigation."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "denied",
        "method_call": "denied",
        "self_access": "denied",
        "variable_binding": "denied",
        "conditional_if": "denied",
        "conditional_match": "denied",
        "return_value": "denied",
        "error_propagation": "denied",
        "err_wrap": "denied",
        "ok_wrap": "denied",
        "string_format": "denied"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns denied — org-chart is structural, not behavioral.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Org Chart is structural documentation. It tells you WHERE things are, not WHAT they do. The package's table of contents.",
    "_X5_scripture": "Genesis 1:1 — In the beginning God created the heaven and the earth."
}
