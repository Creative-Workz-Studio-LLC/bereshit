    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "BODY Section 2: Trait Implementations — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Trait Implementations IS, not how it manifests in any language. See format/blocks/{lang}/body/trait-implementations.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "TraitImplementations",
        "position": 2,
        "label": "Trait Implementations",
        "block": "BODY",
        "overview_text": "Fulfilling contracts from SETUP",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "contract fulfillment",
                "description": "Making types honor the behavioral contracts defined in SETUP",
                "distinguisher": "SETUP said 'this behavior is possible.' This section delivers on that promise."
            },
            {
                "concept": "behavioral trait implementations",
                "description": "Iterator, Read, Write, IntoIterator, Index — traits that ADD capabilities to a type. Removing one and the type still works, just does less.",
                "distinguisher": "The test: if removing this impl makes the type LESS CAPABLE (but still functional), it's behavioral → goes here."
            },
            {
                "concept": "custom trait implementations",
                "description": "Fulfilling project-specific behavioral contracts from SETUP §8",
                "distinguisher": "Domain-specific promises kept. Contracts defined in TraitDefs, fulfilled here."
            }
        ],

        "cannot": [
            {
                "concept": "trait definitions",
                "reason": "Defining and fulfilling are separate. Define in SETUP, fulfill here.",
                "defer_to": "SETUP.TraitDefs"
            },
            {
                "concept": "constructors",
                "reason": "Creation is distinct from contract fulfillment",
                "defer_to": "BODY.Constructors"
            },
            {
                "concept": "core business logic",
                "reason": "Trait impls connect structure to behavior. Core logic IS the behavior.",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "completing trait implementations",
                "reason": "Display, Default, Error, From, Clone, PartialEq, PartialOrd — these COMPLETE the type. Removing one makes the type INCOMPLETE, not just less capable. They stay WITH the type in SETUP §6-§7.",
                "defer_to": "SETUP.CoreTypes or SETUP.ErrorTypes"
            },
            {
                "concept": "test-only implementations",
                "reason": "Mock implementations for testing belong with the tests",
                "defer_to": "CLOSING.Cv"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Trait Implementations",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton has no contracts to fulfill yet). REQUIRED in all declared forms."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "granted",
        "method_call": "granted",
        "self_access": "granted",
        "variable_binding": "granted",
        "conditional_if": "granted",
        "conditional_match": "granted",
        "return_value": "granted",
        "error_propagation": "granted",
        "err_wrap": "granted",
        "ok_wrap": "granted",
        "string_format": "granted"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns granted — trait implementations host any code pattern.",

