    "_P2_subtype": "content-character-schema",
    "_P2_role": "content-section",
    "_P5_title": "BODY.Constructors Content Character — What Constructor Content IS",
    "_P5_brief": "Format-independent definition of constructor content character. Constructors are creation functions — they take parameters and return new instances of types defined in SETUP. Syntax varies (new(), From impl, struct literal, malloc+init); the creation-from-parameters pattern doesn't.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "character": {
        "name": "constructors",
        "block": "BODY",
        "position": 3,
        "nature": "creation",

        "description": "Constructor content is where types come into existence as instances. SETUP defines the shape — the struct fields, the enum variants. Constructors take parameters, validate invariants, and return living instances. The content is generative: 'given these inputs, this type now exists.'",

        "invariants": {
            "description": "Properties true of ALL constructor content, regardless of language.",

            "generative": "Constructors always produce a new instance. They take inputs and return an initialized value. The output is always an instance of a type defined in SETUP.",
            "validating": "Non-trivial constructors enforce invariants before returning. A try_new() that accepts invalid state is a bug. Construction is the first line of defense.",
            "parameterized": "Constructors accept external input — arguments, configuration, other instances. What they accept defines what the type needs to exist.",
            "fallible-or-infallible": "Every constructor is explicitly one or the other. Infallible (new) always succeeds. Fallible (try_new, from) can fail with a meaningful error. The distinction is part of the API contract.",
            "non-mutating": "Constructors create, they do not modify existing instances. Once new() returns, the instance is complete. Further changes belong in CoreLogic."
        },

        "content_forms": {
            "description": "What constructor content looks like across languages. Creation-from-parameters is invariant; the mechanism of initialization varies.",

            "rust": {
                "syntax": "pub fn new(field: Type) -> Self { Self { field } } pub fn try_new(input: &str) -> Result<Self, Error> { ... }",
                "grouping": "Infallible constructors first (new), then fallible (try_new, try_from), then builders (Builder::new().field().build())",
                "notes": "Rust constructors are associated functions (no self parameter). new() is conventional but not enforced by the language. Builder pattern uses a separate Builder type with chained methods. From/TryFrom impls may live here or in TraitImplementations."
            },

            "go": {
                "syntax": "func NewMyType(field Type) *MyType { return &MyType{field: field} } func NewMyTypeFromConfig(cfg *Config) (*MyType, error) { ... }",
                "grouping": "Simple NewX() first, then NewXFromY() variants, then functional options pattern",
                "notes": "Go constructors are package-level functions prefixed with New. Return pointer and optional error. Functional options (WithTimeout, WithLogger) provide builder-like flexibility. No language-level constructor concept."
            },

            "c": {
                "syntax": "MyType* my_type_new(int field) { MyType* t = malloc(sizeof(MyType)); t->field = field; return t; } int my_type_init(MyType* t, int field) { ... }",
                "grouping": "Heap constructors (_new) first, then stack initializers (_init), then complex construction with error codes",
                "notes": "C constructors are either allocating (_new returns pointer) or initializing (_init takes pre-allocated pointer). The caller decides heap vs stack. Error handling via return codes, not exceptions. Must pair with _free/_destroy."
            }
        },

        "transpilation_role": {
            "description": "During transpilation, constructor content preserves the creation semantics. The same types get constructed from the same inputs with the same validation — only the allocation and initialization syntax changes.",
            "invariant": ["parameter sets (what inputs each constructor requires)", "validation rules (what invariants are checked before returning)", "fallibility (which constructors can fail and which cannot)"],
            "variable": ["allocation mechanism (stack vs heap vs arena)", "syntax (associated fn vs package function vs prefixed function)", "error reporting (Result vs error return vs int return code)", "builder pattern shape (method chaining vs functional options vs explicit steps)"]
        }
    },

