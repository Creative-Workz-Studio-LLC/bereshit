    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-body-free-functions",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "BODY Section 7: Free Functions — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Free Functions IS, not how it manifests in any language. See format/blocks/{lang}/body/free-functions.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "FreeFunctions",
        "position": 7,
        "label": "Free Functions",
        "block": "BODY",
        "overview_text": "Module-level public utilities",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "standalone utilities",
                "description": "Functions not bound to any type — module-level operations",
                "distinguisher": "No self parameter. Operates on inputs, returns outputs. Stateless."
            },
            {
                "concept": "convenience wrappers",
                "description": "Thin functions combining multiple type operations into one call",
                "distinguisher": "Ergonomics. Making common multi-step operations a single call."
            },
            {
                "concept": "identity registration",
                "description": "register_identity() — wiring this file into a larger identity system",
                "distinguisher": "Only in crate roots and executables. Modules don't self-register."
            }
        ],

        "cannot": [
            {
                "concept": "type methods",
                "reason": "If it takes self/&self/&mut self, it belongs on the type",
                "defer_to": "BODY.CoreLogic or BODY.Queries"
            },
            {
                "concept": "entry points",
                "reason": "main() and run() are execution, not utility",
                "defer_to": "CLOSING.Execution"
            },
            {
                "concept": "test functions",
                "reason": "Tests validate. Free functions operate.",
                "defer_to": "CLOSING.Cv"
            },
            {
                "concept": "output formatting helpers",
                "reason": "Formatting belongs in the output section",
                "defer_to": "BODY.OutputDisplay"
            }
        ],

        "defer": [
            {
                "signal": "function grows large and complex",
                "to": "Extract to a dedicated module",
                "why": "Large free functions often signal a hidden type wanting to emerge"
            }
        ],

        "forms": {
            "bare-bone": "REQUIRED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Free Functions",
            "reserved_reason": null,
            "note": "Free Functions is REQUIRED in all forms. Every file has at least register_identity() or module-level utilities."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "granted",
        "method_call": "granted",
        "self_access": "denied",
        "variable_binding": "granted",
        "conditional_if": "granted",
        "conditional_match": "granted",
        "return_value": "granted",
        "error_propagation": "granted",
        "err_wrap": "granted",
        "ok_wrap": "granted",
        "string_format": "granted"
    },

    "detection_weight": 0.82,
    "_weight_rationale": "|avg| of concept_map: 10G 1D. (10−1)/11 = 9/11 ≈ 0.82. self_access denied (free functions have no self/receiver).",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Free functions are the module's public utilities. Standalone, stateless, serving callers who don't need a type instance.",
    "_X5_scripture": "Galatians 5:13 — By love serve one another."
}
