    "extends": "structure/parts/body/identity-access.jsonc",
    "format": "rust",

    "content": {

        "can": [
            {
                "construct": "pub fn pragma() -> &'static [(&'static str, &'static str)]",
                "description": "Full slice accessor for PRAGMA identity statics",
                "patterns": [
                    "pub fn pragma() -> &'static [(&'static str, &'static str)] {\n    &PRAGMA\n}"
                ],
                "visibility": "pub"
            },
            {
                "construct": "pub fn pragma_get(key: &str) -> Option<&'static str>",
                "description": "Key lookup in PRAGMA statics via iter().find()",
                "patterns": [
                    "pub fn pragma_get(key: &str) -> Option<&'static str> {\n    PRAGMA.iter()\n        .find(|(k, _)| *k == key)\n        .map(|(_, v)| *v)\n}"
                ],
                "visibility": "pub"
            },
            {
                "construct": "pub fn metadata() -> &'static [(&'static str, &'static str)]",
                "description": "Full slice accessor for METADATA identity statics",
                "patterns": [
                    "pub fn metadata() -> &'static [(&'static str, &'static str)] {\n    &METADATA\n}"
                ],
                "visibility": "pub"
            },
            {
                "construct": "pub fn metadata_get(key: &str) -> Option<&'static str>",
                "description": "Key lookup in METADATA statics via iter().find()",
                "patterns": [
                    "pub fn metadata_get(key: &str) -> Option<&'static str> {\n    METADATA.iter()\n        .find(|(k, _)| *k == key)\n        .map(|(_, v)| *v)\n}"
                ],
                "visibility": "pub"
            },
            {
                "construct": "/// doc comments with file-specific usage examples",
                "description": "Examples referencing this file's actual PRAGMA keys",
                "patterns": [
                    "/// Returns the PRAGMA identity slice.\n///\n/// # Example\n/// ```\n/// let p = pragma();\n/// assert_eq!(p[0].0, \"key\");\n/// ```"
                ],
                "visibility": "N/A"
            }
        ],

        "cannot": [
            {
                "construct": "functions that modify identity",
                "reason": "PRAGMA/METADATA are immutable statics — identity is fixed at compile time",
                "defer_to": "N/A — identity is immutable",
                "rust_signal": "fn\\s+set_pragma|fn\\s+update_metadata|&mut.*PRAGMA|&mut.*METADATA"
            },
            {
                "construct": "functions computing derived values from identity",
                "reason": "Keep accessors pure — read-only, no computation",
                "defer_to": "BODY.CoreLogic or BODY.FreeFunctions",
                "rust_signal": "N/A — design judgment"
            },
            {
                "construct": "any function not related to PRAGMA/METADATA access",
                "reason": "IdentityAccess is exclusively about identity static accessors",
                "defer_to": "BODY.CoreLogic or BODY.FreeFunctions",
                "rust_signal": "N/A"
            },
            {
                "construct": "caching or memoization",
                "reason": "The statics are already compile-time — nothing to cache",
                "defer_to": "N/A — unnecessary",
                "rust_signal": "LazyLock|OnceLock|cache|memo"
            }
        ],

        "defer_signals": [
            {
                "pattern": "fn\\s+(?!pragma|metadata)\\w+\\(",
                "to": "BODY.CoreLogic or BODY.FreeFunctions",
                "confidence": "medium",
                "why": "Non-identity function in IdentityAccess section"
            }
        ],

        "scaffold": {
            "empty_module": "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA }\npub fn pragma_get(key: &str) -> Option<&'static str> {\n    PRAGMA.iter().find(|(k, _)| *k == key).map(|(_, v)| *v)\n}\npub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA }\npub fn metadata_get(key: &str) -> Option<&'static str> {\n    METADATA.iter().find(|(k, _)| *k == key).map(|(_, v)| *v)\n}",
            "empty_library": "pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA }\npub fn pragma_get(key: &str) -> Option<&'static str> {\n    PRAGMA.iter().find(|(k, _)| *k == key).map(|(_, v)| *v)\n}\npub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA }\npub fn metadata_get(key: &str) -> Option<&'static str> {\n    METADATA.iter().find(|(k, _)| *k == key).map(|(_, v)| *v)\n}",
            "comment_skeleton": "// pub fn pragma() -> &'static [(&'static str, &'static str)] { &PRAGMA }\n// pub fn pragma_get(key: &str) -> Option<&'static str> { ... }\n// pub fn metadata() -> &'static [(&'static str, &'static str)] { &METADATA }\n// pub fn metadata_get(key: &str) -> Option<&'static str> { ... }"
        }
