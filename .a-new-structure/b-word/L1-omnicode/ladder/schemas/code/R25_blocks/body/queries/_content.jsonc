        "string_format": "granted"
    },

    "detection_weight": 1.00,
    "_weight_rationale": "|avg| of concept_map. All 11 R[5] patterns granted — queries host any code pattern.",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
