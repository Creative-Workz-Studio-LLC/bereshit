    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-blocks-body-constructors",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-section-schema",
    "_P2_role": "container-structure",
    "_P5_title": "BODY Section 3: Constructors — Structure",
    "_P5_brief": "Format-agnostic structure definition. What Constructors IS, not how it manifests in any language. See format/blocks/{lang}/body/constructors.jsonc for language-specific content.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "section": {
        "tag": "Constructors",
        "position": 3,
        "label": "Constructors",
        "block": "BODY",
        "overview_text": "new(), builders, typestate transitions",

        "header": {
            "section_comment": "// {position}. {label}",
            "bracket_format": "[{position}]  {label}{padding}— {overview_text}",
            "separator_style": "dash-72"
        },

        "can": [
            {
                "concept": "instance creation",
                "description": "Functions that bring types into existence — the birth of an instance",
                "distinguisher": "Before this, the type is a blueprint. After this, it's alive."
            },
            {
                "concept": "validated creation",
                "description": "Constructors that verify invariants before returning an instance",
                "distinguisher": "Creation that can fail. try_new() returns Result because birth requires conditions."
            },
            {
                "concept": "builder patterns",
                "description": "Step-by-step construction for types with many optional fields",
                "distinguisher": "When new() would need too many parameters. Build in stages."
            },
            {
                "concept": "typestate transitions",
                "description": "Builder consumes self and returns a DIFFERENT type — compiler prevents using the builder after transition",
                "distinguisher": "The strongest creation pattern. Builder → .transition() → Validated. The type system enforces lifecycle."
            }
        ],

        "cannot": [
            {
                "concept": "simple field assignment",
                "reason": "Trivial new() that just sets fields belongs with the type definition",
                "defer_to": "SETUP.CoreTypes"
            },
            {
                "concept": "mutation operations",
                "reason": "Once created, operating on the instance is CoreLogic's job",
                "defer_to": "BODY.CoreLogic"
            },
            {
                "concept": "read-only queries",
                "reason": "Observation after creation is Queries' domain",
                "defer_to": "BODY.Queries"
            },
            {
                "concept": "type definitions",
                "reason": "The type exists in SETUP. This section brings instances of it to life.",
                "defer_to": "SETUP.CoreTypes"
            }
        ],

        "defer": [
            {
                "signal": "constructor just assigns fields with no validation",
                "to": "SETUP.CoreTypes (simple new())",
                "why": "Trivial creation stays near the type definition"
            }
        ],

        "forms": {
            "bare-bone": "RESERVED",
            "module": "REQUIRED",
            "library": "REQUIRED",
            "executable": "REQUIRED",
            "demo-test": "REQUIRED"
        },

        "ro": {
            "available_label": "Constructors",
            "reserved_reason": null,
            "note": "RESERVED in bare-bone (skeleton has no types to construct yet). REQUIRED in all declared forms."
        }
    },

    "concept_map": {
        "_note": "Transposed from R[5] concept container_maps. granted = pattern expected here. denied = not expected. defer = context-dependent.",

        "function_call": "granted",
        "method_call": "granted",
        "self_access": "defer",
        "variable_binding": "granted",
        "conditional_if": "granted",
        "conditional_match": "granted",
        "return_value": "granted",
        "error_propagation": "granted",
        "err_wrap": "granted",
        "ok_wrap": "granted",
        "string_format": "granted"
    },

    "detection_weight": 0.91,
    "_weight_rationale": "|avg| of concept_map: 10G 1F. 10/11 ≈ 0.91. self_access defers (constructors create, not access existing self).",

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Constructors are birth. SETUP defines what CAN exist. Constructors bring it into existence. CoreLogic operates on the living.",
    "_X5_scripture": "Genesis 2:7 — And the LORD God formed man of the dust of the ground, and breathed into his nostrils the breath of life."
