{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-dotfile-3block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/definitions/omni",
    "_P3_includes": "none",
    "_P3_provides": ["DOTFILE_3BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Dotfile 3-Block Schema",
    "_P5_brief": "Defines how dotfiles (.editorconfig, .gitignore, .gitmessage, .env) implement OmniCode 3-block structure using # comment lines. Configuration data sits between structural comment boundaries.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "dotfile-3block-schema.jsonc",
        "key": "B-definitions-omni-dotfile-3block-schema",
        "title": "Dotfile 3-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define how dotfiles express OmniCode 3-block structure through # comments"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "1 Corinthians 14:40 — Let all things be done decently and in order.",
        "principle": "Dotfiles are invisible infrastructure — the settings nobody sees but everybody depends on. Decency and order in the hidden things reflects character. Structure in dotfiles mirrors structure in the visible codebase."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "base-3block-schema.jsonc — shared $defs for format-independent concepts",
        "consumers": "c-tov/cws-struct/lib/formats/dotfiles.ts — runtime linter implements these rules",
        "cross_format": {
            "makefile_sibling": "b-word/definitions/omni/makefile-4block-schema.jsonc — Makefile 4-block (also comment-based)",
            "toml_sibling": "b-word/definitions/omni/toml-3block-schema.jsonc — TOML 3-block expression",
            "json_sibling": "b-word/definitions/omni/json-3block-schema.jsonc — JSON 3-block expression",
            "relationship": "Same OmniCode concepts, dotfile-native 3-block structure via # comments"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Dotfiles represent 3-block structure through # comment lines:
    //   # ═══...PRAGMA [PRAGMA]═══...     — pragma block boundary
    //   # key: B-seed-data-dotfiles-editorconfig  — pragma field
    //   # ═══...METADATA BLOCK [METADATA]═══...  — metadata block
    //   # --- M1: Identity ---            — metadata section (compact preferred)
    //   # ═══...CONTENT BLOCK [CONTENT]═══...    — content block
    //   # Cc / # Co / # Cv                — content sub-blocks
    //   # ═══...CLOSING BLOCK [CLOSING]═══...    — closing block
    //
    // The comment structure IS the block structure.
    // Configuration data (editor rules, ignore patterns, env vars) sits
    // BETWEEN the structural comments.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How dotfile conventions map to 3-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "Dotfile — key=value pairs (editorconfig), patterns (gitignore), env vars (.env), prose (.gitmessage)",
    "_Cc_key_convention": "Format-specific (editorconfig: lowercase, env: UPPER_SNAKE, gitignore: glob patterns)",

    "format_mapping": {
        "note": "How OmniCode concepts map to dotfile syntax",
        "block_boundaries": "# ═══...BLOCK NAME [TAG]═══... comment lines — same as Makefiles",
        "section_navigation": "# --- MN: Title --- (compact format preferred for dotfiles)",
        "pragma_fields": "# field: value — within PRAGMA block boundaries",
        "content_sub_blocks": "# Cc (config), # Co (operations), # Cv (validation) — sub-block markers within CONTENT",
        "configuration_data": "Format-specific syntax (key=value, patterns, env vars) between structural comments"
    },

    "comment_conventions": {
        "block_boundary": "# ═══════════════════════════════════════════════════════════════",
        "block_tag": "# BLOCK NAME [TAG]",
        "section_compact": "# --- MN: Title ---",
        "section_verbose": "# # M.N Title [TAG]",
        "sub_separator": "# ───────────────────────────────────────────────────────────────",
        "field": "# field: value",
        "pragma_line": "# #!omni data --editorconfig (or --gitignore, --gitmessage, --env)"
    },

    "supported_dotfiles": {
        ".editorconfig": {
            "purpose": "Editor settings — indentation, encoding, line endings",
            "data_format": "INI-like sections with [glob] headers and key = value pairs",
            "content_structure": "Cc: root/global settings, Co: per-filetype sections, Cv: validation rules"
        },
        ".gitignore": {
            "purpose": "Git ignore patterns — what files to exclude from version control",
            "data_format": "Glob patterns, one per line, # comments for explanation",
            "content_structure": "Cc: ignore philosophy, Co: pattern groups by category, Cv: verification"
        },
        ".gitmessage": {
            "purpose": "Git commit message template — consistent commit format",
            "data_format": "Prose template with # comments for guidance",
            "content_structure": "Cc: message format spec, Co: template text, Cv: format rules"
        },
        ".env": {
            "purpose": "Environment variables — runtime configuration",
            "data_format": "KEY=value pairs, # comments for documentation",
            "content_structure": "Cc: env categories, Co: variable groups, Cv: required vars check"
        }
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete dotfile 3-block structure definition.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "dotfile_structure": {

        // ═══════════════════════════════════════════════════════
        // PRAGMA BLOCK — #!omni + P1-P5 fields
        // ═══════════════════════════════════════════════════════

        "pragma_line": {
            "purpose": "OmniCode format declaration",
            "pattern": "# #!omni data --editorconfig (or --gitignore, --gitmessage, --env)",
            "required": true,
            "severity": "warn",
            "note": "First structural line. The --flag identifies which dotfile format."
        },

        "PRAGMA [PRAGMA]": {
            "purpose": "Pragma block start boundary",
            "pattern": "# ═══...PRAGMA [PRAGMA]═══...",
            "required": true,
            "severity": "error"
        },

        "END PRAGMA [END]": {
            "purpose": "Pragma block end boundary",
            "pattern": "# ═══...END PRAGMA [END]═══...",
            "required": true,
            "severity": "warn"
        },

        "pragma_fields": {
            "purpose": "Identity and classification fields within pragma block",
            "format": "# field: value",
            "required_fields": {
                "key": "Bereshit key (B- prefix) — unique identifier",
                "type": "data (dotfiles are always data)",
                "structure": "3-block",
                "title": "Human-readable title"
            },
            "recommended_fields": {
                "from": "Derivation path (template this came from)",
                "at": "Living version (a-01.00 format)",
                "subtype": "editorconfig | gitignore | gitmessage | env",
                "role": "What role this file plays",
                "brief": "One-line description"
            }
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK — M1-M5 sections
        // ═══════════════════════════════════════════════════════

        "METADATA BLOCK [METADATA]": {
            "purpose": "Metadata block start boundary",
            "pattern": "# ═══...METADATA BLOCK [METADATA]═══...",
            "required": true,
            "severity": "error"
        },

        "END METADATA [END]": {
            "purpose": "Metadata block end boundary",
            "pattern": "# ═══...END METADATA [END]═══...",
            "required": true,
            "severity": "warn"
        },

        "metadata_sections": {
            "note": "Compact format (# --- MN: Title ---) is preferred for dotfiles. Verbose also accepted.",

            "M1_identity": {
                "purpose": "M1 IDENTITY — File identity",
                "compact": "# --- M1: Identity ---",
                "verbose": "# # M.1 Identity [IDENTITY]",
                "required": true,
                "severity": "error",
                "expected_fields": ["file", "key", "title", "type"]
            },

            "M2_state": {
                "purpose": "M2 STATE — Version and lifecycle",
                "compact": "# --- M2: State ---",
                "verbose": "# # M.2 State [STATE]",
                "required": true,
                "severity": "error",
                "expected_fields": ["version", "status", "created", "updated"]
            },

            "M3_attribution": {
                "purpose": "M3 ATTRIBUTION — Authorship",
                "compact": "# --- M3: Attribution ---",
                "verbose": "# # M.3 Attribution [ATTRIBUTION]",
                "required": true,
                "severity": "error",
                "expected_fields": ["architect", "implementation"]
            },

            "M4_grounding": {
                "purpose": "M4 GROUNDING — Biblical foundation",
                "compact": "# --- M4: Grounding ---",
                "verbose": "# # M.4 Grounding [GROUNDING]",
                "required": true,
                "severity": "error",
                "expected_fields": ["scripture", "principle"]
            },

            "M5_dependencies": {
                "purpose": "M5 DEPENDENCIES — Dependency graph",
                "compact": "# --- M5: Dependencies ---",
                "verbose": "# # M.5 Dependencies [DEPENDENCIES]",
                "required": true,
                "severity": "error",
                "expected_fields": ["requires", "consumers"]
            }
        },

        // ═══════════════════════════════════════════════════════
        // CONTENT BLOCK — Cc/Co/Cv sub-blocks
        // ═══════════════════════════════════════════════════════

        "CONTENT BLOCK [CONTENT]": {
            "purpose": "Content block start boundary",
            "pattern": "# ═══...CONTENT BLOCK [CONTENT]═══...",
            "required": true,
            "severity": "error"
        },

        "content_sub_blocks": {
            "note": "Three sub-block markers organize content within the CONTENT block.",

            "Cc": {
                "purpose": "Content Configurations — settings, format specs, category definitions",
                "marker": "# Cc or # --- Cc",
                "required": true,
                "severity": "warn"
            },

            "Co": {
                "purpose": "Content Operations — the actual configuration data groups",
                "marker": "# Co or # --- Co",
                "required": true,
                "severity": "warn"
            },

            "Cv": {
                "purpose": "Content Validation — verification rules, expected state",
                "marker": "# Cv or # --- Cv",
                "required": true,
                "severity": "warn"
            }
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING BLOCK — policy, reference, guidance
        // ═══════════════════════════════════════════════════════

        "CLOSING BLOCK [CLOSING]": {
            "purpose": "Closing block start boundary",
            "pattern": "# ═══...CLOSING BLOCK [CLOSING]═══...",
            "required": true,
            "severity": "error"
        },

        "END CLOSING [END]": {
            "purpose": "Closing block end boundary",
            "pattern": "# ═══...END CLOSING [END]═══...",
            "required": true,
            "severity": "warn"
        },

        "closing_sections": {
            "X1_policy": {
                "purpose": "X1 POLICY — Modification guidelines",
                "compact": "# --- X1: Policy ---",
                "verbose": "# # X.1 Policy [POLICY]",
                "required": true,
                "severity": "error",
                "expected_content": ["never", "careful", "safe"]
            },

            "X2_extension": {
                "purpose": "X2 EXTENSION — Future ideas",
                "compact": "# --- X2: Extension ---",
                "verbose": "# # X.2 Extension [EXTENSION]",
                "optional": true
            },

            "X3_troubleshooting": {
                "purpose": "X3 TROUBLESHOOTING — Common problems",
                "compact": "# --- X3: Troubleshooting ---",
                "verbose": "# # X.3 Troubleshooting [TROUBLESHOOTING]",
                "optional": true
            },

            "X4_reference": {
                "purpose": "X4 REFERENCE — Quick lookup",
                "compact": "# --- X4: Reference ---",
                "verbose": "# # X.4 Reference [REFERENCE]",
                "required": true,
                "severity": "error"
            },

            "X5_note": {
                "purpose": "X5 NOTE — Final guidance",
                "compact": "# --- X5: Note ---",
                "verbose": "# # X.5 Note [NOTE]",
                "required": true,
                "severity": "error",
                "expected_content": ["note", "scripture", "anchor"]
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Dotfile validation is done by dotfiles.ts handler.
    // This section documents the validation contract.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint dotfiles <file>",
    "_Cv_expected_state": "All block boundaries present in correct order (METADATA < CONTENT < CLOSING) with required sections and Cc/Co/Cv sub-blocks.",

    "validation_contract": {
        "pragma": {
            "required_markers": ["PRAGMA [PRAGMA]"],
            "recommended_markers": ["END PRAGMA [END]"],
            "required_fields": ["key", "type", "structure", "title"],
            "recommended_fields": ["from", "at", "subtype", "role", "brief"],
            "structure_value": "3-block"
        },
        "metadata": {
            "required_markers": ["METADATA BLOCK [METADATA]"],
            "recommended_markers": ["END METADATA [END]"],
            "required_sections": ["M1", "M2", "M3", "M4", "M5"],
            "note": "All five base sections required for dotfiles (no optional extension sections)"
        },
        "content": {
            "required_markers": ["CONTENT BLOCK [CONTENT]"],
            "required_sub_blocks": ["Cc", "Co", "Cv"],
            "note": "Sub-block markers checked via regex: ^#\\s+(Cc|Co|Cv)\\b or ^#\\s+---\\s*(Cc|Co|Cv)\\b"
        },
        "closing": {
            "required_markers": ["CLOSING BLOCK [CLOSING]"],
            "recommended_markers": ["END CLOSING [END]"],
            "required_tags": ["POLICY", "REFERENCE", "NOTE"],
            "optional_tags": ["EXTENSION", "TROUBLESHOOTING"]
        },
        "block_order": {
            "rule": "METADATA < CONTENT < CLOSING",
            "note": "Checked by position of block boundary markers"
        },
        "cross_refs": {
            "P1_key_vs_M1_key": "Pragma key field must match Metadata M1 key field",
            "P5_title_vs_M1_title": "Pragma title field should match Metadata M1 title field"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Let all things be done decently and in order. — 1 Corinthians 14:40",
    "_X1_never": [
        "Remove block boundary requirements (METADATA, CONTENT, CLOSING)",
        "Drop Cc/Co/Cv sub-block requirement from CONTENT",
        "Change the # comment convention for structural markers"
    ],
    "_X1_careful": [
        "Adding new supported dotfile types (new basenames in handler registration)",
        "Changing required metadata sections (M1-M5 all required for dotfiles)",
        "Modifying content sub-block detection patterns"
    ],
    "_X1_safe": [
        "Adding descriptions and documentation to section definitions",
        "Adding supported_dotfiles entries for new file types",
        "Adding examples to structural element definitions"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Transform capability — auto-generate missing block boundaries",
        "Format-specific validation (editorconfig syntax, gitignore patterns, env var names)",
        "Cross-reference with project .editorconfig ↔ Makefile settings consistency"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/definitions/omni/base-3block-schema.jsonc — Base concepts (parent)",
        "b-word/definitions/omni/makefile-4block-schema.jsonc — Makefile sibling (also comment-based)",
        "b-word/definitions/omni/toml-3block-schema.jsonc — TOML sibling schema",
        "b-word/definitions/omni/json-3block-schema.jsonc — JSON sibling schema",
        "b-word/seed/data/L0/dotfiles/ — Dotfile seed templates (canonical examples)",
        "c-tov/cws-struct/lib/formats/dotfiles.ts — Runtime linter (implements these rules)"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Dotfiles are the hidden infrastructure — the settings nobody sees but everybody depends on. .editorconfig shapes how code looks. .gitignore shapes what gets preserved. .gitmessage shapes how history reads. .env shapes how systems run. Structure in these invisible files reflects the same order God brought to the invisible foundations of creation.",
    "_X5_scripture": "Let all things be done decently and in order. — 1 Corinthians 14:40",
    "_X5_anchor": "Comments are structure. Structure is Genesis 1. Order in the hidden things reflects character.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
