{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-toml-3block-schema",
    "_P1_from": "b-word/seed/data/json/config.jsonc",
    "_P1_at": "a-02.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas",
    "_P3_includes": "none",
    "_P3_provides": ["TOML_3BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "TOML 3-Block Schema",
    "_P5_brief": "Defines how TOML implements OmniCode 3-block structure using nested tables. Uses unified I/C metadata (I1-I4, C1-C7), content Cc/Co/Cv zones, and X1-X5 closing with required/defined classification.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "toml-3block-schema.jsonc",
        "key": "B-definitions-omni-toml-3block-schema",
        "title": "TOML 3-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define TOML-native representation of OmniCode 3-block structure with unified I/C metadata"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-16"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING — "For God is not the author of confusion, but of peace."
    //   — 1 Corinthians 14:33
    "_M4_grounding": {
        "scripture": "1 Corinthians 14:33 — For God is not the author of confusion, but of peace.",
        "principle": "TOML brings order through explicit structure — nested tables map directly to the conceptual hierarchy. Each table IS the section it represents."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "base-3block-schema.jsonc — shared $defs for format-independent concepts",
        "consumers": "c-tov/cws-struct/lib/formats/toml.ts — runtime linter implements these rules",
        "cross_format": {
            "base": "b-word/L1-omnicode/ladder/schemas/base-3block-schema.jsonc — shared concepts",
            "json_sibling": "b-word/L1-omnicode/ladder/schemas/json-3block-schema.jsonc — JSON expression of same structure",
            "relationship": "Same 3-block concepts, TOML-native tables instead of flat _ keys"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // TOML represents 3-block structure through nested tables:
    //   [_metadata]              — metadata block root
    //   [_metadata.I1_core]      — I.1 section within metadata
    //   [_metadata.C1_state]     — C.1 section within metadata
    //   [_metadata._contract]    — structural self-description
    //   [_content]               — content block header
    //   [_closing.X1_policy]     — X.1 section within closing
    //
    // The table hierarchy IS the block structure.
    // No separators needed — tables are self-delimiting.
    //
    // NOTE: Old _pragma block (P1-P5) merged into _metadata as I1-I4.
    //       Old M1-M5 metadata replaced by C1-C7 context.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How TOML conventions map to 3-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "TOML — UTF-8, LF line endings, nested tables for hierarchy",
    "_Cc_key_convention": "lowercase_with_underscores, match Go struct field tags",

    "format_mapping": {
        "note": "How OmniCode concepts map to TOML syntax",
        "block_boundaries": "Table headers ([_metadata], [_content], [_closing]) — self-delimiting",
        "section_navigation": "Dotted tables ([_metadata.I1_core], [_metadata.C3_grounding]) — hierarchy via dots",
        "separators": "Block comment banners (# ═══...) — visual only, not structural",
        "data_keys": "Simple key = value pairs within tables",
        "naming_patterns": {
            "metadata": "I{N}_{name} for identity, C{N}_{name} for context, _{name} for meta-sections",
            "closing": "X{N}_{name} for closing sections, _{name} for meta-sections",
            "metadata_regex": "/^(?:I\\d+_[a-z][a-z_]*|C\\d+_[a-z][a-z_]*|_[a-z][a-z_]*)$/",
            "closing_regex": "/^(?:X\\d+_[a-z][a-z_]*|_[a-z][a-z_]*)$/"
        }
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete TOML table structure definition.
    // Each entry maps a TOML table path to its purpose,
    // the base schema $def it implements, and field requirements.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "toml_structure": {

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK — [_metadata] tree
        // ═══════════════════════════════════════════════════════
        //
        // Unified I/C structure: Identity (I1-I4) + Context (C1-C7) + _contract
        // OLD pragma (P1-P5) merged into metadata as I1-I4.
        // OLD metadata (M1-M5) replaced by C1-C4 (required) + C5-C7 (extension).

        // ─── I — Identity: What IS this file ───

        "[_metadata.I1_core]": {
            "purpose": "I.1 CORE — File identity [REQUIRED]",
            "required_keys": ["key", "format", "from", "at"],
            "implements": "$defs/I1_core",
            "note": "key = Bereshit key (B- prefix), format = @omni declaration, from = derivation path, at = lifecycle position"
        },

        "[_metadata.I2_family]": {
            "purpose": "I.2 FAMILY — Classification [REQUIRED]",
            "required_keys": ["type", "structure"],
            "defined_keys": ["subtype", "role"],
            "implements": "$defs/I2_family",
            "note": "type = data|code|documentation, structure = 3-block|4-block|5-block"
        },

        "[_metadata.I3_instance]": {
            "purpose": "I.3 INSTANCE — File details [REQUIRED]",
            "required_keys": ["file", "title"],
            "defined_keys": ["component", "path", "provides", "brief"],
            "implements": "$defs/I3_instance",
            "note": "provides = array of UPPER_SNAKE capability constants"
        },

        "[_metadata.I4_architecture]": {
            "purpose": "I.4 ARCHITECTURE — Scaling context [EXTENSION]",
            "optional_keys": ["layers", "anchor"],
            "implements": "$defs/I4_architecture"
        },

        // ─── C — Context: What do I need to KNOW ───

        "[_metadata.C1_state]": {
            "purpose": "C.1 STATE — Version and lifecycle [REQUIRED]",
            "required_keys": ["version", "status"],
            "defined_keys": ["created", "updated"],
            "implements": "$defs/C1_state",
            "note": "version = living version pattern, dates = YYYY-MM-DD"
        },

        "[_metadata.C2_attribution]": {
            "purpose": "C.2 ATTRIBUTION — Authorship [REQUIRED]",
            "required_keys": ["organization"],
            "defined_keys": ["architect", "implementation", "copyright"],
            "implements": "$defs/C2_attribution"
        },

        "[_metadata.C3_grounding]": {
            "purpose": "C.3 GROUNDING — Biblical foundation [REQUIRED]",
            "required_keys": ["scripture"],
            "defined_keys": ["principle", "anchor"],
            "implements": "$defs/C3_grounding"
        },

        "[_metadata.C4_dependencies]": {
            "purpose": "C.4 DEPENDENCIES — Dependency graph [REQUIRED]",
            "required_keys": ["requires", "consumers"],
            "defined_keys": ["integration", "if_missing"],
            "implements": "$defs/C4_dependencies"
        },

        "[_metadata.C4_dependencies.related]": {
            "purpose": "Related data — parent/children relationships",
            "optional_keys": ["parent", "children"],
            "note": "Nested table under C4"
        },

        "[_metadata.C4_dependencies.cross_format]": {
            "purpose": "Cross-format relationships",
            "optional_keys": ["role", "note", "jsonc", "relationship"],
            "note": "How this TOML file relates to JSON/JSONC siblings"
        },

        "[_metadata.C5_intent]": {
            "purpose": "C.5 INTENT — Purpose, design philosophy [EXTENSION]",
            "optional": true,
            "implements": "$defs/C5_intent"
        },

        "[_metadata.C5_intent.key_features]": {
            "purpose": "Key features of this file",
            "optional": true,
            "note": "Nested table under C5"
        },

        "[_metadata.C6_roadmap]": {
            "purpose": "C.6 ROADMAP — History, current, planned [EXTENSION]",
            "optional": true,
            "implements": "$defs/C6_roadmap"
        },

        "[_metadata.C7_classification]": {
            "purpose": "C.7 CLASSIFICATION — Tags and categorization [EXTENSION]",
            "optional": true,
            "implements": "$defs/C7_classification"
        },

        "[_metadata._contract]": {
            "purpose": "Structural self-description — declares what this file's metadata/closing contract is [EXTENSION]",
            "optional_keys": ["required_identity", "required_context", "extension_identity", "extension_context", "required_closing", "defined_closing", "valid_patterns", "rule"],
            "implements": "$defs/_contract",
            "note": "When present, the linter cross-validates contract fields against reality"
        },

        // ═══════════════════════════════════════════════════════
        // CONTENT BLOCK — [_content] + data tables
        // ═══════════════════════════════════════════════════════
        //
        // CONTENT IS the data. METADATA says what it IS.
        // CONTENT says what it HOLDS. CLOSING says what to PROTECT.
        //
        // Three zones always in this order:
        //   Cc → Co → Cv (definition_flow)

        "[_content]": {
            "purpose": "Content block header — format, conventions, and zone labels",
            "principle": "CONTENT is the entire middle of a 3-block file. No SETUP/BODY split — zones organize by concern instead.",
            "required": true,
            "severity": "error",
            "required_keys": ["Cc", "Co", "Cv"],
            "defined_keys": ["format", "key_convention", "constraint", "ordering"],
            "note": "Cc/Co/Cv are label strings naming the three content zones. ordering = 'definition_flow' documents the zone sequence. Actual data follows in separate tables."
        },

        // ─── Zone Ordering ───
        //
        // Unlike Rust 4-block where BODY subsections vary by subtype,
        // TOML 3-block zones are universal. Every TOML config follows
        // the same Cc → Co → Cv flow.

        "zone_ordering": {
            "ordering_principle": "definition_flow",
            "principle_description": "Define first. Configure second. Validate last. You can't validate what you haven't defined. You can't configure what doesn't exist.",

            "zones": {
                "Cc": {
                    "position": 1,
                    "name": "Content Configurations",
                    "tag": "[CONFIG]",
                    "purpose": "Define what EXISTS — static structure the config provides",
                    "production_note": "Cc sections rarely change at runtime. They describe the config's skeleton: identity, settings, resources."
                },
                "Co": {
                    "position": 2,
                    "name": "Content Operations",
                    "tag": "[OPS]",
                    "purpose": "Define what HAPPENS — runtime behavior, operational patterns, integrations",
                    "production_note": "Co sections may vary by environment. Production vs development, local vs cloud. Co is the config's muscle."
                },
                "Cv": {
                    "position": 3,
                    "name": "Content Validation",
                    "tag": "[VALIDATE]",
                    "purpose": "Define what's CORRECT — schema constraints, health scoring, content rules",
                    "production_note": "Cv uses _ prefix tables ([_validation]) because validation is meta-content. The config validates itself — Cv makes that explicit."
                }
            },

            "subsections": {
                "Cc.1": {
                    "position": 1,
                    "tag": "IDENTITY",
                    "table": "[identity]",
                    "classification": "REQUIRED",
                    "purpose": "What IS this config? Name, version, type",
                    "production_note": "Every config MUST have identity. name + version are the minimum viable contract. Without identity, the config is anonymous data — tooling can't discover, version, or reference it.",
                    "required_in": "all"
                },
                "Cc.2": {
                    "position": 2,
                    "tag": "SETTINGS",
                    "table": "[settings]",
                    "classification": "DEFINED",
                    "purpose": "Primary configuration values — the most-touched section",
                    "production_note": "Design for the operator who changes values at 2am. Clear names, documented ranges, sensible defaults. If a setting needs a comment to explain it, the name might be wrong.",
                    "required_in": "configs with tunable values"
                },
                "Cc.3": {
                    "position": 3,
                    "tag": "RESOURCES",
                    "table": "[resources]",
                    "alt_tables": ["[resources.paths]", "[resources.limits]"],
                    "classification": "DEFINED",
                    "purpose": "Paths, limits, constraints — the guardrails",
                    "production_note": "Resources define boundaries. If a limit has no upper bound documented, someone WILL hit it. Common nesting: resources.paths, resources.limits.",
                    "required_in": "configs with paths or limits"
                },
                "Co.1": {
                    "position": 4,
                    "tag": "BEHAVIOR",
                    "table": "[behavior]",
                    "classification": "DEFINED",
                    "purpose": "Runtime modes and toggles — HOW the system runs",
                    "production_note": "Behavior controls HOW the system runs, not WHAT it is. Keep separate from Cc because behavior is deployment-specific, not config-specific. log_level, debug_mode, strict_mode change per-environment.",
                    "required_in": "configs with runtime modes"
                },
                "Co.2": {
                    "position": 5,
                    "tag": "PATTERNS",
                    "table": "varies",
                    "alt_tables": ["[parent.child]", "[[handlers]]", "[integrations]"],
                    "classification": "DEFINED",
                    "purpose": "Structural examples (root template) or integration config (children)",
                    "production_note": "In root template: demonstrates TOML patterns (nested tables, array-of-tables). In children: external service configuration (database, cache, API endpoints). Remove pattern examples when instantiating.",
                    "required_in": "root template (patterns), service configs (integrations)"
                },
                "Cv.1": {
                    "position": 6,
                    "tag": "VALIDATION",
                    "table": "[_validation]",
                    "alt_tables": ["[_validation.schema]", "[_validation.schema.fields.*]", "[_validation.health_scoring]", "[_validation.content]"],
                    "classification": "REQUIRED",
                    "purpose": "Schema, health scoring, content rules — the config's immune system",
                    "production_note": "Every config MUST have validation. At minimum: a parse command. schema.required tells tooling which sections MUST exist. health_scoring weights quality gates. content rules constrain values to valid enums and ranges.",
                    "required_in": "all"
                }
            },

            "extension_zones": {
                "pattern": "[_extensions.{cc,co,cv}]",
                "purpose": "Experimental patterns that haven't earned promotion into a named subsection",
                "production_note": "Extensions sit at the end of their parent zone. When a pattern proves stable, promote it into a numbered subsection."
            }
        },

        // ─── Table Definitions ───
        //
        // Each entry maps a TOML table path to its purpose,
        // requirements, and the base schema $def it implements.

        "[identity]": {
            "purpose": "Cc.1 IDENTITY — What this config IS [REQUIRED in Cc zone]",
            "required_keys": ["name", "version"],
            "defined_keys": ["description", "type"],
            "implements": "$defs/content_identity",
            "production_note": "name + version = minimum viable identity. description and type enhance discoverability but aren't structural requirements."
        },

        "[settings]": {
            "purpose": "Cc.2 SETTINGS — Primary configuration values [DEFINED in Cc zone]",
            "note": "Keys are domain-specific. No universal required_keys — the config's _validation.schema.fields.settings declares its own contract.",
            "production_note": "Most-modified section. Favor flat key=value over deeply nested tables. Group related settings with comments, not sub-tables."
        },

        "[resources]": {
            "purpose": "Cc.3 RESOURCES — Paths, limits, constraints [DEFINED in Cc zone]",
            "note": "Common nested tables: resources.paths, resources.limits",
            "production_note": "Nesting is appropriate here — paths and limits are distinct concerns. Always document units (bytes, ms, count) and valid ranges."
        },

        "[behavior]": {
            "purpose": "Co.1 BEHAVIOR — Runtime modes and toggles [DEFINED in Co zone]",
            "note": "Keys are domain-specific (logging, runtime, features)",
            "production_note": "Behavior should be environment-overridable. Design keys so env vars work naturally: APP_BEHAVIOR_LOG_LEVEL=debug."
        },

        "[integrations]": {
            "purpose": "Co.2 INTEGRATIONS — External service configuration [DEFINED in Co zone]",
            "note": "Common nested tables: integrations.database, integrations.cache",
            "production_note": "Each integration is a nested table. Credentials go in env vars, not config files. Config holds connection parameters (host, port, pool_size)."
        },

        "[_extensions]": {
            "purpose": "Extension zones — experimental patterns [OPTIONAL]",
            "note": "Three sub-tables: [_extensions.cc], [_extensions.co], [_extensions.cv]. May be promoted into main sections.",
            "production_note": "Extensions are incubators. When you're not sure where a new section belongs, put it in extensions. Promotion path: _extensions.cc.feature → [feature] in Cc zone."
        },

        "[_validation]": {
            "purpose": "Cv.1 VALIDATION — Schema, health scoring, content rules [REQUIRED in Cv zone]",
            "required_keys": ["commands"],
            "defined_keys": ["schema"],
            "implements": "$defs/content_validation",
            "production_note": "_ prefix because validation is meta-content. commands = array of shell commands to verify the file. Minimum bar: one parse check."
        },

        "[_validation.schema]": {
            "purpose": "Schema constraints — self-describing contract",
            "defined_keys": ["required", "defined", "optional", "fields"],
            "note": "'fields' enables per-section field requirements: [_validation.schema.fields.identity] → required = ['name', 'version']",
            "production_note": "The schema section makes the config self-describing. required sections MUST exist. defined sections SHOULD exist. optional sections MAY exist. Linter enforces this hierarchy."
        },

        "[_validation.schema.fields.*]": {
            "purpose": "Per-section field requirements",
            "optional_keys": ["required", "defined"],
            "note": "Each entry declares which fields are required/defined for a content section. Linter cross-validates these against reality.",
            "production_note": "Scaling signal: when you add a new content section, add its field requirements here. The self-describing contract is only as good as its completeness."
        },

        "[_validation.health_scoring]": {
            "purpose": "Health scoring criteria — weights summing to 100",
            "optional_keys": ["total", "correct_structure", "valid_configuration", "useful_documentation", "code_integration"],
            "production_note": "Weights are a design signal. If correct_structure is 30 and valid_configuration is 40, you're saying data quality matters more than structural compliance for this config."
        },

        "[_validation.content]": {
            "purpose": "Content-specific validation rules — enums, ranges, ordering",
            "note": "Domain-specific constraints (e.g., mode_valid = ['development', 'production'])",
            "production_note": "Content rules constrain VALUES, not STRUCTURE. mode_valid lists legal enum values. log_levels defines the severity ladder. Range constraints go here too."
        },

        // ─── Production Design ───

        "production_design": {
            "principle": "CONTENT in 3-block is the full middle — no SETUP/BODY split. Zones (Cc/Co/Cv) organize by concern. definition_flow ensures logical order.",
            "scaling_signal": "When a zone has 4+ subsections, consider whether the config should split into separate files or whether a subsection should become its own config.",
            "testing_pattern": "Linter validates: (1) zone labels exist in [_content], (2) required tables present, (3) required keys in required tables, (4) value patterns match, (5) zone ordering correct.",
            "refactoring_signal": "If Cc and Co sections are tightly coupled (settings depend on behavior values), the config may be trying to do too much. Split by concern."
        },

        // ─── Placement Rules ───

        "placement_rules": {
            "must_be_in_content": [
                "Data the consumer reads at startup (identity, settings, resources)",
                "Runtime behavior configuration (behavior, integrations)",
                "Self-describing schema and validation rules (_validation)",
                "Health scoring weights (_validation.health_scoring)"
            ],
            "must_be_in_closing": [
                "Modification guidelines (X1_policy: never/careful/safe)",
                "Human-facing troubleshooting (X3_troubleshooting)",
                "File reference links (X4_reference)",
                "Final anchor and scripture (X5_note)"
            ],
            "gray_area": [
                {
                    "item": "health_scoring",
                    "convention": "CONTENT (Cv) — tooling reads it, so it's operational data",
                    "alternative": "Could live in CLOSING as quality guidance for humans"
                },
                {
                    "item": "extension_plans",
                    "convention": "CLOSING (X2_extension) — future ideas are human guidance",
                    "alternative": "Could live in _extensions as experimental data"
                }
            ]
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING BLOCK — [_closing] tree
        // ═══════════════════════════════════════════════════════
        //
        // Classification:
        //   REQUIRED: X1_policy, X5_note — every file needs guardrails and an anchor
        //   DEFINED:  X2_extension, X3_troubleshooting, X4_reference — expected, info if missing
        //   TEMPLATE: X6_template — only in seed/template files

        "[_closing.X1_policy]": {
            "purpose": "X.1 POLICY — Modification guidelines [REQUIRED]",
            "required_keys": ["never", "careful", "safe"],
            "defined_keys": ["scripture"],
            "implements": "$defs/X1_policy"
        },

        "[_closing.X2_extension]": {
            "purpose": "X.2 EXTENSION — Future ideas [DEFINED]",
            "optional": true,
            "defined_keys": ["planned", "considered"],
            "implements": "$defs/X2_extension"
        },

        "[_closing.X3_troubleshooting]": {
            "purpose": "X.3 TROUBLESHOOTING — Common problems [DEFINED]",
            "optional": true,
            "defined_keys": ["scripture"],
            "note": "Keys are problem descriptions, values are solutions",
            "implements": "$defs/X3_troubleshooting"
        },

        "[_closing.X4_reference]": {
            "purpose": "X.4 REFERENCE — Quick lookup [DEFINED]",
            "optional": true,
            "defined_keys": ["related_files", "required_sections", "validate", "env_pattern"],
            "implements": "$defs/X4_reference"
        },

        "[_closing.X5_note]": {
            "purpose": "X.5 NOTE — Final anchor [REQUIRED]",
            "required_keys": ["note", "scripture"],
            "defined_keys": ["anchor"],
            "implements": "$defs/X5_note"
        },

        "[_closing.X6_template]": {
            "purpose": "X.6 TEMPLATE — Instantiation guide [TEMPLATE-ONLY: remove when instantiating]",
            "optional": true,
            "note": "Only in seed/template files. Removed when copy-and-fill."
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // TOML validation is done by toml.ts handler, not JSON Schema.
    // This section documents the validation contract.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint toml <file>",
    "_Cv_expected_state": "All [_metadata], [_content], [_closing] tables present with required keys, field-level validation passing, and value-level checks clean (version format, dates, key prefix, filename match, type values, cross-field consistency).",

    "validation_contract": {
        "metadata": {
            "required_identity": ["[_metadata.I1_core]", "[_metadata.I2_family]", "[_metadata.I3_instance]"],
            "extension_identity": ["[_metadata.I4_architecture]"],
            "required_context": ["[_metadata.C1_state]", "[_metadata.C2_attribution]", "[_metadata.C3_grounding]", "[_metadata.C4_dependencies]"],
            "extension_context": ["[_metadata.C5_intent]", "[_metadata.C6_roadmap]", "[_metadata.C7_classification]", "[_metadata._contract]"],
            "key_pattern": "/^(?:I\\d+_[a-z][a-z_]*|C\\d+_[a-z][a-z_]*|_[a-z][a-z_]*)$/",
            "field_requirements": {
                "I1_core": { "required": ["key", "format", "from", "at"] },
                "I2_family": { "required": ["type", "structure"], "defined": ["subtype", "role"] },
                "I3_instance": { "required": ["file", "title"], "defined": ["component", "path", "provides", "brief"] },
                "C1_state": { "required": ["version", "status"], "defined": ["created", "updated"] },
                "C2_attribution": { "required": ["organization"], "defined": ["architect", "implementation", "copyright"] },
                "C3_grounding": { "required": ["scripture"], "defined": ["principle", "anchor"] },
                "C4_dependencies": { "required": ["requires", "consumers"], "defined": ["integration", "if_missing"] }
            }
        },
        "content": {
            "required_tables": ["[_content]"],
            "required_keys": {
                "[_content]": ["Cc", "Co", "Cv"]
            },
            "required_sections": ["[identity]"],
            "defined_sections": ["[settings]", "[resources]", "[behavior]", "[integrations]"],
            "defined_cc": ["[settings]", "[resources]"],
            "defined_co": ["[behavior]", "[integrations]"],
            "required_validation": ["[_validation]"],
            "extension_zones": ["cc", "co", "cv"],
            "field_requirements": {
                "identity": { "required": ["name", "version"], "defined": ["description"] },
                "_validation": { "required": ["commands"], "defined": ["schema"] }
            },
            "note": "Actual data tables are format-specific — no _ prefix required. [_validation.schema.fields] enables per-file field requirements."
        },
        "closing": {
            "required_tables": ["[_closing.X1_policy]", "[_closing.X5_note]"],
            "defined_tables": ["[_closing.X2_extension]", "[_closing.X3_troubleshooting]", "[_closing.X4_reference]"],
            "template_tables": ["[_closing.X6_template]"],
            "key_pattern": "/^(?:X\\d+_[a-z][a-z_]*|_[a-z][a-z_]*)$/",
            "field_requirements": {
                "X1_policy": { "required": ["never", "careful", "safe"], "defined": ["scripture"] },
                "X2_extension": { "required": ["planned"], "defined": [] },
                "X3_troubleshooting": { "required": [], "defined": ["scripture"] },
                "X4_reference": { "required": ["related_files"], "defined": ["required_sections", "validate"] },
                "X5_note": { "required": ["note", "scripture"], "defined": ["anchor"] }
            }
        },

        // Value-level validation — patterns for field values (not just existence).
        // Structural checks verify fields exist. Value checks verify values are correct.
        "value_patterns": {
            "version": {
                "pattern": "/^[abc]-\\d{2}\\.\\d{2}$/",
                "applies_to": ["I1_core.at", "C1_state.version"],
                "at_keywords": {
                    "template": "Seed template file — the pattern shown on the mountain",
                    "data": "Data/specification file — foundational definitions (I2_family.type = data)",
                    "code": "Code file — implementation (I2_family.type = code)"
                },
                "note": "Living versioning: stage (a=alpha, b=baseline, c=stable) - phase.completion. I1_core.at accepts keywords (template, data, code) OR version pattern. C1_state.version always requires version pattern. When at is a keyword, version consistency check is skipped."
            },
            "key_prefix": {
                "pattern": "/^B-/",
                "applies_to": ["I1_core.key"],
                "note": "All Bereshit keys start with B-"
            },
            "date": {
                "pattern": "/^\\d{4}-\\d{2}-\\d{2}$/",
                "applies_to": ["C1_state.created", "C1_state.updated"],
                "note": "ISO 8601 date format"
            },
            "family_type": {
                "values": ["data", "code", "documentation"],
                "applies_to": ["I2_family.type"],
                "note": "OmniCode content classification"
            },
            "empty_required": {
                "note": "Required fields with empty string or empty array values produce warnings — placeholders that were never filled"
            },
            "filename_match": {
                "note": "I3_instance.file should match the actual filename on disk"
            },
            "version_consistency": {
                "note": "I1_core.at should match C1_state.version (skipped when at=\"template\")"
            },
            "date_order": {
                "note": "C1_state.created should be <= C1_state.updated"
            }
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy [REQUIRED] → X.2 Extension [DEFINED] → X.3 Troubleshooting [DEFINED] → X.4 Reference [DEFINED] → X.5 Note [REQUIRED]",

    // X.1 POLICY [REQUIRED]
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "For God is not the author of confusion, but of peace. — 1 Corinthians 14:33",
    "_X1_never": [
        "Remove required table definitions (I1-I3, C1-C4, X1, X5)",
        "Change table naming convention ([_metadata.I1_core] → something else)",
        "Break the TOML ↔ JSON parallel without updating both schemas",
        "Remove field_requirements from validation_contract"
    ],
    "_X1_careful": [
        "Adding new required tables (cascades to all TOML files)",
        "Changing required_keys within tables (breaks existing files)",
        "Modifying the [_content] label convention (Cc/Co/Cv)",
        "Changing closing classification (required vs defined)"
    ],
    "_X1_safe": [
        "Adding optional/defined keys to existing sections",
        "Adding descriptions and documentation",
        "Adding examples to table definitions",
        "Adding new extension tables"
    ],

    // X.2 EXTENSION [DEFINED]
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Formal cross-reference to base-3block-schema $defs via $ref paths",
        "TOML-specific validation patterns beyond what toml.ts checks",
        "Schema cross-validation between this file and toml.ts linter constants"
    ],

    // X.4 REFERENCE [DEFINED]
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/L1-omnicode/ladder/schemas/base-3block-schema.jsonc — Base concepts (parent)",
        "b-word/L1-omnicode/ladder/schemas/json-3block-schema.jsonc — JSON sibling schema",
        "b-word/seed/data/L0/toml/config.toml — TOML seed template (canonical root example)",
        "b-word/seed/code/L0/toml/config.toml — Code config template (canonical code example)",
        "b-word/seed/code/L0/toml/compiler/config.toml — Compiler config template (canonical compiler example)",
        "c-tov/cws-struct/lib/formats/toml.ts — Runtime linter (implements these rules)"
    ],

    // X.5 NOTE [REQUIRED]
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Anchor [NOTE]",
    "_X5_note": "TOML and JSON express the same 3-block structure in their native tongues. TOML uses nested tables — the hierarchy IS the structure. JSON uses flat _ keys — explicit markers in a flat namespace. Same truth, different expression. The unified I/C metadata (Identity + Context) replaces the old pragma+metadata split — being and knowing unified in one block, as Genesis unified creation in one verse.",
    "_X5_scripture": "For God is not the author of confusion, but of peace. — 1 Corinthians 14:33",
    "_X5_anchor": "Tables are boundaries. Boundaries are Genesis 1. Structure before content. Identity before context. Both in one block.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
