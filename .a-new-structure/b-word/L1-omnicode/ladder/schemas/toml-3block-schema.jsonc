{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-toml-3block-schema",
    "_P1_from": "b-word/seed/data/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/definitions/omni",
    "_P3_includes": "none",
    "_P3_provides": ["TOML_3BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "TOML 3-Block Schema",
    "_P5_brief": "Defines how TOML implements OmniCode 3-block structure using nested tables. Parallel to json-3block-schema.jsonc — same concepts, TOML-native representation.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "toml-3block-schema.jsonc",
        "key": "B-definitions-omni-toml-3block-schema",
        "title": "TOML 3-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define TOML-native representation of OmniCode 3-block structure"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING — "For God is not the author of confusion, but of peace."
    //   — 1 Corinthians 14:33
    "_M4_grounding": {
        "scripture": "1 Corinthians 14:33 — For God is not the author of confusion, but of peace.",
        "principle": "TOML brings order through explicit structure — nested tables map directly to the conceptual hierarchy. Each table IS the section it represents."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "base-3block-schema.jsonc — shared $defs for format-independent concepts",
        "consumers": "c-tov/cws-struct/lib/formats/toml.ts — runtime linter implements these rules",
        "cross_format": {
            "base": "b-word/definitions/omni/base-3block-schema.jsonc — shared concepts",
            "json_sibling": "b-word/definitions/omni/json-3block-schema.jsonc — JSON expression of same structure",
            "relationship": "Same 3-block concepts, TOML-native tables instead of flat _ keys"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // TOML represents 3-block structure through nested tables:
    //   [_pragma]            — pragma block
    //   [_pragma.P1_core]    — P.1 section within pragma
    //   [_metadata.M1_identity] — M.1 section within metadata
    //   [_content]           — content block header
    //   [_closing.X1_policy] — X.1 section within closing
    //
    // The table hierarchy IS the block structure.
    // No separators needed — tables are self-delimiting.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How TOML conventions map to 3-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "TOML — UTF-8, LF line endings, nested tables for hierarchy",
    "_Cc_key_convention": "lowercase_with_underscores, match Go struct field tags",

    "format_mapping": {
        "note": "How OmniCode concepts map to TOML syntax",
        "block_boundaries": "Table headers ([_pragma], [_metadata], [_content], [_closing]) — self-delimiting",
        "section_navigation": "Dotted tables ([_pragma.P1_core], [_metadata.M1_identity]) — hierarchy via dots",
        "separators": "Block comment banners (# ═══...) — visual only, not structural",
        "data_keys": "Simple key = value pairs within tables"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete TOML table structure definition.
    // Each entry maps a TOML table path to its purpose
    // and the base schema $def it implements.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "toml_structure": {

        // ═══════════════════════════════════════════════════════
        // PRAGMA BLOCK — [_pragma] tree
        // ═══════════════════════════════════════════════════════

        "[_pragma]": {
            "purpose": "Pragma block root — contains format declaration",
            "required_keys": ["format"],
            "implements": "Pragma concept from base-3block-schema",
            "example": "[_pragma]\nformat = \"@omni data --toml\""
        },

        "[_pragma.legend]": {
            "purpose": "Field classification legend",
            "required_keys": ["req", "inh", "ins"],
            "implements": "$defs/pragma_legend",
            "example": "[_pragma.legend]\nreq = \"REQUIRED\"\ninh = \"INHERITED\"\nins = \"INSTANCE\""
        },

        "[_pragma.P1_core]": {
            "purpose": "P.1 CORE — Identity",
            "required_keys": ["key", "from", "at"],
            "implements": "$defs/P1_core",
            "note": "key = Bereshit key (B- prefix), from = derivation path, at = living version"
        },

        "[_pragma.P2_family]": {
            "purpose": "P.2 FAMILY — Classification",
            "required_keys": ["type", "subtype", "role", "structure"],
            "implements": "$defs/P2_family",
            "note": "type = data|code|documentation, structure = 3-block|4-block|5-block"
        },

        "[_pragma.P3_instance]": {
            "purpose": "P.3 INSTANCE — File Details",
            "required_keys": ["component", "layer", "includes", "provides"],
            "implements": "$defs/P3_instance",
            "note": "provides = array of UPPER_SNAKE capability constants"
        },

        "[_pragma.P4_architecture]": {
            "purpose": "P.4 ARCHITECTURE — Scaling Context",
            "required_keys": ["anchor"],
            "optional_keys": ["layers", "streams"],
            "implements": "$defs/P4_architecture"
        },

        "[_pragma.P5_summary]": {
            "purpose": "P.5 SUMMARY — Human Identity",
            "required_keys": ["title", "brief"],
            "optional_keys": ["usage"],
            "implements": "$defs/P5_summary"
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK — [_metadata] tree
        // ═══════════════════════════════════════════════════════

        "[_metadata.M1_identity]": {
            "purpose": "M.1 IDENTITY — File identity",
            "required_keys": ["file", "key", "title", "type", "component", "role"],
            "implements": "$defs/M1_identity"
        },

        "[_metadata.M2_state]": {
            "purpose": "M.2 STATE — Version and lifecycle",
            "required_keys": ["version", "status", "created", "updated"],
            "implements": "$defs/M2_state",
            "note": "version = living version pattern, dates = YYYY-MM-DD"
        },

        "[_metadata.M3_attribution]": {
            "purpose": "M.3 ATTRIBUTION — Authorship",
            "required_keys": ["architect", "implementation"],
            "optional_keys": ["organization", "copyright"],
            "implements": "$defs/M3_attribution"
        },

        "[_metadata.M4_grounding]": {
            "purpose": "M.4 GROUNDING — Biblical foundation",
            "required_keys": ["scripture", "principle"],
            "optional_keys": ["anchor"],
            "implements": "$defs/M4_grounding"
        },

        "[_metadata.M5_dependencies]": {
            "purpose": "M.5 DEPENDENCIES — Dependency graph",
            "required_keys": ["requires", "consumers"],
            "optional_keys": ["integration", "if_missing"],
            "implements": "$defs/M5_dependencies"
        },

        "[_metadata.M5_dependencies.related_data]": {
            "purpose": "Related data — parent/children relationships",
            "optional_keys": ["parent", "children"],
            "note": "Nested table under M5"
        },

        "[_metadata.M5_dependencies.cross_format]": {
            "purpose": "Cross-format relationships",
            "optional_keys": ["role", "note"],
            "note": "How this TOML file relates to JSON/JSONC siblings"
        },

        "[_metadata.M6_location]": {
            "purpose": "M.6 LOCATION — Optional: file path and derivation",
            "optional": true,
            "implements": "Extension metadata"
        },

        "[_metadata.M7_classification]": {
            "purpose": "M.7 CLASSIFICATION — Optional: tags and categorization",
            "optional": true
        },

        "[_metadata.M8_intent]": {
            "purpose": "M.8 INTENT — Optional: purpose, design philosophy",
            "optional": true
        },

        "[_metadata.M9_roadmap]": {
            "purpose": "M.9 ROADMAP — Optional: history, current, planned",
            "optional": true
        },

        "[_metadata.M_extension_note]": {
            "purpose": "Extension contract — M1-M5 base + M6+ domain rules",
            "required_keys": ["required", "extension", "rule"],
            "implements": "$defs/M_extension_note"
        },

        // ═══════════════════════════════════════════════════════
        // CONTENT BLOCK — [_content] + data tables
        // ═══════════════════════════════════════════════════════

        "[_content]": {
            "purpose": "Content block header — format and conventions",
            "required_keys": ["Cc", "Co", "Cv"],
            "optional_keys": ["format", "key_convention", "constraint"],
            "note": "Cc/Co/Cv are label strings that name the three content sections. Actual data follows in separate tables."
        },

        "data_tables": {
            "purpose": "The actual content — user-defined tables after [_content]",
            "note": "Tables like [identity], [settings], [resources], [behavior] — these are the real configuration data. They sit between [_content] and [_closing]. No _ prefix needed.",
            "convention": "Cc data comes first (identity, settings), Co data next (operations), Cv data last ([_validation])"
        },

        "[_validation]": {
            "purpose": "Cv — Content Validation section",
            "optional_keys": ["commands"],
            "note": "TOML-specific: validation lives in [_validation] table, not inline with content"
        },

        "[_validation.schema]": {
            "purpose": "Schema constraints — required and optional sections",
            "optional_keys": ["required", "optional"]
        },

        "[_validation.health_scoring]": {
            "purpose": "Health scoring criteria — weights summing to 100",
            "optional_keys": ["total", "correct_structure", "valid_configuration", "useful_documentation"]
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING BLOCK — [_closing] tree
        // ═══════════════════════════════════════════════════════

        "[_closing.X1_policy]": {
            "purpose": "X.1 POLICY — Modification guidelines",
            "required_keys": ["never", "careful", "safe"],
            "optional_keys": ["scripture"],
            "implements": "$defs/X1_policy"
        },

        "[_closing.X2_extension]": {
            "purpose": "X.2 EXTENSION — Future ideas",
            "optional": true,
            "optional_keys": ["planned", "considered"],
            "implements": "$defs/X2_extension"
        },

        "[_closing.X3_troubleshooting]": {
            "purpose": "X.3 TROUBLESHOOTING — Common problems",
            "optional": true,
            "note": "Keys are problem descriptions, values are solutions",
            "implements": "$defs/X3_troubleshooting"
        },

        "[_closing.X4_reference]": {
            "purpose": "X.4 REFERENCE — Quick lookup",
            "required_keys": ["related_files"],
            "optional_keys": ["required_sections", "validate"],
            "implements": "$defs/X4_reference"
        },

        "[_closing.X5_note]": {
            "purpose": "X.5 NOTE — Final guidance",
            "required_keys": ["note"],
            "optional_keys": ["scripture", "anchor"],
            "implements": "$defs/X5_note"
        },

        "[_closing.X6_template]": {
            "purpose": "X.6 TEMPLATE — Instantiation guide (remove on instantiation)",
            "optional": true,
            "note": "Only in seed/template files. Removed when copy-and-fill."
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // TOML validation is done by toml.ts handler, not JSON Schema.
    // This section documents the validation contract.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint toml <file>",
    "_Cv_expected_state": "All [_pragma], [_metadata], [_content], [_closing] tables present with required keys.",

    "validation_contract": {
        "pragma": {
            "required_tables": ["[_pragma]", "[_pragma.P1_core]", "[_pragma.P2_family]", "[_pragma.P3_instance]", "[_pragma.P4_architecture]", "[_pragma.P5_summary]"],
            "required_keys": {
                "[_pragma]": ["format"],
                "[_pragma.P1_core]": ["key", "from", "at"],
                "[_pragma.P2_family]": ["type", "structure"],
                "[_pragma.P5_summary]": ["title", "brief"]
            }
        },
        "metadata": {
            "required_tables": ["[_metadata.M1_identity]", "[_metadata.M2_state]", "[_metadata.M3_attribution]", "[_metadata.M4_grounding]", "[_metadata.M5_dependencies]"],
            "optional_tables": ["[_metadata.M6_location]", "[_metadata.M7_classification]", "[_metadata.M8_intent]", "[_metadata.M9_roadmap]"]
        },
        "content": {
            "required_tables": ["[_content]"],
            "required_keys": {
                "[_content]": ["Cc", "Co", "Cv"]
            },
            "note": "Actual data tables are format-specific — no _ prefix required"
        },
        "closing": {
            "required_tables": ["[_closing.X1_policy]", "[_closing.X4_reference]", "[_closing.X5_note]"],
            "optional_tables": ["[_closing.X2_extension]", "[_closing.X3_troubleshooting]", "[_closing.X6_template]"]
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "For God is not the author of confusion, but of peace. — 1 Corinthians 14:33",
    "_X1_never": [
        "Remove required table definitions",
        "Change table naming convention ([_pragma] → something else)",
        "Break the TOML ↔ JSON parallel without updating both schemas"
    ],
    "_X1_careful": [
        "Adding new required tables (cascades to all TOML files)",
        "Changing required_keys within tables",
        "Modifying the [_content] label convention (Cc/Co/Cv)"
    ],
    "_X1_safe": [
        "Adding optional tables or keys to existing sections",
        "Adding descriptions and documentation",
        "Adding examples to table definitions"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Formal cross-reference to base-3block-schema $defs via $ref paths",
        "TOML-specific validation patterns beyond what toml.ts checks",
        "4-block TOML schema (code configs with SETUP block)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/definitions/omni/base-3block-schema.jsonc — Base concepts (parent)",
        "b-word/definitions/omni/json-3block-schema.jsonc — JSON sibling schema",
        "b-word/seed/data/L0/toml/config.toml — TOML seed template (canonical example)",
        "c-tov/cws-struct/lib/formats/toml.ts — Runtime linter (implements these rules)"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "TOML and JSON express the same 3-block structure in their native tongues. TOML uses nested tables — the hierarchy IS the structure. JSON uses flat _ keys — explicit markers in a flat namespace. Same truth, different expression. Like Scripture in two languages — the meaning carries, the words adapt.",
    "_X5_scripture": "For God is not the author of confusion, but of peace. — 1 Corinthians 14:33",
    "_X5_anchor": "Tables are boundaries. Boundaries are Genesis 1. Structure before content.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
