{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-structure-whole-5block",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "block-skeleton-schema",
    "_P2_role": "structure-whole",
    "_P5_title": "5-Block Structure Skeleton — Documentation Files",
    "_P5_brief": "Format-agnostic definition of the 5-block (document) structure. Documentation is for humans — it needs visual orientation (HEADER) and reader preparation (CONTEXT) that code and data files don't. The fullest block pattern.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "skeleton": {
        "name": "5-block",
        "type": "document",
        "block_count": 5,

        "blocks": {
            "type": "array",
            "const": ["METADATA", "HEADER", "CONTEXT", "CONTENT", "FOOTER"],
            "description": "Canonical block order — never changes. The 5-block structure is the pattern for documentation files."
        },

        "principle": "Documentation is for humans. Humans need orientation before information, context before content. METADATA identifies (machine). HEADER orients (human eye). CONTEXT prepares (human mind). CONTENT delivers. FOOTER anchors. PhD rigor, Bible accessibility.",

        "METADATA": {
            "position": 1,
            "purpose": "Machine-readable identity — key, title, version, authors, classification",
            "required": true,
            "nature": "declarative",
            "audience": "machines and tools",
            "contains": "OmniCode pragma fields, structured metadata (key-value pairs), version, status, authorship",
            "note": "METADATA in documentation is typically hidden (HTML comments, AsciiDoc attributes). Humans don't read it — tools do."
        },

        "HEADER": {
            "position": 2,
            "purpose": "Human-readable orientation — title, quote, navigation, status at a glance",
            "required": true,
            "nature": "presentational",
            "audience": "human eyes",
            "contains": "Document title, opening scripture/quote, table of contents or navigation, status badges, summary",
            "note": "HEADER exists because documentation is for humans. Code has METADATA (machine-readable); documentation needs visual entry. The reader's first impression."
        },

        "CONTEXT": {
            "position": 3,
            "purpose": "Reader preparation — prerequisites, scope, definitions, orientation",
            "required": true,
            "nature": "preparatory",
            "audience": "human mind",
            "contains": "Quick start, scope (in/out), prerequisites, key terms/definitions, related documents",
            "subsections": {
                "quick_start":    { "purpose": "30-second orientation for the impatient reader" },
                "scope":          { "purpose": "What's in and what's out — clear boundaries" },
                "prerequisites":  { "purpose": "What the reader needs to know before proceeding" },
                "key_terms":      { "purpose": "Vocabulary definitions — shared understanding" }
            },
            "note": "CONTEXT ensures the reader and writer share assumptions before CONTENT begins. Without it, readers guess at scope and definitions."
        },

        "CONTENT": {
            "position": 4,
            "purpose": "The actual documentation — the substance this document exists to deliver",
            "required": true,
            "nature": "substantive",
            "audience": "the reader this document serves",
            "contains": "Main body sections, organized by the document's internal logic",
            "note": "CONTENT structure varies by document type. A guide has steps. A reference has categories. A journal has reflections. The organization serves the content's purpose."
        },

        "FOOTER": {
            "position": 5,
            "purpose": "Closing anchor — references, related documents, final grounding",
            "required": true,
            "nature": "documentary",
            "audience": "the reader who finished and needs next steps",
            "contains": "Related documents, references, changelog/version history, closing scripture anchor",
            "documentation_sections": {
                "related_docs": { "purpose": "Navigation to sibling/parent/child documents" },
                "references":   { "purpose": "External sources, citations, further reading" },
                "closing_note": { "purpose": "Final scripture anchor — the document's last word is eternal truth" }
            },
            "note": "FOOTER returns the reader to anchor. Every document begins with identity (METADATA) and ends with truth (closing scripture). The circuit completes."
        },

        "placement_rules": {
            "METADATA": {
                "must_contain": ["Document key", "Title", "Version", "Status", "Authors"],
                "must_not_contain": ["Visible content", "Narrative text", "Instructions"]
            },
            "HEADER": {
                "must_contain": ["Visible title", "Navigation or summary"],
                "must_not_contain": ["Machine metadata", "Main content", "Definitions"]
            },
            "CONTEXT": {
                "must_contain": ["Scope definition", "Prerequisites or assumptions"],
                "must_not_contain": ["Main content", "Conclusions", "Identity metadata"]
            },
            "CONTENT": {
                "must_contain": ["The substance this document exists to deliver"],
                "must_not_contain": ["Identity metadata (METADATA)", "Orientation (HEADER)", "Definitions (CONTEXT)"]
            },
            "FOOTER": {
                "must_contain": ["Related documents or references", "Closing anchor"],
                "must_not_contain": ["New content", "Identity metadata", "Prerequisites"]
            }
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Documentation is the most human of the three types. Code speaks to compilers. Data speaks to parsers. Documentation speaks to people. The 5-block structure honors this by adding what humans need that machines don't: visual orientation (HEADER) and mental preparation (CONTEXT). The extra two blocks are not overhead — they are hospitality.",
    "_X5_scripture": "Use hospitality one to another without grudging. — 1 Peter 4:9"
}
