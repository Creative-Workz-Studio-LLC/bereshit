{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-makefile-4block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/definitions/omni",
    "_P3_includes": "none",
    "_P3_provides": ["MAKEFILE_4BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Makefile 4-Block Schema",
    "_P5_brief": "Defines how Makefiles implement OmniCode 4-block structure using # comment lines. Block boundaries, pragma fields, metadata sections, and closing sections all live in comments — the build logic sits between them.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "makefile-4block-schema.jsonc",
        "key": "B-definitions-omni-makefile-4block-schema",
        "title": "Makefile 4-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define how Makefiles express OmniCode 4-block structure through # comments"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Nehemiah 4:6 — So built we the wall; and all the wall was joined together unto the half thereof: for the people had a mind to work.",
        "principle": "Makefiles build things. The wall was built because the people had a mind to work — and they built it with order, section by section, each person at their assigned post. Structure in the build system mirrors structure in the work."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "base-3block-schema.jsonc — shared $defs for format-independent concepts",
        "consumers": "c-tov/cws-struct/lib/formats/makefile.ts — runtime linter implements these rules",
        "cross_format": {
            "toml_sibling": "b-word/definitions/omni/toml-3block-schema.jsonc — TOML 3-block expression",
            "json_sibling": "b-word/definitions/omni/json-3block-schema.jsonc — JSON 3-block expression",
            "dotfile_sibling": "b-word/definitions/omni/dotfile-3block-schema.jsonc — Dotfile 3-block expression",
            "relationship": "Same OmniCode concepts, Makefile-native 4-block structure via # comments"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Makefiles represent 4-block structure through # comment lines:
    //   # ═══...PRAGMA [PRAGMA]═══...     — pragma block boundary
    //   # key: B-seed-code-make-template  — pragma field
    //   # ═══...METADATA BLOCK [METADATA]═══...  — metadata block
    //   # # M.1 Title [TAG]               — metadata section (verbose)
    //   # --- M1: Title ---               — metadata section (compact)
    //   # ═══...SETUP BLOCK [SETUP]═══... — setup block
    //   # ═══...BODY═══...                — body marker (no tag)
    //   # ═══...CLOSING BLOCK [CLOSING]═══...  — closing block
    //
    // The comment structure IS the block structure.
    // Build logic (targets, recipes) sits BETWEEN the structural comments.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How Makefile conventions map to 4-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "Makefile — tab-indented recipes, # comments carry all structural metadata",
    "_Cc_key_convention": "UPPER_SNAKE for variables, lower-kebab for targets",

    "format_mapping": {
        "note": "How OmniCode concepts map to Makefile syntax",
        "block_boundaries": "# ═══...BLOCK NAME [TAG]═══... comment lines — visual separators double as parseable markers",
        "section_navigation": "# # M.N Title [TAG] (verbose) or # --- MN: Title --- (compact) — section headers within blocks",
        "pragma_fields": "# field: value — within PRAGMA block boundaries",
        "separators": "# ─── (thin) for sub-sections, # ═══ (thick) for block boundaries",
        "build_logic": "Targets, variables, recipes — the actual Makefile content sits between structural comments"
    },

    "comment_conventions": {
        "block_boundary": "# ═══════════════════════════════════════════════════════════════",
        "block_tag": "# BLOCK NAME [TAG]",
        "section_verbose": "# # M.N Title [TAG]",
        "section_compact": "# --- MN: Title ---",
        "sub_separator": "# ───────────────────────────────────────────────────────────────",
        "field": "# field: value",
        "pragma_line": "# #!omni code --makefile"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete Makefile 4-block structure definition.
    // Each entry maps a structural element to its purpose
    // and what the linter validates.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "makefile_structure": {

        // ═══════════════════════════════════════════════════════
        // PRAGMA BLOCK — #!omni + P1-P5 fields
        // ═══════════════════════════════════════════════════════

        "pragma_line": {
            "purpose": "OmniCode format declaration",
            "pattern": "# #!omni code --makefile",
            "required": true,
            "severity": "warn",
            "note": "First structural line. Tells tools this is an OmniCode-structured Makefile."
        },

        "PRAGMA [PRAGMA]": {
            "purpose": "Pragma block start boundary",
            "pattern": "# ═══...PRAGMA [PRAGMA]═══...",
            "required": true,
            "severity": "error"
        },

        "END PRAGMA [END]": {
            "purpose": "Pragma block end boundary",
            "pattern": "# ═══...END PRAGMA [END]═══...",
            "required": true,
            "severity": "warn"
        },

        "pragma_fields": {
            "purpose": "Identity and classification fields within pragma block",
            "format": "# field: value",
            "required_fields": {
                "key": "Bereshit key (B- prefix) — unique identifier",
                "type": "code | data | documentation",
                "structure": "4-block or METADATA → SETUP → BODY → CLOSING",
                "title": "Human-readable title"
            },
            "recommended_fields": {
                "from": "Derivation path (template this came from)",
                "at": "Living version (a-01.00 format)",
                "subtype": "More specific classification",
                "role": "What role this file plays",
                "brief": "One-line description"
            }
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK — M.1-M.10 sections
        // ═══════════════════════════════════════════════════════

        "METADATA BLOCK [METADATA]": {
            "purpose": "Metadata block start boundary",
            "pattern": "# ═══...METADATA BLOCK [METADATA]═══...",
            "required": true,
            "severity": "error"
        },

        "END METADATA [END]": {
            "purpose": "Metadata block end boundary",
            "pattern": "# ═══...END METADATA [END]═══...",
            "required": true,
            "severity": "warn"
        },

        "metadata_sections": {
            "note": "Two formats supported — verbose and compact. Verbose is canonical for Makefiles.",

            "M1_identity": {
                "purpose": "M.1 IDENTITY — File identity",
                "verbose": "# # M.1 Identity [IDENTITY]",
                "compact": "# --- M1: Identity ---",
                "required": true,
                "severity": "error",
                "expected_fields": ["file", "key", "title", "type", "component", "role"]
            },

            "M2_state": {
                "purpose": "M.2 STATE — Version and lifecycle",
                "verbose": "# # M.2 State [STATE]",
                "compact": "# --- M2: State ---",
                "required": true,
                "severity": "error",
                "expected_fields": ["version", "status", "created", "updated"]
            },

            "M3_attribution": {
                "purpose": "M.3 ATTRIBUTION — Authorship",
                "verbose": "# # M.3 Attribution [ATTRIBUTION]",
                "compact": "# --- M3: Attribution ---",
                "required": true,
                "severity": "error",
                "expected_fields": ["architect", "implementation"]
            },

            "M4_grounding": {
                "purpose": "M.4 GROUNDING — Biblical foundation",
                "verbose": "# # M.4 Grounding [GROUNDING]",
                "compact": "# --- M4: Grounding ---",
                "recommended": true,
                "severity": "warn",
                "expected_fields": ["scripture", "principle"]
            },

            "M5_dependencies": {
                "purpose": "M.5 DEPENDENCIES — Dependency graph",
                "verbose": "# # M.5 Dependencies [DEPENDENCIES]",
                "compact": "# --- M5: Dependencies ---",
                "recommended": true,
                "severity": "warn",
                "expected_fields": ["requires", "consumers"]
            },

            "M6_to_M10": {
                "purpose": "Extension metadata — domain-specific",
                "verbose": "# # M.6 Location [LOCATION] through # # M.10 ...",
                "compact": "# --- M6: ... --- through # --- M10: ... ---",
                "optional": true,
                "severity": "info",
                "note": "Makefile templates use M6 Location, M7 Classification, M8 Intent, M9 Roadmap, M10 Health"
            }
        },

        // ═══════════════════════════════════════════════════════
        // SETUP BLOCK — imports, constants, configuration
        // ═══════════════════════════════════════════════════════

        "SETUP BLOCK [SETUP]": {
            "purpose": "Setup block boundary — variables, includes, configuration",
            "pattern": "# ═══...SETUP BLOCK [SETUP]═══...",
            "required": true,
            "severity": "error",
            "contains": {
                "S1_environment": "Shell, .PHONY, .DEFAULT_GOAL",
                "S2_paths": "Directory variables (SRC_DIR, BUILD_DIR, etc.)",
                "S3_tools": "Tool paths and flags (CC, CFLAGS, etc.)",
                "S4_sources": "Source file lists, wildcards",
                "S5_includes": "Conditional includes, dependency files",
                "S6_platform": "Platform detection, OS-specific logic",
                "S7_derived": "Computed variables, object lists"
            },
            "note": "Order within SETUP follows dependency chain — environment before paths, paths before tools, tools before sources."
        },

        // ═══════════════════════════════════════════════════════
        // BODY — core build targets
        // ═══════════════════════════════════════════════════════

        "BODY": {
            "purpose": "Body marker — the actual build targets",
            "pattern": "# ═══...BODY═══...",
            "note": "Body has no [TAG] — it's the main content area. Contains the actual Make targets and recipes.",
            "contains": {
                "B1_primary": "Primary targets (all, build, compile)",
                "B2_secondary": "Secondary targets (test, clean, install)",
                "B3_utility": "Utility targets (help, info, debug)"
            }
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING BLOCK — policy, reference, guidance
        // ═══════════════════════════════════════════════════════

        "CLOSING BLOCK [CLOSING]": {
            "purpose": "Closing block start boundary",
            "pattern": "# ═══...CLOSING BLOCK [CLOSING]═══...",
            "required": true,
            "severity": "error"
        },

        "END CLOSING [END]": {
            "purpose": "Closing block end boundary",
            "pattern": "# ═══...END CLOSING [END]═══...",
            "required": true,
            "severity": "warn"
        },

        "closing_sections": {
            "X1_policy": {
                "purpose": "X.1 POLICY — Modification guidelines",
                "verbose": "# # X.1 Policy [POLICY]",
                "compact": "# --- X1: Policy ---",
                "required": true,
                "severity": "error",
                "expected_content": ["never", "careful", "safe"]
            },

            "X2_extension": {
                "purpose": "X.2 EXTENSION — Future ideas",
                "verbose": "# # X.2 Extension [EXTENSION]",
                "compact": "# --- X2: Extension ---",
                "optional": true
            },

            "X3_troubleshooting": {
                "purpose": "X.3 TROUBLESHOOTING — Common problems",
                "verbose": "# # X.3 Troubleshooting [TROUBLESHOOTING]",
                "compact": "# --- X3: Troubleshooting ---",
                "optional": true
            },

            "X4_reference": {
                "purpose": "X.4 REFERENCE — Quick lookup",
                "verbose": "# # X.4 Reference [REFERENCE]",
                "compact": "# --- X4: Reference ---",
                "required": true,
                "severity": "error",
                "note": "Labeled REFERENCE in linter check — maps to tag extraction"
            },

            "X5_note": {
                "purpose": "X.5 NOTE — Final guidance",
                "verbose": "# # X.5 Note [NOTE]",
                "compact": "# --- X5: Note ---",
                "required": true,
                "severity": "error",
                "expected_content": ["note", "scripture", "anchor"]
            },

            "X6_to_X10": {
                "purpose": "Extension closing sections",
                "verbose": "# # X.6 ... through # # X.10 ...",
                "compact": "# --- X6: ... --- through # --- X10: ... ---",
                "optional": true,
                "note": "Makefile templates use X6 Template, X7 Advanced, X8 Validation, X9 Debug, X10 Health"
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Makefile validation is done by makefile.ts handler.
    // This section documents the validation contract.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint makefile <file>",
    "_Cv_expected_state": "All block boundaries present in correct order (METADATA < SETUP < BODY < CLOSING) with required sections.",

    "validation_contract": {
        "pragma": {
            "required_markers": ["PRAGMA [PRAGMA]"],
            "recommended_markers": ["END PRAGMA [END]"],
            "required_fields": ["key", "type", "structure", "title"],
            "recommended_fields": ["from", "at", "subtype", "role", "brief"],
            "structure_values": ["4-block", "METADATA → SETUP → BODY → CLOSING"]
        },
        "metadata": {
            "required_markers": ["METADATA BLOCK [METADATA]"],
            "recommended_markers": ["END METADATA [END]"],
            "required_sections": ["M1", "M2", "M3"],
            "recommended_sections": ["M4", "M5"],
            "extension_sections": ["M6", "M7", "M8", "M9", "M10"]
        },
        "blocks": {
            "required_markers": ["SETUP BLOCK [SETUP]", "CLOSING BLOCK [CLOSING]"],
            "recommended_markers": ["END CLOSING [END]"],
            "order": "METADATA < SETUP < CLOSING",
            "note": "BODY marker is visual but not checked as a required boundary by linter"
        },
        "closing": {
            "required_tags": ["POLICY", "REFERENCE", "NOTE"],
            "optional_tags": ["EXTENSION", "TROUBLESHOOTING", "TEMPLATE", "ADVANCED", "VALIDATION", "DEBUG", "HEALTH"]
        },
        "cross_refs": {
            "P1_key_vs_M1_key": "Pragma key field must match Metadata M1 Key field",
            "P5_title_vs_M1_title": "Pragma title field should match Metadata M1 Title field",
            "template_tolerance": "Values starting with [ are treated as template placeholders and skipped"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "So built we the wall; for the people had a mind to work. — Nehemiah 4:6",
    "_X1_never": [
        "Remove block boundary requirements (METADATA, SETUP, CLOSING)",
        "Change the # comment convention for structural markers",
        "Break the Makefile ↔ schema parallel without updating both"
    ],
    "_X1_careful": [
        "Adding new required metadata sections (cascades to all Makefiles)",
        "Changing required closing tags (POLICY, REFERENCE, NOTE)",
        "Modifying pragma field requirements"
    ],
    "_X1_safe": [
        "Adding optional metadata or closing sections",
        "Adding descriptions and documentation to section definitions",
        "Adding examples to structural element definitions"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Transform capability — auto-generate missing block boundaries",
        "Health scoring based on section completeness",
        "Cross-file dependency validation (include paths, target references)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/definitions/omni/base-3block-schema.jsonc — Base concepts (parent)",
        "b-word/definitions/omni/dotfile-3block-schema.jsonc — Dotfile sibling (also comment-based)",
        "b-word/definitions/omni/toml-3block-schema.jsonc — TOML sibling schema",
        "b-word/definitions/omni/json-3block-schema.jsonc — JSON sibling schema",
        "b-word/seed/code/L0/make/makefile.mk — Makefile seed template (canonical example)",
        "c-tov/cws-struct/lib/formats/makefile.ts — Runtime linter (implements these rules)"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Makefiles are builders. The structure lives in # comments because the build logic lives in everything else. Same OmniCode concepts — pragma, metadata, content blocks, closing — expressed through the only channel Makefiles have for documentation: comments. The wall was built because the people had a mind to work, and they built it with order.",
    "_X5_scripture": "So built we the wall; for the people had a mind to work. — Nehemiah 4:6",
    "_X5_anchor": "Comments are structure. Structure is Genesis 1. Boundaries before build targets.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
