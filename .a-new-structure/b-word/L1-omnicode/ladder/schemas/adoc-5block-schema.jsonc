{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-adoc-5block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas",
    "_P3_includes": "none",
    "_P3_provides": ["ADOC_5BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "AsciiDoc 5-Block Schema",
    "_P5_brief": "Defines how AsciiDoc documentation files implement OmniCode 5-block structure. Pragma in //// comment blocks, metadata as :attributes:, structural blocks (METADATA, HEADER, CONTEXT, CONTENT, FOOTER) with section numbering (M.1-M.12, H.1-H.6, C.1-C.8, T.1-T.4, F.1-F.4). First 5-block schema — documentation has two blocks code files don't: HEADER (visible identity) and CONTEXT (reader preparation).",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "adoc-5block-schema.jsonc",
        "key": "B-L1-schemas-adoc-5block-schema",
        "title": "AsciiDoc 5-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define how AsciiDoc documentation files express OmniCode 5-block structure through //// pragma blocks, :attribute: metadata, // section markers, and = heading hierarchy"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-15",
        "updated": "2026-02-15"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Exodus 25:40 — Look that thou make them after their pattern.",
        "principle": "Documentation is the human face of the system. Code has 4 blocks because compilers need no introduction. Documentation has 5 blocks because humans need orientation before content — HEADER is the handshake, CONTEXT is the invitation. The pattern ensures every document answers WHO (METADATA), WHAT IS THIS (HEADER), AM I READY (CONTEXT), THE VALUE (CONTENT), and WHERE NEXT (FOOTER)."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "base-3block-schema.jsonc — shared $defs for format-independent concepts",
        "consumers": "c-tov/cws-struct/lib/formats/adoc.ts — future runtime linter (not yet implemented)",
        "cross_format": {
            "code_siblings": [
                "b-word/L1-omnicode/ladder/schemas/go-4block-schema.jsonc — Go 4-block (code)",
                "b-word/L1-omnicode/ladder/schemas/rust-4block-schema.jsonc — Rust 4-block (code)",
                "b-word/L1-omnicode/ladder/schemas/makefile-4block-schema.jsonc — Makefile 4-block (build)"
            ],
            "data_siblings": [
                "b-word/L1-omnicode/ladder/schemas/toml-3block-schema.jsonc — TOML 3-block (data)",
                "b-word/L1-omnicode/ladder/schemas/json-3block-schema.jsonc — JSON 3-block (data)"
            ],
            "relationship": "Same OmniCode block concepts, AsciiDoc-native expression. 5-block adds HEADER + CONTEXT for human-first documentation."
        },
        "template": "b-word/seed/documentation/L0/adoc/asciidoc-base.adoc — canonical 5-block AsciiDoc template"
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // AsciiDoc documentation files express 5-block structure through:
    //   //// ... ////              — pragma comment block (file-level identity)
    //   :key: B-path-name          — :attribute: syntax for metadata
    //   // # M.1 Core [TAG]       — section markers within metadata
    //   // ========...========     — block boundaries (separators)
    //   // METADATA | HEADER | CONTEXT | CONTENT | FOOTER — block labels
    //   // END METADATA | etc.    — block end markers
    //   = Title                   — AsciiDoc heading (level 0)
    //   == Section                — AsciiDoc heading (level 1)
    //
    // Why 5 blocks (not 4):
    //   Code is for compilers — METADATA carries identity, then straight to SETUP + BODY.
    //   Documentation is for humans — HEADER provides visible identity (5 seconds),
    //   CONTEXT prepares the reader (prerequisites, scope, terms), THEN CONTENT delivers value.
    //   FOOTER sends them out with truth grounding and next steps.
    //
    // Template classification:
    //   Template: /// @omni template --adoc in //// pragma block
    //   Derived:  /// @omni:req key = B-... + // #!omni document --adoc after pragma

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How AsciiDoc conventions map to 5-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "AsciiDoc — :attribute: metadata, // comment markers, = heading hierarchy, block delimiters",
    "_Cc_key_convention": "//// pragma block at top, :attributes: for metadata, // # M.N markers for sections",

    "format_mapping": {
        "note": "How OmniCode concepts map to AsciiDoc syntax",
        "pragma_block": "//// ... //// — multi-line comment block at file top containing @omni directives, P.1-P.5 sections",
        "metadata_attributes": ":key:, :title:, :version:, :status: etc. — AsciiDoc attributes carry structured identity",
        "section_markers": "// # M.1 Core Identity [TAG] — comment markers label sections within metadata",
        "block_boundaries": "// ============...============ — comment separators mark METADATA/HEADER/CONTEXT/CONTENT/FOOTER",
        "end_markers": "// END METADATA | // END HEADER | // END CONTEXT | // END CONTENT | // END FOOTER",
        "heading_hierarchy": "= Title (H.1), == Section (T.1-T.4, F.1-F.4), === Subsection",
        "template_directive": "/// @omni template --adoc (inside //// pragma block)",
        "derived_directive": "#!omni document --adoc (typically as first comment after pragma block)"
    },

    "comment_conventions": {
        "pragma_block_open": "////",
        "pragma_block_close": "////",
        "pragma_line": "/// @omni template --adoc | /// @omni:req key = B-...",
        "section_marker": "// # M.1 Core Identity [IDENTITY] | // # H.2 Epigraph [EPIGRAPH]",
        "block_separator": "// ============================================================================",
        "block_label": "// METADATA | // HEADER | // CONTEXT | // CONTENT | // FOOTER",
        "end_marker": "// END METADATA | // END HEADER | // END CONTEXT | // END CONTENT | // END FOOTER",
        "template_note": "// (inside pragma block: /// lines; outside pragma block: // lines)",
        "reserved_marker": "// [Reserved: reason] — intentional section omission"
    },

    "file_classification": {
        "template": {
            "markers": ["/// @omni template --adoc", "TEMPLATE NOTES — DELETE WHEN USING"],
            "identity": "P.1-P.5 in //// pragma block with @omni:req/@omni:inh/@omni:ins annotations",
            "content": "[Bracketed placeholders] throughout",
            "note": "Templates are seeds — copy then customize"
        },
        "derived": {
            "markers": ["/// @omni:req key = B-...", "// #!omni document --adoc"],
            "identity": "Filled :attributes: + section-specific content",
            "content": "Actual document content replacing placeholders",
            "note": "Derived files are live documentation with real content"
        }
    },

    "asciidoc_toolkit": {
        "note": "AsciiDoc elements used within 5-block structure",
        "block_delimiters": {
            "example": "====",
            "listing": "----",
            "sidebar": "****",
            "literal": "....",
            "quote": "____",
            "comment_block": "////",
            "rule": "Opening and closing delimiters must match exactly; nesting uses +1 delimiter char"
        },
        "admonitions": ["NOTE", "TIP", "IMPORTANT", "WARNING", "CAUTION"],
        "collapsibles": {
            "open_by_default": "[%collapsible%open]",
            "closed_by_default": "[%collapsible]",
            "use": "Layered reading — scanners see headings, readers expand for depth"
        },
        "attributes": {
            "inline": ":attribute: value — set in METADATA, reference as {attribute}",
            "conditional": "ifdef::attribute[] ... endif::[]",
            "unset": ":!attribute:"
        },
        "navigation": {
            "anchor": "[[anchor-id]]",
            "cross_ref": "<<anchor-id,Display Text>>",
            "file_link": "link:path/file.adoc[Text]",
            "back_to_top": "<<_top,icon:arrow-up[] Back to Top>>"
        }
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete AsciiDoc 5-block structure definition.
    // Each block maps structural elements to their purpose
    // and what a future linter would validate.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "adoc_structure": {

        // ═══════════════════════════════════════════════════════
        // PRAGMA — //// comment block at file top
        // ═══════════════════════════════════════════════════════

        "PRAGMA": {
            "purpose": "File-level OmniCode identity in a //// comment block before all AsciiDoc content",
            "boundary": "//// (opening) ... //// (closing)",
            "required": true,
            "severity": "error",

            "sections": {
                "P1_CORE": {
                    "tag": "P.1 CORE — Identity [CORE]",
                    "fields": {
                        "key": { "annotation": "@omni:req", "required": true, "purpose": "Unique bereshit identifier" },
                        "from": { "annotation": "@omni:req", "required": true, "purpose": "Parent template path" },
                        "at": { "annotation": "@omni:req", "required": true, "purpose": "Version at creation" }
                    }
                },
                "P2_FAMILY": {
                    "tag": "P.2 FAMILY — Classification [FAMILY]",
                    "fields": {
                        "type": { "annotation": "@omni:inh", "required": true, "purpose": "documentation" },
                        "subtype": { "annotation": "@omni:inh", "required": true, "purpose": "template | standard | guide | reference | index | report" },
                        "role": { "annotation": "@omni:inh", "required": true, "purpose": "seed | ladder | spiral | hybrid" },
                        "structure": { "annotation": "@omni:inh", "required": true, "purpose": "5-block (always for AsciiDoc)" }
                    }
                },
                "P3_INSTANCE": {
                    "tag": "P.3 INSTANCE — File Details [INSTANCE]",
                    "fields": {
                        "component": { "annotation": "@omni:ins", "required": true, "purpose": "Logical component" },
                        "layer": { "annotation": "@omni:ins", "required": true, "purpose": "Filesystem layer path" },
                        "includes": { "annotation": "@omni:ins", "recommended": true, "purpose": "Included files" },
                        "provides": { "annotation": "@omni:ins", "recommended": true, "purpose": "Exported symbols/templates" }
                    }
                },
                "P4_ARCHITECTURE": {
                    "tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
                    "fields": {
                        "layers": { "annotation": "@omni:ins", "recommended": true, "purpose": "Layer placement" },
                        "anchor": { "annotation": "@omni:ins", "recommended": true, "purpose": "Genesis anchor chain" }
                    }
                },
                "P5_SUMMARY": {
                    "tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
                    "fields": {
                        "title": { "annotation": "@omni:req", "required": true, "purpose": "Human-readable title" },
                        "brief": { "annotation": "@omni:req", "required": true, "purpose": "One-line description" }
                    }
                }
            },

            "format_note": "Lines inside //// block use /// prefix. @omni:req = required, @omni:inh = inherited, @omni:ins = instance-specific."
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK — :attribute: declarations
        // ═══════════════════════════════════════════════════════

        "METADATA": {
            "purpose": "Machine-readable identity using AsciiDoc :attribute: syntax — the catalog card",
            "boundary": "// ============================================================================",
            "label": "// METADATA",
            "end_marker": "// END METADATA",
            "required": true,
            "severity": "error",
            "note": "Unlike code files (// comments), AsciiDoc metadata uses :attribute: declarations that AsciiDoc processors can resolve with {attribute} syntax",

            "sections": {
                "M1_identity": {
                    "tag": "// # M.1 Core Identity [IDENTITY]",
                    "required": true,
                    "attributes": {
                        ":key:": { "required": true, "purpose": "Bereshit unique identifier (B-path-name)" },
                        ":title:": { "required": true, "purpose": "Document title (sets HTML <title>)" },
                        ":subtitle:": { "recommended": true, "purpose": "Optional longer description" },
                        ":type:": { "required": true, "purpose": "Standard | Guide | Template | Reference | Index | Policy | Specification | Report" },
                        ":doctype:": { "recommended": true, "purpose": "article | book | manpage | inline" },
                        ":lang:": { "recommended": true, "purpose": "Language code (en, es, etc.)" }
                    }
                },
                "M2_state": {
                    "tag": "// # M.2 Lifecycle State [STATE]",
                    "required": true,
                    "attributes": {
                        ":status:": { "required": true, "purpose": "Draft | Active | Deprecated | Archived" },
                        ":version:": { "required": true, "purpose": "Living version (a-XX.XX)" },
                        ":revnumber:": { "recommended": true, "purpose": "Usually {version}" },
                        ":created:": { "required": true, "purpose": "Creation date (YYYY-MM-DD)" },
                        ":revdate:": { "required": true, "purpose": "Last revision date" },
                        ":revremark:": { "recommended": true, "purpose": "Brief revision description" }
                    }
                },
                "M3_attribution": {
                    "tag": "// # M.3 Attribution [ATTRIBUTION]",
                    "required": true,
                    "attributes": {
                        ":authors:": { "required": true, "purpose": "Name (Role), Name (Role)" },
                        ":author:": { "required": true, "purpose": "Primary author (AsciiDoc built-in)" },
                        ":email:": { "recommended": true, "purpose": "Primary author email" },
                        ":organization:": { "recommended": true, "purpose": "Company name" },
                        ":copyright:": { "recommended": true, "purpose": "Copyright notice" }
                    }
                },
                "M4_location": {
                    "tag": "// # M.4 Location [LOCATION]",
                    "recommended": true,
                    "attributes": {
                        ":path:": { "recommended": true, "purpose": "Canonical filesystem path" }
                    }
                },
                "M5_derivation": {
                    "tag": "// # M.5 Derivation [DERIVATION]",
                    "required": true,
                    "attributes": {
                        ":derives_from:": { "required": true, "purpose": "Parent template path — enables cascade updates" }
                    }
                },
                "M6_classification": {
                    "tag": "// # M.6 Classification [CLASSIFICATION]",
                    "recommended": true,
                    "attributes": {
                        ":tags:": { "recommended": true, "purpose": "Discovery tags" },
                        ":keywords:": { "recommended": true, "purpose": "HTML meta keywords" }
                    }
                },
                "M7_intent": {
                    "tag": "// # M.7 Intent [INTENT]",
                    "recommended": true,
                    "attributes": {
                        ":purpose:": { "recommended": true, "purpose": "One-line purpose statement" },
                        ":description:": { "recommended": true, "purpose": "HTML meta description" }
                    }
                },
                "M8_grounding": {
                    "tag": "// # M.8 Grounding [GROUNDING]",
                    "required": true,
                    "attributes": {
                        ":verse-ref:": { "required": true, "purpose": "Book Chapter:Verse" },
                        ":verse-kjv-text:": { "required": true, "purpose": "KJV translation text" },
                        ":verse-kjv-path:": { "recommended": true, "purpose": "Path to KJV verse file" },
                        ":verse-web-text:": { "recommended": true, "purpose": "WEB translation text" },
                        ":biblical_foundation:": { "required": true, "purpose": "Primary display text (usually {verse-kjv-text})" }
                    }
                },
                "M9_strictness": {
                    "tag": "// # M.9 Strictness [STRICTNESS]",
                    "recommended": true,
                    "attributes": {
                        ":strictness:": { "recommended": true, "purpose": "T (Tight) | G (Guided) | F (Free)" }
                    }
                },
                "M10_settings": {
                    "tag": "// # M.10 AsciiDoc Settings [SETTINGS]",
                    "required": true,
                    "attributes": {
                        ":toc:": { "required": true, "purpose": "left | right | auto | preamble" },
                        ":toclevels:": { "recommended": true, "purpose": "1-5 (depth of table of contents)" },
                        ":sectnums:": { "recommended": true, "purpose": "Section numbering (flag attribute)" },
                        ":icons:": { "recommended": true, "purpose": "font | image" },
                        ":source-highlighter:": { "recommended": true, "purpose": "highlight.js | rouge | coderay" },
                        ":experimental:": { "recommended": true, "purpose": "Enables kbd:[], btn:[], menu:[] macros" }
                    }
                },
                "M11_navigation": {
                    "tag": "// # M.11 Navigation [NAVIGATION]",
                    "recommended": true,
                    "attributes": {
                        ":root:": { "recommended": true, "purpose": "Relative path to bereshit root" },
                        ":word:": { "recommended": true, "purpose": "{root}word/" },
                        ":scripture:": { "recommended": true, "purpose": "{word}scripture/" }
                    },
                    "note": "Navigation attributes enable portable cross-document links"
                },
                "M12_content_attributes": {
                    "tag": "// # M.12 Content Attributes [CONTENT-ATTRS]",
                    "recommended": true,
                    "attributes": {
                        "note": "Document-specific attributes referenced in body with {attribute} syntax"
                    }
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // HEADER BLOCK — visible identity (5-second scan)
        // ═══════════════════════════════════════════════════════

        "HEADER": {
            "purpose": "Human-visible identity — the reader decides in 5 seconds: is this for me?",
            "boundary": "// ============================================================================",
            "label": "// HEADER",
            "end_marker": "// END HEADER",
            "required": true,
            "severity": "error",
            "note": "HEADER exists because documentation is for humans. Code files skip this — compilers don't need a handshake. Documentation readers do.",

            "sections": {
                "H1_title": {
                    "tag": "// # H.1 Title [TITLE]",
                    "required": true,
                    "elements": {
                        "anchor": "[[_top]] — document top anchor",
                        "heading": "= {title}: {subtitle} — level-0 AsciiDoc heading",
                        "byline": "{authors} — author attribution",
                        "version_line": "v{version}, {revdate} — version and date"
                    },
                    "note": "The = heading is what AsciiDoc renders as the document title"
                },
                "H2_epigraph": {
                    "tag": "// # H.2 Epigraph [EPIGRAPH]",
                    "required": true,
                    "elements": {
                        "format": "[quote, \"{verse-ref}\"] with ____ block",
                        "content": "KJV and WEB translations with verse file links",
                        "purpose": "Scripture grounding — establishes biblical foundation visually"
                    }
                },
                "H3_lead": {
                    "tag": "// # H.3 Lead [LEAD]",
                    "required": true,
                    "elements": {
                        "format": "[.lead.text-center] + *{the-purpose}*",
                        "purpose": "The hook — centered purpose statement. Reader decides: stay or leave."
                    }
                },
                "H4_abstract": {
                    "tag": "// # H.4 Abstract [ABSTRACT]",
                    "required": true,
                    "elements": {
                        "format": "[abstract] + -- block with icon:[] entries",
                        "content": "3-4 key facts at a glance — visual scanning in 5 seconds",
                        "icons": "icon:cube[], icon:cog[], icon:check-circle[], icon:flask[], icon:code[]"
                    }
                },
                "H5_status": {
                    "tag": "// # H.5 Status [STATUS]",
                    "required": true,
                    "elements": {
                        "format": "Table with Status | Version | Type | [domain-specific columns]",
                        "purpose": "Document data table — machine-readable status at human speed"
                    }
                },
                "H6_navigation": {
                    "tag": "// # H.6 Navigation [NAVIGATION]",
                    "required": true,
                    "elements": {
                        "format": "<<anchor,Label>> links separated by bullet points",
                        "purpose": "Quick jump links to major document sections",
                        "pattern": "*<<overview,Overview>>* . *<<definition,Definition>>* . *<<operations,Operations>>*"
                    }
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // CONTEXT BLOCK — reader preparation
        // ═══════════════════════════════════════════════════════

        "CONTEXT": {
            "purpose": "Prepare the reader — prerequisites, scope, terms. Like SETUP in code but for human understanding.",
            "boundary": "// ============================================================================",
            "label": "// CONTEXT",
            "end_marker": "// END CONTEXT",
            "required": true,
            "severity": "error",
            "note": "CONTEXT is the documentation equivalent of SETUP — everything the reader needs before the value. Code imports libraries; documentation imports understanding.",

            "sections": {
                "C1_overview": {
                    "tag": "// # C.1 Overview [OVERVIEW]",
                    "required": true,
                    "elements": {
                        "heading": "== Overview",
                        "lead": "[.lead] brief description",
                        "important": "[IMPORTANT] critical concept box",
                        "purpose": "What this document covers and why it matters"
                    }
                },
                "C2_audience": {
                    "tag": "// # C.2 Audience [AUDIENCE]",
                    "recommended": true,
                    "elements": {
                        "heading": "=== Audience",
                        "format": "Role-based horizontal list with icons",
                        "reserved": "// [Reserved: implicit from context] — valid omission"
                    }
                },
                "C3_scope": {
                    "tag": "// # C.3 Scope [SCOPE]",
                    "recommended": true,
                    "elements": {
                        "heading": "=== Scope",
                        "format": "In Scope / Out of Scope horizontal list"
                    }
                },
                "C4_prerequisites": {
                    "tag": "// # C.4 Prerequisites [PREREQUISITES]",
                    "recommended": true,
                    "elements": {
                        "heading": "=== Prerequisites",
                        "format": "Icon-based requirement list"
                    }
                },
                "C5_key_terms": {
                    "tag": "// # C.5 Key Terms [KEY_TERMS]",
                    "recommended": true,
                    "elements": {
                        "heading": "=== Key Terms",
                        "format": "Collapsible terminology reference with icon:tag[] entries"
                    }
                },
                "C6_quick_start": {
                    "tag": "// # C.6 Quick Start [QUICK_START]",
                    "recommended": true,
                    "elements": {
                        "heading": "=== Quick Start",
                        "format": "Sidebar with code block"
                    }
                },
                "C7_contents": {
                    "tag": "// # C.7 Contents [CONTENTS]",
                    "recommended": true,
                    "elements": {
                        "heading": "=== What This Document Provides",
                        "format": "Table mapping categories to audiences"
                    }
                },
                "C8_return": {
                    "tag": "// # C.8 Return [RETURN]",
                    "recommended": true,
                    "elements": {
                        "format": "<<_top,icon:arrow-up[] Back to Top>>",
                        "purpose": "Navigation anchor back to document top"
                    }
                }
            },

            "reserved_pattern": {
                "note": "Any C.1-C.8 section can be omitted with a [Reserved: reason] comment",
                "format": "// [Reserved: implicit from context] | // [Reserved: not applicable]",
                "severity": "Only C.1 Overview is truly required; others are recommended"
            }
        },

        // ═══════════════════════════════════════════════════════
        // CONTENT BLOCK — the actual value
        // ═══════════════════════════════════════════════════════

        "CONTENT": {
            "purpose": "The chapters — what readers came for. This is the BODY equivalent for documentation.",
            "boundary": "// ============================================================================",
            "label": "// CONTENT",
            "end_marker": "// END CONTENT",
            "required": true,
            "severity": "error",
            "note": "CONTENT maps to BODY in code files. Code has functions; documentation has sections.",

            "sections": {
                "T1_definition": {
                    "tag": "// # T.1 Definition [DEFINITION]",
                    "required": true,
                    "elements": {
                        "heading": "== [Title — what this is]",
                        "purpose": "Concepts, types, structure — WHAT this is",
                        "suggested_headings": "Types | Systems | Structure | About | The Journey",
                        "toolkit": "Tables, collapsibles, TIP admonition"
                    }
                },
                "T2_operations": {
                    "tag": "// # T.2 Operations [OPERATIONS]",
                    "recommended": true,
                    "elements": {
                        "heading": "== [Title — what it does]",
                        "purpose": "Functions, behaviors, processes — HOW it works",
                        "suggested_headings": "Functions | Files | What We Proved | Get Involved",
                        "toolkit": "Comparison matrix, workflow steps, mermaid diagrams",
                        "symbols": "check (yes) | cross (no) | circle (optional)"
                    }
                },
                "T3_application": {
                    "tag": "// # T.3 Application [APPLICATION]",
                    "recommended": true,
                    "elements": {
                        "heading": "== [Title — how to use it]",
                        "purpose": "Patterns, examples, running — practical application",
                        "suggested_headings": "Usage Patterns | Examples | Running the Demo | Community",
                        "toolkit": "Code blocks, collapsible examples, source links"
                    }
                },
                "T4_reference": {
                    "tag": "// # T.4 Reference [REFERENCE]",
                    "recommended": true,
                    "elements": {
                        "heading": "== Quick Reference",
                        "purpose": "Quick lookup — tables, summaries, next steps",
                        "suggested_headings": "Quick Reference | What's Next | Document Map | Recognition",
                        "toolkit": "Checklists, lookup tables, CAUTION admonition"
                    }
                }
            },

            "layered_reading": {
                "scan_5s": "Headings + tables + lead paragraphs",
                "skim_1m": "[%collapsible%open] sections",
                "read": "Full explanations within sections",
                "study": "[%collapsible] deep dives with technical details",
                "reference": "T.4 quick lookup tables"
            }
        },

        // ═══════════════════════════════════════════════════════
        // FOOTER BLOCK — grounding and next steps
        // ═══════════════════════════════════════════════════════

        "FOOTER": {
            "purpose": "Send the reader out with truth grounding, references, and connections — the CLOSING equivalent for documentation",
            "boundary": "// ============================================================================",
            "label": "// FOOTER",
            "end_marker": "// END FOOTER",
            "required": true,
            "severity": "error",
            "note": "FOOTER maps to CLOSING in code files. Code closes with policy and notes; documentation closes with truth and connections.",

            "sections": {
                "F1_biblical": {
                    "tag": "// # F.1 Biblical Foundation [BIBLICAL]",
                    "required": true,
                    "elements": {
                        "heading": "== Biblical Foundation",
                        "content": "Scripture verse + context + practical application",
                        "purpose": "Connect to eternal truth — the WHY beneath the what",
                        "test": "If you cannot articulate Scripture's role, reflect on purpose"
                    }
                },
                "F2_references": {
                    "tag": "// # F.2 References [REFERENCES]",
                    "required": true,
                    "elements": {
                        "heading": "== References",
                        "subsections": ["Related Documents", "Standards & Specifications", "External Resources"],
                        "purpose": "Organized links for discovery — knowledge grows through connection"
                    }
                },
                "F3_see_also": {
                    "tag": "// # F.3 See Also [SEE-ALSO]",
                    "recommended": true,
                    "elements": {
                        "heading": "== See Also",
                        "format": "Bullet list of link:path[text] — brief description",
                        "purpose": "Cross-references to ecosystem"
                    }
                },
                "F4_closing": {
                    "tag": "// # F.4 Centered Closing [CLOSING]",
                    "required": true,
                    "elements": {
                        "format": "[.text-center] -- block with navigation + identity + scripture",
                        "content": "Back to Top link, Key/Type/Version, Status/Updated, biblical closing, Kingdom purpose statement",
                        "purpose": "Closure + key info at a glance"
                    }
                }
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // AsciiDoc validation will be done by a future adoc.ts handler.
    // This section defines the validation contract the handler must implement.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint adoc <file>  (future — handler not yet implemented)",
    "_Cv_expected_state": "All 5 block boundaries present in correct order (METADATA < HEADER < CONTEXT < CONTENT < FOOTER) with //// pragma block and required :attributes:.",

    "validation_contract": {

        "checks_planned": {
            "note": "Checks a future adoc.ts handler should implement",
            "version": "a-01.00 (specification — no runtime linter yet)",
            "checks": [
                "1. checkPragmaBlock — //// block exists at file top with P.1-P.5 sections",
                "2. checkBlockStructure — 5 blocks present (METADATA, HEADER, CONTEXT, CONTENT, FOOTER), correct order, END markers",
                "3. checkMetadataAttributes — required :attributes: present (:key:, :title:, :version:, :status:, :created:, :authors:, :derives_from:, :verse-ref:, :biblical_foundation:)",
                "4. checkHeaderSections — H.1-H.6 present (title, epigraph, lead, abstract, status, navigation)",
                "5. checkContextSections — C.1 Overview required, C.2-C.8 present or [Reserved: reason]",
                "6. checkContentSections — T.1 Definition required, T.2-T.4 present or [Reserved: reason]",
                "7. checkFooterSections — F.1 Biblical + F.2 References + F.4 Closing required, F.3 recommended",
                "8. checkSeparatorConsistency — block separators use consistent = width",
                "9. checkTemplateVsDerived — template markers for templates, derived markers for derived",
                "10. checkNavigationAnchors — [[_top]] exists, <<anchor>> references point to valid anchors",
                "11. checkBlockDelimiters — matched opening/closing delimiters (====, ----, ****, ____)"
            ]
        },

        "blocks": {
            "required_markers": ["METADATA", "HEADER", "CONTEXT", "CONTENT", "FOOTER"],
            "end_markers": ["END METADATA", "END HEADER", "END CONTEXT", "END CONTENT", "END FOOTER"],
            "order": "METADATA < HEADER < CONTEXT < CONTENT < FOOTER",
            "block_severity": "error for derived, warn for templates",
            "end_severity": "warn"
        },

        "required_attributes": {
            "note": "Minimum :attribute: set for a valid AsciiDoc document",
            "always_required": [":key:", ":title:", ":type:", ":status:", ":version:", ":created:", ":revdate:", ":authors:", ":author:", ":derives_from:", ":verse-ref:", ":verse-kjv-text:", ":biblical_foundation:", ":toc:"],
            "severity": "error for :key:/:title:/:status:/:version:; warn for others"
        },

        "section_requirements": {
            "HEADER": {
                "required": ["H.1", "H.2", "H.3", "H.4", "H.5", "H.6"],
                "severity": "warn",
                "note": "All HEADER sections expected — HEADER is the first impression"
            },
            "CONTEXT": {
                "required": ["C.1"],
                "recommended": ["C.2", "C.3", "C.4", "C.5", "C.6", "C.7", "C.8"],
                "reserved_allowed": true,
                "severity": "info for missing recommended sections"
            },
            "CONTENT": {
                "required": ["T.1"],
                "recommended": ["T.2", "T.3", "T.4"],
                "reserved_allowed": true,
                "severity": "info for missing recommended sections"
            },
            "FOOTER": {
                "required": ["F.1", "F.2", "F.4"],
                "recommended": ["F.3"],
                "severity": "warn for missing required, info for F.3"
            }
        },

        "template_rules": {
            "template_markers": ["/// @omni template", "TEMPLATE NOTES — DELETE WHEN USING"],
            "derived_markers": ["/// @omni:req key = B-", "// #!omni document --adoc"],
            "placeholder_format": "[BRACKETED] values in templates"
        },

        "transformer_planned": {
            "capabilities": [
                "Fix block separator widths for consistency",
                "Add [[_top]] anchor if missing",
                "Validate delimiter matching (open/close counts)"
            ],
            "limitations": [
                "Does NOT inject missing blocks",
                "Does NOT add missing :attributes:",
                "Does NOT generate content sections"
            ],
            "usage": "deno run --allow-read --allow-write mod.ts transform adoc <file>  (future)"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Look that thou make them after their pattern. — Exodus 25:40",
    "_X1_never": [
        "Remove block boundary requirements (METADATA, HEADER, CONTEXT, CONTENT, FOOTER)",
        "Change the 5-block order (documentation ALWAYS needs HEADER before CONTEXT before CONTENT)",
        "Remove the biblical grounding requirement (F.1 + M.8) — Kingdom purpose is structural, not decorative",
        "Break the schema ↔ adoc.ts linter parallel without updating both (when linter exists)"
    ],
    "_X1_careful": [
        "Adding new required :attributes: (cascades to all AsciiDoc files)",
        "Changing METADATA section numbering (M.1-M.12)",
        "Modifying HEADER section structure (H.1-H.6)",
        "Adding required CONTEXT sections beyond C.1"
    ],
    "_X1_safe": [
        "Adding recommended CONTENT section patterns (T.2-T.4)",
        "Adding new M.12+ content attributes for domain-specific documents",
        "Adding new AsciiDoc toolkit elements to the format mapping",
        "Adding descriptions and examples to section definitions"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "adoc.ts runtime linter implementing the 11 planned checks",
        "Cross-document link validation (link:path[] targets exist)",
        "Attribute resolution validation ({attribute} references resolve)",
        "Layered reading score — measures how well document serves scan/skim/read/study levels",
        "PDF output validation (admonitions render, TOC populates, collapsibles expand)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/L1-omnicode/ladder/schemas/base-3block-schema.jsonc — Base concepts (shared $defs)",
        "b-word/L1-omnicode/ladder/schemas/go-4block-schema.jsonc — Go 4-block sibling",
        "b-word/L1-omnicode/ladder/schemas/rust-4block-schema.jsonc — Rust 4-block sibling",
        "b-word/L1-omnicode/ladder/schemas/makefile-4block-schema.jsonc — Makefile 4-block sibling",
        "b-word/seed/documentation/L0/adoc/asciidoc-base.adoc — Canonical 5-block AsciiDoc template",
        "c-tov/cws-struct/lib/formats/adoc.ts — Runtime linter (future — not yet implemented)"
    ],
    "_X4_block_comparison": {
        "note": "How 5-block maps to 4-block and 3-block",
        "3_block": "METADATA → CONTENT → CLOSING (data)",
        "4_block": "METADATA → SETUP → BODY → CLOSING (code)",
        "5_block": "METADATA → HEADER → CONTEXT → CONTENT → FOOTER (documentation)",
        "mapping": {
            "METADATA": "Same across all — identity is universal",
            "HEADER": "Documentation only — human orientation (code doesn't need it)",
            "CONTEXT_to_SETUP": "CONTEXT prepares human understanding; SETUP prepares compiler understanding",
            "CONTENT_to_BODY": "CONTENT delivers document value; BODY delivers code value",
            "FOOTER_to_CLOSING": "FOOTER grounds in truth + connects; CLOSING summarizes + constrains"
        }
    },

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Documentation is the human face of the system. Code compiles and runs — it serves the machine first, the developer second. Documentation serves the human first, always. That's why it gets two extra blocks: HEADER for the handshake ('here's who I am and what I offer') and CONTEXT for the invitation ('here's what you need to know before we begin'). The 5-block structure isn't overhead — it's the discipline that makes documentation genuinely serve both shepherd (5-second scan) and scholar (deep study). PhD rigor + Bible accessibility, in structure.",
    "_X5_scripture": "Look that thou make them after their pattern. — Exodus 25:40",
    "_X5_anchor": "Structure is pattern. Pattern is Exodus 25:40. Documentation serves humans the way the tabernacle served worship — every element intentional, every boundary purposeful.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
