{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-extensions",
    "_P1_from": "b-word/seed/data/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "registry",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/definitions/omni",
    "_P3_includes": "none",
    "_P3_provides": ["EXTENSION_REGISTRY"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "OmniCode Extension Registry",
    "_P5_brief": "Canonical registry of all file extensions in the OmniCode ecosystem — system extensions, output formats, and their relationships.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "omnicode-extensions.jsonc",
        "key": "B-definitions-omni-extensions",
        "title": "OmniCode Extension Registry",
        "type": "Data (Registry)",
        "component": "Ladder",
        "role": "Single source of truth for all OmniCode file extensions"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "Genesis 1:4 — And God saw the light, that it was good: and God divided the light from the darkness.",
        "principle": "God named what He created. Every extension has a name, a purpose, and a place in the order. Naming is the first act of governance."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "none — this is the registry, it depends on nothing",
        "consumers": "OmniCode compiler, cws-struct linter, MillenniumOS, IDE integrations"
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Two categories of extensions:
    //
    //   SYSTEM — Native to OmniCode/MillenniumOS. The "Omni" family.
    //            These don't exist outside the ecosystem.
    //
    //   FORMAT — Independent formats that OmniCode can target.
    //            These exist with or without OmniCode.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "registry_format": {
        "extension": "The file extension (e.g., .omni)",
        "name": "Human-readable format name",
        "category": "system | format",
        "purpose": "What this extension is for",
        "schema": "Path to schema definition (relative to definitions/omni/)",
        "linter": "Path to cws-struct handler (relative to c-tov/cws-struct/)",
        "block_structure": "3-block | 4-block | 5-block | n/a",
        "compiled_from": "Source extension (null if independent or source itself)",
        "compiles_to": "Array of target extensions (null if not a source format)",
        "mime_type": "MIME type for HTTP/system registration",
        "status": "active | planned | reserved"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // The registry itself.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    // ═══════════════════════════════════════════════════════════
    // SYSTEM EXTENSIONS — Native to OmniCode/MillenniumOS
    // ═══════════════════════════════════════════════════════════
    //
    // The "Omni" family. These are OmniCode's native tongue.

    "system": {

        ".omni": {
            "name": "OmniCode Source",
            "category": "system",
            "purpose": "OmniCode source code — the abstract form that compiles to concrete formats",
            "schema": "omni-source-schema.jsonc",
            "linter": "lib/formats/omni.ts",
            "block_structure": "3-block",
            "compiled_from": null,
            "compiles_to": [".toml", ".jsonc", ".json", ".ofd"],
            "mime_type": "text/x-omnicode",
            "status": "active",
            "note": "The source language. Human writes .omni, compiler outputs format-specific files."
        },

        ".ofd": {
            "name": "OmniFold",
            "category": "system",
            "purpose": "Compiled folder metadata — what MillenniumOS reads to understand a directory",
            "schema": "omni-folder-schema.jsonc",
            "linter": "lib/formats/ofd.ts",
            "block_structure": "fixed-schema",
            "compiled_from": ".omni",
            "compiles_to": null,
            "mime_type": "application/x-omnifold",
            "status": "active",
            "note": "root.omni → root.ofd. Clean JSON, fixed schema, no _ key ceremony. First compiled 2026-02-13."
        }
    },

    // ═══════════════════════════════════════════════════════════
    // FORMAT EXTENSIONS — Independent formats, OmniCode targets
    // ═══════════════════════════════════════════════════════════
    //
    // These exist with or without OmniCode.
    // OmniCode can compile TO them, and they can also be written
    // directly with OmniCode 3-block structure.

    "formats": {

        ".toml": {
            "name": "TOML",
            "category": "format",
            "purpose": "Configuration files — nested tables map naturally to hierarchy",
            "schema": "toml-3block-schema.jsonc",
            "linter": "lib/formats/toml.ts",
            "block_structure": "3-block",
            "compiled_from": ".omni",
            "compiles_to": null,
            "mime_type": "application/toml",
            "status": "active",
            "note": "Can be written directly (with 3-block structure) OR compiled from .omni source"
        },

        ".jsonc": {
            "name": "JSONC",
            "category": "format",
            "purpose": "Configuration/data files with comments — flat _ keys carry structure",
            "schema": "json-3block-schema.jsonc",
            "linter": "lib/formats/json.ts",
            "block_structure": "3-block",
            "compiled_from": ".omni",
            "compiles_to": null,
            "mime_type": "application/jsonc",
            "status": "active",
            "note": "JSON with comments. _ keys for structure, // comments for human explanation"
        },

        ".json": {
            "name": "JSON",
            "category": "format",
            "purpose": "Data interchange — flat _ keys carry structure, no comments",
            "schema": "json-3block-schema.jsonc",
            "linter": "lib/formats/json.ts",
            "block_structure": "3-block",
            "compiled_from": ".omni",
            "compiles_to": null,
            "mime_type": "application/json",
            "status": "active",
            "note": "Pure JSON. Same schema as JSONC but without comment support"
        },

        ".mk": {
            "name": "Makefile",
            "category": "format",
            "purpose": "Build system — # comments carry OmniCode 4-block structure, build logic between them",
            "schema": "makefile-4block-schema.jsonc",
            "linter": "lib/formats/makefile.ts",
            "block_structure": "4-block",
            "compiled_from": null,
            "compiles_to": null,
            "mime_type": "text/x-makefile",
            "status": "active",
            "basenames": ["Makefile", "GNUmakefile"],
            "note": "Comment-based structure. Also matches Makefile and GNUmakefile by basename."
        },

        ".editorconfig": {
            "name": "EditorConfig",
            "category": "format",
            "purpose": "Editor settings — # comments carry OmniCode 3-block structure, INI-like config between them",
            "schema": "dotfile-3block-schema.jsonc",
            "linter": "lib/formats/dotfiles.ts",
            "block_structure": "3-block",
            "compiled_from": null,
            "compiles_to": null,
            "mime_type": "text/plain",
            "status": "active",
            "note": "Comment-based structure. Matched by basename."
        },

        ".gitignore": {
            "name": "Git Ignore",
            "category": "format",
            "purpose": "Git exclusion patterns — # comments carry OmniCode 3-block structure, glob patterns between them",
            "schema": "dotfile-3block-schema.jsonc",
            "linter": "lib/formats/dotfiles.ts",
            "block_structure": "3-block",
            "compiled_from": null,
            "compiles_to": null,
            "mime_type": "text/plain",
            "status": "active",
            "note": "Comment-based structure. Matched by basename."
        },

        ".gitmessage": {
            "name": "Git Message Template",
            "category": "format",
            "purpose": "Commit message template — # comments carry OmniCode 3-block structure, template prose between them",
            "schema": "dotfile-3block-schema.jsonc",
            "linter": "lib/formats/dotfiles.ts",
            "block_structure": "3-block",
            "compiled_from": null,
            "compiles_to": null,
            "mime_type": "text/plain",
            "status": "active",
            "note": "Comment-based structure. Matched by basename."
        },

        ".env": {
            "name": "Environment Variables",
            "category": "format",
            "purpose": "Runtime configuration — # comments carry OmniCode 3-block structure, KEY=value pairs between them",
            "schema": "dotfile-3block-schema.jsonc",
            "linter": "lib/formats/dotfiles.ts",
            "block_structure": "3-block",
            "compiled_from": null,
            "compiles_to": null,
            "mime_type": "text/plain",
            "status": "active",
            "note": "Comment-based structure. Matched by basename."
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "validation": {
        "rule": "Every extension must have: name, category, purpose, status",
        "schema_required_for": "active extensions with block_structure",
        "linter_required_for": "active extensions (runtime validation)",
        "naming_convention": {
            "system": "Extensions native to OmniCode use .o* prefix family",
            "format": "Extensions use their standard names (.toml, .json, etc.)"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "And God called the light Day, and the darkness he called Night. — Genesis 1:5",
    "_X1_never": [
        "Remove an active extension without deprecation period",
        "Change an extension's name or meaning after it's in use",
        "Register an extension that conflicts with a well-known format"
    ],
    "_X1_careful": [
        "Adding new system extensions (expands the Omni family contract)",
        "Changing a status from active to deprecated (existing files affected)",
        "Modifying schema references (downstream validators depend on them)"
    ],
    "_X1_safe": [
        "Adding new format extensions (OmniCode grows by addition)",
        "Adding planned/reserved extensions (documenting intent)",
        "Updating schema or linter paths as tools move"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "4-block extensions for code formats (Go, C, Rust)",
        "5-block extensions for documentation formats (AsciiDoc, Markdown)",
        "IDE file association mappings (VS Code, MillenniumOS file manager)"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/definitions/omni/base-3block-schema.jsonc — Shared concepts",
        "b-word/definitions/omni/omni-source-schema.jsonc — .omni language spec",
        "b-word/definitions/omni/json-3block-schema.jsonc — JSON format schema",
        "b-word/definitions/omni/toml-3block-schema.jsonc — TOML format schema",
        "b-word/definitions/omni/makefile-4block-schema.jsonc — Makefile format schema",
        "b-word/definitions/omni/dotfile-3block-schema.jsonc — Dotfile format schema",
        "b-word/definitions/omni/omnicode-operators.toml — Operator definitions"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "God named what He created. The Omni family (.omni, .ofd) are system extensions — native to OmniCode and MillenniumOS. Format extensions (.toml, .jsonc, .json) are independent languages that OmniCode speaks into. The registry grows by addition, never by breaking what exists.",
    "_X5_scripture": "And God called the light Day, and the darkness he called Night. — Genesis 1:5",
    "_X5_anchor": "Naming is governance. Every extension has a name, a purpose, and a place.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
