{
    // #!omni data --jsonc

    // ===================================================================
    // OMNICODE PRAGMA [PRAGMA]
    // ===================================================================

    "_pragma_format": "@omni data --jsonc",
    "_P1_key": "B-L1-schemas-content-whole-doc",
    "_P1_at": "a-01.00",
    "_P2_type": "data",
    "_P2_subtype": "content-character-schema",
    "_P2_role": "content-whole",
    "_P5_title": "Document Content Character — What Documentation IS",
    "_P5_brief": "Format-independent definition of what document content is. Documentation is narrative, structured, human-readable. It explains, guides, teaches, grounds. This schema defines the NATURE of document content — what all documentation has in common regardless of format.",

    // ===================================================================
    // CONTENT BLOCK [CONTENT]
    // ===================================================================

    "character": {
        "name": "document",
        "structure": "5-block",
        "nature": "narrative",

        "description": "Document content is explanation for humans. It guides understanding, teaches concepts, records decisions, and grounds work in eternal truth. Unlike code (which acts) and data (which describes), documentation EXPLAINS.",

        "invariants": {
            "description": "Properties true of ALL document content, regardless of format.",

            "narrative": "Documentation tells a story — it has flow, progression, and purpose. Even a reference document has narrative logic (organization by category, alphabetical, complexity).",
            "human_readable": "Documentation's primary audience is humans. Machine-parseability is a bonus, not the goal. If a human can't read it, it's not documentation.",
            "structured": "Documentation has sections, headings, hierarchy. PhD rigor means complete, defensible, machine-parseable structure. Bible accessibility means any reader can enter at any level.",
            "contextual": "Documentation assumes a reader — it answers 'what do you need to know before reading this?' (CONTEXT) and 'where do you go next?' (FOOTER).",
            "grounded": "Documentation is anchored in truth — closing scripture connects technical content to eternal purpose. Every document ends with something bigger than itself.",
            "versioned": "Documentation has identity — OmniCode pragma carries key, version, format. Every document knows who it is."
        },

        "content_patterns": {
            "description": "What document content looks like in each block, regardless of format.",

            "METADATA": {
                "pattern": "Machine-readable identity — hidden from human view, consumed by tools",
                "examples": "AsciiDoc: document attributes. Markdown: YAML frontmatter or HTML comments. LaTeX: preamble metadata.",
                "invariant": "Every document has identity. METADATA is for machines; HEADER is for humans. Both are required."
            },

            "HEADER": {
                "pattern": "Visual orientation — the reader's first impression",
                "examples": "AsciiDoc: document title + preamble. Markdown: # Title + opening quote + TOC. LaTeX: \\maketitle.",
                "invariant": "Every document needs a human-friendly entry point. The title, the opening quote, the navigation — all serve the reader's orientation."
            },

            "CONTEXT": {
                "pattern": "Reader preparation — shared assumptions before content begins",
                "examples": "Quick start section, scope table, prerequisites list, key terms glossary.",
                "invariant": "Every document has assumed knowledge. CONTEXT makes those assumptions explicit. Without it, readers guess — and guess wrong."
            },

            "CONTENT": {
                "pattern": "The substance — what this document exists to deliver",
                "examples": "Guide: step-by-step instructions. Reference: categorized entries. Journal: reflections and insights. Whitepaper: argument and evidence.",
                "invariant": "CONTENT is why the document exists. Its internal organization serves its specific purpose."
            },

            "FOOTER": {
                "pattern": "Closing anchor — references, related work, eternal grounding",
                "examples": "Related documents table, citations, changelog, closing scripture.",
                "invariant": "Every document ends by pointing beyond itself — to related work and to eternal truth."
            }
        },

        "quality_standard": {
            "description": "The dual standard for all documentation content.",
            "phd_rigor": "Complete, defensible, machine-parseable. Every claim supported. Every section justified. Structure that survives scrutiny.",
            "bible_accessibility": "Any reader can enter at any level. 5-second scan reveals purpose. 5-minute read gives working knowledge. Deep study rewards depth.",
            "principle": "Same document serves both. Structure is constant. Tone adapts. The shepherd scans it AND the scholar studies it."
        },

        "transpilation_role": {
            "description": "During format conversion (e.g., AsciiDoc → Markdown), document content character stays constant. The NATURE of the content (narrative, structured, grounded) doesn't change — only the MARKUP changes.",
            "invariant_during_conversion": ["structure (5-block skeleton)", "semantic content (what the document EXPLAINS)", "hierarchy and organization"],
            "variable_during_conversion": ["markup syntax", "heading conventions", "cross-reference mechanisms", "metadata representation"]
        }
    },

    // ===================================================================
    // CLOSING BLOCK [CLOSING]
    // ===================================================================

    "_X5_note": "Documentation is the most generous of the three types. Code serves machines first. Data serves parsers first. Documentation serves people first. The 5-block structure honors this generosity — two extra blocks (HEADER and CONTEXT) exist purely because humans need them. That's not overhead. That's hospitality. And hospitality is a Kingdom value.",
    "_X5_scripture": "Be not forgetful to entertain strangers: for thereby some have entertained angels unawares. — Hebrews 13:2"
}
