{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-definitions-omni-base-3block-schema",
    "_P1_from": "b-word/seed/data/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "definitions",
    "_P3_layer": "b-word/definitions/omni",
    "_P3_includes": "none",
    "_P3_provides": ["BASE_3BLOCK_SCHEMA", "SHARED_DEFS"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Base 3-Block Schema",
    "_P5_brief": "Format-independent foundation for OmniCode 3-block structure. Defines shared type definitions ($defs) that format-specific schemas reference.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "base-3block-schema.jsonc",
        "key": "B-definitions-omni-base-3block-schema",
        "title": "Base 3-Block Schema",
        "type": "Data (Schema Foundation)",
        "component": "Ladder",
        "role": "Define format-independent 3-block structure shared by all OmniCode formats"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-13",
        "updated": "2026-02-13"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING — "In the beginning God created the heaven and the earth."
    //   — Genesis 1:1
    "_M4_grounding": {
        "scripture": "Genesis 1:1 — In the beginning God created the heaven and the earth.",
        "principle": "Before format, before syntax, before representation — there is structure. This schema defines the structure that every format must express."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "none — this is the root schema",
        "consumers": "json-3block-schema.jsonc, toml-3block-schema.jsonc, future format schemas",
        "relationship": "Base provides shared $defs. Format schemas inherit concepts and map to format-specific representation."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract. This file defines the contract itself."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // The 3-block structure is format-independent:
    //   PRAGMA → METADATA → CONTENT → CLOSING
    //
    // Each format expresses this differently:
    //   JSON  — flat _ keys  (_pragma, _P1_key, _M1_identity, _Cc, _X1)
    //   TOML  — nested tables ([_pragma], [_pragma.P1_core], [_closing.X1_policy])
    //   Go    — comments (// METADATA BLOCK, // M.1 IDENTITY)
    //   C     — comments (/* METADATA BLOCK */, /* M.1 IDENTITY */)
    //
    // The $defs below define WHAT each section contains.
    // Format schemas define HOW to represent it.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Schema identity and structure overview.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://creativeworkzstudio.com/schemas/omnicode/base-3block.schema.json",
    "title": "OmniCode Base 3-Block Structure",
    "description": "Format-independent definition of OmniCode 3-block structure. Provides shared $defs for pragma, metadata, content, and closing concepts. Format-specific schemas (JSON, TOML) inherit and map these to their native representation.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Shared type definitions ($defs). Each definition describes
    // WHAT a section contains, independent of format.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "$defs": {

        // ═══════════════════════════════════════════════════════
        // SHARED TYPES — Reusable patterns
        // ═══════════════════════════════════════════════════════

        "living_version": {
            "type": "string",
            "pattern": "^[abc]-[0-9]{2}\\.[0-9]{2}$|^template$",
            "description": "Living version format: stage-phase.completion (a=alpha, b=beta, c=stable) or 'template' for seed files"
        },

        "iso_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "ISO 8601 date format: YYYY-MM-DD"
        },

        "bereshit_key": {
            "type": "string",
            "pattern": "^B-",
            "description": "Unique Bereshit identifier with B- prefix, derived from file path"
        },

        "content_type": {
            "type": "string",
            "enum": ["data", "code", "documentation"],
            "description": "Primary content classification"
        },

        "block_structure": {
            "type": "string",
            "enum": ["3-block", "4-block", "5-block"],
            "description": "Block pattern: 3-block (data), 4-block (code), 5-block (documentation)"
        },

        "architectural_role": {
            "type": "string",
            "enum": ["ladder", "rung", "rails", "seed", "scaffold"],
            "description": "Position in architecture: ladder=foundation, rung=builds-on, rails=infrastructure, seed=template, scaffold=temporary"
        },

        "lifecycle_status": {
            "type": "string",
            "enum": ["Draft", "Active", "Deprecated", "Archived"],
            "description": "Document lifecycle state"
        },

        // ═══════════════════════════════════════════════════════
        // PRAGMA — OmniCode Identity (P.1–P.5)
        // ═══════════════════════════════════════════════════════
        //
        // Pragma establishes WHO this file is.
        // Every format MUST express these five sections.

        "pragma_legend": {
            "type": "object",
            "description": "Field classification: req (required), inh (inherited), ins (instance-specific)",
            "properties": {
                "req": { "type": "string", "description": "REQUIRED — must exist, validation fails without" },
                "inh": { "type": "string", "description": "INHERITED — from template, override allowed" },
                "ins": { "type": "string", "description": "INSTANCE — file-specific, unique values" }
            },
            "required": ["req", "inh", "ins"]
        },

        "P1_core": {
            "type": "object",
            "description": "P.1 CORE — Identity: unique key, template derivation, version",
            "properties": {
                "key": { "$ref": "#/$defs/bereshit_key" },
                "from": { "type": "string", "description": "Template derivation path (b-word/ relative) or 'none' for roots" },
                "at": { "$ref": "#/$defs/living_version" }
            },
            "required": ["key", "from", "at"]
        },

        "P2_family": {
            "type": "object",
            "description": "P.2 FAMILY — Classification: type, subtype, role, structure",
            "properties": {
                "type": { "$ref": "#/$defs/content_type" },
                "subtype": { "type": "string", "description": "Subtype (config, schema, types, constants, etc.)" },
                "role": { "$ref": "#/$defs/architectural_role" },
                "structure": { "$ref": "#/$defs/block_structure" }
            },
            "required": ["type", "subtype", "role", "structure"]
        },

        "P3_instance": {
            "type": "object",
            "description": "P.3 INSTANCE — File Details: component position, layer path, dependencies, capabilities",
            "properties": {
                "component": { "type": "string", "description": "Component position in hierarchy" },
                "layer": { "type": "string", "description": "Layer path within b-word/" },
                "includes": {
                    "oneOf": [
                        { "type": "string", "const": "none" },
                        { "type": "array", "items": { "type": "string" } }
                    ],
                    "description": "Dependencies ('none' or array of paths)"
                },
                "provides": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Capabilities (UPPER_SNAKE constants)"
                }
            },
            "required": ["component", "layer", "includes", "provides"]
        },

        "P4_architecture": {
            "type": "object",
            "description": "P.4 ARCHITECTURE — Scaling Context: layer mapping, anchor chain",
            "properties": {
                "layers": { "type": "string", "description": "Layer-to-language mapping" },
                "streams": { "type": "string", "description": "Build stream definitions" },
                "anchor": { "type": "string", "description": "Anchor chain (genesis_1_1 -> ...)" }
            },
            "required": ["anchor"]
        },

        "P5_summary": {
            "type": "object",
            "description": "P.5 SUMMARY — Human Identity: display title, brief description",
            "properties": {
                "title": { "type": "string", "description": "Human-readable display title" },
                "brief": { "type": "string", "description": "One-sentence description" },
                "usage": { "type": "string", "description": "Usage instructions" }
            },
            "required": ["title", "brief"]
        },

        // ═══════════════════════════════════════════════════════
        // METADATA — M.1–M.5 (required) + M.6–M.10 (optional)
        // ═══════════════════════════════════════════════════════
        //
        // Metadata establishes WHAT this file's state is.
        // M1-M5 are the base contract. M6+ extend per domain.

        "M1_identity": {
            "type": "object",
            "description": "M.1 IDENTITY — File identity: filename, key, title, type, component, role",
            "properties": {
                "file": { "type": "string" },
                "key": { "$ref": "#/$defs/bereshit_key" },
                "title": { "type": "string" },
                "type": { "type": "string" },
                "component": { "type": "string" },
                "role": { "type": "string" }
            },
            "required": ["file", "key", "title", "type", "component", "role"]
        },

        "M2_state": {
            "type": "object",
            "description": "M.2 STATE — Version and lifecycle: version, status, created, updated",
            "properties": {
                "version": { "$ref": "#/$defs/living_version" },
                "status": { "$ref": "#/$defs/lifecycle_status" },
                "created": { "$ref": "#/$defs/iso_date" },
                "updated": { "$ref": "#/$defs/iso_date" }
            },
            "required": ["version", "status", "created", "updated"]
        },

        "M3_attribution": {
            "type": "object",
            "description": "M.3 ATTRIBUTION — Authorship: architect, implementation, organization, copyright",
            "properties": {
                "architect": { "type": "string" },
                "implementation": { "type": "string" },
                "organization": { "type": "string" },
                "copyright": { "type": "string" }
            },
            "required": ["architect", "implementation"]
        },

        "M4_grounding": {
            "type": "object",
            "description": "M.4 GROUNDING — Biblical foundation: scripture reference, derived principle, anchor statement",
            "properties": {
                "scripture": { "type": "string" },
                "principle": { "type": "string" },
                "anchor": { "type": "string" }
            },
            "required": ["scripture", "principle"]
        },

        "M5_dependencies": {
            "type": "object",
            "description": "M.5 DEPENDENCIES — Dependency graph: requires, consumers, integration notes",
            "properties": {
                "requires": { "type": "string" },
                "consumers": { "type": "string" },
                "integration": { "type": "string" },
                "if_missing": { "type": "string" },
                "related_data": { "type": "object" },
                "cross_format": { "type": "object" }
            },
            "required": ["requires", "consumers"]
        },

        "M_extension_note": {
            "type": "object",
            "description": "Extension contract — documents base (M1-M5) + domain extension (M6+) rules",
            "properties": {
                "required": { "type": "array", "items": { "type": "string" } },
                "extension": { "type": "string" },
                "rule": { "type": "string" }
            }
        },

        // ═══════════════════════════════════════════════════════
        // CONTENT — Cc (config) + Co (operations) + Cv (validation)
        // ═══════════════════════════════════════════════════════
        //
        // Content is WHERE the actual data lives.
        // Three sections, always in this order:
        //   Cc = Configurations (identity, settings, format rules)
        //   Co = Operations (the primary data — what this file IS)
        //   Cv = Validation (verification rules, health scoring)

        "content_sections": {
            "type": "object",
            "description": "Content block structure — three sections in fixed order",
            "properties": {
                "Cc": {
                    "type": "string",
                    "const": "Content Configurations",
                    "description": "Format rules, settings, identity of the content"
                },
                "Co": {
                    "type": "string",
                    "const": "Content Operations",
                    "description": "Primary data — the actual content of this file"
                },
                "Cv": {
                    "type": "string",
                    "const": "Content Validation",
                    "description": "Verification rules, health scoring, expected state"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING — X.1–X.5
        // ═══════════════════════════════════════════════════════
        //
        // Closing provides guidance for LIVING with this file.
        // Five sections, X.1 and X.4 required, others recommended.

        "X1_policy": {
            "type": "object",
            "description": "X.1 POLICY — Modification guidelines: never, careful, safe classifications",
            "properties": {
                "scripture": { "type": "string" },
                "never": { "type": "array", "items": { "type": "string" }, "description": "Actions that must NEVER be taken" },
                "careful": { "type": "array", "items": { "type": "string" }, "description": "Actions requiring caution" },
                "safe": { "type": "array", "items": { "type": "string" }, "description": "Actions that are always safe" }
            }
        },

        "X2_extension": {
            "type": "object",
            "description": "X.2 EXTENSION — Future ideas and planned work",
            "properties": {
                "planned": { "type": "array", "items": { "type": "string" } },
                "considered": { "type": "array", "items": { "type": "string" } }
            }
        },

        "X3_troubleshooting": {
            "type": "object",
            "description": "X.3 TROUBLESHOOTING — Common problems and solutions",
            "properties": {
                "scripture": { "type": "string" }
            },
            "additionalProperties": { "type": "string" }
        },

        "X4_reference": {
            "type": "object",
            "description": "X.4 REFERENCE — Quick lookup: related files, validation commands",
            "properties": {
                "related_files": { "type": "array", "items": { "type": "string" } },
                "required_sections": { "type": "array", "items": { "type": "string" } },
                "validate": { "type": "string" }
            }
        },

        "X5_note": {
            "type": "object",
            "description": "X.5 NOTE — Final guidance: closing thought, scripture, anchor",
            "properties": {
                "note": { "type": "string" },
                "scripture": { "type": "string" },
                "anchor": { "type": "string" }
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // This is the base schema — it defines $defs only.
    // Format-specific schemas compose these into properties/required.

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "This schema provides $defs only. Validate format-specific schemas against their targets.",
    "_Cv_expected_state": "All $defs present with correct types, patterns, and required fields.",

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X1_never": [
        "Remove a $def that format schemas reference",
        "Change required fields without updating all format schemas",
        "Remove the base contract (M1-M5, P1-P5, Cc/Co/Cv, X1-X5)"
    ],
    "_X1_careful": [
        "Adding new $defs (format schemas need to adopt them)",
        "Changing enum values (affects all formats)",
        "Modifying required arrays in $defs (cascades to all validated files)"
    ],
    "_X1_safe": [
        "Adding optional properties to existing $defs",
        "Adding description fields",
        "Adding new optional $defs that don't affect existing schemas"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "4-block base schema (code: METADATA → SETUP → BODY → CLOSING)",
        "5-block base schema (documentation: METADATA → HEADER → CONTEXT → CONTENT → FOOTER)",
        "JSON Schema $ref composition across format schemas"
    ],

    // X.3 TROUBLESHOOTING
    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "defs_not_found": "Format schemas reference $defs by path: #/$defs/M1_identity. Verify the $def name matches.",
        "format_mismatch": "This is the BASE — it doesn't validate files directly. Use json-3block-schema.jsonc or toml-3block-schema.jsonc.",
        "which_schema": "JSON/JSONC files → json-3block-schema. TOML files → toml.ts handler. This file defines what both share."
    },

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/definitions/omni/json-3block-schema.jsonc — JSON format schema (child)",
        "b-word/definitions/omni/toml-3block-schema.jsonc — TOML format schema (child)",
        "c-tov/cws-struct/lib/formats/json.ts — JSON runtime linter",
        "c-tov/cws-struct/lib/formats/toml.ts — TOML runtime linter"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Before format, before syntax, before representation — there is structure. This schema defines the structure that every format must express. Genesis 1 separated light from darkness before filling either. We separate structure from content before filling the formats.",
    "_X5_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X5_anchor": "The base of all bases. Every 3-block file traces back here.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
