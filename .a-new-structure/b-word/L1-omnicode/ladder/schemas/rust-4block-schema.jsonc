{
    // #!omni data --jsonc

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni data --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-L1-schemas-rust-4block-schema",
    "_P1_from": "b-word/seed/data/L0/json/config.jsonc",
    "_P1_at": "a-01.00",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "schema",
    "_P2_role": "ladder",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "schemas",
    "_P3_layer": "b-word/L1-omnicode/ladder/schemas",
    "_P3_includes": "none",
    "_P3_provides": ["RUST_4BLOCK_SCHEMA"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Rust 4-Block Schema",
    "_P5_brief": "Defines how Rust source files implement OmniCode 4-block structure using // comments. Block boundaries, //omni: directives, PRAGMA/METADATA statics (slice or BTreeMap), //! doc comments, and SETUP subsection ordering — all validated by the rust.ts linter.",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "rust-4block-schema.jsonc",
        "key": "B-L1-schemas-rust-4block-schema",
        "title": "Rust 4-Block Schema",
        "type": "Data (Schema Definition)",
        "component": "Ladder",
        "role": "Define how Rust source files express OmniCode 4-block structure through // comments, //omni: directives, and //! doc comments"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-01.00",
        "status": "Active",
        "created": "2026-02-15",
        "updated": "2026-02-15"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)"
    },

    // M.4 GROUNDING
    "_M4_grounding": {
        "scripture": "1 Corinthians 14:40 — Let all things be done decently and in order.",
        "principle": "Rust enforces correctness at compile time. The 4-block structure extends that philosophy to file-level organization — the compiler catches logic errors, the linter catches structural drift. Two layers of accountability, both serving the same truth: order precedes creation."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "base-3block-schema.jsonc — shared $defs for format-independent concepts",
        "consumers": "c-tov/cws-struct/lib/formats/rust.ts — runtime linter implements these rules",
        "cross_format": {
            "go_sibling": "b-word/L1-omnicode/ladder/schemas/go-4block-schema.jsonc — Go 4-block (also //-comment-based)",
            "makefile_sibling": "b-word/L1-omnicode/ladder/schemas/makefile-4block-schema.jsonc — Makefile 4-block (also comment-based)",
            "relationship": "Same OmniCode 4-block concepts, Rust-native expression via // comments, //! doc comments, and static identity"
        }
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Rust source files express 4-block structure through // comments:
    //   //omni:key B-crate-name            — identity directive
    //   //omni:code --rust -library         — type/format directive
    //   //omni:version a-01.00              — version directive
    //   //! Crate-level documentation       — Rust doc comments
    //   // ====...====                      — block boundary (76 = chars)
    //   // METADATA                         — block label
    //   // ────...────                      — subsection boundary (64 ─ chars)
    //   // END METADATA                     — block end marker
    //
    // Three file classifications:
    //   Template:    // #!omni template --rust -library (no compilation)
    //   Crate root:  lib.rs or main.rs — holds crate identity (PRAGMA/METADATA statics)
    //   Module file: Other .rs files — identity delegated to lib.rs
    //
    // Identity patterns:
    //   Slice-based:    pub static PRAGMA: &[(&str, &str)] = &[...]
    //   LazyLock-based: static PRAGMA: LazyLock<BTreeMap<&str, &str>>
    //   Both are valid — slice for lightweight, BTreeMap for runtime-queryable.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // How Rust conventions map to 4-block concepts.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "Rust — rustfmt-formatted source, // comments carry structural metadata, //! for doc comments",
    "_Cc_key_convention": "//omni: directives before first use/mod/fn, // block labels after doc comments",

    "format_mapping": {
        "note": "How OmniCode concepts map to Rust syntax",
        "identity_directives": "//omni:key, //omni:code, //omni:version — before first code or block marker",
        "doc_comments": "//! crate/module-level documentation — Rust-native, appears early in file",
        "block_boundaries": "// ====...==== (76 =) separator + // BLOCK_NAME label",
        "end_markers": "// END BLOCK_NAME — marks block end",
        "subsection_markers": "// ────...Label — Unicode box-drawing for subsection headers",
        "separators": "// ====...==== (76 chars) for blocks, // ────...──── (64 ─ chars) for subsections",
        "template_directive": "// #!omni template --rust -library (first structural line in templates)"
    },

    "comment_conventions": {
        "block_separator": "// ============================================================================",
        "block_label": "// METADATA | // SETUP | // BODY | // CLOSING",
        "end_marker": "// END METADATA | // END SETUP | // END BODY | // END CLOSING",
        "subsection_separator_unicode": "// ────────────────────────────────────────────────────────────────",
        "subsection_separator_ascii": "// ----------------------------------------------------------------",
        "doc_comment": "//! Crate-level or module-level documentation",
        "omni_directive": "//omni:key B-crate-name",
        "pragma_line": "// #!omni template --rust -library"
    },

    "file_classification": {
        "template": {
            "markers": ["// #!omni template"],
            "identity": "#!omni meta.key or // Key: comment",
            "note": "Template files contain [bracketed] placeholders and are not compiled"
        },
        "crate_root": {
            "files": ["lib.rs", "main.rs"],
            "identity": "PRAGMA/METADATA statics + //omni:key directive",
            "doc_comments": "//! crate-level docs recommended",
            "note": "Crate root holds identity for the entire crate. //omni:key is required here."
        },
        "module_file": {
            "identity": "Inherited from crate root (lib.rs)",
            "directives": "Optional — //omni: directives not required for module files",
            "blocks": "Optional — module files without block markers are valid",
            "note": "Module files that DO have //omni: or block markers get full validation"
        }
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Complete Rust 4-block structure definition.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "rust_structure": {

        // ═══════════════════════════════════════════════════════
        // DIRECTIVES — //omni: identity lines
        // ═══════════════════════════════════════════════════════

        "directives": {
            "purpose": "OmniCode identity directives — before first use/mod/fn or block marker",

            "required": {
                "//omni:key": {
                    "purpose": "Bereshit key — unique crate/file identifier",
                    "pattern": "//omni:key B-crate-path-name",
                    "severity_crate_root": "error",
                    "severity_module": "warn",
                    "example": "//omni:key B-L0-config"
                }
            },

            "recommended": {
                "//omni:code": {
                    "purpose": "File type and format classification",
                    "pattern": "//omni:code --rust -library | --rust -executable | --rust -demo-test",
                    "severity": "warn",
                    "known_values": ["--rust -library", "--rust -executable", "--rust -demo-test"]
                },
                "//omni:version": {
                    "purpose": "Living version",
                    "pattern": "//omni:version a-01.00",
                    "severity": "warn"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // METADATA BLOCK
        // ═══════════════════════════════════════════════════════

        "METADATA": {
            "purpose": "File identity and context in // comments",
            "boundary": "// ============================================================================",
            "label": "// METADATA",
            "end_marker": "// END METADATA",
            "required": true,
            "severity": "error",

            "doc_comments": {
                "purpose": "//! crate-level or module-level Rust doc comments",
                "location": "Typically at the top of the file, before or near METADATA block",
                "crate_root_severity": "warn",
                "module_severity": "info"
            },

            "comment_fields": {
                "Key": { "required": true, "severity": "warn", "note": "Downgraded to info if lib.rs has PRAGMA static" },
                "Purpose": { "required": true, "severity": "warn", "note": "Downgraded to info if lib.rs has PRAGMA static" },
                "Biblical/Scripture": { "recommended": true, "severity": "info" },
                "Version": { "recommended": true, "severity": "info" }
            },

            "identity_statics": {
                "slice_pattern": {
                    "pragma": "pub static PRAGMA: &[(&str, &str)] = &[(\"P1.key\", \"...\"), ...]",
                    "metadata": "pub static METADATA: &[(&str, &str)] = &[(\"M1.key\", \"...\"), ...]",
                    "use_when": "Lightweight crates — no runtime allocation"
                },
                "btreemap_pattern": {
                    "pragma": "static PRAGMA: LazyLock<BTreeMap<&str, &str>> = LazyLock::new(|| { ... })",
                    "metadata": "static METADATA: LazyLock<BTreeMap<&str, &str>> = LazyLock::new(|| { ... })",
                    "use_when": "Crates needing runtime-queryable identity (lookups by key)"
                },
                "own_pattern": {
                    "pragma": "static OWN_PRAGMA: ... (identity crate self-registration)",
                    "note": "Identity crate uses OWN_PRAGMA to avoid naming collision with its public API"
                },
                "delegated_identity": {
                    "pattern": "pub mod identity;",
                    "note": "Config crate pattern — identity lives in a submodule",
                    "severity": "info"
                },
                "severity_crate_root": "warn",
                "severity_module": "not checked (identity delegated to lib.rs)"
            }
        },

        // ═══════════════════════════════════════════════════════
        // SETUP BLOCK
        // ═══════════════════════════════════════════════════════

        "SETUP": {
            "purpose": "Imports, type definitions, error types — everything needed before BODY logic",
            "boundary": "// ============================================================================",
            "label": "// SETUP",
            "end_marker": "// END SETUP",
            "required": true,
            "severity": "error",

            "subsection_order": {
                "note": "Canonical order — linter checks that present subsections appear in this sequence",
                "Imports": {
                    "pattern": "Imports",
                    "purpose": "use declarations — external crates and internal modules"
                },
                "ErrorTypes": {
                    "pattern": "Error Types",
                    "purpose": "Error enums and From implementations — Rust idiom: define errors early"
                },
                "CoreTypes": {
                    "pattern": "Core Types",
                    "purpose": "Primary types — structs, enums, traits, type aliases"
                }
            }
        },

        // ═══════════════════════════════════════════════════════
        // BODY
        // ═══════════════════════════════════════════════════════

        "BODY": {
            "purpose": "Core logic — implementations, functions, trait impls",
            "boundary": "// ============================================================================",
            "label": "// BODY",
            "end_marker": "// END BODY",
            "note": "BODY contains the actual Rust implementations. Subsection order is flexible — linter does not enforce BODY ordering for Rust (unlike Go)."
        },

        // ═══════════════════════════════════════════════════════
        // CLOSING
        // ═══════════════════════════════════════════════════════

        "CLOSING": {
            "purpose": "Closing comments — summary, identity registration, scripture anchor",
            "boundary": "// ============================================================================",
            "label": "// CLOSING",
            "end_marker": "// END CLOSING",
            "required": true,
            "severity": "error",

            "identity_registration": {
                "function": "pub fn register_identity()",
                "purpose": "Register crate with L0 identity system at runtime",
                "calls": "bereshit_l0_identity::register(key, pragma, metadata)",
                "severity": "info",
                "note": "Only checked for crate roots that already have PRAGMA static"
            }
        }
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Rust validation is done by rust.ts handler (10 checks).

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",
    "_Cv_verify": "deno run --allow-read mod.ts lint rust <file>",
    "_Cv_expected_state": "All block boundaries present in correct order (METADATA < SETUP < BODY < CLOSING) with //omni:key directive and END markers.",

    "validation_contract": {

        "checks_summary": {
            "total": 10,
            "version": "a-01.00",
            "checks": [
                "1. checkDirectives — //omni:key (required for crate root), //omni:code + //omni:version (recommended)",
                "2. checkBlockStructure — 4 blocks present, correct order, END markers",
                "3. checkDocComments — //! crate-level docs for lib.rs/main.rs, module-level for others",
                "4. checkPragmaMetadata — PRAGMA/METADATA statics (slice, BTreeMap, or OWN_ patterns)",
                "5. checkCommentMetadata — Key:, Purpose:, Biblical:, Version: in METADATA comments",
                "6. checkSeparatorConsistency — = widths (standard: 76), ─ widths (standard: 64), - widths",
                "7. checkTemplateVsDerived — template has placeholders, derived has no template directive",
                "8. checkSetupSubsectionOrder — Imports → Error Types → Core Types",
                "9. checkIdentityRegistration — register_identity() for crates with PRAGMA",
                "10. checkDirectiveFormat — //omni:code matches known patterns"
            ]
        },

        "directives": {
            "required_directives": ["//omni:key"],
            "recommended_directives": ["//omni:code", "//omni:version"],
            "template_directive": "#!omni meta.key or // Key: comment",
            "module_files": "Directives optional — identity delegated to lib.rs"
        },

        "blocks": {
            "required_markers": ["METADATA", "SETUP", "BODY", "CLOSING"],
            "end_markers": ["END METADATA", "END SETUP", "END BODY", "END CLOSING"],
            "order": "METADATA < SETUP < BODY < CLOSING",
            "block_severity": "error for crate root, warn for templates",
            "end_severity": "warn",
            "module_files": "Block markers optional if file has no //omni: directives"
        },

        "separators": {
            "block_width": 76,
            "block_char": "=",
            "subsection_width": 64,
            "subsection_char_unicode": "─",
            "subsection_char_ascii": "-",
            "consistency_severity": "warn",
            "standard_severity": "info",
            "note": "Rust prefers Unicode box-drawing (─) for subsections but ASCII dash (-) is accepted"
        },

        "identity": {
            "patterns": [
                "pub static PRAGMA: &[(&str, &str)]",
                "static PRAGMA: LazyLock<BTreeMap<...>>",
                "static OWN_PRAGMA: ... (identity crate)",
                "pub mod identity; (delegated)"
            ],
            "severity": "warn for crate root, not checked for modules",
            "registration": "register_identity() — info severity"
        },

        "template_rules": {
            "placeholder_format": "[bracketed] values",
            "has_placeholders_severity": "info (if no placeholders found in template)",
            "derived_with_template_severity": "warn"
        },

        "transformer": {
            "capabilities": [
                "Fix block separator widths (= → 76 chars)",
                "Fix Unicode subsection separator widths (─ → 64 chars)"
            ],
            "limitations": [
                "Does NOT inject missing block boundaries",
                "Does NOT add missing //omni: directives",
                "Does NOT fix ASCII dash (-) separators (only Unicode ─)",
                "Does NOT reorder subsections"
            ],
            "usage": "deno run --allow-read --allow-write mod.ts transform rust <file>"
        }
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Let all things be done decently and in order. — 1 Corinthians 14:40",
    "_X1_never": [
        "Remove block boundary requirements (METADATA, SETUP, BODY, CLOSING)",
        "Change the // comment convention for structural markers",
        "Break the Rust schema ↔ rust.ts linter parallel without updating both"
    ],
    "_X1_careful": [
        "Adding new required //omni: directives (cascades to all Rust files)",
        "Changing SETUP subsection order (Imports → Error Types → Core Types)",
        "Modifying separator width standards (76= / 64─)"
    ],
    "_X1_safe": [
        "Adding new identity static patterns to the recognized list",
        "Adding descriptions to structural element definitions",
        "Adding new //omni:code directive patterns to known list"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "BODY subsection ordering (once Rust packages mature enough to have consistent patterns)",
        "Cross-crate identity validation (lib.rs PRAGMA key matches Cargo.toml name)",
        "Health scoring based on check completeness",
        "Unsafe block detection and documentation requirements"
    ],

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/L1-omnicode/ladder/schemas/base-3block-schema.jsonc — Base concepts (shared $defs)",
        "b-word/L1-omnicode/ladder/schemas/go-4block-schema.jsonc — Go 4-block sibling",
        "b-word/L1-omnicode/ladder/schemas/makefile-4block-schema.jsonc — Makefile 4-block sibling",
        "b-word/seed/code/L0/rust/ — Rust seed templates",
        "c-tov/cws-struct/lib/formats/rust.ts — Runtime linter (implements these rules)"
    ],

    // X.5 NOTE
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Rust is the language of the BODY layer — compiled, persistent, foundational. The compiler already enforces correctness; the 4-block schema extends that to file-level organization. Two identity patterns (slice and BTreeMap) reflect Rust's zero-cost abstraction philosophy — choose the pattern that fits the crate's needs. The structure lives in comments because Rust code handles the rest. The compiler is one witness. The linter is another. At the mouth of two witnesses shall the matter be established.",
    "_X5_scripture": "Deuteronomy 19:15 — At the mouth of two witnesses shall the matter be established.",
    "_X5_anchor": "Compiler witnesses logic. Linter witnesses structure. Both serve Genesis 1.",

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
