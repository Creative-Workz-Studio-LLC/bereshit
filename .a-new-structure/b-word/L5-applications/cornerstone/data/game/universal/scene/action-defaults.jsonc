{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-universal-scene-action-defaults",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-actions",
    "_P2_role": "rung",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes action definitions to combat system",
    "_P3_layer": "cornerstone/data/game/universal/scene",
    "_P3_includes": "none",
    "_P3_provides": ["ACTION_DEFAULTS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Combat Action Defaults Template",
    "_P5_brief": "Template for defining combat actions — attacks, skills, abilities used in battle. Scene-scoped, loaded with combat scene.",
    "_P5_usage": "cp action-defaults.jsonc [game]/data/actions/basic-attack.jsonc -> update pragma -> fill action data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "action-defaults.jsonc",
        "key": "B-cornerstone-data-game-universal-scene-action-defaults",
        "title": "Combat Action Defaults Template",
        "type": "Data (Template)",
        "component": "Baton — passes action definitions to combat system",
        "role": "Define combat action structure — attacks, skills, abilities for battle"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2025-12-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "To every thing there is a season, and a time to every purpose."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "Actions have purpose — timing and choice define outcomes. The right action at the right time is wisdom.",
        "anchor": "James 1:22 — Be ye doers of the word, and not hearers only."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/combat.c — action_execute()",
        "integration": "Loaded during combat initialization. Combat system looks up action by action_id. Effects applied during turn resolution.",
        "if_missing": "Combat system uses basic attack fallback",
        "related_data": {
            "references": {
                "stats-defaults": "effects.damage_scaling references attribute keys (str, mag, etc.)",
                "game-types": "effects.damage_type, effects.element, targeting.target_type reference game-types enums"
            },
            "referenced_by": {
                "entity-defaults": "available_actions lists action_ids",
                "scene-defaults": "combat scenes declare which action sets to load"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/universal/scene/action-defaults.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    "_M7_classification": {
        "tags": "action, combat, skill, ability, attack, scene-state, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define combat action structure — attacks, skills, abilities for battle",
        "core_design": "Data-driven actions — behavior in data, execution in engine",
        "philosophy": "Actions are the verbs of combat — what characters DO in battle",
        "key_features": {
            "classification": "Action type: attack, skill, ability, item_use",
            "costs": "Resource costs: MP, HP, action points, cooldowns",
            "effects": "Damage, healing, buffs, debuffs, status effects",
            "targeting": "Target rules: self, single, area, all"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2025-12-03) — Initial template creation",
            "a-02.00 (2026-02-09) — Aligned to flat _P1/_M1 convention, reorganized to scene/, added M10 game state"
        ],
        "current": "Combat action template — scene lifetime, flat convention, M10 game state tracking, usable example (Basic Attack)",
        "planned": [
            "Combo action chains",
            "Conditional effects (based on target state)",
            "Animation/visual effect references"
        ]
    },

    // Where this data lives in the stack-based scene system
    "_M10_game_state": {
        "lifetime": "scene",
        "description": "Scene-scoped — pushed with combat scene, popped when battle ends.",
        "loaded_at": "Combat scene push — actions loaded during combat initialization",
        "persists": "Duration of combat scene on the stack",
        "consumed_by": "Combat system — action_execute() during turn resolution",
        "load_priority": 3,
        "cache_policy": "scene-bound — loaded on scene push, evicted on scene pop",
        "authority_rank": "engine-default < universal < class-specific < character-learned",
        "id_format": "action_id: ACT-NNN-TAG (e.g., ACT-001-BASIC_ATK, ACT-002-FIREBALL, ACT-003-HEAL). ref_name for human-readable."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 (game state) tracks stack-based scene system lifetime.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // Data file in JSONC format — structure from data.json, comments from JSONC conventions.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Categories: identity, costs, effects, targeting, requirements.
    // String IDs for cross-referencing. Numeric values for costs and effects.
    // Missing keys tripwire to engine defaults with warning.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every action must have identity, costs, effects, and targeting sections",
    "_Cc_id_format": "action_id: TYPE-NNN-TAG format. TYPE=ACT (3-letter prefix), NNN=sequence (001+), TAG=descriptive uppercase with underscores (BASIC_ATK, FIREBALL, HEAL). ref_name carries the human-readable snake_case form.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: a basic physical attack action.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Basic Attack",
    "version": "a-01.00",

    // Identity — what this action is
    "identity": {
        "action_id": "ACT-001-BASIC_ATK",
        "ref_name": "basic_attack",
        "name": "Attack",
        "type": "attack",
        "description": "A standard physical attack against a single target.",
        "icon": "iconswordswing"
    },

    // Costs — what it takes to use
    "costs": {
        "mp_cost": 0,
        "hp_cost": 0,
        "action_points": 1,
        "cooldown": 0,
        "uses_per_battle": -1
    },

    // Effects — what it does
    "effects": {
        "damage_type": "physical",
        "element": null,
        "damage_base": 10,
        "damage_scaling": "str",
        "scaling_factor": 100,
        "healing": 0,
        "status_apply": [],
        "status_chance": 100,
        "buff_stats": {},
        "buff_duration": 0
    },

    // Targeting — who it affects
    "targeting": {
        "target_type": "single",
        "target_side": "enemy",
        "range": 1,
        "area_size": 0,
        "can_target_self": false
    },

    // Requirements — what's needed to use
    "requirements": {
        "level": 1,
        "class": [],
        "weapon_type": [],
        "status_required": [],
        "status_forbidden": []
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/cornerstone --validate-actions"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "identity", "costs", "effects", "targeting"],
        "optional": ["requirements"],
        "identity_required": ["action_id", "ref_name", "name", "type", "description"],
        "costs_required": ["mp_cost", "action_points"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust damage/cost values (balance tuning)",
            "Add comments explaining action purpose",
            "Add new effects within existing structure"
        ],
        "careful": [
            "Change action_id (breaks references from stats)",
            "Add new effect types (engine must support them)",
            "Change targeting rules (affects NPC decision behavior)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (identity, costs, effects, targeting)",
            "Change value types without updating engine"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (identity, costs, effects, targeting)",
        "Change value types without updating engine"
    ],
    "_X1_careful": [
        "Change action_id (breaks references from stats)",
        "Add new effect types (engine must support)",
        "Change targeting rules (affects NPC decision behavior)"
    ],
    "_X1_safe": [
        "Adjust damage/cost values (balance tuning)",
        "Add new effects within existing structure",
        "Add comments explaining purpose"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Combo action chains",
        "Conditional effects (based on target state)",
        "Animation/visual effect references"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "action_not_found": "Check action_id matches reference in stats. Verify file path. Confirm JSONC parser strips comments.",
        "effect_not_applying": "Check effects object structure. Verify damage_type is valid (physical, magical, true).",
        "cost_not_deducting": "Ensure costs object exists with mp_cost, action_points. Verify values are non-negative integers.",
        "invalid_target": "Verify targeting.target_type is valid (self, single, area, all)."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/base/generic-data.json — Parent data template",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "identity", "costs", "effects", "targeting"],
    "_X4_validate": "make && ./bin/cornerstone --validate-actions",
    "_X4_usage_c": "action_load(\"[game]/data/actions/basic-attack.jsonc\"); action_execute(&action, &user, &target);",

    // Actions have purpose — timing and choice define outcomes.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Combat action template. Scene-scoped — pushed with combat scene, popped when battle ends. Actions are the verbs of combat.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose. — Ecclesiastes 3:1",
    "_X5_anchor": "The right action at the right time — that is wisdom.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp action-defaults.jsonc [game]/data/actions/fire-bolt.jsonc -> update pragma -> fill action data",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: identity, costs, effects, targeting for your action",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
