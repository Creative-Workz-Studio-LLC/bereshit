{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-universal-global-stats-defaults",
    "_P1_from": "b-word/seed/data/json/3block/data.json",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-stats",
    "_P2_role": "rung",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Rails — engine-level fallback for stats system",
    "_P3_layer": "cornerstone/data/game/universal/global",
    "_P3_includes": "none",
    "_P3_provides": ["STATS_ENGINE_DEFAULTS"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "Engine Stats Fallback Defaults",
    "_P5_brief": "Engine-level tripwire stats — minimum viable values when game-specific stats fail to load. Global state, always loaded.",
    "_P5_usage": "cp stats-defaults.jsonc [game]/data/stats/engine-defaults.jsonc -> update pragma -> fill values",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "stats-defaults.jsonc",
        "key": "B-cornerstone-data-game-universal-global-stats-defaults",
        "title": "Engine Stats Fallback Defaults",
        "type": "Data (Template)",
        "component": "Rails — engine-level tripwire for stats system",
        "role": "Minimum viable stats when game-specific stats fail to load"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2025-12-03",
        "updated": "2026-02-09"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // M.4 GROUNDING
    // "The race is not to the swift, nor the battle to the strong."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 9:11 — The race is not to the swift, nor the battle to the strong.",
        "principle": "Stats quantify ability, but wisdom determines outcome. The fallback ensures no entity faces battle with nothing.",
        "anchor": "Proverbs 24:27 — Prepare thy work without, and make it fit for thyself in the field."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/stats.c — stats_load_defaults()",
        "integration": "Tripwire fallback: engine tries game stats → LOUD warning on failure → falls back here",
        "if_missing": "Engine cannot initialize entities — fatal at startup",
        "related_data": {
            "references": "none — stats is the foundation, references no other game data",
            "referenced_by": {
                "action-defaults": "effects.damage_scaling uses attribute keys (str, mag, etc.)",
                "item-defaults": "equipment.stat_bonuses uses attribute keys, equipment.element uses resistance keys",
                "entity-defaults": "stat_base references resource/attribute/combat/resistance categories",
                "game-types": "element and status names must match resistance keys"
            }
        }
    },

    // M.6 LOCATION
    "_M6_location": {
        "path": "cornerstone/data/game/universal/global/stats-defaults.jsonc",
        "derives_from": "b-word/seed/data/json/3block/data.json"
    },

    // M.7 CLASSIFICATION
    "_M7_classification": {
        "tags": "stats, defaults, engine, fallback, tripwire, global-state, jsonc"
    },

    // M.8 INTENT
    "_M8_intent": {
        "purpose": "Engine-level fallback stats — minimum viable values for game to run",
        "core_design": "Tripwire pattern — try game stats, LOUD warning, fallback here",
        "philosophy": "Game keeps running — even if player/enemy stats fail, engine has a floor",
        "key_features": {
            "categories": "Core only: resources, attributes, combat, battle, resistance",
            "tripwire": "If this loads, something went wrong upstream — LOUD warning emitted",
            "no_utility": "Utility stats are game-specific (player/enemy), not engine-level"
        }
    },

    // M.9 ROADMAP
    "_M9_roadmap": {
        "history": [
            "a-01.00 (2025-12-03) — Initial template creation",
            "a-02.00 (2026-02-09) — Aligned to flat _P1/_M1 convention, reorganized to global/, added M10 game state"
        ],
        "current": "Game stats template — global lifetime, flat convention, M10 game state tracking, usable example (Engine Stats Fallback)",
        "planned": [
            "Diagnostic logging for when tripwire is hit",
            "Stats validation at engine startup"
        ]
    },

    // M.10 GAME STATE
    // Where this data lives in the stack-based scene system
    "_M10_game_state": {
        "lifetime": "global",
        "description": "Always loaded — below the scene stack. Every scene references entity stats.",
        "loaded_at": "Engine initialization — first data loaded after game-types",
        "persists": "Entire application lifecycle — never evicted from memory",
        "consumed_by": "Entity system — stats_load_defaults(), stats_apply_modifiers()",
        "load_priority": 1,
        "cache_policy": "permanent — always in memory, never evicted",
        "authority_rank": "engine-default < universal < game-specific < character-override",
        "id_format": "Singleton defaults file — no individual ID. Game-specific stat sets use STS-NNN-TAG (e.g., STS-001-HERO_BASE, STS-002-GOBLIN)."
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 (game state) tracks stack-based scene system lifetime.",
        "rule": "M1-M5 are the base contract. M6+ extends for domain-specific metadata."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // 3-Block Content: Configuration (Cc) → Operations (Co) → Verification (Cv)
    // Data file in JSONC format — structure from data.json, comments from JSONC conventions.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // JSONC format — JSON with comments for inline documentation.
    // Four CORE categories: resources, attributes, combat, resistance.
    // All stat values are integers.
    // NO utility category — that's game-specific (player/enemy).

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "All stat values must be integers. Core categories only.",
    "_Cc_id_format": "No item-level ID — this is a singleton defaults file. Override files use TYPE-NNN-TAG format: TYPE=STS, NNN=sequence, TAG=descriptor (STS-001-HERO_BASE, STS-002-GOBLIN).",
    "_Cc_tripwire": "Engine tries game stats first → LOUD warning on failure → falls back to these values",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Engine fallback values — minimum viable stats for game to run.
    // Core categories only. Game-specific stats go in player/enemy templates.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Engine Stats Fallback",
    "version": "a-01.00",

    // Resources (consumable/accumulating values)
    // hp/mp: Combat resources | stamina: Action systems | exp/gold: Progression
    "resources": {
        "hp_max": 100,
        "mp_max": 50,
        "stamina_max": 100,
        "exp": 0,
        "gold": 0
    },

    // Attributes (base character capabilities)
    // Core stats that define character potential
    "attributes": {
        "str": 10,
        "def": 10,
        "mag": 10,
        "spd": 10,
        "dex": 10,
        "luck": 10,
        "vit": 10,
        "wis": 10
    },

    // Combat (derived battle stats)
    // Typically calculated from attributes but can be overridden
    "combat": {
        "level": 1,
        "damage_min": 5,
        "damage_max": 10,
        "accuracy": 90,
        "evasion": 5,
        "crit_rate": 5,
        "crit_damage": 150
    },

    // Battle (combat system integration — minimal fallback)
    // Minimum fields for battle system to function
    "battle": {
        "action_points": 1,
        "turn_priority": 0,
        "status_slots": 1,
        "actions": []
    },

    // Resistance (elemental/status defenses)
    // 0 = neutral, positive = resist, negative = weakness
    "resistance": {
        "fire": 0,
        "ice": 0,
        "thunder": 0,
        "light": 0,
        "dark": 0,
        "poison": 0
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/cornerstone --validate-stats"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "resources", "attributes", "combat", "battle", "resistance"],
        "optional": [],
        "constraint": "All values must be integers. No utility category at engine level."
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust fallback values (should rarely change)",
            "Add comments explaining purpose"
        ],
        "careful": [
            "Change stat key names (engine must match)",
            "Change values dramatically (affects all tripwire cases)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required categories (resources, attributes, combat, resistance)",
            "Add utility category (game-specific, not engine-level)",
            "Change value types (must be integers)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required categories (resources, attributes, combat, resistance)",
        "Add utility category (game-specific)",
        "Change value types (must be integers)"
    ],
    "_X1_careful": [
        "Change stat key names (engine must match)",
        "Change values dramatically (affects all tripwire cases)"
    ],
    "_X1_safe": [
        "Adjust fallback values",
        "Add comments explaining purpose"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_note": "This file is ENGINE FALLBACK — don't extend it. Extensions go in game-specific stats files.",
    "_X2_planned": [
        "Diagnostic logging for when tripwire is hit",
        "Stats validation at engine startup"
    ],

    // X.3 TROUBLESHOOTING
    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "tripwire_hit": "Working as designed — LOUD warning, game continues. Fix game stats file, not this fallback.",
        "stats_not_loading": "Verify file exists, check JSONC parser is working. Engine needs at least this fallback.",
        "wrong_values": "Check all values are positive integers. Verify key names match engine expectations."
    },

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/base/generic-data.json — Parent data template",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema"
    ],
    "_X4_required": ["name", "version", "resources", "attributes", "combat", "battle", "resistance"],
    "_X4_validate": "make && ./bin/cornerstone --validate-stats",
    "_X4_usage_c": "stats_load_defaults(\"cornerstone/data/stats/defaults.jsonc\");",

    // X.5 NOTE
    // The fallback exists so the game keeps running. Not ideal, but better than crashing.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Engine stats fallback. Global state — always loaded, below the scene stack. If this loads instead of game stats, something went wrong upstream. The game keeps running.",
    "_X5_scripture": "The race is not to the swift, nor the battle to the strong. — Ecclesiastes 9:11",
    "_X5_anchor": "Stats quantify ability. Wisdom determines outcome.",

    // X.6 TEMPLATE
    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp stats-defaults.jsonc [game]/data/stats/engine-defaults.jsonc -> update pragma -> adjust values",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: adjust stat values for your engine",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
