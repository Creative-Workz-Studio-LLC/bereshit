{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_lvl": "LEVEL — affinity relationship level with thresholds",
        "_eff": "EFFECT — gameplay modifiers per level"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-shared-affinity",
    "_P1_from": "cornerstone/templates/data/config/settings.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-affinity-rpg",
    "_P2_role": "rails",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Rails — guides relationship dynamics and social interactions",
    "_P3_layer": "cornerstone/data/game/rpg/shared",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_AFFINITY_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Affinity System Template",
    "_P5_brief": "Relationship system — trust levels, faction standings, NPC bonds. Iron sharpeneth iron. The people we journey with shape the heroes we become. Affinity tracks bonds, karma tracks alignment.",
    "_P5_usage": "cp affinity.jsonc [game]/data/affinity/affinity_defaults.jsonc -> update pragma -> fill level data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "affinity.jsonc",
        "key": "B-cornerstone-data-game-rpg-shared-affinity",
        "title": "RPG Affinity System Template",
        "type": "Data (Template)",
        "component": "Rails — guides relationship dynamics and social interactions",
        "role": "Define relationship levels — trust tiers, faction standings, NPC bond effects"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-09",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend."
    "_M4_grounding": {
        "scripture": "Proverbs 27:17 — Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.",
        "principle": "Relationships shape who we become — affinity tracks bonds that transform. Trust is earned through action. Betrayal has lasting consequences.",
        "anchor": "Ecclesiastes 4:9-10 — Two are better than one; because they have a good reward for their labour. For if they fall, the one will lift up his fellow."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor), affinity.c loader",
        "consumers": "engine/systems/src/affinity.c — affinity_load(), affinity_get_level(), affinity_modify()",
        "integration": "Loaded at game start, updated on relationship-affecting actions. Level checked for dialogue options and quest availability. Faction standings affect world reactions.",
        "if_missing": "Tripwire to neutral-only affinity with LOUD warning — all effects neutral",
        "related_data": {
            "derives_from": {
                "settings": "Universal config template — base structure"
            },
            "references": {
                "npcs": "NPC definitions reference affinity levels for dialogue unlocks",
                "dialogue": "Dialogue branches unlock at affinity thresholds"
            },
            "referenced_by": {
                "npcs": "NPC interactions check affinity level for available options",
                "dialogue": "Dialogue system checks affinity for conversation branches",
                "story-encounter": "Story encounters may require minimum affinity levels"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/shared/affinity.jsonc",
        "derives_from": "cornerstone/templates/data/config/settings.jsonc"
    },

    "_M7_classification": {
        "tags": "affinity, relationship, faction, trust, reputation, npc, bonds, rpg, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define relationship system — trust levels, faction standings, social dynamics",
        "core_design": "Data-driven affinity — engine reads, game defines relationship rules. Affinity is tracked per-NPC and per-faction.",
        "philosophy": "Iron sharpeneth iron — relationships shape growth and unlock paths. The people we journey with shape the heroes we become.",
        "key_features": {
            "levels": "Named trust tiers (hostile, wary, neutral, friendly, bonded)",
            "thresholds": "Affinity value ranges for each level",
            "effects": "Dialogue unlocks, quest availability, combat assistance",
            "factions": "Group-level relationship tracking"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-09) — Initial affinity template creation (old comment-based format)",
            "a-02.00 (2026-02-09) — Flat convention, shared lifetime, cross-reference updates"
        ],
        "current": "RPG affinity template — levels, thresholds, effects",
        "planned": [
            "Affinity decay over time without interaction",
            "Faction reputation inheritance",
            "Relationship events and milestones",
            "NPC memory of past interactions"
        ]
    },

    "_M10_game_state": {
        "lifetime": "shared",
        "description": "Shared — affinity level definitions loaded at game start, affinity VALUES persist across scenes. Levels are reference data; current affinity is per-NPC/faction mutable state.",
        "loaded_at": "Game initialization — level definitions cached, NPC affinities start at 'start' value",
        "persists": "Across scenes — affinity changes carry between scenes (helped an NPC in town, they remember in dungeon)",
        "consumed_by": "Affinity system — affinity_get_level() reads current value against level thresholds. Dialogue system checks for conversation unlocks. Quest system checks for availability.",
        "load_priority": 2,
        "cache_policy": "session-bound — level definitions loaded once, affinity VALUES updated per-interaction",
        "authority_rank": "engine-default (neutral only) < rpg-default (this) < game-specific override"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 tracks shared lifetime — affinity persists across scenes. Level DEFINITIONS are reference data; affinity VALUES are mutable per-NPC/faction.",
        "derivation": "_P1_from points to universal settings template. RPG adds affinity levels with dialogue/quest effects. Affinity tracks BONDS (relationships), karma tracks ALIGNMENT (morality)."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG affinity system template — relationship levels with gameplay effects.
    // Shared data — level definitions loaded once, affinity values cross scenes.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Affinity = range + defaults + levels (with effects and unlocks).

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every affinity file must have name, version, affinity_min, affinity_max, start, levels. Defaults are expected.",
    "_Cc_derivation": "Tripwire chain: rpg/affinity -> engine neutral-only fallback",
    "_Cc_shared_role": "Affinity is SHARED data — level definitions loaded once, affinity VALUES persist across scenes. Changes from NPC interactions carry forward.",
    "_Cc_distinction": "Affinity tracks BONDS (who you know). Karma tracks ALIGNMENT (what you choose). Both are shared, both persist across scenes.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: 5-level affinity system (hostile -> wary -> neutral -> friendly -> bonded).

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "[Affinity System Name]",
    "version": "a-01.00",

    // Range — _req: affinity value boundaries
    "affinity_min": -100,
    "affinity_max": 100,
    "start": 0,

    // Defaults — _req: fallback behavior
    "defaults": {
        "decay_rate": 1,
        "action_weight": 5,
        "gift_weight": 10
    },

    // Levels — _lvl: relationship tiers with thresholds and effects
    "levels": [
        {
            "level_id": "AFF-001-HOSTILE",
            "name": "Hostile",
            "min": -100,
            "max": -61,
            "effects": {
                "shop_price_modifier": 2.0,
                "dialogue_options": "hostile_only",
                "combat_assistance": false,
                "quest_available": false
            },
            "unlocks": ["hostile_dialogue", "betrayal_quests"]
        },
        {
            "level_id": "AFF-002-WARY",
            "name": "Wary",
            "min": -60,
            "max": -21,
            "effects": {
                "shop_price_modifier": 1.5,
                "dialogue_options": "limited",
                "combat_assistance": false,
                "quest_available": false
            },
            "unlocks": ["wary_dialogue"]
        },
        {
            "level_id": "AFF-003-NEUTRAL",
            "name": "Neutral",
            "min": -20,
            "max": 20,
            "effects": {
                "shop_price_modifier": 1.0,
                "dialogue_options": "standard",
                "combat_assistance": false,
                "quest_available": true
            },
            "unlocks": ["standard_dialogue", "basic_quests"]
        },
        {
            "level_id": "AFF-004-FRIENDLY",
            "name": "Friendly",
            "min": 21,
            "max": 60,
            "effects": {
                "shop_price_modifier": 0.8,
                "dialogue_options": "expanded",
                "combat_assistance": true,
                "quest_available": true
            },
            "unlocks": ["friendly_dialogue", "advanced_quests", "party_recruitment"]
        },
        {
            "level_id": "AFF-005-BONDED",
            "name": "Bonded",
            "min": 61,
            "max": 100,
            "effects": {
                "shop_price_modifier": 0.5,
                "dialogue_options": "full",
                "combat_assistance": true,
                "quest_available": true
            },
            "unlocks": ["bonded_dialogue", "loyalty_quests", "unique_abilities", "shared_skills"]
        }
    ],

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "make test-affinity",
            "./bin/cornerstone --validate-affinity"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "affinity_min", "affinity_max", "start", "levels"],
        "optional": ["defaults"],
        "level_required": ["level_id", "name", "min", "max", "effects"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust level thresholds for balance",
            "Update effect values",
            "Add new unlocks to levels"
        ],
        "careful": [
            "Change level_id (breaks references)",
            "Change affinity_min/max (affects all calculations)",
            "Remove levels (may break level lookups)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required schema fields",
            "Leave gaps in level ranges"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend. — Proverbs 27:17",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required schema fields",
        "Leave gaps in level ranges (every affinity value must map to a level)"
    ],
    "_X1_careful": [
        "Change level_id (breaks NPC dialogue references)",
        "Change affinity range (affects all calculations)",
        "Remove levels (may break lookups)"
    ],
    "_X1_safe": [
        "Adjust level thresholds for balance",
        "Update effect values",
        "Add new unlocks to levels"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Affinity decay over time without interaction",
        "Faction reputation inheritance (allied faction members start friendly)",
        "Relationship events and milestones (first gift, betrayal, etc.)",
        "NPC memory of specific past interactions",
        "Affinity-based combat bonuses (bonded allies fight better together)"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "affinity_not_loading": "Verify level_id unique. Check min/max coverage (no gaps). Confirm required fields present.",
        "wrong_level": "Check affinity value in range. Verify no gaps between levels. Check level order.",
        "effects_not_applying": "Verify effect keys match game systems. Check value types.",
        "dialogue_not_unlocking": "Check affinity level against unlock requirements. Verify NPC references correct level_id.",
        "tripwire_to_neutral": "Affinity file missing or malformed. Check logs for LOUD warning."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/rpg/shared/karma.jsonc — Karma tracks alignment, affinity tracks relationships",
        "cornerstone/data/game/rpg/shared/npcs.jsonc — NPC definitions with affinity-gated interactions",
        "cornerstone/data/game/rpg/scene/frames/dialogue.jsonc — Dialogue branches unlock at affinity levels",
        "cornerstone/data/game/rpg/scene/frames/story-encounter.jsonc — Story encounters may require minimum affinity"
    ],
    "_X4_distinction": "Affinity tracks BONDS (who you know, how they feel). Karma tracks ALIGNMENT (what you choose, who you become).",
    "_X4_required": ["name", "version", "affinity_min", "affinity_max", "start", "levels"],
    "_X4_validate": "make && make test-affinity",
    "_X4_usage_c": "affinity_load(\"rpg/data/affinity/defaults.jsonc\"); affinity_get_level(&npc);",
    "_X4_id_ranges": "AFF-001 through AFF-005 (Hostile to Bonded)",

    // The people we journey with shape the heroes we become.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG affinity system — relationships shape who we become. Trust is earned through action, betrayal has lasting consequences. The people we journey with shape the heroes we become.",
    "_X5_scripture": "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend. — Proverbs 27:17",
    "_X5_anchor": "Two are better than one; for if they fall, the one will lift up his fellow. — Ecclesiastes 4:9-10",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp affinity.jsonc [game]/data/affinity/defaults.jsonc -> update pragma -> fill level data",
    "_X6_update": [
        "_P1_key: unique identifier for this affinity config",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: affinity_min/max, start, defaults, levels (AFF-NNN-TAG IDs)",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
