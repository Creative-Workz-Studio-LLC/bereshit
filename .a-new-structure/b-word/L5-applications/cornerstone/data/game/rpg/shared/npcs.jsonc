{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_opt": "OPTIONAL — engine provides fallback if missing",
        "_ref": "REFERENCE — points to another data file (dialogue, items, etc.)"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-shared-npcs",
    "_P1_from": "cornerstone/templates/data/game/items/defaults.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-npc-rpg",
    "_P2_role": "baton",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes NPC data to dialogue, shop, quest, and world systems",
    "_P3_layer": "cornerstone/data/game/rpg/shared",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_NPC_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG NPC Defaults Template",
    "_P5_brief": "Non-player character definitions — merchants, quest givers, allies. NPCs are the world's voice — who characters MEET and KNOW. Relationships forge who we become.",
    "_P5_usage": "cp npcs.jsonc [game]/data/npcs/blacksmith.jsonc -> update pragma -> fill NPC data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "npcs.jsonc",
        "key": "B-cornerstone-data-game-rpg-shared-npcs",
        "title": "RPG NPC Defaults Template",
        "type": "Data (Template)",
        "component": "Baton — passes NPC data to dialogue, shop, quest, and world systems",
        "role": "Define NPC structure — identity, role, dialogue references, shop config, world placement"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend."
    "_M4_grounding": {
        "scripture": "Proverbs 27:17 — Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.",
        "principle": "NPCs shape the hero — relationships forge character. The people we meet forge who we become.",
        "anchor": "Ecclesiastes 4:9-10 — Two are better than one; because they have a good reward for their labour."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/npc.c — npc_load(), npc_spawn(), npc_interact()",
        "integration": "Loaded when populating game world. Dialogue system uses dialogue references for conversations. Shop system uses shop config for merchants. NPC state persists across scenes.",
        "if_missing": "Tripwire to generic NPC with LOUD warning — creates placeholder with no dialogue or shop",
        "related_data": {
            "derives_from": {
                "items-defaults": "Item defaults template — similar structure for entity definitions"
            },
            "references": {
                "dialogue": "Dialogue IDs reference conversation trees in dialogue system",
                "affinity": "Affinity levels gate available interactions",
                "karma": "Some NPCs react differently based on karma tier"
            },
            "referenced_by": {
                "dialogue": "Dialogue system resolves NPC dialogue_id references",
                "affinity": "Affinity system tracks per-NPC relationship values",
                "story-encounter": "Story encounters may spawn or reference NPCs"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/shared/npcs.jsonc",
        "derives_from": "cornerstone/templates/data/game/items/defaults.jsonc"
    },

    "_M7_classification": {
        "tags": "npc, character, merchant, quest, dialogue, shop, ally, rpg, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define NPC structure — merchants, quest givers, allies, neutral characters",
        "core_design": "Data-driven NPCs — behavior in data, interaction in engine. Each NPC is a complete entity definition.",
        "philosophy": "NPCs are the world's voice — who characters MEET and KNOW. Relationships shape the hero's journey.",
        "key_features": {
            "identity": "npc_id, name, title, description, portrait, sprite",
            "role": "Type classification (merchant, quest_giver, ally, neutral, story), faction, importance",
            "dialogue": "Conversation references (default, greeting, farewell, story_flags)",
            "shop": "Merchant config (inventory, buy/sell rates, restock, special items)",
            "location": "World placement (area, position, facing, wanders, schedule)"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-03) — Initial NPC template creation (old comment-based format)",
            "a-02.00 (2026-02-09) — Flat convention, shared lifetime, structured IDs"
        ],
        "current": "RPG NPC template — identity, role, dialogue, shop, location",
        "planned": [
            "NPC schedules (time-based location/availability)",
            "Relationship/affinity tracking per-NPC",
            "Dynamic dialogue based on story progress",
            "NPC combat stats for ally recruitment"
        ]
    },

    "_M10_game_state": {
        "lifetime": "shared",
        "description": "Shared — NPC definitions loaded when area populated, NPC STATE persists across scenes. NPCs remember the player between scenes.",
        "loaded_at": "Area load — NPCs spawned when player enters their area",
        "persists": "Across scenes — NPC state (shop inventory, dialogue progress, affinity) carries between scenes",
        "consumed_by": "NPC system — npc_load() reads definition, npc_spawn() places in world. Dialogue, shop, and quest systems read NPC references.",
        "load_priority": 3,
        "cache_policy": "area-bound with shared state — definition loaded per-area, state persists globally",
        "authority_rank": "engine-default (generic NPC) < rpg-default (this) < game-specific override",
        "id_format": "npc_id: NPC-NNN-TAG (e.g., NPC-001-OLRIC, NPC-002-ELDER_SAGE). name carries display string."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 tracks shared lifetime — NPCs persist across scenes. NPC DEFINITIONS are templates; NPC STATE (shop, dialogue progress, affinity) is mutable.",
        "derivation": "_P1_from points to items defaults template. RPG adds role classification, dialogue references, shop config, and world placement."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG NPC template — identity, role, dialogue, shop, location.
    // Shared data — definition loaded per-area, state persists globally.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // NPC = identity + role + dialogue + shop + location.
    // Missing keys tripwire to generic NPC fallback.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every NPC file must have name, version, identity, role, dialogue. Shop and location are expected for placed NPCs.",
    "_Cc_id_format": "npc_id: NPC-NNN-TAG. Town: NPC-001+. Quest: NPC-100+. Story: NPC-500+.",
    "_Cc_derivation": "Tripwire chain: rpg/npcs -> engine generic-npc fallback",
    "_Cc_shared_role": "NPCs are SHARED data — definitions loaded per-area, NPC STATE persists across scenes. Shop inventory, dialogue progress, and affinity carry forward.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: Olric the Blacksmith — town merchant NPC.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "[NPC Configuration Name]",
    "version": "a-01.00",

    // Identity — _req: who this NPC is
    "identity": {
        "npc_id": "NPC-001-OLRIC",
        "ref_name": "npc_olric_blacksmith",
        "name": "Olric",
        "title": "Blacksmith",
        "description": "Grizzled veteran turned blacksmith — forges weapons and armor from salvaged materials.",
        "portrait": "portrait_olric",
        "sprite": "sprite_olric"
    },

    // Role — _req: what this NPC does
    "role": {
        "type": "merchant",
        "faction": "town_guard",
        "importance": "minor",
        "can_join_party": false,
        "respawns": true
    },

    // Dialogue — _req: conversation references
    "dialogue": {
        "default": "DLG-001-OLRIC_MAIN",
        "greeting": "DLG-002-OLRIC_HELLO",
        "farewell": "DLG-003-OLRIC_BYE",
        "busy": "DLG-004-OLRIC_BUSY",
        "story_flags": {}
    },

    // Shop — _opt: merchant config (null/empty if not merchant)
    "shop": {
        "inventory": ["ITM-001-SWORD_IRON", "ITM-002-SHIELD_WOOD", "ITM-003-POTION_HP"],
        "buy_rate": 100,
        "sell_rate": 50,
        "restock_interval": 0,
        "special_items": []
    },

    // Location — _opt: world placement
    "location": {
        "area": "AREA-001-TOWN_MARKET",
        "position": { "x": 5, "y": 3 },
        "facing": "down",
        "wanders": false,
        "schedule": null
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "make test-npc",
            "./bin/cornerstone --validate-npc"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "identity", "role", "dialogue"],
        "optional": ["shop", "location"],
        "identity_required": ["npc_id", "ref_name", "name", "title", "description"],
        "role_required": ["type", "importance"],
        "dialogue_required": ["default"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust shop prices/inventory (balance tuning)",
            "Change dialogue references",
            "Add comments explaining NPC purpose",
            "Change portrait/sprite references"
        ],
        "careful": [
            "Change npc_id (breaks references from area data and save files)",
            "Add new role types (engine must support them)",
            "Change location (affects world layout)",
            "Change importance (may affect quest system)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (identity, role, dialogue)",
            "Remove npc_id (required for lookup and save references)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend. — Proverbs 27:17",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (identity, role, dialogue)",
        "Remove npc_id (required for lookup and save references)"
    ],
    "_X1_careful": [
        "Change npc_id (breaks area data and save references)",
        "Add new role types (engine must support)",
        "Change location (affects world layout)"
    ],
    "_X1_safe": [
        "Adjust shop prices/inventory",
        "Change dialogue references",
        "Add portrait/sprite references"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "NPC schedules (time-based location/availability)",
        "Relationship/affinity tracking per-NPC",
        "Dynamic dialogue based on story progress",
        "NPC combat stats for ally recruitment",
        "NPC quest chains with progress tracking"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "npc_not_found": "Check npc_id matches reference in area data. Verify file path. Confirm JSONC parser stripping comments.",
        "dialogue_not_triggering": "Check dialogue.default references valid dialogue file. Verify story_flags match game state. Ensure NPC in correct location.",
        "shop_not_working": "Ensure role.type is 'merchant'. Verify shop.inventory has valid item IDs. Check buy_rate/sell_rate values.",
        "npc_not_appearing": "Ensure location.area exists. Check position is valid for area. Verify NPC file is registered.",
        "tripwire_to_generic": "NPC file missing or malformed. Check logs for LOUD warning. Creates placeholder with no dialogue."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/rpg/shared/affinity.jsonc — Affinity levels gate NPC interactions",
        "cornerstone/data/game/rpg/shared/karma.jsonc — Some NPCs react to player karma",
        "cornerstone/data/game/rpg/scene/frames/dialogue.jsonc — Dialogue conversation trees",
        "cornerstone/data/game/rpg/scene/frames/story-encounter.jsonc — Story encounters may reference NPCs"
    ],
    "_X4_required": ["name", "version", "identity", "role", "dialogue"],
    "_X4_validate": "make && make test-npc",
    "_X4_usage_c": "npc_load(\"rpg/data/npcs/olric.jsonc\"); npc_spawn(&world, npc_id, area_id);",
    "_X4_id_ranges": "Town: NPC-001+, Quest: NPC-100+, Story: NPC-500+",
    "_X4_role_types": "merchant | quest_giver | ally | neutral | story",

    // The people we meet forge who we become.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG NPC definitions — the world's voice. NPCs are who characters MEET and KNOW. Relationships shape the hero's journey and character. The people we meet forge who we become.",
    "_X5_scripture": "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend. — Proverbs 27:17",
    "_X5_anchor": "Two are better than one; for if they fall, the one will lift up his fellow. — Ecclesiastes 4:9-10",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp npcs.jsonc [game]/data/npcs/blacksmith.jsonc -> update pragma -> fill NPC data",
    "_X6_update": [
        "_P1_key: unique identifier for this NPC",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: identity (NPC-NNN-TAG), role, dialogue (DLG-NNN-TAG refs), shop, location",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
