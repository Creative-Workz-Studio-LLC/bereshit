{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_tier": "TIER — karma alignment level with thresholds",
        "_mul": "MULTIPLIER — combat/dialogue modifiers per tier"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-shared-karma",
    "_P1_from": "cornerstone/templates/data/config/settings.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-karma-rpg",
    "_P2_role": "rails",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Rails — guides character progression and story branching via karma alignment",
    "_P3_layer": "cornerstone/data/game/rpg/shared",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_KARMA_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Karma System Template",
    "_P5_brief": "Karma alignment system — tiers, thresholds, multipliers, effects. Light and darkness are methods, not morality. The heart determines the journey. Karma tracks choices, not destiny.",
    "_P5_usage": "cp karma.jsonc [game]/data/karma/karma_defaults.jsonc -> update pragma -> fill tier data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "karma.jsonc",
        "key": "B-cornerstone-data-game-rpg-shared-karma",
        "title": "RPG Karma System Template",
        "type": "Data (Template)",
        "component": "Rails — guides character progression and story branching via karma alignment",
        "role": "Define karma tiers — alignment levels, thresholds, multipliers, class upgrade eligibility"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-09",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Keep thy heart with all diligence; for out of it are the issues of life."
    "_M4_grounding": {
        "scripture": "Proverbs 4:23 — Keep thy heart with all diligence; for out of it are the issues of life.",
        "principle": "The heart determines the journey — karma tracks choices, not destiny. Light and dark are approaches, not good and evil. Alignment emerges from accumulated decisions.",
        "anchor": "Matthew 6:21 — For where your treasure is, there will your heart be also."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor), karma.c loader",
        "consumers": "engine/systems/src/karma.c — karma_load(), karma_get_tier(), karma_check_threshold()",
        "integration": "Loaded at game start, updated on karma-affecting choices. Tier checked for class upgrades and story branches. Multipliers applied to combat and dialogue.",
        "if_missing": "Tripwire to neutral-only karma with LOUD warning — all multipliers 1.0x",
        "related_data": {
            "derives_from": {
                "settings": "Universal config template — base structure"
            },
            "references": {
                "class": "Class upgrades require specific karma tiers",
                "dialogue": "Dialogue branches unlock at karma thresholds"
            },
            "referenced_by": {
                "class": "Class upgrade paths check karma_req against player tier",
                "combat": "Combat multipliers modify damage/healing per tier",
                "dialogue": "Dialogue system checks tier for branch availability"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/shared/karma.jsonc",
        "derives_from": "cornerstone/templates/data/config/settings.jsonc"
    },

    "_M7_classification": {
        "tags": "karma, alignment, light, dark, moral, tiers, multipliers, rpg, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define karma alignment system — tiers, thresholds, multipliers, effects on gameplay",
        "core_design": "Data-driven karma — engine reads, game defines tiers and effects. Karma is tracked per-character.",
        "philosophy": "Light and darkness are methods, not morality — the heart determines the journey. Karma tracks accumulated choices.",
        "key_features": {
            "tiers": "Named alignment levels (shadow, dark, neutral, light, radiant)",
            "thresholds": "Karma value ranges defining each tier",
            "multipliers": "Combat and dialogue modifiers per tier",
            "effects": "Unlock conditions for class upgrades and story branches"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-09) — Initial karma template creation (old comment-based format)",
            "a-02.00 (2026-02-09) — Flat convention, shared lifetime, cross-reference updates"
        ],
        "current": "RPG karma template — tiers, thresholds, multipliers, effects",
        "planned": [
            "Karma decay/growth over time",
            "NPC-specific karma reactions",
            "Area-based karma modifiers",
            "Karma milestone events"
        ]
    },

    "_M10_game_state": {
        "lifetime": "shared",
        "description": "Shared — karma definitions loaded at game start, karma VALUE persists across scenes. Tiers are reference data; current karma is per-character mutable state.",
        "loaded_at": "Game initialization — tier definitions cached, character karma starts at 'start' value",
        "persists": "Across scenes — karma changes in combat/dialogue carry between scenes",
        "consumed_by": "Karma system — karma_get_tier() reads current value against tier thresholds. Class system checks for upgrade eligibility. Dialogue system checks for branch unlocks.",
        "load_priority": 1,
        "cache_policy": "session-bound — tier definitions loaded once, karma VALUE updated per-choice",
        "authority_rank": "engine-default (neutral only) < rpg-default (this) < game-specific override"
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 tracks shared lifetime — karma persists across scenes. Tier DEFINITIONS are reference data; karma VALUE is mutable per-character.",
        "derivation": "_P1_from points to universal settings template. RPG adds karma tiers with combat/dialogue multipliers."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG karma system template — alignment tiers with gameplay effects.
    // Shared data — tier definitions loaded once, karma value crosses scenes.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Karma = range + defaults + tiers (with multipliers and unlocks).

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every karma file must have name, version, karma_min, karma_max, start, tiers. Defaults are expected.",
    "_Cc_derivation": "Tripwire chain: rpg/karma -> engine neutral-only fallback",
    "_Cc_shared_role": "Karma is SHARED data — tier definitions loaded once, karma VALUE persists across scenes. Changes in combat/dialogue carry forward.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: 5-tier karma system (shadow -> dark -> neutral -> light -> radiant).

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "[Karma System Name]",
    "version": "a-01.00",

    // Range — _req: karma value boundaries
    "karma_min": -100,
    "karma_max": 100,
    "start": 0,

    // Defaults — _req: fallback behavior
    "defaults": {
        "decay_rate": 1,
        "choice_weight": 5,
        "combat_weight": 2
    },

    // Tiers — _tier: alignment levels with thresholds and effects
    "tiers": [
        {
            "tier_id": "KRM-001-SHADOW",
            "name": "Shadow",
            "min": -100,
            "max": -61,
            "multipliers": {
                "dark_damage": 1.5,
                "light_damage": 0.5,
                "intimidation": 1.5,
                "persuasion": 0.5
            },
            "unlocks": ["class_dark_upgrade", "shadow_dialogue"]
        },
        {
            "tier_id": "KRM-002-DARK",
            "name": "Dark",
            "min": -60,
            "max": -21,
            "multipliers": {
                "dark_damage": 1.25,
                "light_damage": 0.75,
                "intimidation": 1.25,
                "persuasion": 0.75
            },
            "unlocks": ["dark_dialogue"]
        },
        {
            "tier_id": "KRM-003-NEUTRAL",
            "name": "Neutral",
            "min": -20,
            "max": 20,
            "multipliers": {
                "dark_damage": 1.0,
                "light_damage": 1.0,
                "intimidation": 1.0,
                "persuasion": 1.0
            },
            "unlocks": ["class_neutral_upgrade", "neutral_dialogue"]
        },
        {
            "tier_id": "KRM-004-LIGHT",
            "name": "Light",
            "min": 21,
            "max": 60,
            "multipliers": {
                "dark_damage": 0.75,
                "light_damage": 1.25,
                "intimidation": 0.75,
                "persuasion": 1.25
            },
            "unlocks": ["light_dialogue"]
        },
        {
            "tier_id": "KRM-005-RADIANT",
            "name": "Radiant",
            "min": 61,
            "max": 100,
            "multipliers": {
                "dark_damage": 0.5,
                "light_damage": 1.5,
                "intimidation": 0.5,
                "persuasion": 1.5
            },
            "unlocks": ["class_light_upgrade", "radiant_dialogue"]
        }
    ],

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "make test-karma",
            "./bin/cornerstone --validate-karma"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "karma_min", "karma_max", "start", "tiers"],
        "optional": ["defaults"],
        "tier_required": ["tier_id", "name", "min", "max", "multipliers"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust tier thresholds for balance",
            "Update multiplier values",
            "Add new unlocks to tiers"
        ],
        "careful": [
            "Change tier_id (breaks references from class upgrades)",
            "Change karma_min/max (affects all calculations)",
            "Remove tiers (may break tier lookups)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required schema fields",
            "Leave gaps in tier ranges"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Keep thy heart with all diligence; for out of it are the issues of life. — Proverbs 4:23",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required schema fields",
        "Leave gaps in tier ranges (every karma value must map to a tier)"
    ],
    "_X1_careful": [
        "Change tier_id (breaks class upgrade references)",
        "Change karma range (affects all calculations)",
        "Remove tiers (may break lookups)"
    ],
    "_X1_safe": [
        "Adjust tier thresholds for balance",
        "Update multiplier values",
        "Add new unlocks to tiers"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Karma decay/growth over time without interaction",
        "NPC-specific karma reactions (some NPCs care more about karma)",
        "Area-based karma modifiers (sacred ground shifts karma)",
        "Karma milestone events (story beats at tier boundaries)",
        "Karma history tracking (was once light, now dark)"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "karma_not_loading": "Verify tier_id unique. Check min/max coverage (no gaps). Confirm required fields present.",
        "wrong_tier": "Check karma value in range. Verify no gaps between tiers. Check tier order.",
        "multipliers_not_applying": "Verify multiplier keys match combat system. Check values are floats.",
        "class_upgrade_blocked": "Check karma tier matches class upgrade karma_req. Verify mastery is 100%.",
        "tripwire_to_neutral": "Karma file missing or malformed. Check logs for LOUD warning. All multipliers fall to 1.0x."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/rpg/global/class.jsonc — Class upgrades reference karma tiers",
        "cornerstone/data/game/rpg/global/stats-player.jsonc — Player stats modified by karma multipliers",
        "cornerstone/data/game/rpg/shared/affinity.jsonc — Affinity tracks relationships, karma tracks alignment",
        "cornerstone/data/game/rpg/scene/frames/dialogue.jsonc — Dialogue branches unlock at karma tiers",
        "cornerstone/data/game/rpg/scene/frames/combat.jsonc — Combat multipliers per karma tier"
    ],
    "_X4_required": ["name", "version", "karma_min", "karma_max", "start", "tiers"],
    "_X4_validate": "make && make test-karma",
    "_X4_usage_c": "karma_load(\"rpg/data/karma/defaults.jsonc\"); karma_get_tier(&player);",
    "_X4_id_ranges": "KRM-001 through KRM-005 (Shadow to Radiant)",

    // Light and dark are methods, not morality.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG karma system — the heart determines the journey. Light and dark are approaches, not good and evil. Alignment emerges from accumulated decisions, not predetermined fate. What you choose shapes who you become.",
    "_X5_scripture": "Keep thy heart with all diligence; for out of it are the issues of life. — Proverbs 4:23",
    "_X5_anchor": "For where your treasure is, there will your heart be also. — Matthew 6:21",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp karma.jsonc [game]/data/karma/karma_defaults.jsonc -> update pragma -> fill tier data",
    "_X6_update": [
        "_P1_key: unique identifier for this karma config",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: karma_min/max, start, defaults, tiers (KRM-NNN-TAG IDs)",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
