{
    // #!omni template --jsonc
    "$schema": "../../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from universal scene-defaults, override allowed",
        "_rpg": "RPG-SPECIFIC — added by this derivation, not in universal",
        "_cpisi": "CPI-SI DECISION — assessment-based logic for phase transitions AND CPI-SI play"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-scene-boss",
    "_P1_from": "cornerstone/data/game/universal/scene/scene-defaults.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-boss-rpg",
    "_P2_role": "rung",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes boss encounter data to combat system with phase evolution",
    "_P3_layer": "cornerstone/data/game/rpg/scene/frames",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_BOSS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Boss Encounter Template",
    "_P5_brief": "RPG boss battles — WHO the boss is + HOW they evolve. Phase system (HP thresholds trigger behavior changes), CPI-SI phase assessment, dialogue hooks, consequences, guaranteed rewards. Extends universal scene-defaults.",
    "_P5_usage": "cp boss.jsonc [game]/data/scenes/boss-dragon-lord.jsonc -> update pragma -> fill boss data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "boss.jsonc",
        "key": "B-cornerstone-data-game-rpg-scene-boss",
        "title": "RPG Boss Encounter Template",
        "type": "Data (Template)",
        "component": "Baton — passes boss encounter data to combat system with phase evolution",
        "role": "Define RPG boss battles — unique enemy with phases, consequences, and guaranteed rewards"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2025-12-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "The battle is the LORD's."
    "_M4_grounding": {
        "scripture": "1 Samuel 17:47 — And all this assembly shall know that the LORD saveth not with sword and spear: for the battle is the LORD's, and he will give you into our hands.",
        "principle": "Boss fights test preparation — victory comes from readiness and purpose, not just power.",
        "anchor": "Ephesians 6:12 — For we wrestle not against flesh and blood, but against principalities, against powers."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/combat.c — encounter_load_boss(), phase_transition()",
        "integration": "Loaded when boss encounter triggers. Boss ID references entity-defaults for base stats. Phase thresholds monitored during combat loop. CPI-SI phase assessment determines boss behavior adaptation — not scripted rotation.",
        "if_missing": "Tripwire to universal scene-defaults with LOUD warning — creates generic combat scene without phases",
        "related_data": {
            "derives_from": {
                "scene-defaults": "Universal scene template — base structure (identity, stack_behavior)"
            },
            "references": {
                "entity-defaults": "boss.entity_id references entity for base stats",
                "actions": "phases[].abilities_unlocked reference action_ids loaded during combat",
                "combat": "boss.combat references combat configuration (mode, terrain)",
                "dialogue": "dialogue_hooks and phase dialogue reference dialogue_ids",
                "resolution": "consequences feed into resolution system on combat end"
            },
            "referenced_by": {
                "story-encounter": "Story encounters may reference boss encounter for narrative battles"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/scene/frames/boss.jsonc",
        "derives_from": "cornerstone/data/game/universal/scene/scene-defaults.jsonc"
    },

    "_M7_classification": {
        "tags": "boss, encounter, rpg, phases, unique-enemy, combat, scene-state, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define RPG boss encounters — unique enemies that evolve through phases with CPI-SI-driven adaptation",
        "core_design": "Phase-based encounters — bosses adapt behavior as battle progresses. Not scripted rotation but assessment-based evolution.",
        "philosophy": "Boss fights are memorable moments — each one is handcrafted. The boss adapts, not by script, but by assessing the battle state.",
        "key_features": {
            "inherited_from_universal": "identity, stack_behavior — base scene contract",
            "rpg_boss_identity": "Unique boss reference — entity_id, display_name, title, level",
            "rpg_phase_system": "HP thresholds trigger behavior changes, ability unlocks, dialogue",
            "rpg_phase_behavior": "CPI-SI assessment-based phase behavior — boss adapts based on state, not fixed patterns",
            "rpg_consequences": "Victory/defeat outcomes — story flags, karma, area unlocks",
            "rpg_guaranteed_rewards": "Boss drops are guaranteed — exp, gold, items, rare drops"
        },
        "cpisi_note": "Phase behavior uses CPI-SI framework: Assess current phase state (0) -> Evaluate available abilities for situation (+1) -> Verify phase transition timing (-1). Boss 'intelligence' is assessment, not scripted rotation."
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2025-12-03) — Initial template creation (old comment-based format)",
            "a-02.00 (2026-02-09) — Flat convention, CPI-SI phase behavior, stack_behavior, scene organization"
        ],
        "current": "RPG boss template — phase system, CPI-SI behavior adaptation, guaranteed rewards, scene-scoped",
        "planned": [
            "Multi-boss encounters (multiple unique enemies with independent phases)",
            "Environmental phase triggers (not just HP thresholds — turn count, ally death, etc.)",
            "Boss music/atmosphere changes per phase",
            "Phase-specific terrain modifications"
        ]
    },

    // Where this data lives in the stack-based scene system
    "_M10_game_state": {
        "lifetime": "scene",
        "description": "Scene-scoped — boss encounter IS a combat scene frame with phase evolution. Pushed when boss encounter triggers, popped when battle ends.",
        "loaded_at": "On demand — loaded when narrative/encounter system triggers boss fight",
        "persists": "Duration of boss combat scene on the stack",
        "consumed_by": "Combat system — encounter_load_boss() reads config, phase_transition() checks HP thresholds, combat_end() triggers consequences + resolution",
        "load_priority": 3,
        "cache_policy": "scene-bound — loaded on push, all boss/combat state evicted on pop",
        "authority_rank": "engine-default < universal scene < rpg combat < boss-specific (this overrides combat defaults)",
        "id_format": "boss_id: BSS-NNN-TAG (e.g., BSS-001-GOBLIN_KING, BSS-002-DRAGON_LORD, BSS-003-SHADOW_KNIGHT). ref_name for human-readable."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 (game state) tracks stack-based scene system lifetime.",
        "derivation": "_P1_from points to universal scene-defaults. Boss adds phase system, CPI-SI behavior adaptation, consequences, guaranteed rewards."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG boss encounter — extends universal scene structure.
    // Inherits: identity, stack_behavior (from scene-defaults)
    // Adds: boss, phases, phase_behavior (CPI-SI), combat, dialogue_hooks, consequences, rewards

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Boss = identity + phases + behavior + combat + consequences + rewards.
    // Key distinction:
    //   random.jsonc = WHAT pool of enemies can appear
    //   story-encounter.jsonc = WHAT specific enemies + narrative
    //   boss.jsonc (this) = WHO the boss is + HOW they evolve
    //   entity-defaults.jsonc = base stats for all enemies including bosses

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every boss must have identity, boss, phases, combat, and stack_behavior. Consequences and rewards are optional but expected.",
    "_Cc_id_format": "boss_id: BSS-NNN-TAG. Story bosses: BSS-001+. Optional/secret: BSS-500+. ref_name carries human-readable snake_case.",
    "_Cc_derivation": "Tripwire chain: rpg/boss -> rpg/combat -> universal/scene-defaults -> engine fallback",
    "_Cc_scene_role": "Boss encounter is a SCENE FRAME — it pushes a specialized combat scene. Boss data OVERRIDES generic combat config for this fight.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: Goblin King — 3-phase boss with escalating abilities.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Goblin King Battle",
    "version": "a-01.00",

    // Identity — _inh from universal scene-defaults
    "identity": {
        "boss_id": "BSS-001-GOBLIN_KING",
        "ref_name": "boss_goblin_king",
        "name": "Goblin King Encounter",
        "scene_type": "combat",
        "description": "The Goblin King — a 3-phase boss fight in his throne room. Escalating abilities and reinforcement calls."
    },

    // Boss — _rpg: the unique enemy
    // entity_id references entity-defaults for base stats (NOT full stats here)
    "boss": {
        "entity_id": "ENT-010-GOBLIN_KING",
        "display_name": "Grothak the Goblin King",
        "title": "Tyrant of the Deep Warrens",
        "level": 10
    },

    // Phases — _rpg: how the boss evolves during battle
    // HP thresholds trigger behavior changes, ability unlocks, dialogue
    "phases": [
        {
            "id": 1,
            "name": "The Throne",
            "hp_threshold": 100,
            "dialogue": "DLG-500-GROTHAK_TAUNT",
            "abilities_unlocked": ["ACT-001-BASIC_ATK", "ACT-501-CROWN_SMASH"]
        },
        {
            "id": 2,
            "name": "The Rage",
            "hp_threshold": 50,
            "dialogue": "DLG-501-GROTHAK_RAGE",
            "abilities_unlocked": ["ACT-502-WARCRY", "ACT-503-GOBLIN_CALL"]
        },
        {
            "id": 3,
            "name": "Desperation",
            "hp_threshold": 25,
            "dialogue": "DLG-502-GROTHAK_DESPERATE",
            "abilities_unlocked": ["ACT-504-FRENZY"]
        }
    ],

    // Phase Behavior — _cpisi: CPI-SI assessment-based phase adaptation
    // NOT scripted rotation. Boss assesses state and adapts per phase.
    // Serves TWO consumers: boss NPC behavior AND CPI-SI instances playing as/against boss.
    "phase_behavior": {
        // Assess (0 — foundation): What phase are we in and what's the battle state?
        "assess": {
            "phase_check": "Monitor HP against phase thresholds",
            "party_threat": "Assess which party member is most dangerous",
            "resource_state": "Check own HP, abilities available, reinforcement potential"
        },
        // Evaluate (+1 — build up): How should boss behave in current phase?
        "evaluate": {
            "phase_1_pattern": "Confident — use basic attacks, test party strength, conserve special abilities",
            "phase_2_pattern": "Aggressive — use warcry to buff self, call reinforcements, target healer",
            "phase_3_pattern": "Desperate — all-out frenzy, ignore self-preservation, maximum damage output",
            "adaptation": "Boss evaluates party composition and adjusts — focus healers if healing is strong, focus damage dealers if taking too much damage"
        },
        // Verify (-1 — break down): Phase transition safety
        "verify": {
            "phase_transition_clean": "Ensure current action completes before phase dialogue triggers",
            "reinforcement_limit": "Don't call reinforcements if too many allies already present",
            "desperation_threshold": "In phase 3, verify frenzy won't kill self before dealing meaningful damage"
        }
    },

    // Combat — _rpg: how this battle plays (overrides generic combat config)
    "combat": {
        "combat_ref": "CMB-500-THRONE_ROOM",
        "mode": "realtime",
        "terrain": "throne_room",
        "escape_allowed": false,
        "music_id": "mus_boss_goblin_king"
    },

    // Dialogue Hooks — _rpg: narrative integration
    "dialogue_hooks": {
        "pre_battle": "DLG-510-GROTHAK_ENTRANCE",
        "post_victory": "DLG-511-GROTHAK_DEFEATED",
        "post_defeat": "DLG-512-GROTHAK_TRIUMPH"
    },

    // Consequences — _rpg: what happens based on outcome
    "consequences": {
        "victory": {
            "story_flag": "goblin_king_defeated",
            "karma_change": 5,
            "unlocks": ["area_deep_mines", "chapter_2"]
        },
        "defeat": {
            "game_over": true,
            "retry_allowed": true
        }
    },

    // Rewards — _rpg: guaranteed drops from defeating this boss
    "rewards": {
        "exp": 500,
        "gold": 250,
        "items": [
            { "item_id": "ITM-050-GOBLIN_CROWN", "quantity": 1 }
        ],
        "rare_drops": [
            { "item_id": "ITM-051-KINGS_SCEPTER", "drop_rate": 10 }
        ]
    },

    // Stack Behavior — _inh from universal scene-defaults
    // Boss encounter pushes a specialized combat scene
    "stack_behavior": {
        "push_mode": "standard",
        "allows_pause": true,
        "allows_overlay": ["dialogue", "menu", "cutscene"],
        "on_push": "load boss entity (entity_id), load phase abilities, init combat (combat_ref), play pre_battle dialogue, start phase 1",
        "on_pop": "trigger consequences, trigger resolution, play post dialogue, evict boss-scoped data, return to previous scene",
        "on_pause": "preserve full combat state including current phase, HP, abilities, allow menu overlay",
        "on_resume": "restore combat state, resume from current phase"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/cornerstone --validate-boss"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "identity", "boss", "phases", "combat", "stack_behavior"],
        "rpg_required": ["phase_behavior"],
        "optional": ["dialogue_hooks", "consequences", "rewards"],
        "identity_required": ["boss_id", "ref_name", "name", "scene_type"],
        "boss_required": ["entity_id", "display_name", "level"],
        "phase_required": ["id", "name", "hp_threshold", "abilities_unlocked"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust phase HP thresholds (balance tuning)",
            "Change dialogue hooks",
            "Adjust rewards (exp, gold, items)",
            "Add/remove abilities per phase",
            "Adjust phase_behavior assessment criteria"
        ],
        "careful": [
            "Change entity_id (must match entity-defaults)",
            "Change boss_id (breaks script references)",
            "Change phase count (affects battle flow and pacing)",
            "Change combat_ref (must match valid combat config)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (identity, boss, phases, combat, stack_behavior)",
            "Use scripted rotation for phase behavior (use CPI-SI assessment)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (identity, boss, phases, combat, stack_behavior)",
        "Use scripted rotation for phase behavior (use CPI-SI assessment)"
    ],
    "_X1_careful": [
        "Change entity_id (must match entity-defaults)",
        "Change boss_id (breaks script references)",
        "Change phase count (affects battle pacing)"
    ],
    "_X1_safe": [
        "Adjust phase thresholds, rewards, dialogue hooks",
        "Add/remove abilities per phase",
        "Adjust phase_behavior assessment criteria"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Multi-boss encounters (multiple unique enemies with independent phases)",
        "Environmental phase triggers (turn count, ally death, not just HP)",
        "Boss music/atmosphere changes per phase",
        "Phase-specific terrain modifications"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "boss_not_appearing": "Verify entity_id matches entity-defaults. Check boss_id is unique. Confirm required fields present.",
        "phase_not_triggering": "Check hp_threshold values (100, 50, 25 pattern). Verify phase IDs are sequential. Confirm phases array not empty.",
        "abilities_not_working": "Check abilities_unlocked IDs exist in actions.jsonc. Verify action sets are loaded in combat data_requirements.",
        "rewards_not_dropping": "Verify item_id values exist in item data. Check drop_rate is 0-100 for rare items.",
        "tripwire_to_combat": "Boss file missing or malformed. Check logs for LOUD warning. Verify JSON syntax."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/universal/scene/scene-defaults.jsonc — Universal parent template",
        "cornerstone/data/game/rpg/scene/frames/combat.jsonc — Combat configuration for boss battles",
        "cornerstone/data/game/rpg/scene/data/actions.jsonc — Boss ability definitions",
        "cornerstone/data/game/rpg/scene/data/resolution.jsonc — Post-boss reward/consequence handling",
        "cornerstone/data/game/rpg/scene/frames/dialogue.jsonc — Boss dialogue (taunts, phase transitions)"
    ],
    "_X4_required": ["name", "version", "identity", "boss", "phases", "combat", "stack_behavior"],
    "_X4_validate": "make && ./bin/cornerstone --validate-boss",
    "_X4_usage_c": "encounter_load_boss(\"rpg/data/scenes/boss-goblin-king.jsonc\"); encounter_trigger_boss(&boss);",
    "_X4_id_ranges": "Story bosses: BSS-001+, Optional/secret: BSS-500+",

    // Boss fights test everything the player has learned.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG boss encounters — unique enemies with phase evolution. Scene-scoped frame. Phase behavior uses CPI-SI assessment — boss adapts to battle state, not scripted rotation.",
    "_X5_scripture": "The battle is the LORD's, and he will give you into our hands. — 1 Samuel 17:47",
    "_X5_anchor": "David faced Goliath not with armor, but with purpose. Victory comes from preparation.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp boss.jsonc [game]/data/scenes/boss-dragon-lord.jsonc -> update pragma -> fill boss data",
    "_X6_update": [
        "_P1_key: unique identifier for this boss",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: identity (BSS-NNN-TAG), boss, phases, phase_behavior, combat, dialogue_hooks, consequences, rewards, stack_behavior",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
