{
    // #!omni template --jsonc
    "$schema": "../../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from universal action-defaults, override allowed",
        "_rpg": "RPG-SPECIFIC — added by this derivation, not in universal",
        "_cpisi": "CPI-SI DECISION — assessment-based logic for NPC behavior AND CPI-SI play"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-scene-actions",
    "_P1_from": "cornerstone/data/game/universal/scene/action-defaults.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-actions-rpg",
    "_P2_role": "rung",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes RPG action definitions to combat system",
    "_P3_layer": "cornerstone/data/game/rpg/scene/data",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_ACTION_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Combat Actions Template",
    "_P5_brief": "RPG-specific combat actions — player skills and enemy abilities. Extends universal action-defaults with class requirements, weapon restrictions, CPI-SI decision framework, and combo chains.",
    "_P5_usage": "cp actions.jsonc [game]/data/actions/fireball.jsonc -> update pragma -> fill RPG-specific action data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "actions.jsonc",
        "key": "B-cornerstone-data-game-rpg-scene-actions",
        "title": "RPG Combat Actions Template",
        "type": "Data (Template)",
        "component": "Baton — passes RPG action definitions to combat system",
        "role": "Define RPG combat action structure — player skills, enemy abilities, class-gated attacks"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "To every thing there is a season, and a time to every purpose."
    "_M4_grounding": {
        "scripture": "Ecclesiastes 3:1 — To every thing there is a season, and a time to every purpose under the heaven.",
        "principle": "Actions have purpose — timing and choice define outcomes. The warrior's sword, the priest's prayer, the rogue's shadow — each has its season.",
        "anchor": "James 1:22 — Be ye doers of the word, and not hearers only."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/combat.c — action_execute()",
        "integration": "Loaded during combat initialization. RPG actions extend universal structure with class/weapon gating. CPI-SI decision framework used for NPC action selection AND CPI-SI instance play.",
        "if_missing": "Tripwire to universal action-defaults with LOUD warning",
        "related_data": {
            "derives_from": {
                "action-defaults": "Universal combat action template — base structure (identity, costs, effects, targeting)"
            },
            "references": {
                "stats-player": "effects.damage_scaling references player attribute keys",
                "stats-enemy": "CPI-SI decision assessment references enemy stat thresholds",
                "game-types": "effects.damage_type, effects.element, targeting.target_type reference game-types enums",
                "class": "requirements.class references class IDs for action gating"
            },
            "referenced_by": {
                "npcs": "NPC ally actions reference this template",
                "combat": "Combat scenes declare which action sets to load",
                "boss": "Boss phases reference specific action sets"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/scene/data/actions.jsonc",
        "derives_from": "cornerstone/data/game/universal/scene/action-defaults.jsonc"
    },

    "_M7_classification": {
        "tags": "action, combat, skill, ability, attack, rpg, scene-state, player, enemy, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define RPG combat actions — player skills learned through progression AND NPC/enemy abilities governed by CPI-SI decision framework",
        "core_design": "Data-driven actions — behavior in data, execution in engine. One template covers both player and enemy actions.",
        "philosophy": "Player vs enemy is a DATA distinction (who can use it), not a SCHEMA distinction. Same structure, different consumers.",
        "key_features": {
            "inherited_from_universal": "identity, costs, effects, targeting — base action contract",
            "rpg_class_gating": "requirements.class restricts actions to specific RPG classes (warrior, priest, rogue)",
            "rpg_weapon_gating": "requirements.weapon_type restricts to equipped weapon categories",
            "rpg_decision_framework": "decision section provides CPI-SI assessment logic — used by NPCs AND by CPI-SI instances playing the game",
            "rpg_combo_chains": "combo section enables action sequences (future)"
        },
        "consolidation_note": "Merged from actions-player.jsonc + actions-enemy.jsonc — identical structures, player vs enemy is data-level",
        "cpisi_note": "Decision framework is NOT weighted random selection (beastly pattern). It is assessment-based: Assess state (0) -> Evaluate options (+1) -> Choose with wisdom (-1 verify). Same logic serves NPC behavior and CPI-SI play."
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-03) — Separate player/enemy action templates (old format)",
            "a-02.00 (2026-02-09) — Consolidated into single RPG actions template, derived from universal action-defaults, flat convention"
        ],
        "current": "RPG action template — covers player skills and enemy abilities, scene-scoped, flat convention, class/weapon gating",
        "planned": [
            "Combo action chains (action_a -> action_b when conditions met)",
            "Conditional effects (damage bonus vs undead, healing bonus in daylight)",
            "Animation/visual effect references",
            "Mastery scaling (damage increases with class mastery %)"
        ]
    },

    // Where this data lives in the stack-based scene system
    "_M10_game_state": {
        "lifetime": "scene",
        "description": "Scene-scoped — pushed with combat scene, popped when battle ends. Both player and enemy actions loaded together.",
        "loaded_at": "Combat scene push — all available actions for both sides loaded during initialization",
        "persists": "Duration of combat scene on the stack",
        "consumed_by": "Combat system — player selects from available actions, NPC/CPI-SI selects via decision framework (assess -> evaluate -> choose)",
        "load_priority": 3,
        "cache_policy": "scene-bound — loaded on scene push, evicted on scene pop",
        "authority_rank": "engine-default (universal) < rpg-default (this) < class-specific < character-learned",
        "id_format": "action_id: ACT-NNN-TAG (e.g., ACT-010-FIREBALL, ACT-020-SHIELD_BASH, ACT-030-HEAL). ref_name for human-readable."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 (game state) tracks stack-based scene system lifetime.",
        "derivation": "_P1_from points to universal action-defaults. RPG adds class/weapon gating, CPI-SI decision framework, combo potential."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG combat action — extends universal action structure.
    // Inherits: identity, costs, effects, targeting (from action-defaults)
    // Adds: requirements (class/weapon gating), decision (CPI-SI assessment-based behavior)

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Inherits base categories from universal: identity, costs, effects, targeting.
    // RPG adds: requirements (class/weapon/level gating), decision (CPI-SI assessment framework).
    // Missing keys tripwire to universal action-defaults, then to engine fallback.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every action must have identity, costs, effects, targeting. RPG actions SHOULD have requirements and decision.",
    "_Cc_id_format": "action_id: ACT-NNN-TAG. Player actions: ACT-010+. NPC/enemy actions: ACT-500+. Shared actions: ACT-001-009. ref_name carries human-readable snake_case.",
    "_Cc_derivation": "Tripwire chain: rpg/actions -> universal/action-defaults -> engine hardcoded fallback",
    "_Cc_decision_note": "decision section uses CPI-SI building block method: assess(0 foundation) -> evaluate(+1 build up) -> verify(-1 break down). Same framework for NPC behavior and CPI-SI instance play.",
    "_Cc_scene_role": "Actions are NOT a scene frame — they are scene-scoped DATA loaded by the combat scene. Action sets are loaded during combat initialization and evicted when combat pops.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: RPG player skill (Fireball — class-gated, element-typed).
    // Shows RPG-specific additions over universal base.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "Fireball",
    "version": "a-01.00",

    // Identity — _inh from universal, values RPG-specific
    "identity": {
        "action_id": "ACT-010-FIREBALL",
        "ref_name": "fireball",
        "name": "Fireball",
        "type": "skill",
        "description": "Hurls a ball of fire at a single target. Scales with magic stat.",
        "icon": "icon_fire_bolt"
    },

    // Costs — _inh from universal
    "costs": {
        "mp_cost": 8,
        "hp_cost": 0,
        "action_points": 1,
        "cooldown": 0,
        "uses_per_battle": -1
    },

    // Effects — _inh from universal, RPG adds element
    "effects": {
        "damage_type": "magical",
        "element": "fire",
        "damage_base": 15,
        "damage_scaling": "mag",
        "scaling_factor": 120,
        "healing": 0,
        "status_apply": ["burn"],
        "status_chance": 25,
        "buff_stats": {},
        "buff_duration": 0
    },

    // Targeting — _inh from universal
    "targeting": {
        "target_type": "single",
        "target_side": "enemy",
        "range": 3,
        "area_size": 0,
        "can_target_self": false
    },

    // Requirements — _inh from universal, RPG fills with actual gating
    "requirements": {
        "level": 3,
        "class": ["priest", "sage"],
        "weapon_type": [],
        "status_required": [],
        "status_forbidden": ["silenced"]
    },

    // Decision — _cpisi: CPI-SI assessment-based action selection
    // Not in universal — RPG-specific addition.
    // Serves TWO consumers: NPC behavior within the game AND CPI-SI instances playing the game.
    // NOT weighted random (beastly). Assessment-based: Assess(0) -> Evaluate(+1) -> Choose(-1 verify).
    //
    // assess: What must be true for this action to be CONSIDERED? (foundation — state check)
    // evaluate: How does this action compare to alternatives? (build up — relative value)
    // verify: What should prevent choosing this even if assessment passes? (break down — safety check)
    "decision": {
        // Assess (0 — foundation): Preconditions for consideration
        "assess": {
            "self_mp_minimum": 8,
            "self_status_excludes": ["silenced"],
            "target_exists": true
        },
        // Evaluate (+1 — build up): How valuable is this action in context?
        "evaluate": {
            "purpose": "damage_single_target",
            "effectiveness": {
                "strong_against": ["low_magic_defense", "ice_element"],
                "weak_against": ["fire_resistant", "high_magic_defense"]
            },
            "situational": {
                "early_battle": "good",
                "low_hp_self": "neutral",
                "low_hp_target": "prefer_finishing_move_instead",
                "multiple_targets": "consider_area_action_instead"
            }
        },
        // Verify (-1 — break down): Safety checks before committing
        "verify": {
            "mp_after_use": "must_remain_above_0",
            "leaves_self_vulnerable": false,
            "better_option_exists_check": true
        }
    },

    // Combo — _rpg: future action chaining
    "combo": {
        "chain_from": [],
        "chain_to": ["ACT-011-FIRE_STORM"],
        "combo_window_turns": 0
    },

    // Stack Behavior — actions are scene DATA, not a scene frame
    "stack_behavior": {
        "push_mode": "none",
        "is_scene_frame": false,
        "lifecycle_role": "Loaded during combat scene initialization as part of data_requirements",
        "loaded_with": "combat scene (loaded via combat.jsonc data_requirements.action_sets)",
        "consumed_at": "combat duration (player and NPC action selection throughout battle)",
        "evicted_at": "combat on_pop (action data freed with combat scene)",
        "note": "Actions do not push/pop independently. They are scene-scoped data tied to their parent combat scene."
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/cornerstone --validate-actions"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "identity", "costs", "effects", "targeting"],
        "rpg_required": ["requirements"],
        "optional": ["decision", "combo"],
        "identity_required": ["action_id", "ref_name", "name", "type", "description"],
        "costs_required": ["mp_cost", "action_points"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust damage/cost values (balance tuning)",
            "Adjust decision assessment criteria",
            "Add status effects to existing actions",
            "Modify requirements for class rebalancing"
        ],
        "careful": [
            "Change action_id (breaks references from stats, boss phases)",
            "Add new effect types (engine must support them)",
            "Change targeting rules (affects NPC decision behavior)",
            "Modify combo chains (affects action flow)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (identity, costs, effects, targeting)",
            "Change value types without updating engine",
            "Remove requirements section (RPG contract)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (identity, costs, effects, targeting, requirements)",
        "Change value types without updating engine"
    ],
    "_X1_careful": [
        "Change action_id (breaks references from stats, boss phases)",
        "Add new effect types (engine must support)",
        "Change targeting rules (affects NPC decision behavior)"
    ],
    "_X1_safe": [
        "Adjust damage/cost/decision values (balance tuning)",
        "Add new actions following schema",
        "Modify class/weapon requirements for rebalancing"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Combo action chains (chain_from/chain_to with window)",
        "Conditional effects (damage bonus vs element weakness)",
        "Mastery scaling (damage increases with class mastery %)",
        "Animation/visual effect references"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "action_not_found": "Check action_id matches reference in stats. Verify file path. Confirm JSONC parser strips comments.",
        "class_cant_use": "Check requirements.class includes the character's current class. Check class.jsonc for class_id spelling.",
        "npc_never_uses": "Check decision.assess preconditions aren't always failing. Verify decision.evaluate.purpose matches combat situation. Confirm entity has enough resources (MP, HP).",
        "tripwire_to_universal": "RPG action file missing or malformed. Check logs for LOUD warning. Verify JSON syntax.",
        "combo_not_triggering": "Check combo.chain_from matches previous action_id. Verify combo_window_turns > 0."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/universal/scene/action-defaults.jsonc — Universal parent template",
        "cornerstone/data/game/rpg/global/class.jsonc — Class definitions for requirements gating",
        "cornerstone/data/game/rpg/scene/frames/combat.jsonc — Combat rules that execute actions",
        "cornerstone/data/game/rpg/scene/frames/boss.jsonc — Boss phases reference action sets"
    ],
    "_X4_required": ["name", "version", "identity", "costs", "effects", "targeting", "requirements"],
    "_X4_validate": "make && ./bin/cornerstone --validate-actions",
    "_X4_usage_c": "action_load(\"rpg/data/actions/fireball.jsonc\"); action_execute(&action, &caster, &target);",
    "_X4_id_ranges": "Player: ACT-010+, Enemy: ACT-500+, Shared: ACT-001-009",

    // Actions have purpose — the warrior's sword and the priest's prayer each have their season.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG combat actions — covers both player skills and NPC/enemy abilities. Derives from universal action-defaults, adds class/weapon gating and CPI-SI decision framework. Player vs NPC is data, not schema.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose. — Ecclesiastes 3:1",
    "_X5_anchor": "The warrior's sword, the priest's prayer, the rogue's shadow — each has its season.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp actions.jsonc [game]/data/actions/shield-bash.jsonc -> update pragma -> fill RPG-specific action data",
    "_X6_update": [
        "_P1_key: unique identifier for this action",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: identity (ACT-NNN-TAG), costs, effects, targeting, requirements, decision",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
