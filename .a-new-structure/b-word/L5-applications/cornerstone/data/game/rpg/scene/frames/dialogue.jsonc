{
    // #!omni template --jsonc
    "$schema": "../../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from universal scene-defaults, override allowed",
        "_rpg": "RPG-SPECIFIC — added by this derivation, not in universal",
        "_cpisi": "CPI-SI DECISION — assessment-based logic for dialogue choice selection"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-scene-dialogue",
    "_P1_from": "cornerstone/data/game/universal/scene/scene-defaults.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-dialogue-rpg",
    "_P2_role": "rung",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes dialogue content to the scene dialogue system",
    "_P3_layer": "cornerstone/data/game/rpg/scene/frames",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_DIALOGUE_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Dialogue Template",
    "_P5_brief": "Unified RPG dialogue template — 4 flow types (linear, branching, conditional, interruptible) in one schema. Derives from scene-defaults. Includes CPI-SI decision framework for dialogue choice evaluation.",
    "_P5_usage": "cp dialogue.jsonc [game]/data/dialogue/elder-greeting.jsonc -> update pragma -> set type -> fill dialogue lines",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "dialogue.jsonc",
        "key": "B-cornerstone-data-game-rpg-scene-dialogue",
        "title": "RPG Dialogue Template",
        "type": "Data (Template)",
        "component": "Baton — passes dialogue content to the scene dialogue system",
        "role": "Define RPG dialogue scenes — conversations, cutscenes, NPC interactions with 4 flow types"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "A word fitly spoken is like apples of gold in pictures of silver."
    "_M4_grounding": {
        "scripture": "Proverbs 25:11 — A word fitly spoken is like apples of gold in pictures of silver.",
        "principle": "Dialogue is the soul of story. Words shape worlds — what characters say reveals who they are. The right word at the right time changes everything.",
        "anchor": "Proverbs 18:21 — Death and life are in the power of the tongue."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/dialogue.c — dialogue_load(), dialogue_advance(), dialogue_choose()",
        "integration": "Loaded when dialogue scene pushes. Engine reads type field to determine flow mechanism. CPI-SI decision framework used for NPC dialogue selection AND for CPI-SI instance play choices.",
        "if_missing": "Scene system shows empty dialogue frame — no lines, no choices",
        "related_data": {
            "derives_from": {
                "scene-defaults": "Universal scene template — scene stack contract (identity, stack_behavior)"
            },
            "references": {
                "npcs": "speaker fields reference NPC identities",
                "affinity": "Conditional dialogue checks affinity levels for visibility",
                "karma": "Branching dialogue selects paths based on karma tier",
                "game-types": "scene_type references scene_types enum"
            },
            "referenced_by": {
                "story-encounter": "Story encounters reference pre/post battle dialogue IDs",
                "boss": "Boss phases may trigger mid-battle dialogue",
                "resolution": "Battle resolution may trigger outcome dialogue"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/scene/frames/dialogue.jsonc",
        "derives_from": "cornerstone/data/game/universal/scene/scene-defaults.jsonc"
    },

    "_M7_classification": {
        "tags": "dialogue, conversation, npc, story, cutscene, rpg, scene-state, linear, branching, conditional, interruptible, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define RPG dialogue scenes — all 4 flow types in one unified template",
        "core_design": "Type-driven dialogue — one schema, four flow mechanisms. type field selects engine behavior.",
        "philosophy": "Dialogue IS story. Every conversation is a scene. The type determines HOW the words flow, not WHAT is said.",
        "key_features": {
            "linear": "Sequential lines played in order — intro scenes, tutorials, narration",
            "branching": "Named branches selected by game state — endings, outcomes, karma paths",
            "conditional": "Lines with requires/excludes flags — NPCs respond differently based on player state",
            "interruptible": "Cancellable dialogue with interrupt settings — optional tutorials, skippable cutscenes"
        },
        "consolidation_note": "Merged from dialogue-linear.jsonc + dialogue-branching.jsonc + dialogue-conditional.jsonc + dialogue-interruptible.jsonc — same base structure, type field distinguishes flow",
        "cpisi_note": "Dialogue choices are CPI-SI decisions. When a CPI-SI instance plays, it evaluates choices using assess(0) -> evaluate(+1) -> verify(-1). NPCs select dialogue paths using the same framework."
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-03) — Four separate dialogue type templates (old format)",
            "a-02.00 (2026-02-09) — Consolidated into single RPG dialogue template, derived from scene-defaults, flat convention, CPI-SI decision framework"
        ],
        "current": "RPG dialogue template — 4 flow types, scene-scoped, flat convention, CPI-SI choice evaluation",
        "planned": [
            "Voice acting reference fields (audio_id per line)",
            "Emotion-driven portrait animation triggers",
            "Dialogue reputation consequences (affinity/karma changes from choices)",
            "Multi-speaker group conversations"
        ]
    },

    // Where this data lives in the stack-based scene system
    "_M10_game_state": {
        "lifetime": "scene",
        "description": "Scene-scoped — pushed as dialogue scene, popped when conversation ends. Lines and state evicted on pop.",
        "loaded_at": "Dialogue scene push — all lines/branches loaded during initialization",
        "persists": "Duration of dialogue scene on the stack",
        "consumed_by": "Dialogue system — dialogue_advance() steps through lines, dialogue_choose() handles player decisions",
        "load_priority": 3,
        "cache_policy": "scene-bound — loaded on scene push, evicted on scene pop",
        "authority_rank": "engine-default (universal) < rpg-default (this) < instance-specific",
        "id_format": "dialogue_id: DLG-NNN-TAG (e.g., DLG-001-ELDER_GREET, DLG-002-SHOP_HAGGLE, DLG-010-BOSS_TAUNT). ref_name for human-readable."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 (game state) tracks stack-based scene system lifetime.",
        "derivation": "_P1_from points to scene-defaults. RPG adds dialogue types, defaults, lines, choices, CPI-SI choice evaluation."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG dialogue — extends universal scene structure.
    // Inherits: scene identity, stack_behavior (from scene-defaults)
    // Adds: dialogue type, defaults, lines/branches, choice decision framework

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // One schema, four flow types. The type field determines engine behavior.
    // All types share: identity (name, dialogue_id, type, scene), defaults, lines.
    // Type-specific: branches (branching), requires/excludes (conditional), interrupt (interruptible).

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every dialogue must have name, dialogue_id, type, scene, version. Lines or branches required depending on type.",
    "_Cc_id_format": "dialogue_id: DLG-NNN-TAG. NPC dialogues: DLG-001+. Story dialogues: DLG-100+. Boss/combat dialogues: DLG-500+. ref_name carries human-readable snake_case.",
    "_Cc_derivation": "Tripwire chain: rpg/dialogue -> universal/scene-defaults -> engine empty frame",
    "_Cc_scene_role": "Dialogue is a SCENE FRAME — it pushes onto the scene stack as an overlay or standalone scene. Can overlay combat, exploration, or other scenes. Pops when conversation ends.",

    "_Cc_type_guide": {
        "linear": "Sequential — lines[] played in order. Use for: intro scenes, tutorials, narration.",
        "branching": "State-selected — branches{} object with named arrays. Engine selects branch by game state (karma, flags, etc.).",
        "conditional": "Flag-filtered — lines[] with requires/excludes per line. Lines show/hide based on player flags.",
        "interruptible": "Cancellable — lines[] with interrupt{} settings. Player can cancel mid-conversation."
    },

    "_Cc_line_structure": {
        "required": ["id", "speaker", "text"],
        "optional": ["portrait", "emotion", "delay", "choices", "action", "target", "next"],
        "conditional_fields": ["requires", "excludes"],
        "interruptible_fields": ["can_interrupt"]
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: RPG linear dialogue with a choice point.
    // Shows base structure applicable to all 4 types.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    // ─── Dialogue Identity ───
    "name": "Elder's Greeting",
    "dialogue_id": "DLG-001-ELDER_GREET",
    "ref_name": "elder_greeting",
    "type": "linear",
    "scene": "SCN-010-VILLAGE_ELDER",
    "version": "a-01.00",

    // ─── Display Defaults ───
    // Engine uses these if not overridden per-line.
    "defaults": {
        "text_speed": 30,
        "auto_advance": false,
        "skip_enabled": true,
        "portrait_position": "left"
    },

    // ─── Interrupt Settings (interruptible type only) ───
    // Ignored by engine for non-interruptible types.
    "interrupt": {
        "cancel_key": "escape",
        "on_cancel": "exit",
        "cancel_target": null
    },

    // ─── Dialogue Lines (linear/conditional/interruptible) ───
    // Sequential entries. Engine steps through in order.
    // For branching type, use "branches" object instead.
    "lines": [
        {
            "id": 1,
            "speaker": "Elder Tobias",
            "text": "Welcome, traveler. The road to our village is long.",
            "portrait": "elder_tobias",
            "emotion": "neutral"
        },
        {
            "id": 2,
            "speaker": "Elder Tobias",
            "text": "I sense purpose in your journey. Tell me — what brings you here?",
            "emotion": "curious",
            "choices": [
                {
                    "text": "I seek the ancient shrine.",
                    "next": 10,
                    "decision": {
                        "assess": { "quest_active": "shrine_quest" },
                        "evaluate": { "purpose": "advance_main_quest", "affinity_effect": "trust_elder_+1" },
                        "verify": { "reveals_information": true, "consequences": "unlocks_shrine_path" }
                    }
                },
                {
                    "text": "Just passing through.",
                    "next": 20,
                    "decision": {
                        "assess": { "always_available": true },
                        "evaluate": { "purpose": "safe_neutral_response", "affinity_effect": "none" },
                        "verify": { "reveals_information": false, "consequences": "standard_farewell" }
                    }
                },
                {
                    "text": "That's none of your business.",
                    "next": 30,
                    "decision": {
                        "assess": { "always_available": true },
                        "evaluate": { "purpose": "hostile_response", "affinity_effect": "trust_elder_-2", "karma_effect": "dark_+1" },
                        "verify": { "reveals_information": false, "consequences": "elder_distrusts_player" }
                    }
                }
            ]
        },
        {
            "id": 10,
            "speaker": "Elder Tobias",
            "text": "The shrine... Few seek it willingly. I can show you the way.",
            "emotion": "serious",
            "action": "scene_transition",
            "target": "SCN-011-SHRINE_PATH"
        },
        {
            "id": 20,
            "speaker": "Elder Tobias",
            "text": "Safe travels, then. The inn is down the road.",
            "emotion": "neutral"
        },
        {
            "id": 30,
            "speaker": "Elder Tobias",
            "text": "...I see. Guard your tongue, stranger. Words have weight here.",
            "emotion": "stern",

            // Conditional field — only shown if player has a specific flag
            "requires": [],
            "excludes": []
        }
    ],

    // ─── Branches (branching type only) ───
    // Named branches selected by game state. Engine selects based on conditions.
    // Ignored by engine for non-branching types.
    "branches": {
        "_note": "Used when type='branching'. Keys are game-defined. Engine selects branch by evaluating karma/flags/affinity.",
        "example_success": [],
        "example_failure": []
    },

    // ─── CPI-SI Choice Framework ───
    // Describes HOW choices in this dialogue should be evaluated.
    // Used by NPCs making dialogue decisions AND by CPI-SI instances playing.
    // Same assess(0) -> evaluate(+1) -> verify(-1) pattern as combat actions.
    "choice_framework": {
        "description": "CPI-SI decision framework for dialogue choices",
        "assess": "What do I know? Check quest state, affinity levels, karma tier, available flags.",
        "evaluate": "What does each choice lead to? Weigh consequences: affinity changes, quest progress, karma shifts, information revealed.",
        "verify": "Is this consistent with who I am? Check alignment with character identity, current goals, covenant principles."
    },

    // Stack Behavior — _inh from universal scene-defaults, RPG-specific values
    // Dialogue IS a scene frame — pushes as overlay or standalone
    "stack_behavior": {
        "push_mode": "overlay",
        "allows_pause": false,
        "allows_overlay": [],
        "on_push": "load dialogue lines/branches, initialize dialogue state, display first line",
        "on_pop": "apply choice consequences (flags, karma, affinity), return to previous scene, evict dialogue data",
        "on_pause": "preserve dialogue position (current line, choices made)",
        "on_resume": "continue dialogue from paused position"
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "./bin/cornerstone --validate-dialogue"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "dialogue_id", "type", "scene", "version"],
        "type_linear_requires": ["lines"],
        "type_branching_requires": ["branches"],
        "type_conditional_requires": ["lines"],
        "type_interruptible_requires": ["lines", "interrupt"],
        "optional": ["defaults", "choice_framework", "interrupt", "branches"],
        "line_required": ["id", "speaker", "text"],
        "line_optional": ["portrait", "emotion", "delay", "choices", "action", "target", "next", "requires", "excludes", "can_interrupt"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Edit dialogue text content",
            "Add new lines following schema",
            "Adjust defaults (text_speed, portrait_position)",
            "Add/modify choice decision assessments"
        ],
        "careful": [
            "Change dialogue_id (breaks references from story encounters, bosses)",
            "Change type (switches engine flow mechanism)",
            "Modify line IDs (breaks next/choice jumps)",
            "Add/remove choices (affects story branching)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (name, dialogue_id, type, scene)",
            "Leave orphaned line IDs (next points to non-existent id)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (name, dialogue_id, type, scene)",
        "Leave orphaned line IDs (next/choice jumps to non-existent id)",
        "Mix lines and branches in the same dialogue (use one per type)"
    ],
    "_X1_careful": [
        "Change dialogue_id (breaks story encounter and boss references)",
        "Change type (switches engine flow — linear vs branching vs conditional vs interruptible)",
        "Modify line IDs (breaks choice/next jumps)"
    ],
    "_X1_safe": [
        "Edit dialogue text",
        "Add new lines",
        "Modify choice options and their decision assessments",
        "Adjust display defaults"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Voice acting reference fields (audio_id per line)",
        "Emotion-driven portrait animation triggers",
        "Dialogue reputation consequences (affinity/karma changes embedded in choices)",
        "Multi-speaker group conversations",
        "Timed dialogue (auto-advance with player-visible countdown)"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "dialogue_not_loading": "Check dialogue_id matches reference in story/boss file. Verify scene field matches scene_id.",
        "wrong_flow_type": "Check type field matches intended behavior. linear=sequential, branching=state-selected, conditional=flag-filtered, interruptible=cancellable.",
        "choice_not_appearing": "Check line has choices array. Verify choice next IDs exist in lines. For conditional: check requires/excludes flags.",
        "branch_not_selected": "Check branches object has matching key. Verify engine condition evaluation logic matches branch keys.",
        "interrupt_not_working": "Verify type is 'interruptible'. Check interrupt.cancel_key is valid. Ensure interrupt object exists.",
        "lines_skipped": "For conditional: check requires flags are set. Check excludes flags are NOT set. Verify flag state."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/universal/scene/scene-defaults.jsonc — Universal parent template (scene stack contract)",
        "cornerstone/data/game/rpg/shared/npcs.jsonc — NPC definitions referenced by speaker fields",
        "cornerstone/data/game/rpg/shared/affinity.jsonc — Affinity levels checked by conditional dialogue",
        "cornerstone/data/game/rpg/shared/karma.jsonc — Karma tiers used for branching dialogue selection",
        "cornerstone/data/game/rpg/scene/frames/story-encounter.jsonc — Story encounters reference dialogue IDs"
    ],
    "_X4_required": ["name", "dialogue_id", "type", "scene", "version"],
    "_X4_validate": "make && ./bin/cornerstone --validate-dialogue",
    "_X4_usage_c": "dialogue_load(\"DLG-001-ELDER_GREET\"); dialogue_advance(&state); // or dialogue_choose(&state, choice_index);",
    "_X4_type_summary": {
        "linear": "lines[] in order",
        "branching": "branches{} selected by state",
        "conditional": "lines[] with requires/excludes flags",
        "interruptible": "lines[] with interrupt{} cancel behavior"
    },

    // A word fitly spoken is like apples of gold in pictures of silver.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG dialogue template — 4 flow types unified. Dialogue is story. Every word shapes the world. CPI-SI decision framework applies to dialogue choices — assess situation, evaluate options, verify alignment.",
    "_X5_scripture": "A word fitly spoken is like apples of gold in pictures of silver. — Proverbs 25:11",
    "_X5_anchor": "Words have weight. What characters say reveals who they are.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp dialogue.jsonc [game]/data/dialogue/shopkeeper-haggle.jsonc -> update pragma -> set type -> fill lines/branches",
    "_X6_update": [
        "_P1_key: unique identifier for this dialogue",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: dialogue_id (DLG-NNN-TAG), type, scene, lines or branches, choice decision assessments",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
