    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Scene Stack Registry",
    "_P5_brief": "Organizational file defining how RPG scenes relate — which are FRAMES (push/pop), which are DATA (loaded with frames), how they stack, overlap, and lifecycle. The scene stack is LIFO — scenes push on top and pop back.",
    "_P5_usage": "Reference for engine scene manager — scene_push(), scene_pop(), scene_overlay(), scene_pause()",

    // ═══════════════════════════════════════════════════════════════
