    "_X1_careful": [
        "Change type key names (engine must match)",
        "Change values dramatically (affects all tripwire cases)"
    ],
    "_X1_safe": [
        "Adjust fallback rate values (should rarely change)",
        "Add comments explaining purpose"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_note": "This file is ENGINE FALLBACK — don't extend it. Extensions go in game-specific encounter files.",
    "_X2_planned": [
        "Diagnostic logging for when tripwire is hit",
        "Rate validation at engine startup",
        "Health check: warn if game hasn't provided its own rates by first zone load"
    ],
    "_X2_game_templates": {
        "random_encounters": "cornerstone/templates/data/game/battle/random.jsonc",
        "story_encounters": "cornerstone/templates/data/game/battle/story.jsonc",
        "boss_encounters": "cornerstone/templates/data/game/battle/boss.jsonc"
    },

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "tripwire_hit": "Working as designed — LOUD warning, game continues. Fix the game rate file, not this fallback.",
        "rates_not_loading": "Verify this file exists at expected path. Check JSONC parser is working. Engine needs at least THIS fallback.",
        "wrong_fallback_values": "Check all values are positive numbers. Verify key names match engine expectations.",
        "parse_error": "Check for missing commas, mismatched brackets. Validate JSONC syntax."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/rpg/global/random.jsonc — Random encounter pools (WHAT appears)",
        "cornerstone/data/game/rpg/global/stats-enemy.jsonc — Enemy stat definitions",
        "cornerstone/data/game/rpg/scene/frames/combat.jsonc — Combat configuration",
        "cornerstone/data/game/rpg/scene/frames/story-encounter.jsonc — Scripted encounter definitions",
        "cornerstone/data/game/rpg/scene/frames/boss.jsonc — Boss encounter definitions"
    ],
    "_X4_required": ["name", "version", "types", "zone_modifiers", "difficulty_modifiers"],
    "_X4_validate": "make && ./bin/cornerstone --validate-encounter-rates",
    "_X4_usage_c": "encounter_load_rates(\"cornerstone/data/encounters/defaults.jsonc\"); // engine internal — tripwire",
    "_X4_separation": "encounter.jsonc = WHEN encounters happen | random.jsonc = WHAT enemies appear | stats-enemy.jsonc = WHO the enemies ARE",

    // Even with fallback rates, encounters still serve their purpose.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "Engine fallback encounter rates — the safety net. If this file loads during gameplay, game-specific rates failed. LOUD warning, game keeps running. Better degraded than broken.",
    "_X5_scripture": "To every thing there is a season, and a time to every purpose under the heaven. — Ecclesiastes 3:1",
    "_X5_anchor": "Even with fallback rates, encounters still serve their purpose. The rhythm continues.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "DO NOT copy this file for game encounter rates! This IS the engine fallback, not a template.",
    "_X6_use_instead": {
        "random": "cornerstone/templates/data/game/battle/random.jsonc",
        "story": "cornerstone/templates/data/game/battle/story.jsonc",
        "boss": "cornerstone/templates/data/game/battle/boss.jsonc"
    },

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
