{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from universal entity-defaults, override allowed",
        "_rpg": "RPG-SPECIFIC — added by this derivation, not in universal",
        "_grow": "GROWTH — player earns/accumulates these (unlike enemies)"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-global-stats-player",
    "_P1_from": "cornerstone/templates/data/game/stats/defaults.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-stats-rpg-player",
    "_P2_role": "rails",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Rails — defines player starting stat configuration for character creation",
    "_P3_layer": "cornerstone/data/game/rpg/global",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_PLAYER_STATS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Player Stats Template",
    "_P5_brief": "Player starting stat definitions — growth-oriented, balanced for new game. Player EARNS and accumulates (exp, gold, stamina). Stats are the foundation, class modifiers and choices shape the journey.",
    "_P5_usage": "cp stats-player.jsonc [game]/data/stats/player_defaults.jsonc -> update pragma -> fill player stats",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "stats-player.jsonc",
        "key": "B-cornerstone-data-game-rpg-global-stats-player",
        "title": "RPG Player Stats Template",
        "type": "Data (Template)",
        "component": "Rails — defines player starting stat configuration for character creation",
        "role": "Define player starting stats — balanced, growth-oriented, class modifiers apply on top"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Keep thy heart with all diligence; for out of it are the issues of life."
    "_M4_grounding": {
        "scripture": "Proverbs 4:23 — Keep thy heart with all diligence; for out of it are the issues of life.",
        "principle": "The hero's journey begins from the heart, not from power. Stats are starting capability, choices define destiny.",
        "anchor": "Luke 16:10 — He that is faithful in that which is least is faithful also in much."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/player.c — player_init(), player_create()",
        "integration": "Loaded when starting new game or creating character. Player system initializes Stats from this config. Class modifiers (from class.jsonc) apply on top of base values.",
        "if_missing": "Tripwire to universal entity-defaults with LOUD warning — creates base character with neutral starting stats",
        "related_data": {
            "derives_from": {
                "stats-defaults": "Universal stats template — base stat structure"
            },
            "references": {
                "class": "Class modifiers apply on top of these base stats",
                "karma": "Karma tier affects class upgrade eligibility",
                "actions": "Player abilities reference action definitions"
            },
            "referenced_by": {
                "class": "Class selection reads base stats to apply modifiers",
                "combat": "Combat system reads player stats for damage, defense, speed",
                "resolution": "Resolution distributes earned exp/gold to player resources"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/global/stats-player.jsonc",
        "derives_from": "cornerstone/templates/data/game/stats/defaults.jsonc"
    },

    "_M7_classification": {
        "tags": "stats, player, hero, character, rpg, starting, growth, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define player starting stats — resources, attributes, combat, battle, resistance, utility",
        "core_design": "Data-driven stats — values in data, logic in engine. Player stats are growth-oriented, balanced for new game.",
        "philosophy": "Player stats are the foundation — class modifiers shape specialization, choices shape destiny. Start modest, room to develop.",
        "key_features": {
            "resources": "HP, MP, Stamina, EXP, Gold — player EARNS and accumulates these",
            "attributes": "Balanced base stats — class modifiers adjust specialization",
            "combat": "Level 1, modest damage, room to grow",
            "battle": "Action points, guard reduction, flee bonus",
            "resistance": "Neutral starting point — equipment and skills modify later",
            "utility": "Non-combat stats — movement, perception, stealth, charisma"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-03) — Initial player stats template (old comment-based format)",
            "a-02.00 (2026-02-09) — Flat convention, growth clarity, class integration documented"
        ],
        "current": "RPG player stats template — resources, attributes, combat, battle, resistance, utility",
        "planned": [
            "Level-up stat growth formulas",
            "Class-specific starting variations",
            "New Game+ stat carryover",
            "Equipment stat bonus slots"
        ]
    },

    "_M10_game_state": {
        "lifetime": "global",
        "description": "Global — player stat definitions loaded at game start, used as BASE for character creation. Not mutable reference data — character gets a COPY that grows.",
        "loaded_at": "New game initialization — player creation reads base stats, applies class modifiers",
        "persists": "Entire game session (base definition cached, character instance has mutable copy)",
        "consumed_by": "Player system — player_init() reads base definition, player_create() applies class modifiers. Stats grow through play.",
        "load_priority": 1,
        "cache_policy": "session-bound — loaded once at game start, cached for duration",
        "authority_rank": "engine-default (universal) < rpg-default (this) < game-specific override",
        "note": "Player stats are the BASE. Class modifiers (class.jsonc) adjust on top. Equipment, buffs, level-ups further modify the character instance."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 tracks global lifetime. Player stats are BASE — class modifiers, equipment, and growth modify the character instance.",
        "derivation": "_P1_from points to universal stats defaults template. RPG adds battle category, growth-oriented resources (stamina, exp, gold), and utility (stealth, charisma)."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG player stats template — growth-oriented, balanced for new game.
    // Global data — loaded once, character instance gets mutable copy.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Player = resources + attributes + combat + battle + resistance + utility.
    // Missing keys tripwire to universal entity-defaults, then engine fallback.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every player stat file must have name, version, resources, attributes, combat, utility. Battle and resistance are expected.",
    "_Cc_derivation": "Tripwire chain: rpg/stats-player -> universal/entity-defaults -> engine hardcoded fallback",
    "_Cc_global_role": "Player stat definitions are GLOBAL data — loaded once at game start as BASE for character creation. Character instance gets a MUTABLE copy that grows through play. Class modifiers apply on top.",
    "_Cc_contrast": "stats-player has GROWTH resources (stamina, exp, gold). stats-enemy has REWARD resources (exp_value, gold_value, drop_rate). Same stat categories, different purpose.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Starting stats — balanced for Level 1 new game.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "[Player Stats Configuration Name]",
    "version": "a-01.00",

    // Resources — _grow: consumable/accumulating values (player EARNS these)
    "resources": {
        "hp_max": 100,
        "mp_max": 50,
        "stamina_max": 100,
        "exp": 0,
        "gold": 0
    },

    // Attributes — _req: base character capabilities (class modifiers adjust)
    "attributes": {
        "str": 10,
        "def": 10,
        "mag": 10,
        "spd": 10,
        "dex": 10,
        "luck": 10,
        "vit": 10,
        "wis": 10
    },

    // Combat — _req: derived battle stats (typically calculated from attributes)
    "combat": {
        "level": 1,
        "damage_min": 5,
        "damage_max": 10,
        "accuracy": 90,
        "evasion": 5,
        "crit_rate": 5,
        "crit_damage": 150
    },

    // Battle — _rpg: combat system integration
    "battle": {
        "action_points": 3,
        "turn_priority": 0,
        "guard_reduction": 50,
        "flee_bonus": 0,
        "status_slots": 5,
        "actions": ["ACT-001-ATTACK"]
    },

    // Resistance — _inh: elemental/status defenses (0 = neutral, + resist, - weakness)
    "resistance": {
        "fire": 0,
        "ice": 0,
        "thunder": 0,
        "light": 0,
        "dark": 0,
        "poison": 0
    },

    // Utility — _rpg: non-combat capabilities (exploration, social)
    "utility": {
        "movement": 10,
        "perception": 10,
        "stealth": 10,
        "charisma": 10
    },

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "make test-player",
            "./bin/cornerstone --validate-player"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "resources", "attributes", "combat", "utility"],
        "optional": ["battle", "resistance"],
        "resources_format": "{ hp_max: int, mp_max: int, stamina_max: int, exp: int, gold: int }",
        "attributes_format": "{ str: int, def: int, mag: int, spd: int, dex: int, luck: int, vit: int, wis: int }",
        "utility_format": "{ movement: int, perception: int, stealth: int, charisma: int }"
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust stat values for balance tuning",
            "Add new stats within existing categories",
            "Add comments explaining stat purpose"
        ],
        "careful": [
            "Change stat key names (breaks engine lookup)",
            "Add new categories (engine must support them)",
            "Change starting gold/exp (affects early game balance)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (resources, attributes, utility)",
            "Change value types (must be integers)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy -> X.2 Extension -> X.3 Troubleshooting -> X.4 Reference -> X.5 Note -> X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Keep thy heart with all diligence; for out of it are the issues of life. — Proverbs 4:23",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (resources, attributes, utility)",
        "Change value types (must be integers)"
    ],
    "_X1_careful": [
        "Change stat key names (breaks engine lookup)",
        "Add new categories (engine must support)",
        "Change starting gold/exp (affects early game balance)"
    ],
    "_X1_safe": [
        "Adjust stat values for balance tuning",
        "Add new stats within categories",
        "Add comments explaining purpose"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Level-up stat growth formulas",
        "Class-specific starting variations",
        "New Game+ stat carryover",
        "Equipment stat bonus slots",
        "VIT/WIS scaling formulas for HP/MP growth"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "stats_not_loading": "Check resources, attributes, utility objects exist. Verify file path. Confirm JSONC parser stripping comments.",
        "wrong_stat_values": "Check all values are positive integers. Verify key names match engine. Check for typos.",
        "class_modifiers_not_applying": "Verify class.jsonc loaded before player creation. Check modifier key names match attributes (str, mag, def, etc.).",
        "utility_not_working": "Ensure utility object exists with all 4 keys. Check movement/perception/stealth/charisma present.",
        "tripwire_to_defaults": "Check logs for LOUD warning. Verify JSON syntax. Confirm required categories present."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/universal/entity/entity-defaults.jsonc — Universal parent template",
        "cornerstone/data/game/rpg/global/stats-enemy.jsonc — Enemy stats (same categories, different lifetime)",
        "cornerstone/data/game/rpg/global/class.jsonc — Class modifiers applied on top of base stats",
        "cornerstone/data/game/rpg/shared/karma.jsonc — Karma tier affects class upgrade eligibility",
        "cornerstone/data/game/rpg/scene/data/actions.jsonc — Action definitions for player abilities"
    ],
    "_X4_contrast": "Player has GROWTH resources (stamina, exp, gold). Enemy has REWARD resources (exp_value, gold_value, drop_rate). Same stat categories, different purpose.",
    "_X4_required": ["name", "version", "resources", "attributes", "combat", "utility"],
    "_X4_validate": "make && ./bin/cornerstone --validate-player",
    "_X4_usage_c": "stats_load_defaults(\"rpg/data/stats/player_defaults.jsonc\"); player_init(&player, hp_max, mp_max);",

    // The hero's journey begins from the heart.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG player stats — the foundation for the hero's journey. Balanced for growth. Class modifiers shape specialization, choices shape destiny. Stats define starting capability, the heart determines use.",
    "_X5_scripture": "Keep thy heart with all diligence; for out of it are the issues of life. — Proverbs 4:23",
    "_X5_anchor": "Stats are tools, the heart determines their use. Guard the heart.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp stats-player.jsonc [game]/data/stats/player_defaults.jsonc -> update pragma -> fill player stats",
    "_X6_update": [
        "_P1_key: unique identifier for this stat set",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: resources, attributes, combat, battle, resistance, utility",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
