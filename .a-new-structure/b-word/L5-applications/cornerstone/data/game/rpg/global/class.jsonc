{
    // #!omni template --jsonc
    "$schema": "../../../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from universal class-defaults, override allowed",
        "_rpg": "RPG-SPECIFIC — added by this derivation, not in universal"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-game-rpg-global-class",
    "_P1_from": "cornerstone/templates/data/config/settings.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "game-class-rpg",
    "_P2_role": "baton",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes class data to character and combat systems",
    "_P3_layer": "cornerstone/data/game/rpg/global",
    "_P3_includes": "none",
    "_P3_provides": ["RPG_CLASS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "RPG Character Class Template",
    "_P5_brief": "Character class archetypes — stat modifiers, abilities, mastery thresholds, karma-influenced upgrades. Class is what you DO, not who you ARE. Mastery develops calling, karma shapes who you become.",
    "_P5_usage": "cp class.jsonc [game]/data/classes/warrior.jsonc -> update pragma -> fill class data",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    "_M1_identity": {
        "file": "class.jsonc",
        "key": "B-cornerstone-data-game-rpg-global-class",
        "title": "RPG Character Class Template",
        "type": "Data (Template)",
        "component": "Baton — passes class data to character and combat systems",
        "role": "Define character class archetypes — stat modifiers, abilities, mastery, upgrade paths"
    },

    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // "Now there are diversities of gifts, but the same Spirit."
    "_M4_grounding": {
        "scripture": "1 Corinthians 12:4-6 — Now there are diversities of gifts, but the same Spirit. And there are differences of administrations, but the same Lord.",
        "principle": "Different callings, same purpose — class is role, not identity. Each class has unique gifts, but all serve the same mission.",
        "anchor": "Romans 12:6 — Having then gifts differing according to the grace that is given to us, whether prophecy, let us prophesy according to the proportion of faith."
    },

    "_M5_dependencies": {
        "requires": "JSONC parser (C library or strip-comments preprocessor)",
        "consumers": "engine/systems/src/character/class.c — class_load(), class_init()",
        "integration": "Loaded when character created or class changed. Stat modifiers applied to base stats. Abilities registered in combat system. Mastery tracked per-class. Upgrades checked against karma tier.",
        "if_missing": "Tripwire to universal class-defaults with LOUD warning — creates bare class with zeroed modifiers",
        "related_data": {
            "derives_from": {
                "settings": "Universal config template — base structure"
            },
            "references": {
                "karma": "Upgrade eligibility requires karma tier check",
                "stats-player": "Modifiers applied to base player stats",
                "actions": "Abilities reference action definitions for combat execution"
            },
            "referenced_by": {
                "stats-player": "Player creation selects class, applies modifiers",
                "combat": "Combat system loads class abilities for entity action pool",
                "actions": "Action requirements gate on class type"
            }
        }
    },

    "_M6_location": {
        "path": "cornerstone/data/game/rpg/global/class.jsonc",
        "derives_from": "cornerstone/templates/data/config/settings.jsonc"
    },

    "_M7_classification": {
        "tags": "class, character, rpg, warrior, priest, rogue, mastery, upgrade, jsonc"
    },

    "_M8_intent": {
        "purpose": "Define character class archetypes — stat modifiers, abilities, mastery progression, karma-influenced upgrade paths",
        "core_design": "Data-driven classes — engine reads, game defines. Class determines WHAT you can do in combat.",
        "philosophy": "Class is what you DO, not who you ARE — mastery unlocks potential, karma shapes who you become.",
        "key_features": {
            "stat_modifiers": "Bonuses/penalties per class type — strength, magic, defense, speed, HP, MP",
            "mastery_system": "Experience thresholds (25/50/75/100%) gate ability unlocks",
            "abilities": "Skills unlocked at mastery milestones — attack, skill, passive types",
            "upgrade_paths": "Karma-influenced class upgrades — light, dark, neutral paths at 100% mastery"
        }
    },

    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-03) — Initial class template creation (old comment-based format)",
            "a-02.00 (2026-02-09) — Flat convention, game state lifetime, cross-reference updates"
        ],
        "current": "RPG class template — stat modifiers, abilities, mastery, karma upgrades",
        "planned": [
            "Advanced classes (require mastering 2+ base classes)",
            "Ability trees and skill unlocks",
            "Class-specific equipment restrictions",
            "Passive skill synergies between party members"
        ]
    },

    // Where this data lives in the game state system
    "_M10_game_state": {
        "lifetime": "global",
        "description": "Global — class definitions loaded at game start, persist entire session. Class data is reference material, not mutable state.",
        "loaded_at": "Game initialization — all class definitions loaded into class registry",
        "persists": "Entire game session (reference data, not per-character state)",
        "consumed_by": "Character system — class_load() reads definition, class_init() applies modifiers. Combat system reads abilities.",
        "load_priority": 1,
        "cache_policy": "session-bound — loaded once at game start, cached for duration",
        "authority_rank": "engine-default (universal) < rpg-default (this) < game-specific override",
        "id_format": "class_id: CLS-NNN-TAG (e.g., CLS-001-WARRIOR, CLS-002-PRIEST, CLS-003-ROGUE). name carries display string."
    },

    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6-M10 are game-data specific. M10 (game state) tracks global lifetime — loaded once, persists entire session.",
        "derivation": "_P1_from points to universal settings template. RPG adds class-specific stat modifiers, mastery system, karma upgrade paths."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // RPG character class template — defines class archetypes.
    // Global data — loaded once at game start, referenced throughout session.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Class = identity + modifiers + mastery + abilities + upgrades.
    // Missing keys tripwire to universal class-defaults, then engine fallback.

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",
    "_Cc_constraint": "Every class definition must have class_id, name, type, scope, version, modifiers, and abilities. Mastery and upgrades are expected.",
    "_Cc_id_format": "class_id: CLS-NNN-TAG. Base: CLS-001+. Upgrade: CLS-100+. Advanced: CLS-500+.",
    "_Cc_derivation": "Tripwire chain: rpg/class -> universal/class-defaults -> engine hardcoded fallback",
    "_Cc_global_role": "Class definitions are GLOBAL data — loaded once at game start into the class registry. NOT scene-scoped. Referenced by character creation, class switching, combat ability pools. Immutable reference data.",

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Example: Warrior class — melee combat specialist.

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "name": "[Class Name]",
    "version": "a-01.00",

    // Identity — _req: class identification
    "identity": {
        "class_id": "CLS-001-WARRIOR",
        "ref_name": "class_warrior",
        "name": "Warrior",
        "type": "warrior",
        "scope": "base",
        "description": "Melee combat specialist — high strength and defense, low magic."
    },

    // Stat Modifiers — _rpg: bonuses/penalties applied to base stats
    "modifiers": {
        "str": 3,
        "mag": -2,
        "def": 2,
        "spd": 0,
        "hp_bonus": 10,
        "mp_bonus": -5
    },

    // Mastery — _rpg: experience thresholds gating ability unlocks
    "mastery": {
        "threshold_25": 100,
        "threshold_50": 300,
        "threshold_75": 600,
        "threshold_100": 1000
    },

    // Abilities — _rpg: skills unlocked at mastery milestones
    "abilities": [
        {
            "ability_id": "ABL-001-POWER_STRIKE",
            "name": "Power Strike",
            "mastery_req": 0,
            "type": "attack",
            "description": "Heavy melee attack — 1.5x base damage."
        },
        {
            "ability_id": "ABL-002-SHIELD_WALL",
            "name": "Shield Wall",
            "mastery_req": 25,
            "type": "skill",
            "description": "Reduce incoming damage by 50% for 2 turns."
        },
        {
            "ability_id": "ABL-003-COUNTER",
            "name": "Counter Stance",
            "mastery_req": 50,
            "type": "passive",
            "description": "25% chance to counter melee attacks."
        },
        {
            "ability_id": "ABL-004-WAR_CRY",
            "name": "War Cry",
            "mastery_req": 75,
            "type": "skill",
            "description": "Boost party attack by 20% for 3 turns."
        }
    ],

    // Upgrades — _rpg: karma-influenced class evolution at 100% mastery
    "upgrades": [
        {
            "upgrade_id": "CLS-101-PALADIN",
            "name": "Paladin",
            "karma_req": "light",
            "description": "Holy warrior — gains healing and protective abilities."
        },
        {
            "upgrade_id": "CLS-102-BERSERKER",
            "name": "Berserker",
            "karma_req": "dark",
            "description": "Rage warrior — gains devastating attacks at the cost of defense."
        },
        {
            "upgrade_id": "CLS-103-CHAMPION",
            "name": "Champion",
            "karma_req": "neutral",
            "description": "Balanced warrior — gains leadership abilities that boost the party."
        }
    ],

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "make",
            "make test-class",
            "./bin/cornerstone --validate-class"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "version", "identity", "modifiers", "abilities"],
        "optional": ["mastery", "upgrades"],
        "identity_required": ["class_id", "ref_name", "name", "type", "scope"],
        "ability_required": ["ability_id", "name", "mastery_req", "type"],
        "upgrade_required": ["upgrade_id", "name", "karma_req"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Adjust modifier values for balance",
            "Add new abilities following schema",
            "Add new upgrade paths",
            "Change mastery thresholds"
        ],
        "careful": [
            "Change class_id (breaks references from character saves)",
            "Change ability_id (breaks combat system references)",
            "Remove abilities (may break skill dependencies)",
            "Change type (warrior/priest/rogue — affects equipment and ability gating)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required keys (identity, modifiers, abilities)",
            "Change base type after character creation (save corruption)"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required keys (identity, modifiers, abilities)",
        "Change base type after character creation (save corruption)"
    ],
    "_X1_careful": [
        "Change class_id (breaks character save references)",
        "Change ability_id (breaks combat system)",
        "Remove abilities (may break skill dependencies)"
    ],
    "_X1_safe": [
        "Adjust modifier values, mastery thresholds",
        "Add new abilities and upgrade paths",
        "Change descriptions and flavor text"
    ],

    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Advanced classes (require mastering 2+ base classes)",
        "Ability trees with branching skill unlocks",
        "Class-specific equipment restrictions",
        "Passive skill synergies between party members",
        "Class mastery bonuses (stat boosts at 100%)"
    ],

    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "class_not_loading": "Check class_id is unique. Verify JSON syntax. Confirm file path matches game registration.",
        "modifiers_not_applying": "Check modifier key names match stats system (str, mag, def, spd, hp_bonus, mp_bonus). Verify values are integers.",
        "ability_not_unlocking": "Check mastery_req against current mastery %. Verify ability_id is unique. Confirm type is valid (attack | skill | passive).",
        "upgrade_not_available": "Check karma_req matches player karma tier. Verify mastery is 100%. Confirm upgrade_id references a valid class definition.",
        "tripwire_to_universal": "RPG class file missing or malformed. Check logs for LOUD warning. Verify JSON syntax."
    },

    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "cornerstone/data/game/universal/entity/class-defaults.jsonc — Universal parent template",
        "cornerstone/data/game/rpg/global/stats-player.jsonc — Base stats that modifiers apply to",
        "cornerstone/data/game/rpg/global/stats-enemy.jsonc — Enemy stats (enemies may have classes too)",
        "cornerstone/data/game/rpg/shared/karma.jsonc — Karma tiers for upgrade eligibility",
        "cornerstone/data/game/rpg/scene/data/actions.jsonc — Action definitions for class abilities"
    ],
    "_X4_required": ["name", "version", "identity", "modifiers", "abilities"],
    "_X4_validate": "make && ./bin/cornerstone --validate-class",
    "_X4_usage_c": "class_load(\"rpg/data/classes/warrior.jsonc\"); class_init(&player, &class_def);",
    "_X4_id_ranges": "Base: CLS-001+, Upgrade: CLS-100+, Advanced: CLS-500+",

    // Different callings, same purpose.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "RPG character class — WHAT you can do in combat. Global data loaded once, referenced throughout. Mastery develops calling, karma shapes who you become. Class is role, not identity.",
    "_X5_scripture": "Now there are diversities of gifts, but the same Spirit. — 1 Corinthians 12:4",
    "_X5_anchor": "Different gifts, same purpose. The warrior's strength and the priest's prayer both serve the mission.",

    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp class.jsonc [game]/data/classes/warrior.jsonc -> update pragma -> fill class data",
    "_X6_update": [
        "_P1_key: unique identifier for this class",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Co section: identity (CLS-NNN-TAG), modifiers, mastery, abilities, upgrades",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
