{
    // #!omni template --jsonc
    "$schema": "../../../../../b-word/definitions/omni/json-3block-schema.jsonc",

    // ═══════════════════════════════════════════════════════════════
    // OMNICODE PRAGMA [PRAGMA]
    // ═══════════════════════════════════════════════════════════════

    "_pragma": "═══════════════════════════════════════════════════════════════",
    "_pragma_tag": "OMNICODE PRAGMA [PRAGMA]",
    "_pragma_format": "@omni template --jsonc",
    "_pragma_legend": {
        "_req": "REQUIRED — must exist, validation fails without",
        "_inh": "INHERITED — from template, override allowed",
        "_ins": "INSTANCE — file-specific, unique values"
    },

    // P.1 CORE — Identity
    "_P1_CORE": "─────────────────────────────────────────────────────────────",
    "_P1_tag": "P.1 CORE — Identity [CORE]",
    "_P1_key": "B-cornerstone-data-base-config-settings",
    "_P1_from": "b-word/seed/data/json/3block/config.jsonc",
    "_P1_at": "template",

    // P.2 FAMILY — Classification
    "_P2_FAMILY": "─────────────────────────────────────────────────────────────",
    "_P2_tag": "P.2 FAMILY — Classification [FAMILY]",
    "_P2_type": "data",
    "_P2_subtype": "config",
    "_P2_role": "rung",
    "_P2_structure": "3-block",

    // P.3 INSTANCE — File Details
    "_P3_INSTANCE": "─────────────────────────────────────────────────────────────",
    "_P3_tag": "P.3 INSTANCE — File Details [INSTANCE]",
    "_P3_component": "Baton — passes configuration to consuming systems",
    "_P3_layer": "cornerstone/data/base",
    "_P3_includes": "none",
    "_P3_provides": ["JSONC_CONFIG_SETTINGS_TEMPLATE"],

    // P.4 ARCHITECTURE — Scaling Context
    "_P4_ARCH": "─────────────────────────────────────────────────────────────",
    "_P4_tag": "P.4 ARCHITECTURE — Scaling Context [ARCH]",
    "_P4_layers": "L0:C, L1:C, L2:C, L3:Go, L4:Go/Rust, L5:C#",
    "_P4_anchor": "genesis_1_1 -> void(0) -> unity(1) -> derivation",

    // P.5 SUMMARY — Human Identity
    "_P5_SUMMARY": "─────────────────────────────────────────────────────────────",
    "_P5_tag": "P.5 SUMMARY — Human Identity [SUMMARY]",
    "_P5_title": "JSONC Configuration Settings Template",
    "_P5_brief": "Schema for JSONC configuration files — structured key-value data with comments. Configuration as code — version controlled, documented, validated.",
    "_P5_usage": "cp config-settings.jsonc new_config.jsonc -> update pragma (template → document) -> update _P1_key -> fill content",

    // ═══════════════════════════════════════════════════════════════
    // END PRAGMA [END]
    // ═══════════════════════════════════════════════════════════════

    "_pragma_end": "═══════════════════════════════════════════════════════════════",
    "_pragma_end_tag": "END PRAGMA [END]",

    // ═══════════════════════════════════════════════════════════════
    // METADATA BLOCK [METADATA]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_start": "═══════════════════════════════════════════════════════════════",
    "_metadata_tag": "METADATA BLOCK [METADATA]",

    // M.1 IDENTITY
    "_M1_identity": {
        "file": "config-settings.jsonc",
        "key": "B-cornerstone-data-base-config-settings",
        "title": "JSONC Configuration Settings Template",
        "type": "Template",
        "component": "Baton — passes configuration to consuming systems",
        "role": "Schema for JSONC configuration files — copy for new configs"
    },

    // M.2 STATE
    "_M2_state": {
        "version": "a-02.00",
        "status": "Active",
        "created": "2026-01-03",
        "updated": "2026-02-09"
    },

    // M.3 ATTRIBUTION
    "_M3_attribution": {
        "architect": "Seanje Lenox-Wise",
        "implementation": "Nova Dawn (CPI-SI)",
        "organization": "CreativeWorkzStudio LLC",
        "copyright": "© 2026 CreativeWorkzStudio LLC. All rights reserved."
    },

    // M.4 GROUNDING
    // "Give diligence to present yourself approved by God, a workman who doesn't
    //  need to be ashamed, properly handling the Word of truth." — 2 Timothy 2:15
    "_M4_grounding": {
        "scripture": "2 Timothy 2:15 — Study to shew thyself approved unto God, a workman that needeth not to be ashamed, rightly dividing the word of truth.",
        "principle": "Configuration files are the foundation systems build upon. Properly handling means every setting documented, organized, and validated. Excellence in configuration enables excellence in execution.",
        "anchor": "Proverbs 24:27 — Prepare thy work without, and make it fit for thyself in the field; and afterwards build thine house."
    },

    // M.5 DEPENDENCIES
    "_M5_dependencies": {
        "requires": "JSONC parser (JSON parser that strips comments)",
        "consumers": "Application that consumes config",
        "integration": "JSONC parsed at startup or build time, settings applied to application behavior",
        "cross_format": {
            "role": "JSONC configures JSON-consuming applications. TOML configures Go/Rust code packages. Same concern, format matches consumer.",
            "toml_counterpart": "seed/code/L0/toml/config.toml — TOML code config (parallel concept)",
            "relationship": "Both specialize root for code/config use. JSONC for JSON consumers, TOML for Go struct loading."
        }
    },

    // M.6 LOCATION
    "_M6_location": {
        "path": "cornerstone/data/base/config-settings.jsonc",
        "derives_from": "b-word/seed/data/json/3block/config.jsonc"
    },

    // M.7 CLASSIFICATION
    "_M7_classification": {
        "tags": "config, jsonc, settings, template, 3-block"
    },

    // M.8 INTENT — What this file specifically enables
    // This is where the config template's identity lives.
    // It's not "a generic data file" — it's specifically for CONFIGURATION.
    "_M8_intent": {
        "purpose": "Define configuration settings — structured key-value data with comments",
        "core_design": "JSONC format — JSON with comments for inline documentation",
        "philosophy": "Configuration as code — version controlled, documented, validated",
        "key_features": {
            "settings": "Key-value pairs organized by category",
            "comments": "Inline documentation explaining each setting",
            "validation": "Schema-compatible structure for validation tools",
            "versioning": "Version-controlled configuration changes"
        }
    },

    // M.9 ROADMAP
    "_M9_roadmap": {
        "history": [
            "a-01.00 (2026-01-03) — Initial template creation",
            "a-01.10 (2026-01-07) — Added OmniCode pragma structure",
            "a-01.20 (2026-01-07) — Back-propagated crystallized patterns from dialogue defaults",
            "a-02.00 (2026-02-09) — Aligned to flat _P1/_M1 convention"
        ],
        "current": "JSONC config template with 3-block structure, M.1-M.9 metadata, Cc/Co/Cv content",
        "planned": [
            "Schema validation support",
            "Environment-specific overrides pattern (dev/staging/prod)"
        ]
    },

    // M.ext — Extension Contract
    "_M_extension_note": {
        "required": ["_M1_identity", "_M2_state", "_M3_attribution", "_M4_grounding", "_M5_dependencies"],
        "extension": "M6+ available for domain-specific metadata in derived files",
        "rule": "M1-M5 are the base contract. M6-M9 here are config-specific. Derived files inherit the contract and may add their own M6+."
    },

    // ═══════════════════════════════════════════════════════════════
    // END METADATA [END]
    // ═══════════════════════════════════════════════════════════════

    "_metadata_end": "═══════════════════════════════════════════════════════════════",
    "_metadata_end_tag": "END METADATA [END]",

    // ═══════════════════════════════════════════════════════════════
    // CONTENT BLOCK [CONTENT]
    // ═══════════════════════════════════════════════════════════════
    //
    // 3-Block Content: Configuration (Cc) → Operations (Co) → Verification (Cv)
    // This is where the config template's SPECIFIC content lives.
    // The structure is standard. The content is configuration-specific.

    "_content_start": "═══════════════════════════════════════════════════════════════",
    "_content_tag": "CONTENT BLOCK [CONTENT]",

    // ───────────────────────────────────────────────────────────
    // Cc — Content Configurations [CONFIG]
    // ───────────────────────────────────────────────────────────
    //
    // Cc.1 Identity: name, type, scope, version — engine uses these for lookup
    // Cc.2 Defaults: default values inherited by consumers
    // Cc.3 Custom: file-specific sections (triggers, connections, etc.)

    "_Cc": "─────────────────────────────────────────────────────────────",
    "_Cc_tag": "Cc — Content Configurations [CONFIG]",
    "_Cc_format": "JSONC — JSON with comments, UTF-8, LF line endings",
    "_Cc_key_convention": "lowercase_with_underscores for data keys, _prefix for documentation fields",

    "name": "Application Settings",
    "type": "application",
    "scope": "global",
    "version": "a-01.00",

    "defaults": {
        "log_level": "info",
        "max_connections": 100,
        "timeout_seconds": 30,
        "data_directory": "./data"
    },

    // ───────────────────────────────────────────────────────────
    // Co — Content Operations [OPS]
    // ───────────────────────────────────────────────────────────
    //
    // Content types organized in arrays.
    // Each Co.N section documents its structure in schema comments.
    // Pattern: Header → Descriptor → Schema → Example values → Data

    "_Co": "─────────────────────────────────────────────────────────────",
    "_Co_tag": "Co — Content Operations [OPS]",

    "features": [
        {
            "name": "authentication",
            "enabled": true,
            "provider": "jwt"
        },
        {
            "name": "logging",
            "enabled": true,
            "provider": "structured"
        }
    ],

    // ───────────────────────────────────────────────────────────
    // Cv — Content Validation [VALIDATE]
    // ───────────────────────────────────────────────────────────
    //
    // Cv.1 Validation: commands to verify the file
    // Cv.2 Schema: required/optional keys manifest
    // Cv.3 Maintenance: safe/careful/never modification rules

    "_Cv": "─────────────────────────────────────────────────────────────",
    "_Cv_tag": "Cv — Content Validation [VALIDATE]",

    "_Cv_validation": {
        "commands": [
            "npx jsonc-parser validate settings.jsonc",
            "go test ./pkg/config/... -run TestSettingsLoad",
            "go run ./cmd/app --validate-config"
        ]
    },

    "_Cv_schema": {
        "required": ["name", "type", "scope", "version", "defaults"],
        "optional": ["features", "overrides"],
        "item_required": ["name", "enabled"],
        "item_optional": ["description", "provider", "config"]
    },

    "_Cv_maintenance": {
        "safe": [
            "Update values within documented constraints",
            "Add comments explaining settings",
            "Add new keys following existing patterns"
        ],
        "careful": [
            "Change key names (breaks consuming code)",
            "Change value types (breaks parsing)",
            "Remove keys (may break dependencies)"
        ],
        "never": [
            "Break 3-block structure",
            "Remove required schema fields",
            "Remove Cv verification sections"
        ]
    },

    // ═══════════════════════════════════════════════════════════════
    // END CONTENT [END]
    // ═══════════════════════════════════════════════════════════════

    "_content_end": "═══════════════════════════════════════════════════════════════",
    "_content_end_tag": "END CONTENT [END]",

    // ═══════════════════════════════════════════════════════════════
    // CLOSING BLOCK [CLOSING]
    // ═══════════════════════════════════════════════════════════════

    "_closing_start": "═══════════════════════════════════════════════════════════════",
    "_closing_tag": "CLOSING BLOCK [CLOSING]",
    "_closing_structure": "X.1 Policy → X.2 Extension → X.3 Troubleshooting → X.4 Reference → X.5 Note → X.6 Template",

    // X.1 POLICY
    "_X1": "─────────────────────────────────────────────────────────────",
    "_X1_tag": "X.1 POLICY — Modification Guidelines [POLICY]",
    "_X1_scripture": "Remove not the ancient landmark, which thy fathers have set. — Proverbs 22:28",
    "_X1_never": [
        "Break 3-block structure",
        "Remove required schema fields",
        "Remove Cv verification sections"
    ],
    "_X1_careful": [
        "Change key names (breaks consuming code)",
        "Change value types (breaks parsing)",
        "Remove keys (may break dependencies)"
    ],
    "_X1_safe": [
        "Add new settings",
        "Edit existing values",
        "Add comments explaining settings"
    ],

    // X.2 EXTENSION
    "_X2": "─────────────────────────────────────────────────────────────",
    "_X2_tag": "X.2 EXTENSION — Future Ideas [EXTENSION]",
    "_X2_planned": [
        "Environment-specific override patterns (dev/staging/prod)",
        "JSON Schema $ref composition for shared config blocks"
    ],
    "_X2_considered": [
        "JSONC → JSON stripping tool for production deployment"
    ],

    // X.3 TROUBLESHOOTING
    "_X3": "─────────────────────────────────────────────────────────────",
    "_X3_tag": "X.3 TROUBLESHOOTING — Common Problems [TROUBLESHOOTING]",
    "_X3_scripture": "If any of you lack wisdom, let him ask of God. — James 1:5",
    "_X3_problems": {
        "parse_error_on_comments": "Use a JSONC-aware parser. Standard JSON.parse rejects comments. Go: jsonc package. Node: jsonc-parser.",
        "settings_not_applied": "Verify consumer reads from correct path. Check key names match struct tags.",
        "validate_fail": "Run Cv commands. Check against Cv schema. Review error messages."
    },

    // X.4 REFERENCE
    "_X4": "─────────────────────────────────────────────────────────────",
    "_X4_tag": "X.4 REFERENCE — Quick Lookup [REFERENCE]",
    "_X4_related_files": [
        "b-word/seed/data/json/3block/config.jsonc — Parent template",
        "b-word/definitions/omni/json-3block-schema.jsonc — Validation schema",
        "seed/code/L0/toml/config.toml — TOML code config (cross-format counterpart)"
    ],
    "_X4_structure": "{ Cc (identity, defaults, custom) → Co (content types) → Cv (validation, schema, maintenance) }",
    "_X4_required": ["name", "type", "scope", "version", "defaults"],
    "_X4_validate": "npx jsonc-parser validate settings.jsonc",

    // X.5 NOTE
    // Configuration is foundation. Build it well, and what stands on it will stand firm.
    "_X5": "─────────────────────────────────────────────────────────────",
    "_X5_tag": "X.5 NOTE — Final Guidance [NOTE]",
    "_X5_note": "JSONC configuration template. Comments supplement _ fields — human explanation alongside machine structure. Configuration is foundation. Build it well, and what stands on it will stand firm.",
    "_X5_scripture": "In the beginning God created the heaven and the earth. — Genesis 1:1",
    "_X5_anchor": "Prepare thy work without, and make it fit for thyself in the field; and afterwards build thine house. — Proverbs 24:27",

    // X.6 TEMPLATE — Remove when instantiating
    "_X6": "─────────────────────────────────────────────────────────────",
    "_X6_tag": "X.6 TEMPLATE — Instantiation Guide [TEMPLATE]",
    "_X6_note": "Remove this section when instantiating",
    "_X6_usage": "cp config-settings.jsonc new_config.jsonc -> update pragma (template → document) -> update _P1_key",
    "_X6_update": [
        "_P1_key: unique identifier",
        "_M1_identity: file, key, title, role",
        "_M2_state: created/updated dates",
        "_M6_location: path",
        "Cc section: name, type, scope, version, defaults",
        "Co section: actual content types",
        "Cv_schema: required/optional keys for YOUR config",
        "Remove _X6 section when instantiating"
    ],

    // ═══════════════════════════════════════════════════════════════
    // END CLOSING [END]
    // ═══════════════════════════════════════════════════════════════

    "_closing_end": "═══════════════════════════════════════════════════════════════",
    "_closing_end_tag": "END CLOSING [END]"
}
